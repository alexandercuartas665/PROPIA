<Project>

  <!--
    Pin de paquetes base de Microsoft.Extensions.* / KeyDerivation.

    Contexto (2026-09-08, tras la salida de .NET 10 GA): el servicing 9.0.20 de los paquetes de
    Identity (Microsoft.Extensions.Identity.Core/Stores, Microsoft.AspNetCore.Identity) exige
    Microsoft.Extensions.* >= 9.0.20, pero esas versiones base NO se publicaron en 9.0.20 (saltaron
    a 10.0.0). En un restore fresh (contenedor de Railway) NuGet resuelve 10.0.0 como transitiva
    (NU1603) y choca con las referencias flotantes 9.0.* directas (NU1605: package downgrade).

    Estos cuatro paquetes son abstracciones/DI/opciones/KDF estables y retrocompatibles con net9.0,
    asi que fijarlos a 10.0.0 (la version que el resolver ya elige) elimina NU1603/NU1605 sin migrar
    el resto del stack a .NET 10. Aplica a todos los proyectos (todos net9.0).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="10.0.*" />
  </ItemGroup>

</Project>
