# PROPIA - Variables de entorno para docker compose
# Copiar este archivo a .env y completar los valores reales.
# .env NUNCA se sube a git.

# PostgreSQL - password del usuario "propia" (rol owner de la BD propia_dev)
POSTGRES_PASSWORD=CambiameAhora!

# pgAdmin - password del login web admin@propia.local
PGADMIN_PASSWORD=admin
