@page "/restablecer-contrasena"
@layout AuthLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Nueva contraseña - PROPIA</PageTitle>

@* Destino del enlace del correo "Restablece tu contrasena": ?email=...&token=... (token de Identity,
   un solo uso, 24 h). *@

<h2 class="h4 mb-1 text-center fw-semibold">Crea tu nueva contraseña</h2>

@if (_listo)
{
    <p class="text-muted text-center mb-4">Tu contraseña se actualizó. Ya puedes ingresar con ella.</p>
    <a href="/login" class="btn btn-auth-primary w-100 mb-3" style="color:var(--propia-text-inverse)">Iniciar sesión</a>
}
else if (string.IsNullOrEmpty(_emailQs) || string.IsNullOrEmpty(_tokenQs))
{
    <p class="text-muted text-center mb-4">El enlace está incompleto. Ábrelo de nuevo desde el correo o solicita uno nuevo.</p>
    <a href="/recuperar-contrasena" class="btn btn-auth-primary w-100 mb-3" style="color:var(--propia-text-inverse)">Solicitar un enlace nuevo</a>
}
else
{
    <p class="text-muted text-center mb-4">Para <strong>@_emailQs</strong>. Mínimo 10 caracteres, con al menos una mayúscula y un número.</p>

    <ClaveNuevaCampos @bind-Nueva="_nueva" @bind-Confirmar="_confirmar" OnEnter="GuardarAsync" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2 mb-3">
            @if (_enlaceInvalido)
            {
                <span>El enlace no es válido o ya venció. <a href="/recuperar-contrasena">Solicita uno nuevo</a>.</span>
            }
            else
            {
                @_error
            }
        </div>
    }

    <button type="button" class="btn btn-auth-primary w-100 mb-3" style="color:var(--propia-text-inverse)" disabled="@_guardando" @onclick="GuardarAsync">
        @if (_guardando) { <span class="spinner-border spinner-border-sm me-2"></span><span>Guardando...</span> }
        else { <span>Guardar contraseña</span> }
    </button>
    <p class="text-center small mb-0"><a href="/login">Volver a iniciar sesión</a></p>
}

@code {
    private string? _emailQs;
    private string? _tokenQs;
    private string _nueva = "";
    private string _confirmar = "";
    private bool _guardando;
    private bool _listo;
    private bool _enlaceInvalido;
    private string? _error;

    protected override void OnInitialized()
    {
        var qs = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (qs.TryGetValue("email", out var e)) _emailQs = e.ToString();
        if (qs.TryGetValue("token", out var t)) _tokenQs = t.ToString();
    }

    private async Task GuardarAsync()
    {
        _error = null; _enlaceInvalido = false;
        if (ClaveNuevaCampos.Validar(_nueva, _confirmar) is { } err) { _error = err; return; }
        _guardando = true;
        try
        {
            var http = HttpClientFactory.CreateClient("PropiaApi");
            var resp = await http.PostAsJsonAsync("/connect/restablecer-clave",
                new { Email = _emailQs, Token = _tokenQs, NuevaClave = _nueva, ConfirmarClave = _confirmar });
            if (resp.IsSuccessStatusCode) { _listo = true; return; }
            if ((int)resp.StatusCode == 429) { _error = "Demasiados intentos. Espera un minuto y vuelve a intentar."; return; }
            var body = await LeerErrorAsync(resp);
            _error = body ?? "No se pudo guardar la contraseña.";
            _enlaceInvalido = _error.Contains("enlace", StringComparison.OrdinalIgnoreCase);
        }
        catch (HttpRequestException) { _error = "No se pudo conectar con el servidor."; }
        finally { _guardando = false; }
    }

    private static async Task<string?> LeerErrorAsync(HttpResponseMessage resp)
    {
        try { return (await resp.Content.ReadFromJsonAsync<ErrorResp>())?.Error; }
        catch { return null; }
    }

    private sealed record ErrorResp(string? Error);
}
