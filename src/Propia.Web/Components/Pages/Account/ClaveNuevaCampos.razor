@* Campos "Nueva contrasena" + "Confirmar" con ver/ocultar (mismo estilo del login: .password-wrapper /
   .password-toggle). Lo usan /restablecer-contrasena y /cambiar-contrasena. *@

<div class="mb-3">
    <label for="clave-nueva" class="form-label">Nueva contraseña</label>
    <div class="password-wrapper">
        <input id="clave-nueva" type="@(_ver ? "text" : "password")" class="form-control" autocomplete="new-password"
               placeholder="Mínimo 10 caracteres" @bind:get="Nueva" @bind:set="v => NuevaChanged.InvokeAsync(v)" @bind:event="oninput" />
        <button type="button" class="password-toggle" @onclick="() => _ver = !_ver" aria-label="Mostrar u ocultar contraseña">
            @if (_ver)
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            }
        </button>
    </div>
</div>
<div class="mb-3">
    <label for="clave-confirmar" class="form-label">Confirmar contraseña</label>
    <input id="clave-confirmar" type="@(_ver ? "text" : "password")" class="form-control" autocomplete="new-password"
           placeholder="Repite la contraseña" @bind:get="Confirmar" @bind:set="v => ConfirmarChanged.InvokeAsync(v)" @bind:event="oninput"
           @onkeydown="TeclaAsync" />
</div>

@code {
    [Parameter] public string Nueva { get; set; } = "";
    [Parameter] public EventCallback<string> NuevaChanged { get; set; }
    [Parameter] public string Confirmar { get; set; } = "";
    [Parameter] public EventCallback<string> ConfirmarChanged { get; set; }
    [Parameter] public EventCallback OnEnter { get; set; }

    private bool _ver;

    private async Task TeclaAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnEnter.InvokeAsync();
    }

    /// <summary>Misma politica que el API (10+, mayuscula, numero): error en espanol o null.</summary>
    public static string? Validar(string nueva, string confirmar)
    {
        if (nueva != confirmar) return "Las contraseñas no coinciden.";
        return Propia.Application.Auth.ClaveTemporal.ValidarPolitica(nueva);
    }
}
