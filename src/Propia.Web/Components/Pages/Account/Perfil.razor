@page "/cuenta/perfil"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Auth
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Mi Perfil - PROPIA</PageTitle>

@* Modulo "Mi Perfil" (Mi cuenta). Datos del usuario + copropiedades vinculadas con su rol + sesion.
   Los datos vienen de /connect/me (identidad + tenants). Los datos personales detallados (documento,
   telefonos) se gestionan en el Directorio 2.4; la contrasena/MFA quedan para Fase 2. *@

<div class="pf-page">
    <div class="pf-head">
        <h1 class="pf-title">Mi Perfil</h1>
        <p class="pf-sub">Tus datos, las copropiedades a las que tienes acceso y tu sesion.</p>
    </div>

    @if (_me is null)
    {
        <div class="pf-loading">Cargando tu perfil...</div>
    }
    else
    {
        <div class="pf-grid">
            @* Identidad *@
            <div class="pf-card pf-card--id">
                <div class="pf-avatar">@Iniciales</div>
                <div class="pf-id-info">
                    <div class="pf-name">@NombreCompleto</div>
                    <div class="pf-email">@_me.Email</div>
                    @if (RolActivo is not null)
                    {
                        <span class="pf-rol-badge">@RolActivo en @NombreCopActiva</span>
                    }
                </div>
            </div>

            @* Datos de la cuenta *@
            <div class="pf-card">
                <div class="pf-eyebrow">DATOS DE LA CUENTA</div>
                <div class="pf-rows">
                    <div class="pf-row"><span>Nombres</span><span>@(string.IsNullOrWhiteSpace(_me.PersonaNombres) ? "-" : _me.PersonaNombres)</span></div>
                    <div class="pf-row"><span>Apellidos</span><span>@(string.IsNullOrWhiteSpace(_me.PersonaApellidos) ? "-" : _me.PersonaApellidos)</span></div>
                    <div class="pf-row"><span>Correo</span><span>@_me.Email</span></div>
                </div>
                <div class="pf-note">Tus datos personales detallados (documento, telefonos) se administran en el Directorio de tu copropiedad.</div>
            </div>

            @* Copropiedades vinculadas *@
            <div class="pf-card pf-card--full">
                <div class="pf-eyebrow">MIS COPROPIEDADES (@_me.AvailableTenants.Count)</div>
                @if (_me.AvailableTenants.Count == 0)
                {
                    <div class="pf-empty">No tienes copropiedades vinculadas todavia.</div>
                }
                else
                {
                    <div class="pf-cops">
                        @foreach (var t in _me.AvailableTenants)
                        {
                            var activa = _me.ActiveTenantId == t.TenantId;
                            <div class="pf-cop @(activa ? "pf-cop--act" : "")">
                                <div class="pf-cop-ico">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 13h.01M15 13h.01M9 17h.01M15 17h.01"/></svg>
                                </div>
                                <div class="pf-cop-info">
                                    <div class="pf-cop-name">@t.Nombre</div>
                                    <div class="pf-cop-rol">@t.Rol</div>
                                </div>
                                @if (activa)
                                {
                                    <span class="pf-cop-badge">Activa</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* Sesion *@
            <div class="pf-card pf-card--full">
                <div class="pf-eyebrow">SESION Y SEGURIDAD</div>
                <div class="pf-session">
                    <div class="pf-note pf-note--inline">El cambio de contrasena y la autenticacion en dos pasos (MFA) llegan en una proxima fase.</div>
                    <button class="pf-btn-logout" type="button" @onclick="CerrarSesionAsync">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                        Cerrar sesion
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pf-page { padding: 22px 28px; font-family: var(--propia-font-base, 'Lexend', sans-serif); max-width: 1100px; }
    .pf-head { margin-bottom: 18px; }
    .pf-title { font-size: 27px; font-weight: 800; letter-spacing: -0.6px; color: #1B2A3A; margin: 0; }
    .pf-sub { font-size: 14px; color: #7C98B6; margin: 4px 0 0; }
    .pf-loading { padding: 30px; text-align: center; color: #A6B7C8; }
    .pf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .pf-card { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; padding: 18px 20px; }
    .pf-card--full { grid-column: 1 / -1; }
    .pf-card--id { grid-column: 1 / -1; display: flex; align-items: center; gap: 16px; }
    .pf-avatar { width: 58px; height: 58px; border-radius: 15px; flex-shrink: 0; background: linear-gradient(140deg,#8366F0,#5838C9); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 800; }
    .pf-name { font-size: 19px; font-weight: 800; color: #1B2A3A; letter-spacing: -.3px; }
    .pf-email { font-size: 13px; color: #7C98B6; margin-top: 2px; }
    .pf-rol-badge { display: inline-block; margin-top: 8px; font-size: 11px; font-weight: 700; color: var(--propia-brand,#6D4FE3); background: #F1ECFD; border: 1px solid #DCD2F8; padding: 3px 10px; border-radius: 7px; }
    .pf-eyebrow { font-size: 10.5px; letter-spacing: .5px; color: #A6B7C8; font-weight: 700; margin-bottom: 12px; }
    .pf-rows { display: flex; flex-direction: column; gap: 10px; }
    .pf-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .pf-row > span:first-child { font-size: 12.5px; color: #7C98B6; }
    .pf-row > span:last-child { font-size: 13px; font-weight: 600; color: #33475B; text-align: right; }
    .pf-note { font-size: 11.5px; color: #A6B7C8; margin-top: 12px; line-height: 1.5; }
    .pf-note--inline { margin: 0; flex: 1; }
    .pf-empty { font-size: 12.5px; color: #A6B7C8; padding: 6px 0; }
    .pf-cops { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .pf-cop { display: flex; align-items: center; gap: 11px; border: 1px solid #E1E8EE; border-radius: 11px; padding: 12px 13px; background: #FBFBFD; }
    .pf-cop--act { border-color: #DCD2F8; background: #F8F5FE; }
    .pf-cop-ico { width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0; background: #EEF3F8; color: #516F90; display: flex; align-items: center; justify-content: center; }
    .pf-cop-info { flex: 1; min-width: 0; }
    .pf-cop-name { font-size: 13px; font-weight: 700; color: #33475B; }
    .pf-cop-rol { font-size: 11px; color: #7C98B6; font-weight: 600; margin-top: 1px; }
    .pf-cop-badge { font-size: 10px; font-weight: 800; color: #1A8754; background: #E6F6EE; padding: 3px 8px; border-radius: 6px; }
    .pf-session { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .pf-btn-logout { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 9px; border: 1px solid #FECACA; background: #fff; color: #B91C1C; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .pf-btn-logout:hover { background: #FEE2E2; }

    @@media (max-width: 720px) {
        .pf-grid, .pf-cops { grid-template-columns: 1fr; }
    }
</style>

@code {
    private string? _jwt;
    private MeResponse? _me;

    private string Iniciales
    {
        get
        {
            var n = _me?.PersonaNombres?.Trim() ?? "";
            var a = _me?.PersonaApellidos?.Trim() ?? "";
            var i1 = n.Length > 0 ? n[0].ToString() : (_me?.Email?.Length > 0 ? _me.Email[0].ToString() : "?");
            var i2 = a.Length > 0 ? a[0].ToString() : "";
            return (i1 + i2).ToUpperInvariant();
        }
    }
    private string NombreCompleto => $"{_me?.PersonaNombres} {_me?.PersonaApellidos}".Trim() is { Length: > 0 } s ? s : (_me?.Email ?? "Usuario");
    private string? RolActivo => _me?.AvailableTenants.FirstOrDefault(t => t.TenantId == _me.ActiveTenantId)?.Rol;
    private string? NombreCopActiva => _me?.AvailableTenants.FirstOrDefault(t => t.TenantId == _me.ActiveTenantId)?.Nombre;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt"); }
        catch { _jwt = null; }
        if (!string.IsNullOrEmpty(_jwt)) { await CargarAsync(); StateHasChanged(); }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var resp = await Auth().GetAsync("/connect/me");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevo = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevo)) return;
                _jwt = nuevo;
                resp = await Auth().GetAsync("/connect/me");
            }
            resp.EnsureSuccessStatusCode();
            _me = await resp.Content.ReadFromJsonAsync<MeResponse>();
        }
        catch { /* sin datos: queda en "Cargando" -> mostramos vacio si falla */ }
    }

    private async Task CerrarSesionAsync()
    {
        try { await Js.InvokeVoidAsync("propiaAuth.clear"); } catch { }
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
