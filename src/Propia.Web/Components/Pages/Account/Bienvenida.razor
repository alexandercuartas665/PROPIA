    }
    .stage-foot .ob-btn { padding: 12px 26px; font-size: 15px; border-radius: 12px; }

    /* Transicion tipo pagina: la actual sale hacia arriba desenfocandose y la nueva entra desde
       abajo con un resorte suave (direccional: al volver se invierte). */
    .ob-step { display: none; max-width: 560px; width: 100%; margin: 0 auto; will-change: transform, opacity, filter; }
    .ob-step.on { display: block; }
    .ob-step.wide { max-width: 780px; }
    .ob-step.exit-up { animation: obExitUp .26s cubic-bezier(.5, 0, .75, .4) forwards; }
    .ob-step.exit-down { animation: obExitDown .26s cubic-bezier(.5, 0, .75, .4) forwards; }
    .ob-step.enter-from-down { animation: obEnterDown .48s cubic-bezier(.16, 1, .3, 1) both; }
    .ob-step.enter-from-up { animation: obEnterUp .48s cubic-bezier(.16, 1, .3, 1) both; }
    @@keyframes obExitUp { to { opacity: 0; transform: translateY(-34px) scale(.985); filter: blur(5px); } }
    @@keyframes obExitDown { to { opacity: 0; transform: translateY(34px) scale(.985); filter: blur(5px); } }
    @@keyframes obEnterDown { from { opacity: 0; transform: translateY(44px) scale(.99); filter: blur(7px); } to { opacity: 1; transform: none; filter: none; } }
    @@keyframes obEnterUp { from { opacity: 0; transform: translateY(-44px) scale(.99); filter: blur(7px); } to { opacity: 1; transform: none; filter: none; } }

    .ob-kicker { font-size: 11.5px; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; color: var(--ob-brand); margin: 18px 0 6px; }
