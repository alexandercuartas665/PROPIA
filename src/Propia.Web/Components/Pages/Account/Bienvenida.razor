    private void OnDeptoCambio() => _cop.Ciudad = "";

    // DV del NIT con el algoritmo DIAN (pesos de derecha a izquierda, mod 11)
    private void CalcDV()
    {
        var digits = new string((_cop.Nit ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length == 0) { _cop.Dv = ""; return; }
        int[] pesos = { 3, 7, 13, 17, 19, 23, 29, 37, 41, 43, 47, 53, 59, 67, 71 };
        var suma = 0;
        for (var i = 0; i < digits.Length && i < pesos.Length; i++)
            suma += (digits[digits.Length - 1 - i] - '0') * pesos[i];
        var r = suma % 11;
        _cop.Dv = (r > 1 ? 11 - r : r).ToString();
    }

    // ---------- archivos ----------
    private async Task OnEstructuraFile(InputFileChangeEventArgs e) => _estructuraFile = await LeerArchivoAsync(e, "estructura");
    private async Task OnPersonasFile(InputFileChangeEventArgs e) => _personasFile = await LeerArchivoAsync(e, "personas");

    private async Task<(string, byte[])?> LeerArchivoAsync(InputFileChangeEventArgs e, string cual)
    {
        if (e.File is null) return null;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            var nombre = e.File.Name;
            _ = PushBotAsync(cual == "estructura"
                ? $"Recibí {nombre} 📄 Lo leo y cargo las unidades apenas creemos la copropiedad."
                : $"Recibí {nombre} 📄 Vinculo a cada persona con su unidad al final del recorrido.");
            return (nombre, ms.ToArray());
        }
        catch (Exception ex)
        {
            _ = PushBotAsync("No pude leer el archivo (" + ex.Message + "). Revisa que sea un .xlsx de máximo 10 MB.");
            return null;
        }
    }

    private async Task DescargarPlantillaAsync(string tipo)
    {
        if (_descargando) return;
        _descargando = true;
        try
        {
            var (url, nombre) = tipo == "directorio"
                ? ("/api/bienvenida/plantilla-directorio", "plantilla-directorio-propia.xlsx")
                : ("/api/bienvenida/plantilla-distribucion", "plantilla-unidades-propia.xlsx");
            var bytes = await Auth().GetByteArrayAsync(url);
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", nombre,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
            await PushBotAsync("¡Aquí la tienes! Llénala y me la subes cuando quieras.");
        }
        catch
        {
            await PushBotAsync("No pude generar esa plantilla ahora mismo — también la encuentras luego dentro del módulo correspondiente.");
        }
        finally { _descargando = false; StateHasChanged(); }
    }

    private async Task GenerarDescripcionAsync()
    {
        if (_generandoDesc) return;
        if (string.IsNullOrWhiteSpace(_cop.Nombre))
        {
            await PushBotAsync("Ponle primero el nombre a la copropiedad y con eso te redacto la descripción ✍️");
            return;
        }
        _generandoDesc = true;
        StateHasChanged();
        try
        {
            var req = new DescReq(_cop.Nombre.Trim(), _cop.Tipo.ToString(), Vacio(_cop.Ciudad), Vacio(_cop.Departamento),
                ((int)_cop.Estrato).ToString(), Vacio(_cop.Descripcion));
            var resp = await Auth().PostAsJsonAsync("/api/bienvenida/generar-descripcion", req);
            ChatResp? dto = resp.IsSuccessStatusCode ? await resp.Content.ReadFromJsonAsync<ChatResp>() : null;
            if (dto is { Ok: true } && !string.IsNullOrWhiteSpace(dto.Texto))
            {
                _cop.Descripcion = dto.Texto.Trim();
                await PushBotAsync("Le di una primera pasada a la descripción con lo que llevas ✍️ Ajústala a tu gusto — o cámbiale el tono y me dices.");
            }
            else
            {
                _cop.Descripcion = DescripcionLocal();
                await PushBotAsync("La IA de la plataforma no está disponible ahora, así que te dejé un borrador mío. Ajústalo a tu gusto.");
            }
        }
        catch
        {
            _cop.Descripcion = DescripcionLocal();
            await PushBotAsync("La IA de la plataforma no está disponible ahora, así que te dejé un borrador mío. Ajústalo a tu gusto.");
        }
        finally { _generandoDesc = false; StateHasChanged(); }
    }

    private string DescripcionLocal()
    {
        var ciudad = string.IsNullOrWhiteSpace(_cop.Ciudad) ? "" : $" ubicada en {_cop.Ciudad}";
        return $"{_cop.Nombre.Trim()} es una copropiedad {_cop.Tipo.ToString().ToLowerInvariant()}{ciudad}, comprometida con la sana convivencia, el cuidado de sus zonas comunes y una administración cercana a sus residentes.";
    }

    // ---------- cierre: crear + cargas + confetti ----------
    private async Task FinishAsync()
    {
        if (string.IsNullOrWhiteSpace(_cop.Nombre))
        {
            var idx = _pasos.IndexOf("copropiedad");
            if (idx >= 0 && idx != _pasoIdx) await GoAsync(idx, idx > _pasoIdx ? 1 : -1);
            return;
        }

        _finalizando = true;
        _crearError = null;
        _finalLineas.Clear();
        StateHasChanged();

        // 1. Crear copropiedad (y organizacion si hace falta)
        var linea = AddFinal($"Creando {_cop.Nombre.Trim()}...");
        CreadaResp? creada = null;
        try
        {
            var req = new CrearReq(
                _perfil == "empresa", Vacio(_empresaNombre), Vacio(_empresaNit),
                _cop.Nombre.Trim(), Vacio(_cop.Nit), Vacio(_cop.Dv),
                (int)_cop.Tipo, (int)_cop.Estrato,
                Vacio(_cop.Direccion), Vacio(_cop.Departamento), Vacio(_cop.Ciudad),
                Vacio(_cop.Telefono), Vacio(_cop.Email), Vacio(_cop.Descripcion));
            var resp = await Auth().PostAsJsonAsync("/api/bienvenida/crear", req);
            if (resp.IsSuccessStatusCode)
            {
                creada = await resp.Content.ReadFromJsonAsync<CreadaResp>();
            }
            else
            {
                var err = await LeerErrorAsync(resp);
                Marcar(linea, "err", $"No se pudo crear la copropiedad");
                _crearError = err;
                StateHasChanged();
                return;
            }
        }
        catch (Exception ex)
        {
            Marcar(linea, "err", "No se pudo crear la copropiedad");
            _crearError = ex.Message;
            StateHasChanged();
            return;
        }
        if (creada is null)
        {
            Marcar(linea, "err", "Respuesta inesperada del servidor");
            _crearError = "Intenta de nuevo en un momento.";
            StateHasChanged();
            return;
        }
        Marcar(linea, "ok", $"Copropiedad {creada.Nombre} creada");
        StateHasChanged();

        // 2. Entrar a la copropiedad nueva (token con tenant para RLS)
        linea = AddFinal("Entrando a tu copropiedad...");
        StateHasChanged();
        try
        {
            var swResp = await Auth().PostAsJsonAsync("/connect/switch-tenant", new SwitchTenantRequestDto(creada.TenantId));
            if (swResp.IsSuccessStatusCode)
            {
                var dto = await swResp.Content.ReadFromJsonAsync<LoginResponseDto>();
                if (!string.IsNullOrWhiteSpace(dto?.AccessToken))
                {
                    _jwt = dto!.AccessToken;
                    await Js.InvokeVoidAsync("propiaAuth.save", _jwt, creada.TenantId.ToString(), creada.Nombre);
                    try { await Js.InvokeVoidAsync("propiaUI.refreshAuthCta"); } catch { }
                }
            }
            Marcar(linea, "ok", "Sesión lista");
        }
        catch
        {
            Marcar(linea, "warn", "Creada, pero no pude activar la sesión — entra desde el selector");
        }
        StateHasChanged();

        // 3. Estructura (torres y unidades)
        if (_estructuraFile is { } ef)
        {
            linea = AddFinal("Cargando torres y unidades...");
            StateHasChanged();
            var ok = await SubirExcelAsync("/api/mi-copropiedad/distribucion/importar", ef.Nombre, ef.Bytes);
            Marcar(linea, ok ? "ok" : "warn", ok
                ? "Torres y unidades cargadas"
                : "La estructura no cargó — súbela luego en Mi Copropiedad, quedó guardada tu plantilla");
            StateHasChanged();
        }

        // 4. Personas (directorio)
        if (_personasFile is { } pf)
        {
            linea = AddFinal("Cargando propietarios y residentes...");
            StateHasChanged();
            var ok = await SubirExcelAsync("/api/directorio/importar", pf.Nombre, pf.Bytes);
            Marcar(linea, ok ? "ok" : "warn", ok
                ? "Directorio cargado y vinculado"
                : "El directorio no cargó — súbelo luego en Directorio");
            StateHasChanged();
        }

        // 5. Celebrar y entrar al producto
        _completado = true;
        AddFinal("¡Todo listo! Entrando a tu copropiedad...").Estado = "ok";
        LanzarConfetti();
        StateHasChanged();
        await Task.Delay(2400);
        Nav.NavigateTo("/mi-copropiedad", forceLoad: true);
    }

    private async Task<bool> SubirExcelAsync(string url, string nombre, byte[] bytes)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(bytes), "file", nombre);
            var resp = await Auth().PostAsync(url, content);
            return resp.IsSuccessStatusCode;
        }
        catch { return false; }
    }

    private FinalLinea AddFinal(string texto)
    {
        var l = new FinalLinea { Texto = texto, Estado = "run" };
        _finalLineas.Add(l);
        return l;
    }

    private static void Marcar(FinalLinea l, string estado, string texto)
    {
        l.Estado = estado;
        l.Texto = texto;
    }

    private void LanzarConfetti()
    {
        _confetti.Clear();
        string[] cols = { "#5955D1", "#7A77E0", "#22A362", "#E8A13C", "#1D63D8" };
        var rnd = Random.Shared;
        for (var i = 0; i < 42; i++)
        {
            var left = (rnd.NextDouble() * 100).ToString("F1", CultureInfo.InvariantCulture);
            var dur = (1.9 + rnd.NextDouble() * 1.6).ToString("F2", CultureInfo.InvariantCulture);
            var delay = (rnd.NextDouble() * .5).ToString("F2", CultureInfo.InvariantCulture);
            var rot = rnd.Next(0, 360);
            _confetti.Add($"left:{left}vw;background:{cols[i % cols.Length]};animation-duration:{dur}s;animation-delay:{delay}s;transform:rotate({rot}deg)");
        }
    }

