    .agent-head .t { font-weight: 800; font-size: 13.5px; }
    .agent-head .s { font-size: 11px; color: #B9F3D2; display: flex; align-items: center; gap: 5px; }
    .agent-head .s::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #4ADE80; box-shadow: 0 0 6px #4ADE80; }
    .agent-msgs { flex: 1; overflow-y: auto; padding: 16px 14px; display: flex; flex-direction: column; gap: 10px; min-height: 0; }
    .ob-bub {
        max-width: 92%; background: var(--ob-surface); border: 1px solid var(--ob-border);
        border-radius: 14px 14px 14px 5px; box-shadow: 0 2px 6px rgba(41, 41, 75, .05);
        padding: 10px 13px; font-size: 12.8px; color: var(--ob-ink-soft); line-height: 1.55; animation: obBubIn .25s ease;
    }
    .ob-bub.me {
        align-self: flex-end; color: #fff; border: 0;
        background: linear-gradient(135deg, var(--ob-brand-3), var(--ob-brand));
        border-radius: 14px 14px 5px 14px; box-shadow: 0 4px 10px rgba(89, 85, 209, .28);
    }
    .ob-bub .dl {
        display: inline-flex; align-items: center; gap: 7px; padding: 7px 11px; border-radius: 9px;
        background: var(--ob-brand-soft); color: var(--ob-brand); font-weight: 700; font-size: 12px; border: 0; cursor: pointer;
    }
    @@keyframes obBubIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .ob-typing { display: inline-flex; gap: 4px; padding: 2px; }
    .ob-typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--ob-brand-3); animation: obTy 1s infinite; }
    .ob-typing i:nth-child(2) { animation-delay: .15s; }
    .ob-typing i:nth-child(3) { animation-delay: .3s; }
    @@keyframes obTy { 0%, 60%, 100% { transform: none; opacity: .4; } 30% { transform: translateY(-4px); opacity: 1; } }
    .agent-quick { padding: 8px 14px 4px; display: flex; gap: 7px; overflow-x: auto; scrollbar-width: none; }
    .agent-quick::-webkit-scrollbar { display: none; }
    .ob-qr {
        flex: 0 0 auto; border: 1px solid var(--ob-brand-line); background: var(--ob-surface); color: var(--ob-brand);
        border-radius: 18px; padding: 6px 12px; font-size: 12px; font-weight: 700; white-space: nowrap; cursor: pointer;
    }
    .ob-qr:hover { background: var(--ob-brand-soft); }
    .agent-input {
        display: flex; align-items: center; gap: 8px; margin: 8px 12px 14px; padding: 5px 5px 5px 15px;
        background: var(--ob-surface); border: 1.5px solid var(--ob-border); border-radius: 24px;
        transition: border-color .13s, box-shadow .13s;
    }
    .agent-input:focus-within { border-color: var(--ob-brand-2); box-shadow: 0 0 0 3px var(--ob-brand-soft); }
    .agent-input input {
        flex: 1; min-width: 0; border: 0; outline: none; background: transparent;
        font-size: 13px; color: var(--ob-ink); padding: 8px 0; font-family: inherit;
    }
    .agent-input input::placeholder { color: var(--ob-faint); }
    .agent-send {
        width: 36px; height: 36px; flex: 0 0 36px; border-radius: 50%; border: 0;
        background: linear-gradient(135deg, var(--ob-brand-3), var(--ob-brand)); color: #fff;
        display: grid; place-items: center; transition: transform .12s; cursor: pointer;
    }
    .agent-send:hover { transform: scale(1.07); }

    /* confetti */
    .ob-confetti { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 1100; }
    .ob-confetti i { position: absolute; top: -12px; width: 9px; height: 14px; border-radius: 2px; animation: obFall linear forwards; }
    @@keyframes obFall { to { transform: translateY(105vh) rotate(720deg); opacity: .1; } }

    @@media (prefers-reduced-motion: reduce) {
        .ob, .ob-step, .ob-bub { animation: none; }
        .ob-confetti { display: none; }
        .ob-pick-card { transition: none; }
    }

    @@media (max-width: 980px) {
        .ob { grid-template-columns: 1fr; height: min(760px, calc(100vh - 24px)); }
        .agent { display: none; }
        .stage-head { padding-left: 22px; }
        .stage-body, .stage-foot { padding-left: 22px; padding-right: 22px; }
    }
</style>

@code {
    // ---------- estado general ----------
    private string? _jwt;
    private bool _modoNueva;
    private bool _modalOpen;
    private bool _completado;
    private bool _agentVisible = true;
    private string _nombreUsuario = "";
    private string? _perfil;               // "empresa" | "independiente"
    private string? _empresaNombre;
    private string? _empresaNit;
    private readonly CopForm _cop = new();
    private string? _estructuraModo;       // "excel" | "luego"
    private string? _dirModo;
    private (string Nombre, byte[] Bytes)? _estructuraFile;
    private (string Nombre, byte[] Bytes)? _personasFile;

    // pasos logicos: primera vez completo; modo=nueva salta bienvenida y perfil
    private List<string> _pasos = new() { "bienvenida", "perfil", "copropiedad", "estructura", "personas" };
    private int _pasoIdx;
    private string CurrentKey => _pasos[_pasoIdx];

    // transiciones direccionales (mismas curvas del prototipo)
    private bool _nav;
    private string? _exitKey;
    private string? _enterKey;
    private int _dir = 1;

    // chat
    private sealed record Bub(string Texto, bool Me, string? Plantilla = null);
    private readonly List<Bub> _msgs = new();
    private bool _typing;
    private string _chatInput = "";
    private readonly HashSet<string> _pasosSaludados = new();
    private bool _descargando;
    private bool _generandoDesc;

    // cierre
    private bool _finalizando;
    private string? _crearError;
    private sealed class FinalLinea { public string Texto = ""; public string Estado = "run"; }
    private readonly List<FinalLinea> _finalLineas = new();
    private readonly List<string> _confetti = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var uri = new Uri(Nav.Uri);
        _modoNueva = uri.Query.Contains("modo=nueva", StringComparison.OrdinalIgnoreCase);
        if (_modoNueva) _pasos = new List<string> { "copropiedad", "estructura", "personas" };

        try
        {
            _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
        }
        catch { }
        if (string.IsNullOrWhiteSpace(_jwt))
        {
            Nav.NavigateTo("/login?returnUrl=%2Fbienvenida", forceLoad: true);
            return;
        }

        try
        {
            var me = await Auth().GetFromJsonAsync<MeResponseDto>("/connect/me");
            if (me is not null)
            {
                if (!_modoNueva && me.AvailableTenants is { Count: > 0 })
                {
                    // Ya tiene copropiedades: este flujo no aplica, va al producto.
                    Nav.NavigateTo("/mi-copropiedad", forceLoad: true);
                    return;
                }
                _nombreUsuario = (me.PersonaNombres ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
                if (string.IsNullOrWhiteSpace(_cop.Email)) _cop.Email = null; // el email de contacto es de la copropiedad, no del usuario
            }
        }
        catch { /* si /connect/me falla seguimos: el flujo pide el nombre igual */ }

        await Task.Delay(500);
        AbrirModal();
        StateHasChanged();
    }

    private void AbrirModal()
    {
        _modalOpen = true;
        _ = SaludarPasoAsync();
    }

    private void CerrarModal()
    {
        if (_finalizando) return;
        _modalOpen = false;
        if (_modoNueva) Nav.NavigateTo("/mi-copropiedad");
    }

    // ---------- navegacion entre pasos ----------
    private int HairPct()
    {
        var pct = (int)Math.Round(100.0 * _pasoIdx / Math.Max(1, _pasos.Count - 1));
        return Math.Max(4, pct);
    }

    private static string TituloPaso(string key) => key switch
    {
        "bienvenida" => "Bienvenida",
        "perfil" => "Tu perfil",
        "copropiedad" => "Co-propiedad",
        "estructura" => "Estructura",
        _ => "Personas"
    };

    private string TituloCopropiedad() =>
        _perfil == "empresa" && !string.IsNullOrWhiteSpace(_empresaNombre)
            ? $"La primera copropiedad de {_empresaNombre}"
            : (_modoNueva ? "Creemos la nueva copropiedad" : "Creemos tu copropiedad");

    private string StepClass(string key)
    {
        var cls = "ob-step";
        if (key == "copropiedad") cls += " wide";
        if (_exitKey == key) return cls + " on " + (_dir > 0 ? "exit-up" : "exit-down");
        if (key == CurrentKey)
        {
            cls += " on";
            if (_enterKey == key) cls += _dir > 0 ? " enter-from-down" : " enter-from-up";
        }
        return cls;
    }

    private bool EsUltimoPaso() => _pasoIdx == _pasos.Count - 1;

    private bool MostrarOmitir() => CurrentKey is "perfil" or "estructura" or "personas" && !EsUltimoPaso() || CurrentKey == "estructura";

    private async Task NextAsync(bool skip)
    {
        if (_nav) return;
        if (EsUltimoPaso())
        {
            await FinishAsync();
            return;
        }
        if (!skip && !Commit()) return;
        await GoAsync(_pasoIdx + 1, 1);
    }

    private async Task BackAsync()
    {
        if (_nav || _pasoIdx == 0) return;
        await GoAsync(_pasoIdx - 1, -1);
    }

    private async Task GoAsync(int destino, int dir)
    {
        _nav = true;
        _dir = dir;
        _exitKey = CurrentKey;
        StateHasChanged();
        await Task.Delay(240);
        _exitKey = null;
        _pasoIdx = destino;
        _enterKey = CurrentKey;
        try { await Js.InvokeVoidAsync("eval", "var b=document.querySelector('.stage-body'); if(b) b.scrollTop=0;"); } catch { }
        StateHasChanged();
        _ = SaludarPasoAsync();
        await Task.Delay(500);
        _enterKey = null;
        _nav = false;
        StateHasChanged();
    }

    private bool Commit()
    {
        if (CurrentKey == "bienvenida")
        {
            _nombreUsuario = _nombreUsuario.Trim();
            if (string.IsNullOrWhiteSpace(_nombreUsuario)) return false;
            _ = PushBotAsync($"¡Un gusto, {_nombreUsuario}! Sigamos 🙌", instant: true);
        }
        if (CurrentKey == "copropiedad" && string.IsNullOrWhiteSpace(_cop.Nombre)) return false;
        return true;
    }

