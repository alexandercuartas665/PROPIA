    .stage > * { position: relative; }
    .stage-head { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding: 18px 20px 0 46px; }
    .stage-head .paso-lbl { font-size: 11.5px; font-weight: 700; color: var(--ob-faint); letter-spacing: .04em; font-variant-numeric: tabular-nums; display: flex; align-items: center; gap: 12px; }
    .ob-iconbtn { border: 0; background: transparent; color: var(--ob-faint); padding: 7px; border-radius: 9px; display: grid; place-items: center; cursor: pointer; }
    .ob-iconbtn:hover { background: var(--ob-bg); color: var(--ob-ink-soft); }

    /* GOTCHA flexbox: centrar con margin auto dentro de un scroller recorta el tope cuando el
       contenido es mas alto que el area. Espaciadores ::before/::after: centran los pasos cortos
       y colapsan (min-height) cuando el paso es largo y debe scrollear. */
    .stage-body { flex: 1; overflow-y: auto; padding: 8px 46px 20px; display: flex; flex-direction: column; min-height: 0; }
    .stage-body::before, .stage-body::after { content: ""; flex: 1 1 0; min-height: 14px; }
    .stage-foot {
        flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 10px;
        padding: 14px 46px 20px;
        background: linear-gradient(to top, #FDFDFF 72%, rgba(253, 253, 255, 0));
