@page "/bienvenida"
@layout WizardLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Shared.Auth
@using Propia.Domain.Enums
@using Propia.Web.Services
@using System.Net.Http.Json
@using System.Globalization
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Bienvenida - PROPIA</PageTitle>

@* Onboarding de bienvenida (spec: prototipo onboarding-propia-sin-textura.html aprobado).
   Se activa cuando el usuario entra SIN copropiedades (Login redirige aqui con JWT sin tenant)
   y tambien desde el selector de copropiedad con ?modo=nueva (ahi salta directo a la ficha).
   El asistente es un agente de PLATAFORMA (config global de IA del Super Admin): conversa via
   /api/bienvenida/asistente y cae a respuestas locales si la IA no esta configurada. *@

@if (!_modalOpen && !_modoNueva)
{
    <div class="ob-home">
        @if (_pasoIdx > 0 && !_completado)
        {
            <div class="ob-resume">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5955D1" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                <span class="tx">Dejaste tu configuración a medias — <b>paso @(_pasoIdx + 1) de @_pasos.Count</b>. Retómala cuando quieras.</span>
                <button class="ob-btn brand" @onclick="AbrirModal">Continuar configuración</button>
            </div>
        }
        <div class="ob-empty">
            <div class="ico">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6M9 11h.01M15 11h.01"/></svg>
            </div>
            <h2>Todo listo para empezar</h2>
            <p>Aún no tienes copropiedades. Te acompañamos paso a paso para crear la primera — toma unos minutos y puedes saltar lo que quieras.</p>
            <button class="ob-btn brand" style="margin-top:8px" @onclick="AbrirModal">Empezar</button>
        </div>
    </div>
}

@if (_modalOpen)
{
    <div class="ob-backdrop" @onclick="CerrarModal">
        <div class="ob @(_agentVisible ? "" : "no-agent")" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Configuración inicial">
            <div class="prog-hair"><i style="width:@(HairPct())%"></i></div>

            <section class="stage">
                <div class="stage-head">
                    <span class="paso-lbl">
                        <span>Paso @(_pasoIdx + 1) de @_pasos.Count · @TituloPaso(CurrentKey)</span>
                        <span class="ob-dots" aria-hidden="true">
                            @for (var i = 0; i < _pasos.Count; i++)
                            {
                                <i class="@(i == _pasoIdx ? "now" : (i < _pasoIdx ? "done" : ""))"></i>
                            }
                        </span>
                    </span>
                    <span style="display:flex;gap:4px">
                        <button class="ob-iconbtn" title="Mostrar u ocultar asistente" @onclick="() => _agentVisible = !_agentVisible">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-.9L3 21l2-4.9a8.4 8.4 0 1 1 16-4.6z"/></svg>
                        </button>
                        <button class="ob-iconbtn" title="Cerrar (tu avance queda en esta sesión)" @onclick="CerrarModal">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        </button>
                    </span>
                </div>

                <div class="stage-body">

                    @* -------- Paso: Bienvenida -------- *@
                    <div class="@StepClass("bienvenida")">
                        <div class="ob-kicker">Bienvenida</div>
                        <h2>Hola, qué bueno tenerte aquí</h2>
                        <p class="lead">Vamos a dejar tu operación lista en unos minutos. Primero lo primero: ¿cómo quieres que te llamemos?</p>
                        <div class="ob-field">
                            <label>Tu nombre</label>
                            <input class="ob-in ob-in-lg" @bind="_nombreUsuario" @bind:event="oninput" placeholder="Ej. Alexander" autocomplete="off" />
                        </div>
                    </div>

                    @* -------- Paso: Tu perfil -------- *@
                    <div class="@StepClass("perfil")">
                        <div class="ob-kicker">Tu perfil</div>
                        <h2>¿Cómo administras?</h2>
                        <p class="lead">Esto nos ayuda a organizar tu espacio de trabajo.</p>
                        <div class="ob-pick">
                            <button class="ob-pick-card @(_perfil == "empresa" ? "sel" : "")" @onclick="@(() => PickPerfil("empresa"))">
                                <span class="pc-ico"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16M9 7h.01M15 7h.01M9 11h.01M15 11h.01M9 15h.01M15 15h.01"/></svg></span>
                                <span class="pc-t">Empresa administradora</span>
                                <span class="pc-s">Administro varias copropiedades con mi equipo.</span>
                            </button>
                            <button class="ob-pick-card @(_perfil == "independiente" ? "sel" : "")" @onclick="@(() => PickPerfil("independiente"))">
                                <span class="pc-ico"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"/></svg></span>
                                <span class="pc-t">Administrador independiente</span>
                                <span class="pc-s">Administro directamente mi copropiedad.</span>
                            </button>
                        </div>
                        @if (_perfil == "empresa")
                        {
                            <div class="ob-subpanel">
                                <div class="ob-row2">
                                    <div class="ob-field"><label>Nombre de la empresa</label><input class="ob-in" @bind="_empresaNombre" placeholder="Ej. A&D Group S.A.S" /></div>
                                    <div class="ob-field"><label>NIT</label><input class="ob-in" @bind="_empresaNit" placeholder="900123456-7" /></div>
                                </div>
                            </div>
                        }
                    </div>

                    @* -------- Paso: Co-propiedad (ficha completa por secciones) -------- *@
                    <div class="@StepClass("copropiedad")">
                        <div class="ob-kicker">@(_modoNueva ? "Nueva co-propiedad" : "Tu primera co-propiedad")</div>
                        <h2>@TituloCopropiedad()</h2>
                        <p class="lead">Solo el nombre es obligatorio — lo demás lo llenas aquí o después, con calma.</p>

                        <div class="ob-seck">Identidad</div>
                        <div class="ob-field">
                            <label>Nombre de la copropiedad *</label>
                            <input class="ob-in ob-in-lg" @bind="_cop.Nombre" @bind:event="oninput" placeholder="Ej. Conjunto Altos del Bosque" />
                        </div>
                        <div class="ob-row3">
                            <div class="ob-field"><label>Tipo</label>
                                <select class="ob-in" @bind="_cop.Tipo">
                                    @foreach (var t in (TipoCopropiedad[])Enum.GetValues(typeof(TipoCopropiedad)))
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="ob-field"><label>NIT (opcional)</label><input class="ob-in" @bind="_cop.Nit" @bind:event="oninput" @bind:after="CalcDV" inputmode="numeric" placeholder="900123456" /></div>
                            <div class="ob-field"><label>DV</label><input class="ob-in" value="@_cop.Dv" readonly placeholder="—" title="Se calcula solo con el algoritmo DIAN" /></div>
                        </div>

                        <div class="ob-seck">Ubicación</div>
                        <div class="ob-row2">
                            <div class="ob-field"><label>Departamento</label>
                                <select class="ob-in" @bind="_cop.Departamento" @bind:after="OnDeptoCambio">
                                    <option value="">Seleccionar...</option>
                                    @foreach (var d in ColombiaCatalogo.DepartamentosColombia)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            <div class="ob-field"><label>Ciudad</label>
                                <select class="ob-in" @bind="_cop.Ciudad" disabled="@string.IsNullOrWhiteSpace(_cop.Departamento)">
                                    <option value="">Seleccionar...</option>
                                    @foreach (var c in ColombiaCatalogo.CiudadesDelDepartamento(_cop.Departamento))
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="ob-row2">
                            <div class="ob-field"><label>Dirección</label><input class="ob-in" @bind="_cop.Direccion" placeholder="Cra 45 # 100-20" /></div>
                            <div class="ob-field"><label>Estrato</label>
                                <select class="ob-in" @bind="_cop.Estrato">
                                    @foreach (var e in (Estrato[])Enum.GetValues(typeof(Estrato)))
                                    {
                                        <option value="@e">@((int)e)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="ob-seck">Contacto de la administración</div>
                        <div class="ob-row2">
                            <div class="ob-field"><label>Teléfono</label><input class="ob-in" @bind="_cop.Telefono" placeholder="604 444 55 66" /></div>
                            <div class="ob-field"><label>Email</label><input class="ob-in" @bind="_cop.Email" placeholder="administracion@tucopropiedad.co" /></div>
                        </div>

                        <div class="ob-seck">Presentación</div>
                        <div class="ob-field">
                            <label class="ob-lbl-ia">Descripción breve
                                <button type="button" class="ob-ia-btn" @onclick="GenerarDescripcionAsync" disabled="@_generandoDesc">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.9 2.4L22 18l-2.1.6L19 21l-.9-2.4L16 18l2.1-.6z"/></svg>
                                    @(_generandoDesc ? "Redactando..." : "Generar con IA")
                                </button>
                            </label>
                            <textarea class="ob-in ob-ta" rows="3" @bind="_cop.Descripcion" placeholder="Una frase que presente tu copropiedad (o pídesela a la IA)..."></textarea>
                        </div>
                    </div>

                    @* -------- Paso: Estructura -------- *@
                    <div class="@StepClass("estructura")">
                        <div class="ob-kicker">La estructura</div>
                        <h2>Torres y unidades</h2>
                        <p class="lead">Es la columna vertebral de todo: cuotas, directorio, portería. Elige cómo cargarla.</p>
                        <div class="ob-pick">
                            <button class="ob-pick-card @(_estructuraModo == "excel" ? "sel" : "")" @onclick="@(() => PickEstructura("excel"))">
                                <span class="pc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
                                <span class="pc-t">Tengo un Excel</span>
                                <span class="pc-s">Te doy una plantilla o me subes el que tengas.</span>
                            </button>
                            <button class="ob-pick-card @(_estructuraModo == "luego" ? "sel" : "")" @onclick="@(() => PickEstructura("luego"))">
                                <span class="pc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
                                <span class="pc-t">Después</span>
                                <span class="pc-s">Lo harás desde Mi Copropiedad.</span>
                            </button>
                        </div>
                        @if (_estructuraModo == "excel")
                        {
                            <div class="ob-subpanel">
                                @if (_estructuraFile is null)
                                {
                                    <p style="font-size:13.5px;color:var(--ob-ink-soft);margin:0 0 10px">1 · Descarga la plantilla, llénala y súbela — o sube directo el archivo que ya tienes.</p>
                                    <button class="ob-filechip" @onclick="@(() => DescargarPlantillaAsync("unidades"))" disabled="@_descargando">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                                        plantilla-unidades-propia.xlsx
                                    </button>
                                    <label class="ob-drop" style="margin-top:12px">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M17 8l-5-5-5 5"/><path d="M12 3v12"/></svg>
                                        <b>Arrastra tu Excel aquí o haz clic</b><span>Se carga apenas creemos la copropiedad</span>
                                        <InputFile OnChange="OnEstructuraFile" accept=".xlsx" style="display:none" />
                                    </label>
                                }
                                else
                                {
                                    <span class="ob-filechip">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                        @_estructuraFile.Value.Nombre
                                        <button class="x" title="Quitar" @onclick="() => _estructuraFile = null">&times;</button>
                                    </span>
                                    <p style="font-size:12.5px;color:var(--ob-muted);margin:10px 0 0">Listo. Lo cargo apenas la copropiedad quede creada y te cuento qué encontré.</p>
                                }
                            </div>
                        }
                    </div>

                    @* -------- Paso: Personas -------- *@
                    <div class="@StepClass("personas")">
                        <div class="ob-kicker">Las personas</div>
                        <h2>Propietarios y residentes</h2>
                        <p class="lead">Con el directorio vivo, la comunicación y la cartera cobran sentido.</p>
                        <div class="ob-pick">
                            <button class="ob-pick-card @(_dirModo == "excel" ? "sel" : "")" @onclick="@(() => PickDir("excel"))">
                                <span class="pc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
                                <span class="pc-t">Subir mi Excel</span>
                                <span class="pc-s">El asistente te da la plantilla del directorio.</span>
                            </button>
                            <button class="ob-pick-card @(_dirModo == "luego" ? "sel" : "")" @onclick="@(() => PickDir("luego"))">
                                <span class="pc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
                                <span class="pc-t">Después</span>
                                <span class="pc-s">Podrás invitar gente en cualquier momento.</span>
                            </button>
                        </div>
                        @if (_dirModo == "excel")
                        {
                            <div class="ob-subpanel">
                                @if (_personasFile is null)
                                {
                                    <button class="ob-filechip" @onclick="@(() => DescargarPlantillaAsync("directorio"))" disabled="@_descargando">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                                        plantilla-directorio-propia.xlsx
                                    </button>
                                    <label class="ob-drop" style="margin-top:12px">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M17 8l-5-5-5 5"/><path d="M12 3v12"/></svg>
                                        <b>Arrastra tu Excel de personas o haz clic</b><span>Nombres, documentos, unidades y roles</span>
                                        <InputFile OnChange="OnPersonasFile" accept=".xlsx" style="display:none" />
                                    </label>
                                }
                                else
                                {
                                    <span class="ob-filechip">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                        @_personasFile.Value.Nombre
                                        <button class="x" title="Quitar" @onclick="() => _personasFile = null">&times;</button>
                                    </span>
                                    <p style="font-size:12.5px;color:var(--ob-muted);margin:10px 0 0">Perfecto. Vinculo a cada persona con su unidad al crear la copropiedad.</p>
                                }
                            </div>
                        }
                    </div>

                </div>

                <div class="stage-foot">
                    <button class="ob-btn ghost" style="visibility:@(_pasoIdx == 0 ? "hidden" : "visible")" @onclick="BackAsync">← Volver</button>
                    <div style="display:flex;gap:10px;align-items:center">
                        @if (MostrarOmitir())
                        {
                            <button class="ob-btn ghost" @onclick="() => NextAsync(true)">Omitir por ahora</button>
                        }
                        <button class="ob-btn brand" @onclick="() => NextAsync(false)" disabled="@_nav">
                            @(EsUltimoPaso() ? "Crear mi co-propiedad" : "Continuar")
                        </button>
                    </div>
                </div>

                @if (_finalizando)
                {
                    <div class="ob-final">
                        <div class="ob-final-card">
                            @if (_crearError is null)
                            {
                                <div class="ob-spin"></div>
                            }
                            <h3>@(_crearError is null ? "Creando tu copropiedad..." : "Algo no salió bien")</h3>
                            <div class="ob-final-list">
                                @foreach (var l in _finalLineas)
                                {
                                    <div class="ob-final-item @l.Estado">
                                        @if (l.Estado == "ok")
                                        {
                                            <span class="mk ok">✓</span>
                                        }
                                        else if (l.Estado == "warn")
                                        {
                                            <span class="mk warn">!</span>
                                        }
                                        else if (l.Estado == "err")
                                        {
                                            <span class="mk err">✕</span>
                                        }
                                        else
                                        {
                                            <span class="mk run"></span>
                                        }
                                        <span>@l.Texto</span>
                                    </div>
                                }
                            </div>
                            @if (_crearError is not null)
                            {
                                <div class="ob-final-error">@_crearError</div>
                                <button class="ob-btn" @onclick="() => { _finalizando = false; _crearError = null; }">Volver al formulario</button>
                            }
                        </div>
                    </div>
                }
            </section>

            @* -------- Asistente (agente de plataforma) -------- *@
            <aside class="agent" aria-label="Asistente">
                <div class="agent-head">
                    <div class="agent-ava">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="7" width="16" height="12" rx="3"/><circle cx="9" cy="13" r="1.3" fill="currentColor"/><circle cx="15" cy="13" r="1.3" fill="currentColor"/><path d="M12 7V4M8 4h8"/></svg>
                    </div>
                    <div>
                        <div class="t">Auxiliar de PROPIA</div>
                        <div class="s">en línea, contigo</div>
                    </div>
                </div>
                <div class="agent-msgs" id="obAgentMsgs">
                    @foreach (var m in _msgs)
                    {
                        @if (m.Plantilla is not null)
                        {
                            <div class="ob-bub">
                                <button class="dl" @onclick="@(() => DescargarPlantillaAsync(m.Plantilla))" disabled="@_descargando">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                                    @(m.Plantilla == "directorio" ? "plantilla-directorio-propia.xlsx" : "plantilla-unidades-propia.xlsx")
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="ob-bub @(m.Me ? "me" : "")">@m.Texto</div>
                        }
                    }
                    @if (_typing)
                    {
                        <div class="ob-bub"><span class="ob-typing"><i></i><i></i><i></i></span></div>
                    }
                </div>
                <div class="agent-quick">
                    @foreach (var q in QuickChips())
                    {
                        <button class="ob-qr" @onclick="@(() => QuickAsync(q))">@q</button>
                    }
                </div>
                <form class="agent-input" @onsubmit="EnviarAsync" @onsubmit:preventDefault>
                    <input @bind="_chatInput" @bind:event="oninput" placeholder="Escríbele al asistente..." autocomplete="off" />
                    <button type="submit" class="agent-send" title="Enviar">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                    </button>
                </form>
            </aside>
        </div>
    </div>
}

@if (_confetti.Count > 0)
{
    <div class="ob-confetti">
        @foreach (var p in _confetti)
        {
            <i style="@p"></i>
        }
    </div>
}

<style>
    /* ============ Tokens del onboarding (paleta PROPIA, tema claro del producto) ============ */
    :root {
        --ob-brand: #5955D1;
        --ob-brand-2: #6D4FE3;
        --ob-brand-3: #7A77E0;
        --ob-brand-soft: #F1ECFD;
        --ob-brand-line: #D9D2F6;
        --ob-ink: #1B2A3A;
        --ob-ink-soft: #33475B;
        --ob-muted: #7C98B6;
        --ob-faint: #9AABBE;
        --ob-border: #E9EEF3;
        --ob-bg: #F7F8FB;
        --ob-surface: #FFFFFF;
        --ob-ok-bg: #E4F7EC; --ob-ok-fg: #16794C;
        --ob-warn-bg: #FFF6DE; --ob-warn-fg: #A16207;
        --ob-err-bg: #FDE8E8; --ob-err-fg: #C81E1E;
    }

    /* ============ Home de respaldo (cuando cierran el modal sin terminar) ============ */
    .ob-home { max-width: 860px; margin: 40px auto; padding: 0 24px; }
    .ob-resume {
        display: flex; align-items: center; gap: 12px; margin-bottom: 18px;
        background: var(--ob-brand-soft); border: 1px solid var(--ob-brand-line); border-radius: 14px; padding: 12px 16px;
    }
    .ob-resume .tx { flex: 1; font-size: 14px; color: var(--ob-ink-soft); }
    .ob-resume .tx b { color: var(--ob-brand); }
    .ob-empty {
        border: 1.5px dashed var(--ob-brand-line); border-radius: 18px; background: var(--ob-surface);
        padding: 64px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px;
    }
    .ob-empty .ico { width: 62px; height: 62px; border-radius: 18px; display: grid; place-items: center; background: var(--ob-brand-soft); color: var(--ob-brand); }
    .ob-empty h2 { margin: 8px 0 0; font-size: 19px; font-weight: 800; }
    .ob-empty p { margin: 0; color: var(--ob-muted); font-size: 14px; max-width: 46ch; }

    .ob-btn {
        display: inline-flex; align-items: center; gap: 7px; border-radius: 11px; border: 1px solid var(--ob-border);
        background: var(--ob-surface); color: var(--ob-ink-soft); font-weight: 700; font-size: 14px; padding: 10px 18px; cursor: pointer;
    }
    .ob-btn:hover { border-color: var(--ob-brand-2); color: var(--ob-brand-2); }
    .ob-btn.brand { background: var(--ob-brand); border-color: var(--ob-brand); color: #fff; }
    .ob-btn.brand:hover { background: #4B47C4; color: #fff; }
    .ob-btn.ghost { border: 0; background: transparent; color: var(--ob-muted); }
    .ob-btn.ghost:hover { color: var(--ob-brand-2); }
    .ob-btn[disabled] { opacity: .45; cursor: default; pointer-events: none; }

    /* ============ Modal ============ */
    .ob-backdrop {
        position: fixed; inset: 0; background: rgba(23, 20, 55, .52); backdrop-filter: blur(3px);
        display: flex; align-items: center; justify-content: center; padding: 24px; z-index: 1050;
    }
    .ob {
        width: calc(100vw - 44px); height: calc(100vh - 44px); max-width: 1680px;
