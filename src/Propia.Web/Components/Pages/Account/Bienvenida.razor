    .prog-hair { position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--ob-border); z-index: 5; }
    .prog-hair i {
        display: block; height: 100%;
        background: linear-gradient(90deg, var(--ob-brand-3), var(--ob-brand));
        transition: width .55s cubic-bezier(.25, .9, .3, 1); border-radius: 0 3px 3px 0;
    }
    .ob-dots { display: inline-flex; gap: 6px; align-items: center; }
    .ob-dots i { width: 6px; height: 6px; border-radius: 4px; background: var(--ob-border); transition: all .35s cubic-bezier(.25, .9, .3, 1); }
    .ob-dots i.done { background: var(--ob-brand-line); }
