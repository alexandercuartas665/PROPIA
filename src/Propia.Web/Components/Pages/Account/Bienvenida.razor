    .ob-filechip .x { color: var(--ob-faint); border: 0; background: none; padding: 0 2px; font-size: 15px; cursor: pointer; }
    .ob-filechip .x:hover { color: var(--ob-err-fg); }

    .ob-subpanel { margin-top: 16px; border-top: 1px solid var(--ob-border); padding-top: 16px; }

    /* ---- overlay de creacion (crear + cargas + confetti) ---- */
    .ob-final {
        position: absolute; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center;
        background: rgba(253, 253, 255, .93); backdrop-filter: blur(4px);
    }
    .ob-final-card { max-width: 460px; width: 100%; padding: 24px; text-align: center; }
    .ob-final-card h3 { margin: 14px 0 16px; font-size: 19px; font-weight: 800; color: var(--ob-ink); }
    .ob-final-list { display: flex; flex-direction: column; gap: 10px; text-align: left; margin-bottom: 16px; }
    .ob-final-item { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--ob-ink-soft); }
    .ob-final-item .mk { width: 22px; height: 22px; flex: 0 0 22px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 800; }
    .ob-final-item .mk.ok { background: var(--ob-ok-bg); color: var(--ob-ok-fg); }
    .ob-final-item .mk.warn { background: var(--ob-warn-bg); color: var(--ob-warn-fg); }
    .ob-final-item .mk.err { background: var(--ob-err-bg); color: var(--ob-err-fg); }
    .ob-final-item .mk.run { border: 3px solid var(--ob-brand-soft); border-top-color: var(--ob-brand); animation: obSpin .8s linear infinite; }
    .ob-final-error { background: var(--ob-err-bg); color: var(--ob-err-fg); border-radius: 10px; padding: 10px 14px; font-size: 13px; margin-bottom: 14px; text-align: left; }
    .ob-spin {
        width: 26px; height: 26px; border-radius: 50%; border: 3px solid var(--ob-brand-soft); border-top-color: var(--ob-brand);
        animation: obSpin .8s linear infinite; margin: 0 auto;
    }
    @@keyframes obSpin { to { transform: rotate(360deg); } }

    /* ---- panel del agente ---- */
    .agent { border-left: 1px solid var(--ob-border); background: #F8F8FD; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
    .agent-head {
        display: flex; align-items: center; gap: 10px; padding: 16px;
