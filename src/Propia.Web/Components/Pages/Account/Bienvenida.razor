    private string[] QuickChips() => Quick.TryGetValue(CurrentKey, out var q) ? q : Array.Empty<string>();

    private async Task SaludarPasoAsync()
    {
        if (!_pasosSaludados.Add(CurrentKey)) return;
        if (!Guiones.TryGetValue(CurrentKey, out var lineas)) return;
        await Task.Delay(350);
        foreach (var l in lineas)
        {
            _msgs.Add(new Bub(l, false));
            StateHasChanged();
            await ScrollChatAsync();
            await Task.Delay(750);
        }
    }

    private async Task QuickAsync(string t)
    {
        _msgs.Add(new Bub(t, true));
        StateHasChanged();
        await ScrollChatAsync();
        await MostrarTypingAsync();
        _msgs.Add(new Bub(Canned.TryGetValue(t, out var r) ? r : "Buena pregunta — cuéntame un poco más y te ayudo.", false));
        if (t == "Dame la plantilla") _msgs.Add(new Bub("", false, CurrentKey == "personas" ? "directorio" : "unidades"));
        StateHasChanged();
        await ScrollChatAsync();
    }

    private async Task EnviarAsync()
    {
        var t = _chatInput.Trim();
        if (t.Length == 0 || _typing) return;
        _chatInput = "";
        _msgs.Add(new Bub(t, true));
        StateHasChanged();
        await ScrollChatAsync();

        _typing = true;
        StateHasChanged();
        await ScrollChatAsync();
        var respuesta = await LlamarAsistenteAsync();
        _typing = false;

        string? plantilla = null;
        if (respuesta is null)
        {
            // Fallback local por palabras clave (la IA de plataforma no esta configurada o fallo)
            var low = t.ToLowerInvariant();
            if (low.Contains("plantilla") || low.Contains("excel") || low.Contains("archivo"))
            {
                respuesta = "Te dejo la plantilla de este paso aquí abajo. Y si tu archivo tiene otro formato, súbelo igual.";
                plantilla = CurrentKey == "personas" ? "directorio" : "unidades";
            }
            else if (low.Contains("estrato")) respuesta = Canned["¿Qué es el estrato?"];
            else if (low.Contains("borra") || low.Contains("elimina")) respuesta = Canned["¿Esto borra algo?"];
            else if (low.Contains("rol")) respuesta = Canned["¿Qué roles existen?"];
            else if (low.Contains("cambiar") || low.Contains("editar") || low.Contains("despues") || low.Contains("después")) respuesta = "Todo lo de este paso se puede editar después desde Mi Copropiedad — nada queda en piedra.";
            else if (low.Contains("hola") || low.Contains("gracias")) respuesta = $"¡Con gusto{(string.IsNullOrWhiteSpace(_nombreUsuario) ? "" : ", " + _nombreUsuario)}! Aquí sigo, paso a paso contigo.";
            else if (low.Contains("cuota") || low.Contains("cobr") || low.Contains("pago")) respuesta = "Los cobros viven en Finanzas: cuando termines este recorrido configuras el presupuesto y las cuotas.";
            else respuesta = "Anotado 📝 Sigamos con el paso y, si algo no cuadra, usa los botones de arriba o pregúntame de otra forma.";
        }
        _msgs.Add(new Bub(respuesta, false));
        if (plantilla is not null) _msgs.Add(new Bub("", false, plantilla));
        StateHasChanged();
        await ScrollChatAsync();
    }

    private async Task<string?> LlamarAsistenteAsync()
    {
        try
        {
            var turnos = _msgs.Where(m => m.Plantilla is null && !string.IsNullOrWhiteSpace(m.Texto))
                .TakeLast(16)
                .Select(m => new TurnoDto(m.Me ? "user" : "model", m.Texto))
                .ToList();
            var req = new ChatReq(SemanticIndex(CurrentKey), Vacio(_nombreUsuario), BuildContexto(), turnos);
            var resp = await Auth().PostAsJsonAsync("/api/bienvenida/asistente", req);
            if (!resp.IsSuccessStatusCode) return null;
            var dto = await resp.Content.ReadFromJsonAsync<ChatResp>();
            return dto is { Ok: true } && !string.IsNullOrWhiteSpace(dto.Texto) ? dto.Texto!.Trim() : null;
        }
        catch { return null; }
    }

    private string BuildContexto()
    {
        var partes = new List<string>();
        if (!string.IsNullOrWhiteSpace(_perfil)) partes.Add($"perfil: {(_perfil == "empresa" ? "empresa administradora" + (string.IsNullOrWhiteSpace(_empresaNombre) ? "" : $" ({_empresaNombre})") : "administrador independiente")}");
        if (!string.IsNullOrWhiteSpace(_cop.Nombre)) partes.Add($"copropiedad: {_cop.Nombre} ({_cop.Tipo}{(string.IsNullOrWhiteSpace(_cop.Ciudad) ? "" : ", " + _cop.Ciudad)})");
        partes.Add(_estructuraFile is not null ? $"estructura: archivo {_estructuraFile.Value.Nombre} listo para cargar" : $"estructura: {(_estructuraModo == "luego" ? "la deja para despues" : "sin definir")}");
        partes.Add(_personasFile is not null ? $"personas: archivo {_personasFile.Value.Nombre} listo para cargar" : $"personas: {(_dirModo == "luego" ? "las deja para despues" : "sin definir")}");
        return string.Join("; ", partes);
    }

    private async Task PushBotAsync(string texto, bool instant = false)
    {
        if (!instant)
        {
            await MostrarTypingAsync();
        }
        _msgs.Add(new Bub(texto, false));
        StateHasChanged();
        await ScrollChatAsync();
    }

    private async Task MostrarTypingAsync()
    {
        _typing = true;
        StateHasChanged();
        await ScrollChatAsync();
        await Task.Delay(750);
        _typing = false;
    }

    private async Task ScrollChatAsync()
    {
        try { await Js.InvokeVoidAsync("eval", "var m=document.getElementById('obAgentMsgs'); if(m) m.scrollTop=m.scrollHeight;"); } catch { }
    }

    // ---------- infra ----------
    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private static string? Vacio(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static async Task<string> LeerErrorAsync(HttpResponseMessage resp)
    {
        try
        {
            var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (err is not null && err.TryGetValue("error", out var m)) return m;
        }
        catch { }
        return "No se pudo crear la copropiedad. Intenta de nuevo.";
    }

