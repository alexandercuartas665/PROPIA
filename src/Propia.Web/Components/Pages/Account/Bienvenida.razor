    /* min-height:0 como item de grid: sin esto no se encoge y el scroll interno nunca aparece */
    .stage {
        display: flex; flex-direction: column; min-width: 0; min-height: 0; position: relative;
        background:
            radial-gradient(620px 400px at 88% -8%, rgba(109, 79, 227, .07), transparent 62%),
