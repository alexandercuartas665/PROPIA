@page "/oauth/gmail/callback"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Conectando Gmail - PROPIA</PageTitle>

<div class="ogc">
    <div class="ogc-card">
        @if (_estado == "cargando")
        {
            <div class="ogc-spin"></div>
            <div class="ogc-t">Conectando tu cuenta Gmail...</div>
            <div class="ogc-s">Un momento, estamos guardando la autorizacion.</div>
        }
        else if (_estado == "ok")
        {
            <div class="ogc-ic ok">&#10003;</div>
            <div class="ogc-t">Gmail conectado</div>
            <div class="ogc-s">Ya puedes enviar respuestas PQRSD por correo desde esta copropiedad.</div>
            <button class="ogc-btn" @onclick="Volver">Volver a PROPIA</button>
        }
        else
        {
            <div class="ogc-ic err">!</div>
            <div class="ogc-t">No se pudo conectar</div>
            <div class="ogc-s">@_error</div>
            <button class="ogc-btn" @onclick="Volver">Volver a PROPIA</button>
        }
    </div>
</div>

<style>
    .ogc { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #EEF1F6; padding: 24px; }
    .ogc-card { background: #fff; border: 1px solid #E4E9EF; border-radius: 16px; padding: 40px 44px; max-width: 440px; width: 100%; text-align: center; box-shadow: 0 12px 40px rgba(27,42,58,.10); }
    .ogc-t { font-size: 19px; font-weight: 800; color: #1B2A3A; margin-top: 14px; }
    .ogc-s { font-size: 13.5px; color: #63748A; margin-top: 8px; line-height: 1.5; }
    .ogc-btn { margin-top: 20px; padding: 11px 22px; border: 0; border-radius: 10px; background: #6D4FE3; color: #fff; font-size: 14px; font-weight: 700; cursor: pointer; }
    .ogc-ic { width: 56px; height: 56px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 30px; font-weight: 800; margin: 0 auto; }
    .ogc-ic.ok { background: #E7F6EE; color: #15703F; }
    .ogc-ic.err { background: #FDECEC; color: #C0383C; }
    .ogc-spin { width: 42px; height: 42px; border-radius: 50%; border: 4px solid #E1E8EE; border-top-color: #6D4FE3; margin: 0 auto; animation: ogcspin 0.8s linear infinite; }
    @@keyframes ogcspin { to { transform: rotate(360deg); } }
</style>

@code {
    private string _estado = "cargando";   // cargando | ok | error
    private string? _error;
    private bool _procesado;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _procesado) return;
        _procesado = true;
        await CompletarAsync();
    }

    private async Task CompletarAsync()
    {
        try
        {
            var uri = new Uri(Nav.Uri);
            var q = ParseQuery(uri.Query);
            var error = q.GetValueOrDefault("error");
            if (!string.IsNullOrEmpty(error))
            {
                _error = "Google devolvio: " + error; _estado = "error"; StateHasChanged(); return;
            }
            var code = q.GetValueOrDefault("code");
            var state = q.GetValueOrDefault("state");
            if (string.IsNullOrEmpty(code) || string.IsNullOrEmpty(state))
            {
                _error = "Faltan parametros de la autorizacion."; _estado = "error"; StateHasChanged(); return;
            }

            var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (string.IsNullOrEmpty(jwt))
            {
                _error = "Tu sesion no esta activa. Inicia sesion e intenta de nuevo."; _estado = "error"; StateHasChanged(); return;
            }

            var redirectUri = new Uri(new Uri(Nav.BaseUri), "oauth/gmail/callback").ToString();
            var http = HttpFactory.CreateClient("PropiaApi");
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", jwt);
            var resp = await http.PostAsJsonAsync("/api/gmail-envio/completar",
                new { Code = code, State = state, RedirectUri = redirectUri });
            if (resp.IsSuccessStatusCode)
            {
                _estado = "ok";
            }
            else
            {
                _error = "No se pudo guardar la conexion: " + await resp.Content.ReadAsStringAsync();
                _estado = "error";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message; _estado = "error";
        }
        StateHasChanged();
    }

    private void Volver() => Nav.NavigateTo("/pqrsd", forceLoad: true);

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query)) return d;
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var i = part.IndexOf('=');
            if (i < 0) { d[Uri.UnescapeDataString(part)] = ""; continue; }
            var k = Uri.UnescapeDataString(part[..i]);
            var v = Uri.UnescapeDataString(part[(i + 1)..]);
            d[k] = v;
        }
        return d;
    }
}
