@page "/admin/configuracion-menu"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Navegacion
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Menu del sistema - Plataforma</PageTitle>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-1">
    <div>
        <h1 class="h3 mb-1">Menu del sistema</h1>
        <p class="text-muted mb-0">Organiza el menu lateral del cliente: cambia el nombre visible, el orden y mueve items entre secciones. Puedes agregar secciones e items nuevos; los items sin funcion todavia abren una pagina "Proximamente". Es global: aplica a todas las copropiedades.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-outline-secondary" @onclick="ExportarJson" disabled="@(_busy || _sections is null)" title="Descargar la configuracion actual como JSON"><i class="fi fi-rr-download"></i> Exportar JSON</button>
        <label class="btn btn-outline-secondary mb-0" title="Cargar un JSON exportado (revisa y luego Guarda)">
            <i class="fi fi-rr-upload"></i> Importar JSON
            <InputFile OnChange="ImportarJson" accept=".json" style="display:none" />
        </label>
        <button class="btn btn-outline-primary" @onclick="AgregarSeccion" disabled="@(_busy || _sections is null)"><i class="fi fi-rr-plus"></i> Agregar seccion</button>
        <button class="btn btn-outline-secondary" @onclick="ResetAsync" disabled="@(_busy || _sections is null)">Restablecer base</button>
        <button class="btn btn-dark" @onclick="GuardarAsync" disabled="@(_busy || _sections is null)">@(_busy ? "Guardando..." : "Guardar cambios")</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="alert @_msgCls py-2">@_msg</div>
}

@if (_jwt is null || _sections is null)
{
    <div class="text-center py-5"><div class="spinner-border"></div></div>
}
else
{
    <div class="row g-3">
        @for (var si = 0; si < _sections.Count; si++)
        {
            var sec = _sections[si];
            var sIdx = si;
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-white d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm me-1">
                            <button class="btn btn-outline-secondary" title="Subir seccion" disabled="@(sIdx == 0)" @onclick="() => MoverSeccion(sIdx, -1)"><i class="fi fi-rr-angle-up"></i></button>
                            <button class="btn btn-outline-secondary" title="Bajar seccion" disabled="@(sIdx == _sections.Count - 1)" @onclick="() => MoverSeccion(sIdx, 1)"><i class="fi fi-rr-angle-down"></i></button>
                        </div>
                        @* Icono editable con selector visual (grilla de iconos; tambien deja escribir la clase). *@
                        <button type="button" class="mnu-ico-pick" title="Elegir icono" @onclick="() => AbrirPickerIcono(sec.Icon, v => sec.Icon = v)"><i class="fi @sec.Icon"></i></button>
                        <input class="form-control form-control-sm fw-semibold @(sec.Hidden ? "text-decoration-line-through text-muted" : "")" style="max-width:280px" @bind="sec.Label" />
                        @if (sec.IsCustom)
                        {
                            <span class="badge bg-primary-subtle text-primary-emphasis">nueva</span>
                        }
                        @if (sec.Hidden)
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis">oculta</span>
                        }
                        <span class="badge bg-light text-muted ms-auto">@sec.Items.Count items</span>
                        <button class="btn btn-sm @(sec.Hidden ? "btn-secondary" : "btn-outline-secondary")" title="@(sec.Hidden ? "Mostrar seccion en el menu" : "Ocultar seccion del menu")" @onclick="() => sec.Hidden = !sec.Hidden">
                            <i class="fi @(sec.Hidden ? "fi-rr-eye-crossed" : "fi-rr-eye")"></i>
                        </button>
                        @if (sec.IsCustom)
                        {
                            <button class="btn btn-sm btn-outline-danger" title="Eliminar seccion" @onclick="() => EliminarSeccion(sec)"><i class="fi fi-rr-trash"></i></button>
                        }
                    </div>
                    <div class="card-body p-2">
                        @if (sec.Items.Count == 0)
                        {
                            <div class="text-muted small px-2 py-1">Sin items en esta seccion.</div>
                        }
                        <ul class="list-group list-group-flush">
                            @for (var ii = 0; ii < sec.Items.Count; ii++)
                            {
                                var it = sec.Items[ii];
                                var iIdx = ii;
                                <li class="list-group-item d-flex align-items-center gap-2 px-2">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" title="Subir" disabled="@(iIdx == 0)" @onclick="() => MoverItem(sec, iIdx, -1)"><i class="fi fi-rr-angle-up"></i></button>
                                        <button class="btn btn-outline-secondary" title="Bajar" disabled="@(iIdx == sec.Items.Count - 1)" @onclick="() => MoverItem(sec, iIdx, 1)"><i class="fi fi-rr-angle-down"></i></button>
                                    </div>
                                    @* Icono editable con selector visual. *@
                                    <button type="button" class="mnu-ico-pick" title="Elegir icono" @onclick="() => AbrirPickerIcono(it.Icon, v => it.Icon = v)"><i class="fi @it.Icon"></i></button>
                                    <input class="form-control form-control-sm @(it.Hidden ? "text-decoration-line-through text-muted" : "")" style="max-width:300px" @bind="it.Label" />
                                    <code class="small text-muted d-none d-md-inline">@it.Href</code>
                                    @if (!string.IsNullOrWhiteSpace(it.Subheading))
                                    {
                                        <span class="badge bg-light text-secondary">@it.Subheading</span>
                                    }
                                    <div class="ms-auto d-flex align-items-center gap-1">
                                        <span class="small text-muted">Mover a:</span>
                                        <select class="form-select form-select-sm" style="max-width:200px"
                                                @onchange="e => MoverAItem(sec, it, e.Value?.ToString())">
                                            @foreach (var dest in _sections)
                                            {
                                                <option value="@dest.Key" selected="@(dest.Key == sec.Key)">@dest.Label</option>
                                            }
                                        </select>
                                        <button class="btn btn-sm @(it.Hidden ? "btn-secondary" : "btn-outline-secondary")" title="@(it.Hidden ? "Mostrar en el menu" : "Ocultar del menu")" @onclick="() => it.Hidden = !it.Hidden">
                                            <i class="fi @(it.Hidden ? "fi-rr-eye-crossed" : "fi-rr-eye")"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary" title="Agregar sub-item (submenu desplegable)" @onclick="() => AgregarSubItem(it)"><i class="fi fi-rr-plus"></i><i class="fi fi-rr-angle-small-down"></i></button>
                                        @if (it.IsCustom)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" title="Eliminar item" @onclick="() => EliminarItem(sec, it)"><i class="fi fi-rr-trash"></i></button>
                                        }
                                    </div>
                                </li>
                                @* Sub-items (3er nivel): cuelgan del item de arriba y forman un submenu desplegable. *@
                                @foreach (var ch in it.Children)
                                {
                                    var child = ch;
                                    <li class="list-group-item d-flex align-items-center gap-2 px-2 mnu-subitem">
                                        <span class="mnu-sub-guide">&#8627;</span>
                                        <button type="button" class="mnu-ico-pick" title="Elegir icono" @onclick="() => AbrirPickerIcono(child.Icon, v => child.Icon = v)"><i class="fi @child.Icon"></i></button>
                                        <input class="form-control form-control-sm @(child.Hidden ? "text-decoration-line-through text-muted" : "")" style="max-width:280px" @bind="child.Label" />
                                        @if (child.IsCustom) { <span class="badge bg-primary-subtle text-primary-emphasis">nuevo</span> }
                                        <div class="ms-auto d-flex align-items-center gap-1">
                                            <button class="btn btn-sm @(child.Hidden ? "btn-secondary" : "btn-outline-secondary")" title="@(child.Hidden ? "Mostrar" : "Ocultar")" @onclick="() => child.Hidden = !child.Hidden"><i class="fi @(child.Hidden ? "fi-rr-eye-crossed" : "fi-rr-eye")"></i></button>
                                            <button class="btn btn-sm btn-outline-danger" title="Eliminar sub-item" @onclick="() => it.Children.Remove(child)"><i class="fi fi-rr-trash"></i></button>
                                        </div>
                                    </li>
                                }
                            }
                        </ul>
                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="() => AgregarItem(sec)"><i class="fi fi-rr-plus"></i> Agregar item</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ===== Selector visual de iconos (grilla fi-rr-*) ===== *@
@if (_pickerSet is not null)
{
    <div class="mnu-ico-bd" @onclick="CerrarPickerIcono">
        <div class="mnu-ico-modal" @onclick:stopPropagation="true">
            <div class="mnu-ico-head">
                <div>
                    <div class="mnu-ico-title">Elegir icono</div>
                    <div class="mnu-ico-sub">Haz clic en un icono, o escribe la clase (fi-rr-*) abajo.</div>
                </div>
                <button type="button" class="mnu-ico-x" @onclick="CerrarPickerIcono">&times;</button>
            </div>
            <div class="mnu-ico-search">
                <input class="form-control form-control-sm" placeholder="Buscar icono..." @bind="_pickerQuery" @bind:event="oninput" />
                <div class="mnu-ico-current" title="Icono actual"><i class="fi @(_pickerActual)"></i></div>
            </div>
            <div class="mnu-ico-grid">
                @foreach (var ic in IconosFiltrados())
                {
                    var icon = ic;
                    <button type="button" class="mnu-ico-cell @(_pickerActual == icon ? "on" : "")" title="@icon" @onclick="() => ElegirIcono(icon)">
                        <i class="fi @icon"></i>
                    </button>
                }
            </div>
            <div class="mnu-ico-foot">
                <input class="form-control form-control-sm" placeholder="fi-rr-clase-personalizada" @bind="_pickerActual" @bind:event="oninput" />
                <button type="button" class="btn btn-sm btn-primary" @onclick="() => ElegirIcono(_pickerActual)">Usar esta clase</button>
            </div>
        </div>
    </div>
}

@code {
    private string? _jwt;
    private bool _busy;
    private string? _msg;
    private string _msgCls = "alert-info";
    private List<EdSection>? _sections;

    // ----- Selector visual de iconos -----
    private Action<string>? _pickerSet;   // callback que fija el icono en el nodo (seccion o item)
    private string _pickerActual = "";    // clase actualmente elegida (se refleja en vivo)
    private string _pickerQuery = "";

    private void AbrirPickerIcono(string actual, Action<string> set)
    {
        _pickerActual = actual ?? "";
        _pickerQuery = "";
        _pickerSet = set;
    }

    private void ElegirIcono(string icon)
    {
        if (string.IsNullOrWhiteSpace(icon)) return;
        _pickerSet?.Invoke(icon.Trim());
        CerrarPickerIcono();
    }

    private void CerrarPickerIcono() { _pickerSet = null; _pickerQuery = ""; }

    private IEnumerable<string> IconosFiltrados()
    {
        var q = _pickerQuery?.Trim().ToLowerInvariant();
        return string.IsNullOrEmpty(q) ? IconosMenu : IconosMenu.Where(i => i.Contains(q));
    }

    // Catalogo curado de iconos fi-rr-* (Flaticon uicons) para el menu. Cubre los que ya usa el
    // menu base + un set general util. Se puede escribir una clase fuera de esta lista en el picker.
    private static readonly string[] IconosMenu =
    {
        "fi-rr-house-blank","fi-rr-home","fi-rr-building","fi-rr-apartment","fi-rr-city",
        "fi-rr-apps","fi-rr-apps-add","fi-rr-dashboard","fi-rr-chart-line-up","fi-rr-chart-pie",
        "fi-rr-chart-histogram","fi-rr-stats","fi-rr-users","fi-rr-users-alt","fi-rr-user",
        "fi-rr-user-add","fi-rr-users-medical","fi-rr-address-book","fi-rr-id-badge","fi-rr-portrait",
        "fi-rr-usd-circle","fi-rr-money-bill-wave","fi-rr-credit-card","fi-rr-bank","fi-rr-receipt",
        "fi-rr-calculator","fi-rr-briefcase","fi-rr-file-signature","fi-rr-shield","fi-rr-shield-check",
        "fi-rr-podium-star","fi-rr-megaphone","fi-rr-comment-alt","fi-rr-comments","fi-rr-comments-question",
        "fi-rr-list-check","fi-rr-list","fi-rr-checkbox","fi-rr-clipboard-list","fi-rr-screwdriver",
        "fi-rr-settings","fi-rr-settings-sliders","fi-rr-tools","fi-rr-wrench-simple","fi-rr-trees",
        "fi-rr-tree","fi-rr-leaf","fi-rr-swimming-pool","fi-rr-calendar","fi-rr-calendar-check",
        "fi-rr-calendar-clock","fi-rr-clock","fi-rr-time-past","fi-rr-folder","fi-rr-folder-open",
        "fi-rr-document","fi-rr-file","fi-rr-file-invoice","fi-rr-hashtag","fi-rr-network",
        "fi-rr-site-map","fi-rr-robot","fi-rr-bolt","fi-rr-ban","fi-rr-key","fi-rr-lock",
        "fi-rr-bell","fi-rr-envelope","fi-rr-phone-call","fi-rr-map-marker","fi-rr-truck-side",
        "fi-rr-box","fi-rr-tags","fi-rr-star","fi-rr-heart","fi-rr-flag","fi-rr-bookmark",
        "fi-rr-search","fi-rr-filter","fi-rr-arrows-repeat","fi-rr-refresh","fi-rr-plus","fi-rr-menu-burger",
    };

    private sealed class EdItem
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public string Href { get; set; } = "";
        public string Icon { get; set; } = "";
        public string? Subheading { get; set; }
        public bool IsCustom { get; set; }
        public bool Hidden { get; set; }
        public List<EdItem> Children { get; set; } = new();   // sub-items (3er nivel)
    }

    private sealed class EdSection
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool IsCustom { get; set; }
        public bool Hidden { get; set; }
        public List<EdItem> Items { get; set; } = new();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) { return; }
        try
        {
            var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_admin_jwt");
            if (string.IsNullOrWhiteSpace(jwt)) { Nav.NavigateTo("/login", forceLoad: true); return; }
            _jwt = jwt;
            await CargarAsync();
            StateHasChanged();
        }
        catch (Exception ex) { _msg = $"Error cargando el menu: {ex.Message}"; _msgCls = "alert-danger"; StateHasChanged(); }
    }

    private async Task CargarAsync()
    {
        var menu = await Auth().GetFromJsonAsync<ResolvedMenu>("/admin/menu");
        _sections = (menu?.Sections ?? new List<ResolvedMenuSection>())
            .Select(s => new EdSection
            {
                Key = s.Key,
                Label = s.Label,
                Icon = s.Icon,
                IsCustom = s.IsCustom,
                Hidden = s.Hidden,
                Items = s.Items.Select(i => new EdItem
                {
                    Key = i.Key, Label = i.Label, Href = i.Href, Icon = i.Icon, Subheading = i.Subheading, IsCustom = i.IsCustom, Hidden = i.Hidden,
                    Children = (i.Children ?? Array.Empty<ResolvedMenuItem>())
                        .Select(c => new EdItem { Key = c.Key, Label = c.Label, Href = c.Href, Icon = c.Icon, Subheading = c.Subheading, IsCustom = c.IsCustom, Hidden = c.Hidden }).ToList()
                }).ToList()
            })
            .ToList();
    }

    // ----- Exportar / importar la configuracion como JSON -----
    private async Task ExportarJson()
    {
        if (_sections is null) { return; }
        var json = JsonSerializer.Serialize(_sections, new JsonSerializerOptions { WriteIndented = true });
        var b64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
        await Js.InvokeVoidAsync("propiaUI.downloadBase64", "menu-propia.json", "application/json", b64);
    }

    private async Task ImportarJson(InputFileChangeEventArgs e)
    {
        _msg = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(4 * 1024 * 1024));
            var json = await reader.ReadToEndAsync();
            var secs = JsonSerializer.Deserialize<List<EdSection>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (secs is null || secs.Count == 0) { _msg = "El archivo no tiene secciones validas."; _msgCls = "alert-danger"; return; }
            foreach (var s in secs) { s.Items ??= new(); }
            _sections = secs;
            _msg = "JSON importado. Revisa y pulsa \"Guardar cambios\" para aplicarlo."; _msgCls = "alert-info";
        }
        catch (Exception ex) { _msg = $"No se pudo importar: {ex.Message}"; _msgCls = "alert-danger"; }
    }

    private void MoverSeccion(int idx, int dir)
    {
        if (_sections is null) { return; }
        var j = idx + dir;
        if (j < 0 || j >= _sections.Count) { return; }
        (_sections[idx], _sections[j]) = (_sections[j], _sections[idx]);
    }

    private void MoverItem(EdSection sec, int idx, int dir)
    {
        var j = idx + dir;
        if (j < 0 || j >= sec.Items.Count) { return; }
        (sec.Items[idx], sec.Items[j]) = (sec.Items[j], sec.Items[idx]);
    }

    private void MoverAItem(EdSection from, EdItem it, string? targetKey)
    {
        if (_sections is null || string.IsNullOrWhiteSpace(targetKey) || targetKey == from.Key) { return; }
        var target = _sections.FirstOrDefault(s => s.Key == targetKey);
        if (target is null) { return; }
        from.Items.Remove(it);
        target.Items.Add(it);
    }

    // ----- Agregar / eliminar nodos custom -----

    private void AgregarSeccion()
    {
        if (_sections is null) { return; }
        _sections.Add(new EdSection { Key = $"custom-sec-{Guid.NewGuid():N}", Label = "Nueva seccion", Icon = "fi-rr-apps", IsCustom = true, Items = new() });
    }

    private void AgregarItem(EdSection sec)
    {
        // Item nuevo sin funcion todavia: abre la pagina "Proximamente".
        sec.Items.Add(new EdItem { Key = $"custom-item-{Guid.NewGuid():N}", Label = "Nuevo item", Icon = "fi-rr-clock-three", Href = "/proximamente", IsCustom = true });
    }

    // Sub-item (3er nivel): cuelga del item padre y forma un submenu desplegable en el menu del cliente.
    private void AgregarSubItem(EdItem parent)
    {
        parent.Children.Add(new EdItem { Key = $"custom-item-{Guid.NewGuid():N}", Label = "Nuevo sub-item", Icon = "fi-rr-clock-three", Href = "/proximamente", IsCustom = true });
    }

    private void EliminarSeccion(EdSection sec)
    {
        if (_sections is null || !sec.IsCustom) { return; }
        _sections.Remove(sec);
    }

    private void EliminarItem(EdSection sec, EdItem it)
    {
        if (!it.IsCustom) { return; }
        sec.Items.Remove(it);
    }

    private async Task GuardarAsync()
    {
        if (_sections is null) { return; }
        _busy = true; _msg = null;
        try
        {
            var req = new SaveMenuArrangementRequest(
                _sections.Select((s, si) => new MenuSectionArrangement(
                    s.Key, s.Label, si + 1,
                    s.Items.Select((it, ii) => new MenuItemArrangement(it.Key, it.Label, ii + 1, it.IsCustom, it.Icon, it.Href, it.Hidden,
                        it.Children.Select((ch, ci) => new MenuItemArrangement(ch.Key, ch.Label, ci + 1, ch.IsCustom, ch.Icon, ch.Href, ch.Hidden)).ToList())).ToList(),
                    s.IsCustom, s.Icon, s.Hidden)).ToList());

            var resp = await Auth().PutAsJsonAsync("/admin/menu", req);
            if (resp.IsSuccessStatusCode)
            {
                _msg = "Menu guardado. Recarga el sistema del cliente para ver el nuevo orden."; _msgCls = "alert-success";
            }
            else { _msg = $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}"; _msgCls = "alert-danger"; }
        }
        catch (Exception ex) { _msg = $"Error guardando: {ex.Message}"; _msgCls = "alert-danger"; }
        finally { _busy = false; }
    }

    private async Task ResetAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var resp = await Auth().PostAsync("/admin/menu/reset", null);
            if (resp.IsSuccessStatusCode)
            {
                await CargarAsync();
                _msg = "Menu restablecido al base."; _msgCls = "alert-success";
            }
            else { _msg = $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}"; _msgCls = "alert-danger"; }
        }
        catch (Exception ex) { _msg = $"Error: {ex.Message}"; _msgCls = "alert-danger"; }
        finally { _busy = false; }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}

<style>
    /* Boton que muestra el icono actual y abre el selector visual. */
    .mnu-ico-pick {
        width: 34px; height: 34px; flex: 0 0 34px;
        border: 1px solid #E1E8EE; border-radius: 8px; background: #fff;
        color: #516F90; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
        transition: border-color .12s, background .12s, color .12s;
    }
    .mnu-ico-pick:hover { border-color: var(--propia-primary, #5955D1); color: var(--propia-primary, #5955D1); background: rgba(89,85,209,.06); }
    .mnu-ico-pick i { font-size: 16px; }

    /* Modal del selector de iconos. */
    .mnu-ico-bd {
        position: fixed; inset: 0; z-index: 1090; background: rgba(15,15,30,.45);
        display: flex; align-items: flex-start; justify-content: center; padding-top: 10vh; pointer-events: auto;
    }
    .mnu-ico-modal {
        width: 560px; max-width: calc(100vw - 32px); background: #fff;
        border: 1px solid #E1E8EE; border-radius: 14px; box-shadow: 0 18px 48px rgba(0,0,0,.28); overflow: hidden;
    }
    .mnu-ico-head { display: flex; align-items: flex-start; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #EEF2F6; }
    .mnu-ico-title { font-weight: 700; color: #33475B; }
    .mnu-ico-sub { font-size: 12.5px; color: #6B7C8F; }
    .mnu-ico-x { background: none; border: none; font-size: 22px; line-height: 1; color: #90A4B7; cursor: pointer; }
    .mnu-ico-search { display: flex; align-items: center; gap: 10px; padding: 12px 16px 4px; }
    .mnu-ico-current { width: 38px; height: 38px; flex: 0 0 38px; border: 1px solid #E1E8EE; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: var(--propia-primary, #5955D1); }
    .mnu-ico-current i { font-size: 18px; }
    .mnu-ico-grid { display: grid; grid-template-columns: repeat(9, 1fr); gap: 6px; padding: 10px 16px; max-height: 46vh; overflow-y: auto; }
    .mnu-ico-cell {
        aspect-ratio: 1; border: 1px solid #EEF2F6; border-radius: 9px; background: #fff; color: #516F90;
        cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all .1s;
    }
    .mnu-ico-cell:hover { border-color: var(--propia-primary, #5955D1); color: var(--propia-primary, #5955D1); background: rgba(89,85,209,.06); }
