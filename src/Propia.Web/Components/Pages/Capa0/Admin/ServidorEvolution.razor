@page "/admin/integraciones/evolution"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Integraciones
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Servidor Evolution (WhatsApp) - Plataforma</PageTitle>

<div class="d-flex align-items-center gap-2 mb-1">
    <i class="fi fi-rr-display-code" style="color: var(--propia-primary);"></i>
    <span class="small fw-semibold text-uppercase text-muted">Super Admin SaaS</span>
</div>
<h1 class="h3 mb-1">Servidor <span style="color: var(--propia-primary);">Evolution API</span></h1>
<p class="text-muted mb-4">Servidor maestro de WhatsApp de la plataforma. Las copropiedades usan este servidor compartido. Configura tambien la URL publica y el token del webhook: sin ellos los agentes NO reciben mensajes entrantes (el webhook se registra al conectar o refrescar cada linea).</p>

@if (_jwt is null || _cargando)
{
    <div class="text-center py-5"><div class="spinner-border"></div></div>
}
else if (_form is not null)
{
    <div class="card" style="max-width: 920px;">
        <div class="card-body">
            <div class="d-flex align-items-start gap-3">
                <div class="rounded p-2" style="background: rgba(89,85,209,.1);"><i class="fi fi-rr-display-code fs-4" style="color: var(--propia-primary);"></i></div>
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center">
                        <strong>Evolution API &mdash; servidor maestro</strong>
                        @{ var (cls, txt) = StatusBadge(_form.Status); }
                        <span class="badge @cls ms-auto">@txt</span>
                    </div>
                    <div class="text-muted small">Conexion central para crear instancias y enviar/recibir WhatsApp.</div>
                </div>
            </div>

            <hr />

            @if (!_editMode)
            {
                @* ---- Vista de solo lectura (configurado) ---- *@
                <div class="row g-3">
                    <div class="col-md-7">
                        <div class="small text-muted text-uppercase">URL del servidor</div>
                        <div class="font-monospace">@(_form.BaseUrl ?? "-")</div>
                    </div>
                    <div class="col-md-5">
                        <div class="small text-muted text-uppercase">API Key</div>
                        <div class="font-monospace">@(_form.HasApiKey ? _form.ApiKeyMasked : "(sin configurar)")</div>
                    </div>
                    <div class="col-md-7">
                        <div class="small text-muted text-uppercase">URL publica (webhook entrante)</div>
                        <div class="font-monospace">@(string.IsNullOrWhiteSpace(_form.WebhookPublicUrl) ? "(sin configurar)" : _form.WebhookPublicUrl)</div>
                    </div>
                    <div class="col-md-5">
                        <div class="small text-muted text-uppercase">Token webhook</div>
                        <div class="font-monospace">@(_form.HasWebhookToken ? "configurado" : "(sin configurar)")</div>
                    </div>
                    @if (_form.LastValidatedAt is not null)
                    {
                        <div class="col-12">
                            <div class="small text-muted text-uppercase">Ultima validacion</div>
                            <div>@_form.LastValidatedAt.Value.ToCo().ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_validateMsg))
                {
                    <div class="mt-3 @(_validateOk ? "text-success" : "text-danger")">@_validateMsg</div>
                }
                else if (_form.Status == EvolutionIntegrationStatus.Validated)
                {
                    <div class="mt-3 text-success">Conexion exitosa: el servidor responde y la API key es valida.</div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button class="btn" style="background: var(--propia-primary); color:#fff;" @onclick="Editar">Editar configuracion</button>
                    <button class="btn btn-outline-dark" @onclick="ValidarAsync" disabled="@_busy">@(_busy ? "Validando..." : "Validar conexion")</button>
                </div>
            }
            else
            {
                @* ---- Edicion ---- *@
                <div class="row g-3">
                    <div class="col-12"><label class="form-label">URL del servidor</label><input class="form-control" @bind="_form.BaseUrl" placeholder="https://evo.propia.com.co" /></div>
                    <div class="col-12">
                        <label class="form-label">API Key @(_form.HasApiKey ? "(guardada - dejar vacio para conservar)" : "")</label>
                        <input type="password" class="form-control" @bind="_form.ApiKey" placeholder="@(_form.HasApiKey ? _form.ApiKeyMasked : "AUTHENTICATION_API_KEY")" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">URL publica (para el webhook entrante)</label>
                        <input class="form-control" @bind="_form.WebhookPublicUrl" placeholder="https://app.propia-ad.com" />
                        <div class="form-text">Evolution entrega los mensajes entrantes aqui: se registra como {url}/webhooks/evolution/{tenantId} al conectar (o refrescar) cada linea. Sin esto, el agente no recibe mensajes.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Token del webhook @(_form.HasWebhookToken ? "(guardado - dejar vacio para conservar)" : "")</label>
                        <input type="password" class="form-control" @bind="_form.WebhookToken" placeholder="@(_form.HasWebhookToken ? "********" : "cadena secreta compartida")" />
                        <div class="form-text">Requerido para registrar el webhook. Para validar los entrantes, pon el mismo valor en la env var Propia__WebhookToken del servicio (opcional).</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgCls mt-3 mb-0">@_msg</div> }

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-dark" @onclick="GuardarAsync" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar configuracion")</button>
                    <button class="btn btn-outline-dark" @onclick="ValidarAsync" disabled="@_busy">Validar conexion</button>
                    @if (_form.HasApiKey)
                    {
                        <button class="btn btn-outline-secondary ms-auto" @onclick="() => { _editMode = false; _msg = null; }">Cancelar</button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private string? _jwt;
    private bool _cargando = true;
    private bool _busy;
    private bool _editMode;
    private string? _msg;
    private string _msgCls = "alert-info";
    private string? _validateMsg;
    private bool _validateOk;
    private Form? _form;

    private class Form
    {
        public string? BaseUrl { get; set; }
        public string? ApiKey { get; set; }
        public string? ApiKeyMasked { get; set; }
        public bool HasApiKey { get; set; }
        public EvolutionIntegrationStatus Status { get; set; } = EvolutionIntegrationStatus.NotConfigured;
        public DateTimeOffset? LastValidatedAt { get; set; }
        // Webhook: se conserva del backend pero NO se edita aqui (se configura al conectar cada linea).
        public string WebhookMode { get; set; } = "Production";
        public string? WebhookPublicUrl { get; set; }
        public string? WebhookToken { get; set; }
        public bool HasWebhookToken { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_admin_jwt");
            if (string.IsNullOrWhiteSpace(jwt)) { Nav.NavigateTo("/login", forceLoad: true); return; }
            _jwt = jwt;
            await CargarAsync();
            StateHasChanged();
        }
        catch { _cargando = false; }
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        try
        {
            var c = await Auth().GetFromJsonAsync<EvolutionMasterDto>("/admin/evolution-config");
            _form = c is null ? new Form() : MapToForm(c);
            // Si no hay nada configurado, abrir directo en modo edicion.
            _editMode = !_form.HasApiKey && string.IsNullOrWhiteSpace(_form.BaseUrl);
        }
        catch (System.Net.Http.HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // Sesion de super admin vencida: en vez de quedarse pensando, volver al login.
            _cargando = false;
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _msg = "No se pudo cargar la configuracion: " + ex.Message; _msgCls = "alert-danger";
        }
        finally { _cargando = false; }
    }

    private void Editar() { _editMode = true; _msg = null; }

    private async Task GuardarAsync()
    {
        if (_form is null) return;
        _busy = true; _msg = null;
        try
        {
            // El webhook se conserva tal cual estaba (se gestiona al conectar lineas).
            var req = new SaveEvolutionMasterRequest(_form.BaseUrl, _form.ApiKey, _form.WebhookMode, _form.WebhookPublicUrl, _form.WebhookToken);
            var resp = await Auth().PutAsJsonAsync("/admin/evolution-config", req);
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<EvolutionMasterDto>();
                if (dto is not null) _form = MapToForm(dto);
                _msg = "Configuracion guardada. Valida la conexion."; _msgCls = "alert-success";
                _editMode = false;
            }
            else { _msg = $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}"; _msgCls = "alert-danger"; }
        }
        finally { _busy = false; }
    }

    private async Task ValidarAsync()
    {
        _busy = true; _validateMsg = null; _msg = null;
        try
        {
            var resp = await Auth().PostAsync("/admin/evolution-config/validar", null);
            if (resp.IsSuccessStatusCode)
            {
                var r = await resp.Content.ReadFromJsonAsync<EvolutionValidationResult>();
                _validateOk = r?.Ok == true;
                _validateMsg = r?.Message ?? (_validateOk ? "Conexion exitosa." : "No se pudo validar.");
                await CargarAsync();
            }
            else { _validateOk = false; _validateMsg = $"No se pudo validar: {await resp.Content.ReadAsStringAsync()}"; }
        }
        finally { _busy = false; }
    }

    private static Form MapToForm(EvolutionMasterDto c) => new()
    {
        BaseUrl = c.BaseUrl, ApiKeyMasked = c.ApiKeyMasked, HasApiKey = c.HasApiKey,
        Status = c.Status, LastValidatedAt = c.LastValidatedAt,
        WebhookMode = c.WebhookMode, WebhookPublicUrl = c.WebhookPublicUrl, HasWebhookToken = c.HasWebhookToken
    };

    private static (string, string) StatusBadge(EvolutionIntegrationStatus s) => s switch
    {
        EvolutionIntegrationStatus.Validated => ("bg-success", "Validado"),
        EvolutionIntegrationStatus.Configured => ("bg-info text-dark", "Configurado"),
        EvolutionIntegrationStatus.Error => ("bg-danger", "Error"),
        _ => ("bg-secondary", "No configurado")
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}
