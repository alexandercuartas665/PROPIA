    // La abre el expander (de la fila de datos, o del alta tras crear). =====
    private MascotaResumenDto? _fichaM;
    private void AbrirFichaM(MascotaResumenDto v) { _fichaM = v; _editM = false; _confirmDelM = false; }
    private void CerrarFichaM() { _fichaM = null; _editM = false; _confirmDelM = false; }
    private void RefrescarFichaM(Guid mascotaId) { if (_fichaM is not null) _fichaM = _mascotas.FirstOrDefault(x => x.MascotaId == mascotaId) ?? _fichaM; }

    // ===== Ficha de mascota: modo vista/edicion (canon igual a Unidades: lapiz -> editar -> guardar/cancelar) =====
    private bool _editM;
    private bool _savingM;
    private string _emNombre = "", _emRaza = "", _emTipoSel = "";
    private readonly Dictionary<Guid, string?> _emDin = new();
    private bool _emPropChanged;
    private Guid? _emPropPersonaId;
    private string? _emPropNombre;
    private bool _confirmDelM;
    private string _confirmTextM = "";
    private string? _delErrorM;
    private bool ConfirmCoincideM(MascotaResumenDto v) => string.Equals(_confirmTextM?.Trim(), (v.Nombre ?? "").Trim(), StringComparison.Ordinal);

    private void IniciarEdicionM(MascotaResumenDto v)
    {
        _emNombre = v.Nombre ?? "";
        _emRaza = v.Raza ?? "";
        _emTipoSel = EfectivoTipoLabel(v);
        _emDin.Clear();
        foreach (var def in _defs.Where(d => d.Tipo != TipoCampoTablero.Separador && d.Tipo != TipoCampoTablero.Formula))
            _emDin[def.Id] = ValorDe(v.MascotaId, def.Id);
        _emPropChanged = false; _emPropPersonaId = v.PropietarioPersonaId; _emPropNombre = v.PropietarioNombre;
        _msg = null; _editM = true;
    }
    private void CancelarEdicionM() { _editM = false; _emDin.Clear(); _emPropChanged = false; _msg = null; }

    private void SeleccionarPropietarioM(PersonaCandidatoDto? sel)
    {
        _emPropChanged = true; _emPropPersonaId = sel?.PersonaId; _emPropNombre = sel?.NombreCompleto;
    }
    private void QuitarPropietarioM() { _emPropChanged = true; _emPropPersonaId = null; _emPropNombre = null; }
    private string PropietarioDisplayM(MascotaResumenDto v)
    {
        var nom = _editM && _emPropChanged ? _emPropNombre : v.PropietarioNombre;
        return string.IsNullOrWhiteSpace(nom) ? "-" : nom!;
    }
    private string PropietarioSrcM(MascotaResumenDto v)
    {
        var pid = _editM && _emPropChanged ? _emPropPersonaId : v.PropietarioPersonaId;
        return pid is null ? "según la unidad" : "del Directorio";
    }

    private async Task GuardarFichaMAsync(MascotaResumenDto v)
    {
        _savingM = true; _msg = null;
        try
        {
            // 1) Campos fijos en un solo PUT (MERGE): solo los que cambiaron.
            string? nombre = null, raza = null; TipoMascota? tipo = null; string? tipoCustom = null;
            var nn = (_emNombre ?? "").Trim();
            if (nn.Length > 0 && !string.Equals(nn, v.Nombre, StringComparison.Ordinal)) nombre = nn;
            var nr = (_emRaza ?? "").Trim();
            if (!string.Equals(nr, v.Raza ?? "", StringComparison.Ordinal)) raza = nr;
            var (tn, tc) = DesdeSelTipo(_emTipoSel);
            if (tn != v.Tipo || !string.Equals(tc ?? "", v.TipoCustom ?? "", StringComparison.Ordinal)) { tipo = tn; tipoCustom = tc ?? ""; }
            if (nombre is not null || raza is not null || tipo is not null)
            {
                var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-mascotas/{v.MascotaId}",
                    new ActualizarUnidadMascotaRequest(Nombre: nombre, Tipo: tipo, Raza: raza, TipoCustom: tipoCustom));
                if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); return; }
            }
            // 2) Propietario si cambio.
            if (_emPropChanged)
            {
                var rp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-mascotas/{v.MascotaId}/propietario", new ActualizarPropietarioRequest(_emPropPersonaId));
                if (!rp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(rp), true); return; }
            }
            // 3) Campos dinamicos cambiados.
            foreach (var kv in _emDin)
            {
                var original = ValorDe(v.MascotaId, kv.Key);
                if (string.Equals(kv.Value ?? "", original ?? "", StringComparison.Ordinal)) continue;
                var rd = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/mascotas-campos-valores/{v.MascotaId}/{kv.Key}", new SetCampoValorRequest(kv.Value));
                if (!rd.IsSuccessStatusCode) { Mensaje(await MotivoAsync(rd), true); return; }
            }
            await CargarAsync();
            RefrescarFichaM(v.MascotaId);
            _editM = false; _emDin.Clear(); _emPropChanged = false;
            Mensaje("Datos guardados.", false);
        }
        catch (Exception ex) { Mensaje("No se pudo guardar: " + ex.Message, true); }
        finally { _savingM = false; }
    }

    private void AbrirConfirmDelM() { _confirmTextM = ""; _delErrorM = null; _confirmDelM = true; }
    private void CerrarConfirmDelM() { _confirmDelM = false; _confirmTextM = ""; _delErrorM = null; }
    private async Task ConfirmarEliminarM(MascotaResumenDto v)
    {
        if (!ConfirmCoincideM(v)) return;
        _savingM = true; _delErrorM = null;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-mascotas/{v.MascotaId}");
            if (resp.IsSuccessStatusCode) { _confirmDelM = false; _fichaM = null; _editM = false; await CargarAsync(); Mensaje("Mascota eliminada.", false); return; }
            _delErrorM = await MotivoAsync(resp);
        }
        catch (Exception ex) { _delErrorM = ex.Message; }
        finally { _savingM = false; }
    }

    private async Task GuardarNombreAsync(MascotaResumenDto v, string? valor)
    {
        var nuevo = (valor ?? "").Trim();
        if (nuevo.Length == 0 || string.Equals(nuevo, v.Nombre, StringComparison.Ordinal)) return;
        await GuardarAsync(v.MascotaId, new ActualizarUnidadMascotaRequest(Nombre: nuevo));
    }

    private async Task GuardarRazaAsync(MascotaResumenDto v, string? valor)
    {
        var nueva = (valor ?? "").Trim();
        if (string.Equals(nueva, v.Raza ?? "", StringComparison.Ordinal)) return;
        await GuardarAsync(v.MascotaId, new ActualizarUnidadMascotaRequest(Raza: nueva));
    }

    private async Task GuardarTipoAsync(MascotaResumenDto v, string? valor)
    {
        var (tn, tc) = DesdeSelTipo(valor);
        // Sin cambios reales: mismo enum y mismo custom.
        if (tn == v.Tipo && string.Equals(tc ?? "", v.TipoCustom ?? "", StringComparison.Ordinal)) return;
        // Mandamos ambos: "" limpia TipoCustom en el back (MERGE: null = no tocar) al volver a una semilla.
        await GuardarAsync(v.MascotaId, new ActualizarUnidadMascotaRequest(Tipo: tn, TipoCustom: tc ?? ""));
    }

    private async Task GuardarAsync(Guid mascotaId, ActualizarUnidadMascotaRequest req)
    {
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-mascotas/{mascotaId}", req);
            if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); }
            await CargarAsync();
        }
        catch (Exception ex) { Mensaje("No se pudo guardar: " + ex.Message, true); }
    }

    private async Task GuardarDinamicoAsync(Guid mascotaId, Guid defId, string? valor)
    {
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/mascotas-campos-valores/{mascotaId}/{defId}",
                new SetCampoValorRequest(valor));
            if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); return; }
            if (!_valores.TryGetValue(mascotaId, out var d)) _valores[mascotaId] = d = new();
            d[defId] = valor;
        }
        catch (Exception ex) { Mensaje("No se pudo guardar el campo: " + ex.Message, true); }
    }

    private async Task EliminarAsync(MascotaResumenDto v)
    {
        bool ok;
        try { ok = await Modals.ConfirmAsync($"Quitar la mascota {v.Nombre} de la unidad {v.UnidadCodigo}?", "Quitar mascota"); }
        catch { ok = true; }
        if (!ok) return;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-mascotas/{v.MascotaId}");
            if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); return; }
            await CargarAsync();
            Mensaje("Mascota eliminada.", false);
        }
        catch (Exception ex) { Mensaje("No se pudo eliminar: " + ex.Message, true); }
    }

    // ===== Seleccion multiple + borrado masivo =====
    private readonly HashSet<Guid> _sel = new();
    private bool _confirmDelSel;
    private bool _delBusy;
    private void ToggleSel(Guid id, bool on) { if (on) _sel.Add(id); else _sel.Remove(id); }
    private void LimpiarSel() => _sel.Clear();
    private void ToggleSelAll(bool on) { _sel.Clear(); if (on) foreach (var v in Filtradas) _sel.Add(v.MascotaId); }
    private bool TodasSel { get { var ids = Filtradas.Select(v => v.MascotaId).ToList(); return ids.Count > 0 && ids.All(_sel.Contains); } }
    private async Task EliminarSelAsync()
    {
        if (_sel.Count == 0) return;
        _delBusy = true; int ok = 0, fail = 0;
        foreach (var id in _sel.ToList())
        {
            try { var r = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-mascotas/{id}"); if (r.IsSuccessStatusCode) ok++; else fail++; }
            catch { fail++; }
        }
        _sel.Clear(); _confirmDelSel = false; _delBusy = false;
        Mensaje(fail == 0 ? $"{ok} mascota(s) eliminada(s)." : $"{ok} eliminada(s), {fail} con error.", fail != 0);
        await CargarAsync(); StateHasChanged();
    }

    // ===== Menu "Columnas" inline (orden/visibilidad + borrar DIN) =====
    private bool _showColMenu;
    private string _colQ = "";
    private bool _colBusy;
    private CampoDinDef? _campoAEliminar;

    private GuardarUnidadCampoConfigRequest FilaConfig(string clave)
    {
        _cfg.TryGetValue(clave, out var c);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato,
            Oculto: c?.Oculto ?? !VisibleColDefault(clave), Orden: c?.Orden, Entidad: EntCfg);
    }
    private async Task GuardarCfgAsync(GuardarUnidadCampoConfigRequest req)
    {
        try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { }
    }
    private async Task CargarCfgAsync()
    {
        try
        {
            var cfg = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>($"/api/mi-copropiedad/unidades-config?entidad={EntCfg}") ?? new();
            _cfg = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchos();
        }
        catch { }
    }
    private async Task ToggleVisibleColAsync(string clave)
    {
        var visible = VisibleCol(clave);
        await GuardarCfgAsync(FilaConfig(clave) with { Oculto = visible });
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task MoverColumnaAsync(string clave, int dir)
    {
        var keys = ClavesOrdenadas().ToList();
        var i = keys.IndexOf(clave); var j = i + dir;
        if (i <= 0 || j <= 0 || j >= keys.Count) return; // la 1a columna ('unidad') queda fija
        (keys[i], keys[j]) = (keys[j], keys[i]);
        for (int k = 0; k < keys.Count; k++) await GuardarCfgAsync(FilaConfig(keys[k]) with { Orden = k });
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task OcultarTodasColAsync()
    {
        var keys = ClavesOrdenadas().ToList();
        for (int k = 0; k < keys.Count; k++)
        {
            if (k == 0) continue; // 'unidad' no se oculta
            await GuardarCfgAsync(FilaConfig(keys[k]) with { Oculto = true });
        }
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task MostrarTodasColAsync()
    {
        foreach (var k in ClavesOrdenadas()) await GuardarCfgAsync(FilaConfig(k) with { Oculto = false });
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task RestablecerColAsync()
    {
        foreach (var k in ClavesOrdenadas()) await GuardarCfgAsync(FilaConfig(k) with { Oculto = !VisibleColDefault(k), Orden = null });
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task EliminarCampoDinAsync()
    {
        if (_campoAEliminar is null) return;
        _colBusy = true;
        try
        {
            var r = await Auth().DeleteAsync($"/api/mi-copropiedad/mascotas-campos/{_campoAEliminar.Id}");
            Mensaje(r.IsSuccessStatusCode ? $"Campo \"{_campoAEliminar.Label}\" eliminado." : "No se pudo eliminar el campo.", !r.IsSuccessStatusCode);
            if (r.IsSuccessStatusCode) await CargarCamposAsync(Auth());
        }
        catch (Exception ex) { Mensaje("Error al eliminar el campo: " + ex.Message, true); }
        _campoAEliminar = null; _colBusy = false; StateHasChanged();
    }

    // ===== Crear / editar UN campo (modal focalizado) =====
    private bool _crearCampoAbierto;
    private CampoDinDef? _campoAEditar;
    private void AbrirCrearCampo() { _campoAEditar = null; _crearCampoAbierto = true; }
    private void AbrirEditarCampo(CampoDinDef c)
    {
        _campoAEditar = new CampoDinDef(c.Id, c.Label, c.Orden, c.Tipo, c.Opciones, c.Descripcion);
        _crearCampoAbierto = true;
    }

    // "Editar campo" sobre una columna del SISTEMA: editor focalizado (alias/descripcion/visibilidad).
    private string? _editSisClave;
    private string _editSisLabel = "";
    private TipoCampoTablero? _editSisTipo;
    private bool _editSisReq;
    private void AbrirEditarCampoSistema(string clave)
    {
        var s = MascotaCatalogo.FirstOrDefault(c => c.Clave == clave);
        _editSisLabel = s?.Label ?? clave;
        _editSisTipo = s?.Tipo;
        _editSisReq = s?.Fija ?? false;
        _editSisClave = clave;
    }
    private async Task RecargarTrasCrearCampo()
    {
        _crearCampoAbierto = false; _campoAEditar = null;
        await CargarCamposAsync(Auth());
        if (_insertTargetKey is not null) await ReposicionarNuevoAsync();
        StateHasChanged();
    }

    // "Insertar a la izquierda/derecha": tras crear el campo (que nace al final), lo coloca junto a la
    // columna elegida reescribiendo el orden de todas las columnas (config, entidad del modulo).
    private string? _insertTargetKey;
    private int _insertSide;
    private HashSet<Guid> _defsAntesInsert = new();
    private async Task ReposicionarNuevoAsync()
    {
        var target = _insertTargetKey; _insertTargetKey = null;
        if (target is null) return;
        var nuevo = _defs.FirstOrDefault(d => !_defsAntesInsert.Contains(d.Id));
        if (nuevo is null) return;
        var nuevoKey = "cd:" + nuevo.Id;
        var keys = ClavesOrdenadas().ToList();
        keys.Remove(nuevoKey);
        var ti = keys.IndexOf(target);
        if (ti < 0) return; // columna objetivo no visible: el campo queda al final
        var pos = _insertSide < 0 ? ti : ti + 1;
        if (pos < 1) pos = 1; // nunca antes de la 1a columna (fija)
        if (pos > keys.Count) pos = keys.Count;
        keys.Insert(pos, nuevoKey);
        for (int k = 0; k < keys.Count; k++) await GuardarCfgAsync(FilaConfig(keys[k]) with { Orden = k });
        await CargarCfgAsync();
        StateHasChanged();
    }
    private void AbrirGestorDesdeCrear()
    {
        _crearCampoAbierto = false; _campoAEditar = null;
        _configAbierto = true;
    }

    // ===== Menu de columna estilo Airtable (la flecha del header abre TablaColMenu) =====
    // Cablea las acciones reales del modulo; lo que depende de backend nuevo se avisa por toast.
    private TablaColMenu? _colMenu;
    private string? _colToast;
    private void ColToast(string m) { _colToast = m; StateHasChanged(); }
    private void AbrirColMenu(MouseEventArgs e, string clave, string label, bool dyn)
        => _colMenu?.Abrir(new TablaColMenu.Ctx(clave, label, dyn), e.ClientX, e.ClientY);
    // Flecha del header (reutiliza la clase del engranaje, sin CSS nuevo). Se inserta en cada columna.
    private RenderFragment ChevCol(string clave, string label, bool dyn) =>@<button type="button" class="mas-th-edit" title="Opciones de columna" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="(e) => AbrirColMenu(e, clave, label, dyn)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg></button>;
    private async Task OnColAccion((TablaColMenu.Accion Accion, TablaColMenu.Ctx Col) a)
    {
        var (accion, col) = a;
        var campo = col.EsDinamico ? CampoCustom(col.Key) : null;
        switch (accion)
        {
            case TablaColMenu.Accion.OrdenarAsc:
                _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = 1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.OrdenarDesc:
                _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = -1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.Editar:
                if (campo is not null) AbrirEditarCampo(campo);
                else AbrirEditarCampoSistema(col.Key);   // sistema: editor focalizado (alias/descripcion/visibilidad)
                break;
            case TablaColMenu.Accion.Eliminar:
                if (campo is not null)
                {
                    _campoAEliminar = campo;
                    if (await Modals.ConfirmEliminarCampoAsync(campo.Label)) await EliminarCampoDinAsync();
                    else _campoAEliminar = null;
                }
                else ColToast("Los campos del sistema no se eliminan aquí.");
                break;
            case TablaColMenu.Accion.Duplicar:
                if (campo is not null) await DuplicarCampoAsync(campo);
                else ColToast("Solo se pueden duplicar campos propios.");
                break;
            case TablaColMenu.Accion.InsertarIzq:
            case TablaColMenu.Accion.InsertarDer:
                _insertTargetKey = col.Key;
                _insertSide = accion == TablaColMenu.Accion.InsertarIzq ? -1 : 1;
                _defsAntesInsert = _defs.Select(d => d.Id).ToHashSet();
                AbrirCrearCampo();
                break;
            case TablaColMenu.Accion.Ocultar:
                await ToggleVisibleColAsync(col.Key);
                break;
            case TablaColMenu.Accion.Agrupar:
                {
                    var g = GrupoDeClave(col.Key);
                    if (g is null) { ColToast("Agrupar por este campo no esta disponible."); break; }
                    SetAgrupar(g);
                }
                break;
            case TablaColMenu.Accion.Filtrar:
                if (_fd is not null && CamposFiltro.Any(c => c.Key == col.Key))
                    await _fd.AgregarReglaCampo(col.Key);
                else ColToast("Filtrar por este campo aun no esta disponible; usa el boton Filtros.");
                break;
        }
        StateHasChanged();
    }
    // Duplica un campo propio (definicion) reutilizando el catalogo del modulo, y recarga columnas.
    private async Task DuplicarCampoAsync(CampoDinDef campo)
    {
        var req = new CrearCampoDefinicionRequest(campo.Label + " (copia)", campo.Tipo, campo.Opciones, campo.Descripcion);
        var r = await Auth().PostAsJsonAsync("/api/mi-copropiedad/mascotas-campos", req);
        if (r.IsSuccessStatusCode) { await CargarCamposAsync(Auth()); ColToast("Campo duplicado."); }
        else ColToast("No se pudo duplicar el campo.");
    }
    // Traduce la clave de columna a la dimension de agrupacion soportada (SetAgrupar). null = no soportado.
    private string? GrupoDeClave(string clave)
    {
        if (clave.StartsWith("cd:", StringComparison.Ordinal)) return CampoCustom(clave) is not null ? clave : null;
        return clave switch
        {
            "tipo" => "tipo", "unidad" => "unidad", "propietario" => "propietario", _ => null
        };
    }

    // ===== Ordenar multi-criterio apilable (boton "Ordenar", canonico) =====
    // El clic en cabecera es el caso de un solo criterio, sincronizado con esta misma lista; el
    // indicador de cabecera deriva del primer criterio.
    private List<TablaOrdenarMenu.Sort> _sorts = new();
    private string? _sortKey => _sorts.Count > 0 ? _sorts[0].Key : null;
    private int _sortDir => _sorts.Count > 0 ? _sorts[0].Dir : 1;
    // Columnas ofrecidas en el menu Ordenar: las visibles (estructurales + sistema + dinamicas "cd:{id}").
    private List<TablaOrdenarMenu.Col> ColsOrdenables()
        => ColsVisibles().Select(k => new TablaOrdenarMenu.Col(k, ColLabel(k))).ToList();
    private void OnSortsChanged() { _pagina = 1; StateHasChanged(); }
    // Clic en cabecera: opera _sorts como un unico criterio (reclic invierte, otra columna reemplaza).
    private void OrdenarPorColumna(string clave)
    {
        var ex = _sorts.FirstOrDefault(s => s.Key == clave);
        if (_sorts.Count == 1 && ex is not null) ex.Dir = -ex.Dir;
        else _sorts = new() { new TablaOrdenarMenu.Sort { Key = clave, Dir = 1 } };
        _pagina = 1;
    }
    private string SortStr(MascotaResumenDto v, string k)
    {
        var cd = CampoCustom(k);
        if (cd is not null) return ValorDe(v.MascotaId, cd.Id) ?? "";
        return k switch
        {
            "unidad" => v.UnidadCodigo ?? "",
            "nombre" => v.Nombre ?? "",
            "tipo" => EfectivoTipoLabel(v),
            "raza" => v.Raza ?? "",
            "propietario" => v.PropietarioNombre ?? "",
            _ => ""
        };
    }
    private static int CmpValTabla(string a, string b)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var na = decimal.TryParse(a, System.Globalization.NumberStyles.Any, ci, out var da);
        var nb = decimal.TryParse(b, System.Globalization.NumberStyles.Any, ci, out var db);
        if (na && nb) return da.CompareTo(db);
        if (na) return -1; if (nb) return 1;
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    // ===== Mover columna por ARRASTRE (JS propiaTablaColReorder) =====
    private DotNetObjectReference<MascotasPanel>? _self;
    private async Task IniciarReorder(MouseEventArgs e, string clave)
    {
        _self ??= DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _self, clave, e.ClientX, e.ClientY); } catch { }
    }
    [JSInvokable]
    public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        var keys = ClavesOrdenadas().ToList();
        var from = keys.IndexOf(src); var to = keys.IndexOf(dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, src);
        for (int i = 0; i < keys.Count; i++) await GuardarCfgAsync(FilaConfig(keys[i]) with { Orden = i });
        await CargarCfgAsync(); StateHasChanged();
    }

    // ===== Redimensionar columnas (persiste en Formato JSON, clave "w") =====
    private readonly Dictionary<string, int> _colW = new(StringComparer.Ordinal);
    private async Task IniciarResize(MouseEventArgs e, string clave)
    {
        _self ??= DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("propiaTablaResize.start", _self, clave, e.ClientX); } catch { }
    }
    private Task ResetResize(string clave) => OnColResize(clave, 0);
    [JSInvokable]
    public async Task OnColResize(string clave, int width)
    {
        int? w = width <= 0 ? null : Math.Max(70, width);
        if (w is null) _colW.Remove(clave); else _colW[clave] = w.Value;
        var fila = FilaConfig(clave);
        await GuardarCfgAsync(fila with { Formato = ConAnchoTabla(fila.Formato, w) });
        await CargarCfgAsync(); HidratarAnchos(); StateHasChanged();
    }
    private void HidratarAnchos()
    {
        _colW.Clear();
        foreach (var kv in _cfg) { var w = AnchoDeFormatoTabla(kv.Value.Formato); if (w is > 0) _colW[kv.Key] = w.Value; }
    }
    private static int? AnchoDeFormatoTabla(string? json)
    {
        try { var o = System.Text.Json.Nodes.JsonNode.Parse(json ?? "") as System.Text.Json.Nodes.JsonObject; return o? ["w"]?.GetValue<int>(); }
        catch { return null; }
    }
    private static string? ConAnchoTabla(string? json, int? w)
    {
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(json) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (w is null) o.Remove("w"); else o["w"] = w.Value;
        return o.Count == 0 ? null : o.ToJsonString();
    }
    public void Dispose() { _self?.Dispose(); }

    // ===== Menu contextual (clic derecho) =====
    private bool _ctxOpen;
    private double _ctxX, _ctxY;
    private List<TablaCtxMenu.Item> _ctxItems = new();
    private void AbrirCtx(MouseEventArgs e, MascotaResumenDto v)
    {
        _ctxX = e.ClientX; _ctxY = e.ClientY;
        _ctxItems = new()
        {
            new("Insertar registro arriba", "fi-rr-arrow-small-up", OnClick: StubCtx),
            new("Insertar registro abajo", "fi-rr-arrow-small-down", OnClick: StubCtx),            new("Abrir la unidad", "fi-rr-expand", OnClick: () => { AbrirUnidad(v); return Task.CompletedTask; }),
            new(Sep: true),
            new("Eliminar registro", "fi-rr-trash", Danger: true, OnClick: () => EliminarAsync(v)),
        };
        _ctxOpen = true;
    }
    private Task StubCtx() { Mensaje("Accion aun no disponible en esta version.", false); StateHasChanged(); return Task.CompletedTask; }

    // Al cerrar el panel de campos se recarga el catalogo + config.
    private async Task CerrarConfig()
    {
        _configAbierto = false;
        try { await CargarCamposAsync(Auth()); } catch { }
    }

    // Un fallo no puede quedarse mudo: el 403 de permisos es el caso frecuente.
    private static async Task<string> MotivoAsync(HttpResponseMessage r)
    {
        if (r.StatusCode == System.Net.HttpStatusCode.Forbidden)
            return "No tienes permiso para esta accion en Mi Copropiedad. Pidele a un Administrador que lo habilite.";
        try
        {
            var body = await r.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (body is not null && body.TryGetValue("error", out var e) && !string.IsNullOrWhiteSpace(e)) return e;
        }
        catch { }
        return $"El servidor respondio {(int)r.StatusCode}.";
    }

    private void Mensaje(string texto, bool error)
    {
        _msg = texto; _msgError = error;
        StateHasChanged();
    }
}

