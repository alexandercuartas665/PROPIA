@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

@if (!Embedded) { <PageTitle>Mascotas - PROPIA</PageTitle> }

@* Mascotas: vista agregada de TODAS las mascotas de las unidades. Hermano de /vehiculos y del
   modulo de residentes. Vista tabla estandar del sistema, homogenea con Zonas/Equipos: columnas
   dinamicas (sistema + propias) dirigidas por unidades-config (entidad 'mascotas'), seleccion
   multiple + borrado masivo, alta "nace fila", menu Columnas, "+"/engranaje -> CrearCampoModal,
   ordenar/mover/redimensionar columnas y menu contextual. *@

@if (!Embedded)
{
    <div class="mas-pagehead">
        <h1 class="mas-pagetitle">Mascotas</h1>
        <p class="mas-pagesub">Todas las mascotas registradas en las unidades de @(_copNombre ?? "la copropiedad").</p>
    </div>
}

@if (!_authChecked || _jwt is null)
{
    <div class="mas-loading"><div class="spinner-border" style="color: var(--propia-brand);"></div></div>
}
else
{
    <div class="mas-bar">
        <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="@(() => { _pagina = 1; StateHasChanged(); })" />
        <div class="mas-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input placeholder="Buscar nombre, raza, unidad o propietario..." value="@_q" @oninput="OnBuscar" />
        </div>
        <div class="mas-spacer"></div>

        @* Ordenar (multi-criterio apilable): fuente unica compartida. *@
        <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sorts" SortsChanged="OnSortsChanged" />

        @* Agrupar *@
        <div class="mas-menu-wrap">
            <button type="button" class="mas-fbtn @(_agruparPor != "" ? "on" : "")" @onclick="() => _showAgrupar = !_showAgrupar" title="Agrupar filas">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                <span>@(_agruparPor == "" ? "Agrupar" : AgruparLabel(_agruparPor))</span>
            </button>
            @if (_showAgrupar)
            {
                <div class="mas-menu-bd" @onclick="() => _showAgrupar = false"></div>
                <div class="mas-menu">
                    @foreach (var g in new[] { ("", "Sin agrupar"), ("tipo", "Tipo de mascota"), ("unidad", "Unidad"), ("propietario", "Propietario") })
                    {
                        var gk = g.Item1;
                        <button class="mas-menu-it @(_agruparPor == gk ? "on" : "")" @onclick="() => SetAgrupar(gk)">@g.Item2</button>
                    }
                    @foreach (var d in _defs)
                    {
                        var gk = "cd:" + d.Id;
                        <button class="mas-menu-it @(_agruparPor == gk ? "on" : "")" @onclick="@(() => SetAgrupar(gk))">@d.Label</button>
                    }
                </div>
            }
        </div>

        @* "Columnas" (inline, milimetrico a Unidades/Zonas): orden, visibilidad y borrar campo dinamico.
           Crear campo nuevo = "+" del header de la tabla; editar/eliminar = engranaje de la columna. *@
        <div class="mas-menu-wrap">
            <button type="button" class="mas-fbtn @(_showColMenu ? "on" : "")" @onclick="() => _showColMenu = !_showColMenu" title="Columnas: orden, visibilidad y campos">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                <span>Columnas</span>
            </button>
            @if (_showColMenu)
            {
                <div class="mas-menu-bd" @onclick="() => _showColMenu = false"></div>
                <div class="mas-menu mas-colmenu">
                    <div class="mas-col-search">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                        <input placeholder="Buscar campo..." value="@_colQ" @oninput="@(e => _colQ = e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="mas-col-list">
                        @{ var _cols = ClavesOrdenadas().ToList(); }
                        @for (int _ci = 0; _ci < _cols.Count; _ci++)
                        {
                            var k = _cols[_ci];
                            var idx = _ci;
                            var label = ColLabel(k);
                            if (!string.IsNullOrWhiteSpace(_colQ) && !label.Contains(_colQ, StringComparison.OrdinalIgnoreCase)) { continue; }
                            var fija = idx == 0;
                            var visible = VisibleCol(k);
                            var custom = CampoCustom(k);
                            <div class="mas-col-it">
                                <button class="mas-col-mv" disabled="@(idx <= 1)" @onclick="() => MoverColumnaAsync(k, -1)">&#9650;</button>
                                <button class="mas-col-mv" disabled="@(idx == 0 || idx == _cols.Count - 1)" @onclick="() => MoverColumnaAsync(k, 1)">&#9660;</button>
                                <span class="mas-col-name">@label @if (custom is not null) { <span class="mas-col-dyn" title="Campo personalizado">din</span> }</span>
                                @if (fija) { <span class="mas-col-fija">fija</span> }
                                else
                                {
                                    <button class="mas-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => ToggleVisibleColAsync(k)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                }
                                @if (custom is not null) { <button class="mas-col-del" title="Eliminar campo (definicion y valores)" @onclick="() => _campoAEliminar = custom"><i class="fi fi-rr-trash"></i></button> }
                            </div>
                        }
                    </div>
                    <div class="mas-col-massacts">
                        <button type="button" class="mas-col-mass" @onclick="OcultarTodasColAsync"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                        <button type="button" class="mas-col-mass" @onclick="MostrarTodasColAsync"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                        <button type="button" class="mas-col-reset" @onclick="RestablecerColAsync">Restablecer</button>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_msg)) { <div class="mas-msg @(_msgError ? "err" : "ok")">@_msg</div> }

    @if (_sel.Count > 0)
    {
        <div class="mas-selbar">
            <span class="mas-selbar-n">@_sel.Count seleccionada@(_sel.Count == 1 ? "" : "s")</span>
            <button type="button" class="mas-selbar-del" @onclick="() => _confirmDelSel = true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                Eliminar
            </button>
            <button type="button" class="mas-selbar-x" @onclick="LimpiarSel">Deseleccionar</button>
        </div>
    }
    @if (_confirmDelSel)
    {
        <div class="mas-cfg-back" @onclick="() => { if (!_delBusy) _confirmDelSel = false; }">
            <div class="mas-confirm" @onclick:stopPropagation="true">
                <div class="mas-confirm-t">Eliminar @_sel.Count mascota@(_sel.Count == 1 ? "" : "s")</div>
                <div class="mas-confirm-s">Esta accion quita las mascotas seleccionadas de sus unidades de forma permanente y no se puede deshacer.</div>
                <div class="mas-confirm-acts">
                    <button type="button" class="mas-fbtn" @onclick="() => _confirmDelSel = false" disabled="@_delBusy">Cancelar</button>
                    <button type="button" class="mas-selbar-del" @onclick="EliminarSelAsync" disabled="@_delBusy">@(_delBusy ? "Eliminando..." : "Si, eliminar")</button>
                </div>
            </div>
        </div>
    }
    @if (_campoAEliminar is not null)
    {
        <div class="mas-cfg-back" @onclick="() => { if (!_colBusy) _campoAEliminar = null; }">
            <div class="mas-confirm" @onclick:stopPropagation="true">
                <div class="mas-confirm-t">Eliminar campo "@_campoAEliminar.Label"</div>
                <div class="mas-confirm-s">Se elimina la definicion del campo y todos sus valores en las mascotas. No se puede deshacer.</div>
                <div class="mas-confirm-acts">
                    <button type="button" class="mas-fbtn" @onclick="() => _campoAEliminar = null" disabled="@_colBusy">Cancelar</button>
                    <button type="button" class="mas-selbar-del" @onclick="EliminarCampoDinAsync" disabled="@_colBusy">@(_colBusy ? "Eliminando..." : "Si, eliminar campo")</button>
                </div>
            </div>
        </div>
    }

    @* ===== Tabla ===== *@
    <div class="mas-table">
        <div class="mas-scroll">
            @* La clase zc-list-head la usa el JS de redimensionar (propiaTablaResize) para ubicar la
               celda por data-clave; no aporta estilos en esta pagina (solo mas-head los define). *@
            <div class="mas-head mas-grid zc-list-head" style="grid-template-columns:@GridCols">
                <div class="mas-sel-cell"><label class="mas-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodasSel" @onchange="@(e => ToggleSelAll((bool)(e.Value ?? false)))" /></label></div>
                <div></div>
                @foreach (var k in ColsVisibles())
                {
                    var clave = k;
                    if (CampoCustom(clave) is not null)
                    {
                        <div class="mas-th-dyn mas-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                             @onmousedown="e => IniciarReorder(e, clave)" @onclick="() => OrdenarPorColumna(clave)">
                            <span class="mas-th-lbl">@ColLabel(clave).ToUpperInvariant()</span>
                            @if (_sortKey == clave) { <span class="mas-th-arrow">@((MarkupString)(_sortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                            @ChevCol(clave, ColLabel(clave), true)
                            <span class="mas-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResize(clave)" @ondblclick:stopPropagation="true"></span>
                        </div>
                    }
                    else
                    {
                        <div class="mas-th-dyn mas-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                             @onmousedown="e => IniciarReorder(e, clave)" @onclick="() => OrdenarPorColumna(clave)">
                            <span class="mas-th-lbl">@ColLabel(clave).ToUpperInvariant()</span>
                            @if (_sortKey == clave) { <span class="mas-th-arrow">@((MarkupString)(_sortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                            @ChevCol(clave, ColLabel(clave), false)
                            <span class="mas-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResize(clave)" @ondblclick:stopPropagation="true"></span>
                        </div>
                    }
                }
                <div></div>
                <div class="mas-addcol-h"><button type="button" class="mas-addcol-btn" title="Crear campo nuevo (columna)" @onclick="AbrirCrearCampo"><i class="fi fi-rr-plus"></i></button></div>
            </div>

            @foreach (var item in FilasRender())
            {
                if (item.EsGrupo)
                {
                    <div class="mas-group">
                        <span class="mas-group-chip">@item.GrupoTitulo</span>
                        <span class="mas-group-n">@item.GrupoCount</span>
                    </div>
                    continue;
                }
                var v = item.Fila!;
                <div class="mas-row mas-grid @(_recienCreados.Contains(v.MascotaId) ? "mas-row-nuevo" : "") @(_sel.Contains(v.MascotaId) ? "mas-row-sel" : "")" style="grid-template-columns:@GridCols"
                     @oncontextmenu="e => AbrirCtx(e, v)" @oncontextmenu:preventDefault="true">
                    <div class="mas-sel-cell"><label class="mas-chk"><input type="checkbox" checked="@_sel.Contains(v.MascotaId)" @onchange="@(e => ToggleSel(v.MascotaId, (bool)(e.Value ?? false)))" @onclick:stopPropagation="true" /></label></div>
                    <div class="mas-col-exp">
                        <button type="button" class="mas-exp-fijo" title="Abrir la unidad de esta mascota" @onclick="() => AbrirUnidad(v)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @foreach (var k in ColsVisibles())
                    {
                        if (CampoCustom(k) is CampoDinDef def)
                        {
                            var d = def;
                            var val = ValorDe(v.MascotaId, def.Id);
                            if (def.Tipo == TipoCampoTablero.Seleccion)
                            {
                                <div class="mas-selcell">
                                    @if (!string.IsNullOrWhiteSpace(val))
                                    {
                                        var col = ColorOpcion(def, val);
                                        <span class="mas-chip" style="background:@(col ?? PaletaChips.Neutro);color:@PaletaChips.TextoSobre(col)">@val</span>
                                    }
                                    <select class="mas-editcell" value="@val" @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())">
                                        <option value="">-</option>
                                        @foreach (var op in def.OpcionesArray()) { <option value="@op" selected="@(op == val)">@op</option> }
                                    </select>
                                </div>
                            }
                            else if (def.Tipo == TipoCampoTablero.Formula)
                            {
                                <div class="mas-cell mas-auto" title="Se calcula automaticamente">@(string.IsNullOrWhiteSpace(val) ? "-" : val)</div>
                            }
                            else if (def.Tipo == TipoCampoTablero.Usuario)
                            {
                                <select class="mas-editcell" value="@val" @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())">
                                    <option value="">-</option>
                                    @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId" selected="@(u.PersonaId.ToString() == val)">@u.NombreCompleto</option> }
                                </select>
                            }
                            else if (def.Tipo == TipoCampoTablero.Directorio)
                            {
                                <div class="mas-cell">@(NombrePersona(val) ?? "-")</div>
                            }
                            else if (def.Tipo == TipoCampoTablero.Numero || def.Tipo == TipoCampoTablero.Moneda)
                            {
                                <input class="mas-editcell" type="number" step="any" value="@val" @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())" />
                            }
                            else if (def.Tipo == TipoCampoTablero.Fecha)
                            {
                                <input class="mas-editcell" type="date" value="@val" @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())" />
                            }
                            else
                            {
                                <input class="mas-editcell" value="@val" placeholder="-"
                                       @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())" />
                            }
                            continue;
                        }
                        switch (k)
                        {
                            case "unidad":
                                <div class="mas-cell"><span class="mas-cod">@v.UnidadCodigo</span></div>
                                break;
                            case "nombre":
                                <input class="mas-editcell" value="@v.Nombre" placeholder="-" @onchange="e => GuardarNombreAsync(v, e.Value?.ToString())" />
                                break;
                            case "tipo":
                                <select class="mas-editcell" @onchange="e => GuardarTipoAsync(v, e.Value?.ToString())">
                                    @foreach (var t in TiposMascota) { <option value="@t" selected="@(v.Tipo == t)">@TipoLabel(t)</option> }
                                </select>
                                break;
                            case "raza":
                                <input class="mas-editcell" value="@v.Raza" placeholder="-" @onchange="e => GuardarRazaAsync(v, e.Value?.ToString())" />
                                break;
                            case "propietario":
                                <div class="mas-cell mas-prop">@(string.IsNullOrWhiteSpace(v.PropietarioNombre) ? "-" : v.PropietarioNombre)</div>
                                break;
                        }
                    }
                    <div class="mas-acts">
                        <button type="button" class="mas-del" title="Quitar la mascota" @onclick="() => EliminarAsync(v)">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                        </button>
                    </div>
                    <div class="mas-addcol-cell"></div>
                </div>
            }

            @* Alta "nace fila": CTA morado -> fila editable con foco redondeado + acciones checkmark/x.
               Enter guarda, Esc cancela. La primera columna estructural (unidad) usa el selector. *@
            @if (_altaAbierta)
            {
                <div class="mas-newrow mas-newrow--edit mas-grid" style="grid-template-columns:@GridCols" @key="_nonce" @onkeydown="OnAltaKeydown">
                    <div class="mas-sel-cell"></div>
                    <div class="mas-col-exp">
                        <span class="mas-exp-mut" title="Nueva mascota">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </span>
                    </div>
                    @foreach (var k in ColsVisibles())
                    {
                        if (CampoCustom(k) is CampoDinDef def)
                        {
                            var d = def;
                            var dv = _nuDinamicos.TryGetValue(def.Id, out var _dv) ? _dv : "";
                            if (def.Tipo == TipoCampoTablero.Seleccion)
                            {
                                <select class="mas-row-inp" value="@dv" @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())">
                                    <option value="">@def.Label</option>
                                    @foreach (var op in def.OpcionesArray()) { <option value="@op" selected="@(op == dv)">@op</option> }
                                </select>
                            }
                            else if (def.Tipo == TipoCampoTablero.Formula)
                            {
                                <div class="mas-cell mas-auto">(se calcula)</div>
                            }
                            else if (def.Tipo == TipoCampoTablero.Usuario)
                            {
                                <select class="mas-row-inp" value="@dv" @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())">
                                    <option value="">@def.Label</option>
                                    @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId" selected="@(u.PersonaId.ToString() == dv)">@u.NombreCompleto</option> }
                                </select>
                            }
                            else if (def.Tipo == TipoCampoTablero.Directorio)
                            {
                                <SelectorPersona Flotante="true" Jwt="@_jwt" Placeholder="@def.Label"
                                                 SeleccionadaChanged="c => OnDirectorioNuevo(d.Id, c)" />
                            }
                            else if (def.Tipo == TipoCampoTablero.Numero || def.Tipo == TipoCampoTablero.Moneda)
                            {
                                <input class="mas-row-inp" type="number" step="any" placeholder="@def.Label" value="@dv"
                                       @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())" />
                            }
                            else if (def.Tipo == TipoCampoTablero.Fecha)
                            {
                                <input class="mas-row-inp" type="date" value="@dv"
                                       @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())" />
                            }
                            else
                            {
                                <input class="mas-row-inp" placeholder="@def.Label" value="@dv"
                                       @oninput="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())" />
                            }
                            continue;
                        }
                        switch (k)
                        {
                            case "unidad":
                                <div class="mas-nf-unidad">
                                    <SelectorUnidadCodigo Unidades="_unidades" UnidadId="_nuUnidadId" UnidadIdChanged="OnUnidadSel"
                                                          Class="mas-row-inp" Placeholder="Unidad (ej. A1-101)" />
                                </div>
                                break;
                            case "nombre":
                                <input class="mas-row-inp" @ref="_nombreRef" placeholder="Nombre" value="@_nuNombre" @oninput="OnNombreNuevo" />
                                break;
                            case "tipo":
                                <select class="mas-row-inp" @bind="_nuTipo">
                                    @foreach (var t in TiposMascota) { <option value="@t">@TipoLabel(t)</option> }
                                </select>
                                break;
                            case "raza":
                                <input class="mas-row-inp" placeholder="Raza" value="@_nuRaza" @oninput="OnRazaNueva" />
                                break;
                            case "propietario":
                                <div class="mas-cell mas-auto">(segun la unidad)</div>
                                break;
                        }
                    }
                    <div class="mas-acts mas-nf-actbtns">
                        <button type="button" class="mas-nf-ok" title="Guardar (Enter)" @onclick="AgregarAsync" disabled="@_busy">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                        </button>
                        <button type="button" class="mas-nf-cancel" title="Cancelar (Esc)" @onclick="CerrarAlta" disabled="@_busy">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                        </button>
                    </div>
                    <div class="mas-addcol-cell"></div>
                </div>
            }
            else
            {
                <div class="mas-newrow mas-newrow--cta mas-grid" style="grid-template-columns:@GridCols">
                    <div class="mas-sel-cell"></div>
                    <div class="mas-col-exp"></div>
                    <div class="mas-nf-ctacell" style="grid-column: 3 / -1;">
                        <button type="button" class="mas-nf-cta" @onclick="AbrirAlta">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                            Agregar registro
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (Grupos() is null)
        {
            <TablaPager Total="Filtradas.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="mascotas"
                        PaginaChanged="p => { _pagina = p; }" PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
        }
    </div>
}

@* Crear / editar UN campo (modal focalizado, replica de la maqueta). "+" crea; engranaje edita. *@
@if (_crearCampoAbierto)
{
    <CrearCampoModal Prefijo="mascotas"
                     TituloSingular="mascota"
                     Ejemplo="Ej. Numero de chip, Vacunas al dia"
                     Jwt="@_jwt"
                     Editar="_campoAEditar"
                     TiposAvanzados="false"
                     Guardado="RecargarTrasCrearCampo"
                     Cerrado="() => { _crearCampoAbierto = false; _campoAEditar = null; _insertTargetKey = null; }"
                     AbrirGestorAvanzado="AbrirGestorDesdeCrear" />
}

@* Menu contextual (clic derecho sobre una fila). *@
<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />

@* Menu de columna estilo Airtable (flecha del header) + toast, replica de Tareas. *@
<TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" />
@if (_colToast is not null)
{
    <div style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--propia-text-h1);color:var(--propia-text-inverse);padding:8px 16px;border-radius:9px;z-index:5000;font-size:12.5px;cursor:pointer;box-shadow:0 6px 18px rgba(27,42,58,.28);" @onclick="() => _colToast = null">@_colToast</div>
}

@* Panel de campos del modulo (gestor avanzado; fallback para tipos avanzados y formato). *@
@if (_configAbierto)
{
    <div class="mas-cg-back" @onclick="CerrarConfig">
        <div class="mas-cg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="mas-cg-head">
                <div>
                    <div class="mas-cg-title">Campos de la mascota</div>
                    <div class="mas-cg-sub">Se muestran como columnas de esta tabla y en la ficha de la unidad.</div>
                </div>
                <button class="mas-cg-x" type="button" @onclick="CerrarConfig" aria-label="Cerrar">&times;</button>
            </div>
            <div class="mas-cg-body">
                <ConfigCamposEntidad Prefijo="mascotas"
                                     TiposAvanzados="true"
                                     Catalogo="@MascotaCatalogo"
                                     TituloSingular="mascota" TituloPlural="Mascotas"
                                     Ejemplo="Ej. Numero de chip, Vacunas al dia" Jwt="@_jwt"
                                     Cambiado="RecargarCamposYConfigAsync" />
            </div>
        </div>
    </div>
}

@code {
    // Embebido en el hub de Configuracion: oculta su page-head/PageTitle.
    [Parameter] public bool Embedded { get; set; }

    private string? _jwt;
    private bool _authChecked;
    private string? _copNombre;
    private bool _busy, _msgError, _configAbierto;
    private string? _msg;

    private List<MascotaResumenDto> _mascotas = new();
    private List<UnidadDto> _unidades = new();
    private List<CampoDinDef> _defs = new();
    private Dictionary<Guid, Dictionary<Guid, string?>> _valores = new();
    private readonly HashSet<Guid> _recienCreados = new();

    // Alta inline "nace fila".
    private bool _altaAbierta;
    private bool _focusPending;
    private ElementReference _nombreRef;
    private int _nonce;
    private Guid? _nuUnidadId;
    private string _nuNombre = "";
    private string _nuRaza = "";
    private TipoMascota _nuTipo = TipoMascota.Perro;
    private readonly Dictionary<Guid, string> _nuDinamicos = new();

    private string _q = "";
    private FiltroDinamico? _fd;
    private string _agruparPor = "";
    private bool _showAgrupar;
    private int _pagina = 1, _porPagina = 25;

    // Tipos ofrecidos: los mismos que la ficha de la unidad.
    private static readonly TipoMascota[] TiposMascota = Enum.GetValues<TipoMascota>();
    private static string TipoLabel(TipoMascota t) => t.ToString();

    // ===== Columnas dinamicas dirigidas por unidades-config (entidad 'mascotas') =====
    // Estructurales (unidad, propietario) + de sistema (nombre, tipo, raza) + propias (cd:{id}).
    private const string EntCfg = "mascotas";
    private static readonly string[] ClavesEstructuralesInicio = { "unidad" };
    private static readonly string[] ClavesEstructuralesFin = { "propietario" };
    private Dictionary<string, UnidadCampoConfigDto> _cfg = new(StringComparer.Ordinal);

    private static bool EsCustom(string clave) => clave.StartsWith("cd:", StringComparison.Ordinal);
    private CampoDinDef? CampoCustom(string clave)
        => EsCustom(clave) && Guid.TryParse(clave[3..], out var g) ? _defs.FirstOrDefault(c => c.Id == g) : null;

    private IEnumerable<string> ClavesCandidatas()
        => ClavesEstructuralesInicio
            .Concat(MascotaCamposSistema.Todos.Select(c => c.Clave))
            .Concat(ClavesEstructuralesFin)
            .Concat(_defs.OrderBy(d => d.Orden).Select(d => "cd:" + d.Id));

    private bool VisibleColDefault(string clave)
    {
        if (EsCustom(clave)) return true;
        if (ClavesEstructuralesInicio.Contains(clave) || ClavesEstructuralesFin.Contains(clave)) return true;
        return MascotaCamposSistema.Por(clave)?.VisiblePorDefecto ?? true;
    }
    private bool VisibleCol(string clave)
        => _cfg.TryGetValue(clave, out var c) ? !c.Oculto : VisibleColDefault(clave);
    private int OrdenCol(string clave, int fallback)
        => _cfg.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;
    private IEnumerable<string> ClavesOrdenadas()
        => ClavesCandidatas().Select((k, i) => (k, ord: OrdenCol(k, i))).OrderBy(x => x.ord).Select(x => x.k);
    private IEnumerable<string> ColsVisibles() => ClavesOrdenadas().Where(VisibleCol);

    private string ColLabel(string clave)
    {
        if (_cfg.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias)) return c.Alias!;
        if (clave == "unidad") return "Unidad";
        if (clave == "propietario") return "Propietario";
        return CampoCustom(clave)?.Label ?? MascotaCamposSistema.Por(clave)?.Label ?? clave;
    }
    private static string ColWidth(string clave) => clave switch
    {
        "unidad" => "150px",
        "nombre" => "minmax(140px,1fr)",
        "tipo" => "120px",
        "raza" => "minmax(120px,1fr)",
        "propietario" => "minmax(170px,1.2fr)",
        _ => "minmax(140px,150px)"   // campos propios
    };
    private string GridCols => "38px 34px " + string.Join(" ", ColsVisibles().Select(k => _colW.TryGetValue(k, out var w) ? w + "px" : ColWidth(k))) + " 60px 40px";

    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "nombre", Label = "Nombre", Kind = "texto" },
        new() { Key = "raza", Label = "Raza", Kind = "texto" },
        new() { Key = "tipo", Label = "Tipo", Kind = "sel",
                Opciones = TiposMascota.Select(t => (t.ToString(), TipoLabel(t))).ToList() },
        new() { Key = "unidad", Label = "Unidad", Kind = "texto" },
        new() { Key = "propietario", Label = "Propietario", Kind = "texto" },
    };

    private List<MascotaResumenDto> Filtradas
    {
        get
        {
            var q = (_q ?? "").Trim();
            var baseSeq = _mascotas
                .Where(v => q == ""
                    || v.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (v.Raza ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                    || v.UnidadCodigo.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (v.PropietarioNombre ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
                .Where(v => _fd?.Pasa(campo => campo switch
                {
                    "nombre" => v.Nombre,
                    "raza" => v.Raza ?? "",
                    "tipo" => v.Tipo.ToString(),
                    "unidad" => v.UnidadCodigo,
                    "propietario" => v.PropietarioNombre ?? "",
                    _ => ""
                }) ?? true);
            if (_sorts.Count > 0)
            {
                var sorts = _sorts;
                var cmp = Comparer<MascotaResumenDto>.Create((a, b) =>
                {
                    foreach (var s in sorts)
                    {
                        var c = CmpValTabla(SortStr(a, s.Key), SortStr(b, s.Key)) * s.Dir;
                        if (c != 0) return c;
                    }
                    return 0;
                });
                return baseSeq.OrderBy(v => v, cmp).ToList();
            }
            return baseSeq.ToList();
        }
    }

    private sealed record GrupoMas(string Titulo, List<MascotaResumenDto> Items);

    private List<GrupoMas>? Grupos()
    {
        if (_agruparPor == "") return null;
        var items = Filtradas;
        // Agrupar por campo propio (dinamico): "cd:{id}", por el valor del campo en cada fila.
        if (_agruparPor.StartsWith("cd:", StringComparison.Ordinal))
        {
            if (CampoCustom(_agruparPor) is not CampoDinDef gcd) return null;
            return items.GroupBy(v => { var val = ValorDe(v.MascotaId, gcd.Id); return string.IsNullOrWhiteSpace(val) ? "Sin dato" : val!; })
                        .Select(g => new GrupoMas(g.Key, g.ToList()))
                        .OrderBy(g => g.Titulo.StartsWith("Sin ", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
                        .ThenBy(g => g.Titulo, StringComparer.CurrentCultureIgnoreCase)
                        .ToList();
        }
        var gs = _agruparPor switch
        {
            "tipo" => items.GroupBy(v => TipoLabel(v.Tipo)),
            "unidad" => items.GroupBy(v => v.UnidadCodigo),
            "propietario" => items.GroupBy(v => string.IsNullOrWhiteSpace(v.PropietarioNombre) ? "Sin propietario" : v.PropietarioNombre!),
            _ => null
        };
        if (gs is null) return null;
        return gs.Select(g => new GrupoMas(g.Key, g.ToList()))
                 .OrderBy(g => g.Titulo.StartsWith("Sin ", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
                 .ThenBy(g => g.Titulo, StringComparer.CurrentCultureIgnoreCase)
                 .ToList();
    }

    private sealed record FilaRender(bool EsGrupo, MascotaResumenDto? Fila, string GrupoTitulo = "", int GrupoCount = 0);

    // Con agrupacion se muestran los grupos completos (sin paginar), igual que en el resto del sistema.
    private IEnumerable<FilaRender> FilasRender()
    {
        var grupos = Grupos();
        if (grupos is not null)
        {
            foreach (var g in grupos)
            {
                yield return new FilaRender(true, null, g.Titulo, g.Items.Count);
                foreach (var v in g.Items) yield return new FilaRender(false, v);
            }
            yield break;
        }
        var desde = (_pagina - 1) * _porPagina;
        foreach (var v in Filtradas.Skip(desde).Take(_porPagina)) yield return new FilaRender(false, v);
    }

    private string AgruparLabel(string v)
    {
        if (v.StartsWith("cd:", StringComparison.Ordinal)) return CampoCustom(v)?.Label ?? "Campo";
        return v switch
        {
            "tipo" => "Tipo de mascota", "unidad" => "Unidad", "propietario" => "Propietario", _ => ""
        };
    }

    private void SetAgrupar(string v) { _agruparPor = v; _pagina = 1; _showAgrupar = false; }
    private void OnBuscar(ChangeEventArgs e) { _q = e.Value?.ToString() ?? ""; _pagina = 1; }
    private void OnUnidadSel(Guid? id) => _nuUnidadId = id;
    private void AbrirUnidad(MascotaResumenDto v) => Nav.NavigateTo($"/distribucion?unidad={v.UnidadId}");
    private void OnNombreNuevo(ChangeEventArgs e) => _nuNombre = e.Value?.ToString() ?? string.Empty;
    private void OnRazaNueva(ChangeEventArgs e) => _nuRaza = e.Value?.ToString() ?? string.Empty;
    private void SetDinamicoNuevo(Guid defId, string? valor) => _nuDinamicos[defId] = valor ?? string.Empty;

    private string? ValorDe(Guid mascotaId, Guid defId)
        => _valores.TryGetValue(mascotaId, out var d) && d.TryGetValue(defId, out var v) ? v : null;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            try { _jwt = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_jwt"); } catch { }
            if (string.IsNullOrWhiteSpace(_jwt)) { Nav.NavigateTo("/login?returnUrl=%2Fmascotas", true); return; }
            _authChecked = true;
            await CargarAsync();
            StateHasChanged();
            return;
        }
        if (_focusPending)
        {
            _focusPending = false;
            try { await _nombreRef.FocusAsync(); } catch { }
        }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _mascotas = await http.GetFromJsonAsync<List<MascotaResumenDto>>("/api/mi-copropiedad/mascotas") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            try { _copNombre = (await http.GetFromJsonAsync<ResumenMiCopropiedadDto>("/api/mi-copropiedad/resumen"))?.Identidad?.Nombre; } catch { }
            await CargarCamposAsync(http);
        }
        catch (Exception ex) { Mensaje("No se pudieron cargar las mascotas: " + ex.Message, true); }
    }

    // Catalogo de campos del SISTEMA de la mascota para el gestor compartido (Fase 1).
    private static readonly IReadOnlyList<CampoSistemaDef> MascotaCatalogo =
        MascotaCamposSistema.Todos.Select(c => new CampoSistemaDef(
            Clave: c.Clave,
            Label: c.Label,
            Tipo: c.Tipo,
            VisibleDefault: c.VisiblePorDefecto,
            Fija: c.Fija,
            OpcionesEditables: c.OpcionesEditables)).ToList();

    // El gestor compartido cambio algo: refresca columnas + valores + config de la tabla.
    private async Task RecargarCamposAsync()
    {
        try { await CargarCamposAsync(Auth()); } catch { }
        StateHasChanged();
    }
    private async Task RecargarCamposYConfigAsync()
    {
        try { await CargarCamposAsync(Auth()); } catch { }
        StateHasChanged();
    }

    // Color de la opcion elegida en un campo propio de tipo Lista (para el chip). null = chip neutro.
    private static string? ColorOpcion(CampoDinDef d, string? val)
        => d.OpcionesDetalle().FirstOrDefault(o => string.Equals(o.K, val, StringComparison.Ordinal))?.Color;

    // Catalogo de campos del modulo + valores de todos los registros + config de columnas (tres/cuatro llamadas).
    private async Task CargarCamposAsync(HttpClient http)
    {
        var defs = await http.GetFromJsonAsync<List<MascotaCampoDefinicionDto>>("/api/mi-copropiedad/mascotas-campos") ?? new();
        _defs = defs.OrderBy(d => d.Orden).ThenBy(d => d.Label)
                    .Select(d => new CampoDinDef(d.Id, d.Label, d.Orden, d.Tipo, d.Opciones, d.Descripcion)).ToList();

        var vals = await http.GetFromJsonAsync<List<MascotaCampoValorFlatDto>>("/api/mi-copropiedad/mascotas-campos-valores") ?? new();
        _valores = vals.GroupBy(v => v.UnidadMascotaId)
                       .ToDictionary(g => g.Key, g => g.ToDictionary(x => x.DefinicionId, x => x.Valor));

        try
        {
            var cfg = await http.GetFromJsonAsync<List<UnidadCampoConfigDto>>($"/api/mi-copropiedad/unidades-config?entidad={EntCfg}") ?? new();
            _cfg = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchos();
        }
        catch { _cfg = new(StringComparer.Ordinal); }

        // Fase 2: usuarios del tenant (campo Usuario) + mapa id->nombre (Usuario y Directorio), tenant-scoped.
        try { _usuariosTenant = await http.GetFromJsonAsync<List<UsuarioOpc>>("/api/usuarios") ?? new(); } catch { _usuariosTenant = new(); }
        try
        {
            var vinc = await http.GetFromJsonAsync<List<UsuarioOpc>>("/api/mi-copropiedad/personas-vinculadas") ?? new();
            _usuarioNombre = vinc.GroupBy(x => x.PersonaId).ToDictionary(g => g.Key, g => g.First().NombreCompleto);
        }
        catch { _usuarioNombre = new(); }
    }

    // ---- Fase 2: campos Usuario/Directorio ----
    private List<UsuarioOpc> _usuariosTenant = new();
    private Dictionary<Guid, string> _usuarioNombre = new();
    private sealed record UsuarioOpc(Guid PersonaId, string NombreCompleto, string? Email);

    private string? NombrePersona(string? val)
        => !string.IsNullOrWhiteSpace(val) && Guid.TryParse(val, out var g) && _usuarioNombre.TryGetValue(g, out var n) ? n : val;

    private void OnDirectorioNuevo(Guid defId, Propia.Application.Directorio.PersonaCandidatoDto? c)
    {
        if (c is null) { _nuDinamicos.Remove(defId); return; }
        SetDinamicoNuevo(defId, c.PersonaId.ToString());
        _usuarioNombre[c.PersonaId] = c.NombreCompleto;
    }

    // ===== Alta "nace fila" =====
    private void AbrirAlta()
    {
        _altaAbierta = true; _focusPending = true;
        _nuUnidadId = null; _nuNombre = ""; _nuRaza = ""; _nuTipo = TipoMascota.Perro; _nuDinamicos.Clear();
    }
    private void CerrarAlta() { _altaAbierta = false; }
    private async Task OnAltaKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CerrarAlta();
        else if (e.Key == "Enter") await AgregarAsync();
    }

    private async Task AgregarAsync()
    {
        if (_nuUnidadId is not Guid uid) { Mensaje("Elige la unidad de la mascota.", true); return; }
        if (string.IsNullOrWhiteSpace(_nuNombre)) { Mensaje("Escribe el nombre de la mascota.", true); return; }
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{uid}/mascotas",
                new CrearUnidadMascotaRequest(_nuNombre.Trim(), _nuTipo, string.IsNullOrWhiteSpace(_nuRaza) ? null : _nuRaza.Trim()));
            if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); return; }

            var creada = await resp.Content.ReadFromJsonAsync<UnidadMascotaDto>();
            // Los campos dinamicos se guardan despues del alta: necesitan el id del registro.
            if (creada is not null)
            {
                foreach (var (defId, valor) in _nuDinamicos.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                    await Auth().PutAsJsonAsync($"/api/mi-copropiedad/mascotas-campos-valores/{creada.Id}/{defId}",
                        new SetCampoValorRequest(valor));
                _recienCreados.Add(creada.Id);
            }

            _nuNombre = ""; _nuRaza = ""; _nuTipo = TipoMascota.Perro; _nuUnidadId = null; _nuDinamicos.Clear();
            _altaAbierta = false; _nonce++;
            await CargarAsync();
            Mensaje("Mascota agregada.", false);
        }
        catch (Exception ex) { Mensaje("No se pudo agregar: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task GuardarNombreAsync(MascotaResumenDto v, string? valor)
    {
        var nuevo = (valor ?? "").Trim();
        if (nuevo.Length == 0 || string.Equals(nuevo, v.Nombre, StringComparison.Ordinal)) return;
        await GuardarAsync(v.MascotaId, new ActualizarUnidadMascotaRequest(Nombre: nuevo));
    }

    private async Task GuardarRazaAsync(MascotaResumenDto v, string? valor)
    {
        var nueva = (valor ?? "").Trim();
        if (string.Equals(nueva, v.Raza ?? "", StringComparison.Ordinal)) return;
        await GuardarAsync(v.MascotaId, new ActualizarUnidadMascotaRequest(Raza: nueva));
    }

    private async Task GuardarTipoAsync(MascotaResumenDto v, string? valor)
    {
        if (!Enum.TryParse<TipoMascota>(valor, out var t) || t == v.Tipo) return;
        await GuardarAsync(v.MascotaId, new ActualizarUnidadMascotaRequest(Tipo: t));
    }

    private async Task GuardarAsync(Guid mascotaId, ActualizarUnidadMascotaRequest req)
    {
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-mascotas/{mascotaId}", req);
            if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); }
            await CargarAsync();
        }
        catch (Exception ex) { Mensaje("No se pudo guardar: " + ex.Message, true); }
    }

    private async Task GuardarDinamicoAsync(Guid mascotaId, Guid defId, string? valor)
    {
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/mascotas-campos-valores/{mascotaId}/{defId}",
                new SetCampoValorRequest(valor));
            if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); return; }
            if (!_valores.TryGetValue(mascotaId, out var d)) _valores[mascotaId] = d = new();
            d[defId] = valor;
        }
        catch (Exception ex) { Mensaje("No se pudo guardar el campo: " + ex.Message, true); }
    }

    private async Task EliminarAsync(MascotaResumenDto v)
    {
        bool ok;
        try { ok = await Js.InvokeAsync<bool>("confirm", $"Quitar la mascota {v.Nombre} de la unidad {v.UnidadCodigo}?"); }
        catch { ok = true; }
        if (!ok) return;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-mascotas/{v.MascotaId}");
            if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); return; }
            await CargarAsync();
            Mensaje("Mascota eliminada.", false);
        }
        catch (Exception ex) { Mensaje("No se pudo eliminar: " + ex.Message, true); }
    }

    // ===== Seleccion multiple + borrado masivo =====
    private readonly HashSet<Guid> _sel = new();
    private bool _confirmDelSel;
    private bool _delBusy;
    private void ToggleSel(Guid id, bool on) { if (on) _sel.Add(id); else _sel.Remove(id); }
    private void LimpiarSel() => _sel.Clear();
    private void ToggleSelAll(bool on) { _sel.Clear(); if (on) foreach (var v in Filtradas) _sel.Add(v.MascotaId); }
    private bool TodasSel { get { var ids = Filtradas.Select(v => v.MascotaId).ToList(); return ids.Count > 0 && ids.All(_sel.Contains); } }
    private async Task EliminarSelAsync()
    {
        if (_sel.Count == 0) return;
        _delBusy = true; int ok = 0, fail = 0;
        foreach (var id in _sel.ToList())
        {
            try { var r = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-mascotas/{id}"); if (r.IsSuccessStatusCode) ok++; else fail++; }
            catch { fail++; }
        }
        _sel.Clear(); _confirmDelSel = false; _delBusy = false;
        Mensaje(fail == 0 ? $"{ok} mascota(s) eliminada(s)." : $"{ok} eliminada(s), {fail} con error.", fail != 0);
        await CargarAsync(); StateHasChanged();
    }

    // ===== Menu "Columnas" inline (orden/visibilidad + borrar DIN) =====
    private bool _showColMenu;
    private string _colQ = "";
    private bool _colBusy;
    private CampoDinDef? _campoAEliminar;

    private GuardarUnidadCampoConfigRequest FilaConfig(string clave)
    {
        _cfg.TryGetValue(clave, out var c);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato,
            Oculto: c?.Oculto ?? !VisibleColDefault(clave), Orden: c?.Orden, Entidad: EntCfg);
    }
    private async Task GuardarCfgAsync(GuardarUnidadCampoConfigRequest req)
    {
        try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { }
    }
    private async Task CargarCfgAsync()
    {
        try
        {
            var cfg = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>($"/api/mi-copropiedad/unidades-config?entidad={EntCfg}") ?? new();
            _cfg = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchos();
        }
        catch { }
    }
    private async Task ToggleVisibleColAsync(string clave)
    {
        var visible = VisibleCol(clave);
        await GuardarCfgAsync(FilaConfig(clave) with { Oculto = visible });
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task MoverColumnaAsync(string clave, int dir)
    {
        var keys = ClavesOrdenadas().ToList();
        var i = keys.IndexOf(clave); var j = i + dir;
        if (i <= 0 || j <= 0 || j >= keys.Count) return; // la 1a columna ('unidad') queda fija
        (keys[i], keys[j]) = (keys[j], keys[i]);
        for (int k = 0; k < keys.Count; k++) await GuardarCfgAsync(FilaConfig(keys[k]) with { Orden = k });
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task OcultarTodasColAsync()
    {
        var keys = ClavesOrdenadas().ToList();
        for (int k = 0; k < keys.Count; k++)
        {
            if (k == 0) continue; // 'unidad' no se oculta
            await GuardarCfgAsync(FilaConfig(keys[k]) with { Oculto = true });
        }
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task MostrarTodasColAsync()
    {
        foreach (var k in ClavesOrdenadas()) await GuardarCfgAsync(FilaConfig(k) with { Oculto = false });
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task RestablecerColAsync()
    {
        foreach (var k in ClavesOrdenadas()) await GuardarCfgAsync(FilaConfig(k) with { Oculto = !VisibleColDefault(k), Orden = null });
        await CargarCfgAsync(); StateHasChanged();
    }
    private async Task EliminarCampoDinAsync()
    {
        if (_campoAEliminar is null) return;
        _colBusy = true;
        try
        {
            var r = await Auth().DeleteAsync($"/api/mi-copropiedad/mascotas-campos/{_campoAEliminar.Id}");
            Mensaje(r.IsSuccessStatusCode ? $"Campo \"{_campoAEliminar.Label}\" eliminado." : "No se pudo eliminar el campo.", !r.IsSuccessStatusCode);
            if (r.IsSuccessStatusCode) await CargarCamposAsync(Auth());
        }
        catch (Exception ex) { Mensaje("Error al eliminar el campo: " + ex.Message, true); }
        _campoAEliminar = null; _colBusy = false; StateHasChanged();
    }

    // ===== Crear / editar UN campo (modal focalizado) =====
    private bool _crearCampoAbierto;
    private CampoDinDef? _campoAEditar;
    private void AbrirCrearCampo() { _campoAEditar = null; _crearCampoAbierto = true; }
    private void AbrirEditarCampo(CampoDinDef c)
    {
        _campoAEditar = new CampoDinDef(c.Id, c.Label, c.Orden, c.Tipo, c.Opciones, c.Descripcion);
        _crearCampoAbierto = true;
    }
    private async Task RecargarTrasCrearCampo()
    {
        _crearCampoAbierto = false; _campoAEditar = null;
        await CargarCamposAsync(Auth());
        if (_insertTargetKey is not null) await ReposicionarNuevoAsync();
        StateHasChanged();
    }

    // "Insertar a la izquierda/derecha": tras crear el campo (que nace al final), lo coloca junto a la
    // columna elegida reescribiendo el orden de todas las columnas (config, entidad del modulo).
    private string? _insertTargetKey;
    private int _insertSide;
    private HashSet<Guid> _defsAntesInsert = new();
    private async Task ReposicionarNuevoAsync()
    {
        var target = _insertTargetKey; _insertTargetKey = null;
        if (target is null) return;
        var nuevo = _defs.FirstOrDefault(d => !_defsAntesInsert.Contains(d.Id));
        if (nuevo is null) return;
        var nuevoKey = "cd:" + nuevo.Id;
        var keys = ClavesOrdenadas().ToList();
        keys.Remove(nuevoKey);
        var ti = keys.IndexOf(target);
        if (ti < 0) return; // columna objetivo no visible: el campo queda al final
        var pos = _insertSide < 0 ? ti : ti + 1;
        if (pos < 1) pos = 1; // nunca antes de la 1a columna (fija)
        if (pos > keys.Count) pos = keys.Count;
        keys.Insert(pos, nuevoKey);
        for (int k = 0; k < keys.Count; k++) await GuardarCfgAsync(FilaConfig(keys[k]) with { Orden = k });
        await CargarCfgAsync();
        StateHasChanged();
    }
    private void AbrirGestorDesdeCrear()
    {
        _crearCampoAbierto = false; _campoAEditar = null;
        _configAbierto = true;
    }

    // ===== Menu de columna estilo Airtable (la flecha del header abre TablaColMenu) =====
    // Cablea las acciones reales del modulo; lo que depende de backend nuevo se avisa por toast.
    private TablaColMenu? _colMenu;
    private string? _colToast;
    private void ColToast(string m) { _colToast = m; StateHasChanged(); }
    private void AbrirColMenu(MouseEventArgs e, string clave, string label, bool dyn)
        => _colMenu?.Abrir(new TablaColMenu.Ctx(clave, label, dyn), e.ClientX, e.ClientY);
    // Flecha del header (reutiliza la clase del engranaje, sin CSS nuevo). Se inserta en cada columna.
    private RenderFragment ChevCol(string clave, string label, bool dyn) =>@<button type="button" class="mas-th-edit" title="Opciones de columna" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="(e) => AbrirColMenu(e, clave, label, dyn)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg></button>;
    private async Task OnColAccion((TablaColMenu.Accion Accion, TablaColMenu.Ctx Col) a)
    {
        var (accion, col) = a;
        var campo = col.EsDinamico ? CampoCustom(col.Key) : null;
        switch (accion)
        {
            case TablaColMenu.Accion.OrdenarAsc:
                _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = 1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.OrdenarDesc:
                _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = -1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.Editar:
            case TablaColMenu.Accion.Descripcion:
                if (campo is not null) AbrirEditarCampo(campo);
                else ColToast("Los campos del sistema no editan su configuracion aqui.");
                break;
            case TablaColMenu.Accion.Eliminar:
                if (campo is not null) _campoAEliminar = campo;
                else ColToast("Los campos del sistema no se eliminan aqui.");
                break;
            case TablaColMenu.Accion.Duplicar:
                if (campo is not null) await DuplicarCampoAsync(campo);
                else ColToast("Solo se pueden duplicar campos propios.");
                break;
            case TablaColMenu.Accion.InsertarIzq:
            case TablaColMenu.Accion.InsertarDer:
                _insertTargetKey = col.Key;
                _insertSide = accion == TablaColMenu.Accion.InsertarIzq ? -1 : 1;
                _defsAntesInsert = _defs.Select(d => d.Id).ToHashSet();
                AbrirCrearCampo();
                break;
            case TablaColMenu.Accion.Ocultar:
                await ToggleVisibleColAsync(col.Key);
                break;
            case TablaColMenu.Accion.CopiarUrl:
                try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}mascotas#campo-{col.Key}"); ColToast("Enlace del campo copiado."); }
                catch { ColToast("No se pudo copiar el enlace."); }
                break;
            case TablaColMenu.Accion.Agrupar:
                {
                    var g = GrupoDeClave(col.Key);
                    if (g is null) { ColToast("Agrupar por este campo no esta disponible."); break; }
                    SetAgrupar(g);
                }
                break;
            case TablaColMenu.Accion.Filtrar:
                if (_fd is not null && CamposFiltro.Any(c => c.Key == col.Key))
                    await _fd.AgregarReglaCampo(col.Key);
                else ColToast("Filtrar por este campo aun no esta disponible; usa el boton Filtros.");
                break;
            case TablaColMenu.Accion.TituloIa:
                if (campo is not null)
                {
                    ColToast("Sugiriendo un titulo con IA...");
                    var _t = await Propia.Web.Components.Shared.IaCampoTitulo.SugerirAsync(Auth(), "mascotas", campo.Label);
                    if (_t.Ok && !string.IsNullOrWhiteSpace(_t.Titulo))
                    {
                        try
                        {
                            var _rr = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/mascotas-campos/{campo.Id}",
                                new ActualizarCampoDefinicionRequest(_t.Titulo!, campo.Tipo, campo.Opciones, campo.Orden, campo.Descripcion));
                            if (_rr.IsSuccessStatusCode) { await CargarCamposAsync(Auth()); ColToast($"Titulo IA aplicado: {_t.Titulo}"); }
                            else ColToast("No se pudo aplicar el titulo sugerido.");
                        }
                        catch { ColToast("No se pudo aplicar el titulo sugerido."); }
                    }
                    else ColToast("La IA no pudo sugerir un titulo ahora.");
                }
                else ColToast("Sugerir titulo con IA solo aplica a campos propios.");
                break;
        }
        StateHasChanged();
    }
    // Duplica un campo propio (definicion) reutilizando el catalogo del modulo, y recarga columnas.
    private async Task DuplicarCampoAsync(CampoDinDef campo)
    {
        var req = new CrearCampoDefinicionRequest(campo.Label + " (copia)", campo.Tipo, campo.Opciones, campo.Descripcion);
        var r = await Auth().PostAsJsonAsync("/api/mi-copropiedad/mascotas-campos", req);
        if (r.IsSuccessStatusCode) { await CargarCamposAsync(Auth()); ColToast("Campo duplicado."); }
        else ColToast("No se pudo duplicar el campo.");
    }
    // Traduce la clave de columna a la dimension de agrupacion soportada (SetAgrupar). null = no soportado.
    private string? GrupoDeClave(string clave)
    {
        if (clave.StartsWith("cd:", StringComparison.Ordinal)) return CampoCustom(clave) is not null ? clave : null;
        return clave switch
        {
            "tipo" => "tipo", "unidad" => "unidad", "propietario" => "propietario", _ => null
        };
    }

    // ===== Ordenar multi-criterio apilable (boton "Ordenar", canonico) =====
    // El clic en cabecera es el caso de un solo criterio, sincronizado con esta misma lista; el
    // indicador de cabecera deriva del primer criterio.
    private List<TablaOrdenarMenu.Sort> _sorts = new();
    private string? _sortKey => _sorts.Count > 0 ? _sorts[0].Key : null;
    private int _sortDir => _sorts.Count > 0 ? _sorts[0].Dir : 1;
    // Columnas ofrecidas en el menu Ordenar: las visibles (estructurales + sistema + dinamicas "cd:{id}").
    private List<TablaOrdenarMenu.Col> ColsOrdenables()
        => ColsVisibles().Select(k => new TablaOrdenarMenu.Col(k, ColLabel(k))).ToList();
    private void OnSortsChanged() { _pagina = 1; StateHasChanged(); }
    // Clic en cabecera: opera _sorts como un unico criterio (reclic invierte, otra columna reemplaza).
    private void OrdenarPorColumna(string clave)
    {
        var ex = _sorts.FirstOrDefault(s => s.Key == clave);
        if (_sorts.Count == 1 && ex is not null) ex.Dir = -ex.Dir;
        else _sorts = new() { new TablaOrdenarMenu.Sort { Key = clave, Dir = 1 } };
        _pagina = 1;
    }
    private string SortStr(MascotaResumenDto v, string k)
    {
        var cd = CampoCustom(k);
        if (cd is not null) return ValorDe(v.MascotaId, cd.Id) ?? "";
        return k switch
        {
            "unidad" => v.UnidadCodigo ?? "",
            "nombre" => v.Nombre ?? "",
            "tipo" => v.Tipo.ToString(),
            "raza" => v.Raza ?? "",
            "propietario" => v.PropietarioNombre ?? "",
            _ => ""
        };
    }
    private static int CmpValTabla(string a, string b)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var na = decimal.TryParse(a, System.Globalization.NumberStyles.Any, ci, out var da);
        var nb = decimal.TryParse(b, System.Globalization.NumberStyles.Any, ci, out var db);
        if (na && nb) return da.CompareTo(db);
        if (na) return -1; if (nb) return 1;
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    // ===== Mover columna por ARRASTRE (JS propiaTablaColReorder) =====
    private DotNetObjectReference<MascotasPanel>? _self;
    private async Task IniciarReorder(MouseEventArgs e, string clave)
    {
        _self ??= DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _self, clave, e.ClientX, e.ClientY); } catch { }
    }
    [JSInvokable]
    public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        var keys = ClavesOrdenadas().ToList();
        var from = keys.IndexOf(src); var to = keys.IndexOf(dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, src);
        for (int i = 0; i < keys.Count; i++) await GuardarCfgAsync(FilaConfig(keys[i]) with { Orden = i });
        await CargarCfgAsync(); StateHasChanged();
    }

    // ===== Redimensionar columnas (persiste en Formato JSON, clave "w") =====
    private readonly Dictionary<string, int> _colW = new(StringComparer.Ordinal);
    private async Task IniciarResize(MouseEventArgs e, string clave)
    {
        _self ??= DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("propiaTablaResize.start", _self, clave, e.ClientX); } catch { }
    }
    private Task ResetResize(string clave) => OnColResize(clave, 0);
    [JSInvokable]
    public async Task OnColResize(string clave, int width)
    {
        int? w = width <= 0 ? null : Math.Max(70, width);
        if (w is null) _colW.Remove(clave); else _colW[clave] = w.Value;
        var fila = FilaConfig(clave);
        await GuardarCfgAsync(fila with { Formato = ConAnchoTabla(fila.Formato, w) });
        await CargarCfgAsync(); HidratarAnchos(); StateHasChanged();
    }
    private void HidratarAnchos()
    {
        _colW.Clear();
        foreach (var kv in _cfg) { var w = AnchoDeFormatoTabla(kv.Value.Formato); if (w is > 0) _colW[kv.Key] = w.Value; }
    }
    private static int? AnchoDeFormatoTabla(string? json)
    {
        try { var o = System.Text.Json.Nodes.JsonNode.Parse(json ?? "") as System.Text.Json.Nodes.JsonObject; return o? ["w"]?.GetValue<int>(); }
        catch { return null; }
    }
    private static string? ConAnchoTabla(string? json, int? w)
    {
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(json) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (w is null) o.Remove("w"); else o["w"] = w.Value;
        return o.Count == 0 ? null : o.ToJsonString();
    }
    public void Dispose() { _self?.Dispose(); }

    // ===== Menu contextual (clic derecho) =====
    private bool _ctxOpen;
    private double _ctxX, _ctxY;
    private List<TablaCtxMenu.Item> _ctxItems = new();
    private void AbrirCtx(MouseEventArgs e, MascotaResumenDto v)
    {
        _ctxX = e.ClientX; _ctxY = e.ClientY;
        _ctxItems = new()
        {
            new("Insertar registro arriba", "fi-rr-arrow-small-up", OnClick: StubCtx),
            new("Insertar registro abajo", "fi-rr-arrow-small-down", OnClick: StubCtx),            new("Abrir la unidad", "fi-rr-expand", OnClick: () => { AbrirUnidad(v); return Task.CompletedTask; }),
            new("Copiar enlace del registro", "fi-rr-link-alt", OnClick: () => CopiarEnlace(v)),
            new(Sep: true),
            new("Eliminar registro", "fi-rr-trash", Danger: true, OnClick: () => EliminarAsync(v)),
        };
        _ctxOpen = true;
    }
    private Task StubCtx() { Mensaje("Accion aun no disponible en esta version.", false); StateHasChanged(); return Task.CompletedTask; }
    private async Task CopiarEnlace(MascotaResumenDto v)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}distribucion?unidad={v.UnidadId}"); Mensaje("Enlace del registro copiado.", false); }
        catch { Mensaje("No se pudo copiar el enlace.", true); }
        StateHasChanged();
    }

    // Al cerrar el panel de campos se recarga el catalogo + config.
    private async Task CerrarConfig()
    {
        _configAbierto = false;
        try { await CargarCamposAsync(Auth()); } catch { }
    }

    // Un fallo no puede quedarse mudo: el 403 de permisos es el caso frecuente.
    private static async Task<string> MotivoAsync(HttpResponseMessage r)
    {
        if (r.StatusCode == System.Net.HttpStatusCode.Forbidden)
            return "No tienes permiso para esta accion en Mi Copropiedad. Pidele a un Administrador que lo habilite.";
        try
        {
            var body = await r.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (body is not null && body.TryGetValue("error", out var e) && !string.IsNullOrWhiteSpace(e)) return e;
        }
        catch { }
        return $"El servidor respondio {(int)r.StatusCode}.";
    }

    private void Mensaje(string texto, bool error)
    {
        _msg = texto; _msgError = error;
        StateHasChanged();
    }
}

