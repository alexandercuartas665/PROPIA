    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            try { _jwt = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_jwt"); } catch { }
            if (string.IsNullOrWhiteSpace(_jwt)) { Nav.NavigateTo("/login?returnUrl=%2Fmascotas", true); return; }
            _authChecked = true;
            try { var _vv = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKeyM); if (_vv == "cards" || _vv == "tabla") _view = _vv; } catch { }
            await CargarAsync();
            StateHasChanged();
            return;
        }
        if (_focusPending)
        {
            _focusPending = false;
            // El cursor cae primero en la Unidad (1a columna, campo necesario para el expander).
            try { if (_unidadSelRef is not null) await _unidadSelRef.FocusAsync(); } catch { }
        }
        if (_view == "tabla")
        {
            _self ??= DotNetObjectReference.Create(this);
            // El guardado invisible del alta corre SIEMPRE (agrupado o no); solo el scroll infinito se gatea
            // a sin-agrupar. _agrupadoM va en la firma para re-enganchar al togglear la agrupacion.
            var sig = $"{_altaAbierta}|{Filtradas.Count}|{_agrupadoM}";
            if (sig != _wiredSigM)
            {
                _wiredSigM = sig;
                if (!_agrupadoM) { try { await Js.InvokeVoidAsync("propiaUI.dstInfinite", _self, ".mas-scroll"); } catch { } }
                // Guardado invisible de la fila de alta (clic fuera + Tab; ignora pickers y flotantes).
                if (_altaAbierta) { try { await Js.InvokeVoidAsync("propiaUI.altaAutoSave", _self, ".mas-newrow--edit", "AltaBlurGuardar", ".sp-pop"); } catch { } }
                else { try { await Js.InvokeVoidAsync("propiaUI.altaAutoSaveOff"); } catch { } }
            }
        }
        if (_scrollBottomPendingM)
        {
            _scrollBottomPendingM = false;
            try { await Js.InvokeVoidAsync("propiaUI.dstScrollToCta", ".mas-scroll"); } catch { }
        }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _mascotas = await http.GetFromJsonAsync<List<MascotaResumenDto>>("/api/mi-copropiedad/mascotas") ?? new();
            try { _catTipoMas = (await http.GetFromJsonAsync<List<CatalogoOpcionDto>>("/api/catalogos?lista=mascota.tipo") ?? new()).ToDictionary(o => o.Clave, o => o.Label, StringComparer.Ordinal); } catch { _catTipoMas = new(StringComparer.Ordinal); }
            if (_suppressRecienClearM) _suppressRecienClearM = false; else _recienCreados.Clear();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            try { _copNombre = (await http.GetFromJsonAsync<ResumenMiCopropiedadDto>("/api/mi-copropiedad/resumen"))?.Identidad?.Nombre; } catch { }
            await CargarCamposAsync(http);
        }
        catch (Exception ex) { Mensaje("No se pudieron cargar las mascotas: " + ex.Message, true); }
    }

