    // Guardado invisible: lo invoca propiaUI.altaAutoSave al SALIR de la fila (clic fuera o Tab tras el
    // ultimo campo). Con unidad + nombre crea; incompleta descarta sin error.
    [JSInvokable] public async Task AltaBlurGuardar()
    {
        if (!_altaAbierta || _busy) return;
        if (_nuUnidadId is null || string.IsNullOrWhiteSpace(_nuNombre)) { CerrarAlta(); StateHasChanged(); return; }
        await AgregarAsync();
        StateHasChanged();
    }

    // abrir=true (gesto del expander, canon Unidades): tras crear, abre la ficha de la mascota para completarla.
    private async Task AgregarAsync(bool abrir = false)
    {
        if (_nuUnidadId is not Guid uid) { Mensaje("Elige la unidad de la mascota.", true); return; }
        if (string.IsNullOrWhiteSpace(_nuNombre)) { Mensaje("Escribe el nombre de la mascota.", true); return; }
        _busy = true;
        try
        {
            var (tn, tc) = DesdeSelTipo(_nuTipoSel);
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{uid}/mascotas",
                new CrearUnidadMascotaRequest(_nuNombre.Trim(), tn, string.IsNullOrWhiteSpace(_nuRaza) ? null : _nuRaza.Trim(), tc, _nuPropietarioId));
            if (!resp.IsSuccessStatusCode) { Mensaje(await MotivoAsync(resp), true); return; }

            var creada = await resp.Content.ReadFromJsonAsync<UnidadMascotaDto>();
            // Los campos dinamicos se guardan despues del alta: necesitan el id del registro.
            if (creada is not null)
            {
                foreach (var (defId, valor) in _nuDinamicos.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                    await Auth().PutAsJsonAsync($"/api/mi-copropiedad/mascotas-campos-valores/{creada.Id}/{defId}",
                        new SetCampoValorRequest(valor));
                _recienCreados.Add(creada.Id); _suppressRecienClearM = true;
            }

            _nuNombre = ""; _nuRaza = ""; _nuTipoSel = _tipoOpciones.FirstOrDefault() ?? TipoLabel(TipoMascota.Perro); _nuUnidadId = null; _propSelNuevo = null; _nuPropietarioId = null; _nuDinamicos.Clear();
            _altaAbierta = false; _nonce++;
            await CargarAsync();
            Mensaje("Mascota agregada.", false);
            // Canon Unidades: crear + abrir la ficha para completar el registro.
            if (abrir && creada is not null) _fichaM = _mascotas.FirstOrDefault(x => x.MascotaId == creada.Id);
        }
        catch (Exception ex) { Mensaje("No se pudo agregar: " + ex.Message, true); }
        finally { _busy = false; }
    }

