@using Propia.Application.MiCopropiedad
@using Propia.Application.Catalogos
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals
@implements IDisposable

@if (!Embedded) { <PageTitle>Mascotas - PROPIA</PageTitle> }

@* Mascotas: vista agregada de TODAS las mascotas de las unidades. Hermano de /vehiculos y del
   modulo de residentes. Vista tabla estandar del sistema, homogenea con Zonas/Equipos: columnas
   dinamicas (sistema + propias) dirigidas por unidades-config (entidad 'mascotas'), seleccion
   multiple + borrado masivo, alta "nace fila", menu Columnas, "+"/engranaje -> CrearCampoModal,
   ordenar/mover/redimensionar columnas y menu contextual. *@

@if (!Embedded)
{
    <div class="mas-pagehead">
        <h1 class="mas-pagetitle">Mascotas</h1>
        <p class="mas-pagesub">Todas las mascotas registradas en las unidades de @(_copNombre ?? "la copropiedad").</p>
    </div>
}

@if (!_authChecked || _jwt is null)
{
    <div class="mas-loading"><div class="spinner-border" style="color: var(--propia-brand);"></div></div>
}
else
{
    <div class="mas-bar">
        <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="@(() => { _pagina = 1; StateHasChanged(); })" />
        <div class="mas-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input placeholder="Buscar nombre, raza, unidad o propietario..." value="@_q" @oninput="OnBuscar" />
        </div>
        <div class="mas-spacer"></div>

        @* Ordenar (multi-criterio apilable): fuente unica compartida. *@
        <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sorts" SortsChanged="OnSortsChanged" />

        @* Agrupar (menu compartido, multi-nivel), a la derecha, patron estandar.
           Fuente unica: TablaAgruparMenu (menu) + TablaAgrupador (motor) + TablaGruposRender (render). *@
        <TablaAgruparMenu Columnas="ColsAgrupablesM()" Grupos="_gruposM" GruposChanged="OnGruposMChanged" />

        @* "Columnas" (inline, milimetrico a Unidades/Zonas): orden, visibilidad y borrar campo dinamico.
           Crear campo nuevo = "+" del header de la tabla; editar/eliminar = engranaje de la columna. *@
        <div class="mas-menu-wrap">
            <button type="button" class="mas-fbtn @(_showColMenu ? "on" : "")" @onclick="() => _showColMenu = !_showColMenu" title="Columnas: orden, visibilidad y campos">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                <span>Columnas</span>
            </button>
            @if (_showColMenu)
            {
                <div class="mas-menu-bd" @onclick="() => _showColMenu = false"></div>
                <div class="mas-menu mas-colmenu">
                    <div class="mas-col-search">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                        <input placeholder="Buscar campo..." value="@_colQ" @oninput="@(e => _colQ = e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="mas-col-list">
                        @{ var _cols = ClavesOrdenadas().ToList(); }
                        @for (int _ci = 0; _ci < _cols.Count; _ci++)
                        {
                            var k = _cols[_ci];
                            var idx = _ci;
                            var label = ColLabel(k);
                            if (!string.IsNullOrWhiteSpace(_colQ) && !label.Contains(_colQ, StringComparison.OrdinalIgnoreCase)) { continue; }
                            var fija = idx == 0;
                            var visible = VisibleCol(k);
                            var custom = CampoCustom(k);
                            <div class="mas-col-it">
                                <button class="mas-col-mv" disabled="@(idx <= 1)" @onclick="() => MoverColumnaAsync(k, -1)">&#9650;</button>
                                <button class="mas-col-mv" disabled="@(idx == 0 || idx == _cols.Count - 1)" @onclick="() => MoverColumnaAsync(k, 1)">&#9660;</button>
                                <span class="mas-col-name">@label @if (custom is not null) { <span class="mas-col-dyn" title="Campo personalizado">din</span> }</span>
                                @if (fija) { <span class="mas-col-fija">fija</span> }
                                else
                                {
                                    <button class="mas-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => ToggleVisibleColAsync(k)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                }
                                @if (custom is not null) { <button class="mas-col-del" title="Eliminar campo (definicion y valores)" @onclick="() => _campoAEliminar = custom"><i class="fi fi-rr-trash"></i></button> }
                            </div>
                        }
                    </div>
                    <div class="mas-col-massacts">
                        <button type="button" class="mas-col-mass" @onclick="OcultarTodasColAsync"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                        <button type="button" class="mas-col-mass" @onclick="MostrarTodasColAsync"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                        <button type="button" class="mas-col-reset" @onclick="RestablecerColAsync">Restablecer</button>
                    </div>
                </div>
            }
        </div>
        @* Toggle Tarjetas / Tabla (canon = Equipos/Zonas/Residentes). *@
        <div class="mas-viewtoggle">
            <button type="button" class="mas-vt @(_view == "cards" ? "on" : "")" @onclick='() => SetVista("cards")' title="Tarjetas">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Tarjetas
            </button>
            <button type="button" class="mas-vt @(_view == "tabla" ? "on" : "")" @onclick='() => SetVista("tabla")' title="Tabla">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18M3 12h18M3 19h18"/></svg>
                Tabla
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_msg)) { <div class="mas-msg @(_msgError ? "err" : "ok")">@_msg</div> }

    @if (_sel.Count > 0)
    {
        <div class="mas-selbar">
            <span class="mas-selbar-n">@_sel.Count seleccionada@(_sel.Count == 1 ? "" : "s")</span>
            <button type="button" class="mas-selbar-del" @onclick="() => _confirmDelSel = true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                Eliminar
            </button>
            <button type="button" class="mas-selbar-x" @onclick="LimpiarSel">Deseleccionar</button>
        </div>
    }
    @if (_confirmDelSel)
    {
        <div class="mas-cfg-back" @onclick="() => { if (!_delBusy) _confirmDelSel = false; }">
            <div class="mas-confirm" @onclick:stopPropagation="true">
                <div class="mas-confirm-t">Eliminar @_sel.Count mascota@(_sel.Count == 1 ? "" : "s")</div>
                <div class="mas-confirm-s">Esta accion quita las mascotas seleccionadas de sus unidades de forma permanente y no se puede deshacer.</div>
                <div class="mas-confirm-acts">
                    <button type="button" class="mas-fbtn" @onclick="() => _confirmDelSel = false" disabled="@_delBusy">Cancelar</button>
                    <button type="button" class="mas-selbar-del" @onclick="EliminarSelAsync" disabled="@_delBusy">@(_delBusy ? "Eliminando..." : "Si, eliminar")</button>
                </div>
            </div>
        </div>
    }
    @* El modal de confirmacion de borrado se centralizo en Modals.ConfirmEliminarCampoAsync (doble confirmacion). *@

    @if (_view == "tabla")
    {
    @* ===== Tabla ===== *@
    <div class="mas-table">
        <div class="mas-scroll">
            @* La clase zc-list-head la usa el JS de redimensionar (propiaTablaResize) para ubicar la
               celda por data-clave; no aporta estilos en esta pagina (solo mas-head los define). *@
            <div class="mas-head mas-grid zc-list-head" style="grid-template-columns:@GridCols">
                <div class="mas-sel-cell"><label class="mas-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodasSel" @onchange="@(e => ToggleSelAll((bool)(e.Value ?? false)))" /></label></div>
                <div></div>
                @foreach (var k in ColsVisibles())
                {
                    var clave = k;
                    if (CampoCustom(clave) is not null)
                    {
                        <div class="mas-th-dyn mas-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                             @onmousedown="e => IniciarReorder(e, clave)" @onclick="() => OrdenarPorColumna(clave)">
                            <span class="mas-th-lbl">@ColLabel(clave).ToUpperInvariant()</span>
                            @if (_sortKey == clave) { <span class="mas-th-arrow">@((MarkupString)(_sortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                            @ChevCol(clave, ColLabel(clave), true)
                            <span class="mas-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResize(clave)" @ondblclick:stopPropagation="true"></span>
                        </div>
                    }
                    else
                    {
                        <div class="mas-th-dyn mas-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                             @onmousedown="e => IniciarReorder(e, clave)" @onclick="() => OrdenarPorColumna(clave)">
                            <span class="mas-th-lbl">@ColLabel(clave).ToUpperInvariant()</span>
                            @if (_sortKey == clave) { <span class="mas-th-arrow">@((MarkupString)(_sortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                            @ChevCol(clave, ColLabel(clave), false)
                            <span class="mas-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResize(clave)" @ondblclick:stopPropagation="true"></span>
                        </div>
                    }
                }
                <div></div>
                <div class="mas-addcol-h"><button type="button" class="mas-addcol-btn" title="Crear campo nuevo (columna)" @onclick="AbrirCrearCampo"><i class="fi fi-rr-plus"></i></button></div>
            </div>

            @* Filas: con agrupacion activa las pinta el render compartido (TablaGruposRender, arbol de
               TablaAgrupador, N niveles); sin agrupacion, la pagina actual. La fila hoja es FilaMTpl. *@
            @if (_agrupadoM)
            {
                <TablaGruposRender T="MascotaResumenDto" Nodos="TablaAgrupador.Agrupar<MascotaResumenDto>(Filtradas, _gruposM, ValorGrupoM)" FilaTemplate="FilaMTpl" />
            }
            else
            {
                @foreach (var v in MascotasRenderM())
                {
                    @FilaMTpl(v)
                }
            }

            @* Alta "nace fila": CTA morado -> fila editable con foco redondeado + acciones checkmark/x.
               Enter guarda, Esc cancela. La primera columna estructural (unidad) usa el selector. *@
            @if (_altaAbierta)
            {
                <div class="mas-newrow mas-newrow--edit mas-grid" style="grid-template-columns:@GridCols" @key="_nonce" @onkeydown="OnAltaKeydown">
                    <div class="mas-sel-cell"></div>
                    <div class="mas-col-exp">
                        @* Canon Unidades/skill 8: el expander del alta va SIEMPRE habilitado; CREA la mascota con lo
                           escrito y ABRE su ficha. Valida los minimos (unidad + nombre) al clic con toast (AgregarAsync). *@
                        <button type="button" class="mas-exp-fijo" title="Crear y abrir la ficha" @onclick="() => AgregarAsync(true)" disabled="@_busy">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @foreach (var k in ColsVisibles())
                    {
                        if (CampoCustom(k) is CampoDinDef def)
                        {
                            var d = def;
                            var dv = _nuDinamicos.TryGetValue(def.Id, out var _dv) ? _dv : "";
                            if (def.Tipo == TipoCampoTablero.Seleccion)
                            {
                                <select class="mas-row-inp" value="@dv" @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())">
                                    <option value="">@def.Label</option>
                                    @foreach (var op in def.OpcionesArray()) { <option value="@op" selected="@(op == dv)">@op</option> }
                                </select>
                            }
                            else if (def.Tipo == TipoCampoTablero.Formula)
                            {
                                <div class="mas-cell mas-auto">(se calcula)</div>
                            }
                            else if (def.Tipo == TipoCampoTablero.Usuario)
                            {
                                <select class="mas-row-inp" value="@dv" @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())">
                                    <option value="">@def.Label</option>
                                    @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId" selected="@(u.PersonaId.ToString() == dv)">@u.NombreCompleto</option> }
                                </select>
                            }
                            else if (def.Tipo == TipoCampoTablero.Directorio)
                            {
                                <SelectorPersona Flotante="true" Jwt="@_jwt" Placeholder="@def.Label"
                                                 SeleccionadaChanged="c => OnDirectorioNuevo(d.Id, c)" />
                            }
                            else if (def.Tipo == TipoCampoTablero.Numero || def.Tipo == TipoCampoTablero.Moneda)
                            {
                                <input class="mas-row-inp" type="number" step="any" placeholder="@def.Label" value="@dv"
                                       @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())" />
                            }
                            else if (def.Tipo == TipoCampoTablero.Fecha)
                            {
                                <input class="mas-row-inp" type="date" value="@dv"
                                       @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())" />
                            }
                            else
                            {
                                <input class="mas-row-inp" placeholder="@def.Label" value="@dv"
                                       @oninput="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())" />
                            }
                            continue;
                        }
                        switch (k)
                        {
                            case "unidad":
                                <div class="mas-nf-unidad">
                                    <SelectorUnidadCodigo @ref="_unidadSelRef" Unidades="_unidades" UnidadId="_nuUnidadId" UnidadIdChanged="OnUnidadSel"
                                                          Class="mas-row-inp" Placeholder="Unidad (ej. A1-101)" />
                                </div>
                                break;
                            case "nombre":
                                <input class="mas-row-inp" @ref="_nombreRef" placeholder="Nombre" value="@_nuNombre" @oninput="OnNombreNuevo" />
                                break;
                            case "tipo":
                                <select class="mas-row-inp" @bind="_nuTipoSel">
                                    @foreach (var o in _tipoOpciones) { <option value="@o">@o</option> }
                                </select>
                                break;
                            case "raza":
                                <input class="mas-row-inp" placeholder="Raza" value="@_nuRaza" @oninput="OnRazaNueva" />
                                break;
                            case "propietario":
                                @* Override opcional del Directorio; si se deja vacio, se usa el dueno de la unidad. *@
                                <div class="mas-nf-prop">
                                    <SelectorPersona Flotante="true" Jwt="@_jwt" Seleccionada="_propSelNuevo" SeleccionadaChanged="OnPropietarioNuevo"
                                                     PermiteEmpresa="false" Placeholder="Propietario (opcional)" />
                                </div>
                                break;
                        }
                    }
                    @* Guardado invisible: sin checkmark/x. Se guarda al salir de la fila (clic fuera) o al
                       terminar el tabulado (Tab); Enter guarda, Esc cancela. Celda de acciones vacia (alineacion). *@
                    <div class="mas-acts"></div>
                    <div class="mas-addcol-cell"></div>
                </div>
                @* Fila-aviso bajo la fila de alta (clases compartidas .tbl-nf-hint*). *@
                <div class="mas-newrow tbl-nf-hintrow mas-grid" style="grid-template-columns:@GridCols">
                    <div class="mas-sel-cell"></div>
                    <div class="mas-col-exp"></div>
                    <div style="grid-column: 3 / -1;">
                        <span class="tbl-nf-hint-txt">
                            <kbd class="tbl-kbd">Tab</kbd> o clic fuera para guardar la fila
                            <span class="tbl-nf-hint-sep">&middot;</span>
                            <kbd class="tbl-kbd">Esc</kbd> para cancelar
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="mas-newrow mas-newrow--cta mas-grid" style="grid-template-columns:@GridCols">
                    <div class="mas-sel-cell"></div>
                    <div class="mas-col-exp"></div>
                    <div class="mas-nf-ctacell" style="grid-column: 3 / -1;">
                        <button type="button" class="row-add--sm" @onclick="AbrirAlta">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                            Agregar registro
                        </button>
                    </div>
                </div>
            }
        </div>

        <button type="button" class="tbl-fab" hidden="@(_ctaVisibleM || _agrupadoM)" @onclick="FabAgregarM" title="Agregar registro">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            Agregar registro
        </button>
        @if (!_agrupadoM)
        {
            <div class="tbl-foot">@Filtradas.Count registros &middot; mostrando @Filtradas.Count</div>
        }
    </div>
    }
    @if (_view == "cards")
    {
        <div class="mas-acards">
            @foreach (var m in Filtradas)
            {
                var mm = m;
                <div class="mas-acard" @onclick="() => AbrirUnidad(mm)" title="Ver la unidad de la mascota">
                    <div class="mas-acard-ic">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="9" r="2"/><circle cx="19" cy="9" r="2"/><circle cx="9" cy="5" r="2"/><circle cx="15" cy="5" r="2"/><path d="M12 11c-2.5 0-4.5 2-4.5 4.5 0 1.9 1.6 2.5 4.5 2.5s4.5-.6 4.5-2.5C16.5 13 14.5 11 12 11Z"/></svg>
                    </div>
                    <div class="mas-acard-body">
                        <div class="mas-acard-name">@(string.IsNullOrWhiteSpace(m.Nombre) ? "(sin nombre)" : m.Nombre)</div>
                        <div class="mas-acard-meta">@EfectivoTipoLabel(m)@(string.IsNullOrWhiteSpace(m.Raza) ? "" : " · " + m.Raza)</div>
                        <div class="mas-acard-sub">@(string.IsNullOrWhiteSpace(m.UnidadCodigo) ? "Sin unidad" : m.UnidadCodigo)@(string.IsNullOrWhiteSpace(m.PropietarioNombre) ? "" : " · " + m.PropietarioNombre)</div>
                    </div>
                </div>
            }
            @if (!Filtradas.Any())
            {
                <div class="mas-empty" style="grid-column:1/-1;">No hay mascotas que coincidan.</div>
            }
        </div>
    }
}

@* Crear / editar UN campo (modal focalizado, replica de la maqueta). "+" crea; engranaje edita. *@
@if (_crearCampoAbierto)
{
    <CrearCampoModal Prefijo="mascotas"
                     TituloSingular="mascota"
                     Ejemplo="Ej. Numero de chip, Vacunas al dia"
                     Jwt="@_jwt"
                     Editar="_campoAEditar"
                     TiposAvanzados="false"
                     Guardado="RecargarTrasCrearCampo"
                     Cerrado="() => { _crearCampoAbierto = false; _campoAEditar = null; _insertTargetKey = null; }"
                     AbrirGestorAvanzado="AbrirGestorDesdeCrear" />
}

@if (_editSisClave is not null)
{
    @* 'tipo' es lista: modo auto-servido (semillas del catalogo A&D mascota.tipo + propias por copropiedad,
       guardadas en unidades-config entidad=mascotas); el <select> de la celda lee esa misma config. *@
    <EditarCampoSistemaModal Clave="@_editSisClave" DefLabel="@_editSisLabel" Tipo="_editSisTipo" Requerido="_editSisReq"
                             EntidadConfig="mascotas" TituloSingular="mascota" Jwt="@_jwt"
                             ListaCatalogo="@(_editSisClave == "tipo" ? "mascota.tipo" : null)"
                             SemillaFallback="@(_editSisClave == "tipo" ? TiposMascota.Select(t => TipoLabel(t)).ToArray() : null)"
                             PermiteAgregar="@(_editSisClave == "tipo")"
                             Guardado="RecargarCamposYConfigAsync" Cerrado="() => _editSisClave = null" />
}

@* Menu contextual (clic derecho sobre una fila). *@
<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />

@* Menu de columna estilo Airtable (flecha del header) + toast, replica de Tareas. *@
<TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" />
@if (_colToast is not null)
{
    <div style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--propia-text-h1);color:var(--propia-text-inverse);padding:8px 16px;border-radius:9px;z-index:5000;font-size:12.5px;cursor:pointer;box-shadow:0 6px 18px rgba(27,42,58,.28);" @onclick="() => _colToast = null">@_colToast</div>
}

@* Panel de campos del modulo (gestor avanzado; fallback para tipos avanzados y formato). *@
@if (_configAbierto)
{
    <div class="mas-cg-back" @onclick="CerrarConfig">
        <div class="mas-cg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="mas-cg-head">
                <div>
                    <div class="mas-cg-title">Campos de la mascota</div>
                    <div class="mas-cg-sub">Se muestran como columnas de esta tabla y en la ficha de la unidad.</div>
                </div>
                <button class="mas-cg-x" type="button" @onclick="CerrarConfig" aria-label="Cerrar">&times;</button>
            </div>
            <div class="mas-cg-body">
                <ConfigCamposEntidad Prefijo="mascotas"
                                     TiposAvanzados="true"
                                     Catalogo="@MascotaCatalogo"
                                     TituloSingular="mascota" TituloPlural="Mascotas"
                                     Ejemplo="Ej. Numero de chip, Vacunas al dia" Jwt="@_jwt"
                                     Cambiado="RecargarCamposYConfigAsync" />
            </div>
        </div>
    </div>
}

@* Ficha de la mascota (modal simple): campos fijos + propios, con los endpoints de la edicion inline.
   La abre el expander (de una fila, o del alta tras crear + abrir, canon Unidades). *@
@if (_fichaM is { } fm)
{
    <div class="mas-cg-back" @onclick="CerrarFichaM">
        <div class="mas-cg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="mas-cg-head">
                <div>
                    <div class="mas-cg-title">Ficha de la mascota</div>
                    <div class="mas-cg-sub">@(string.IsNullOrWhiteSpace(fm.Nombre) ? "Sin nombre" : fm.Nombre) &middot; @fm.UnidadCodigo</div>
                </div>
                <ModalHeaderActions EnEdicion="_editM" MostrarEditar="true" MostrarEliminar="true"
                                    MostrarCancelar="true" Guardando="_savingM"
                                    TituloEditar="Editar" TituloGuardar="Guardar cambios" TituloEliminar="Quitar mascota"
                                    OnEntrarEdicion="() => IniciarEdicionM(fm)" OnGuardar="() => GuardarFichaMAsync(fm)"
                                    OnEliminar="AbrirConfirmDelM" OnCancelarEdicion="CancelarEdicionM" OnCerrar="CerrarFichaM" />
            </div>
            <div class="mas-cg-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px 16px;">
                    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--propia-text-secondary);"><span>Nombre</span>
                        @if (_editM) { <input class="mas-row-inp" @bind="_emNombre" /> }
                        else { <input class="mas-row-inp" value="@fm.Nombre" disabled /> }</label>
                    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--propia-text-secondary);"><span>Tipo</span>
                        @if (_editM)
                        {
                            <select class="mas-row-inp" @bind="_emTipoSel">
                                @foreach (var o in OpcionesTipoFila(fm)) { <option value="@o">@o</option> }
                            </select>
                        }
                        else { <input class="mas-row-inp" value="@EfectivoTipoLabel(fm)" disabled /> }</label>
                    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--propia-text-secondary);"><span>Raza</span>
                        @if (_editM) { <input class="mas-row-inp" @bind="_emRaza" /> }
                        else { <input class="mas-row-inp" value="@fm.Raza" disabled /> }</label>
                    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--propia-text-secondary);"><span>Unidad</span>
                        <input class="mas-row-inp" value="@fm.UnidadCodigo" disabled /></label>
                    <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--propia-text-secondary);"><span>Propietario</span>
                        <div class="mas-prop-cur">
                            <span>@PropietarioDisplayM(fm)</span>
                            <span class="mas-prop-src">@PropietarioSrcM(fm)</span>
                            @if (_editM && (_emPropChanged ? _emPropPersonaId is not null : fm.PropietarioPersonaId is not null))
                            {
                                <button type="button" class="mas-prop-clear" @onclick="QuitarPropietarioM">Quitar</button>
                            }
                        </div>
                        @if (_editM)
                        {
                            <SelectorPersona Flotante="true" Jwt="@_jwt" Seleccionada="null" SeleccionadaChanged="SeleccionarPropietarioM"
                                             PermiteEmpresa="false" Placeholder="Cambiar: buscar en el Directorio" />
                        }</label>
                    @foreach (var def in _defs.Where(d => d.Tipo != TipoCampoTablero.Separador))
                    {
                        var d = def; var val = _editM ? _emDin.GetValueOrDefault(def.Id) : ValorDe(fm.MascotaId, def.Id);
                        <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--propia-text-secondary);"><span>@def.Label</span>
                            @if (def.Tipo == TipoCampoTablero.Formula)
                            {
                                <input class="mas-row-inp" value="@(string.IsNullOrWhiteSpace(val) ? "(se calcula)" : val)" disabled />
                            }
                            else if (!_editM)
                            {
                                <input class="mas-row-inp" value="@val" disabled />
                            }
                            else if (def.Tipo == TipoCampoTablero.Seleccion)
                            {
                                <select class="mas-row-inp" value="@val" @onchange="e => _emDin[d.Id] = e.Value?.ToString()">
                                    <option value="">-</option>
                                    @foreach (var op in def.OpcionesArray()) { <option value="@op" selected="@(op == val)">@op</option> }
                                </select>
                            }
                            else if (def.Tipo == TipoCampoTablero.Numero || def.Tipo == TipoCampoTablero.Moneda)
                            {
                                <input class="mas-row-inp" type="number" step="any" value="@val" @onchange="e => _emDin[d.Id] = e.Value?.ToString()" />
                            }
                            else if (def.Tipo == TipoCampoTablero.Fecha)
                            {
                                <input class="mas-row-inp" type="date" value="@val" @onchange="e => _emDin[d.Id] = e.Value?.ToString()" />
                            }
                            else if (def.Tipo == TipoCampoTablero.Usuario)
                            {
                                <select class="mas-row-inp" value="@val" @onchange="e => _emDin[d.Id] = e.Value?.ToString()">
                                    <option value="">-</option>
                                    @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId" selected="@(u.PersonaId.ToString() == val)">@u.NombreCompleto</option> }
                                </select>
                            }
                            else
                            {
                                <input class="mas-row-inp" value="@val" @onchange="e => _emDin[d.Id] = e.Value?.ToString()" />
                            }
                        </label>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* Confirmacion de "Quitar mascota" (type-to-confirm, patron compartido mha-cdel-*). *@
@if (_confirmDelM && _fichaM is { } fmd)
{
    <div class="mha-cdel-overlay" @onclick="CerrarConfirmDelM">
        <div class="mha-cdel-card" @onclick:stopPropagation="true">
            <div class="mha-cdel-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
            </div>
            <div class="mha-cdel-title">Quitar mascota</div>
            <div class="mha-cdel-sub">
                Vas a quitar a <b>@(string.IsNullOrWhiteSpace(fmd.Nombre) ? "esta mascota" : fmd.Nombre)</b> de la unidad <b>@fmd.UnidadCodigo</b>.
                Esta accion es <b>permanente</b> y no se puede deshacer.
            </div>
            <div class="mha-cdel-confirm">
                <label class="mha-cdel-lbl">Para confirmar, escribe el nombre: <b>@(string.IsNullOrWhiteSpace(fmd.Nombre) ? "(sin nombre)" : fmd.Nombre)</b></label>
                <input class="mha-cdel-inp" @bind="_confirmTextM" @bind:event="oninput" placeholder="@fmd.Nombre" autocomplete="off" disabled="@_savingM" />
            </div>
            @if (!string.IsNullOrEmpty(_delErrorM)) { <div class="mha-cdel-err">@_delErrorM</div> }
            <div class="mha-cdel-actions">
                <button class="mha-cdel-cancel" type="button" @onclick="CerrarConfirmDelM" disabled="@_savingM">Cancelar</button>
                <button class="mha-cdel-go" type="button" @onclick="() => ConfirmarEliminarM(fmd)"
                        disabled="@(_savingM || !ConfirmCoincideM(fmd))">@(_savingM ? "Quitando..." : "Quitar mascota")</button>
            </div>
        </div>
    </div>
}

<ModalHost />

@code {
    // Embebido en el hub de Configuracion: oculta su page-head/PageTitle.
    [Parameter] public bool Embedded { get; set; }

    private string? _jwt;
    private bool _authChecked;
    private string? _copNombre;
    private bool _busy, _msgError, _configAbierto;
    private string? _msg;

    private List<MascotaResumenDto> _mascotas = new();
    private List<UnidadDto> _unidades = new();
    private List<CampoDinDef> _defs = new();
    private Dictionary<Guid, Dictionary<Guid, string?>> _valores = new();
    private readonly HashSet<Guid> _recienCreados = new();

    // ===== FAB flotante + fila nueva verde/ultima + scroll-al-fondo (patron piloto Unidades) =====
    private bool _suppressRecienClearM;
    private bool _ctaVisibleM = true;
    private bool _scrollBottomPendingM;
    private string? _wiredSigM;
    private IEnumerable<MascotaResumenDto> MascotasRenderM()
    {
        IEnumerable<MascotaResumenDto> seq = Filtradas;
        if (_recienCreados.Count > 0) seq = seq.OrderBy(v => _recienCreados.Contains(v.MascotaId) ? 1 : 0);
        return seq;
    }
    [JSInvokable] public Task CargarMas() => Task.CompletedTask;
    [JSInvokable] public void SetCtaVisible(bool visible) { if (_ctaVisibleM != visible) { _ctaVisibleM = visible; StateHasChanged(); } }
    private void FabAgregarM() { _altaAbierta = true; _focusPending = true; _scrollBottomPendingM = true; }

    // Alta inline "nace fila".
    private bool _altaAbierta;
    private bool _focusPending;
    private ElementReference _nombreRef;
    private SelectorUnidadCodigo? _unidadSelRef;
    private int _nonce;
    private Guid? _nuUnidadId;
    private string _nuNombre = "";
    private string _nuRaza = "";
    private string _nuTipoSel = "";
    private PersonaCandidatoDto? _propSelNuevo;   // propietario override elegido en el alta (opcional)
    private Guid? _nuPropietarioId;
    private readonly Dictionary<Guid, string> _nuDinamicos = new();

    private string _q = "";
    private FiltroDinamico? _fd;
    // ===== Agrupar (boton "Agrupar", multi-nivel): fuente unica compartida (TablaAgruparMenu +
    // TablaAgrupador + TablaGruposRender). El modulo mantiene los niveles (_gruposM) y aporta el
    // valor de cada dimension por fila (ValorGrupoM). Con agrupacion activa NO se pagina. =====
    private List<string> _gruposM = new();
    private bool _agrupadoM => _gruposM.Count > 0;
    private int _pagina = 1, _porPagina = 25;

    // Tipos semilla (enum). La copropiedad puede AGREGAR tipos propios (ver _tipoOpciones / TipoCustom).
    private static readonly TipoMascota[] TiposMascota = Enum.GetValues<TipoMascota>();
    // Label del tipo: del catalogo global (mascota.tipo, editable por A&D) si cargo; si no, el enum.
    private Dictionary<string, string> _catTipoMas = new(StringComparer.Ordinal);
    private string TipoLabel(TipoMascota t)
        => _catTipoMas.TryGetValue("e:" + t, out var l) && !string.IsNullOrWhiteSpace(l) ? l : t.ToString();

    // Opciones EFECTIVAS del select de Tipo (etiquetas): las que personalizo la copropiedad
    // (unidades-config entidad=mascotas, clave=tipo; semillas+propias) o, sin personalizar, las semillas.
    private List<string> _tipoOpciones = new();
    // Mapa etiqueta -> enum para las SEMILLAS (label del catalogo A&D y el nombre crudo del enum). Una
    // etiqueta que NO este aqui es un tipo PROPIO del tenant (se guarda en TipoCustom, enum = Otro).
    private Dictionary<string, TipoMascota> _tipoSeedToEnum = new(StringComparer.OrdinalIgnoreCase);

    // Recalcula _tipoOpciones + el mapa de semillas a partir del catalogo (_catTipoMas) y la config (_cfg).
    private void RecargarTipoOpciones()
    {
        _tipoSeedToEnum = new(StringComparer.OrdinalIgnoreCase);
        foreach (var t in TiposMascota) { _tipoSeedToEnum[TipoLabel(t)] = t; _tipoSeedToEnum[t.ToString()] = t; }
        var raw = _cfg.TryGetValue("tipo", out var c) ? c.Opciones : null;
        var propias = OpcionCampo.VisiblesK(raw).ToList();
        _tipoOpciones = propias.Count > 0 ? propias : TiposMascota.Select(t => TipoLabel(t)).ToList();
    }

    // Etiqueta efectiva de una fila (lo que se muestra/filtra/agrupa): el tipo propio si lo tiene, si no el enum.
    private string EfectivoTipoLabel(MascotaResumenDto v)
        => !string.IsNullOrWhiteSpace(v.TipoCustom) ? v.TipoCustom! : TipoLabel(v.Tipo);

    // Convierte una etiqueta elegida en (enum, custom): semilla => (enum, null); propia => (Otro, etiqueta).
    private (TipoMascota Tipo, string? Custom) DesdeSelTipo(string? sel)
    {
        var s = (sel ?? "").Trim();
        if (s.Length == 0) return (TipoMascota.Perro, null);
        if (_tipoSeedToEnum.TryGetValue(s, out var en)) return (en, null);
        return (TipoMascota.Otro, s);
    }

    // Opciones del <select> de una fila: las efectivas + la propia de la fila si no estuviera en la lista.
    private IEnumerable<string> OpcionesTipoFila(MascotaResumenDto v)
    {
        var ef = EfectivoTipoLabel(v);
        return _tipoOpciones.Contains(ef, StringComparer.OrdinalIgnoreCase)
            ? _tipoOpciones : _tipoOpciones.Append(ef);
    }

    // ===== Columnas dinamicas dirigidas por unidades-config (entidad 'mascotas') =====
    // Estructurales (unidad, propietario) + de sistema (nombre, tipo, raza) + propias (cd:{id}).
    private const string EntCfg = "mascotas";
    private static readonly string[] ClavesEstructuralesInicio = { "unidad" };
    private static readonly string[] ClavesEstructuralesFin = { "propietario" };
    private Dictionary<string, UnidadCampoConfigDto> _cfg = new(StringComparer.Ordinal);

    private static bool EsCustom(string clave) => clave.StartsWith("cd:", StringComparison.Ordinal);
    private CampoDinDef? CampoCustom(string clave)
        => EsCustom(clave) && Guid.TryParse(clave[3..], out var g) ? _defs.FirstOrDefault(c => c.Id == g) : null;

    private IEnumerable<string> ClavesCandidatas()
        => ClavesEstructuralesInicio
            .Concat(MascotaCamposSistema.Todos.Select(c => c.Clave))
            .Concat(ClavesEstructuralesFin)
            .Concat(_defs.OrderBy(d => d.Orden).Select(d => "cd:" + d.Id));

    private bool VisibleColDefault(string clave)
    {
        if (EsCustom(clave)) return true;
        if (ClavesEstructuralesInicio.Contains(clave) || ClavesEstructuralesFin.Contains(clave)) return true;
        return MascotaCamposSistema.Por(clave)?.VisiblePorDefecto ?? true;
    }
    private bool VisibleCol(string clave)
        => _cfg.TryGetValue(clave, out var c) ? !c.Oculto : VisibleColDefault(clave);
    private int OrdenCol(string clave, int fallback)
        => _cfg.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;
    private IEnumerable<string> ClavesOrdenadas()
        => ClavesCandidatas().Select((k, i) => (k, ord: OrdenCol(k, i))).OrderBy(x => x.ord).Select(x => x.k);
    private IEnumerable<string> ColsVisibles() => ClavesOrdenadas().Where(VisibleCol);

    private string ColLabel(string clave)
    {
        if (_cfg.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias)) return c.Alias!;
        if (clave == "unidad") return "Unidad";
        if (clave == "propietario") return "Propietario";
        return CampoCustom(clave)?.Label ?? MascotaCamposSistema.Por(clave)?.Label ?? clave;
    }
    // Anchos FIJOS en px (no fr/minmax-fr): cada fila (head/dato/alta) es su PROPIA grilla, asi que un
    // track flexible se resuelve distinto por fila segun su contenido y desalinea las columnas (ademas de
    // dejar el header mas angosto que las filas = "columna fantasma"). Solo px fijo comparte track; el
    // ancho natural lo da min-width:max-content + scroll horizontal.
    private static string ColWidth(string clave) => clave switch
    {
        "unidad" => "150px",
        "nombre" => "200px",
        "tipo" => "120px",
        "raza" => "150px",
        "propietario" => "220px",
        _ => "150px"   // campos propios
    };
    private string GridCols => "38px 34px " + string.Join(" ", ColsVisibles().Select(k => _colW.TryGetValue(k, out var w) ? w + "px" : ColWidth(k))) + " 60px 40px";

    private List<FiltroDinamico.CampoDef> CamposFiltro
    {
        get
        {
            var l = new List<FiltroDinamico.CampoDef>
            {
                new() { Key = "nombre", Label = "Nombre", Kind = "texto" },
                new() { Key = "raza", Label = "Raza", Kind = "texto" },
                new() { Key = "tipo", Label = "Tipo", Kind = "sel",
                        Opciones = _tipoOpciones.Select(o => (o, o)).ToList() },
                new() { Key = "unidad", Label = "Unidad", Kind = "texto" },
                new() { Key = "propietario", Label = "Propietario", Kind = "texto" },
            };
            // Campos propios (dinamicos): mismo mapeo compartido que el resto de modulos.
            l.AddRange(_defs.Select(FiltroDinamico.DeDinamico));
            return l;
        }
    }

    private List<MascotaResumenDto> Filtradas
    {
        get
        {
            var q = (_q ?? "").Trim();
            var baseSeq = _mascotas
                .Where(v => q == ""
                    || v.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (v.Raza ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                    || v.UnidadCodigo.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (v.PropietarioNombre ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
                .Where(v => _fd?.Pasa(campo =>
                {
                    if (campo.StartsWith("cd:", StringComparison.Ordinal) && Guid.TryParse(campo.AsSpan(3), out var defId))
                        return ValorDe(v.MascotaId, defId) ?? "";
                    return campo switch
                    {
                        "nombre" => v.Nombre,
                        "raza" => v.Raza ?? "",
                        "tipo" => EfectivoTipoLabel(v),
                        "unidad" => v.UnidadCodigo,
                        "propietario" => v.PropietarioNombre ?? "",
                        _ => ""
                    };
                }) ?? true);
            if (_sorts.Count > 0)
            {
                var sorts = _sorts;
                var cmp = Comparer<MascotaResumenDto>.Create((a, b) =>
                {
                    foreach (var s in sorts)
                    {
                        var c = CmpValTabla(SortStr(a, s.Key), SortStr(b, s.Key)) * s.Dir;
                        if (c != 0) return c;
                    }
                    return 0;
                });
                return baseSeq.OrderBy(v => v, cmp).ToList();
            }
            return baseSeq.ToList();
        }
    }

    // Agrupar ofrece los MISMOS campos que Ordenar/Columnas: todas las columnas visibles (fijas + dinamicas).
    private List<TablaAgruparMenu.Col> ColsAgrupablesM()
        => ColsVisibles().Select(k => new TablaAgruparMenu.Col(k, ColLabel(k))).ToList();

    // Valor de una dimension de agrupacion para una mascota. Reusa SortStr (resuelve toda clave fija + "cd:"),
    // asi cualquier columna agrupa igual que ordena.
    private IEnumerable<Propia.Web.Components.Shared.ValorGrupo> ValorGrupoM(MascotaResumenDto v, string clave)
    {
        var val = SortStr(v, clave);
        var t = string.IsNullOrWhiteSpace(val) ? "(Sin dato)" : val;
        yield return new(t, t);
    }

    // Cambio de niveles desde el menu compartido: solo resetea la pagina (el reagrupado es automatico).
    private void OnGruposMChanged() { _pagina = 1; }

    // Clic derecho -> "Agrupar por esta columna": un unico nivel (vacio limpia). Reusa el menu compartido.
    private void SetAgrupar(string k) { _gruposM = string.IsNullOrEmpty(k) ? new() : new() { k }; _pagina = 1; }

    // Pagina actual de la vista tabla SIN agrupacion (footer canonico). Con agrupacion se muestran los
    // grupos completos (sin paginar), asi que este helper solo se usa en el modo no agrupado.
    private IEnumerable<MascotaResumenDto> PaginaM()
    {
        var desde = (_pagina - 1) * _porPagina;
        return Filtradas.Skip(desde).Take(_porPagina);
    }

    // Fila hoja de la vista tabla (misma fila editable para el modo agrupado y el no agrupado). La
    // pinta TablaGruposRender (agrupado) o el foreach de la pagina (no agrupado). El parametro 'v' es
    // el registro de la fila (mismo nombre que usaba el foreach original, sin cambios en el cuerpo).
    private RenderFragment<MascotaResumenDto> FilaMTpl => v =>
    @<div class="mas-row mas-grid @(_recienCreados.Contains(v.MascotaId) ? "mas-row-nuevo" : "") @(_sel.Contains(v.MascotaId) ? "mas-row-sel" : "")" style="grid-template-columns:@GridCols"
         @oncontextmenu="e => AbrirCtx(e, v)" @oncontextmenu:preventDefault="true">
        <div class="mas-sel-cell"><label class="mas-chk"><input type="checkbox" checked="@_sel.Contains(v.MascotaId)" @onchange="@(e => ToggleSel(v.MascotaId, (bool)(e.Value ?? false)))" @onclick:stopPropagation="true" /></label></div>
        <div class="mas-col-exp">
            <button type="button" class="mas-exp-fijo" title="Abrir la ficha de la mascota" @onclick="() => AbrirFichaM(v)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </button>
        </div>
        @foreach (var k in ColsVisibles())
        {
            if (CampoCustom(k) is CampoDinDef def)
            {
                var d = def;
                var val = ValorDe(v.MascotaId, def.Id);
                if (def.Tipo == TipoCampoTablero.Seleccion)
                {
                    <div class="mas-selcell">
                        @if (!string.IsNullOrWhiteSpace(val))
                        {
                            var col = ColorOpcion(def, val);
                            <span class="mas-chip" style="background:@(col ?? PaletaChips.Neutro);color:@PaletaChips.TextoSobre(col)">@val</span>
                        }
                        <select class="mas-editcell" value="@val" @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())">
                            <option value="">-</option>
                            @foreach (var op in def.OpcionesArray()) { <option value="@op" selected="@(op == val)">@op</option> }
                        </select>
                    </div>
                }
                else if (def.Tipo == TipoCampoTablero.Formula)
                {
                    <div class="mas-cell mas-auto" title="Se calcula automaticamente">@(string.IsNullOrWhiteSpace(val) ? "-" : val)</div>
                }
                else if (def.Tipo == TipoCampoTablero.Usuario)
                {
                    <select class="mas-editcell" value="@val" @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())">
                        <option value="">-</option>
                        @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId" selected="@(u.PersonaId.ToString() == val)">@u.NombreCompleto</option> }
                    </select>
                }
                else if (def.Tipo == TipoCampoTablero.Directorio)
                {
                    <div class="mas-cell">@(NombrePersona(val) ?? "-")</div>
                }
                else if (def.Tipo == TipoCampoTablero.Numero || def.Tipo == TipoCampoTablero.Moneda)
                {
                    <input class="mas-editcell" type="number" step="any" value="@val" @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())" />
                }
                else if (def.Tipo == TipoCampoTablero.Fecha)
                {
                    <input class="mas-editcell" type="date" value="@val" @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())" />
                }
                else
                {
                    <input class="mas-editcell" value="@val" placeholder="-"
                           @onchange="e => GuardarDinamicoAsync(v.MascotaId, d.Id, e.Value?.ToString())" />
                }
                continue;
            }
            switch (k)
            {
                case "unidad":
                    <div class="mas-cell"><span class="mas-cod">@v.UnidadCodigo</span></div>
                    break;
                case "nombre":
                    <input class="mas-editcell" value="@v.Nombre" placeholder="-" @onchange="e => GuardarNombreAsync(v, e.Value?.ToString())" />
                    break;
                case "tipo":
                    <select class="mas-editcell" @onchange="e => GuardarTipoAsync(v, e.Value?.ToString())">
                        @foreach (var o in OpcionesTipoFila(v)) { <option value="@o" selected="@(string.Equals(EfectivoTipoLabel(v), o, StringComparison.OrdinalIgnoreCase))">@o</option> }
                    </select>
                    break;
                case "raza":
                    <input class="mas-editcell" value="@v.Raza" placeholder="-" @onchange="e => GuardarRazaAsync(v, e.Value?.ToString())" />
                    break;
                case "propietario":
                    <div class="mas-cell mas-prop">@(string.IsNullOrWhiteSpace(v.PropietarioNombre) ? "-" : v.PropietarioNombre)</div>
                    break;
            }
        }
        @* Sin cesto por fila: el borrado va por menu contextual (clic derecho) + barra de seleccion. *@
        <div class="mas-acts"></div>
        <div class="mas-addcol-cell"></div>
    </div>;
    private void OnBuscar(ChangeEventArgs e) { _q = e.Value?.ToString() ?? ""; _pagina = 1; }

