@page "/residentes-hub"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@* Hub "Residentes": agrupa en pestañas las personas y sus dependencias de la unidad (Residentes,
   Mascotas, Vehiculos), reutilizando cada componente COMPLETO (su tabla, gestor de campos, toggle)
   igual que el hub de Configuracion Copropiedad. Cada modulo vive en su *Panel con Embedded="true". *@

<PageTitle>Residentes - PROPIA</PageTitle>

<div class="cfg-head">
    <h1 class="cfg-title">Residentes</h1>
    <p class="cfg-sub">Personas de las unidades y sus dependencias: residentes, mascotas y vehiculos.</p>
</div>

<div class="cfg-tabs">
    @foreach (var t in Tabs)
    {
        var key = t.Key;
        <button type="button" class="cfg-tab @(_tab == key ? "on" : "")" @onclick="() => _tab = key">
            <i class="fi @t.Icon"></i> <span>@t.Label</span>
        </button>
    }
</div>

<div class="cfg-body">
    @if (_tab == "residentes")
    {
        <ResidentesPanel Embedded="true" @key="_tab" />
    }
    else if (_tab == "mascotas")
    {
        <MascotasPanel Embedded="true" @key="_tab" />
    }
    else if (_tab == "vehiculos")
    {
        <VehiculosPanel Embedded="true" @key="_tab" />
    }
</div>

@code {
    private string _tab = "residentes";

    private sealed record TabDef(string Key, string Label, string Icon);
    private static readonly TabDef[] Tabs =
    {
        new("residentes", "Residentes", "fi-rr-users"),
        new("mascotas", "Mascotas", "fi-rr-paw"),
        new("vehiculos", "Vehiculos", "fi-rr-car"),
    };
}
