    private string ValorOrden(SiniestroDto s, string clave)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        return clave switch
        {
            "fechaocurrencia" => s.FechaOcurrencia.ToString("yyyy-MM-dd", ci),
            "fechareporte" => s.FechaReporte?.ToString("yyyy-MM-dd", ci) ?? "",
            "fechapago" => s.FechaPago?.ToString("yyyy-MM-dd", ci) ?? "",
            "montoestimado" => s.MontoEstimado?.ToString(ci) ?? "",
            "montoreclamado" => s.MontoReclamado?.ToString(ci) ?? "",
            "deducible" => s.Deducible?.ToString(ci) ?? "",
            "montoreconocido" => s.MontoReconocido?.ToString(ci) ?? "",
            "documentos" => s.DocumentosCount > 0 ? s.DocumentosCount.ToString(ci) : "",
            "estado" => (_estados.FirstOrDefault(e => e.Id == s.EstadoId)?.Orden ?? 999).ToString("D4", ci),
            _ => CeldaTexto(s, clave) is var t && t == "-" ? "" : CeldaTexto(s, clave)
        };
    }
    private static int CmpOrd(string a, string b)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var na = decimal.TryParse(a, System.Globalization.NumberStyles.Any, ci, out var da);
        var nb = decimal.TryParse(b, System.Globalization.NumberStyles.Any, ci, out var db);
        if (na && nb) return da.CompareTo(db);
        if (na) return -1; if (nb) return 1;
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

