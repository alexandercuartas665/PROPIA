    private readonly record struct Fila(bool EsGrupo, string? Grupo, int Count, SiniestroDto? Siniestro, int Nivel = 0, string? Color = null, NodoGrupo<SiniestroDto>? Nodo = null);
    private async Task OnGruposChanged() { try { await Js.InvokeVoidAsync("localStorage.setItem", AgruparKey, string.Join(",", _grupos)); } catch { } StateHasChanged(); }
    private async Task SetGroup(string clave) { _grupos = new() { clave }; await OnGruposChanged(); }
    private List<TablaAgruparMenu.Col> ColsAgrupables() => ColsVisibles().Select(k => new TablaAgruparMenu.Col(k, ColLabel(k))).ToList();
    private IEnumerable<ValorGrupo> ValorGrupoS(SiniestroDto s, string clave)
    {
        if (clave == "estado")
        {
            var e = _estados.FirstOrDefault(x => x.Id == s.EstadoId);
            yield return new ValorGrupo(s.EstadoId.ToString(), s.EstadoNombre, Orden: e?.Orden ?? 999, Color: s.EstadoColor);
            yield break;
        }
        var t = CeldaTexto(s, clave);
        if (string.IsNullOrWhiteSpace(t) || t == "-") t = "(Sin dato)";
        yield return new ValorGrupo(t, t);
    }
    private IEnumerable<Fila> FilasRender()
    {
        if (_grupos.Count == 0)
        {
            foreach (var s in Filtradas) yield return new Fila(false, null, 0, s);
            yield break;
        }
        foreach (var el in TablaAgrupador.Aplanar(TablaAgrupador.Agrupar(Filtradas.ToList(), _grupos, ValorGrupoS)))
        {
            if (el.Grupo is { } g) yield return new Fila(true, g.Titulo, g.Conteo, null, g.Nivel, g.Color, g);
            else yield return new Fila(false, null, 0, el.Fila);
        }
    }

    // ===== Totales por columna en grupos =====
    private const string AggKey = "propia_agregado_siniestros";
    private readonly Dictionary<string, string> _agg = new(StringComparer.Ordinal);
    private static readonly HashSet<string> NumSistema = new(StringComparer.Ordinal)
        { "montoestimado", "montoreclamado", "deducible", "montoreconocido", "documentos" };
    private bool EsNumericaCol(string k)
    {
        var cm = CampoCustom(k);
        if (cm is not null) return cm.Tipo is TipoCampoTablero.Numero or TipoCampoTablero.Moneda or TipoCampoTablero.Porcentaje;
        return NumSistema.Contains(k);
    }
    private decimal? ValorNumCol(SiniestroDto s, string k)
    {
        var cm = CampoCustom(k);
        if (cm is not null) return Dec(RawCampo(s, cm.Id) ?? "");
        return k switch
        {
            "montoestimado" => s.MontoEstimado,
            "montoreclamado" => s.MontoReclamado,
            "deducible" => s.Deducible,
            "montoreconocido" => s.MontoReconocido,
            "documentos" => s.DocumentosCount,
            _ => null
        };
    }
    private string TextoAggCol(SiniestroDto s, string k) { var t = CeldaTexto(s, k); return t == "-" ? "" : t; }
    private string ModoActivo(string k) => _agg.TryGetValue(k, out var m) ? m : (EsNumericaCol(k) && k != "documentos" ? "suma" : "off");
    private static int ModoCodigo(string modo) => modo switch { "suma" => 1, "prom" => 2, "cont" => 3, "min" => 4, "max" => 5, _ => 0 };
    private TablaColMenu.AggOferta AggOferta(string k) => new(EsNumericaCol(k), ModoCodigo(ModoActivo(k)));
    private async Task FijarAgg(string k, string modo)
    {
        _agg[k] = modo;
        try { await Js.InvokeVoidAsync("localStorage.setItem", AggKey, string.Join(";", _agg.Select(kv => kv.Key + "=" + kv.Value))); } catch { }
        StateHasChanged();
    }
    private void CargarAgg(string? raw)
    {
        _agg.Clear();
        if (string.IsNullOrWhiteSpace(raw)) return;
        foreach (var par in raw.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        { var i = par.IndexOf('='); if (i > 0) _agg[par[..i]] = par[(i + 1)..]; }
    }
    private static IReadOnlyList<SiniestroDto> TodasFilas(NodoGrupo<SiniestroDto> n)
    {
        if (n.EsHoja) return n.Filas;
        var acc = new List<SiniestroDto>();
        foreach (var s in n.Subgrupos) acc.AddRange(TodasFilas(s));
        return acc;
    }
    private string FmtNumCol(decimal v, string k)
    {
        var es = new System.Globalization.CultureInfo("es-CO");
        var tipo = CampoCustom(k)?.Tipo;
        if (k.StartsWith("monto", StringComparison.Ordinal) || k == "deducible" || tipo == TipoCampoTablero.Moneda)
            return "$ " + Math.Round(v, 0, MidpointRounding.AwayFromZero).ToString("N0", es);
        if (tipo == TipoCampoTablero.Porcentaje) return Math.Round(v, 2, MidpointRounding.AwayFromZero).ToString("0.##", es) + "%";
        return Math.Round(v, 2, MidpointRounding.AwayFromZero).ToString("0.##", es);
    }
    private (bool Hay, string Texto, string Tag) AggCelda(IReadOnlyList<SiniestroDto> miembros, string k)
    {
        var modo = ModoActivo(k);
        if (modo == "off") return (false, "", "");
        if (modo == "cont")
        {
            var n = miembros.Count(s => !string.IsNullOrWhiteSpace(TextoAggCol(s, k)));
            return (true, n.ToString(new System.Globalization.CultureInfo("es-CO")), "CONT");
        }
        var vals = new List<decimal>();
        foreach (var s in miembros) if (ValorNumCol(s, k) is { } v) vals.Add(v);
        if (vals.Count == 0) return (false, "", "");
        var (res, tag) = modo switch
        {
            "prom" => (vals.Sum() / vals.Count, "PROM"),
            "min" => (vals.Min(), "MIN"),
            "max" => (vals.Max(), "MAX"),
            _ => (vals.Sum(), "")
        };
        return (true, FmtNumCol(res, k), tag);
    }
    private static string TituloAgg(string tag) => tag switch
    {
        "PROM" => "Promedio del grupo",
        "MIN" => "Mínimo del grupo",
        "MAX" => "Máximo del grupo",
        "CONT" => "Conteo (no vacíos) del grupo",
        _ => "Suma del grupo"
    };

    // ===== Descarga (TablaExportar) =====
    private string? _copropiedadNombre;
    private ExportVista VistaExport()
    {
        var cols = ColsVisibles().ToList();
        bool EsNum(string k) => EsNumericaCol(k) || CampoCustom(k)?.Tipo is TipoCampoTablero.Total or TipoCampoTablero.Formula;
        string Fmt(string k) => k.StartsWith("monto", StringComparison.Ordinal) || k == "deducible" || CampoCustom(k)?.Tipo == TipoCampoTablero.Moneda ? "\"$\"#,##0" : "General";
        object? Celda(SiniestroDto s, string k)
        {
            if (EsNum(k) && (ValorNumCol(s, k) ?? (CampoCustom(k) is { } cm ? Dec(RawCampo(s, cm.Id) ?? "") : null)) is { } num) return num;
            var t = CeldaTexto(s, k);
            return string.IsNullOrWhiteSpace(t) || t == "-" ? null : t;
        }
        var columnas = cols.Select(k => new ExportColumna(ColLabel(k), EsNum(k), EsNum(k) ? Fmt(k) : null)).ToList();
        ExportFila FilaX(SiniestroDto s, IReadOnlyList<string>? ruta) => new(cols.Select(k => Celda(s, k)).ToList(), Ruta: ruta);
        var lista = Filtradas;
        var filas = new List<ExportFila>();
        if (_grupos.Count == 0) filas.AddRange(lista.Select(s => FilaX(s, null)));
        else
        {
            void Recorrer(IReadOnlyList<NodoGrupo<SiniestroDto>> nodos, List<string> ruta)
            {
                foreach (var n in nodos)
                {
                    filas.Add(ExportFila.DeGrupo(n.Titulo, n.Nivel, n.Conteo));
                    var r = new List<string>(ruta) { n.Titulo };
                    if (n.EsHoja) filas.AddRange(n.Filas.Select(s => FilaX(s, r)));
                    else Recorrer(n.Subgrupos, r);
                }
            }
            Recorrer(TablaAgrupador.Agrupar(lista, _grupos, ValorGrupoS), new());
        }
        var criterios = new List<string>();
        if (!string.IsNullOrWhiteSpace(_q)) criterios.Add($"Búsqueda: \"{_q.Trim()}\"");
        if (ResumenReglas() is { Length: > 0 } fr) criterios.Add("Filtros: " + fr);
        if (_sorts.Count > 0) criterios.Add("Orden: " + string.Join(", ", _sorts.Select(s => $"{ColLabel(s.Key)} {(s.Dir >= 0 ? "ascendente" : "descendente")}")));
        if (_grupos.Count > 0) criterios.Add("Agrupado por: " + string.Join(" > ", _grupos.Select(ColLabel)));
        criterios.Add($"{lista.Count} siniestros");
        return new ExportVista("Siniestros", _copropiedadNombre, columnas, filas, criterios, _grupos.Select(ColLabel).ToList());
    }

    // ===== Ciclo de vida =====
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_jwt is not null && _vista == "tabla")
        {
            _self ??= DotNetObjectReference.Create(this);
            var sig = _vista + ":" + Filtradas.Count + ":" + _altaAbierta + ":" + (_grupos.Count == 0);
            if (sig != _fabSig)
            {
                _fabSig = sig;
                if (_grupos.Count == 0) { try { await Js.InvokeVoidAsync("propiaUI.dstInfinite", _self, ".seg-scroll"); } catch { } }
                if (_altaAbierta) { try { await Js.InvokeVoidAsync("propiaUI.altaAutoSave", _self, ".seg-newrow--edit", "AltaBlurGuardar", ".sp-pop", "AltaTabFinal"); } catch { } }
                else { try { await Js.InvokeVoidAsync("propiaUI.altaAutoSaveOff"); } catch { } }
            }
        }
        else { _fabSig = null; try { await Js.InvokeVoidAsync("propiaUI.altaAutoSaveOff"); } catch { } }
        if (_scrollCtaPend) { _scrollCtaPend = false; try { await Js.InvokeVoidAsync("propiaUI.dstScrollToCta", ".seg-scroll"); } catch { } }
        if (_focoPrimerCampo && _altaAbierta) { _focoPrimerCampo = false; try { await Js.InvokeVoidAsync("propiaUI.focusBySelector", ".seg-newrow--edit .seg-nf-inp"); } catch { } }
        if (_focoCtaAlta && !_altaAbierta) { _focoCtaAlta = false; try { await _ctaAlta.FocusAsync(); } catch { } }

        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                _miUsuarioId = UserIdFromJwt(stored);
                try { var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey); if (v is "tabla" or "tarjetas") _vista = v; } catch { }
                try { var g = await Js.InvokeAsync<string?>("localStorage.getItem", AgruparKey); _grupos = string.IsNullOrWhiteSpace(g) ? new() : g.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(); } catch { }
                try { CargarAgg(await Js.InvokeAsync<string?>("localStorage.getItem", AggKey)); } catch { }
                try { _copropiedadNombre = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_copropiedad_nombre"); } catch { }
                await CargarAsync();
                // Enlace directo (#siniestro-{id}, "Copiar enlace del registro"): abre la ficha.
                var frag = new Uri(Nav.Uri).Fragment;
                if (frag.StartsWith("#siniestro-", StringComparison.Ordinal) && Guid.TryParse(frag["#siniestro-".Length..], out var sid)) await AbrirModal(sid);
            }
            else { Nav.NavigateTo("/login?returnUrl=%2Fsiniestros", true); return; }
            StateHasChanged();
        }
        catch { }
    }

    private static Guid? UserIdFromJwt(string jwt)
    {
        try
        {
            var parts = jwt.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4) { case 2: payload += "=="; break; case 3: payload += "="; break; }
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("user_id", out var e) && Guid.TryParse(e.GetString(), out var g)) return g;
        }
        catch { }
        return null;
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private static async Task<string> MensajeErrorAsync(HttpResponseMessage resp)
    {
        if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden) return "No tienes permiso para esta acción en Siniestros.";
        var cuerpo = await resp.Content.ReadAsStringAsync();
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(cuerpo);
            if (doc.RootElement.TryGetProperty("error", out var e) && e.GetString() is { Length: > 0 } m) return m;
        }
        catch { }
        return string.IsNullOrWhiteSpace(cuerpo) ? "No se pudo guardar el siniestro." : cuerpo;
    }

