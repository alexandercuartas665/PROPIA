    private async Task AplicarEstadoAsync(Guid destino, decimal? monto, DateOnly? fechaPago)
    {
        if (_editId is not { } id) return;
        _busy = true; _modalError = null;
        try
        {
            var r = await Auth().PutAsJsonAsync($"/api/siniestros/{id}/estado", new CambiarEstadoSiniestroRequest(destino, monto, fechaPago));
            if (!r.IsSuccessStatusCode) { _modalError = await MensajeErrorAsync(r); _estadoSel = _dto?.EstadoId; return; }
            _pideMonto = false; _estadoDestino = null;
            try { _dto = await Auth().GetFromJsonAsync<SiniestroDto>($"/api/siniestros/{id}") ?? _dto; } catch { }
            if (_dto is not null)
            {
                // Solo lo que el cambio de estado toca: no se pisan ediciones sin guardar del formulario.
                _estadoSel = _dto.EstadoId;
                _f.MontoReconocido = _dto.MontoReconocido;
                _f.FechaPago = _dto.FechaPago?.ToDateTime(TimeOnly.MinValue);
            }
            try { _comentarios = await Auth().GetFromJsonAsync<List<SiniestroComentarioDto>>($"/api/siniestros/{id}/comentarios") ?? _comentarios; } catch { }
            try { _items = await Auth().GetFromJsonAsync<List<SiniestroDto>>("/api/siniestros") ?? _items; await RecargarEstadosAsync(); } catch { }
        }
        catch (Exception ex) { _modalError = ex.Message; _estadoSel = _dto?.EstadoId; }
        finally { _busy = false; }
    }

