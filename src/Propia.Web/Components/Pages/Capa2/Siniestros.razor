</style>

@code {
    private const string ListaTipo = "siniestro.tipo";

    // ===== Estado general =====
    private string? _jwt;
    private Guid? _miUsuarioId;
    private bool _authChecked;
    private string? _loadError;
    private List<SiniestroDto> _items = new();
    private List<SiniestroEstadoDto> _estados = new();
    private List<OpcionEfectivaDto> _tipos = new();
    private List<SiniestroCampoDto> _campos = new();
    private Dictionary<Guid, Dictionary<Guid, string?>> _valores = new();   // siniestroId -> (campoId -> valor)
    private IReadOnlyList<SiniestroCampoDto> CamposActivos => _campos.Where(c => c.Activo).OrderBy(c => c.Orden).ToList();
    private IEnumerable<OpcionEfectivaDto> TiposActivos => _tipos.Where(t => t.Activo).OrderBy(t => t.Orden);

    // Listas de apoyo (alta y ficha): se cargan una vez.
    private sealed record ElemLite(Guid Id, string? Nombre, string? Numero);
    private List<ElemLite> _equipos = new(), _zonas = new(), _unidades = new();
    private List<PolizaDto> _polizas = new();
    private bool _apoyoCargado;

    private string _q = "";
    private string _vista = "tabla";
    private const string VistaKey = "propia_view_siniestros";
    private List<string> _grupos = new();
    private const string AgruparKey = "propia_agrupar_siniestros";

    // ===== Menu contextual de la fila =====
    private bool _ctxOpen;
    private double _ctxX, _ctxY;
    private List<TablaCtxMenu.Item> _ctxItems = new();
    private void AbrirCtx(MouseEventArgs e, SiniestroDto s)
    {
        _ctxX = e.ClientX; _ctxY = e.ClientY;
        _ctxItems = new()
        {
            new("Abrir ficha", "fi-rr-expand", OnClick: () => AbrirModal(s.Id)),
            new("Copiar enlace del registro", "fi-rr-link-alt", OnClick: () => CopiarEnlace(s)),
        };
        _ctxOpen = true;
    }
    private async Task CopiarEnlace(SiniestroDto s)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}siniestros#siniestro-{s.Id}"); }
        catch { }
    }

    // ===== Seleccion multiple =====
    private readonly HashSet<Guid> _sel = new();
    private bool TodosSel { get { var ids = Filtradas.Select(s => s.Id).ToList(); return ids.Count > 0 && ids.All(_sel.Contains); } }
    private void ToggleSel(Guid id, bool on) { if (on) _sel.Add(id); else _sel.Remove(id); }
    private void ToggleSelAll(bool on) { _sel.Clear(); if (on) foreach (var s in Filtradas) _sel.Add(s.Id); }
    private async Task BulkEliminar()
    {
        if (_sel.Count == 0) return;
        var n = _sel.Count;
        bool ok;
        try { ok = await Js.InvokeAsync<bool>("confirm", $"¿Eliminar {n} siniestro{(n == 1 ? "" : "s")}? Esta acción no se puede deshacer."); }
        catch { ok = false; }
        if (!ok) return;
        _eliminando = true;
        try
        {
            foreach (var id in _sel.ToList()) { try { await Auth().DeleteAsync($"/api/siniestros/{id}"); } catch { } }
            _sel.Clear();
            await CargarAsync();
        }
