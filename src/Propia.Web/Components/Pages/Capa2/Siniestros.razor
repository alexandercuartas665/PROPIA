    private async Task OnColAccion((TablaColMenu.Accion Accion, TablaColMenu.Ctx Col) a)
    {
        var (accion, col) = a;
        switch (accion)
        {
            case TablaColMenu.Accion.OrdenarAsc: _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = 1 } }; break;
            case TablaColMenu.Accion.OrdenarDesc: _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = -1 } }; break;
            case TablaColMenu.Accion.AgregarSuma: await FijarAgg(col.Key, "suma"); break;
            case TablaColMenu.Accion.AgregarPromedio: await FijarAgg(col.Key, "prom"); break;
            case TablaColMenu.Accion.AgregarMinimo: await FijarAgg(col.Key, "min"); break;
            case TablaColMenu.Accion.AgregarMaximo: await FijarAgg(col.Key, "max"); break;
            case TablaColMenu.Accion.AgregarConteo: await FijarAgg(col.Key, "cont"); break;
            case TablaColMenu.Accion.AgregarNinguno: await FijarAgg(col.Key, "off"); break;
            case TablaColMenu.Accion.Agrupar:
                await SetGroup(col.EsDinamico && !col.Key.StartsWith("cd:", StringComparison.Ordinal) ? "cd:" + col.Key : col.Key);
                break;
            case TablaColMenu.Accion.Filtrar:
                _colToast = "Usa el botón Filtros para filtrar por este campo.";
                break;
            case TablaColMenu.Accion.Duplicar:
                {
                    var campo = col.EsDinamico ? CampoCustom(col.Key) : null;
                    if (campo is null) { _colToast = "Solo se pueden duplicar campos propios."; break; }
                    try
                    {
                        var rr = await Auth().PostAsJsonAsync("/api/siniestros/campos", new CrearSiniestroCampoRequest(campo.Label + " (copia)", campo.Tipo, campo.Opciones, campo.Descripcion));
                        if (rr.IsSuccessStatusCode) { await RecargarCamposYConfigAsync(); _colToast = "Campo duplicado."; }
                        else _colToast = await MensajeErrorAsync(rr);
                    }
                    catch { _colToast = "No se pudo duplicar el campo."; }
                }
                break;
            case TablaColMenu.Accion.Eliminar:
                {
                    var campo = col.EsDinamico ? CampoCustom(col.Key) : null;
                    if (campo is null) { _colToast = "Los campos del sistema no se eliminan aquí."; break; }
                    if (!await Modals.ConfirmEliminarCampoAsync(campo.Label)) break;
                    try
                    {
                        var rr = await Auth().DeleteAsync($"/api/siniestros/campos/{campo.Id}");
                        if (rr.IsSuccessStatusCode) { await RecargarCamposYConfigAsync(); _colToast = "Campo eliminado."; }
                        else _colToast = "No se pudo eliminar el campo.";
                    }
                    catch { _colToast = "No se pudo eliminar el campo."; }
                }
                break;
            case TablaColMenu.Accion.Editar:
                if (col.EsDinamico) { _showCampos = true; _colToast = "Edita el campo en el panel de Campos."; }
                else AbrirEditarCampoSistema(col.Key);
                break;
            case TablaColMenu.Accion.Ocultar:
                if (EsFija(col.Key)) { _colToast = "Esta columna es fija y no se puede ocultar."; break; }
                await GuardarCfg(FilaConfig(col.Key) with { Oculto = true });
                await CargarConfigAsync();
                _colToast = "Columna oculta. Usa Columnas para restaurarla.";
                break;
            case TablaColMenu.Accion.InsertarIzq:
            case TablaColMenu.Accion.InsertarDer:
                _crearCampoAbierto = true;
                break;
            default:
                _colToast = "En construcción: " + accion + ".";
                break;
        }
        StateHasChanged();
    }
