    private string? RawCampo(SiniestroDto s, Guid campoId)
        => _valores.TryGetValue(s.Id, out var d) && d.TryGetValue(campoId, out var v) ? v : null;
    private string ValorCampoTexto(SiniestroDto s, SiniestroCampoDto cm)
    {
        var raw = RawCampo(s, cm.Id);
        if (string.IsNullOrWhiteSpace(raw)) return "";
        return cm.Tipo switch
        {
            TipoCampoTablero.Booleano => raw == "true" ? "Sí" : "No",
            TipoCampoTablero.Moneda => Dec(raw) is { } m ? "$" + m.ToString("N0") : raw,
            _ => raw
        };
    }
