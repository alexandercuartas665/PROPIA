@page "/siniestros"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Siniestros
@using Propia.Application.Seguros
@using Propia.Application.Directorio
@using Propia.Application.MiCopropiedad
@using Propia.Application.Catalogos
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using Propia.Web.Components.Shared
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals
@implements IDisposable

<PageTitle>Siniestros - PROPIA</PageTitle>

@* Modulo Siniestros (S2, 2026-11-16). Hermano de Seguros: MISMA bandeja canon (Tarjetas/Tabla, filtros, ordenar,
   agrupar, columnas, campos propios, descarga, alta inline con guardado invisible) y MISMA ficha (marco de Poliza:
   pestana principal con panel de Actividad lateral + pestana Documentos). Los estilos seg-* son los de Seguros
   (componente compartido SegurosEstilos), no una copia. Backend: api/siniestros (S1). *@

<div class="seg-page">
    <div class="mod-pagehead">
        <div>
            <h1 class="mod-pagetitle">Siniestros</h1>
            <p class="mod-pagesub">Daños y pérdidas de la copropiedad y su trámite con la aseguradora.</p>
        </div>
        @if (_authChecked && _jwt is not null)
        {
            <div class="seg-head-actions">
                <button class="propia-btn-brand" @onclick="() => AbrirModal(null)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                    Nuevo siniestro
                </button>
            </div>
        }
    </div>

    @if (!_authChecked)
    {
        <div class="seg-loading"><div class="spinner-border" style="color: var(--propia-brand);"></div></div>
    }
    else if (string.IsNullOrEmpty(_jwt))
    {
        <AuthMessage />
    }
    else
    {
        <div class="mod-filtros">
            <div class="seg-filtro-wrap">
                <button type="button" class="seg-fsel @(HayReglasActivas ? "on" : "")" @onclick="ToggleFiltros" title="Filtrar siniestros">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M3 5h18M6 12h12M10 19h4"/></svg><span>Filtros</span>
                    @if (CuentaReglas > 0) { <span class="seg-fbadge">@CuentaReglas</span> }
                </button>
                @if (_filtrosMenu)
                {
                    <div class="seg-menu-bd" @onclick="() => _filtrosMenu = false"></div>
                    <div class="seg-fpop" @onclick:stopPropagation="true">
                        @if (_reglas.Count == 0)
                        {
                            <div class="seg-fpop-empty">Sin filtros aplicados.<br />Agrega una condición para acotar los siniestros.</div>
                        }
                        else
                        {
                            @for (int i = 0; i < _reglas.Count; i++)
                            {
                                var idx = i; var r = _reglas[idx];
                                <div class="seg-frule">
                                    @if (idx == 0)
                                    {
                                        <span class="seg-frule-lead">Donde</span>
                                    }
                                    else if (idx == 1)
                                    {
                                        <select class="seg-frule-lead seg-frule-logic" @onchange="SetLogica">
                                            <option value="and" selected="@(_logica == "and")">Y</option>
                                            <option value="or" selected="@(_logica == "or")">O</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="seg-frule-lead">@(_logica == "or" ? "O" : "Y")</span>
                                    }
                                    <select class="seg-frule-f" @onchange="(e) => SetReglaCampo(idx, e)">
                                        @foreach (var opt in CamposFiltro()) { <option value="@opt.Key" selected="@(r.Campo == opt.Key)">@opt.Label</option> }
                                    </select>
                                    <select class="seg-frule-op" @onchange="(e) => SetReglaOp(idx, e)">
                                        @foreach (var op in Operadores(r.Campo)) { <option value="@op.Key" selected="@(r.Op == op.Key)">@op.Label</option> }
                                    </select>
                                    @if (r.Op is not "vacio" and not "no_vacio")
                                    {
                                        @RenderValor(idx)
                                    }
                                    <button class="seg-frule-del" title="Quitar condición" @onclick="() => QuitarRegla(idx)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                    </button>
                                </div>
                            }
                        }
                        <div class="seg-fpop-foot">
                            <button class="seg-fadd" @onclick="AgregarRegla">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"/></svg>Agregar filtro
                            </button>
                            @if (_reglas.Count > 0) { <button class="seg-fclear2" @onclick="LimpiarReglas">Limpiar todo</button> }
                        </div>
                    </div>
                }
            </div>
            <div class="seg-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input class="seg-search-inp" placeholder="Buscar por número, título, elemento, póliza..." @oninput="OnBuscar" />
            </div>
            <div class="mod-filtros-spacer"></div>
            <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sorts" SortsChanged="() => StateHasChanged()" />
            <TablaAgruparMenu Columnas="ColsAgrupables()" Grupos="_grupos" GruposChanged="OnGruposChanged" />
            <TablaColumnasMenu Columnas="ColsVisibilidad()" OnMover="MoverColMenu" OnToggleVisible="ToggleVisibleColMenu"
                               OnEliminar="PedirEliminarCol" OnOcultarTodas="OcultarTodasColMenu"
                               OnMostrarTodas="MostrarTodasColMenu" OnRestablecer="RestablecerColMenu" />
            @if (_crearCampoAbierto)
            {
                <CrearCampoModal Prefijo="siniestros" RutaCatalogo="/api/siniestros/campos" EntidadConfig="siniestro" TituloSingular="siniestro"
                                 Ejemplo="Ej. Perito asignado, Fecha de inspección"
                                 Jwt="@_jwt" TiposAvanzados="false" OfreceFuncion="true" Catalogo="@SiniestroCatalogo"
                                 Guardado="RecargarCamposYConfigAsync"
                                 Cerrado="() => _crearCampoAbierto = false"
                                 AbrirGestorAvanzado="() => { _crearCampoAbierto = false; _showCampos = true; }" />
            }
            @if (_campoAEliminarMenu is not null)
            {
                <div class="seg-ov seg-ov--top" @onclick="() => _campoAEliminarMenu = null"></div>
                <div class="seg-confirm" @onclick:stopPropagation="true">
                    <div class="seg-confirm-t">Eliminar campo</div>
                    <div class="seg-confirm-s">¿Eliminar el campo "<strong>@_campoAEliminarMenu.Label</strong>"? Se borran la definición y todos sus valores. No se puede deshacer.</div>
                    <div class="seg-confirm-acts">
                        <button class="seg-btn-ghost" @onclick="() => _campoAEliminarMenu = null" disabled="@_colBusyMenu">Cancelar</button>
                        <button class="seg-btn-danger" @onclick="EliminarColConfirm" disabled="@_colBusyMenu">@(_colBusyMenu ? "Eliminando..." : "Eliminar")</button>
                    </div>
                </div>
            }
            <div class="seg-menu-wrap">
                <button type="button" class="seg-fsel @(_showCampos ? "on" : "")" @onclick="() => _showCampos = !_showCampos" title="Campos: orden, visibilidad y campos personalizados">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>Campos
                </button>
                @if (_showCampos)
                {
                    <div class="seg-menu-bd" @onclick="() => _showCampos = false"></div>
                    <div class="seg-campospop" @onclick:stopPropagation="true">
                        <div class="seg-campospop-h">CAMPOS DEL SINIESTRO (orden, visibilidad y campos propios)</div>
                        <ConfigCamposEntidad Prefijo="siniestros"
                                             RutaCatalogo="/api/siniestros/campos"
                                             EntidadConfig="siniestro"
                                             Catalogo="@SiniestroCatalogo"
                                             TituloSingular="siniestro"
                                             TituloPlural="Siniestros"
                                             Ejemplo="Ej. Perito asignado, Fecha de inspección"
                                             TiposAvanzados="true"
                                             Jwt="@_jwt"
                                             Cambiado="RecargarCamposYConfigAsync" />
                    </div>
                }
            </div>
            @if (_vista == "tabla")
            {
                <TablaExportar Modulo="@Propia.Domain.Enums.ModuloCodigo.Siniestros" Vista="VistaExport" />
            }
            <TablaVistaToggle Opciones="@(new[] { TablaVistaToggle.Tarjetas("tarjetas"), TablaVistaToggle.Tabla("tabla") })" Valor="@_vista" OnCambiar="SetVista" />
        </div>

        <TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" ModoAgregado="AggOferta" />

        @* Editor de ESTADOS = componente COMPARTIDO GestionarEstadosColumna (el mismo de Tareas/PQRSD/Contratos),
           lanzado desde EditarCampoSistemaModal de la columna "Estado". API propia: api/siniestros/estados. *@
        <GestionarEstadosColumna Visible="_estEditorOpen" Ancla="(_popX, _popY)" HaciaArriba="_popUp" Busy="_busy"
                                 Titulo="Estados del siniestro"
                                 Hint="Clic en el nombre para renombrar, en el color para cambiarlo, y las flechas para reordenar. Los estados base se pueden renombrar o inactivar, pero no eliminar."
                                 PlaceholderNuevo="Nuevo estado (ej. En peritaje)..."
                                 Estados="EstadosVm()"
                                 OnAgregar="AgregarEstadoAsync"
                                 OnRenombrar="RenombrarEstadoAsync"
                                 OnColor="ColorEstadoAsync"
                                 OnMover="MoverEstadoAsync"
                                 OnEliminar="EliminarEstadoAsync"
                                 OnToggleActivo="ToggleActivoEstadoAsync"
                                 Error="@_estEditorErr"
                                 Cerrar="() => { _estEditorOpen = false; _estEditorErr = null; }" />

        @if (_editSisClave == "estado")
        {
            <EditarCampoSistemaModal Clave="estado" DefLabel="@_editSisLabel" Tipo="_editSisTipo" Requerido="false"
                                     EntidadConfig="siniestro" TituloSingular="siniestro" Jwt="@_jwt"
                                     OpcionesLista="EstadosVista()" PermiteAgregar="false"
                                     HintReadOnly="Gestiona los estados (crear, renombrar, color, orden, inactivar) con el botón de abajo."
                                     AbrirGestorAvanzado="EventCallback.Factory.Create(this, AbrirEstadosEditor)"
                                     Guardado="RecargarCamposYConfigAsync" Cerrado="() => _editSisClave = null" />
        }
        else if (_editSisClave is not null)
        {
            <EditarCampoSistemaModal Clave="@_editSisClave" DefLabel="@_editSisLabel" Tipo="_editSisTipo" Requerido="_editSisReq"
                                     EntidadConfig="siniestro" TituloSingular="siniestro" Jwt="@_jwt"
                                     ListaTenant="@(_editSisClave == "tipo" ? ListaTipo : null)"
                                     Guardado="RecargarTodoAsync" Cerrado="() => _editSisClave = null" />
        }
        @if (_colToast is not null)
        {
            <div class="sin-coltoast" @onclick="() => _colToast = null">@_colToast</div>
        }

        @if (_loadError is not null) { <div class="alert alert-danger">@_loadError</div> }

        @if (Filtradas.Count == 0 && _vista == "tarjetas")
        {
            <div class="seg-empty"><strong>Sin siniestros.</strong><span>Usa "Nuevo siniestro" para registrar el primero.</span></div>
        }
        else if (_vista == "tabla")
        {
            @if (_sel.Count > 0)
            {
                <div class="seg-selbar">
                    <span class="seg-selbar-n">@_sel.Count seleccionado@(_sel.Count == 1 ? "" : "s")</span>
                    <div style="flex:1"></div>
                    <button type="button" class="seg-selbar-del" @onclick="BulkEliminar" disabled="@_eliminando">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                        Eliminar (@_sel.Count)
                    </button>
                    <button type="button" class="seg-selbar-x" @onclick="() => _sel.Clear()" disabled="@_eliminando">Deseleccionar</button>
                </div>
            }
            <div class="seg-table">
                <div class="seg-scroll">
                    <div class="seg-head seg-grid" style="@GridStyle()">
                        <div class="seg-sel"><input type="checkbox" class="seg-chk" title="Seleccionar todo" checked="@TodosSel" @onchange="e => ToggleSelAll((bool)(e.Value ?? false))" /></div>
                        <div></div>
                        @foreach (var clave in ColsVisibles()) { var ck = clave; <div class="seg-th" data-clave="@ck" data-minw="@(ColEsFecha(ck) ? "150" : null)" title="Arrastra: mover columna" @onmousedown="e => IniciarReorder(e, ck)"><span class="seg-th-lbl">@ColLabel(ck).ToUpperInvariant()</span>@ChevCol(ck, ColLabel(ck), ck.StartsWith("cd:", StringComparison.Ordinal))<span class="seg-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, ck)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => OnColResize(ck, 0)" @ondblclick:stopPropagation="true"></span></div> }
                        <div class="seg-addcol-h"><button type="button" class="seg-addcol-btn" title="Crear campo nuevo (columna)" @onclick="() => _crearCampoAbierto = true"><i class="fi fi-rr-plus"></i></button></div>
                    </div>
                    @foreach (var item in FilasRender())
                    {
                        if (item.EsGrupo)
                        {
                            var colsG = ColsVisibles().ToList();
                            var idxAgg = colsG.FindIndex(k => ModoActivo(k) != "off");
                            <div class="seg-grouprow seg-grid seg-gl@(item.Nivel > 2 ? 2 : item.Nivel)" style="@GridStyle()">
                                <div class="seg-grouplead" style="grid-column:1 / @(idxAgg < 0 ? "-1" : (3 + idxAgg).ToString()); padding-left:@(14 + item.Nivel * 16)px;">
                                    @if (item.Color is not null) { <span class="sin-gdot" style="background:@item.Color;"></span> }
                                    <span class="seg-group-t">@item.Grupo</span><span class="seg-group-n">@item.Count</span>
                                </div>
                                @if (idxAgg >= 0 && item.Nodo is { } nodo)
                                {
                                    var miembros = TodasFilas(nodo);
                                    @for (int ci = idxAgg; ci < colsG.Count; ci++)
                                    {
                                        var kG = colsG[ci];
                                        @if (ModoActivo(kG) != "off")
                                        {
                                            var (hayG, txtG, tagG) = AggCelda(miembros, kG);
                                            <div class="seg-groupagg">@if (hayG) { <span title="@TituloAgg(tagG)">@txtG@if (tagG.Length > 0) { <span class="seg-aggtag">@tagG</span> }</span> }</div>
                                        }
                                        else
                                        {
                                            <div></div>
                                        }
                                    }
                                    <div></div>
                                }
                            </div>
                            continue;
                        }
                        var s = item.Siniestro!;
                        var ss = s;
                        <div class="seg-row seg-grid @(_recienCreados.Contains(s.Id) ? "seg-row-nuevo" : "") @(_sel.Contains(s.Id) ? "seg-row-sel" : "")" style="@GridStyle()"
                             @oncontextmenu="e => AbrirCtx(e, ss)" @oncontextmenu:preventDefault="true">
                            <div class="seg-sel" @onclick:stopPropagation="true">
                                <input type="checkbox" class="seg-chk" checked="@_sel.Contains(ss.Id)" @onchange="e => ToggleSel(ss.Id, (bool)(e.Value ?? false))" />
                            </div>
                            <div class="seg-exp-col">
                                <button type="button" class="seg-exp" title="Abrir la ficha" @onclick="() => AbrirModal(ss.Id)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                </button>
                            </div>
                            @foreach (var clave in ColsVisibles())
                            {
                                var col = clave;
                                <div class="@ColCeldaClass(col)" title="@ColLabel(col)">
                                    @if (col == "estado") { @EstadoBadge(s.EstadoNombre, s.EstadoColor) }
                                    else if (col == "numero") { <span class="cod-key">@s.Numero</span> }
                                    else { @CeldaTexto(s, col) }
                                </div>
                            }
                        </div>
                    }
                    @if (_altaAbierta)
                    {
                        <div class="seg-row seg-newrow seg-newrow--edit seg-grid" data-alta-fila style="@GridStyle()" @onkeydown="OnAltaKeydown">
                            <div class="seg-sel"></div>
                            <div class="seg-exp-col">
                                <button type="button" class="seg-exp seg-exp-fijo" tabindex="-1" title="Abrir el formulario completo con lo escrito" @onclick="AbrirModalDesdeAltaAsync" disabled="@_creandoInline">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                </button>
                            </div>
                            @foreach (var clave in ColsVisibles())
                            {
                                var col = clave;
                                <div class="@AltaCeldaClass(col)">
                                    @switch (col)
                                    {
                                        case "titulo": <input class="seg-nf-inp" @bind="_nTitulo" @bind:event="oninput" placeholder="Qué pasó *" /> break;
                                        case "tipo":
                                            <select class="seg-nf-inp" value="@_nTipo" @onchange="e => _nTipo = e.Value?.ToString() ?? string.Empty">
                                                <option value="">Tipo</option>
                                                @foreach (var t in TiposActivos) { <option value="@t.Clave">@t.Label</option> }
                                            </select>
                                            break;
                                        case "elemento":
                                            <select class="seg-nf-inp" value="@_nElemento" @onchange="e => _nElemento = e.Value?.ToString() ?? string.Empty">
                                                <option value="">Elemento afectado</option>
                                                @if (_equipos.Count > 0) { <optgroup label="Equipos">@foreach (var x in _equipos) { <option value="@("equipo:" + x.Id)">@x.Nombre</option> }</optgroup> }
                                                @if (_zonas.Count > 0) { <optgroup label="Zonas comunes">@foreach (var x in _zonas) { <option value="@("zona:" + x.Id)">@x.Nombre</option> }</optgroup> }
                                                @if (_unidades.Count > 0) { <optgroup label="Unidades">@foreach (var x in _unidades) { <option value="@("unidad:" + x.Id)">@x.Numero</option> }</optgroup> }
                                            </select>
                                            break;
                                        case "fechaocurrencia": <input type="date" class="seg-nf-inp" value="@_nOcurrencia" @oninput="e => _nOcurrencia = e.Value?.ToString() ?? string.Empty" /> break;
                                        case "fechareporte": <input type="date" class="seg-nf-inp" value="@_nReporte" @oninput="e => _nReporte = e.Value?.ToString() ?? string.Empty" /> break;
                                        case "poliza":
                                            <select class="seg-nf-inp" value="@_nPoliza" @onchange="e => _nPoliza = e.Value?.ToString() ?? string.Empty">
                                                <option value="">Póliza</option>
                                                @foreach (var p in _polizas) { <option value="@p.Id">@PolizaEtiqueta(p)</option> }
                                            </select>
                                            break;
                                        case "numeroreclamacion": <input class="seg-nf-inp" @bind="_nReclamacion" @bind:event="oninput" placeholder="N° reclamación" /> break;
                                        case "montoestimado": <input type="number" step="1000" class="seg-nf-inp" value="@_nEstimado" @oninput="e => _nEstimado = e.Value?.ToString() ?? string.Empty" placeholder="Estimado" /> break;
                                        case "montoreclamado": <input type="number" step="1000" class="seg-nf-inp" value="@_nReclamado" @oninput="e => _nReclamado = e.Value?.ToString() ?? string.Empty" placeholder="Reclamado" /> break;
                                        case "deducible": <input type="number" step="1000" class="seg-nf-inp" value="@_nDeducible" @oninput="e => _nDeducible = e.Value?.ToString() ?? string.Empty" placeholder="Deducible" /> break;
                                        case "descripcion": <input class="seg-nf-inp" @bind="_nDescripcion" @bind:event="oninput" placeholder="Descripción" /> break;
                                        case "responsable":
                                            <SelectorPersona Jwt="@_jwt" Seleccionada="_nResponsable" SeleccionadaChanged="v => _nResponsable = v" Flotante="true" Placeholder="Responsable..." />
                                            break;
                                        case "numero":
                                        case "estado":
                                            <span>(auto)</span>
                                            break;
                                        default: <span>-</span> break;
                                    }
                                </div>
                            }
                        </div>
                        <div class="seg-newrow tbl-nf-hintrow seg-grid" style="@GridStyle()">
                            <div class="seg-sel"></div>
                            <div class="seg-exp-col"></div>
                            <div style="grid-column: 3 / -1;">
                                <span class="tbl-nf-hint-txt">
                                    <kbd class="tbl-kbd">Tab</kbd> o clic fuera para guardar la fila
                                    <span class="tbl-nf-hint-sep">&middot;</span>
                                    <kbd class="tbl-kbd">Esc</kbd> para cancelar
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="seg-row seg-cta-row seg-grid" style="@GridStyle()">
                            <div class="seg-sel"></div>
                            <div class="seg-exp-col"></div>
                            <div class="seg-nf-ctacell" style="grid-column: 3 / -1;">
                                <button type="button" class="row-add--sm" @ref="_ctaAlta" @onclick="FabNuevo">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                                    Agregar siniestro
                                </button>
                            </div>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_inlineMsg)) { <div class="seg-toast @(_inlineMsgEsError ? "seg-toast--error" : "")" @onclick="() => _inlineMsg = null">@_inlineMsg</div> }
                @if (_grupos.Count == 0)
                {
                    <button type="button" class="tbl-fab" hidden="@_ctaVisible" @onclick="FabNuevo" title="Agregar siniestro">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                        Agregar registro
                    </button>
                    <div class="tbl-foot"><strong>@Filtradas.Count</strong>&nbsp;@(Filtradas.Count == 1 ? "siniestro" : "siniestros")</div>
                }
            </div>
        }
        else
        {
            <div class="seg-cards">
                @foreach (var item in FilasRender())
                {
                    if (item.EsGrupo)
                    {
                        <div class="seg-group seg-group--card"><span class="seg-group-t">@item.Grupo</span><span class="seg-group-n">@item.Count</span></div>
                        continue;
                    }
                    var s = item.Siniestro!;
                    var ss = s;
                    <button type="button" class="seg-card" @onclick="() => AbrirModal(ss.Id)">
                        <div class="seg-card-top">
                            <span class="seg-card-aseg">@s.Titulo</span>
                            @EstadoBadge(s.EstadoNombre, s.EstadoColor)
                        </div>
                        <div class="seg-card-num">@s.Numero@(string.IsNullOrWhiteSpace(s.TipoLabel) ? "" : " - " + s.TipoLabel)</div>
                        <div class="seg-card-meta">
                            @s.FechaOcurrencia.ToString("dd MMM yyyy")
                            @(ElementoTexto(s) is { } et && et != "-" ? " - " + et : "")
                            @(s.MontoReclamado is { } mr ? " - $" + mr.ToString("N0") : "")
                        </div>
                    </button>
                }
            </div>
        }
    }
</div>

@if (_modal)
{
    <div class="seg-ov" @onclick="() => _modal = false"></div>
    <div class="seg-modal">
        <div class="seg-modal-head">
            <div class="seg-modal-ic"><i class="fi fi-rr-house-crack" style="font-size:19px;line-height:1;"></i></div>
            <div style="flex:1;min-width:0;">
                <div class="seg-modal-title">@(_editId is null ? "Nuevo siniestro" : (_dto?.Numero ?? "Siniestro"))</div>
                <div class="seg-modal-sub">@(_editId is null ? "Registra qué pasó, qué afectó y su trámite con la aseguradora." : _f.Titulo)</div>
            </div>
            @if (_editId is not null && _dto is not null)
            {
                @EstadoBadge(_dto.EstadoNombre, _dto.EstadoColor)
            }
            <button class="seg-x" @onclick="() => _modal = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        </div>

        @if (_editId is not null)
        {
            <div class="seg-tabs">
                <button class="@(_tab == "siniestro" ? "on" : "")" @onclick='() => _tab = "siniestro"'>Siniestro</button>
                <button class="@(_tab == "docs" ? "on" : "")" @onclick='() => _tab = "docs"'>Documentos <span class="seg-tab-n">@_docs.Count</span></button>
            </div>
        }

        <div class="seg-modal-body">
            @if (_editId is null || _tab == "siniestro")
            {
            <div class="seg-2col @(_editId is null ? "seg-2col--solo" : "")">
            <div class="seg-mainpane">
                @if (_editId is not null)
                {
                    @* Estado: se cambia aqui mismo (PUT /estado). Pagado/Cerrado piden el monto reconocido si falta. *@
                    <div class="sin-estbar">
                        <label class="seg-lbl" style="margin:0;">Estado</label>
                        <select class="seg-input sin-estsel" value="@(_estadoSel?.ToString() ?? "")" @onchange="OnEstadoChange" disabled="@_busy">
                            @foreach (var e in _estados.Where(x => x.Activo || x.Id == _dto?.EstadoId).OrderBy(x => x.Orden))
                            {
                                <option value="@e.Id">@e.Nombre</option>
                            }
                        </select>
                        @if (_pideMonto)
                        {
                            <div class="sin-pidemonto">
                                <span>Monto reconocido por la aseguradora *</span>
                                <input class="seg-input seg-mini" type="number" step="any" @bind="_montoRecEstado" placeholder="0" />
                                @if (_estadoDestinoClave == EstadoSiniestroClave.Pagado)
                                {
                                    <span>Fecha de pago</span>
                                    <input class="seg-input seg-mini" type="date" @bind="_fechaPagoEstado" />
                                }
                                <button class="seg-btn-brand" @onclick="ConfirmarCambioEstado" disabled="@_busy">Cambiar estado</button>
                                <button class="seg-btn-ghost" @onclick="CancelarCambioEstado" disabled="@_busy">Cancelar</button>
                            </div>
                        }
                        @* S3: tarea de reparacion (tablero General, ligada al elemento afectado y al siniestro). *@
                        <div class="sin-tarea">
                            @if (_dto?.TareaNumero is { } tnum && _dto.TareaId is { } tid)
                            {
                                <a class="sin-tarea-link" href="@($"/tareas?abrir={tid}")" title="Abrir la tarea en Tareas">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                                    Tarea de reparación <b>@tnum</b>@(string.IsNullOrEmpty(_dto.TareaEstado) ? "" : $" · {_dto.TareaEstado}")
                                </a>
                            }
                            else
                            {
                                <button class="seg-btn-ghost" @onclick="CrearTareaReparacionAsync" disabled="@_busy">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/></svg>
                                    Crear tarea de reparación
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="sin-nota">El siniestro se crea en estado <b>@(_estados.FirstOrDefault(e => e.Clave == EstadoSiniestroClave.Reportado)?.Nombre ?? "Reportado")</b> con el siguiente consecutivo.</div>
                }

                <div class="seg-grid-form">
                    <div class="seg-col-full"><label class="seg-lbl">Qué pasó *</label><input class="seg-input" @bind="_f.Titulo" @bind:event="oninput" placeholder="Ej. Filtración de agua en el cuarto de bombas" /></div>
                    <div>
                        <label class="seg-lbl">Tipo de siniestro</label>
                        <select class="seg-input" value="@(_f.TipoClave ?? "")" @onchange="e => _f.TipoClave = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                            <option value="">- Selecciona -</option>
                            @foreach (var t in TiposParaSelect(_f.TipoClave)) { <option value="@t.Clave">@t.Label</option> }
                        </select>
                    </div>
                    <div><label class="seg-lbl">Fecha de ocurrencia *</label><input class="seg-input" type="date" @bind="_f.Ocurrencia" /></div>
                    <div>
                        <label class="seg-lbl">Elemento afectado</label>
                        <select class="seg-input" value="@((int)_f.ElementoTipo)" @onchange="OnElementoTipoChange">
                            <option value="0">Ninguno</option>
                            <option value="1">Equipo</option>
                            <option value="2">Zona común</option>
                            <option value="3">Unidad</option>
                            <option value="4">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="seg-lbl">@ElementoDetalleLabel()</label>
                        @switch (_f.ElementoTipo)
                        {
                            case ElementoSiniestro.Equipo:
                                <select class="seg-input" value="@(_f.ElementoId?.ToString() ?? "")" @onchange="OnElementoIdChange">
                                    <option value="">- Selecciona el equipo -</option>
                                    @foreach (var x in _equipos) { <option value="@x.Id">@x.Nombre</option> }
                                </select>
                                break;
                            case ElementoSiniestro.Zona:
                                <select class="seg-input" value="@(_f.ElementoId?.ToString() ?? "")" @onchange="OnElementoIdChange">
                                    <option value="">- Selecciona la zona -</option>
                                    @foreach (var x in _zonas) { <option value="@x.Id">@x.Nombre</option> }
                                </select>
                                break;
                            case ElementoSiniestro.Unidad:
                                <select class="seg-input" value="@(_f.ElementoId?.ToString() ?? "")" @onchange="OnElementoIdChange">
                                    <option value="">- Selecciona la unidad -</option>
                                    @foreach (var x in _unidades) { <option value="@x.Id">@x.Numero</option> }
                                </select>
                                break;
                            case ElementoSiniestro.Otro:
                                <input class="seg-input" @bind="_f.ElementoOtro" @bind:event="oninput" placeholder="Describe qué se afectó" />
                                break;
                            default:
                                <input class="seg-input" disabled placeholder="Sin elemento" />
                                break;
                        }
                    </div>
                    <div class="seg-col-full"><label class="seg-lbl">Descripción</label><textarea data-dictado data-dictado-contexto="Descripcion de un siniestro (dano o perdida) en una copropiedad" class="seg-input" rows="3" @bind="_f.Descripcion" placeholder="Qué pasó, cómo se detectó, qué daños hay"></textarea></div>

                    <div class="seg-col-full"><div class="seg-doc-h" style="margin-top:4px;">Trámite con la aseguradora</div></div>
                    <div class="seg-col-full">
                        <label class="seg-lbl">Póliza <span class="seg-hint">(opcional; debe cubrir la fecha de ocurrencia)</span></label>
                        <select class="seg-input" value="@(_f.PolizaId?.ToString() ?? "")" @onchange="e => _f.PolizaId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                            <option value="">- Sin póliza -</option>
                            @foreach (var p in _polizas) { <option value="@p.Id">@PolizaEtiqueta(p)</option> }
                        </select>
                    </div>
                    <div><label class="seg-lbl">Fecha de reporte</label><input class="seg-input" type="date" @bind="_f.Reporte" /></div>
                    <div><label class="seg-lbl">N° de reclamación</label><input class="seg-input" @bind="_f.NumeroReclamacion" @bind:event="oninput" placeholder="Radicado de la aseguradora" /></div>
                    <div class="seg-col-full">
                        <label class="seg-lbl">Responsable <span class="seg-hint">(del Directorio)</span></label>
                        <SelectorPersona Jwt="@_jwt" Seleccionada="_responsableSel" SeleccionadaChanged="OnResponsableSel" Placeholder="Buscar persona responsable del trámite..." />
                    </div>
                    <div><label class="seg-lbl">Monto estimado (COP)</label><input class="seg-input" type="number" step="any" @bind="_f.MontoEstimado" placeholder="0" /></div>
                    <div><label class="seg-lbl">Monto reclamado (COP)</label><input class="seg-input" type="number" step="any" @bind="_f.MontoReclamado" placeholder="0" /></div>
                    <div><label class="seg-lbl">Deducible (COP)</label><input class="seg-input" type="number" step="any" @bind="_f.Deducible" placeholder="0" /></div>
                    <div><label class="seg-lbl">Monto reconocido (COP)</label><input class="seg-input" type="number" step="any" @bind="_f.MontoReconocido" placeholder="0" /></div>
                    <div><label class="seg-lbl">Fecha de pago</label><input class="seg-input" type="date" @bind="_f.FechaPago" /></div>

                    @if (CamposActivos.Any())
                    {
                        <div class="seg-col-full"><div class="seg-doc-h" style="margin-top:4px;">Campos personalizados</div></div>
                        @foreach (var cm in CamposActivos)
                        {
                            var cid = cm.Id;
                            var full = cm.Tipo is TipoCampoTablero.AreaTexto or TipoCampoTablero.Seleccion;
                            <div class="@(full ? "seg-col-full" : "")">
                                <label class="seg-lbl">@cm.Label</label>
                                @switch (cm.Tipo)
                                {
                                    case TipoCampoTablero.Formula:
                                    case TipoCampoTablero.Total:
                                        <input class="seg-input" disabled value="@(Val(cid) ?? "")" placeholder="(calculado)" />
                                        break;
                                    case TipoCampoTablero.AreaTexto:
                                        <textarea class="seg-input" rows="2" @bind:get="Val(cid)" @bind:set="v => SetVal(cid, v)" @bind:event="oninput"></textarea>
                                        break;
                                    case TipoCampoTablero.Numero:
                                    case TipoCampoTablero.Moneda:
                                    case TipoCampoTablero.Porcentaje:
                                        <input class="seg-input" type="number" step="any" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Fecha:
                                        <input class="seg-input" type="date" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Booleano:
                                        <label class="seg-check" style="margin-top:6px;"><input type="checkbox" checked="@(Val(cid) == "true")" @onchange='e => SetVal(cid, ((bool)(e.Value ?? false)) ? "true" : "false")' /> Sí</label>
                                        break;
                                    case TipoCampoTablero.Seleccion:
                                        <select class="seg-input" value="@Val(cid)" @onchange="e => SetVal(cid, e.Value?.ToString())">
                                            <option value="">- Selecciona -</option>
                                            @foreach (var op in OpcionCampo.VisiblesK(cm.Opciones)) { <option value="@op">@op</option> }
                                        </select>
                                        break;
                                    default:
                                        <input class="seg-input" @bind:get="Val(cid)" @bind:set="v => SetVal(cid, v)" @bind:event="oninput" />
                                        break;
                                }
                            </div>
                        }
                    }
                </div>
            </div>
            @if (_editId is not null)
            {
                <aside class="seg-actpane">
                    <div class="act-panel">
                        <div class="act-h"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> Actividad</div>
                        <div class="act-chat">
                            @if (_comentarios.Count == 0)
                            {
                                <div class="act-empty">Aún no hay actividad. Escribe el primer mensaje sobre el siniestro.</div>
                            }
                            else
                            {
                                @foreach (var c in _comentarios)
                                {
                                    if (c.EsSistema)
                                    {
                                        <div class="sin-act-sis"><span>@c.Texto</span><span class="act-time">@c.CreatedAt.ToLocalTime().ToString("dd MMM - HH:mm")</span></div>
                                        continue;
                                    }
                                    var mine = c.AutorUsuarioId is { } au && au == _miUsuarioId;
                                    var autor = string.IsNullOrWhiteSpace(c.AutorNombre) ? "Usuario" : c.AutorNombre!;
                                    <div class="act-msg @(mine ? "mine" : "")">
                                        <span class="act-av">@Iniciales(autor)</span>
                                        <div class="act-msg-b">
                                            <div class="act-who">@autor</div>
                                            <div class="act-bubble">@c.Texto</div>
                                            <div class="act-time">@c.CreatedAt.ToLocalTime().ToString("dd MMM - HH:mm")</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="act-qr-row">
                            <span class="act-qr-lbl">Respuesta rápida</span>
                            @foreach (var qr in _respuestasRapidas)
                            {
                                var t = qr;
                                <button type="button" class="act-qr" @onclick="() => EnviarComentario(t)" disabled="@_busy">@t</button>
                            }
                        </div>
                        <div class="act-composer">
                            <input class="seg-input" @bind="_nuevoComentario" @bind:event="oninput" placeholder="Escribe un mensaje..." @onkeydown="OnChatKey" />
                            <button type="button" class="act-cbtn act-send" title="Enviar" @onclick="() => EnviarComentario(null)" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoComentario))"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"/></svg></button>
                        </div>
                    </div>
                </aside>
            }
            </div>
            }
            else if (_tab == "docs")
            {
                <div class="seg-docpane">
                    <DocumentosPanel Documentos="DocsItems()" Subiendo="_docsSubiendo" Fill="true" Padding="0"
                                     EmptyHint="Sube fotos del daño, cotizaciones, el informe del perito y la respuesta de la aseguradora."
                                     OnSubir="OnSubirDocumento" OnEliminar="OnEliminarDocumento" />
                </div>
            }
        </div>
        @if (_modalError is not null) { <div class="seg-banner err" style="margin:12px 20px 0;">@_modalError</div> }
        @if (_editId is null || _tab == "siniestro")
        {
            <div class="seg-modal-foot">
                @if (_editId is not null)
                {
                    <button class="seg-btn-danger" style="margin-right:auto;" @onclick="() => _confirmEliminar = true" disabled="@_busy">Eliminar</button>
                }
                <button class="seg-btn-ghost" @onclick="() => _modal = false">Cancelar</button>
                <button class="seg-btn-brand" @onclick="GuardarAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_f.Titulo))">@(_editId is null ? "Crear siniestro" : "Guardar siniestro")</button>
            </div>
        }
    </div>
    @if (_confirmEliminar)
    {
        <div class="seg-ov seg-ov--top" @onclick="() => { if (!_eliminando) _confirmEliminar = false; }"></div>
        <div class="seg-confirm" @onclick:stopPropagation="true">
            <div class="seg-confirm-t">Eliminar siniestro</div>
            <div class="seg-confirm-s">Se eliminará el siniestro @(_dto?.Numero) junto con sus documentos, actividad y valores. Esta acción no se puede deshacer.</div>
            <div class="seg-confirm-acts">
                <button class="seg-btn-ghost" @onclick="() => _confirmEliminar = false" disabled="@_eliminando">Cancelar</button>
                <button class="seg-btn-danger" @onclick="BorrarAsync" disabled="@_eliminando">@(_eliminando ? "Eliminando..." : "Sí, eliminar")</button>
            </div>
        </div>
    }
}

<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />

<ModalHost />

<SegurosEstilos />
<style>
    /* Extras de Siniestros sobre el canon seg-* (solo tokens). */
    .sin-est { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--propia-text-body); background: var(--propia-bg-card-soft); border: 1px solid var(--propia-border-card); border-radius: 999px; padding: 3px 10px 3px 8px; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
    .sin-est i { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
    .sin-gdot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; flex: 0 0 auto; }
    .sin-estbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; padding: 10px 12px; background: var(--propia-bg-card-soft); border: 1px solid var(--propia-border-card); border-radius: 10px; }
    .sin-estsel { width: auto; min-width: 220px; }
    .sin-pidemonto { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; flex-basis: 100%; font-size: 12.5px; color: var(--propia-text-secondary); padding-top: 8px; border-top: 1px dashed var(--propia-border-divider); }
    .sin-tarea { margin-left: auto; display: flex; align-items: center; }
    .sin-tarea .seg-btn-ghost { display: inline-flex; align-items: center; gap: 6px; }
    .sin-tarea-link { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: var(--propia-brand); background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); border-radius: 8px; padding: 6px 10px; text-decoration: none; }
    .sin-tarea-link:hover { background: var(--propia-brand-soft-2); }
    .sin-tarea-link b { font-weight: 800; }
    .sin-nota { font-size: 12.5px; color: var(--propia-text-secondary); background: var(--propia-brand-soft-2); border: 1px solid var(--propia-brand-border); border-radius: 9px; padding: 8px 11px; margin-bottom: 14px; }
    .sin-nota b { color: var(--propia-text-h1); }
    .sin-act-sis { display: flex; flex-direction: column; align-items: center; gap: 1px; align-self: center; text-align: center; font-size: 11.5px; color: var(--propia-text-muted); background: var(--propia-bg-card); border: 1px dashed var(--propia-border-card); border-radius: 9px; padding: 5px 10px; max-width: 92%; }
