    // ---- Eliminar ----
    private bool _confirmEliminar;
    private bool _eliminando;
    private async Task BorrarAsync()
    {
        if (_editId is not Guid id) { _confirmEliminar = false; return; }
        _eliminando = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/siniestros/{id}");
            if (resp.IsSuccessStatusCode)
            {
                _confirmEliminar = false; _modal = false;
                _inlineMsg = "Siniestro eliminado."; _inlineMsgEsError = false;
                await CargarAsync();
            }
            else { _modalError = await MensajeErrorAsync(resp); _confirmEliminar = false; }
        }
        catch (Exception ex) { _modalError = ex.Message; _confirmEliminar = false; }
        finally { _eliminando = false; }
    }

    // ---- Actividad ----
    private List<SiniestroComentarioDto> _comentarios = new();
    private string _nuevoComentario = "";
    private static readonly string[] _respuestasRapidas = { "Reportado a la aseguradora", "Esperando perito", "Documentos enviados", "Pago recibido" };
    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var parts = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpperInvariant();
    }
    private async Task EnviarComentario(string? textoRapido)
    {
        if (_editId is not { } id) return;
        var texto = (textoRapido ?? _nuevoComentario).Trim();
        if (string.IsNullOrWhiteSpace(texto)) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/siniestros/{id}/comentarios", new AgregarComentarioSiniestroRequest(texto));
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<SiniestroComentarioDto>();
                if (dto is not null) _comentarios.Add(dto);
                if (textoRapido is null) _nuevoComentario = "";
            }
            else _modalError = await MensajeErrorAsync(resp);
        }
        catch { }
        finally { _busy = false; }
    }
    private async Task OnChatKey(KeyboardEventArgs e) { if (e.Key == "Enter") await EnviarComentario(null); }

    // ---- Documentos ----
    private List<SiniestroDocumentoDto> _docs = new();
    private bool _docsSubiendo;
    private List<DocumentosPanel.Item> DocsItems() => _docs.Select(d => new DocumentosPanel.Item(d.Id, d.Nombre, d.Url)).ToList();
    private async Task OnSubirDocumento(InputFileChangeEventArgs e)
    {
        if (_editId is not { } id) return;
        _docsSubiendo = true; _modalError = null;
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                using var content = new MultipartFormDataContent();
                var sc = new StreamContent(file.OpenReadStream(10_000_000));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(sc, "file", file.Name);
                var resp = await Auth().PostAsync($"/api/siniestros/{id}/documentos", content);
                if (!resp.IsSuccessStatusCode) { _modalError = await MensajeErrorAsync(resp); break; }
            }
            _docs = await Auth().GetFromJsonAsync<List<SiniestroDocumentoDto>>($"/api/siniestros/{id}/documentos") ?? _docs;
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _docsSubiendo = false; }
    }
    private async Task OnEliminarDocumento(Guid docId)
    {
        var resp = await Auth().DeleteAsync($"/api/siniestros/documentos/{docId}");
        if (resp.IsSuccessStatusCode) _docs.RemoveAll(d => d.Id == docId);
        else _modalError = await MensajeErrorAsync(resp);
    }
}
