    private bool _altaAbierta;
    private string _nTitulo = "", _nTipo = "", _nElemento = "", _nOcurrencia = "", _nReporte = "", _nPoliza = "", _nReclamacion = "",
        _nEstimado = "", _nReclamado = "", _nDeducible = "", _nDescripcion = "";
    private PersonaCandidatoDto? _nResponsable;
    private bool _creandoInline;
