    [JSInvokable] public async Task AltaBlurGuardar()
    {
        if (!_altaAbierta || _creandoInline) return;
        if (string.IsNullOrWhiteSpace(_nTitulo) || string.IsNullOrWhiteSpace(_nOcurrencia)) { CerrarAlta(); StateHasChanged(); return; }
        await CrearDesdeAltaAsync();
        StateHasChanged();
    }
    private static (ElementoSiniestro Tipo, Guid? Id) ParseElementoAlta(string v)
    {
        var i = v.IndexOf(':');
        if (i <= 0 || !Guid.TryParse(v[(i + 1)..], out var g)) return (ElementoSiniestro.Ninguno, null);
        return v[..i] switch
        {
            "equipo" => (ElementoSiniestro.Equipo, g),
            "zona" => (ElementoSiniestro.Zona, g),
            "unidad" => (ElementoSiniestro.Unidad, g),
            _ => (ElementoSiniestro.Ninguno, null)
        };
    }
    private static decimal? Dec(string s)
        => decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    private static string? Txt(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task CrearDesdeAltaAsync()
    {
        if (string.IsNullOrWhiteSpace(_nTitulo)) { _inlineMsg = "Indica qué pasó para crear el siniestro."; _inlineMsgEsError = true; return; }
        if (!DateOnly.TryParse(_nOcurrencia, out var oc)) { _inlineMsg = "Indica la fecha de ocurrencia."; _inlineMsgEsError = true; return; }
        _creandoInline = true;
        try
        {
            var (et, eid) = ParseElementoAlta(_nElemento);
            var req = new CrearSiniestroRequest(_nTitulo.Trim(), oc,
                Descripcion: Txt(_nDescripcion), TipoClave: Txt(_nTipo),
                FechaReporte: DateOnly.TryParse(_nReporte, out var fr) ? fr : null,
                ElementoTipo: et, ElementoId: eid,
                PolizaId: Guid.TryParse(_nPoliza, out var pg) ? pg : null,
                NumeroReclamacion: Txt(_nReclamacion), ResponsablePersonaId: _nResponsable?.PersonaId,
                MontoEstimado: Dec(_nEstimado), MontoReclamado: Dec(_nReclamado), Deducible: Dec(_nDeducible));
            var resp = await Auth().PostAsJsonAsync("/api/siniestros", req);
            if (resp.IsSuccessStatusCode)
            {
                try { var c = await resp.Content.ReadFromJsonAsync<SiniestroDto>(); if (c is not null) _recienCreados.Add(c.Id); } catch { }
                _altaAbierta = false; LimpiarAlta();
                _inlineMsg = "Siniestro creado."; _inlineMsgEsError = false;
                await CargarAsync();
            }
            else { _inlineMsg = await MensajeErrorAsync(resp); _inlineMsgEsError = true; }
        }
        catch (Exception ex) { _inlineMsg = ex.Message; _inlineMsgEsError = true; }
        finally { _creandoInline = false; }
    }
    // Expander de la fila de alta: lleva lo escrito al modal (sin crear) y cierra la fila (evita el doble alta del blur).
    private async Task AbrirModalDesdeAltaAsync()
    {
        var t = _nTitulo; var tipo = _nTipo; var el = _nElemento; var oc = _nOcurrencia; var rep = _nReporte; var pol = _nPoliza;
        var rec = _nReclamacion; var est = _nEstimado; var recl = _nReclamado; var ded = _nDeducible; var desc = _nDescripcion; var resp = _nResponsable;
        _altaAbierta = false; _inlineMsg = null; LimpiarAlta();
        await AbrirModal(null);
        _f.Titulo = t.Trim(); _f.TipoClave = Txt(tipo); _f.Descripcion = Txt(desc); _f.NumeroReclamacion = Txt(rec);
        var (et, eid) = ParseElementoAlta(el); _f.ElementoTipo = et; _f.ElementoId = eid;
        if (DateTime.TryParse(oc, out var d1)) _f.Ocurrencia = d1;
        if (DateTime.TryParse(rep, out var d2)) _f.Reporte = d2;
        _f.PolizaId = Guid.TryParse(pol, out var pg) ? pg : null;
        _f.MontoEstimado = Dec(est); _f.MontoReclamado = Dec(recl); _f.Deducible = Dec(ded);
        if (resp is not null) OnResponsableSel(resp);
    }

