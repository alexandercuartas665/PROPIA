    {
        _cfg.TryGetValue(clave, out var c);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato, Oculto: c?.Oculto ?? false, Orden: c?.Orden, Entidad: "siniestro", Descripcion: c?.Descripcion);
