    { foreach (var k in ClavesOrdenadas()) { if (EsFija(k)) continue; await GuardarCfg(FilaConfig(k) with { Oculto = true }); } await CargarConfigAsync(); StateHasChanged(); }
    private async Task MostrarTodasColMenu()
    { foreach (var k in ClavesOrdenadas()) await GuardarCfg(FilaConfig(k) with { Oculto = false }); await CargarConfigAsync(); StateHasChanged(); }
    private async Task RestablecerColMenu()
    { foreach (var k in ClavesOrdenadas()) await GuardarCfg(FilaConfig(k) with { Oculto = false, Orden = null }); await CargarConfigAsync(); StateHasChanged(); }
