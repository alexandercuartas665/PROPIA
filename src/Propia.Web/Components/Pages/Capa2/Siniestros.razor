    private sealed class Regla { public string Campo = "estado"; public string Op = "es"; public string Valor = ""; }
    private readonly List<Regla> _reglas = new();
    private string _logica = "and";
    private bool _filtrosMenu;
    private static bool ReglaActiva(Regla r) => r.Op is "vacio" or "no_vacio" || !string.IsNullOrWhiteSpace(r.Valor);
    private int CuentaReglas => _reglas.Count(ReglaActiva);
    private bool HayReglasActivas => _reglas.Any(ReglaActiva);
    private void ToggleFiltros() { _filtrosMenu = !_filtrosMenu; if (_filtrosMenu && _reglas.Count == 0) AgregarRegla(); }
    private void AgregarRegla() => _reglas.Add(new Regla());
    private void QuitarRegla(int idx) { if (idx >= 0 && idx < _reglas.Count) _reglas.RemoveAt(idx); }
    private void LimpiarReglas() { _reglas.Clear(); _logica = "and"; }
    private void SetLogica(ChangeEventArgs e) => _logica = e.Value?.ToString() == "or" ? "or" : "and";
    private void SetReglaCampo(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _reglas.Count) return;
        _reglas[idx].Campo = e.Value?.ToString() ?? "estado";
        var ops = Operadores(_reglas[idx].Campo);
        if (!ops.Any(o => o.Key == _reglas[idx].Op)) _reglas[idx].Op = ops.First().Key;
        _reglas[idx].Valor = "";
    }
    private void SetReglaOp(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglas.Count) _reglas[idx].Op = e.Value?.ToString() ?? "es"; }
    private void SetReglaValor(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglas.Count) _reglas[idx].Valor = e.Value?.ToString() ?? ""; }
    private IEnumerable<(string Key, string Label)> CamposFiltro()
    {
        yield return ("numero", "N° siniestro");
        yield return ("titulo", "Título");
        yield return ("estado", "Estado");
        yield return ("tipo", "Tipo");
        yield return ("elemento", "Elemento afectado");
        yield return ("ocurrencia", "Fecha de ocurrencia");
        yield return ("poliza", "Póliza");
        yield return ("reclamado", "Monto reclamado");
        yield return ("reconocido", "Monto reconocido");
        foreach (var c in CamposActivos) yield return (c.Id.ToString(), c.Label);
    }
    private SiniestroCampoDto? CampoDin(string campo) => Guid.TryParse(campo, out var g) ? CamposActivos.FirstOrDefault(c => c.Id == g) : null;
    private string FiltroKind(string campo) => campo switch
    {
        "estado" => "sel-estado",
        "tipo" => "sel-tipo",
        "elemento" => "sel-elem",
        "ocurrencia" => "fecha",
        "reclamado" or "reconocido" => "num",
        "numero" or "titulo" or "poliza" => "texto",
        _ => CampoDin(campo)?.Tipo switch
        {
            TipoCampoTablero.Numero or TipoCampoTablero.Moneda or TipoCampoTablero.Porcentaje or TipoCampoTablero.Formula => "num",
            TipoCampoTablero.Fecha => "fecha",
            TipoCampoTablero.Seleccion => "sel-din",
            TipoCampoTablero.Booleano => "sel-bool",
            _ => "texto"
        }
    };
    private IEnumerable<(string Key, string Label)> Operadores(string campo)
    {
        switch (FiltroKind(campo))
        {
            case "num":
                return new[] { ("=", "es igual a"), ("!=", "es distinto de"), (">", "mayor que"), (">=", "mayor o igual"),
                               ("<", "menor que"), ("<=", "menor o igual"), ("vacio", "está vacío"), ("no_vacio", "no está vacío") };
            case "fecha":
                return new[] { ("es", "es"), ("antes", "antes de"), ("despues", "después de"), ("vacio", "está vacío"), ("no_vacio", "no está vacío") };
            case "texto":
                return new[] { ("contiene", "contiene"), ("no_contiene", "no contiene"), ("es", "es"), ("no_es", "no es"),
                               ("vacio", "está vacío"), ("no_vacio", "no está vacío") };
            default:
                return new[] { ("es", "es"), ("no_es", "no es"), ("vacio", "está vacío"), ("no_vacio", "no está vacío") };
        }
    }
    private string ValorTextoFiltro(SiniestroDto s, string campo) => campo switch
    {
        "numero" => s.Numero,
        "titulo" => s.Titulo,
        "estado" => s.EstadoId.ToString(),
        "tipo" => s.TipoClave ?? "",
        "elemento" => s.ElementoTipo == ElementoSiniestro.Ninguno ? "" : ((int)s.ElementoTipo).ToString(),
        "poliza" => PolizaTexto(s) is var p && p == "-" ? "" : PolizaTexto(s),
        _ => CampoDin(campo) is { } cm ? (cm.Tipo == TipoCampoTablero.Booleano
                ? (RawCampo(s, cm.Id) == "true" ? "Sí" : (RawCampo(s, cm.Id) == "false" ? "No" : ""))
                : RawCampo(s, cm.Id) ?? "") : ""
    };
    private decimal? ValorNumFiltro(SiniestroDto s, string campo) => campo switch
    {
        "reclamado" => s.MontoReclamado,
        "reconocido" => s.MontoReconocido,
        _ => CampoDin(campo) is { } cm ? Dec(RawCampo(s, cm.Id) ?? "") : null
    };
    private DateOnly? FechaFiltro(SiniestroDto s, string campo)
    {
        if (campo == "ocurrencia") return s.FechaOcurrencia;
        return CampoDin(campo) is { } cm && DateOnly.TryParse(RawCampo(s, cm.Id), out var d) ? d : null;
    }
    private bool EvalRegla(SiniestroDto s, Regla r)
    {
        var kind = FiltroKind(r.Campo);
        if (kind == "num")
        {
            var nv = ValorNumFiltro(s, r.Campo);
            if (r.Op == "vacio") return nv is null;
            if (r.Op == "no_vacio") return nv is not null;
            if (Dec(r.Valor) is not { } rv) return true;
            if (nv is null) return false;
            return r.Op switch { "=" => nv == rv, "!=" => nv != rv, ">" => nv > rv, ">=" => nv >= rv, "<" => nv < rv, "<=" => nv <= rv, _ => true };
        }
        if (kind == "fecha")
        {
            var dv = FechaFiltro(s, r.Campo);
            if (r.Op == "vacio") return dv is null;
            if (r.Op == "no_vacio") return dv is not null;
            if (!DateOnly.TryParse(r.Valor, out var rd)) return true;
            if (dv is null) return false;
            return r.Op switch { "es" => dv == rd, "antes" => dv < rd, "despues" => dv > rd, _ => true };
        }
        var sv = ValorTextoFiltro(s, r.Campo);
        if (r.Op == "vacio") return string.IsNullOrWhiteSpace(sv);
        if (r.Op == "no_vacio") return !string.IsNullOrWhiteSpace(sv);
        if (string.IsNullOrEmpty(r.Valor)) return true;
        return r.Op switch
        {
            "es" => string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_es" => !string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "contiene" => sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_contiene" => !sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }
    private IEnumerable<(string Val, string Txt)> OpcionesFiltro(string campo) => FiltroKind(campo) switch
    {
        "sel-estado" => _estados.OrderBy(e => e.Orden).Select(e => (e.Id.ToString(), e.Nombre)),
        "sel-tipo" => _tipos.OrderBy(t => t.Orden).Select(t => (t.Clave, t.Label)),
        "sel-elem" => new[] { ("1", "Equipo"), ("2", "Zona común"), ("3", "Unidad"), ("4", "Otro") },
        "sel-din" => OpcionCampo.VisiblesK(CampoDin(campo)?.Opciones).Select(o => (o, o)),
        "sel-bool" => new[] { ("Sí", "Sí"), ("No", "No") },
        _ => Array.Empty<(string, string)>()
    };
    private RenderFragment RenderValor(int idx) => builder =>
    {
        if (idx < 0 || idx >= _reglas.Count) return;
        var r = _reglas[idx];
        var kind = FiltroKind(r.Campo);
        if (kind.StartsWith("sel-", StringComparison.Ordinal))
        {
            builder.OpenElement(0, "select");
            builder.AddAttribute(1, "class", "seg-frule-v");
            builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValor(idx, e)));
            builder.OpenElement(3, "option");
            builder.AddAttribute(4, "value", "");
            builder.AddAttribute(5, "selected", string.IsNullOrEmpty(r.Valor));
            builder.AddContent(6, "Elegir...");
            builder.CloseElement();
            foreach (var (val, txt) in OpcionesFiltro(r.Campo))
            {
                builder.OpenElement(7, "option");
                builder.AddAttribute(8, "value", val);
                builder.AddAttribute(9, "selected", r.Valor == val);
                builder.AddContent(10, txt);
                builder.CloseElement();
            }
            builder.CloseElement();
            return;
        }
        builder.OpenElement(20, "input");
        builder.AddAttribute(21, "class", "seg-frule-v");
        builder.AddAttribute(22, "type", kind == "num" ? "number" : kind == "fecha" ? "date" : "text");
        builder.AddAttribute(23, "value", r.Valor);
        builder.AddAttribute(24, "placeholder", "Valor");
        builder.AddAttribute(25, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValor(idx, e)));
        builder.CloseElement();
    };
    private string ResumenReglas()
    {
        var partes = _reglas.Where(ReglaActiva).Select(r =>
        {
            var campo = CamposFiltro().FirstOrDefault(x => x.Key == r.Campo).Label ?? r.Campo;
            var op = Operadores(r.Campo).FirstOrDefault(o => o.Key == r.Op).Label ?? r.Op;
            if (r.Op is "vacio" or "no_vacio") return $"{campo} {op}";
            var val = OpcionesFiltro(r.Campo).FirstOrDefault(o => o.Val == r.Valor).Txt ?? r.Valor;
            return $"{campo} {op} {val}";
        }).ToList();
        return string.Join(_logica == "or" ? " O " : " Y ", partes);
    }

    private List<SiniestroDto> Filtradas
    {
        get
        {
            var q = _q.Trim();
            var activas = _reglas.Where(ReglaActiva).ToList();
            var lista = _items.Where(s =>
            {
                if (q != ""
                    && !s.Numero.Contains(q, StringComparison.OrdinalIgnoreCase)
                    && !s.Titulo.Contains(q, StringComparison.OrdinalIgnoreCase)
                    && !ElementoTexto(s).Contains(q, StringComparison.OrdinalIgnoreCase)
                    && !PolizaTexto(s).Contains(q, StringComparison.OrdinalIgnoreCase)
                    && !(s.NumeroReclamacion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
                    return false;
                if (activas.Count == 0) return true;
                return _logica == "or" ? activas.Any(r => EvalRegla(s, r)) : activas.All(r => EvalRegla(s, r));
            }).ToList();
            if (_sorts.Count > 0)
            {
                lista = lista.OrderBy(s => s, Comparer<SiniestroDto>.Create((a, b) =>
                {
                    foreach (var so in _sorts)
                    {
                        var cmp = CmpOrd(ValorOrden(a, so.Key), ValorOrden(b, so.Key)) * so.Dir;
                        if (cmp != 0) return cmp;
                    }
                    return 0;
                })).ToList();
            }
            return lista;
        }
    }

