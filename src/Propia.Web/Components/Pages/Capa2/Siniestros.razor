    private async Task GuardarAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_f.Titulo)) { _modalError = "Indica qué pasó."; return; }
        if (_f.Ocurrencia is null) { _modalError = "La fecha de ocurrencia es obligatoria."; return; }
        if (_f.ElementoTipo is ElementoSiniestro.Equipo or ElementoSiniestro.Zona or ElementoSiniestro.Unidad && _f.ElementoId is null)
        { _modalError = "Selecciona el elemento afectado o cambia el tipo a Ninguno."; return; }
        static DateOnly? D(DateTime? d) => d.HasValue ? DateOnly.FromDateTime(d.Value) : null;
        _busy = true;
        try
        {
            HttpResponseMessage resp;
            var oc = DateOnly.FromDateTime(_f.Ocurrencia.Value);
            if (_editId is null)
            {
                resp = await Auth().PostAsJsonAsync("/api/siniestros", new CrearSiniestroRequest(
                    _f.Titulo.Trim(), oc, Txt(_f.Descripcion), Txt(_f.TipoClave), D(_f.Reporte),
                    _f.ElementoTipo, _f.ElementoId, Txt(_f.ElementoOtro), _f.PolizaId, Txt(_f.NumeroReclamacion),
                    _f.ResponsableId, _f.MontoEstimado, _f.MontoReclamado, _f.Deducible));
            }
            else
            {
                // PUT es MERGE: los opcionales vacios se nombran en Limpiar para borrarlos de verdad.
                var limpiar = new List<string>();
                if (Txt(_f.Descripcion) is null) limpiar.Add("descripcion");
                if (Txt(_f.TipoClave) is null) limpiar.Add("tipo");
                if (_f.Reporte is null) limpiar.Add("fechareporte");
                if (_f.PolizaId is null) limpiar.Add("poliza");
                if (Txt(_f.NumeroReclamacion) is null) limpiar.Add("numeroreclamacion");
                if (_f.ResponsableId is null) limpiar.Add("responsable");
                if (_f.MontoEstimado is null) limpiar.Add("montoestimado");
                if (_f.MontoReclamado is null) limpiar.Add("montoreclamado");
                if (_f.Deducible is null) limpiar.Add("deducible");
                if (_f.MontoReconocido is null) limpiar.Add("montoreconocido");
                if (_f.FechaPago is null) limpiar.Add("fechapago");
                resp = await Auth().PutAsJsonAsync($"/api/siniestros/{_editId}", new ActualizarSiniestroRequest(
                    _f.Titulo.Trim(), Txt(_f.Descripcion), Txt(_f.TipoClave), oc, D(_f.Reporte),
                    _f.ElementoTipo, _f.ElementoId, Txt(_f.ElementoOtro), _f.PolizaId, Txt(_f.NumeroReclamacion),
                    _f.ResponsableId, _f.MontoEstimado, _f.MontoReclamado, _f.Deducible, _f.MontoReconocido, D(_f.FechaPago),
                    limpiar.Count > 0 ? limpiar : null));
            }
            if (!resp.IsSuccessStatusCode) { _modalError = await MensajeErrorAsync(resp); return; }
            Guid? sid = _editId;
            if (sid is null)
            {
                try { var c = await resp.Content.ReadFromJsonAsync<SiniestroDto>(); sid = c?.Id; if (c is not null) _recienCreados.Add(c.Id); } catch { }
            }
            if (sid is { } id)
            {
                foreach (var cm in CamposActivos.Where(c => c.Tipo is not (TipoCampoTablero.Formula or TipoCampoTablero.Total)))
                {
                    var val = _campoValores.TryGetValue(cm.Id, out var vv) ? vv : null;
                    var antes = _editId is null ? null : _valores.TryGetValue(id, out var d) && d.TryGetValue(cm.Id, out var a) ? a : null;
                    if (_editId is not null && (antes ?? "") == (val ?? "")) continue;
                    if (_editId is null && string.IsNullOrWhiteSpace(val)) continue;
                    try { await Auth().PutAsJsonAsync($"/api/siniestros/{id}/campos/{cm.Id}", new GuardarSiniestroCampoValorRequest(string.IsNullOrWhiteSpace(val) ? null : val)); } catch { }
                }
            }
            _modal = false;
            _inlineMsg = _editId is null ? "Siniestro creado." : "Siniestro guardado."; _inlineMsgEsError = false;
            await CargarAsync();
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _busy = false; }
    }

