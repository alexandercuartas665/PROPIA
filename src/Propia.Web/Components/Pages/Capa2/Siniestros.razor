    private void LimpiarAlta()
    {
        _nTitulo = _nTipo = _nElemento = _nReporte = _nPoliza = _nReclamacion = _nEstimado = _nReclamado = _nDeducible = _nDescripcion = "";
        _nOcurrencia = HoyColombia().ToString("yyyy-MM-dd");
        _nResponsable = null;
    }
    private void CerrarAlta() { _altaAbierta = false; LimpiarAlta(); }
    private async Task OnAltaKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CerrarAlta();
        else if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(_nTitulo) && !_creandoInline)
        {
            await CrearDesdeAltaAsync();
            _focoCtaAlta = !_altaAbierta;   // como Tareas: guarda, cierra y foco en "Agregar registro"
        }
    }
