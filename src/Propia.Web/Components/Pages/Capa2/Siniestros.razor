        => ClavesOrdenadas().Select(k => new TablaColumnasMenu.Col(
            k, ColLabel(k), EsDinamico: k.StartsWith("cd:", StringComparison.Ordinal), Visible: VisibleCol(k),
            Movible: !EsFija(k), Ocultable: !EsFija(k))).ToList();
    private async Task MoverColMenu((string Key, int Dir) a)
    {
        var keys = ClavesOrdenadas().ToList();
        var i = keys.IndexOf(a.Key); var j = i + a.Dir;
        if (i < 0 || j < 0 || j >= keys.Count) return;
        (keys[i], keys[j]) = (keys[j], keys[i]);
        for (int k = 0; k < keys.Count; k++) await GuardarCfg(FilaConfig(keys[k]) with { Orden = k });
        await CargarConfigAsync(); StateHasChanged();
    }
    private async Task ToggleVisibleColMenu(string k)
    { if (EsFija(k)) return; await GuardarCfg(FilaConfig(k) with { Oculto = VisibleCol(k) }); await CargarConfigAsync(); StateHasChanged(); }
