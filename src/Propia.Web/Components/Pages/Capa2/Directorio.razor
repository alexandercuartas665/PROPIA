    private async Task CargarAdjuntosAsync()
    {
        try { _adjuntos = await Auth().GetFromJsonAsync<List<DirectorioAdjuntoDto>>($"/api/directorio/adjuntos/{AdjTipoRuta}/{_detalleId}") ?? new(); }
        catch { _adjuntos = new(); }
        // Mantener la seleccion del visor viva: si el seleccionado ya no existe, tomar el primero.
        if (_adjSel is null || _adjuntos.All(a => a.Id != _adjSel)) _adjSel = _adjuntos.FirstOrDefault()?.Id;
        StateHasChanged();
    }

    private async Task SubirAdjuntosAsync(InputFileChangeEventArgs e)
    {
        _adjMsg = null; _adjBusy = true;
        StateHasChanged();
        try
        {
            foreach (var f in e.GetMultipleFiles(10))
            {
                if (f.Size > 10_000_000) { _adjMsg = $"\"{f.Name}\" supera 10 MB y no se subio."; continue; }
                using var content = new MultipartFormDataContent();
                var sc = new StreamContent(f.OpenReadStream(maxAllowedSize: 10_000_000));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
                content.Add(sc, "file", f.Name);
                var resp = await Auth().PostAsync($"/api/directorio/adjuntos/{AdjTipoRuta}/{_detalleId}", content);
                if (!resp.IsSuccessStatusCode)
                    _adjMsg = "No se pudo subir \"" + f.Name + "\": " + await MensajeDeError(resp, "revisa el archivo.");
            }
            await CargarAdjuntosAsync();
        }
        catch (Exception ex) { _adjMsg = "Error subiendo archivos: " + ex.Message; }
        finally { _adjBusy = false; StateHasChanged(); }
    }

    private async Task EliminarAdjuntoAsync(Guid id)
    {
        _adjBusy = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/directorio/adjuntos/{id}");
            if (resp.IsSuccessStatusCode) await CargarAdjuntosAsync();
        }
        finally { _adjBusy = false; StateHasChanged(); }
    }

    private static string TamanoLegible(long bytes) => bytes switch
    {
        >= 1_048_576 => $"{bytes / 1_048_576.0:0.#} MB",
        >= 1_024 => $"{bytes / 1_024.0:0.#} KB",
        _ => $"{bytes} B"
    };

    private static bool EsImg(string url)
    {
        // Quitar el ?query (ej. ?v=...) antes de mirar la extension, si no las imagenes con querystring no previsualizan.
        var u = url.ToLowerInvariant().Split('?')[0].TrimEnd();
        return u.EndsWith(".jpg") || u.EndsWith(".jpeg") || u.EndsWith(".png") || u.EndsWith(".webp") || u.EndsWith(".gif") || u.EndsWith(".bmp") || u.EndsWith(".svg");
    }
    private static bool EsPdf(string url) => url.ToLowerInvariant().Split('?')[0].TrimEnd().EndsWith(".pdf");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                try
                {
                    var n = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_copropiedad_nombre");
                    if (!string.IsNullOrWhiteSpace(n)) CopropiedadNombre = n;
                }
                catch { }
                await RestaurarVistaAsync();
                await RestaurarColsAsync();
                await CargarEtiquetasAsync();
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { /* prerender */ }
    }

