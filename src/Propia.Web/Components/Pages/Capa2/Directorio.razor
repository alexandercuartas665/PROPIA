    // ---- Plantilla Excel de personas (descargar / cargar con upsert por documento) ----
    private async Task DescargarPlantillaAsync()
    {
        _impBusy = true;
        try
        {
            var bytes = await Auth().GetByteArrayAsync("/api/directorio/plantilla");
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", "plantilla-directorio-propia.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { await Js.InvokeVoidAsync("alert", "No se pudo descargar la plantilla: " + ex.Message); }
        finally { _impBusy = false; }
    }

    private async Task OnPlantillaImport(InputFileChangeEventArgs e)
    {
        if (e.File is null) return;
        _impBusy = true; _impResult = null; StateHasChanged();
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StreamContent(e.File.OpenReadStream(10 * 1024 * 1024)), "file", e.File.Name);
            var resp = await Auth().PostAsync("/api/directorio/importar", content);
            if (resp.IsSuccessStatusCode)
            {
                _impResult = await resp.Content.ReadFromJsonAsync<ImportarPlantillaResultado>();
                await CargarAsync();
            }
            else await Js.InvokeVoidAsync("alert", "Error al cargar: " + await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { await Js.InvokeVoidAsync("alert", "Error al cargar: " + ex.Message); }
        finally { _impBusy = false; StateHasChanged(); }
    }

    private static string Iniciales(string nombres, string apellidos)
        => $"{(nombres.Length > 0 ? nombres[0] : ' ')}{(apellidos.Length > 0 ? apellidos[0] : ' ')}".ToUpperInvariant();

    private static string InicialesEmpresa(string razon)
    {
        if (string.IsNullOrWhiteSpace(razon)) return "?";
        var partes = razon.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, Math.Min(2, partes[0].Length)).ToUpperInvariant();
        return (partes[0][0].ToString() + partes[partes.Length - 1][0].ToString()).ToUpperInvariant();
    }

    private static string JoinDash(string? a, string? b)
    {
        var parts = new[] { a, b }.Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
        return parts.Length == 0 ? "-" : string.Join(" / ", parts);
    }

