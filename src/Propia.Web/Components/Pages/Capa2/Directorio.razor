    {
        _detalleAbierto = true; _detalleTipo = "persona"; _detalleTab = "perfil"; _detalleEdit = false;
        _detalleId = id; _p360 = null; _e360 = null; _detalleError = null; _detalleCargando = true;
        _adjuntos = new(); _adjMsg = null;
        try
        {
            var resp = await Auth().GetAsync($"/api/directorio/personas/{id}");
            if (resp.StatusCode == System.Net.HttpStatusCode.NotFound) { _detalleError = "Persona no encontrada"; return; }
            resp.EnsureSuccessStatusCode();
            _p360 = await resp.Content.ReadFromJsonAsync<Persona360Dto>();
        }
        catch (Exception ex) { _detalleError = ex.Message; }
        finally { _detalleCargando = false; }
    }

    private async Task AbrirEmpresa(Guid id)
    {
        _detalleAbierto = true; _detalleTipo = "empresa"; _detalleTab = "perfil"; _detalleEdit = false;
        _detalleId = id; _p360 = null; _e360 = null; _detalleError = null; _detalleCargando = true;
        _adjuntos = new(); _adjMsg = null;
        try
        {
            var resp = await Auth().GetAsync($"/api/directorio/empresas/{id}");
            if (resp.StatusCode == System.Net.HttpStatusCode.NotFound) { _detalleError = "Empresa no encontrada"; return; }
            resp.EnsureSuccessStatusCode();
            _e360 = await resp.Content.ReadFromJsonAsync<Empresa360Dto>();
        }
        catch (Exception ex) { _detalleError = ex.Message; }
