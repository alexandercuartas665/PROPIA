            if (resp.IsSuccessStatusCode)
            {
                if (_cfgEditId == id) ResetCfgForm();
                await CargarEtiquetasAsync();
                await CargarAsync();
                _cfgMsg = "Etiqueta eliminada."; _cfgErr = false;
