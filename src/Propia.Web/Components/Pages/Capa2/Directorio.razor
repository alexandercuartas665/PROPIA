    private void AbrirCfgEtiquetas() { _cfgOpen = true; ResetCfgForm(); }

    private void ResetCfgForm()
    {
        _cfgEditId = null; _cfgNombre = ""; _cfgIcono = ""; _cfgColor = "#6D4FE3";
        _cfgGrupo = GrupoEtiqueta.Identidad; _cfgAplica = AplicaEtiqueta.Persona; _cfgMsg = null;
    }

    private void EditarEtiqueta(EtiquetaCatalogoDto et)
    {
        _cfgEditId = et.Id; _cfgNombre = et.Nombre; _cfgIcono = et.Icono ?? "";
        _cfgColor = string.IsNullOrEmpty(et.Color) ? "#6D4FE3" : et.Color!;
        _cfgGrupo = et.Grupo; _cfgAplica = et.AplicaA; _cfgMsg = null;
    }

    private async Task GuardarEtiqueta()
    {
        if (string.IsNullOrWhiteSpace(_cfgNombre)) return;
        _cfgBusy = true; _cfgMsg = null;
        try
        {
            var http = Auth();
            HttpResponseMessage resp;
            if (_cfgEditId is null)
            {
                resp = await http.PostAsJsonAsync("/api/directorio/etiquetas",
                    new CrearEtiquetaCustomRequest(_cfgNombre.Trim(), _cfgGrupo, _cfgAplica,
                        string.IsNullOrWhiteSpace(_cfgIcono) ? null : _cfgIcono, _cfgColor));
            }
            else
            {
                resp = await http.PutAsJsonAsync($"/api/directorio/etiquetas/{_cfgEditId}",
                    new EditarEtiquetaRequest(_cfgNombre.Trim(),
                        string.IsNullOrWhiteSpace(_cfgIcono) ? null : _cfgIcono, _cfgColor));
            }
            if (resp.IsSuccessStatusCode)
            {
                await CargarEtiquetasAsync();
                await CargarAsync();          // refresca chips en las tarjetas
                ResetCfgForm();
                _cfgMsg = "Etiqueta guardada."; _cfgErr = false;
            }
            else { _cfgMsg = await ErrTxt(resp); _cfgErr = true; }
        }
        catch (Exception ex) { _cfgMsg = ex.Message; _cfgErr = true; }
        finally { _cfgBusy = false; }
    }

    private async Task EliminarEtiqueta(Guid id)
    {
        _cfgBusy = true; _cfgMsg = null;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/directorio/etiquetas/{id}");
            if (resp.IsSuccessStatusCode)
            {
                if (_cfgEditId == id) ResetCfgForm();
                await CargarEtiquetasAsync();
                await CargarAsync();
                _cfgMsg = "Etiqueta eliminada."; _cfgErr = false;
            }
            else { _cfgMsg = await ErrTxt(resp); _cfgErr = true; }
        }
        catch (Exception ex) { _cfgMsg = ex.Message; _cfgErr = true; }
        finally { _cfgBusy = false; }
    }

    private static async Task<string> ErrTxt(HttpResponseMessage resp)
    {
        try { var e = await resp.Content.ReadFromJsonAsync<ErrResp>(); return e?.error ?? "No se pudo completar la accion."; }
        catch { return "No se pudo completar la accion."; }
    }
