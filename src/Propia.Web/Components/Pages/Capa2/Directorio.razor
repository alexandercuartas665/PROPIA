    private string AdjTipoRuta => _detalleTipo == "empresa" ? "Empresa" : "Persona";

    private async Task SetDetalleTabAsync(string tab)
    {
        _detalleTab = tab;
        if (tab == "documentos") await CargarAdjuntosAsync();
    }

    private async Task CargarAdjuntosAsync()
    {
        try { _adjuntos = await Auth().GetFromJsonAsync<List<DirectorioAdjuntoDto>>($"/api/directorio/adjuntos/{AdjTipoRuta}/{_detalleId}") ?? new(); }
        catch { _adjuntos = new(); }
        // Mantener la seleccion del visor viva: si el seleccionado ya no existe, tomar el primero.
        if (_adjSel is null || _adjuntos.All(a => a.Id != _adjSel)) _adjSel = _adjuntos.FirstOrDefault()?.Id;
        StateHasChanged();
    }

    private async Task SubirAdjuntosAsync(InputFileChangeEventArgs e)
    {
        _adjMsg = null; _adjBusy = true;
        StateHasChanged();
        try
        {
            foreach (var f in e.GetMultipleFiles(10))
            {
                if (f.Size > 10_000_000) { _adjMsg = $"\"{f.Name}\" supera 10 MB y no se subio."; continue; }
                using var content = new MultipartFormDataContent();
                var sc = new StreamContent(f.OpenReadStream(maxAllowedSize: 10_000_000));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
                content.Add(sc, "file", f.Name);
                var resp = await Auth().PostAsync($"/api/directorio/adjuntos/{AdjTipoRuta}/{_detalleId}", content);
                if (!resp.IsSuccessStatusCode)
                    _adjMsg = "No se pudo subir \"" + f.Name + "\": " + await MensajeDeError(resp, "revisa el archivo.");
            }
            await CargarAdjuntosAsync();
        }
        catch (Exception ex) { _adjMsg = "Error subiendo archivos: " + ex.Message; }
        finally { _adjBusy = false; StateHasChanged(); }
    }

    private async Task EliminarAdjuntoAsync(Guid id)
    {
