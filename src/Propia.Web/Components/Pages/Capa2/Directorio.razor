    private async Task<List<string>> LeerOrdenAsync(string key, List<string> def)
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", key);
            if (!string.IsNullOrWhiteSpace(raw))
            {
                var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(raw);
                if (list is { Count: > 0 }) return list;
            }
        }
        catch { }
        return def;
    }

