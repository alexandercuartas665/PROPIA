        }
        finally { _adjBusy = false; StateHasChanged(); }
    }

    private static string TamanoLegible(long bytes) => bytes switch
    {
        >= 1_048_576 => $"{bytes / 1_048_576.0:0.#} MB",
        >= 1_024 => $"{bytes / 1_024.0:0.#} KB",
        _ => $"{bytes} B"
    };

    private static bool EsImg(string url)
    {
        // Quitar el ?query (ej. ?v=...) antes de mirar la extension, si no las imagenes con querystring no previsualizan.
        var u = url.ToLowerInvariant().Split('?')[0].TrimEnd();
        return u.EndsWith(".jpg") || u.EndsWith(".jpeg") || u.EndsWith(".png") || u.EndsWith(".webp") || u.EndsWith(".gif") || u.EndsWith(".bmp") || u.EndsWith(".svg");
    }
    private static bool EsPdf(string url) => url.ToLowerInvariant().Split('?')[0].TrimEnd().EndsWith(".pdf");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                try
                {
                    var n = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_copropiedad_nombre");
                    if (!string.IsNullOrWhiteSpace(n)) CopropiedadNombre = n;
                }
                catch { }
                await RestaurarVistaAsync();
                await CargarEtiquetasAsync();
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { /* prerender */ }
    }

    // await (no fire-and-forget) para que Blazor re-renderice al terminar la carga;
