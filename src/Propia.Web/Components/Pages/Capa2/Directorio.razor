    private async Task MoverColDir(int idx, int dir)
    {
        var ord = OrdenActiva;
        var ni = idx + dir;
        if (ni < 0 || ni >= ord.Count) return;
        (ord[idx], ord[ni]) = (ord[ni], ord[idx]);
        await GuardarColsAsync();
    }

