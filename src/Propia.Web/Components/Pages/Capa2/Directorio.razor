    private async Task GuardarEtiqueta()
    {
        if (string.IsNullOrWhiteSpace(_cfgNombre)) return;
        _cfgBusy = true; _cfgMsg = null;
        try
        {
            var http = Auth();
            HttpResponseMessage resp;
            if (_cfgEditId is null)
            {
                resp = await http.PostAsJsonAsync("/api/directorio/etiquetas",
                    new CrearEtiquetaCustomRequest(_cfgNombre.Trim(), _cfgGrupo, _cfgAplica,
                        string.IsNullOrWhiteSpace(_cfgIcono) ? null : _cfgIcono, _cfgColor));
            }
            else
            {
                resp = await http.PutAsJsonAsync($"/api/directorio/etiquetas/{_cfgEditId}",
                    new EditarEtiquetaRequest(_cfgNombre.Trim(),
                        string.IsNullOrWhiteSpace(_cfgIcono) ? null : _cfgIcono, _cfgColor));
            }
            if (resp.IsSuccessStatusCode)
            {
                await CargarEtiquetasAsync();
                await CargarAsync();          // refresca chips en las tarjetas
                ResetCfgForm();
                _cfgMsg = "Etiqueta guardada."; _cfgErr = false;
            }
            else { _cfgMsg = await ErrTxt(resp); _cfgErr = true; }
        }
        catch (Exception ex) { _cfgMsg = ex.Message; _cfgErr = true; }
        finally { _cfgBusy = false; }
    }

