    // Al recargar el board, la hija aparece anidada en modo lista y suma al chip "N sub" en tarjetas.
    private async Task CrearSubtareaRapida()
    {
        if (_cardDraft?.Id is not Guid padreId || _board is null) return;
        var titulo = _subtareaNew?.Trim();
        if (string.IsNullOrWhiteSpace(titulo)) return;
        _busy = true;
        try
        {
            var req = new CrearTareaRequest(
                titulo, null, _cardDraft.Prioridad, _cardDraft.EstadoId,
                null, null, null, padreId, new List<Guid>(), _board.Tablero.Id,
                null, false, null, null, null, null, null,
                new List<Guid>(), new List<SubtareaCheckItem>(), new List<TareaCampoValorDto>());
            var resp = await Auth().PostAsJsonAsync("/api/tareas", req);
            if (resp.IsSuccessStatusCode)
            {
                _subtareaNew = "";
                if (_boardMode == "tablero") _expandidas.Add(padreId);
                await RecargarBoard();   // refresca _board.Tareas -> Hijos(padreId) + chip del padre
            }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _busy = false; }
    }
