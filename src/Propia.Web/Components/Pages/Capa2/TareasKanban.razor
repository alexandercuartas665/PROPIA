    private async Task EtiquetaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CrearEtiquetaInline();
    }

    private async Task CrearEtiquetaInline()
    {
        if (_cardDraft is null || string.IsNullOrWhiteSpace(_nuevaEtiqueta)) return;
        var nombre = _nuevaEtiqueta.Trim();
        // Si ya existe en el catalogo, solo la seleccionamos.
        var existente = _etiquetasCat.FirstOrDefault(x => string.Equals(x.Nombre, nombre, StringComparison.OrdinalIgnoreCase));
        if (existente is not null) { _cardDraft.EtiquetaIds.Add(existente.Id); _nuevaEtiqueta = ""; return; }
        _busy = true;
        try
        {
            var color = _colores[Math.Abs(nombre.GetHashCode()) % _colores.Length];
            var resp = await Auth().PostAsJsonAsync("/api/tareas/etiquetas", new CrearEtiquetaRequest(nombre, color));
            if (resp.IsSuccessStatusCode)
            {
                var nueva = await resp.Content.ReadFromJsonAsync<EtiquetaTareaDto>();
                if (nueva is not null) { _etiquetasCat.Add(nueva); _cardDraft.EtiquetaIds.Add(nueva.Id); _nuevaEtiqueta = ""; }
            }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _busy = false; }
    }

    private string PersonaNombre(Guid id) => _personas?.FirstOrDefault(p => p.Id == id)?.Nombre ?? "Persona";
    private static string RespColor(int idx) => _avaColors[idx % _avaColors.Length];

    private async Task SubirAdjunto(InputFileChangeEventArgs e)
    {
        if (_cardDraft?.Id is null || e.File is null) return;
        _subiendo = true; _msg = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(e.File.OpenReadStream(10_000_000));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType);
            content.Add(sc, "file", e.File.Name);
            var resp = await Auth().PostAsync($"/api/tareas/{_cardDraft.Id}/adjuntos", content);
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<TareaAdjuntoDto>();
                if (dto is not null) _cardDraft.Adjuntos.Add(new AdjuntoVM(dto.Id, dto.Nombre, dto.Url));
            }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _subiendo = false; }
    }

    private async Task EliminarAdjunto(Guid adjuntoId)
    {
        if (_cardDraft?.Id is null) return;
        var resp = await Auth().DeleteAsync($"/api/tareas/{_cardDraft.Id}/adjuntos/{adjuntoId}");
        if (resp.IsSuccessStatusCode) _cardDraft.Adjuntos.RemoveAll(a => a.Id == adjuntoId);
    }

    private static bool EsImg(string url)
    {
        var u = url.ToLowerInvariant();
        return u.EndsWith(".jpg") || u.EndsWith(".jpeg") || u.EndsWith(".png") || u.EndsWith(".webp") || u.EndsWith(".gif");
    }
    private static string FechaHora(DateTimeOffset f)
    {
        var l = f.ToLocalTime();
        return l.ToString("d MMM yyyy, HH:mm", Es);
    }

    private static string Iniciales(string? n)
    {
        var p = (n ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0) return "?";
        if (p.Length == 1) return p[0].Substring(0, Math.Min(2, p[0].Length)).ToUpperInvariant();
        return ("" + p[0][0] + p[1][0]).ToUpperInvariant();
    }
    private static string FechaCorta(DateOnly d)
    {
        var dia = d.ToString("ddd", Es);
        dia = char.ToUpper(dia[0]) + dia.Substring(1);
        return dia + " " + d.Day + " " + d.ToString("MMM", Es);
    }
    private static string PrioFg(PrioridadTarea p) => p switch { PrioridadTarea.Urgente => "#C0383C", PrioridadTarea.Alta => "#B45309", PrioridadTarea.Normal => "#2563EB", _ => "#516F90" };
    private static string PrioBg(PrioridadTarea p) => p switch { PrioridadTarea.Urgente => "#FDE7E7", PrioridadTarea.Alta => "#FEF3DC", PrioridadTarea.Normal => "#E6F2FB", _ => "#EEF3F8" };
