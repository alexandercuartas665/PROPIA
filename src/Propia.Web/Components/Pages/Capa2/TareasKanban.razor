    .tb-row-titbtn { text-align: left; flex: 1; min-width: 0; background: none; border: 0; cursor: pointer; padding: 0; }
    .tb-row-titbtn:hover .tb-row-t { color: #6D4FE3; }
    .tb-row-t { font-size: 13px; font-weight: 600; color: #33475B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
