    // ---- Selector de copropiedad (prototipo v2): cambia el tenant activo sin salir del modulo ----
    private string NombreCopropiedadActiva()
        => (_tenants.FirstOrDefault(t => t.TenantId == _activeTenantId) ?? _tenants.FirstOrDefault())?.Nombre ?? "Copropiedad";

    private void ToggleCoMenu() { if (_tenants.Count > 1) _coMenuOpen = !_coMenuOpen; }

    private async Task SwitchCopropiedadAsync(TenantInfoDto t)
    {
        _coMenuOpen = false;
        if (t.TenantId == _activeTenantId) return;
        _coBusy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/connect/switch-tenant", new SwitchTenantRequestDto(t.TenantId));
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<LoginResponseDto>();
                if (dto is not null)
                {
                    // Persistir el nuevo contexto y recargar el modulo de Tareas re-scopeado al tenant elegido.
                    await Js.InvokeVoidAsync("propiaAuth.save", dto.AccessToken, t.TenantId.ToString(), t.Nombre);
                    Nav.NavigateTo("/tareas", forceLoad: true);
                    return;
                }
            }
        }
        catch { /* error de red: dejamos el menu para reintentar */ }
        finally { _coBusy = false; }
    }

