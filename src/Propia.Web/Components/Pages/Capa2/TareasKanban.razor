    /* Etiquetas en Configurar tablero */
    .tbcfg-tags { display: flex; flex-direction: column; gap: 7px; margin-bottom: 10px; }
    .tbcfg-tag { display: flex; align-items: center; gap: 8px; }
    .tbcfg-tag .tb-tag { position: relative; }
    .tbcfg-tag-glob { font-size: 9px; font-weight: 800; color: #516F90; background: #EEF3F8; border-radius: 5px; padding: 2px 6px; text-transform: uppercase; }
    .tbcfg-tag-cnt { margin-left: auto; font-size: 11px; font-weight: 700; color: #A6B7C8; }
    /* Hint en el modal de tarjeta (las etiquetas ya no se crean ahi) */
    .tbc-tag-hint { margin-top: 8px; font-size: 11.5px; color: #7C98B6; }
    .tbc-linkbtn { border: 0; background: transparent; color: #6D4FE3; font-weight: 700; cursor: pointer; padding: 0; font: inherit; text-decoration: underline; }
    [data-bs-theme="dark"] .tbcfg-tag-glob { background: #232342; color: #C7C7D6; }
    .tbcfg-help { font-size: 11.5px; color: #7C98B6; margin-bottom: 10px; line-height: 1.45; }
    .tbcfg-chips { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
    .tbcfg-chip { display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: #516F90; background: #F5F8FA; border: 1px solid #E1E8EE; padding: 6px 11px; border-radius: 8px; }
    .tbcfg-chip button { display: flex; color: #C3D0DD; border: 0; background: transparent; cursor: pointer; padding: 0; }
    .tbcfg-chip button:hover { color: #D7263D; }

    /* ===== Vista Calendario ===== */
    .tcal { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; box-shadow: 0 1px 2px rgba(45,62,80,.05); overflow: hidden; }
    .tcal-head { display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid #EEF3F8; }
    .tcal-nav { width: 32px; height: 32px; border-radius: 8px; border: 1px solid #E1E8EE; background: #fff; color: #516F90; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .tcal-nav:hover { border-color: #6D4FE3; color: #6D4FE3; }
    .tcal-title { font-size: 15px; font-weight: 800; color: #1B2A3A; min-width: 150px; }
    .tcal-today { font-size: 12px; font-weight: 700; color: #6D4FE3; background: #F1ECFD; border: 1px solid #DCD2F8; border-radius: 8px; padding: 6px 12px; cursor: pointer; }
    .tcal-today:hover { background: #E6DEFA; }
    .tcal-count { font-size: 11.5px; font-weight: 700; color: #6D4FE3; background: #F1ECFD; padding: 4px 11px; border-radius: 20px; }
    .tcal-grid-h { display: grid; grid-template-columns: repeat(7, 1fr); background: #FAFBFC; border-bottom: 1px solid #EEF3F8; }
    .tcal-dow { padding: 8px 10px; font-size: 10.5px; letter-spacing: .4px; font-weight: 700; color: #A6B7C8; }
    .tcal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: #EEF3F8; }
    .tcal-cell { background: #fff; min-height: 106px; display: flex; flex-direction: column; padding: 6px 7px; }
    .tcal-cell.tcal-finde { background: #FBFCFD; }
    .tcal-cell.tcal-out { background: #FAFBFC; }
    .tcal-cell.tcal-out .tcal-daynum { color: #C3D0DD; }
    .tcal-daynum { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11.5px; font-weight: 800; color: #33475B; align-self: flex-end; }
    .tcal-daynum.tcal-hoy { background: #6D4FE3; color: #fff; }
    .tcal-events { display: flex; flex-direction: column; gap: 4px; margin-top: 3px; min-width: 0; }
    .tcal-ev { display: block; width: 100%; text-align: left; font-size: 10.5px; font-weight: 700; color: #33475B; line-height: 1.25; background: #F8FAFC; border: 0; border-left: 3px solid #6D4FE3; border-radius: 6px; padding: 4px 7px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tcal-ev:hover { background: #F1ECFD; }
    .tcal-ev.venc { background: #FDE7E7; color: #C0383C; }
    .tcal-more { font-size: 9.5px; color: #A6B7C8; font-weight: 700; padding-left: 3px; }
    .tcal-modes { display: flex; align-items: center; gap: 2px; background: #F1F5F9; border: 1px solid #E1E8EE; border-radius: 9px; padding: 3px; }
    .tcal-mode { padding: 6px 13px; border-radius: 7px; font-size: 12px; font-weight: 700; color: #7C98B6; background: transparent; border: 0; cursor: pointer; }
    .tcal-mode.on { color: #6D4FE3; background: #fff; box-shadow: 0 1px 2px rgba(45,62,80,.12); }
    /* vista semana */
    .tcal-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: #EEF3F8; }
    .tcal-wcol { background: #fff; min-height: 220px; display: flex; flex-direction: column; }
    .tcal-whead { padding: 9px 10px; border-bottom: 1px solid #EEF3F8; background: #FAFBFC; }
    .tcal-whead.hoy { background: #F1ECFD; }
    .tcal-wdow { font-size: 10px; font-weight: 700; color: #A6B7C8; letter-spacing: .3px; }
    .tcal-wnum { font-size: 15px; font-weight: 800; color: #1B2A3A; }
    .tcal-whead.hoy .tcal-wnum { color: #6D4FE3; }
    .tcal-wmes { font-size: 10px; color: #A6B7C8; font-weight: 600; }
    .tcal-wbody { padding: 8px; display: flex; flex-direction: column; gap: 6px; }
    .tcal-wev { display: block; width: 100%; text-align: left; border: 1px solid #E1E8EE; border-left: 3px solid #6D4FE3; border-radius: 8px; padding: 7px 9px; background: #fff; cursor: pointer; }
    .tcal-wev:hover { border-color: #6D4FE3; background: #FBFAFE; }
    .tcal-wev-t { font-size: 11.5px; font-weight: 700; color: #33475B; line-height: 1.3; }
    .tcal-wev-r { font-size: 10px; color: #A6B7C8; margin-top: 2px; }
    .tcal-wempty { font-size: 10.5px; color: #C3D0DD; text-align: center; padding: 14px 0; }

    /* ===== Vista Gantt ===== */
    .tg { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; box-shadow: 0 1px 2px rgba(45,62,80,.05); overflow: hidden; }
    .tg-titlebar { display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid #EEF3F8; }
    .tg-title { font-size: 15px; font-weight: 800; color: #1B2A3A; }
    .tg-scroll { overflow-x: auto; }
    .tg-inner { min-width: 100%; }
    .tg-row { display: flex; align-items: stretch; border-bottom: 1px solid #F4F7FA; }
    .tg-row:last-child { border-bottom: 0; }
    .tg-head { background: #FAFBFC; border-bottom: 1px solid #EEF3F8; position: sticky; top: 0; z-index: 3; }
    .tg-left { width: 240px; flex-shrink: 0; position: sticky; left: 0; z-index: 2; background: #fff; border-right: 1px solid #EEF3F8; display: flex; align-items: center; gap: 8px; padding: 0 12px; }
    .tg-head-left { background: #FAFBFC; font-size: 10.5px; letter-spacing: .4px; font-weight: 700; color: #A6B7C8; padding: 10px 12px; }
    .tg-task { text-align: left; border: 0; cursor: pointer; min-height: 40px; }
    .tg-task:hover .tg-task-t { color: #6D4FE3; }
    .tg-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .tg-task-t { font-size: 12.5px; font-weight: 600; color: #33475B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tg-task-btn { flex: 1; min-width: 0; text-align: left; background: none; border: 0; cursor: pointer; padding: 0; overflow: hidden; }
    .tg-task-btn:hover .tg-task-t { color: #6D4FE3; }
    .tg-exp { width: 18px; height: 18px; flex-shrink: 0; border-radius: 5px; display: flex; align-items: center; justify-content: center; color: #6D4FE3; background: #F1ECFD; border: 0; cursor: pointer; padding: 0; }
    .tg-exp:hover { background: #E6DEFA; }
    .tg-exp-sp { width: 18px; flex-shrink: 0; display: inline-block; }
    .tg-time { display: flex; position: relative; }
    .tg-daycol { flex-shrink: 0; padding: 5px 0; text-align: center; border-right: 1px solid #F4F7FA; }
    .tg-daycol.tg-we { background: #FBFCFD; }
    .tg-daycol.tg-today { background: #F1ECFD; }
    .tg-dow { font-size: 8.5px; letter-spacing: .3px; font-weight: 700; color: #A6B7C8; text-transform: uppercase; }
    .tg-dnum { font-size: 11px; font-weight: 700; color: #516F90; margin-top: 1px; }
    .tg-dnum-hoy { color: #6D4FE3; }
    .tg-lane { min-height: 40px; }
    .tg-cell { flex-shrink: 0; border-right: 1px solid #F4F7FA; }
    .tg-cell.tg-we { background: #FBFCFD; }
    .tg-cell.tg-today { background: #F5F1FE; }
    .tg-bar { position: absolute; top: 8px; height: 24px; border-radius: 7px; border: 0; cursor: pointer; overflow: hidden; display: flex; align-items: center; box-shadow: 0 1px 3px rgba(27,42,58,.18); }
    .tg-bar:hover { filter: brightness(1.05); }
    .tg-bar-cl { border-top-left-radius: 0; border-bottom-left-radius: 0; } /* recortada por la izquierda (continua antes) */
    .tg-bar-cr { border-top-right-radius: 0; border-bottom-right-radius: 0; } /* recortada por la derecha (continua despues) */
    .tg-bar-rest { position: absolute; top: 0; bottom: 0; right: 0; background: rgba(255,255,255,.5); }
    .tg-bar-lbl { position: relative; z-index: 1; font-size: 10.5px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 8px; text-shadow: 0 1px 1px rgba(0,0,0,.15); }
    .tg-note { font-size: 11.5px; color: #A6B7C8; padding: 11px 18px; border-top: 1px solid #EEF3F8; background: #FBFCFD; }

    @@media (max-width: 880px) { .tcal-cell { min-height: 76px; } }
    @@media (max-width: 880px) { .tbc-body { grid-template-columns: 1fr; grid-template-rows: none; overflow-y: auto; } .tbc-col { overflow: visible; min-height: auto; padding-right: 0; } .tbc-act-cols { grid-template-columns: 1fr; } .tbc-col-act { border-left: 0; padding-left: 0; border-top: 1px solid #EEF3F8; padding-top: 14px; } .tbc-files { flex-direction: column; } .tbc-thumbs { width: auto; flex-direction: row; flex-wrap: wrap; } .tbc-viewer { min-height: 320px; } }
    /* ----- Campos personalizados: lista (columnas) ----- */
    .tb-lc-due { flex: 0 0 100px; min-width: 100px; }
    .tb-row-due { flex: 0 0 100px; min-width: 100px; }
    .tb-lc-campo { width: 120px; flex-shrink: 0; }
    .tb-row-campo { width: 120px; flex-shrink: 0; font-size: 12px; color: #516F90; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* Columnas numericas (Valor + campos Numero/Moneda): alineadas a la derecha, digitos tabulares y un poco mas anchas. */
    .tb-lc-campo.tb-num, .tb-row-campo.tb-num { width: 132px; }
    .tb-num { text-align: right; font-variant-numeric: tabular-nums; }
    .tb-num .tb-editable { text-align: right; }
    .tb-num .tb-cell-inp, .tb-num .tb-nf-inp { text-align: right; }
    .tb-lc.tb-num { justify-content: flex-end; }

    /* ----- Campos personalizados: modal de tarjeta ----- */
    .tbc-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
    .tbc-campos-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
    .tbc-addcampo { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: var(--propia-brand, #6D4FE3); border: 1px solid #DCD2F8; background: #F5F1FE; border-radius: 8px; padding: 4px 9px; cursor: pointer; font-family: inherit; }
    .tbc-addcampo:hover { background: #EDE7FD; }
    .tbc-campoeditor { margin-bottom: 10px; border: 1px solid #DCD2F8; border-radius: 10px; padding: 10px; background: #FBFAFE; display: flex; flex-direction: column; gap: 8px; }
    .tbc-campo { display: flex; flex-direction: column; gap: 4px; }
    .tbc-campo.full { grid-column: 1 / -1; }
    .tbc-campo-lbl { font-size: 11px; font-weight: 700; color: #516F90; }
    /* Lapiz para editar la DEFINICION del campo (nombre/tipo/opciones), desde la ficha y la parrilla. */
    .tbc-campo-lblrow { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
    .tbc-campo-ed2 { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border: 0; background: transparent; color: #A6B7C8; cursor: pointer; border-radius: 5px; opacity: .5; flex-shrink: 0; font-family: inherit; }
    .tbc-campo-ed2:hover { color: var(--propia-brand, #6D4FE3); background: #F1ECFD; opacity: 1; }
    .tbc-campo-acts { display: flex; align-items: center; gap: 1px; flex-shrink: 0; }
    .tbc-campo-mv { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border: 0; background: transparent; color: #A6B7C8; cursor: pointer; border-radius: 5px; opacity: .5; font-family: inherit; }
    .tbc-campo-mv:hover { color: var(--propia-brand, #6D4FE3); background: #F1ECFD; opacity: 1; }
    .tbc-campo-del { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border: 0; background: transparent; color: #A6B7C8; cursor: pointer; border-radius: 5px; opacity: .5; flex-shrink: 0; font-family: inherit; }
    .tbc-campo-del:hover { color: #D7263D; background: #FDE7E7; opacity: 1; }
    .tb-lc-ed { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border: 0; background: transparent; color: #A6B7C8; cursor: pointer; border-radius: 4px; opacity: 0; margin-left: 4px; vertical-align: middle; }
    .tb-lc-campo:hover .tb-lc-ed { opacity: .7; }
    .tb-lc-ed:hover { color: var(--propia-brand, #6D4FE3); opacity: 1; }
    .tbc-req { color: #D7263D; font-weight: 800; }
    .tbc-sep { display: flex; align-items: center; justify-content: space-between; gap: 6px; font-size: 11px; font-weight: 800; letter-spacing: .4px; color: var(--propia-brand, #6D4FE3); text-transform: uppercase; border-top: 1px solid #E1E8EE; padding-top: 9px; margin-top: 4px; }
    .tbc-total { background: #F3EFFE; font-weight: 700; color: #33475B; }
    .tbc-cardmsg { font-size: 12px; font-weight: 600; color: #D7263D; align-self: center; margin-right: 8px; }
    .tbcfg-suma { border: 1px solid #E1E8EE; border-radius: 8px; padding: 8px 10px; display: flex; flex-direction: column; gap: 4px; }
    .tbcfg-suma-h { font-size: 10.5px; font-weight: 700; letter-spacing: .3px; color: #90A4B7; }
    .tbcfg-suma-empty { font-size: 11.5px; color: #A6B7C8; }
    .tbc-campo input, .tbc-campo select, .tbc-campo textarea { border: 1px solid #E1E8EE; border-radius: 8px; padding: 7px 9px; font-size: 12.5px; color: #33475B; outline: none; background: #fff; box-sizing: border-box; width: 100%; font-family: inherit; }
    .tbc-campo input:focus, .tbc-campo select:focus, .tbc-campo textarea:focus { border-color: #6D4FE3; }
    .tbc-campo-bool { display: flex; align-items: center; gap: 7px; font-size: 12.5px; color: #516F90; font-weight: 600; }
    .tbc-campo-bool input { width: auto; }

    /* ----- Editor de campos en Configurar tablero ----- */
    .tbcfg-campos { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
    .tbcfg-campo { display: flex; align-items: center; gap: 8px; padding: 8px 11px; border: 1px solid #E1E8EE; border-radius: 9px; background: #fff; }
    .tbcfg-campo.on { border-color: #6D4FE3; background: #F5F1FE; }
    .tbcfg-campo-id { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .tbcfg-campo-nom { font-size: 13px; font-weight: 700; color: #33475B; }
    .tbcfg-campo-tipo { font-size: 10px; font-weight: 700; color: #6D4FE3; background: #F1ECFD; padding: 2px 8px; border-radius: 6px; }
    .tbcfg-campo-filt { font-size: 10px; font-weight: 700; color: #1A8754; background: #E6F6EE; padding: 2px 8px; border-radius: 6px; }
    .tbcfg-campo-ed { width: 28px; height: 28px; flex-shrink: 0; border-radius: 7px; display: flex; align-items: center; justify-content: center; color: #A6B7C8; border: 1px solid #E1E8EE; background: #fff; cursor: pointer; }
    .tbcfg-campo-ed:hover { color: #6D4FE3; border-color: #6D4FE3; }
    /* Campos archivados (retirados sin perder datos) */
    .tbcfg-arch { margin-top: 12px; border: 1px dashed #D7E0EA; border-radius: 10px; padding: 11px 12px; background: #F8FAFC; }
    .tbcfg-arch-h { font-size: 11px; letter-spacing: .5px; color: #A6B7C8; font-weight: 700; margin-bottom: 6px; }
    .tbcfg-arch-h span { color: #7C98B6; }
    .tbcfg-arch-it { display: flex; align-items: center; gap: 8px; padding: 6px 4px; border-top: 1px solid #EEF3F8; }
    .tbcfg-arch-it:first-of-type { border-top: 0; }
    .tbcfg-arch-restore { font-size: 12px; font-weight: 700; color: #6D4FE3; border: 1px solid #DCD2F8; background: #F1ECFD; border-radius: 8px; padding: 5px 12px; cursor: pointer; flex-shrink: 0; }
    .tbcfg-arch-restore:hover { background: #E6DEFA; }
    .tbcfg-editor { border: 1px dashed #D7E0EA; border-radius: 10px; padding: 12px; background: #FBFCFD; display: flex; flex-direction: column; gap: 8px; }
    .tbcfg-editor-h { font-size: 11px; font-weight: 800; letter-spacing: .3px; color: #7C98B6; }
    .tbcfg-erow { display: flex; gap: 8px; align-items: center; }
    .tbcfg-erow-end { justify-content: flex-end; }
    .tbcfg-in { flex: 1; min-width: 0; border: 1px solid #E1E8EE; border-radius: 8px; padding: 8px 10px; font-size: 12.5px; color: #33475B; outline: none; background: #fff; box-sizing: border-box; font-family: inherit; }
    .tbcfg-in:focus { border-color: #6D4FE3; }
    .tbcfg-in-sm { flex: 0 0 160px; }
    .tbcfg-chkl { display: flex; align-items: center; gap: 7px; font-size: 12px; color: #516F90; font-weight: 600; flex: 1; }
    /* Editor de campo flotante + boton "+ Campo" del encabezado de la tabla */
    /* Editor de campo como POPOVER anclado al boton (nace del boton, con flechita). */
    .tbfld-bd { position: fixed; inset: 0; z-index: 1118; background: transparent; }
    .tbfld-pop { position: fixed; z-index: 1120; width: 360px; max-width: calc(100vw - 24px); background: #fff; border: 1px solid #E6ECF1; border-radius: 13px; box-shadow: 0 18px 50px rgba(27,42,58,.28); display: flex; flex-direction: column; overflow: hidden; transform-origin: top right; animation: tbfldIn .12s ease-out; }
    .tbfld-pop::before { content: ''; position: absolute; top: -7px; right: 18px; width: 13px; height: 13px; background: #fff; border-left: 1px solid #E6ECF1; border-top: 1px solid #E6ECF1; transform: rotate(45deg); }
    .tbfld-pop-up { transform-origin: bottom right; animation: tbfldInUp .12s ease-out; }
    .tbfld-pop-up::before { top: auto; bottom: -7px; border-left: none; border-top: none; border-right: 1px solid #E6ECF1; border-bottom: 1px solid #E6ECF1; }
    @@keyframes tbfldIn { from { opacity: 0; transform: translateY(-6px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @@keyframes tbfldInUp { from { opacity: 0; transform: translateY(6px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .tbfld-pop-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; border-bottom: 1px solid #F1F4F7; font-size: 13.5px; font-weight: 800; color: #1B2A3A; flex-shrink: 0; }
    .tbfld-x { width: 26px; height: 26px; border-radius: 7px; display: flex; align-items: center; justify-content: center; border: 1px solid #E1E8EE; background: #fff; color: #7C98B6; cursor: pointer; flex-shrink: 0; }
    .tbfld-x:hover { border-color: #6D4FE3; color: #6D4FE3; }
    .tbfld-pop-b { padding: 13px 14px; overflow-y: auto; display: flex; flex-direction: column; gap: 11px; }
    .tbfld-pop-f { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding: 11px 14px; border-top: 1px solid #F1F4F7; flex-shrink: 0; }
    .tbfld-field { display: flex; flex-direction: column; gap: 4px; }
    .tbfld-lbl { font-size: 11px; font-weight: 700; color: #516F90; letter-spacing: .2px; }
    .tb-hdr-addcampo { display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; font-weight: 700; color: var(--propia-brand, #6D4FE3); border: 1px solid #DCD2F8; background: #F5F1FE; border-radius: 6px; padding: 2px 7px; cursor: pointer; font-family: inherit; }
    .tb-hdr-addcampo:hover { background: #EDE7FD; }

    /* ============================================================================
       TEMA OSCURO del area de trabajo de Tareas.
       El resto de la app activa el modo oscuro con html[data-bs-theme="dark"]
       (ver wwwroot/js/propia-ui.js). Aqui reescribimos los fondos/contraste de las
