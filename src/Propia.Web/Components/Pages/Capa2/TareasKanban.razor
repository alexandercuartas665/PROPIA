    .tb-icon-btn { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #516F90; border: 1px solid #E1E8EE; background: #fff; flex-shrink: 0; cursor: pointer; margin-top: 3px; }
    .tb-icon-btn:hover { border-color: #6D4FE3; color: #6D4FE3; }
    .tb-board-color { width: 8px; height: 38px; border-radius: 5px; flex-shrink: 0; margin-top: 3px; }
    .tb-board-id { flex: 1; min-width: 0; }
    .tb-board-nom { font-size: 24px; font-weight: 800; letter-spacing: -.5px; color: #1B2A3A; margin: 0; }
    .tb-board-desc { font-size: 13px; color: #7C98B6; margin: 2px 0 0; }
    .tb-modeswitch { display: flex; align-items: center; gap: 2px; background: #F1F5F9; border: 1px solid #E1E8EE; border-radius: 9px; padding: 3px; flex-shrink: 0; margin-top: 3px; }
    .tb-mode { display: flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 7px; font-size: 12px; font-weight: 700; color: #7C98B6; background: transparent; border: 0; cursor: pointer; }
    .tb-mode.on { color: #6D4FE3; background: #fff; box-shadow: 0 1px 2px rgba(45,62,80,.12); }

    .tb-kanban { display: grid; gap: 13px; align-items: start; overflow-x: auto; padding-bottom: 8px; }
    .tb-col { background: #F8FAFC; border: 1px solid #ECEEF2; border-radius: 14px; padding: 12px; }
    .tb-col-head { display: flex; align-items: center; gap: 8px; padding: 4px 6px 12px; }
    .tb-col-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .tb-col-nom { font-size: 13px; font-weight: 700; color: #33475B; flex: 1; }
    .tb-col-count { font-size: 11.5px; font-weight: 700; color: #7C98B6; background: #fff; border: 1px solid #E1E8EE; padding: 1px 8px; border-radius: 20px; }
    .tb-col-body { display: flex; flex-direction: column; gap: 9px; }
    .tb-tcard { display: block; width: 100%; text-align: left; background: #fff; border: 1px solid #E1E8EE; border-left: 3px solid #6D4FE3; border-radius: 11px; padding: 12px 13px; box-shadow: 0 1px 2px rgba(45,62,80,.04); cursor: pointer; }
    .tb-tcard:hover { border-color: #6D4FE3; box-shadow: 0 6px 16px rgba(109,79,227,.12); }
    .tb-tcard-tit { font-size: 13px; font-weight: 700; color: #33475B; line-height: 1.35; }
    .tb-tcard-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; }
    .tb-prio { font-size: 10.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px; }
    .tb-due { font-size: 11px; color: #A6B7C8; }
    .tb-due.venc { color: #C0383C; font-weight: 700; }
    .tb-tcard-foot { display: flex; align-items: center; gap: 8px; margin-top: 9px; padding-top: 9px; border-top: 1px solid #F4F7FA; }
    .tb-tcard-resp { font-size: 11px; color: #7C98B6; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tb-chip { font-size: 10px; font-weight: 700; color: #6D4FE3; background: #F1ECFD; padding: 2px 7px; border-radius: 6px; }
    .tb-col-add { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; padding: 9px; border-radius: 9px; border: 1px dashed #D7E0EA; background: transparent; color: #A6B7C8; font-size: 11.5px; font-weight: 700; cursor: pointer; }
    .tb-col-add:hover { border-color: #6D4FE3; color: #6D4FE3; background: #F5F1FE; }

    .tb-filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .tb-filter { font-size: 12px; font-weight: 600; color: #516F90; border: 1px solid #E1E8EE; border-radius: 9px; padding: 7px 10px; background: #fff; outline: none; }
    .tb-filter:focus { border-color: #6D4FE3; }
    .tb-filter-clear { font-size: 12px; font-weight: 700; color: #C0383C; padding: 7px 10px; border-radius: 9px; border: 0; background: transparent; cursor: pointer; }
    .tb-filter-clear:hover { background: #FDE7E7; }
    .tb-filter-btn { display: flex; align-items: center; gap: 6px; padding: 7px 11px; border-radius: 9px; border: 1px solid #E1E8EE; background: #fff; font-size: 12px; font-weight: 700; color: #516F90; cursor: pointer; }
