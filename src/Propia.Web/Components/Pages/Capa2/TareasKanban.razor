    // ---- Invitar externo al tablero (crea cuenta + acceso, envia correo) ----
    private record RolMini(Guid Id, string Nombre);
    private record InvitacionResultMini(string LinkAceptacion);
    private List<RolMini> _rolesInv = new();
    private string _extEmail = "";
    private string _extNombre = "";
    private string _extRolId = "";
    private bool _extBusy;
    private bool _extError;
    private string? _extMsg;
    private string? _extLink;

    private async Task InvitarExterno()
    {
        if (_tableroDraft?.Id is not Guid tableroId) return;
        var email = _extEmail?.Trim() ?? "";
        var nombre = _extNombre?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@') || string.IsNullOrWhiteSpace(nombre))
        {
            _extError = true; _extMsg = "Completa un correo valido y el nombre."; return;
        }
        if (!Guid.TryParse(_extRolId, out var rolId))
        {
            _extError = true; _extMsg = "Selecciona un rol para el invitado."; return;
        }
        _extBusy = true; _extError = false; _extMsg = null; _extLink = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync(
                $"/api/tareas/tableros/{tableroId}/invitar-externo",
                new { Email = email, Nombre = nombre, RolId = rolId });
            if (resp.IsSuccessStatusCode)
            {
                var inv = await resp.Content.ReadFromJsonAsync<InvitacionResultMini>();
                _extLink = Nav.BaseUri.TrimEnd('/') + (inv?.LinkAceptacion ?? "");
                _extMsg = $"Invitacion enviada por correo a {email}.";
                _extError = false;
                _extEmail = ""; _extNombre = "";
            }
            else
            {
                _extError = true;
                var body = await resp.Content.ReadAsStringAsync();
                _extMsg = "No se pudo invitar. " + body;
            }
        }
        catch (Exception ex) { _extError = true; _extMsg = "Error: " + ex.Message; }
        finally { _extBusy = false; }
    }

    private async Task CopiarLinkExt()
    {
        if (string.IsNullOrEmpty(_extLink)) return;
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", _extLink); } catch { }
    }
    private async Task GuardarTablero()
    {
        if (_tableroDraft is null || string.IsNullOrWhiteSpace(_tableroDraft.Nombre)) return;
        _busy = true;
        try
        {
            var req = new GuardarTableroRequest(_tableroDraft.Nombre.Trim(), _tableroDraft.Descripcion, _tableroDraft.Color, _tableroDraft.UsuarioIds.ToList());
            var resp = _tableroDraft.Id is null
                ? await Auth().PostAsJsonAsync("/api/tareas/tableros", req)
                : await Auth().PutAsJsonAsync($"/api/tareas/tableros/{_tableroDraft.Id}", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _tableroDraft = null;
            await CargarAsync();
            await RecargarBoard();
        }
        finally { _busy = false; }
    }
    private async Task EliminarTablero()
    {
        if (_tableroDraft?.Id is null) return;
        if (!await Js.InvokeAsync<bool>("confirm", "Eliminar este tablero? Sus tarjetas se conservan pero el tablero deja de mostrarse.")) return;
        var resp = await Auth().DeleteAsync($"/api/tareas/tableros/{_tableroDraft.Id}");
        if (resp.IsSuccessStatusCode) { _tableroDraft = null; _board = null; await CargarAsync(); }
    }

