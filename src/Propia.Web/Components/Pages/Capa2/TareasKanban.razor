    // Torre derivada de la unidad relacionada: toma el prefijo antes del primer separador (- , / #).
    private string TorreDeTarea(TareaListaDto t)
    {
        if (t.OrigenTipo != "inmueble" || string.IsNullOrWhiteSpace(t.OrigenReferencia)) return "Sin torre";
        var s = t.OrigenReferencia!.Trim();
        var idx = s.IndexOfAny(new[] { '-', ',', '/', '#' });
        var pre = idx > 0 ? s.Substring(0, idx).Trim() : s;
        return string.IsNullOrWhiteSpace(pre) ? "Sin torre" : pre;
    }
    // Funcion de clave de agrupacion segun _cardGroup (compartida por Tablero y Lista).
    private Func<TareaListaDto, string> ClaveGrupo() => _cardGroup switch
    {
        "prioridad" => t => t.Prioridad.ToString(),
        "responsable" => t => string.IsNullOrWhiteSpace(t.AsignadoNombre) ? "Sin responsable" : t.AsignadoNombre!,
        "torre" => t => TorreDeTarea(t),
        "unidad" => t => (t.OrigenTipo == "inmueble" && !string.IsNullOrWhiteSpace(t.OrigenReferencia)) ? t.OrigenReferencia! : "Sin unidad",
        "relacionado" => t => string.IsNullOrWhiteSpace(t.OrigenReferencia) ? "Sin relacion" : t.OrigenReferencia!,
        _ => t => t.EstadoNombre
    };
    // Tablero (tarjetas): agrupa las raices sin aplicar filtros (la vista tarjetas no tiene filtros).
    private List<(string Key, List<TareaListaDto> Items)> AgruparCards()
        => _tareas.Where(t => t.PadreId == null).GroupBy(ClaveGrupo())
            .Select(g => (Key: g.Key, Items: AplicarSort(g.ToList()).ToList()))
            .OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
    // Lista: agrupa por la dimension elegida aplicando filtros y orden (para la vista tabla).
    private List<(string Key, List<TareaListaDto> Items)> AgruparLista()
        => _tareas.Where(t => t.PadreId == null).Where(PasaFiltros).GroupBy(ClaveGrupo())
            .Select(g => (Key: g.Key, Items: AplicarSort(g.ToList()).ToList()))
            .OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();

    // ---- Tiempo en el estado actual (indicador de tarjeta + tooltip en lista/calendario/gantt) ----
    private static string TiempoRelativo(DateTimeOffset? desde)
    {
        if (desde is null) return "";
        var span = DateTimeOffset.UtcNow - desde.Value;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        int dias = (int)span.TotalDays;
        if (dias >= 365) { int y = dias / 365; return y + (y == 1 ? " ano" : " anos"); }
        if (dias >= 30) { int m = dias / 30; return m + (m == 1 ? " mes" : " meses"); }
        if (dias >= 7) { int w = dias / 7; return w + " sem"; }
        if (dias >= 1) return dias + (dias == 1 ? " dia" : " dias");
        int horas = (int)span.TotalHours;
        if (horas >= 1) return horas + " h";
        int min = (int)span.TotalMinutes;
        if (min >= 1) return min + " min";
        return "ahora";
    }
    private string TiempoEnEstado(TareaListaDto t) => TiempoRelativo(t.EstadoDesde);
    private string TooltipEstado(TareaListaDto t)
    {
        var rel = TiempoEnEstado(t);
        if (string.IsNullOrEmpty(rel)) return $"En \"{t.EstadoNombre}\"";
        var frase = rel == "ahora" ? "hace un momento" : $"hace {rel}";
        return $"En \"{t.EstadoNombre}\" {frase}";
    }

    private bool _pinTitulo; private bool _colsMenu;
    private bool _colResp = true; private bool _colEtiq = true; private bool _colPrio = true; private bool _colDue = true;
    private bool _colValor = true; private bool _colDesc = true; private bool _colOrigen = true;

    // Visibilidad por campo dinamico del tablero. Se guarda el set de OCULTOS (vacio = todos
    // visibles), para conservar el comportamiento previo (los campos siempre se mostraban).
    private HashSet<Guid> _colsCampoOcultos = new();
    private IEnumerable<TableroCampoDto> CamposDelTablero => _board?.Tablero.Campos ?? new List<TableroCampoDto>();
    private IEnumerable<TableroCampoDto> CamposVisibles => CamposDelTablero.Where(c => c.Tipo != TipoCampoTablero.Separador && CampoColVisible(c.Id));
    private bool CampoColVisible(Guid id) => !_colsCampoOcultos.Contains(id);
    private async Task ToggleCampoCol(Guid id) { if (!_colsCampoOcultos.Remove(id)) _colsCampoOcultos.Add(id); await PersistColsAsync(); }
    private async Task ToggleColFijo(string key)
    {
        switch (key)
        {
            case "resp": _colResp = !_colResp; break;
            case "etiq": _colEtiq = !_colEtiq; break;
            case "prio": _colPrio = !_colPrio; break;
            case "due": _colDue = !_colDue; break;
            case "desc": _colDesc = !_colDesc; break;
            case "valor": _colValor = !_colValor; break;
            case "orig": _colOrigen = !_colOrigen; break;
            case "pin": _pinTitulo = !_pinTitulo; break;
        }
        await PersistColsAsync();
    }
    private async Task ColsTodos()
    {
        _colResp = _colEtiq = _colPrio = _colDue = _colDesc = _colValor = _colOrigen = true;
        _colsCampoOcultos.Clear();
        await PersistColsAsync();
    }
    private async Task ColsNinguno()
    {
        _colResp = _colEtiq = _colPrio = _colDue = _colDesc = _colValor = _colOrigen = false;
        _colsCampoOcultos = CamposDelTablero.Select(c => c.Id).ToHashSet();
        await PersistColsAsync();
    }

    // Persistencia de la config de columnas POR TABLERO en localStorage. Cada tablero tiene sus
    // propios campos dinamicos, asi que la config va llaveada por su Id (propia_tb_cols_<id>).
    // Sobrevive recarga y cierre de sesion (el logout solo borra llaves puntuales).
    private sealed record ColsCfg(bool Resp, bool Etiq, bool Prio, bool Due, bool Desc, bool Valor, bool Orig, bool Pin, List<Guid> Ocultos, List<string>? Orden = null);
    private static string ColsKey(Guid tableroId) => $"propia_tb_cols_{tableroId}";
    private void ColsReset()   // defaults: todo visible, titulo sin fijar
    {
        _colResp = _colEtiq = _colPrio = _colDue = _colDesc = _colValor = _colOrigen = true;
        _pinTitulo = false;
        _colsCampoOcultos = new();
        _colOrden = new();
    }
    private async Task PersistColsAsync()
    {
        if (_board is null) return;
        var cfg = new ColsCfg(_colResp, _colEtiq, _colPrio, _colDue, _colDesc, _colValor, _colOrigen, _pinTitulo, _colsCampoOcultos.ToList(), _colOrden.ToList());
        try { await Js.InvokeVoidAsync("localStorage.setItem", ColsKey(_board.Tablero.Id), System.Text.Json.JsonSerializer.Serialize(cfg)); } catch { }
    }
    private async Task RestaurarColsAsync()
    {
        if (_board is null) return;
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", ColsKey(_board.Tablero.Id));
            var cfg = string.IsNullOrEmpty(raw) ? null : System.Text.Json.JsonSerializer.Deserialize<ColsCfg>(raw);
            if (cfg is null) { ColsReset(); return; }   // sin config guardada: defaults del tablero
            _colResp = cfg.Resp; _colEtiq = cfg.Etiq; _colPrio = cfg.Prio; _colDue = cfg.Due;
            _colDesc = cfg.Desc; _colValor = cfg.Valor; _colOrigen = cfg.Orig; _pinTitulo = cfg.Pin;
            _colsCampoOcultos = cfg.Ocultos?.ToHashSet() ?? new();
            _colOrden = cfg.Orden?.ToList() ?? new();
        }
        catch { ColsReset(); }
    }

    // ---- Orden de columnas (vista Lista): reordenable via flechas; se aplica por CSS `order`, sin tocar el markup ----
    private List<string> _colOrden = new();
    private static readonly string[] ClavesBaseOrden = { "desc", "est", "resp", "prog", "etiq", "prio", "due", "valor", "orig" };
    private List<string> ClavesReordenables()
    {
        var claves = ClavesBaseOrden.ToList();
        claves.AddRange(CamposDelTablero
            .Where(c => c.Tipo != TipoCampoTablero.Separador && c.Tipo != TipoCampoTablero.Total)
            .Select(c => c.Id.ToString()));
        return claves;
    }
    // Deja _colOrden con exactamente las claves validas actuales: conserva el orden guardado y anexa las nuevas.
    private void ReconciliarOrden()
    {
        var validas = ClavesReordenables();
        var nuevo = _colOrden.Where(validas.Contains).ToList();
        nuevo.AddRange(validas.Where(k => !nuevo.Contains(k)));
        _colOrden = nuevo;
    }
    private void MoverColumna(int idx, int dir)
    {
        int j = idx + dir;
        if (idx < 0 || idx >= _colOrden.Count || j < 0 || j >= _colOrden.Count) return;
        (_colOrden[idx], _colOrden[j]) = (_colOrden[j], _colOrden[idx]);
        _ = PersistColsAsync();
    }
    private static bool ColKeyBloqueada(string key) => key is "est" or "prog";  // Etapa y Progreso no se pueden ocultar
    private bool ColKeyVisible(string key) => key switch
    {
        "desc" => _colDesc, "est" => true, "resp" => _colResp, "prog" => true,
        "etiq" => _colEtiq, "prio" => _colPrio, "due" => _colDue, "valor" => _colValor, "orig" => _colOrigen,
        _ => Guid.TryParse(key, out var g) && CampoColVisible(g)
    };
    private async Task ToggleColKey(string key)
    {
        if (Guid.TryParse(key, out var g)) await ToggleCampoCol(g);
        else await ToggleColFijo(key);
    }
    private string ColKeyLabel(string key) => key switch
    {
        "desc" => "Descripcion", "est" => "Etapa", "resp" => "Asignado", "prog" => "Progreso",
        "etiq" => "Etiquetas", "prio" => "Prioridad", "due" => "Vence", "valor" => "Valor", "orig" => "Relacionado con",
        _ => (Guid.TryParse(key, out var g) ? CamposDelTablero.FirstOrDefault(c => c.Id == g)?.Label : null) ?? key
    };
    // <style> con el `order` de flexbox de cada columna (encabezado + filas + totales) segun _colOrden.
    private MarkupString ColumnOrderCss
    {
        get
        {
            var sb = new System.Text.StringBuilder("<style>");
            sb.Append(".tb-list .tb-lc-tit,.tb-list .tb-row-tit{order:0 !important;}");
            int i = 1;
            foreach (var key in _colOrden)
            {
                var sel = ColSelectores(key);
                if (sel is null) continue;
                sb.Append(sel).Append("{order:").Append(i).Append(" !important;}");
                i++;
            }
            sb.Append(".tb-list .tb-lc-acc,.tb-list .tb-row-acc{order:9999 !important;}");
            sb.Append("</style>");
            return (MarkupString)sb.ToString();
        }
    }

    // Agrupacion elegida + funciones de agregacion (totales) POR TABLERO. Sobreviven recarga igual
    // que la config de columnas.
    private static string GroupKey(Guid id) => $"propia_tb_group_{id}";
    private static string AggKey(Guid id) => $"propia_tb_agg_{id}";
    private static string ColColorKey(Guid id) => $"propia_tb_colcolor_{id}";
    private static string FiltrosKey(Guid id) => $"propia_tb_filtros_{id}";
    private sealed class FiltrosGuardados { public string Logica { get; set; } = "and"; public List<FiltroRegla> Reglas { get; set; } = new(); }
    private async Task PersistFiltrosAsync()
    {
        if (_board is null) return;
        try { await Js.InvokeVoidAsync("localStorage.setItem", FiltrosKey(_board.Tablero.Id), System.Text.Json.JsonSerializer.Serialize(new FiltrosGuardados { Logica = _filtroLogica, Reglas = _reglas })); } catch { }
    }
    private async Task PersistColColorAsync()
    {
        if (_board is null) return;
        try { await Js.InvokeVoidAsync("localStorage.setItem", ColColorKey(_board.Tablero.Id), System.Text.Json.JsonSerializer.Serialize(_colColor)); } catch { }
    }
    private async Task PersistGroupAsync()
    {
        if (_board is null) return;
        try { await Js.InvokeVoidAsync("localStorage.setItem", GroupKey(_board.Tablero.Id), _cardGroup ?? ""); } catch { }
    }
    private async Task PersistAggAsync()
    {
        if (_board is null) return;
        try { await Js.InvokeVoidAsync("localStorage.setItem", AggKey(_board.Tablero.Id), System.Text.Json.JsonSerializer.Serialize(_agg)); } catch { }
    }
    private async Task RestaurarAggGroupAsync()
    {
        if (_board is null) { _cardGroup = ""; _agg = new(); return; }
        try { var g = await Js.InvokeAsync<string?>("localStorage.getItem", GroupKey(_board.Tablero.Id)); _cardGroup = g ?? ""; } catch { _cardGroup = ""; }
        try { var raw = await Js.InvokeAsync<string?>("localStorage.getItem", AggKey(_board.Tablero.Id)); _agg = string.IsNullOrEmpty(raw) ? new() : (System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(raw) ?? new()); } catch { _agg = new(); }
        try { var raw = await Js.InvokeAsync<string?>("localStorage.getItem", ColColorKey(_board.Tablero.Id)); _colColor = string.IsNullOrEmpty(raw) ? new() : (System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(raw) ?? new()); } catch { _colColor = new(); }
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", FiltrosKey(_board.Tablero.Id));
            _reglas.Clear(); _filtroLogica = "and";
            if (!string.IsNullOrEmpty(raw))
            {
                var g = System.Text.Json.JsonSerializer.Deserialize<FiltrosGuardados>(raw);
                if (g is not null) { _filtroLogica = g.Logica == "or" ? "or" : "and"; _reglas.AddRange(g.Reglas); }
            }
        }
        catch { _reglas.Clear(); _filtroLogica = "and"; }
    }
