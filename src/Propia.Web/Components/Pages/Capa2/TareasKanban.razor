    .tb-chips { display: flex; flex-wrap: wrap; gap: 7px; }
    .tb-chip { display: inline-flex; align-items: center; gap: 7px; background: #F5F1FE; border: 1px solid #DCD2F8; border-radius: 20px; padding: 3px 8px 3px 4px; font-size: 12.5px; font-weight: 600; color: #33475B; }
