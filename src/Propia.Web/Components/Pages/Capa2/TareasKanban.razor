    /* Columna Titulo fijada: el left debe igualar el padding-left de las filas (18px) para que
       NO salte al hacer scroll horizontal; la sombra derecha marca la columna congelada. */
    /* Columna Titulo fijada: se ancla en left:0 con padding-left:18px (no en left:18px) para que su
       fondo OPACO cubra tambien la franja izquierda; si no, al hacer scroll se veian los datos/colores
       de las celdas que pasan por detras. box-sizing preserva el ancho de columna. z-index alto para
       quedar por encima de toda la fila. */
    .tb-pin { position: sticky; left: 0; padding-left: 18px; box-sizing: border-box; z-index: 5; background: #fff; box-shadow: 9px 0 10px -8px rgba(45,62,80,.16); }
    .tb-pin-h { position: sticky; left: 0; padding-left: 18px; box-sizing: border-box; z-index: 9; background: #FAFBFC; box-shadow: 9px 0 10px -8px rgba(45,62,80,.16); }
    .tb-glead { display: inline-flex; align-items: center; gap: 8px; }
    /* lead del grupo fijado: ancla en 0 con padding-left 18px para que su fondo cubra el borde
       izquierdo (si no, el boton "Agregar" del grupo asoma bajo el titulo al hacer scroll). */
    .tb-pin-g { left: 0; padding-left: 18px; background: #F8FAFC; padding-right: 10px; }

    /* Alto acotado + scroll interno para que la fila de encabezados quede fija (sticky top)
