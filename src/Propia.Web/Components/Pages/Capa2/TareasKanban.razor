    private string CampoDeTarea(TareaListaDto t, Guid campoId) => t.CamposValores?.FirstOrDefault(v => v.CampoId == campoId)?.Valor ?? "";

    // ----- Campos avanzados (Total / multivalor / suma) -----
    private static HashSet<Guid> ParseCamposSuma(string? csv) =>
        string.IsNullOrWhiteSpace(csv) ? new()
        : csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
             .Select(s => Guid.TryParse(s, out var g) ? g : Guid.Empty).Where(g => g != Guid.Empty).ToHashSet();
    private IEnumerable<TableroCampoDto> CamposSumables => (_board?.Tablero.Campos ?? new List<TableroCampoDto>())
        .Where(c => c.Tipo == TipoCampoTablero.Numero || c.Tipo == TipoCampoTablero.Moneda);
    private void ToggleCampoSuma(Guid id) { if (!_campoDraft.CamposSuma.Remove(id)) _campoDraft.CamposSuma.Add(id); }
    // Total en el modal de tarjeta (lee el borrador) y en la lista (lee la tarea guardada).
    private string CalcularTotal(TableroCampoDto c) => SumarCampos(c, id => CampoVal(id));
    private string CalcularTotalTarea(TareaListaDto t, TableroCampoDto c) => SumarCampos(c, id => CampoDeTarea(t, id));
    private string SumarCampos(TableroCampoDto c, Func<Guid, string> getVal)
    {
        decimal sum = 0m;
        foreach (var id in ParseCamposSuma(c.CamposSuma))
            if (decimal.TryParse(getVal(id), NumberStyles.Any, CultureInfo.InvariantCulture, out var d)) sum += d;
        return Math.Round(sum).ToString("N0", Es);
    }

    private string CampoDisplay(TareaListaDto t, TableroCampoDto c)
    {
        if (c.Tipo == TipoCampoTablero.Total) return "$ " + CalcularTotalTarea(t, c);
        var v = CampoDeTarea(t, c.Id);
        if (string.IsNullOrWhiteSpace(v)) return "-";
        if (c.PermiteVarios) return string.Join(", ", v.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return c.Tipo switch
        {
            TipoCampoTablero.Booleano => string.Equals(v, "true", StringComparison.OrdinalIgnoreCase) ? "Si" : "No",
            TipoCampoTablero.Moneda => decimal.TryParse(v, NumberStyles.Any, CultureInfo.InvariantCulture, out var d) ? "$ " + Math.Round(d).ToString("N0", Es) : v,
            _ => v
        };
    }

    private List<TableroCampoDto> CamposFiltrables() => (_board?.Tablero.Campos ?? new List<TableroCampoDto>()).Where(c => c.MostrarEnFiltro).ToList();
    private List<string> CampoValoresDistintos(Guid campoId) => _tareas.AsEnumerable()
        .Select(t => CampoDeTarea(t, campoId)).Where(v => !string.IsNullOrWhiteSpace(v))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(v => v).ToList();
    private string FCampoVal(Guid id) => _fCampo.GetValueOrDefault(id, "");
    private void SetFCampo(Guid id, ChangeEventArgs e) { var v = e.Value?.ToString() ?? ""; if (string.IsNullOrEmpty(v)) _fCampo.Remove(id); else _fCampo[id] = v; }

    private void CerrarCard() { _cardDraft = null; _subNew = ""; _respPick = ""; }

    // ---- Copiar tarea (mini-modal): copia INDEPENDIENTE con traza; se invoca desde modal/tabla/tarjeta ----
    private class CopiaDialog
    {
        public Guid TareaId { get; set; }
        public string TareaTitulo { get; set; } = "";
        public string Titulo { get; set; } = "";
        public Guid EstadoId { get; set; }
        public int Cantidad { get; set; } = 1;
        public bool ConservarResponsables { get; set; } = true;
        public bool ConservarEtiquetas { get; set; } = true;
        public bool ConservarRelacion { get; set; } = true;
        public bool ConservarCampos { get; set; } = true;
    }
    private CopiaDialog? _copiaDlg;
    private bool _copiaBusy;
    private void AbrirCopiaDialog(Guid id, string titulo, Guid estadoId)
        => _copiaDlg = new CopiaDialog { TareaId = id, TareaTitulo = titulo, Titulo = (titulo + " (copia)").Trim(), EstadoId = estadoId, Cantidad = 1 };
    private void CerrarCopiaDialog() { _copiaDlg = null; }
    private async Task ConfirmarCopia()
    {
        if (_copiaDlg is null) return;
        _copiaBusy = true;
        try
        {
            var d = _copiaDlg;
            var req = new CopiarTareaRequest(
                string.IsNullOrWhiteSpace(d.Titulo) ? null : d.Titulo.Trim(),
                d.EstadoId, Math.Clamp(d.Cantidad, 1, 20),
                d.ConservarResponsables, d.ConservarEtiquetas, d.ConservarRelacion, d.ConservarCampos);
            var resp = await Auth().PostAsJsonAsync($"/api/tareas/{d.TareaId}/copiar", req);
            if (resp.IsSuccessStatusCode)
            {
                var srcId = d.TareaId;
                _copiaDlg = null;
                await RecargarBoard();
                if (_cardDraft?.Id == srcId)   // refrescar la traza si el modal del original sigue abierto
                {
                    var t2 = _tareas.FirstOrDefault(x => x.Id == srcId);
                    if (t2 is not null) await AbrirCardDraft(t2, null);
                }
            }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _copiaBusy = false; }
    }
    private async Task AbrirCopiaOriginal()
    {
        if (_cardDraft?.CopiadaDeTareaId is not Guid oid) return;
        var t = _tareas.FirstOrDefault(x => x.Id == oid);
        if (t is not null) await AbrirCardDraft(t, null);
    }

    private async Task AbrirCardDraft(TareaListaDto? t, Guid? estadoIdDefault)
    {
        _subNew = ""; _respPick = ""; _cardMsg = null;
        if (t is null)
        {
            _cardDraft = new CardDraft { EstadoId = estadoIdDefault ?? _board?.Estados.FirstOrDefault()?.Id ?? Guid.Empty };
            // Valores por defecto de los campos del tablero al crear una tarjeta nueva.
            foreach (var c in _board?.Tablero.Campos ?? new List<TableroCampoDto>())
                if (!string.IsNullOrEmpty(c.ValorPorDefecto)) _cardDraft.Campos[c.Id] = c.ValorPorDefecto;
            return;
        }

        // Tarjeta existente: traer la ficha completa.
        try
        {
            var det = await Auth().GetFromJsonAsync<TareaDetalleDto>($"/api/tareas/{t.Id}");
            if (det is null) return;
            var responsables = new List<Guid>();
            if (det.AsignadoPersonaId is { } ap) responsables.Add(ap);
            responsables.AddRange(det.Colaboradores.Select(c => c.PersonaId).Where(p => !responsables.Contains(p)));
            _cardDraft = new CardDraft
            {
                Id = det.Id,
                PadreId = det.PadreId,
                PadreTitulo = det.PadreTitulo,
                Titulo = det.Titulo,
                Descripcion = det.Descripcion,
                Prioridad = det.Prioridad,
                EstadoId = det.Estado.Id,
                Color = det.Color ?? t.Color ?? "#6D4FE3",
                EsProyecto = det.EsProyecto,
                Valor = det.Valor,
                Progreso = det.Progreso,
                FechaInicio = det.FechaInicio?.ToDateTime(TimeOnly.MinValue),
                FechaVencimiento = det.FechaVencimiento?.ToDateTime(TimeOnly.MinValue),
                HoraInicio = det.HoraInicio,
                HoraFin = det.HoraFin,
                OrigenTipo = det.OrigenTipo,
                OrigenReferencia = det.OrigenReferencia,
                Responsables = responsables,
                Checklist = (det.Checklist ?? new List<SubtareaCheckDto>()).Select(s => new SubChk { Titulo = s.Titulo, Hecho = s.Hecho }).ToList(),
                Adjuntos = (det.Adjuntos ?? new List<TareaAdjuntoDto>()).Select(a => new AdjuntoVM(a.Id, a.Nombre, a.Url)).ToList(),
                Historial = det.Historial.OrderBy(h => h.OcurridoAt).Select(h => new LogVM(h.Descripcion, h.OcurridoAt)).ToList(),
                Campos = (det.CamposValores ?? new List<TareaCampoValorDto>()).GroupBy(v => v.CampoId).ToDictionary(g => g.Key, g => g.First().Valor),
                EtiquetaIds = t.Etiquetas.Select(e => e.Id).ToHashSet(),
                EtiquetaIdsOrig = t.Etiquetas.Select(e => e.Id).ToHashSet(),
                TieneHijos = t.CantidadSubtareas > 0,
                CopiadaDeTareaId = det.CopiadaDeTareaId,
                CopiadaDeNumero = det.CopiadaDeNumero,
                CopiadaDeTitulo = det.CopiadaDeTitulo,
                Copias = (det.Copias ?? new List<TareaListaDto>()).ToList()
            };
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task GuardarCard()
    {
        if (_cardDraft is null || _board is null || string.IsNullOrWhiteSpace(_cardDraft.Titulo)) return;
        _cardMsg = null;
        // Campos requeridos: bloquea guardar si falta alguno (Separador/Total no capturan valor).
        var faltan = (_board.Tablero.Campos ?? new List<TableroCampoDto>())
            .Where(c => c.Requerido && c.Tipo != TipoCampoTablero.Separador && c.Tipo != TipoCampoTablero.Total
                        && string.IsNullOrWhiteSpace(_cardDraft.Campos.GetValueOrDefault(c.Id)))
            .Select(c => c.Label).ToList();
        if (faltan.Count > 0) { _cardMsg = "Faltan campos requeridos: " + string.Join(", ", faltan); return; }
        var d = _cardDraft;
        _busy = true;
        try
        {
            var ini = d.FechaInicio.HasValue ? DateOnly.FromDateTime(d.FechaInicio.Value) : (DateOnly?)null;
            var venc = d.FechaVencimiento.HasValue ? DateOnly.FromDateTime(d.FechaVencimiento.Value) : (DateOnly?)null;
            var origenTipo = string.IsNullOrWhiteSpace(d.OrigenTipo) ? null : d.OrigenTipo;
            var origenRef = string.IsNullOrWhiteSpace(d.OrigenReferencia) ? null : d.OrigenReferencia;
            var responsables = d.Responsables.Count > 0 ? d.Responsables.ToList() : new List<Guid>();
            var checklist = d.Checklist.Where(x => !string.IsNullOrWhiteSpace(x.Titulo))
                .Select(x => new SubtareaCheckItem(x.Titulo.Trim(), x.Hecho)).ToList();
            var camposValores = (_board.Tablero.Campos ?? new List<TableroCampoDto>())
                .Select(c => new TareaCampoValorDto(c.Id, d.Campos.GetValueOrDefault(c.Id))).ToList();

            HttpResponseMessage resp;
            if (d.Id is null)
            {
                var req = new CrearTareaRequest(
                    d.Titulo.Trim(), d.Descripcion, d.Prioridad, d.EstadoId,
                    null, ini, venc, d.PadreId, d.EtiquetaIds.ToList(), _board.Tablero.Id,
                    d.Color, d.EsProyecto, d.Valor, d.HoraInicio, d.HoraFin,
                    origenTipo, origenRef, responsables, checklist, camposValores);
                resp = await Auth().PostAsJsonAsync("/api/tareas", req);
            }
            else
            {
                var req = new ActualizarTareaRequest(
                    d.Titulo.Trim(), d.Descripcion, d.Prioridad, null, ini, venc,
                    d.EstadoId, d.Color, d.EsProyecto, d.Valor, d.Progreso, d.HoraInicio, d.HoraFin,
                    origenTipo, origenRef, responsables, checklist, camposValores);
                resp = await Auth().PutAsJsonAsync($"/api/tareas/{d.Id}", req);
            }
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }

            // Etiquetas: en tarjeta existente, sincronizar (asignar nuevas / quitar removidas) via endpoints.
            if (d.Id is { } tid)
            {
                foreach (var add in d.EtiquetaIds.Where(x => !d.EtiquetaIdsOrig.Contains(x)))
                    await Auth().PostAsJsonAsync($"/api/tareas/{tid}/etiquetas", new Propia.Application.Tareas.AsignarEtiquetaRequest(add));
                foreach (var rem in d.EtiquetaIdsOrig.Where(x => !d.EtiquetaIds.Contains(x)))
                    await Auth().DeleteAsync($"/api/tareas/{tid}/etiquetas/{rem}");
            }

            // Si era una tarea hija, deja el padre expandido para verla en la lista.
            if (d.PadreId is { } pid) { _expandidas.Add(pid); if (_boardMode == "tablero") _boardMode = "lista"; }
            CerrarCard();
            await RecargarBoard();
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task EliminarCard()
    {
        if (_cardDraft?.Id is null) return;
        if (!await Js.InvokeAsync<bool>("confirm", "Eliminar esta tarjeta? Esta accion no se puede deshacer.")) return;
        _busy = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/tareas/{_cardDraft.Id}");
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            CerrarCard();
            await RecargarBoard();
        }
        finally { _busy = false; }
    }

