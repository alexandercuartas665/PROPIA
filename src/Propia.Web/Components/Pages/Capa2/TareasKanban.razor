@page "/tareas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Propia.Application.Tareas
@using Propia.Application.Directorio
@using Propia.Application.Cierre
@using Propia.Domain.Enums
@using Propia.Shared.Auth
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Tareas y proyectos - PROPIA</PageTitle>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="tb-wrap">

    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

    @* ===================== LISTA DE TABLEROS ===================== *@
    @if (_board is null)
    {
        <div class="tb-head">
            <div>
                <h1 class="tb-title">Tableros de trabajo</h1>
                <p class="tb-sub">Gestiona las acciones de la copropiedad en tableros configurables.</p>
            </div>
            <div class="tb-head-actions">
                @SelectorCopropiedad
                <button class="tb-btn tb-btn-primary" @onclick="() => AbrirTableroDraft(null)"><i class="fi fi-rr-plus"></i>Nuevo tablero</button>
            </div>
        </div>

        @* ----- Indicadores (KPIs de todo el modulo, prototipo v2) ----- *@
        @if (_resumen is not null)
        {
            <div class="tb-kpis">
                @foreach (var k in TaskKpis())
                {
                    <div class="tb-kpi" style="background:@k.Grad">
                        <svg class="tb-kpi-wm" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6"><path d="@k.Icon"/></svg>
                        <div class="tb-kpi-body">
                            <div class="tb-kpi-label">@k.Label</div>
                            <div class="tb-kpi-n">@k.Valor</div>
                            <div class="tb-kpi-sub">@k.Sub</div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_tableros is null)
        {
            <div class="text-center py-5"><div class="spinner-border" style="color:#6D4FE3"></div></div>
        }
        else
        {
            <div class="tb-grid">
                @foreach (var b in _tableros)
                {
                    var board = b;
                    <div class="tb-card">
                        <div class="tb-card-bar" style="background:@b.Color"></div>
                        <div class="tb-card-body">
                            <div class="tb-card-top">
                                <div class="tb-card-id">
                                    <div class="tb-card-nom">@b.Nombre</div>
                                    <div class="tb-card-desc">@b.Descripcion</div>
                                </div>
                                <button class="tb-card-edit" title="Editar tablero" @onclick="() => AbrirTableroDraft(board)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                            </div>
                            <div class="tb-card-foot">
                                <div class="tb-avatars">
                                    @foreach (var u in b.Usuarios.Take(3)) { <div class="tb-ava" title="@u.Nombre">@u.Iniciales</div> }
                                    @if (b.Usuarios.Count > 3) { <div class="tb-ava tb-ava-more">+@(b.Usuarios.Count - 3)</div> }
                                </div>
                                <span class="tb-card-count">@b.NCards tarjetas</span>
                            </div>
                            <button class="tb-card-open" @onclick="() => AbrirBoardAsync(board.Id)">Abrir tablero<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg></button>
                        </div>
                    </div>
                }
                <button class="tb-card-new" @onclick="() => AbrirTableroDraft(null)">
                    <div class="tb-card-new-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg></div>
                    <span>Crear tablero</span>
                </button>
            </div>
        }
    }

    @* ===================== VISTA DE TABLERO ===================== *@
    else
    {
        <div class="tb-board-head">
            <button class="tb-icon-btn" title="Volver" @onclick="CerrarBoard"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
            <div class="tb-board-color" style="background:@_board.Tablero.Color"></div>
            <div class="tb-board-id">
                <h1 class="tb-board-nom">@_board.Tablero.Nombre</h1>
                <p class="tb-board-desc">@_board.Tablero.Descripcion</p>
            </div>
            <div class="tb-board-actions">
                <div class="tb-avatars tb-avatars-lg">
                    @foreach (var u in _board.Tablero.Usuarios.Take(4)) { <div class="tb-ava" title="@u.Nombre">@u.Iniciales</div> }
                </div>
                @* En "Cerrados" no hay diseno de tablero: solo una tabla de consulta. *@
                @if (!_verCerradas)
                {
                    <div class="tb-modeswitch">
                        @foreach (var m in _modes)
                        {
                            var mode = m.Key;
                            <button class="tb-mode @(_boardMode == mode ? "on" : "")" @onclick="() => SetBoardMode(mode)" title="@m.Label">
                                @((MarkupString)m.Icon)<span>@m.Label</span>
                            </button>
                        }
                    </div>
                }
                @SelectorCopropiedad
                @if (!_verCerradas)
                {
                    <button class="tb-btn tb-btn-soft" @onclick="AbrirConfigBoard"><i class="fi fi-rr-settings"></i>Configurar</button>
                    <button class="tb-btn tb-btn-primary" @onclick="() => AbrirCardDraft(null, _board.Estados.FirstOrDefault()?.Id)"><i class="fi fi-rr-plus"></i>Nueva tarea</button>
                }
            </div>
        </div>

        @* Pestanas Activos / Cerrados + buscador (las tareas cerradas desaparecen del tablero activo). *@
        <div class="tb-board-tabs">
            <button class="tb-btab @(!_verCerradas ? "on" : "")" @onclick="() => CambiarTabCerradas(false)">Activos</button>
            <button class="tb-btab @(_verCerradas ? "on" : "")" @onclick="() => CambiarTabCerradas(true)">Cerrados</button>
            <div class="tb-flex"></div>
            @* En vista Lista el buscador va junto a "Filtros" (como en PQRSD); aqui se oculta para no duplicarlo. *@
            @if (_boardMode != "lista") { <input class="tb-search" @bind="_buscarTarea" @bind:event="oninput" placeholder="Buscar por titulo o numero..." /> }
        </div>


        @* ========== CERRADOS: una sola tabla de consulta (sin diseno de tablero) ========== *@
        @if (_verCerradas)
        {
            var qCerr = (_buscarTarea ?? "").Trim().ToLowerInvariant();
            var cerradas = _board.Tareas
                .Where(x => string.IsNullOrEmpty(qCerr) || x.Titulo.ToLowerInvariant().Contains(qCerr) || x.NumeroTarea.ToLowerInvariant().Contains(qCerr))
                .OrderByDescending(x => x.CerradaAt)
                .ToList();
            <div class="tb-cerr">
                @if (cerradas.Count == 0)
                {
                    <div class="tb-cerr-empty">No hay tareas cerradas@(string.IsNullOrWhiteSpace(_buscarTarea) ? "" : " para esa busqueda").</div>
                }
                else
                {
                    <table class="tb-cerr-tbl">
                        <thead>
                            <tr>
                                <th>Numero</th><th>Tarea</th><th>Prioridad</th><th>Estado final</th><th>Motivo de cierre</th><th>Cerrada</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in cerradas)
                            {
                                var tarea = t;
                                <tr class="tb-cerr-row" @onclick="() => AbrirCardDraft(tarea, null)" title="Abrir">
                                    <td class="tb-cerr-num">@t.NumeroTarea</td>
                                    <td class="tb-cerr-tit">@t.Titulo</td>
                                    <td>@if (Enum.IsDefined(t.Prioridad)) { <span class="tb-cerr-prio tb-cerr-prio-@t.Prioridad">@t.Prioridad</span> } else { <span class="tb-cerr-prio">—</span> }</td>
                                    <td><span class="tb-cerr-est" style="background:@(t.EstadoColor ?? "#64748b")">@t.EstadoNombre</span></td>
                                    <td class="tb-cerr-mot">@(string.IsNullOrWhiteSpace(t.MotivoCierre) ? "—" : t.MotivoCierre)</td>
                                    <td class="tb-cerr-dt">@(t.CerradaAt is DateTimeOffset ca ? FechaHora(ca) : "—")</td>
                                    <td class="tb-cerr-act">
                                        <button class="tb-cerr-reab" @onclick:stopPropagation="true" @onclick="() => ReabrirTareaCerrada(tarea.Id)" title="Reabrir: vuelve al tablero activo">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Reabrir
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else
        {
        @* ---------- TABLERO (Kanban) ---------- *@
        @if (_boardMode == "tablero")
        {
            <div class="tb-cardbar">
                <div class="tb-flex"></div>
                <div class="tb-menuwrap">
                    <button class="tb-filter-btn @(!string.IsNullOrEmpty(_sortCol) ? "on" : "")" @onclick="() => { _cardSortMenu = !_cardSortMenu; _cardGroupMenu = false; }" title="Ordenar tarjetas">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h13M3 12h9M3 18h5M18 8V4m0 0l-3 3m3-3l3 3"/></svg>@(string.IsNullOrEmpty(_sortCol) ? "Ordenar" : "Ordenar: " + OrdenLabel(_sortCol))
                    </button>
                    @if (_cardSortMenu)
                    {
                        <div class="tb-menu">
                            <button class="tb-menu-it @(string.IsNullOrEmpty(_sortCol) ? "on" : "")" @onclick='() => SetCardSort("")'>Sin orden</button>
                            @foreach (var o in OpcionesOrden())
                            {
                                var k = o.Key;
                                <button class="tb-menu-it @(_sortCol == k ? "on" : "")" @onclick="() => SetCardSort(k)"><span>@o.Label</span>@SortInd(k)</button>
                            }
                        </div>
                    }
                </div>
                <div class="tb-menuwrap">
                    <button class="tb-filter-btn @(!string.IsNullOrEmpty(_cardGroup) ? "on" : "")" @onclick="() => { _cardGroupMenu = !_cardGroupMenu; _cardSortMenu = false; }" title="Agrupar tarjetas">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>@(string.IsNullOrEmpty(_cardGroup) ? "Agrupar por" : "Agrupar: " + GrupoLabel(_cardGroup))
                    </button>
                    @if (_cardGroupMenu)
                    {
                        <div class="tb-menu">
                            @foreach (var o in OpcionesGrupo())
                            {
                                var k = o.Key;
                                <button class="tb-menu-it @(_cardGroup == k ? "on" : "")" @onclick="() => SetCardGroup(k)">@o.Label</button>
                            }
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_cardGroup))
                {
                    <button class="tb-filter-btn tb-group-clear" @onclick="ClearCardGroup" title="Quitar agrupacion">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>Quitar
                    </button>
                }
            </div>

            @if (string.IsNullOrEmpty(_cardGroup) || _cardGroup == "none")
            {
            <div class="tb-kanban" style="grid-template-columns:repeat(@_board.Estados.Count, minmax(260px, 1fr))">
                @foreach (var est in _board.Estados)
                {
                    var estado = est;
                    var cards = AplicarSort(RaicesPorEstado(est.Id)).ToList();
                    @* El dragover se cancela con un handler HTML plano (no con @@ondragover:preventDefault):
                       Blazor solo instala el listener de un evento si hay un manejador para el, asi que
                       la marca de preventDefault sola no se aplicaba y el navegador rechazaba el drop. *@
                    <div class="tb-col @(_dragTareaId is not null ? "tb-col-drop" : "")"
                         ondragover="event.preventDefault()"
                         @ondrop="() => SoltarEnEstado(estado.Id)">
                        <div class="tb-col-head">
                            <span class="tb-col-dot" style="background:@(est.Color ?? "#94a3b8")"></span>
                            <span class="tb-col-nom">@est.Nombre</span>
                            <span class="tb-col-count">@cards.Count</span>
                        </div>
                        <div class="tb-col-body">
                            @foreach (var t in cards)
                            {
                                var tarea = t;
                                <button class="tb-tcard" draggable="true"
                                        @ondragstart="() => IniciarArrastre(tarea.Id)"
                                        @ondragend="() => _dragTareaId = null"
                                        style="border-left-color:@(t.Color ?? est.Color ?? "#6D4FE3")" @onclick="() => AbrirCardDraft(tarea, null)">
                                    <span class="tb-tcard-copy" title="Copiar tarea" @onclick:stopPropagation="true" @onclick="() => AbrirCopiaDialog(tarea.Id, tarea.Titulo, tarea.EstadoId)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg></span>
                                    <div class="tb-tcard-tit">@t.Titulo</div>
                                    <div class="tb-tcard-meta">
                                        <span class="tb-prio" style="color:@PrioFg(t.Prioridad);background:@PrioBg(t.Prioridad)">@t.Prioridad</span>
                                        @if (t.FechaVencimiento.HasValue) { <span class="tb-due @(t.Vencida ? "venc" : "")">@FechaCorta(t.FechaVencimiento.Value)</span> }
                                    </div>
                                    <div class="tb-tcard-foot">
                                        <span class="tb-tcard-resp">@(string.IsNullOrWhiteSpace(t.AsignadoNombre) ? "Sin asignar" : t.AsignadoNombre)</span>
                                        @if (t.CantidadSubtareas > 0) { <span class="tb-chip">@t.CantidadSubtareas sub</span> }
                                        <span class="tb-tcard-age" title="@TooltipEstado(t)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>@TiempoEnEstado(t)</span>
                                    </div>
                                </button>
                            }
                            @if (_composerEstado == estado.Id)
                            {
                                @* Compositor progresivo: titulo primero; cada Tab revela el siguiente campo. Enter crea, Esc cierra. *@
                                <div class="tb-composer">
                                    @* SIN value= a proposito: con value= + @@oninput en Blazor Server cada tecla
                                       hace round-trip y el re-render reafirma value con el modelo, pisando las
                                       teclas escritas mientras el round-trip esta en vuelo (se pierden pulsaciones).
                                       El modelo se mantiene por @@oninput; @@key limpia el input al abrir/crear y el
                                       foco se restaura a mano en OnAfterRenderAsync. *@
                                    <input class="tb-composer-inp" placeholder="Titulo de la tarea..."
                                           @key="_composerNonce" @ref="_composerTituloRef"
                                           @oninput="@(e => { _composerDraft.Titulo = e.Value?.ToString() ?? string.Empty; RevealComposerNext(0); })"
                                           @onkeydown="@(e => ComposerKeydown(e, estado.Id, 0))" />
                                    @if (_composerReveal >= 1)
                                    {
                                        <input class="tb-composer-sub tb-composer-appear" placeholder="Descripcion (opcional)"
                                               @oninput="@(e => _composerDraft.Descripcion = e.Value?.ToString())"
                                               @onfocus="@(() => RevealComposerNext(1))" @onkeydown="@(e => ComposerKeydown(e, estado.Id, 1))" />
                                    }
                                    @if (_composerReveal >= 2)
                                    {
                                        <select class="tb-composer-sel tb-composer-appear" @onchange="SetComposerAsignado"
                                                @onfocus="@(() => RevealComposerNext(2))" @onkeydown="@(e => ComposerKeydown(e, estado.Id, 2))">
                                            <option value="">Sin asignar</option>
                                            @foreach (var p in _personas ?? new List<PersonaMini>()) { <option value="@p.Id">@p.Nombre</option> }
                                        </select>
                                    }
                                    @if (_composerReveal >= 3)
                                    {
                                        <select class="tb-composer-sel tb-composer-appear" @bind="_composerDraft.Prioridad"
                                                @onfocus="@(() => RevealComposerNext(3))" @onkeydown="@(e => ComposerKeydown(e, estado.Id, 3))">
                                            @foreach (var pr in Enum.GetValues<PrioridadTarea>()) { <option value="@pr">@pr</option> }
                                        </select>
                                    }
                                    @if (_composerReveal >= 4)
                                    {
                                        <input type="date" class="tb-composer-sel tb-composer-appear" @bind="_composerDraft.FechaVencimiento"
                                               @onfocus="@(() => RevealComposerNext(4))" @onkeydown="@(e => ComposerKeydown(e, estado.Id, 4))" />
                                    }
                                    @if (_composerReveal >= 5)
                                    {
                                        <input type="number" step="1000" class="tb-composer-sel tb-composer-appear" placeholder="Valor ($)"
                                               @bind="_composerDraft.Valor" @bind:event="oninput"
                                               @onfocus="@(() => RevealComposerNext(5))" @onkeydown="@(e => ComposerKeydown(e, estado.Id, 5))" />
                                    }
                                    @if (_composerReveal >= 6)
                                    {
                                        <div class="tb-composer-orig tb-composer-appear">
                                            <select class="tb-composer-sel" @onfocus="@(() => RevealComposerNext(6))"
                                                    @onchange="@(e => { _composerDraft.OrigenTipo = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString(); _composerDraft.OrigenReferencia = null; })"
                                                    @onkeydown="@(e => ComposerKeydown(e, estado.Id, 6))">
                                                <option value="" selected="@(_composerDraft.OrigenTipo is null)">Relacionar con... (opcional)</option>
                                                <option value="inmueble" selected="@(_composerDraft.OrigenTipo == "inmueble")">Inmueble / unidad</option>
                                                <option value="zona" selected="@(_composerDraft.OrigenTipo == "zona")">Zona comun</option>
                                                <option value="equipo" selected="@(_composerDraft.OrigenTipo == "equipo")">Equipo / activo</option>
                                            </select>
                                            @if (!string.IsNullOrEmpty(_composerDraft.OrigenTipo))
                                            {
                                                <SelectorOrigenReferencia InputClass="tb-composer-sel"
                                                                          Placeholder="@OrigenPlaceholder(_composerDraft.OrigenTipo)"
                                                                          Opciones="@OrigenBusquedaDe(_composerDraft.OrigenTipo)"
                                                                          Value="@_composerDraft.OrigenReferencia"
                                                                          ValueChanged="@(v => _composerDraft.OrigenReferencia = string.IsNullOrEmpty(v) ? null : v)"
                                                                          OnKeyDown="@(e => ComposerKeydown(e, estado.Id, 6))" />
                                            }
                                        </div>
                                    }
                                    @{ var campos = _board?.Tablero.Campos ?? new List<TableroCampoDto>(); }
                                    @for (int ci = 0; ci < campos.Count; ci++)
                                    {
                                        var campo = campos[ci];
                                        var fidx = 7 + ci;
                                        if (_composerReveal >= fidx)
                                        {
                                            <input class="tb-composer-sel tb-composer-appear" placeholder="@campo.Label"
                                                   value="@(_composerDraft.Campos.GetValueOrDefault(campo.Id))"
                                                   @oninput="@(e => _composerDraft.Campos[campo.Id] = e.Value?.ToString())"
                                                   @onfocus="@(() => RevealComposerNext(fidx))" @onkeydown="@(e => ComposerKeydown(e, estado.Id, fidx))" />
                                        }
                                    }
                                    <div class="tb-composer-foot">
                                        <span class="tb-composer-hint">Tab agrega campos &middot; Enter crea &middot; Esc cierra</span>
                                        <button class="tb-composer-btn" @onclick="() => CrearDesdeComposer(estado.Id)" disabled="@string.IsNullOrWhiteSpace(_composerDraft.Titulo)">Agregar</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="tb-col-add" @onclick="() => AbrirComposer(estado.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>Agregar</button>
                            }
                        </div>
                    </div>
                }
            </div>
            }
            else
            {
                var grupos = AgruparCards();
                <div class="tb-groups">
                    @foreach (var gr in grupos)
                    {
                        <div class="tb-gsec">
                            <div class="tb-gsec-head">
                                <span class="tb-gsec-nom">@gr.Key</span>
                                <span class="tb-col-count">@gr.Items.Count</span>
                                @{ var camposNumK = (_board?.Tablero.Campos ?? new List<TableroCampoDto>()).Where(CampoEsNumerico).ToList(); var svK = SumaCampoGrupo("valor", gr.Items); }
                                <span class="tb-gsec-tot">
                                    @if (svK != 0) { <span class="tb-gsec-chip">Valor <b>$ @Math.Round(svK).ToString("N0", Es)</b></span> }
                                    @foreach (var cnk in camposNumK)
                                    {
                                        var scK = SumaCampoGrupo(cnk.Id.ToString(), gr.Items);
                                        if (scK != 0) { <span class="tb-gsec-chip">@cnk.Label <b>@(cnk.Tipo == TipoCampoTablero.Moneda ? "$ " : "")@Math.Round(scK).ToString("N0", Es)</b></span> }
                                    }
                                </span>
                            </div>
                            <div class="tb-gsec-grid">
                                @foreach (var t in gr.Items)
                                {
                                    var tarea = t;
                                    <button class="tb-tcard" style="border-left-color:@(t.Color ?? "#6D4FE3")" @onclick="() => AbrirCardDraft(tarea, null)">
                                        <span class="tb-tcard-copy" title="Copiar tarea" @onclick:stopPropagation="true" @onclick="() => AbrirCopiaDialog(tarea.Id, tarea.Titulo, tarea.EstadoId)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg></span>
                                        <div class="tb-tcard-tit">@t.Titulo</div>
                                        <div class="tb-tcard-meta">
                                            <span class="tb-etapa-dot" style="background:@(t.EstadoColor ?? "#94a3b8")" title="@t.EstadoNombre"></span>
                                            <span class="tb-prio" style="color:@PrioFg(t.Prioridad);background:@PrioBg(t.Prioridad)">@t.Prioridad</span>
                                            @if (t.FechaVencimiento.HasValue) { <span class="tb-due @(t.Vencida ? "venc" : "")">@FechaCorta(t.FechaVencimiento.Value)</span> }
                                        </div>
                                        <div class="tb-tcard-foot">
                                            <span class="tb-tcard-resp">@(string.IsNullOrWhiteSpace(t.AsignadoNombre) ? "Sin asignar" : t.AsignadoNombre)</span>
                                            @if (t.CantidadSubtareas > 0) { <span class="tb-chip">@t.CantidadSubtareas sub</span> }
                                            <span class="tb-tcard-age" title="@TooltipEstado(t)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>@TiempoEnEstado(t)</span>
                                        </div>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    @if (grupos.Count == 0) { <div class="tb-groups-empty">No hay tarjetas en este tablero.</div> }
                </div>
            }
        }

        @* ---------- LISTA ---------- *@
        else if (_boardMode == "lista")
        {
            <div class="tb-filters">
                @* Constructor de filtros: boton compacto con contador -> panel donde se agregan varias
                   reglas (campo + condicion + valor), combinables con Y/O. Reemplaza la fila fija de menus. *@
                <div class="tb-menuwrap">
                    <button class="tb-filter-btn @(HayFiltros ? "on" : "")" @onclick="ToggleFiltros" title="Filtrar tareas">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18M6 12h12M10 19h4"/></svg><span>Filtros</span>@if (CuentaFiltros > 0) { <span class="tb-filter-badge">@CuentaFiltros</span> }
                    </button>
                    @if (_filtrosMenu)
                    {
                        <div class="tb-filterpop-bd" @onclick="() => _filtrosMenu = false"></div>
                        <div class="tb-filterpop" @onclick:stopPropagation="true">
                            @if (_reglas.Count == 0)
                            {
                                <div class="tb-filterpop-empty">Sin filtros aplicados.<br />Agrega una condicion para acotar las tareas.</div>
                            }
                            else
                            {
                                @for (int i = 0; i < _reglas.Count; i++)
                                {
                                    var idx = i; var r = _reglas[idx];
                                    <div class="tb-frule">
                                        @if (idx == 0)
                                        {
                                            <span class="tb-frule-lead">Donde</span>
                                        }
                                        else if (idx == 1)
                                        {
                                            <select class="tb-frule-lead tb-frule-logic" @onchange="SetFiltroLogica">
                                                <option value="and" selected="@(_filtroLogica == "and")">Y</option>
                                                <option value="or" selected="@(_filtroLogica == "or")">O</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="tb-frule-lead">@(_filtroLogica == "or" ? "O" : "Y")</span>
                                        }
                                        <select class="tb-frule-f" @onchange="(e) => SetReglaCampo(idx, e)">
                                            @foreach (var opt in CamposFiltro()) { <option value="@opt.Key" selected="@(r.Campo == opt.Key)">@opt.Label</option> }
                                        </select>
                                        <select class="tb-frule-op" @onchange="(e) => SetReglaOp(idx, e)">
                                            @foreach (var op in OperadoresDe(r.Campo)) { <option value="@op.Key" selected="@(r.Op == op.Key)">@op.Label</option> }
                                        </select>
                                        @if (r.Op is not "vacio" and not "no_vacio")
                                        {
                                            @RenderValorFiltro(idx)
                                        }
                                        <button class="tb-frule-del" title="Quitar condicion" @onclick="() => QuitarRegla(idx)">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                        </button>
                                    </div>
                                }
                            }
                            <div class="tb-filterpop-foot">
                                <button class="tb-filter-add" @onclick="AgregarRegla">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"/></svg>Agregar filtro
                                </button>
                                @if (_reglas.Count > 0) { <button class="tb-filter-clear2" @onclick="LimpiarFiltros">Limpiar todo</button> }
                            </div>
                        </div>
                    }
                </div>
                @* Buscador junto a "Filtros" (como en PQRSD). *@
                <input class="tb-search tb-search--sm" @bind="_buscarTarea" @bind:event="oninput" placeholder="Buscar por titulo o numero..." />
                <div class="tb-flex"></div>
                <div class="tb-menuwrap">
                    <button class="tb-filter-btn @(!string.IsNullOrEmpty(_cardGroup) ? "on" : "")" @onclick="() => _cardGroupMenu = !_cardGroupMenu" title="Agrupar filas">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>@(string.IsNullOrEmpty(_cardGroup) ? "Agrupar por" : "Agrupar: " + GrupoLabel(_cardGroup))
                    </button>
                    @if (_cardGroupMenu)
                    {
                        <div class="tb-menu">
                            @foreach (var o in OpcionesGrupo())
                            {
                                var k = o.Key;
                                <button class="tb-menu-it @(_cardGroup == k ? "on" : "")" @onclick="() => SetCardGroup(k)">@o.Label</button>
                            }
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_cardGroup))
                {
                    <button class="tb-filter-btn tb-group-clear" @onclick="ClearCardGroup" title="Quitar agrupacion">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>Quitar
                    </button>
                }
                <button class="tb-filter-btn @(_pinTitulo ? "on" : "")" @onclick='() => ToggleColFijo("pin")' title="Congelar la columna Titulo al desplazar la tabla de lado (los encabezados ya quedan fijos al bajar)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 4v6l-2 4h10l-2-4V4M12 14v6M8 4h8"/></svg>Fijar columna
                </button>
                <button class="tb-filter-btn" @onclick="() => _colsMenu = !_colsMenu" title="Columnas visibles">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M7 12h10M10 18h4"/></svg>Campos
                </button>
                @if (_colsMenu)
                {
                    <div class="tb-colsmenu">
                        <div class="tb-colsmenu-h">COLUMNAS (orden y visibilidad)</div>
                        @* Cada fila: flechas para reordenar + casilla para mostrar/ocultar + nombre. El orden real
                           de la tabla se aplica por CSS (order) segun _colOrden, sin tocar el markup de las filas. *@
                        @for (int i = 0; i < _colOrden.Count; i++)
                        {
                            var idx = i; var key = _colOrden[idx];
                            <div class="tb-colsmenu-i @(ColKeyVisible(key) ? "" : "tb-colsmenu-off")">
                                <span class="tb-colord">
                                    <button type="button" class="tb-colord-b" title="Subir" disabled="@(idx == 0)" @onclick="() => MoverColumna(idx, -1)"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 15l6-6 6 6"/></svg></button>
                                    <button type="button" class="tb-colord-b" title="Bajar" disabled="@(idx == _colOrden.Count - 1)" @onclick="() => MoverColumna(idx, 1)"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg></button>
                                </span>
                                @if (ColKeyBloqueada(key))
                                {
                                    <span class="tb-chk tb-chk-lock" title="Columna fija (no se puede ocultar)"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#90A4B7" stroke-width="2.4"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
                                }
                                else
                                {
                                    <button type="button" class="tb-chk-btn" @onclick="() => ToggleColKey(key)"><span class="tb-chk @(ColKeyVisible(key) ? "on" : "")">@if (ColKeyVisible(key)){<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><path d="M5 12l5 5 9-11"/></svg>}</span></button>
                                }
                                <span class="tb-colsmenu-lbl">@ColKeyLabel(key)</span>
                            </div>
                        }
                        <div class="tb-colsmenu-acts">
                            <button class="tb-colsmenu-act" @onclick="ColsTodos">Mostrar todas</button>
                            <button class="tb-colsmenu-act" @onclick="ColsNinguno">Ocultar todas</button>
                        </div>
                    </div>
                }
            </div>

            @ColumnColorCss
            @ColumnOrderCss
            @* Scroll horizontal SUPERIOR (espejo del de abajo), sincronizado por JS con la tabla. *@
            <div class="tb-topscroll" id="tbTopScroll"><div id="tbTopScrollInner"></div></div>

            <div class="tb-list" id="tbList">
                <div class="tb-list-hdr">
                    <div class="tb-lc tb-lc-tit tb-lc-sort @(_pinTitulo ? "tb-pin tb-pin-h" : "")" @onclick='() => SortBy("titulo")'><span>TITULO</span>@SortInd("titulo")</div>
                    @if (_colDesc) { <div class="tb-lc tb-lc-desc tb-lc-sort" @onclick='() => SortBy("descripcion")'><span>DESCRIPCION</span>@ColorDot("desc")</div> }
                    <div class="tb-lc tb-lc-est"><span>ETAPA</span>@ColorDot("est")</div>
                    @if (_colResp) { <div class="tb-lc tb-lc-resp tb-lc-sort" @onclick='() => SortBy("asignado")'><span>ASIGNADO</span>@SortInd("asignado")@ColorDot("resp")</div> }
                    <div class="tb-lc tb-lc-prog tb-lc-sort" @onclick='() => SortBy("progreso")'><span>PROGRESO</span>@SortInd("progreso")@ColorDot("prog")</div>
                    @if (_colEtiq) { <div class="tb-lc tb-lc-etiq"><span>ETIQUETAS</span>@ColorDot("etiq")</div> }
                    @if (_colPrio) { <div class="tb-lc tb-lc-prio tb-lc-sort" @onclick='() => SortBy("prioridad")'><span>PRIORIDAD</span>@SortInd("prioridad")@ColorDot("prio")</div> }
                    @if (_colDue) { <div class="tb-lc tb-lc-due tb-lc-sort" @onclick='() => SortBy("vence")'><span>VENCE</span>@SortInd("vence")@ColorDot("due")</div> }
                    @if (_colValor) { <div class="tb-lc tb-lc-valor tb-lc-sort tb-num" @onclick='() => SortBy("valor")'><span>VALOR</span>@SortInd("valor")@ColorDot("valor")</div> }
                    @if (_colOrigen) { <div class="tb-lc tb-lc-orig tb-lc-sort" @onclick='() => SortBy("origen")'><span>RELACIONADO CON</span>@SortInd("origen")@ColorDot("orig")</div> }
                    @foreach (var c in CamposVisibles) { var cid = c.Id.ToString(); var campo = c; <div class="tb-lc tb-lc-campo tb-cc-@c.Id tb-lc-sort @(CampoEsNumerico(c) ? "tb-num" : "")" @onclick="() => SortBy(cid)"><span>@c.Label.ToUpperInvariant()</span>@SortInd(cid)<button type="button" class="tb-lc-ed" title="Editar campo" @onclick:stopPropagation="true" @onclick="(e) => EditarCampoPop(e, campo)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>@ColorDot(cid)</div> }
                    <div class="tb-lc tb-lc-acc"><button type="button" class="tb-hdr-addcampo" @onclick="AbrirEditorCampo" title="Agregar campo (columna)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"/></svg>Campo</button></div>
                </div>
                @if (_cardGroup == "none")
                {
                    @* Sin agrupar: lista plana, sin encabezados de grupo. *@
                    @foreach (var t in AplicarSort(_tareas.Where(x => x.PadreId == null).Where(PasaFiltros).ToList()))
                    {
                        @RenderArbol(t, 0)
                    }
                }
                else if (string.IsNullOrEmpty(_cardGroup))
                {
                @foreach (var est in _board.Estados)
                {
                    var grupo = RaicesPorEstado(est.Id).Where(PasaFiltros).ToList();
                    grupo = AplicarSort(grupo).ToList();
                    @* Con filtros activos se ocultan las etapas que quedan sin tareas (no se muestran encabezados vacios). *@
                    if (HayFiltros && grupo.Count == 0) { continue; }
                    var estado = est;
                    @EncabezadoGrupoLista(estado.Nombre, estado.Color ?? "#94a3b8", grupo.Count, estado.Id, grupo)
                    @foreach (var t in grupo)
                    {
                        @RenderArbol(t, 0)
                    }
                    @* Fila "nueva tarea" inline estilo Excel: Tab salta entre campos, Enter crea.
                       @@key=nf usa la identidad del draft (se reemplaza por uno nuevo al crear/Esc)
                       para limpiar la fila; los inputs de texto usan @@oninput SIN value= para no
                       perder pulsaciones (value= se reafirma en cada re-render en Blazor Server). *@
                    var nf = NuevaFilaDe(estado.Id);
                    <div class="tb-newrow" @key="nf">
                        <div class="tb-row-tit @(_pinTitulo ? "tb-pin" : "")">
                            <span class="tb-newrow-plus">+</span>
                            <input class="tb-nf-inp tb-nf-tit" data-nf-tit="@estado.Id" placeholder="Nueva tarea..." @oninput="@(e => nf.Titulo = e.Value?.ToString() ?? string.Empty)" @onkeydown="@(e => NuevaFilaKeydown(e, estado.Id))" />
                        </div>
                        @if (_colDesc)
                        {
                            <div class="tb-row-desc"><input class="tb-nf-inp" placeholder="Descripcion" @oninput="@(e => nf.Descripcion = e.Value?.ToString())" @onkeydown="@(e => NuevaFilaKeydown(e, estado.Id))" /></div>
                        }
                        <div class="tb-row-cell-est">
                            <select class="tb-est-sel" style="background:#6D4FE3" @bind="nf.EstadoId">
                                @if (_board is not null) { @foreach (var es in _board.Estados) { <option value="@es.Id" style="background:#fff;color:#33475B">@es.Nombre</option> } }
                            </select>
                        </div>
                        @if (_colResp)
                        {
                            <div class="tb-row-resp">
                                <select class="tb-nf-inp" value="@(nf.Asignados.Count > 0 ? nf.Asignados[0].ToString() : "")" @onchange="@(e => SetNuevaFilaAsignado(nf, e))">
                                    <option value="">Sin asignar</option>
                                    @foreach (var p in _personas ?? new List<PersonaMini>()) { <option value="@p.Id">@p.Nombre</option> }
                                </select>
                            </div>
                        }
                        <div class="tb-row-prog"><span class="tb-nf-mut">&mdash;</span></div>
                        @if (_colEtiq) { <div class="tb-row-etiq"></div> }
                        @if (_colPrio)
                        {
                            <div class="tb-row-prio">
                                <select class="tb-prio-sel" style="color:@PrioFg(nf.Prioridad);background:@PrioBg(nf.Prioridad)" @bind="nf.Prioridad" @onkeydown="@(e => NuevaFilaKeydown(e, estado.Id))">
                                    @foreach (var pr in Enum.GetValues<PrioridadTarea>()) { <option value="@pr" style="background:#fff;color:#33475B">@pr</option> }
                                </select>
                            </div>
                        }
                        @if (_colDue)
                        {
                            <div class="tb-row-due"><input type="date" class="tb-nf-inp" @bind="nf.FechaVencimiento" @onkeydown="@(e => NuevaFilaKeydown(e, estado.Id))" /></div>
                        }
                        @if (_colValor)
                        {
                            <div class="tb-row-valor tb-num"><input type="number" step="1000" class="tb-nf-inp" placeholder="$" @bind="nf.Valor" @bind:event="oninput" @onkeydown="@(e => NuevaFilaKeydown(e, estado.Id))" /></div>
                        }
                        @if (_colOrigen)
                        {
                            <div class="tb-row-orig">
                                <select class="tb-orig-tsel" @onchange="@(e => { nf.OrigenTipo = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString(); nf.OrigenReferencia = null; })">
                                    <option value="" selected="@(nf.OrigenTipo is null)">Sin relacion</option>
                                    <option value="inmueble" selected="@(nf.OrigenTipo == "inmueble")">Inmueble</option>
                                    <option value="zona" selected="@(nf.OrigenTipo == "zona")">Zona comun</option>
                                    <option value="equipo" selected="@(nf.OrigenTipo == "equipo")">Equipo/activo</option>
                                </select>
                                @if (!string.IsNullOrEmpty(nf.OrigenTipo))
                                {
                                    <SelectorOrigenReferencia InputClass="tb-orig-rsel"
                                                              Placeholder="@OrigenPlaceholder(nf.OrigenTipo)"
                                                              Opciones="@OrigenBusquedaDe(nf.OrigenTipo)"
                                                              Value="@nf.OrigenReferencia"
                                                              ValueChanged="@(v => nf.OrigenReferencia = string.IsNullOrEmpty(v) ? null : v)" />
                                }
                            </div>
                        }
                        @foreach (var c in CamposVisibles)
                        {
                            var campo = c;
                            <div class="tb-row-campo tb-cc-@campo.Id @(CampoEsNumerico(campo) ? "tb-num" : "")">
                                @if (campo.Tipo == TipoCampoTablero.Numero || campo.Tipo == TipoCampoTablero.Moneda)
                                {
                                    <input type="number" class="tb-nf-inp" placeholder="@campo.Label" value="@(nf.Campos.GetValueOrDefault(campo.Id))" @oninput="@(e => nf.Campos[campo.Id] = e.Value?.ToString())" @onkeydown="@(e => NuevaFilaKeydown(e, estado.Id))" />
                                }
                                else if (campo.Tipo == TipoCampoTablero.Fecha)
                                {
                                    <input type="date" class="tb-nf-inp" value="@(nf.Campos.GetValueOrDefault(campo.Id))" @oninput="@(e => nf.Campos[campo.Id] = e.Value?.ToString())" @onkeydown="@(e => NuevaFilaKeydown(e, estado.Id))" />
                                }
                                else
                                {
                                    <input class="tb-nf-inp" placeholder="@campo.Label" value="@(nf.Campos.GetValueOrDefault(campo.Id))" @oninput="@(e => nf.Campos[campo.Id] = e.Value?.ToString())" @onkeydown="@(e => NuevaFilaKeydown(e, estado.Id))" />
                                }
                            </div>
                        }
                        <div class="tb-row-acc">
                            <button class="tb-nf-crear" title="Crear tarea (Enter)" @onclick="() => CrearDesdeNuevaFila(estado.Id)" disabled="@string.IsNullOrWhiteSpace(nf.Titulo)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"/></svg>
                            </button>
                        </div>
                    </div>
                }
                }
                else
                {
                    @* Agrupada por la dimension elegida (prioridad, responsable, torre, unidad, relacionado). *@
                    @foreach (var gr in AgruparLista())
                    {
                        @EncabezadoGrupoLista(gr.Key, null, gr.Items.Count, null, gr.Items)
                        @foreach (var t in gr.Items) { @RenderArbol(t, 0) }
                    }
                }
                @if (HayColumnasNumericas)
                {
                    @FilaResumen("TOTAL", true, _tareas.Where(x => x.PadreId == null).Where(PasaFiltros).ToList())
                }
            </div>
        }

        @* ---------- CALENDARIO (mensual por fecha de vencimiento) ---------- *@
        else if (_boardMode == "calendario")
        {
            <div class="tcal">
                <div class="tcal-head">
                    <button class="tcal-nav" title="Anterior" @onclick="() => CalMover(-1)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
                    <div class="tcal-title">@CalTitulo()</div>
                    <button class="tcal-nav" title="Siguiente" @onclick="() => CalMover(1)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></button>
                    <button class="tcal-today" @onclick="CalHoy">Hoy</button>
                    <div class="tb-flex"></div>
                    <div class="tcal-modes">
                        <button class="tcal-mode @(_calMode == "semana" ? "on" : "")" @onclick='() => _calMode = "semana"'>Semana</button>
                        <button class="tcal-mode @(_calMode == "mes" ? "on" : "")" @onclick='() => _calMode = "mes"'>Mes</button>
                    </div>
                </div>
                @if (_calMode == "mes")
                {
                    <div class="tcal-grid-h">
                        @foreach (var d in _diasSemana) { <div class="tcal-dow">@d</div> }
                    </div>
                    <div class="tcal-grid">
                        @foreach (var cell in CalCeldas())
                        {
                            <div class="tcal-cell @(cell.EsMes ? "" : "tcal-out") @(cell.EsFinde ? "tcal-finde" : "")">
                                <div class="tcal-daynum @(cell.EsHoy ? "tcal-hoy" : "")">@cell.Dia</div>
                                <div class="tcal-events">
                                    @foreach (var t in cell.Cards.Take(3))
                                    {
                                        var tarea = t;
                                        <button class="tcal-ev @(t.Vencida ? "venc" : "")" style="border-left-color:@(t.Color ?? t.EstadoColor ?? "#6D4FE3")" title="@t.Titulo - @TooltipEstado(t)" @onclick="() => AbrirCardDraft(tarea, null)">@t.Titulo</button>
                                    }
                                    @if (cell.Cards.Count > 3) { <span class="tcal-more">+@(cell.Cards.Count - 3) mas</span> }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="tcal-week">
                        @foreach (var d in CalSemanaDias())
                        {
                            <div class="tcal-wcol">
                                <div class="tcal-whead @(d.EsHoy ? "hoy" : "")">
                                    <div class="tcal-wdow">@d.Dow</div>
                                    <div class="tcal-wnum">@d.Dia <span class="tcal-wmes">@d.Mes</span></div>
                                </div>
                                <div class="tcal-wbody">
                                    @foreach (var t in d.Cards)
                                    {
                                        var tarea = t;
                                        <button class="tcal-wev" style="border-left-color:@(t.Color ?? t.EstadoColor ?? "#6D4FE3")" title="@TooltipEstado(t)" @onclick="() => AbrirCardDraft(tarea, null)">
                                            <div class="tcal-wev-t">@t.Titulo</div>
                                            @if (!string.IsNullOrWhiteSpace(t.AsignadoNombre)) { <div class="tcal-wev-r">@t.AsignadoNombre</div> }
                                        </button>
                                    }
                                    @if (d.Cards.Count == 0) { <div class="tcal-wempty">&mdash;</div> }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* ---------- GANTT (cronograma de barras inicio-fin) ---------- *@
        else if (_boardMode == "gantt")
        {
            var (gIni, gDias) = GanttRango();
            var hoy = DateOnly.FromDateTime(DateTime.Today);
            var filas = GanttTareas();
            var sinFecha = GanttSinFecha();
            <div class="tg">
                <div class="tg-titlebar">
                    <button class="tcal-nav" title="Anterior" @onclick="() => GanttMover(-1)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
                    <div class="tg-title">Cronograma · @FechaCortaSimple(gIni) – @FechaCortaSimple(gIni.AddDays(gDias - 1))</div>
                    <button class="tcal-nav" title="Siguiente" @onclick="() => GanttMover(1)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></button>
                    <button class="tcal-today" @onclick="GanttHoy">Hoy</button>
                    <div class="tb-flex"></div>
                    <span class="tcal-count">@filas.Count en cronograma</span>
                </div>
                <div class="tg-scroll">
                    <div class="tg-inner" style="width:@(240 + gDias * GColW)px">
                        @* cabecera de dias *@
                        <div class="tg-row tg-head">
                            <div class="tg-left tg-head-left">TAREA</div>
                            <div class="tg-time">
                                @for (int i = 0; i < gDias; i++)
                                {
                                    var d = gIni.AddDays(i);
                                    var fin = d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                    <div class="tg-daycol @(fin ? "tg-we" : "") @(d == hoy ? "tg-today" : "")" style="width:@(GColW)px">
                                        <div class="tg-dow">@DowLetra(d)</div>
                                        <div class="tg-dnum @(d == hoy ? "tg-dnum-hoy" : "")">@d.Day</div>
                                    </div>
                                }
                            </div>
                        </div>
                        @* filas de tareas (jerarquia: raices + subtareas expandibles) *@
                        @foreach (var (t, depth) in GanttFilasOrden())
                        {
                            var tarea = t;
                            var tieneFecha = GIni(t).HasValue;
                            var kids = Hijos(t.Id).Where(GanttVisible).ToList();
                            <div class="tg-row">
                                <div class="tg-left tg-task" style="padding-left:@(12 + depth * 16)px">
                                    @if (kids.Count > 0)
                                    {
                                        <button class="tg-exp" @onclick="() => ToggleExp(tarea.Id)" title="Ver subtareas">
                                            @if (_expandidas.Contains(t.Id)) { <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14"/></svg> }
                                            else { <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M5 12h14"/></svg> }
                                        </button>
                                    }
                                    else { <span class="tg-exp-sp"></span> }
                                    <span class="tg-dot" style="background:@(t.EstadoColor ?? "#94a3b8")"></span>
                                    <button class="tg-task-btn" @onclick="() => AbrirCardDraft(tarea, null)" title="@TooltipEstado(t)"><span class="tg-task-t" style="font-weight:@(depth == 0 ? 700 : 500)">@t.Titulo</span></button>
                                </div>
                                <div class="tg-time tg-lane">
                                    @for (int i = 0; i < gDias; i++)
                                    {
                                        var d = gIni.AddDays(i);
                                        var fin2 = d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                        <div class="tg-cell @(fin2 ? "tg-we" : "") @(d == hoy ? "tg-today" : "")" style="width:@(GColW)px"></div>
                                    }
                                    @if (tieneFecha)
                                    {
                                        var ini = GIni(t)!.Value; var fin = GFin(t)!.Value;
                                        var off = ini.DayNumber - gIni.DayNumber;
                                        var dur = Math.Max(1, fin.DayNumber - ini.DayNumber + 1);
                                        var visIni = Math.Max(0, off);
                                        var visFin = Math.Min(gDias, off + dur);
                                        @* solo dibujamos la barra si intersecta la ventana visible; la recortamos a los bordes *@
                                        @if (visFin > visIni)
                                        {
                                            var clipL = off < 0;             // empieza antes de la ventana
                                            var clipR = off + dur > gDias;   // termina despues de la ventana
                                            <button class="tg-bar @(clipL ? "tg-bar-cl" : "") @(clipR ? "tg-bar-cr" : "")" style="left:@(visIni * GColW + 2)px;width:@((visFin - visIni) * GColW - 4)px;background:@(t.Color ?? t.EstadoColor ?? "#6D4FE3")" @onclick="() => AbrirCardDraft(tarea, null)" title="@t.Titulo (@t.Progreso%)">
                                                @if (t.Progreso < 100) { <span class="tg-bar-rest" style="left:@(t.Progreso)%"></span> }
                                                <span class="tg-bar-lbl">@t.Titulo</span>
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (sinFecha.Count > 0)
                {
                    <div class="tg-note">@sinFecha.Count tarea@(sinFecha.Count == 1 ? "" : "s") sin fechas no se muestran en el cronograma.</div>
                }
            </div>
        }
        }
    }
</div>

@* ===================== Modal crear/editar tablero ===================== *@
@if (_tableroDraft is not null)
{
    <div class="tb-modal-bd" @onclick="() => _tableroDraft = null">
        <div class="tb-modal" @onclick:stopPropagation="true">
            <div class="tb-modal-head">
                <div class="tb-modal-tt">
                    <div class="tb-modal-h">@(_tableroDraft.Id is null ? "Nuevo tablero" : "Editar tablero")</div>
                    <div class="tb-modal-s">Nombre, color y equipo de trabajo</div>
                </div>
                <button class="tb-modal-x" @onclick="() => _tableroDraft = null"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="tb-modal-body">
                <div class="tb-fld"><label>Nombre del tablero *</label><input @bind="_tableroDraft.Nombre" placeholder="Ej. Mantenimiento general" /></div>
                <div class="tb-fld"><label>Descripcion</label><textarea rows="2" @bind="_tableroDraft.Descripcion" placeholder="Para que sirve este tablero?"></textarea></div>
                <div class="tb-fld">
                    <label>Color</label>
                    <div class="tb-colors">
                        @foreach (var c in _colores)
                        {
                            var col = c;
                            <button class="tb-color @(_tableroDraft.Color == col ? "on" : "")" style="background:@col" @onclick="() => _tableroDraft.Color = col"></button>
                        }
                    </div>
                </div>
                <div class="tb-fld">
                    <label>Usuarios que pueden trabajar en el tablero</label>
                    <div class="tb-userpick">
                        @if (_tableroDraft.UsuarioIds.Count > 0)
                        {
                            <div class="tb-chips">
                                @foreach (var pid in _tableroDraft.UsuarioIds)
                                {
                                    var id = pid;
                                    var info = SelInfo(pid);
                                    <span class="tb-chip">
                                        @if (!string.IsNullOrEmpty(info.Foto))
                                        {
                                            <img class="tb-chip-ava" src="@info.Foto" alt="" />
                                        }
                                        else
                                        {
                                            <span class="tb-ava tb-ava-sm">@Iniciales(info.Nombre)</span>
                                        }
                                        <span class="tb-chip-nom">@info.Nombre</span>
                                        <button type="button" class="tb-chip-x" @onclick="() => QuitarMiembroTb(id)" title="Quitar">&times;</button>
                                    </span>
                                }
                            </div>
                        }
                        <div class="tb-search-wrap">
                            <input class="tb-input" placeholder="Buscar persona por nombre, documento o correo..." @bind="_tbBuscar" @bind:event="oninput" @onkeyup="BuscarPersonasTb" autocomplete="off" />
                            @if (_tbResultados.Count > 0)
                            {
                                <div class="tb-search-drop">
                                    @foreach (var p in _tbResultados.Where(x => !_tableroDraft.UsuarioIds.Contains(x.Id)))
                                    {
                                        var per = p;
                                        var nombre = $"{p.Nombres} {p.Apellidos}".Trim();
                                        <button type="button" class="tb-search-item" @onclick="() => AgregarMiembroTb(per)">
                                            @if (!string.IsNullOrEmpty(p.FotoUrl))
                                            {
                                                <img class="tb-chip-ava" src="@p.FotoUrl" alt="" />
                                            }
                                            else
                                            {
                                                <span class="tb-ava tb-ava-sm">@Iniciales(nombre)</span>
                                            }
                                            <span class="tb-search-nom">@nombre</span>
                                            <span class="tb-search-doc">@p.Documento</span>
                                        </button>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_tbBuscar) && _tbBuscar.Trim().Length >= 2)
                            {
                                <div class="tb-search-empty">Sin resultados en el directorio.</div>
                            }
                        </div>
                    </div>
                </div>
                @if (_tableroDraft.Id is not null)
                {
                    <div class="tb-fld tb-invite">
                        <label>Invitar a un externo por correo</label>
                        <div class="tb-invite-hint">Se crea su cuenta y queda con acceso a este tablero. Recibe un enlace por correo que vence en 72 horas.</div>
                        <div class="tb-invite-grid">
                            <input class="tb-input" type="email" placeholder="correo@@ejemplo.com" @bind="_extEmail" autocomplete="off" />
                            <input class="tb-input" placeholder="Nombre y apellido" @bind="_extNombre" autocomplete="off" />
                            <select class="tb-input" @bind="_extRolId">
                                <option value="">Rol...</option>
                                @foreach (var r in _rolesInv) { <option value="@r.Id">@r.Nombre</option> }
                            </select>
                            <button class="tb-btn tb-btn-primary" @onclick="InvitarExterno"
                                    disabled="@(_extBusy || string.IsNullOrWhiteSpace(_extEmail) || string.IsNullOrWhiteSpace(_extNombre) || string.IsNullOrEmpty(_extRolId))">
                                @(_extBusy ? "Enviando..." : "Invitar")
                            </button>
                        </div>
                        @if (_extMsg is not null)
                        {
                            <div class="tb-invite-msg @(_extError ? "err" : "ok")">@_extMsg</div>
                        }
                        @if (!string.IsNullOrEmpty(_extLink))
                        {
                            <div class="tb-invite-link">
                                <input class="tb-input" readonly value="@_extLink" />
                                <button class="tb-btn tb-btn-ghost" @onclick="CopiarLinkExt">Copiar</button>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="tb-modal-foot">
                @if (_tableroDraft.Id is not null) { <button class="tb-btn-danger" @onclick="EliminarTablero"><i class="fi fi-rr-trash"></i>Eliminar</button> }
                <div class="tb-flex"></div>
                <button class="tb-btn tb-btn-ghost" @onclick="() => _tableroDraft = null">Cancelar</button>
                <button class="tb-btn tb-btn-primary" @onclick="GuardarTablero" disabled="@(_busy || string.IsNullOrWhiteSpace(_tableroDraft.Nombre))">@(_busy ? "Guardando..." : "Guardar tablero")</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal Cerrar tarea (motivo de cierre) ===================== *@
@if (_cierreTarget is not null)
{
    <div class="tb-modal-bd" @onclick="() => _cierreTarget = null">
        <div class="tb-cierre" @onclick:stopPropagation="true">
            <div class="tb-cierre-h">Cerrar tarea</div>
            @if (!string.IsNullOrEmpty(_cierreTareaTitulo)) { <div class="tb-cierre-sub">@_cierreTareaTitulo</div> }
            <label class="tb-cierre-lbl">Motivo de cierre *</label>
            <select class="tb-cierre-sel" @bind="_cierreMotivoId">
                <option value="">Elige un motivo...</option>
                @foreach (var m in _motivosTareas.Where(x => x.Activo))
                {
                    <option value="@m.Id">@m.Nombre (@ClasifTareaTexto(m.Clasificacion))</option>
                }
            </select>
            <p class="tb-cierre-hint">Al cerrar, la tarea desaparece del tablero activo y queda en la pestana "Cerrados".</p>
            <div class="tb-cierre-foot">
                <button class="tb-btn tb-btn-ghost" @onclick="async () => { _cierreTarget = null; await RecargarBoard(); }">Cancelar</button>
                <button class="tb-btn tb-btn-primary" @onclick="ConfirmarCierreTarea" disabled="@string.IsNullOrEmpty(_cierreMotivoId)">Cerrar tarea</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal Configurar tablero (estados + campos) ===================== *@
@if (_cfgOpen && _board is not null)
{
    <div class="tb-modal-bd" @onclick="CerrarConfigBoard">
        <div class="tb-modal" @onclick:stopPropagation="true">
            <div class="tb-modal-head">
                <div class="tb-modal-tt">
                    <div class="tb-modal-h">Configurar tablero</div>
                    <div class="tb-modal-s">@_board.Tablero.Nombre · estados y campos</div>
                </div>
                <button class="tb-modal-x" @onclick="CerrarConfigBoard"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="tb-modal-body">
                <div>
                    <div class="tbcfg-h">ESTADOS (COLUMNAS)</div>
                    <div class="tbcfg-list">
                        @foreach (var e in _board.Estados)
                        {
                            var est = e;
                            <div class="tbcfg-est">
                                <span class="tbcfg-dot" style="background:@(e.Color ?? "#94a3b8")"></span>
                                <span class="tbcfg-est-nom">@e.Nombre</span>
                                <span class="tbcfg-est-cnt">@CountEstado(e.Id) tarjetas</span>
                                @if (!e.EsBase && !e.EsTerminal)
                                {
                                    <button class="tbcfg-del" title="Quitar estado" @onclick="() => CfgRemoveEstado(est.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
                                }
                            </div>
                        }
                    </div>
                    <div class="tbcfg-add">
                        <input @bind="_cfgEstadoNew" @bind:event="oninput" placeholder="Nuevo estado (ej. En revision)" />
                        <button class="tb-btn tb-btn-primary" @onclick="CfgAddEstado" disabled="@(_busy || string.IsNullOrWhiteSpace(_cfgEstadoNew))">Agregar</button>
                    </div>
                </div>
                <div>
                    <div class="tbcfg-h">ETIQUETAS</div>
                    <div class="tbcfg-help">Se crean y colorean aqui. Son exclusivas de este tablero. En las tarjetas solo se asignan.</div>
                    <div class="tbcfg-tags">
                        @foreach (var et in _etiquetasCat)
                        {
                            var tag = et;
                            var col = string.IsNullOrWhiteSpace(et.Color) ? "#6D4FE3" : et.Color!;
                            <div class="tbcfg-tag">
                                <span class="tb-tag" style="background:@col;border-color:@col;color:@TagTextColor(col)">
                                    @if (_tagEditId == et.Id)
                                    {
                                        <input class="tb-tag-inp" @bind="_tagEditVal" @bind:event="oninput" @onblur="() => GuardarTagNombre(tag)" @onkeydown="(e) => TagKeydown(e, tag)" />
                                    }
                                    else
                                    {
                                        <span class="tb-tag-tx" title="Click para renombrar" @onclick="() => IniciarTagEdit(tag)">@et.Nombre</span>
                                    }
                                    <button type="button" class="tb-tag-sw" title="Cambiar color" @onclick:stopPropagation="true" @onclick="() => ToggleTagColor(et.Id)"></button>
                                    @if (_tagColorId == et.Id)
                                    {
                                        <div class="tb-tagpop-bd" @onclick="() => _tagColorId = null"></div>
                                        <div class="tb-tag-colors" @onclick:stopPropagation="true">
                                            @foreach (var c in _colores)
                                            {
                                                var cc = c;
                                                <button type="button" class="tb-tag-copt @(string.Equals(et.Color, cc, StringComparison.OrdinalIgnoreCase) ? "on" : "")" style="background:@cc" @onclick="() => GuardarTagColor(tag, cc)"></button>
                                            }
                                        </div>
                                    }
                                </span>
                                <span class="tbcfg-tag-cnt" title="Tareas que la usan">@et.CantidadTareas</span>
                                <button class="tbcfg-del" title="Eliminar etiqueta" @onclick="() => EliminarEtiquetaCfg(tag.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
                            </div>
                        }
                        @if (_etiquetasCat.Count == 0) { <div class="tbcfg-help">Aun no hay etiquetas en este tablero.</div> }
                    </div>
                    <div class="tbcfg-add">
                        <input @bind="_nuevaEtiqueta" @bind:event="oninput" placeholder="Nueva etiqueta de este tablero" @onkeydown="EtiquetaKeyDown" />
                        <button class="tb-btn tb-btn-primary" @onclick="CrearEtiquetaCfg" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaEtiqueta))">Agregar</button>
                    </div>
                </div>
                <div>
                    <div class="tbcfg-h">CAMPOS PERSONALIZADOS</div>
                    <div class="tbcfg-help">Define campos tipados que apareceran en cada tarjeta, en los filtros y como columnas de la lista.</div>
                    @if (_board.Tablero.Campos is { Count: > 0 })
                    {
                        <div class="tbcfg-campos">
                            @foreach (var c in _board.Tablero.Campos)
                            {
                                var campo = c;
                                <div class="tbcfg-campo @(_campoDraft.Id == c.Id ? "on" : "")">
                                    <div class="tbcfg-campo-id">
                                        <span class="tbcfg-campo-nom">@c.Label</span>
                                        <span class="tbcfg-campo-tipo">@TipoCampoLabel(c.Tipo)</span>
                                        @if (c.MostrarEnFiltro) { <span class="tbcfg-campo-filt" title="Aparece en filtros">filtro</span> }
                                    </div>
                                    <button class="tbcfg-campo-ed" title="Editar" @onclick="() => CfgEditCampo(campo)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                                    <button class="tbcfg-campo-ed" title="Archivar (ocultar sin borrar datos)" @onclick="() => ArchivarCampo(campo.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/></svg></button>
                                    <button class="tbcfg-del" title="Eliminar (borra los datos)" @onclick="() => CfgRemoveCampo(campo.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
                                </div>
                            }
                        </div>
                    }
                    @if (_camposArchivados is { Count: > 0 })
                    {
                        <div class="tbcfg-arch">
                            <div class="tbcfg-arch-h">ARCHIVADOS <span>@_camposArchivados.Count</span></div>
                            <div class="tbcfg-help">Conservan sus datos. Restaura para volver a usarlos, o elimina para borrarlos definitivamente.</div>
                            @foreach (var a in _camposArchivados)
                            {
                                var ac = a;
                                <div class="tbcfg-arch-it">
                                    <span class="tbcfg-campo-nom">@a.Label</span>
                                    <span class="tbcfg-campo-tipo">@TipoCampoLabel(a.Tipo)</span>
                                    <div class="tb-flex"></div>
                                    <button class="tbcfg-arch-restore" @onclick="() => RestaurarCampo(ac.Id)">Restaurar</button>
                                    <button class="tbcfg-del" title="Eliminar definitivamente (borra los datos)" @onclick="() => CfgRemoveCampo(ac.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
                                </div>
                            }
                        </div>
                    }
                    <div class="tbcfg-editor">
                        <div class="tbcfg-editor-h">@(_campoDraft.Id is null ? "Nuevo campo" : "Editar campo")</div>
                        <div class="tbcfg-erow">
                            <input class="tbcfg-in" @bind="_campoDraft.Label" @bind:event="oninput" placeholder="Nombre del campo (ej. Costo estimado)" />
                            <select class="tbcfg-in tbcfg-in-sm" @bind="_campoDraft.Tipo">
                                @foreach (var tp in Enum.GetValues<TipoCampoTablero>()) { <option value="@tp">@TipoCampoLabel(tp)</option> }
                            </select>
                        </div>
                        @if (_campoDraft.Tipo == TipoCampoTablero.Seleccion)
                        {
                            <textarea class="tbcfg-in" rows="3" @bind="_campoDraft.Opciones" @bind:event="oninput" placeholder="Una opcion por linea"></textarea>
                        }
                        @if (_campoDraft.Tipo == TipoCampoTablero.Total)
                        {
                            <div class="tbcfg-suma">
                                <div class="tbcfg-suma-h">Campos a sumar (Numero / Moneda)</div>
                                @if (!CamposSumables.Any())
                                {
                                    <div class="tbcfg-suma-empty">Crea antes campos de tipo Numero o Moneda para sumarlos.</div>
                                }
                                @foreach (var s in CamposSumables)
                                {
                                    var sid = s.Id;
                                    <label class="tbcfg-chkl"><input type="checkbox" checked="@_campoDraft.CamposSuma.Contains(sid)" @onchange="() => ToggleCampoSuma(sid)" /> @s.Label</label>
                                }
                            </div>
                        }
                        <input class="tbcfg-in" @bind="_campoDraft.Descripcion" @bind:event="oninput" placeholder="@(_campoDraft.Tipo == TipoCampoTablero.Separador ? "Titulo de la seccion (divisoria)" : "Descripcion / ayuda (opcional)")" />
                        @if (_campoDraft.Tipo != TipoCampoTablero.Separador && _campoDraft.Tipo != TipoCampoTablero.Total)
                        {
                            <input class="tbcfg-in" @bind="_campoDraft.ValorPorDefecto" @bind:event="oninput" placeholder="Valor por defecto (opcional)" />
                            <div class="tbcfg-erow">
                                <label class="tbcfg-chkl"><input type="checkbox" @bind="_campoDraft.Requerido" /> Requerido</label>
                                <label class="tbcfg-chkl"><input type="checkbox" @bind="_campoDraft.PermiteVarios" /> Permitir varios valores</label>
                            </div>
                        }
                        <div class="tbcfg-erow">
                            <label class="tbcfg-chkl"><input type="checkbox" @bind="_campoDraft.MostrarEnFiltro" /> Mostrar en filtros</label>
                            <select class="tbcfg-in tbcfg-in-sm" @bind="_campoDraft.Columna">
                                <option value="1">Ancho normal</option>
                                <option value="2">Ancho completo</option>
                            </select>
                        </div>
                        <div class="tbcfg-erow tbcfg-erow-end">
                            @if (_campoDraft.Id is not null) { <button class="tb-btn tb-btn-ghost" @onclick="CfgNuevoCampo">Cancelar</button> }
                            <button class="tb-btn tb-btn-primary" @onclick="CfgGuardarCampo" disabled="@(_busy || string.IsNullOrWhiteSpace(_campoDraft.Label))">@(_campoDraft.Id is null ? "Agregar campo" : "Guardar campo")</button>
                        </div>
                    </div>
                </div>
                <div class="tbcfg-sec">
                    <div class="tbcfg-h">MOTIVOS DE CIERRE</div>
                    <p class="tbcfg-hint">Al cerrar una tarea se elige uno de estos motivos; cada uno trae su clasificacion.</p>
                    @foreach (var m in _motivosTareas.OrderBy(x => x.Orden))
                    {
                        var mm = m;
                        <div class="tbcfg-erow">
                            <input class="tbcfg-in" value="@m.Nombre" @onchange="(ev) => RenombrarMotivoTarea(mm, ev)" />
                            <select class="tbcfg-in tbcfg-in-sm" @onchange="(ev) => ClasifMotivoTarea(mm, ev)">
                                <option value="1" selected="@(m.Clasificacion == ClasificacionCierre.CierreCorrecto)">Cierre correcto</option>
                                <option value="2" selected="@(m.Clasificacion == ClasificacionCierre.ViaInternaAgotada)">Via interna agotada</option>
                                <option value="3" selected="@(m.Clasificacion == ClasificacionCierre.Perdida)">Perdida</option>
                            </select>
                            <button class="tb-btn tb-btn-ghost" @onclick="() => EliminarMotivoTarea(mm.Id)">@(m.EsBase ? "Desactivar" : "Eliminar")</button>
                        </div>
                    }
                    <div class="tbcfg-erow tbcfg-erow-end">
                        <input class="tbcfg-in" placeholder="Nuevo motivo de cierre..." @bind="_nuevoMotivoTareaNombre" />
                        <select class="tbcfg-in tbcfg-in-sm" @bind="_nuevoMotivoTareaClasif">
                            <option value="1">Cierre correcto</option>
                            <option value="2">Via interna agotada</option>
                            <option value="3">Perdida</option>
                        </select>
                        <button class="tb-btn tb-btn-primary" @onclick="AgregarMotivoTarea" disabled="@string.IsNullOrWhiteSpace(_nuevoMotivoTareaNombre)">Agregar motivo</button>
                    </div>
                </div>
            </div>
            <div class="tb-modal-foot">
                <div class="tb-flex"></div>
                <button class="tb-btn tb-btn-primary" @onclick="CerrarConfigBoard">Listo</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal tarjeta (rico, fiel al prototipo) ===================== *@
@if (_cardDraft is not null && _board is not null)
{
    var d = _cardDraft;
    <div class="tb-modal-bd" @onclick="CerrarCard">
        <div class="tbc-modal" @onclick:stopPropagation="true">
            @* ----- Cabecera con color de la tarjeta ----- *@
            <div class="tbc-head" style="background:@d.Color">
                <div class="tbc-head-bar"></div>
                <div class="tbc-head-id">
                    <div class="tbc-head-tt">
                        @(d.Id is null ? "Nueva tarea" : "Detalle de la tarea")
                        @if (d.EsProyecto)
                        {
                            <span class="tbc-proy"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 7h7l2 2h9v11H3z"/></svg>PROYECTO</span>
                        }
                    </div>
                    <div class="tbc-head-bc">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg>
                        <span>@_coNombre</span>
                        @if (d.PadreId is not null) { <span class="tbc-sep">&rsaquo;</span><span class="tbc-bold">Subtarea de @d.PadreTitulo</span> }
                        @if (d.CopiadaDeTareaId is not null) { <span class="tbc-sep">&rsaquo;</span><button type="button" class="tbc-copia-bc" title="Abrir tarea original" @onclick="AbrirCopiaOriginal"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>Copia de @d.CopiadaDeTitulo</button> }
                        @if (!string.IsNullOrEmpty(d.OrigenTipo)) { <span class="tbc-sep">&rsaquo;</span><span>@OrigenTipoLabel(d.OrigenTipo)</span> }
                        @if (!string.IsNullOrEmpty(d.OrigenReferencia)) { <span class="tbc-sep">&rsaquo;</span><span class="tbc-bold">@d.OrigenReferencia</span> }
                    </div>
                </div>
                <button class="tbc-head-btn @(d.EsProyecto ? "on" : "")" @onclick="() => d.EsProyecto = !d.EsProyecto" title="Marcar como proyecto">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h7l2 2h9v11H3z"/></svg>@(d.EsProyecto ? "Es proyecto" : "Marcar proyecto")
                </button>
                <button class="tbc-head-x" @onclick="CerrarCard"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>

            @* ----- Pestanas: Detalle (incluye actividad tipo chat) / Archivos / Historial ----- *@
            <div class="tbc-tabs">
                <button type="button" class="tbc-tab @(_cardTab == "detalle" ? "on" : "")" @onclick='() => _cardTab = "detalle"'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg>Detalle
                </button>
                <button type="button" class="tbc-tab @(_cardTab == "archivos" ? "on" : "")" @onclick='() => _cardTab = "archivos"'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15l-5-5L5 21M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="8.5" cy="8.5" r="1.5"/></svg>Archivos @if (d.Adjuntos.Count > 0) { <span class="tbc-tab-badge">@d.Adjuntos.Count</span> }
                </button>
                <button type="button" class="tbc-tab @(_cardTab == "historial" ? "on" : "")" @onclick='() => _cardTab = "historial"'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Historial @if (d.Historial.Count > 0) { <span class="tbc-tab-badge">@d.Historial.Count</span> }
                </button>
            </div>

            @if (_cardTab == "detalle")
            {
            <div class="tbc-body">
                @* ----- Columna 1: titulo, descripcion, origen, color, checklist ----- *@
                <div class="tbc-col">
                    <div class="tbc-fld"><label>Titulo *</label><input @bind="d.Titulo" placeholder="Ej. Cambio de luminarias piso 3" /></div>
                    <div class="tbc-fld"><label>Descripcion</label><textarea rows="3" @bind="d.Descripcion" placeholder="Detalle de la tarea..."></textarea></div>

                    <div class="tbc-row2">
                        <div class="tbc-fld tbc-grow">
                            <label>Estado</label>
                            <select class="tbc-estado-sel" value="@d.EstadoId" @onchange="OnCardEstadoChange">
                                @foreach (var e in _board.Estados)
                                {
                                    <option value="@e.Id">@e.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="tbc-fld tbc-grow">
                            <label>Prioridad</label>
                            <select @bind="d.Prioridad">
                                @foreach (var p in Enum.GetValues<PrioridadTarea>())
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="tbc-origen">
                        <div class="tbc-origen-h">ORIGEN DE LA TAREA</div>
                        <div class="tbc-origen-row">
                            <div class="tbc-fld tbc-grow">
                                <label>Relacionado con</label>
                                <select value="@(d.OrigenTipo ?? "")" @onchange="CardSetOrigenTipo">
                                    <option value="">Sin relacion</option>
                                    <option value="inmueble">Inmueble / unidad</option>
                                    <option value="zona">Zona comun</option>
                                    <option value="equipo">Equipo / activo</option>
                                </select>
                            </div>
                            @if (!string.IsNullOrEmpty(d.OrigenTipo))
                            {
                                <div class="tbc-fld tbc-grow">
                                    <label>Origen</label>
                                    <SelectorOrigenReferencia InputClass="tbc-origen-sel"
                                                              Placeholder="@OrigenPlaceholder(d.OrigenTipo)"
                                                              Opciones="@OrigenBusquedaDe(d.OrigenTipo)"
                                                              Value="@d.OrigenReferencia"
                                                              ValueChanged="@(v => d.OrigenReferencia = string.IsNullOrEmpty(v) ? null : v)" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="tbc-fld">
                        <label>Color de la tarjeta</label>
                        <div class="tb-colors">
                            @foreach (var c in _colores) { var col = c; <button class="tb-color @(d.Color == col ? "on" : "")" style="background:@col" @onclick="() => d.Color = col"></button> }
                        </div>
                    </div>

                    @* Subtareas REALES (tareas hijas con PadreId): anidan en modo lista y muestran el chip "N sub" en tarjetas. *@
                    @if (d.Id is not null)
                    {
                        var kids = Hijos(d.Id.Value);
                        <div class="tbc-fld">
                            <label>Subtareas @if (kids.Count > 0) { <span class="tbc-mut">- @kids.Count(k => k.EstadoEsTerminal)/@kids.Count</span> }</label>
                            <div class="tbc-sublist">
                                @foreach (var k in kids)
                                {
                                    var kid = k;
                                    <div class="tbc-sub tbc-subtask" @onclick="() => AbrirCardDraft(kid, null)" title="Abrir subtarea">
                                        <span class="tbc-sub-dot" style="background:@(k.EstadoColor ?? "#6D4FE3")"></span>
                                        <span class="tbc-sub-t @(k.EstadoEsTerminal ? "done" : "")">@k.Titulo</span>
                                        <span class="tbc-sub-est">@k.EstadoNombre</span>
                                    </div>
                                }
                                <div class="tbc-sub-add">
                                    <input @bind="_subtareaNew" @bind:event="oninput" placeholder="Nueva subtarea (tarea hija)..." />
                                    <button class="tbc-add-btn" @onclick="CrearSubtareaRapida" disabled="@(_busy || string.IsNullOrWhiteSpace(_subtareaNew))"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>Agregar</button>
                                </div>
                            </div>
                        </div>
                    }

                    @* Traza de COPIAS: copias independientes hechas desde esta tarea (NO son subtareas). *@
                    @if (d.Id is not null && d.Copias.Count > 0)
                    {
                        <div class="tbc-fld">
                            <label>Copias de esta tarea <span class="tbc-mut">- @d.Copias.Count</span></label>
                            <div class="tbc-sublist">
                                @foreach (var cp in d.Copias)
                                {
                                    var copia = cp;
                                    <div class="tbc-sub tbc-subtask" @onclick="() => AbrirCardDraft(copia, null)" title="Abrir copia">
                                        <span class="tbc-copia-ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg></span>
                                        <span class="tbc-sub-t">@copia.Titulo</span>
                                        <span class="tbc-sub-est">@copia.EstadoNombre</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="tbc-fld">
                        <label>Checklist @if (d.Checklist.Count > 0) { <span class="tbc-mut">- @d.Checklist.Count(x => x.Hecho)/@d.Checklist.Count</span> }</label>
                        <div class="tbc-sublist">
                            @for (int i = 0; i < d.Checklist.Count; i++)
                            {
                                var idx = i; var st = d.Checklist[i];
                                <div class="tbc-sub">
                                    <button class="tbc-chk @(st.Hecho ? "on" : "")" @onclick="() => CardToggleSub(idx)">
                                        @if (st.Hecho) { <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><path d="M5 12l5 5 9-11"/></svg> }
                                    </button>
                                    <span class="tbc-sub-t @(st.Hecho ? "done" : "")">@st.Titulo</span>
                                    <button class="tbc-sub-x" @onclick="() => CardRemoveSub(idx)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                                </div>
                            }
                            <div class="tbc-sub-add">
                                <input @bind="_subNew" @bind:event="oninput" placeholder="Nuevo item del checklist..." />
                                <button class="tbc-add-btn" @onclick="CardAddSub"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="tbc-fld">
                        <div class="tbc-campos-h">
                            <label>Campos personalizados</label>
                            @* Misma potencia de configuracion que "Configurar tablero", pero desde la tarjeta. *@
                            <button type="button" class="tbc-addcampo" @onclick="AbrirEditorCampo" title="Agregar y configurar un campo del tablero"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>Agregar campo</button>
                        </div>
                        @if (_board.Tablero.Campos is { Count: > 0 })
                        {
                            <div class="tbc-campos">
                                @foreach (var c in _board.Tablero.Campos)
                                {
                                    var campo = c;
                                    <div class="tbc-campo @((c.Columna >= 2 || c.Tipo == TipoCampoTablero.Separador) ? "full" : "")">
                                        @if (c.Tipo == TipoCampoTablero.Separador)
                                        {
                                            <div class="tbc-sep">
                                                <span>@(string.IsNullOrWhiteSpace(c.Descripcion) ? c.Label : c.Descripcion)</span>
                                                <div class="tbc-campo-acts">
                                                    <button type="button" class="tbc-campo-mv" title="Subir" @onclick:stopPropagation="true" @onclick="() => MoverCampo(campo.Id, -1)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 15l-6-6-6 6"/></svg></button>
                                                    <button type="button" class="tbc-campo-mv" title="Bajar" @onclick:stopPropagation="true" @onclick="() => MoverCampo(campo.Id, 1)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 9l6 6 6-6"/></svg></button>
                                                    <button type="button" class="tbc-campo-ed2" title="Editar campo" @onclick:stopPropagation="true" @onclick="(e) => EditarCampoPop(e, campo)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                                                    <button type="button" class="tbc-campo-mv" title="Archivar (ocultar sin borrar los datos)" @onclick:stopPropagation="true" @onclick="() => ArchivarCampo(campo.Id)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/></svg></button>
                                                    <button type="button" class="tbc-campo-del" title="Eliminar campo (borra los datos)" @onclick:stopPropagation="true" @onclick="() => CfgRemoveCampo(campo.Id)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="tbc-campo-lblrow">
                                                <label class="tbc-campo-lbl" title="@c.Descripcion">@c.Label@(c.Requerido ? " *" : "")</label>
                                                <div class="tbc-campo-acts">
                                                    <button type="button" class="tbc-campo-mv" title="Subir" @onclick:stopPropagation="true" @onclick="() => MoverCampo(campo.Id, -1)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 15l-6-6-6 6"/></svg></button>
                                                    <button type="button" class="tbc-campo-mv" title="Bajar" @onclick:stopPropagation="true" @onclick="() => MoverCampo(campo.Id, 1)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 9l6 6 6-6"/></svg></button>
                                                    <button type="button" class="tbc-campo-ed2" title="Editar campo" @onclick:stopPropagation="true" @onclick="(e) => EditarCampoPop(e, campo)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                                                    <button type="button" class="tbc-campo-mv" title="Archivar (ocultar sin borrar los datos)" @onclick:stopPropagation="true" @onclick="() => ArchivarCampo(campo.Id)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/></svg></button>
                                                    <button type="button" class="tbc-campo-del" title="Eliminar campo (borra los datos)" @onclick:stopPropagation="true" @onclick="() => CfgRemoveCampo(campo.Id)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                                                </div>
                                            </div>
                                            @if (c.Tipo == TipoCampoTablero.Total)
                                            {
                                                <input type="text" class="tbc-total" readonly value="@CalcularTotal(c)" />
                                            }
                                            else if (c.PermiteVarios)
                                            {
                                                <textarea rows="2" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="Un valor por linea"></textarea>
                                            }
                                            else
                                            {
                                                @switch (c.Tipo)
                                                {
                                                    case TipoCampoTablero.AreaTexto:
                                                        <textarea rows="2" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="@c.Descripcion"></textarea>
                                                        break;
                                                    case TipoCampoTablero.Numero:
                                                    case TipoCampoTablero.Moneda:
                                                        <input type="number" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="@c.Descripcion" />
                                                        break;
                                                    case TipoCampoTablero.Fecha:
                                                        <input type="date" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" />
                                                        break;
                                                    case TipoCampoTablero.Hora:
                                                        <input type="time" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" />
                                                        break;
                                                    case TipoCampoTablero.Telefono:
                                                        <input type="tel" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="@c.Descripcion" />
                                                        break;
                                                    case TipoCampoTablero.Url:
                                                        <input type="url" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="https://..." />
                                                        break;
                                                    case TipoCampoTablero.Email:
                                                        <input type="email" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="correo@@ejemplo.com" />
                                                        break;
                                                    case TipoCampoTablero.Seleccion:
                                                        <select value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)">
                                                            <option value="">Seleccionar...</option>
                                                            @foreach (var op in CampoOpciones(c)) { <option value="@op">@op</option> }
                                                        </select>
                                                        break;
                                                    case TipoCampoTablero.Booleano:
                                                        <label class="tbc-campo-bool"><input type="checkbox" checked="@CampoBool(campo.Id)" @onchange="(e) => SetCampoBool(campo.Id, e)" /> Si</label>
                                                        break;
                                                    default:
                                                        <input type="text" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="@c.Descripcion" />
                                                        break;
                                                }
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                        </div>
                </div>

                @* ----- Columna 2: progreso, etiquetas, responsables, fechas, valor ----- *@
                <div class="tbc-col">
                    @if (d.Id is not null)
                    {
                        <div class="tbc-fld">
                            <label>Progreso @if (d.TieneHijos) { <span class="tbc-mut">- se calcula desde las subtareas</span> }</label>
                            @if (d.TieneHijos)
                            {
                                <div class="tbc-prog-ro">
                                    <div class="tb-prog-bar"><div class="tb-prog-fill" style="width:@(d.Progreso)%;background:@(d.Progreso >= 100 ? "#1A8754" : "#6D4FE3")"></div></div>
                                    <span class="tbc-prog-v" style="color:@(d.Progreso >= 100 ? "#1A8754" : "#516F90")">@d.Progreso%</span>
                                </div>
                            }
                            else
                            {
                                <div class="tbc-prog-edit">
                                    <input type="range" min="0" max="100" step="5" @bind="d.Progreso" @bind:event="oninput" style="accent-color:@(d.Progreso >= 100 ? "#1A8754" : "#6D4FE3")" />
                                    <span class="tbc-prog-v" style="color:@(d.Progreso >= 100 ? "#1A8754" : "#516F90")">@d.Progreso%</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="tbc-fld">
                        <label>Etiquetas</label>
                        <div class="tbc-tags">
                            @foreach (var et in _etiquetasCat)
                            {
                                var eid = et.Id; var on = d.EtiquetaIds.Contains(et.Id);
                                <button class="tbc-tag @(on ? "on" : "")" style="@(on ? $"background:{et.Color ?? "#6D4FE3"};border-color:{et.Color ?? "#6D4FE3"};color:#fff" : "")" @onclick="() => ToggleEtiquetaDraft(eid)">@et.Nombre</button>
                            }
                            @if (_etiquetasCat.Count == 0) { <span class="tbc-mut">Aun no hay etiquetas. Se crean en "Configurar tablero".</span> }
                        </div>
                        <div class="tbc-tag-hint">Las etiquetas se crean y colorean en <button type="button" class="tbc-linkbtn" @onclick="AbrirConfigBoard">Configurar tablero</button>.</div>
                    </div>

                    @* Solicitante: quien pide la tarea (registro del directorio). Por defecto el usuario actual; editable con el selector que busca/crea terceros. *@
                    <div class="tbc-fld">
                        <label>Solicitante</label>
                        <div class="tbc-solic">
                            <div class="tb-ava tbc-solic-ava">@Iniciales(d.SolicitanteNombre ?? "?")</div>
                            <span class="tbc-solic-nm">@(string.IsNullOrWhiteSpace(d.SolicitanteNombre) ? "Tu (usuario actual)" : d.SolicitanteNombre)</span>
                        </div>
                        <div class="tbc-solic-sel">
                            <SelectorPersona Jwt="@_jwt" Seleccionada="_solicitanteSel" SeleccionadaChanged="OnSolicitanteSel" Placeholder="Cambiar solicitante (buscar o crear)..." />
                        </div>
                    </div>

                    <div class="tbc-fld">
                        <label>Responsables</label>
                        @if (d.Responsables.Count > 0)
                        {
                            <div class="tbc-resps">
                                @for (int i = 0; i < d.Responsables.Count; i++)
                                {
                                    var rid = d.Responsables[i]; var ci = i;
                                    <div class="tbc-resp">
                                        <div class="tb-ava" style="background:@RespColor(ci);margin-right:0">@Iniciales(PersonaNombre(rid))</div>
                                        <span class="tbc-resp-nm">@PersonaNombre(rid)</span>
                                        <button class="tbc-resp-x" @onclick="() => CardRemoveResp(rid)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                                    </div>
                                }
                            </div>
                        }
                        <div class="tbc-resp-add">
                            <select @bind="_respPick">
                                <option value="">Agregar responsable...</option>
                                @if (_personas is not null)
                                {
                                    @foreach (var p in _personas.Where(x => !d.Responsables.Contains(x.Id))) { <option value="@p.Id">@p.Nombre</option> }
                                }
                            </select>
                            <button class="tbc-add-sq" @onclick="CardAddResp"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg></button>
                        </div>
                    </div>
                    <div class="tbc-row2">
                        <div class="tbc-fld tbc-grow"><label>Inicio</label><input type="date" @bind="d.FechaInicio" /></div>
                        <div class="tbc-fld tbc-w80"><label>Hora</label><input type="time" @bind="d.HoraInicio" /></div>
                    </div>
                    <div class="tbc-row2">
                        <div class="tbc-fld tbc-grow"><label>Fin</label><input type="date" @bind="d.FechaVencimiento" /></div>
                        <div class="tbc-fld tbc-w80"><label>Hora</label><input type="time" @bind="d.HoraFin" /></div>
                    </div>
                    <div class="tbc-fld"><label>Valor (COP)</label><input type="number" @bind="d.Valor" placeholder="Ej. 1200000" /></div>
                </div>

                @* ----- Columna 3: actividad como CHAT (comentarios + adjuntos inline, estilo Airtable) ----- *@
                <div class="tbc-col tbc-col-act">
                    <div class="tbc-actchat">
                        <div class="tbc-actchat-h">
                            <label class="tbc-lbl">Actividad</label>
                        </div>
                        @if (d.Id is null)
                        {
                            <div class="tbc-act-empty">Guarda la tarjeta para registrar actividad y adjuntar archivos.</div>
                        }
                        else
                        {
                            var timeline = ActTimeline(d);
                            <div class="tbc-chat tbc-chat-scroll">
                                @if (timeline.Count == 0)
                                {
                                    <div class="tbc-act-empty">Aun no hay actividad. Escribe un comentario o adjunta un archivo.</div>
                                }
                                else
                                {
                                    @* Orden cronologico (mas antiguo arriba); los mios a la derecha. *@
                                    @foreach (var it in timeline)
                                    {
                                        @if (it.EsSepDia)
                                        {
                                            <div class="tbc-daysep"><span>@it.SepTexto</span></div>
                                        }
                                        else
                                        {
                                            var nombre = string.IsNullOrWhiteSpace(it.Autor) ? (it.EsMio ? "Tu" : "Usuario") : it.Autor;
                                            <div class="tbc-msg @(it.EsMio ? "mine" : "")">
                                                <div class="tb-ava tbc-msg-ava">@Iniciales(nombre)</div>
                                                <div class="tbc-msg-col">
                                                    <div class="tbc-msg-meta"><span class="tbc-msg-au">@nombre</span><span class="tbc-msg-dt">@FechaSoloHora(it.Fecha)</span></div>
                                                    <div class="tbc-bubble @(it.Adj is not null ? "has-file" : "")">
                                                        @if (it.Adj is AdjuntoVM adj)
                                                        {
                                                            @if (EsImg(adj.Url))
                                                            {
                                                                <div class="tbc-bubble-img" @onclick="() => _lightbox = adj.Url" title="Clic para ampliar">
                                                                    <img src="@adj.Url" alt="@adj.Nombre" />
                                                                </div>
                                                            }
                                                            else if (EsPdf(adj.Url))
                                                            {
                                                                <a class="tbc-bubble-pdf" href="@adj.Url" target="_blank" title="Abrir @adj.Nombre">
                                                                    <iframe class="tbc-bubble-pdf-fr" src="@(adj.Url + "#toolbar=0&navpanes=0&view=FitH")" tabindex="-1" loading="lazy"></iframe>
                                                                    <span class="tbc-bubble-pdf-hint">Abrir</span>
                                                                </a>
                                                            }
                                                            <a class="tbc-bubble-file" href="@adj.Url" target="_blank" title="@adj.Nombre">
                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/></svg>
                                                                <span class="tbc-bubble-fnm">@adj.Nombre</span>
                                                            </a>
                                                            @if (!string.IsNullOrWhiteSpace(adj.Texto))
                                                            {
                                                                <div class="tbc-bubble-tx tbc-bubble-cap">@adj.Texto</div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="tbc-bubble-tx">@it.Texto</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                            @* Compositor tipo chat: adjuntar (clip) + texto + enviar. Permite archivo con caption y @menciones a usuarios. *@
                            <div class="tbc-composerwrap">
                                @* Sugerencias de mencion @usuario (aparece al escribir "@") *@
                                @if (_mencionQuery is not null && _mencionMatches.Count > 0)
                                {
                                    <div class="tbc-mencion-pop">
                                        @foreach (var p in _mencionMatches)
                                        {
                                            var per = p;
                                            <button type="button" class="tbc-mencion-it" @onclick="() => InsertarMencion(per)">
                                                <span class="tb-ava tbc-mencion-ava">@Iniciales(per.Nombre)</span>
                                                <span class="tbc-mencion-nm">@per.Nombre</span>
                                            </button>
                                        }
                                    </div>
                                }
                                @* Archivo pendiente: se sube junto con el mensaje (archivo + comentario) *@
                                @if (_pendingFileName is not null)
                                {
                                    <div class="tbc-pendfile">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/></svg>
                                        <span class="tbc-pendfile-nm">@_pendingFileName</span>
                                        <button type="button" class="tbc-pendfile-x" @onclick="QuitarArchivoPendiente" title="Quitar archivo"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                                    </div>
                                }
                                <div class="tbc-chat-composer">
                                    <label class="tbc-chat-clip" title="Adjuntar archivo">
                                        @if (_subiendo) { <span class="tbc-chat-clip-load">...</span> }
                                        else { <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 0 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"/></svg> }
                                        <InputFile OnChange="SeleccionarArchivo" style="display:none" />
                                    </label>
                                    <textarea class="tbc-chat-input" rows="1" @bind="_nuevoComentario" @bind:event="oninput" @bind:after="DetectarMencion" placeholder="@(_pendingFileName is null ? "Escribe un comentario o @menciona..." : "Anade un comentario (opcional)...")"></textarea>
                                    <button class="tbc-chat-send" @onclick="EnviarMensaje" disabled="@(_busy || _subiendo || (_pendingFile is null && string.IsNullOrWhiteSpace(_nuevoComentario)))" title="Enviar">
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_cardMsg)) { <div class="tbc-cardmsg">@_cardMsg</div> }
                        }
                    </div>
                </div>
            </div>
            }

            @* ===== TAB ARCHIVOS: miniaturas a la izquierda + visor grande a la derecha ===== *@
            @if (_cardTab == "archivos")
            {
            <div class="tbc-files">
                @{ var sel = d.Adjuntos.FirstOrDefault(a => a.Id == _adjSel) ?? d.Adjuntos.FirstOrDefault(); }
                @if (d.Id is null)
                {
                    <div class="tbc-files-hint">Guarda la tarjeta para adjuntar archivos.</div>
                }
                else
                {
                    @* Columna izquierda: lista vertical de miniaturas *@
                    <div class="tbc-thumbs">
                        @foreach (var a in d.Adjuntos)
                        {
                            var aid = a.Id;
                            var tituloAdj = string.IsNullOrWhiteSpace(a.SubidoPor) ? a.Nombre : $"{a.Nombre} - subido por {a.SubidoPor}";
                            <div class="tbc-thumb @(sel is not null && sel.Id == a.Id ? "on" : "")" @onclick="() => _adjSel = aid" title="@tituloAdj">
                                <div class="tbc-thumb-ic">
                                    @if (EsImg(a.Url)) { <img src="@a.Url" alt="@a.Nombre" /> }
                                    else { <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h4"/></svg> }
                                </div>
                                <div class="tbc-thumb-meta">
                                    <span class="tbc-thumb-nm">@a.Nombre</span>
                                    @if (!string.IsNullOrWhiteSpace(a.SubidoPor))
                                    {
                                        <span class="tbc-thumb-by"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 12 0v1"/></svg>@a.SubidoPor</span>
                                    }
                                </div>
                                <button class="tbc-thumb-x" @onclick:stopPropagation="true" @onclick="() => EliminarAdjunto(aid)" title="Quitar"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                            </div>
                        }
                        <label class="tbc-thumb-up">
                            @if (_subiendo) { <span class="tbc-thumb-up-t">Subiendo...</span> }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
                                <span class="tbc-thumb-up-t">Subir archivo</span>
                            }
                            <InputFile OnChange="SubirDesdeArchivos" style="display:none" />
                        </label>
                    </div>
                    @* Columna derecha: visor grande de la imagen/archivo seleccionado *@
                    <div class="tbc-viewer">
                        @if (sel is null)
                        {
                            <div class="tbc-viewer-empty">
                                <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M21 15l-5-5L5 21M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="8.5" cy="8.5" r="1.5"/></svg>
                                <p>No hay archivos adjuntos.</p>
                                <span>Sube imagenes o documentos con el boton "Subir archivo".</span>
                            </div>
                        }
                        else if (EsImg(sel.Url))
                        {
                            <div class="tbc-viewer-imgwrap tbc-viewer-imgwrap--zoom" @onclick="() => _lightbox = sel.Url" title="Clic para ampliar">
                                <img class="tbc-viewer-img" src="@sel.Url" alt="@sel.Nombre" />
                                <span class="tbc-viewer-zoom"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg> Ampliar</span>
                            </div>
                            <div class="tbc-viewer-bar">
                                <div class="tbc-viewer-meta">
                                    <span class="tbc-viewer-nm">@sel.Nombre</span>
                                    @if (!string.IsNullOrWhiteSpace(sel.SubidoPor)) { <span class="tbc-viewer-by">Subido por @sel.SubidoPor@(sel.SubidoAt is DateTimeOffset t ? " - " + FechaHora(t) : "")</span> }
                                </div>
                                <a class="tbc-viewer-open" href="@sel.Url" target="_blank">Abrir</a>
                            </div>
                        }
                        else if (EsPdf(sel.Url))
                        {
                            <div class="tbc-viewer-pdfwrap">
                                <iframe class="tbc-viewer-pdf" src="@sel.Url" title="@sel.Nombre"></iframe>
                            </div>
                            <div class="tbc-viewer-bar">
                                <div class="tbc-viewer-meta">
                                    <span class="tbc-viewer-nm">@sel.Nombre</span>
                                    @if (!string.IsNullOrWhiteSpace(sel.SubidoPor)) { <span class="tbc-viewer-by">Subido por @sel.SubidoPor</span> }
                                </div>
                                <a class="tbc-viewer-open" href="@sel.Url" target="_blank">Abrir en pestana</a>
                            </div>
                        }
                        else
                        {
                            <div class="tbc-viewer-file">
                                <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h4"/></svg>
                                <p class="tbc-viewer-nm">@sel.Nombre</p>
                                @if (!string.IsNullOrWhiteSpace(sel.SubidoPor)) { <p class="tbc-viewer-by">Subido por @sel.SubidoPor</p> }
                                <a class="tbc-viewer-open" href="@sel.Url" target="_blank">Abrir / descargar</a>
                            </div>
                        }
                    </div>
                }
            </div>
            }

            @* ===== TAB HISTORIAL: bitacora de eventos del sistema (creacion, cambios de estado, adjuntos...) ===== *@
            @if (_cardTab == "historial")
            {
            <div class="tbc-histtab">
                @if (d.Id is null)
                {
                    <div class="tbc-act-empty">Guarda la tarjeta para ver su historial.</div>
                }
                else if (d.Historial.Count == 0)
                {
                    <div class="tbc-act-empty">Sin eventos registrados.</div>
                }
                else
                {
                    <div class="tbc-log">
                        @foreach (var l in Enumerable.Reverse(d.Historial))
                        {
                            <div class="tbc-log-i">
                                <div class="tbc-log-rail"><span class="tbc-log-dot"></span><span class="tbc-log-line"></span></div>
                                <div><div class="tbc-log-t">@l.Texto</div><div class="tbc-log-d">@FechaHora(l.Fecha)</div></div>
                            </div>
                        }
                    </div>
                }
            </div>
            }

            @* Lightbox: visor de imagen a pantalla completa (clic en la imagen del visor de Archivos). *@
            @if (_lightbox is not null)
            {
                <div class="tbc-lightbox" @onclick="() => _lightbox = null">
                    <img class="tbc-lightbox-img" src="@_lightbox" @onclick:stopPropagation="true" />
                    <button class="tbc-lightbox-x" @onclick="() => _lightbox = null" title="Cerrar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                </div>
            }

            <div class="tbc-foot">
                @if (d.Id is not null)
                {
                    @* En la pestana Historial no se muestra "Eliminar": el historial es una bitacora de solo lectura y no se debe poder borrar. *@
                    @if (_cardTab != "historial")
                    {
                        <button class="tb-btn-danger" @onclick="EliminarCard"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>Eliminar</button>
                    }
                    <button class="tb-btn tb-btn-ghost" @onclick="() => AbrirCopiaDialog(d.Id!.Value, d.Titulo, d.EstadoId)" title="Crear una copia de esta tarea"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>Copiar</button>
                }
                <div class="tb-flex"></div>
                @if (!string.IsNullOrEmpty(_cardMsg)) { <span class="tbc-cardmsg">@_cardMsg</span> }
                <button class="tb-btn tb-btn-ghost" @onclick="CerrarCard">Cancelar</button>
                <button class="tb-btn tb-btn-primary" @onclick="GuardarCard" disabled="@(_busy || string.IsNullOrWhiteSpace(d.Titulo))">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>@(_busy ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}
}

@* ---------- Mini-modal: copiar tarea (pregunta al usuario que copiar) ---------- *@
@if (_copiaDlg is not null)
{
    <div class="tb-modal-bd" @onclick="CerrarCopiaDialog">
        <div class="tbcopy" @onclick:stopPropagation="true">
            <div class="tbcopy-h">
                <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>Copiar tarea</span>
                <button class="tbc-head-x" @onclick="CerrarCopiaDialog"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="tbcopy-bd">
                <div class="tbcopy-src">Original: <b>@_copiaDlg.TareaTitulo</b></div>
                <div class="tbc-fld"><label>Titulo de la copia</label><input @bind="_copiaDlg.Titulo" @bind:event="oninput" placeholder="Titulo de la copia..." /></div>
                <div class="tbcopy-row">
                    <div class="tbc-fld tbcopy-grow">
                        <label>Etapa destino</label>
                        <select @bind="_copiaDlg.EstadoId">
                            @if (_board is not null) { @foreach (var es in _board.Estados) { <option value="@es.Id">@es.Nombre</option> } }
                        </select>
                    </div>
                    <div class="tbc-fld tbcopy-cant">
                        <label>Cuantas</label>
                        <input type="number" min="1" max="20" @bind="_copiaDlg.Cantidad" />
                    </div>
                </div>
                <div class="tbcopy-tglbl">Conservar del original:</div>
                <div class="tbcopy-toggles">
                    <label class="tbcopy-tg"><input type="checkbox" @bind="_copiaDlg.ConservarResponsables" />Responsables</label>
                    <label class="tbcopy-tg"><input type="checkbox" @bind="_copiaDlg.ConservarEtiquetas" />Etiquetas</label>
                    <label class="tbcopy-tg"><input type="checkbox" @bind="_copiaDlg.ConservarRelacion" />Relacionado con</label>
                    <label class="tbcopy-tg"><input type="checkbox" @bind="_copiaDlg.ConservarCampos" />Campos personalizados</label>
                </div>
                <div class="tbcopy-note">Cada copia es una tarea <b>independiente</b> (no una subtarea). Queda una traza en el original.</div>
            </div>
            <div class="tbcopy-foot">
                <button class="tb-btn tb-btn-ghost" @onclick="CerrarCopiaDialog">Cancelar</button>
                <button class="tb-btn tb-btn-primary" @onclick="ConfirmarCopia" disabled="@(_copiaBusy || string.IsNullOrWhiteSpace(_copiaDlg.Titulo))">@(_copiaBusy ? "Copiando..." : (_copiaDlg.Cantidad > 1 ? $"Crear {_copiaDlg.Cantidad} copias" : "Crear copia"))</button>
            </div>
        </div>
    </div>
}

@* ===================== Editor de campo FLOTANTE (compartido: tarjeta + tabla) ===================== *@
@if (_showCampoEditor)
{
    <div class="tbfld-bd" @onclick="() => _showCampoEditor = false"></div>
    <div class="tbfld-pop @(_popUp ? "tbfld-pop-up" : "")" @onclick:stopPropagation="true" style="@PopStyle()">
        <div class="tbfld-pop-h">
                <span>@(_campoDraft.Id is null ? "Nuevo campo" : "Editar campo")</span>
                <button type="button" class="tbfld-x" @onclick="() => _showCampoEditor = false" title="Cerrar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="tbfld-pop-b">
                <div class="tbfld-field">
                    <label class="tbfld-lbl">Nombre del campo</label>
                    <input class="tbcfg-in" @bind="_campoDraft.Label" @bind:event="oninput" placeholder="Ej. Costo estimado" />
                </div>
                <div class="tbfld-field">
                    <label class="tbfld-lbl">Tipo de campo</label>
                    <select class="tbcfg-in" @bind="_campoDraft.Tipo">
                        @foreach (var tp in Enum.GetValues<TipoCampoTablero>()) { <option value="@tp">@TipoCampoLabel(tp)</option> }
                    </select>
                </div>
                @if (_campoDraft.Tipo == TipoCampoTablero.Seleccion)
                {
                    <div class="tbfld-field">
                        <label class="tbfld-lbl">Opciones</label>
                        <textarea class="tbcfg-in" rows="4" @bind="_campoDraft.Opciones" @bind:event="oninput" placeholder="Una opcion por linea"></textarea>
                    </div>
                }
                @if (_campoDraft.Tipo == TipoCampoTablero.Total)
                {
                    <div class="tbcfg-suma">
                        <div class="tbcfg-suma-h">Campos a sumar (Numero / Moneda)</div>
                        @if (!CamposSumables.Any()) { <div class="tbcfg-suma-empty">Crea antes campos Numero o Moneda.</div> }
                        @foreach (var s in CamposSumables) { var sid = s.Id; <label class="tbcfg-chkl"><input type="checkbox" checked="@_campoDraft.CamposSuma.Contains(sid)" @onchange="() => ToggleCampoSuma(sid)" /> @s.Label</label> }
                    </div>
                }
                <div class="tbfld-field">
                    <label class="tbfld-lbl">@(_campoDraft.Tipo == TipoCampoTablero.Separador ? "Titulo de la seccion (divisoria)" : "Descripcion / ayuda (opcional)")</label>
                    <input class="tbcfg-in" @bind="_campoDraft.Descripcion" @bind:event="oninput" placeholder="@(_campoDraft.Tipo == TipoCampoTablero.Separador ? "Ej. Datos de facturacion" : "Texto de ayuda para quien llena el campo")" />
                </div>
                @if (_campoDraft.Tipo != TipoCampoTablero.Separador && _campoDraft.Tipo != TipoCampoTablero.Total)
                {
                    <div class="tbfld-field">
                        <label class="tbfld-lbl">Valor por defecto (opcional)</label>
                        <input class="tbcfg-in" @bind="_campoDraft.ValorPorDefecto" @bind:event="oninput" placeholder="Se precarga al crear una tarea nueva" />
                    </div>
                    <div class="tbcfg-erow">
                        <label class="tbcfg-chkl"><input type="checkbox" @bind="_campoDraft.Requerido" /> Requerido</label>
                        <label class="tbcfg-chkl"><input type="checkbox" @bind="_campoDraft.PermiteVarios" /> Permitir varios</label>
                    </div>
                }
                <div class="tbcfg-erow">
                    <label class="tbcfg-chkl"><input type="checkbox" @bind="_campoDraft.MostrarEnFiltro" /> Mostrar en filtros</label>
                    <select class="tbcfg-in tbcfg-in-sm" @bind="_campoDraft.Columna"><option value="1">Ancho normal</option><option value="2">Ancho completo</option></select>
                </div>
            </div>
            <div class="tbfld-pop-f">
                <button class="tb-btn tb-btn-ghost" @onclick="() => _showCampoEditor = false">Cancelar</button>
                <button class="tb-btn tb-btn-primary" @onclick="GuardarCampoFlotante" disabled="@(_busy || string.IsNullOrWhiteSpace(_campoDraft.Label))">@(_campoDraft.Id is null ? "Agregar campo" : "Guardar campo")</button>
            </div>
    </div>
}

<style>
    .tb-wrap { width: 100%; max-width: 1900px; margin: 0 auto; padding: 6px 28px 60px; font-family: 'Lexend', sans-serif; box-sizing: border-box; }
