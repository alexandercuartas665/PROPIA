    // ---- Color por columna (tonos pastel), persistido por tablero ----
    private Dictionary<string, string> _colColor = new();
    private string? _colColorMenu;
    private static readonly string[] PastelCols =
        { "#FDE2E4", "#FCE8D5", "#FFF3C4", "#E4F4D4", "#D4F0EC", "#D6E6FB", "#E7DFFB", "#FBE0F0", "#ECEFF3" };
    private string? ColBg(string key) => _colColor.TryGetValue(key, out var c) && !string.IsNullOrEmpty(c) ? c : null;
    private void ToggleColColorMenu(string key) { _colColorMenu = _colColorMenu == key ? null : key; }
    private async Task SetColColor(string key, string? color)
    {
        if (string.IsNullOrEmpty(color)) _colColor.Remove(key); else _colColor[key] = color;
        _colColorMenu = null;
        await PersistColColorAsync();
    }
    // Color personalizado elegido por el usuario (input type=color). No cierra el popup (permite ajustar).
    private async Task SetColColorInput(string key, ChangeEventArgs e)
    {
        var color = e.Value?.ToString();
        if (!string.IsNullOrEmpty(color)) { _colColor[key] = color; await PersistColColorAsync(); }
    }
    // Solo las celdas de DATOS (.tb-row-*) se colorean. Los encabezados de columna, los agrupadores
    // (.tb-list-group) y la fila-resumen usan clases .tb-lc-* y quedan con su color natural: asi el
    // color no "invade" los titulos/agrupadores (donde ademas se veia desalineado por el relleno vertical).
    private static string? ColSelectores(string key) => key switch
    {
        "desc" => ".tb-list .tb-row-desc",
        "est" => ".tb-list .tb-row-cell-est",
        "resp" => ".tb-list .tb-row-resp",
        "prog" => ".tb-list .tb-row-prog",
        "etiq" => ".tb-list .tb-row-etiq",
        "prio" => ".tb-list .tb-row-prio",
        "due" => ".tb-list .tb-row-due",
        "valor" => ".tb-list .tb-row-valor",
        "orig" => ".tb-list .tb-row-orig",
        _ => Guid.TryParse(key, out _) ? $".tb-list .tb-row-campo.tb-cc-{key}" : null
    };
    // Emite un <style> con el fondo de cada columna coloreada (celdas de encabezado + filas).
    private MarkupString ColumnColorCss
    {
        get
        {
            if (_colColor.Count == 0) return (MarkupString)"";
            var sb = new System.Text.StringBuilder("<style>");
            foreach (var kv in _colColor)
            {
                if (string.IsNullOrEmpty(kv.Value)) continue;
                var sel = ColSelectores(kv.Key);
                if (sel is null) continue;
                // El color rellena TODA la altura de la celda (no solo la caja de texto): la celda es un flex-item
                // centrado dentro de una fila mas alta (padding 9px), asi que se estira con align-self:stretch y
                // se "come" el padding vertical de la fila con margenes negativos + padding propio.
                sb.Append(sel).Append("{background:").Append(kv.Value)
                  .Append(" !important;align-self:stretch;box-sizing:border-box;margin-top:-9px;margin-bottom:-9px;padding-top:9px;padding-bottom:9px;}");
            }
            sb.Append("</style>");
            return (MarkupString)sb.ToString();
        }
    }
    // Boton de color + paleta pastel para el encabezado de una columna.
    private RenderFragment ColorDot(string key)
    {
        return
    @<span class="tb-lc-colorwrap" @onclick:stopPropagation="true">
        <button type="button" class="tb-lc-color" style="background:@(ColBg(key) ?? "transparent")" title="Color de columna" @onclick="() => ToggleColColorMenu(key)"></button>
        @if (_colColorMenu == key)
        {
            <div class="tb-colorpop-bd" @onclick="() => _colColorMenu = null"></div>
            <div class="tb-colorpop" @onclick:stopPropagation="true">
                @foreach (var c in PastelCols)
                {
                    var cc = c;
                    <button type="button" class="tb-coloropt @(string.Equals(ColBg(key), cc, StringComparison.OrdinalIgnoreCase) ? "on" : "")" style="background:@cc" @onclick="() => SetColColor(key, cc)"></button>
                }
                <label class="tb-coloropt tb-coloropt-custom" title="Elegir color personalizado">
                    <input type="color" value="@(ColBg(key) ?? "#6D4FE3")" @onchange="(e) => SetColColorInput(key, e)" />
                </label>
                <button type="button" class="tb-coloropt tb-coloropt-none" title="Sin color" @onclick="() => SetColColor(key, null)"></button>
            </div>
        }
    </span>;
    }

    // Color de texto (blanco / oscuro) para una etiqueta segun la luminancia de su color de fondo,
    // para que el texto quede legible sobre el chip relleno.
    private static string TagTextColor(string hex)
    {
        var h = (hex ?? "").TrimStart('#');
        if (h.Length == 3) { h = string.Concat(h[0], h[0], h[1], h[1], h[2], h[2]); }
        if (h.Length < 6
            || !int.TryParse(h.Substring(0, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var r)
            || !int.TryParse(h.Substring(2, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var g)
            || !int.TryParse(h.Substring(4, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var b))
        { return "#ffffff"; }
        var lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255.0;
        return lum > 0.62 ? "#1B2A3A" : "#ffffff";
    }

