        TipoCampoTablero.Telefono => "Telefono", TipoCampoTablero.Seleccion => "Seleccion", TipoCampoTablero.Booleano => "Si/No",
        TipoCampoTablero.Url => "URL", TipoCampoTablero.Email => "Email",
