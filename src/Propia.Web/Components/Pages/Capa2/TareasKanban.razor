    private async Task AbrirBoardAsync(Guid id)
    {
        _board = await Auth().GetFromJsonAsync<TableroBoardDto>($"/api/tareas/tableros/{id}/board?verCerradas={(_verCerradas ? "true" : "false")}");
        // Etiquetas de ESTE tablero (+ las globales). Se gestionan en "Configurar tablero".
        try { _etiquetasCat = await Auth().GetFromJsonAsync<List<EtiquetaTareaDto>>($"/api/tareas/etiquetas?tableroId={id}") ?? _etiquetasCat; } catch { }
        SyncTareas();
        await RestaurarColsAsync();   // config de columnas guardada para ESTE tablero (por usuario)
        ReconciliarOrden();           // deja _colOrden alineado con los campos actuales del tablero
        await RestaurarAggGroupAsync();   // agrupacion + funciones de totales guardadas para ESTE tablero
        _boardMode = await LeerVistaGuardadaAsync();   // abre en el ultimo modo de vista del usuario
        try { await Js.InvokeVoidAsync("localStorage.setItem", TbLastKey, id.ToString()); } catch { }
        _expandidas.Clear();
        _nuevaFilas.Clear();
        LimpiarFiltros();
        if (_personas is null)
        {
            try { var raw = await Auth().GetFromJsonAsync<List<PersonaRaw>>("/api/directorio/personas") ?? new(); _personas = raw.Select(p => new PersonaMini(p.Id, ($"{p.Nombres} {p.Apellidos}").Trim())).ToList(); }
            catch { _personas = new(); }
        }
        if (_unidades is null || _zonas is null || _equipos is null) await CargarContextoAsync();
    }

