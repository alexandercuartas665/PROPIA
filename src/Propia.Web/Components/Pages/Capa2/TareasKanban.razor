    .tb-nf-inp { width: 100%; box-sizing: border-box; border: 1px dashed #D7E0EA; border-radius: 7px; padding: 5px 8px; font-size: 12.5px; color: #33475B; outline: none; background: #fff; font-family: inherit; }
