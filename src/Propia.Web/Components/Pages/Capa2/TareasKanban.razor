    .tb-btn-ghost:hover { border-color: #C3D0DD; }
    .tb-btn-danger { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; color: #D7263D; padding: 9px 13px; border-radius: 9px; border: 1px solid #FBD5D5; background: #fff; cursor: pointer; }
    .tb-btn-danger:hover { background: #FFF5F5; }
    .tb-flex { flex: 1; }

    .tb-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .tb-card { background: #fff; border: 1px solid #E1E8EE; border-radius: 15px; overflow: hidden; box-shadow: 0 1px 2px rgba(45,62,80,.05); }
    .tb-card-bar { height: 7px; }
    .tb-card-body { padding: 17px 18px; }
    .tb-card-top { display: flex; align-items: flex-start; gap: 10px; }
    .tb-card-id { flex: 1; min-width: 0; }
    .tb-card-nom { font-size: 15.5px; font-weight: 800; color: #1B2A3A; letter-spacing: -.2px; }
    .tb-card-desc { font-size: 12px; color: #7C98B6; margin-top: 3px; line-height: 1.45; }
    .tb-card-edit { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #A6B7C8; border: 1px solid #E1E8EE; background: #fff; flex-shrink: 0; cursor: pointer; }
    .tb-card-edit:hover { border-color: #6D4FE3; color: #6D4FE3; }
    .tb-card-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 15px; }
    .tb-avatars { display: flex; align-items: center; }
    .tb-ava { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg,#8366F0,#5838C9); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; border: 2px solid #fff; margin-right: -8px; }
    .tb-ava-more { background: #EEF3F8; color: #516F90; }
    .tb-avatars-lg .tb-ava { width: 30px; height: 30px; }
    .tb-card-count { font-size: 11px; font-weight: 700; color: #7C98B6; background: #F5F8FA; border: 1px solid #E1E8EE; padding: 3px 10px; border-radius: 20px; }
    .tb-card-open { width: 100%; margin-top: 15px; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 9px; border-radius: 9px; background: #F1ECFD; color: #6D4FE3; font-size: 12.5px; font-weight: 700; border: 0; cursor: pointer; }
    .tb-card-open:hover { background: #E6DEFA; }
    .tb-card-new { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; min-height: 180px; border: 1.5px dashed #D7E0EA; border-radius: 15px; background: #FBFCFD; color: #7C98B6; font-size: 12.5px; font-weight: 700; cursor: pointer; }
