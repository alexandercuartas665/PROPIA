    private void CfgNuevoCampo() => _campoDraft = new CampoDraft();
    // "Agregar campo" desde el modal de tarjeta: mismo editor/potencia que Configurar tablero.
    // Coordenadas del clic para anclar el popover al boton (aspecto de "nace del boton").
    // _popUp = true cuando el clic esta en la mitad inferior: el popover abre hacia arriba.
    private double _popX, _popY; private bool _popUp;
    // Nuevo campo: abre el popover en blanco anclado al boton.
    private async Task AbrirEditorCampo(MouseEventArgs e) { _campoDraft = new CampoDraft(); await AbrirPopEn(e); }
    // Editar campo existente: precarga el draft con el campo y abre el mismo popover anclado.
    private async Task EditarCampoPop(MouseEventArgs e, TableroCampoDto c) { CfgEditCampo(c); await AbrirPopEn(e); }
    private async Task AbrirPopEn(MouseEventArgs e)
    {
        _popX = e.ClientX; _popY = e.ClientY;
        try { var vh = await Js.InvokeAsync<double>("propiaViewportH"); _popUp = vh > 0 && e.ClientY > vh * 0.55; }
        catch { _popUp = false; }
        _showCampoEditor = true;
    }
    // Ancla el popover al punto del clic: cae hacia abajo, o hacia arriba si no hay espacio.
    private string PopStyle() => _popUp
        ? $"bottom:calc(100vh - {_popY:0}px + 8px); right:calc(100vw - {_popX:0}px); max-height:calc({_popY:0}px - 24px);"
        : $"top:calc({_popY:0}px + 8px); right:calc(100vw - {_popX:0}px); max-height:calc(100vh - {_popY:0}px - 24px);";
    private async Task GuardarCampoFlotante()
    {
