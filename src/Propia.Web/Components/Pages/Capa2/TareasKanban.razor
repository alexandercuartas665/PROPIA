    private void CfgEditCampo(TableroCampoDto c) => _campoDraft = new CampoDraft
    {
        Id = c.Id,
        Label = c.Label,
        Tipo = c.Tipo,
        Opciones = c.Opciones ?? "",
        MostrarEnFiltro = c.MostrarEnFiltro,
        Columna = c.Columna < 1 ? 1 : c.Columna,
        Descripcion = c.Descripcion ?? "",
        Requerido = c.Requerido,
        ValorPorDefecto = c.ValorPorDefecto ?? "",
        PermiteVarios = c.PermiteVarios,
        CamposSuma = ParseCamposSuma(c.CamposSuma)
    };
    private async Task CfgGuardarCampo()
    {
        if (_board is null || string.IsNullOrWhiteSpace(_campoDraft.Label)) return;
        _busy = true;
        try
        {
            var body = new GuardarCampoRequest(
                _campoDraft.Label.Trim(),
                _campoDraft.Tipo,
                _campoDraft.Tipo == TipoCampoTablero.Seleccion && !string.IsNullOrWhiteSpace(_campoDraft.Opciones) ? _campoDraft.Opciones.Trim() : null,
                _campoDraft.MostrarEnFiltro,
                _campoDraft.Columna,
                string.IsNullOrWhiteSpace(_campoDraft.Descripcion) ? null : _campoDraft.Descripcion.Trim(),
                _campoDraft.Requerido,
                string.IsNullOrWhiteSpace(_campoDraft.ValorPorDefecto) ? null : _campoDraft.ValorPorDefecto.Trim(),
                _campoDraft.PermiteVarios,
                _campoDraft.Tipo == TipoCampoTablero.Total && _campoDraft.CamposSuma.Count > 0 ? string.Join(",", _campoDraft.CamposSuma) : null);
            HttpResponseMessage resp = _campoDraft.Id is { } cid
                ? await Auth().PutAsJsonAsync($"/api/tareas/tableros/{_board.Tablero.Id}/campos/{cid}", body)
                : await Auth().PostAsJsonAsync($"/api/tareas/tableros/{_board.Tablero.Id}/campos", body);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _campoDraft = new CampoDraft();
            await RecargarBoard();
        }
        finally { _busy = false; }
    }
