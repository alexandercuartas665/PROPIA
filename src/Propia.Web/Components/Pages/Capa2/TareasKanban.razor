    .tb-row-etiq { flex: 0 0 160px; width: 160px; display: flex; gap: 4px; flex-wrap: wrap; align-content: flex-start; align-items: center; }
    /* Etiqueta rellena con su color (fondo completo), texto en contraste (blanco/oscuro segun luminancia). */
    .tb-tag { position: relative; display: inline-flex; align-items: center; gap: 4px; max-width: 100%; font-size: 10px; font-weight: 700; color: #fff; background: #6D4FE3; border: 1px solid transparent; padding: 2px 4px 2px 8px; border-radius: 20px; box-sizing: border-box; }
    .tb-tag-tx { max-width: 96px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: text; }
    .tb-tag-inp { width: 82px; max-width: 82px; border: 0; border-radius: 5px; padding: 0 4px; font-size: 10px; font-weight: 700; color: #1B2A3A; outline: none; background: #fff; font-family: inherit; box-sizing: border-box; }
    /* Botita para abrir el selector de color: circulo blanco translucido, visible sobre cualquier color. */
    .tb-tag-sw { width: 12px; height: 12px; flex-shrink: 0; border-radius: 50%; border: 1px solid rgba(255,255,255,.85); cursor: pointer; padding: 0; background: rgba(255,255,255,.35); }
    .tb-tag-sw:hover { transform: scale(1.12); }
    .tb-tagpop-bd { position: fixed; inset: 0; z-index: 1118; background: transparent; }
    .tb-tag-colors { position: absolute; top: calc(100% + 5px); right: 0; z-index: 1120; display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; padding: 7px; background: #fff; border: 1px solid #E1E8EE; border-radius: 10px; box-shadow: 0 12px 30px rgba(45,62,80,.2); }
    .tb-tag-copt { width: 20px; height: 20px; border-radius: 6px; border: 2px solid transparent; cursor: pointer; padding: 0; box-shadow: 0 1px 2px rgba(0,0,0,.15); }
    .tb-tag-copt.on { border-color: #1B2A3A; }
