    .tb-colsmenu { position: absolute; top: 44px; right: 0; z-index: 20; width: 256px; max-height: 380px; overflow-y: auto; background: #fff; border: 1px solid #E1E8EE; border-radius: 12px; box-shadow: 0 12px 30px rgba(27,42,58,.16); padding: 8px; }
