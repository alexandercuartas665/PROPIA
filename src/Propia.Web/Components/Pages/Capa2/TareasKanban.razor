    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Foco del compositor: al abrir o tras crear una tarea el input de titulo se recrea (@key),
        // asi que hay que devolverle el foco a mano (autofocus solo aplica en la carga inicial).
        if (_composerFocusPending)
        {
            _composerFocusPending = false;
            try { await _composerTituloRef.FocusAsync(); } catch { }
        }
        // Fila lista (por columna): tras crear, el @key recrea la fila; se reenfoca su titulo por
        // selector (no hay ElementReference por columna en el foreach).
        if (_nfFocusEstado is Guid nfe)
        {
            _nfFocusEstado = null;
            try { await Js.InvokeVoidAsync("propiaUI.focusBySelector", $"[data-nf-tit='{nfe}']"); } catch { }
        }
        // Barra de scroll superior espejo (vista Lista): enlazarla con el scroll real de la tabla.
        if (_boardMode == "lista")
        {
            try { await Js.InvokeVoidAsync("propiaUI.syncTopScroll", "tbTopScroll", "tbTopScrollInner", "tbList"); } catch { }
        }
        // Chat de actividad: al abrir la tarjeta o tras enviar un mensaje, dejarlo scrolleado abajo (ultimo mensaje visible).
        if (_scrollChatPend)
        {
            _scrollChatPend = false;
            try { await Js.InvokeVoidAsync("propiaUI.scrollBottom", ".tbc-chat-scroll"); } catch { }
        }

        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                _miUsuarioId = LeerUsuarioIdDeJwt(stored);
                await CargarAsync();
                await AbrirUltimoTableroAsync();   // por usuario: reabrir el ultimo tablero en su ultimo modo
                StateHasChanged();
            }
        }
        catch { }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    // Lee el claim user_id (o sub) del payload del JWT sin dependencias externas.
    private static Guid LeerUsuarioIdDeJwt(string jwt)
    {
        try
        {
            var partes = jwt.Split('.');
            if (partes.Length < 2) return Guid.Empty;
            var payload = partes[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4) { case 2: payload += "=="; break; case 3: payload += "="; break; }
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("user_id", out var uid) && Guid.TryParse(uid.GetString(), out var g)) return g;
            if (root.TryGetProperty("sub", out var sub) && Guid.TryParse(sub.GetString(), out var gs)) return gs;
        }
        catch { }
        return Guid.Empty;
    }

    private async Task CargarAsync()
    {
        try
        {
            _tableros = await Auth().GetFromJsonAsync<List<TableroDto>>("/api/tareas/tableros") ?? new();
            try { _resumen = await Auth().GetFromJsonAsync<ResumenTareasDto>("/api/tareas/resumen"); } catch { _resumen = null; }
            try { _etiquetasCat = await Auth().GetFromJsonAsync<List<EtiquetaTareaDto>>("/api/tareas/etiquetas") ?? new(); } catch { _etiquetasCat = new(); }
            if (_tenants.Count == 0)
            {
                try
                {
                    var me = await Auth().GetFromJsonAsync<MeResponseDto>("/connect/me");
                    _tenants = me?.AvailableTenants?.ToList() ?? new();
                    _activeTenantId = me?.ActiveTenantId;
                }
                catch { _tenants = new(); }
            }
            if (_personas is null)
            {
                try
                {
                    var raw = await Auth().GetFromJsonAsync<List<PersonaRaw>>("/api/directorio/personas") ?? new();
                    _personas = raw.Select(p => new PersonaMini(p.Id, ($"{p.Nombres} {p.Apellidos}").Trim())).ToList();
                }
                catch { _personas = new(); }
            }
            if (string.IsNullOrEmpty(_coNombre)) await CargarContextoAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    /// <summary>Carga, best-effort, el nombre de la copropiedad y las listas para el origen de la tarjeta.</summary>
    private async Task CargarContextoAsync()
    {
        try { var r = await Auth().GetFromJsonAsync<CoResumenMini>("/api/mi-copropiedad/resumen"); if (!string.IsNullOrWhiteSpace(r?.Identidad?.Nombre)) _coNombre = r!.Identidad!.Nombre!; } catch { }
        try
        {
            var u = await Auth().GetFromJsonAsync<List<UnidadMini>>("/api/mi-copropiedad/unidades");
            _unidades = u?.Select(x => new OpcionOrigen(x.Id, x.Numero)).ToList() ?? new();
            _busqUnidades = (u ?? new()).Select(x => new SelectorOrigenReferencia.OpcionBusqueda(
                x.Numero,
                string.IsNullOrEmpty(x.TorreNombre) ? x.Numero : $"{x.TorreNombre} - {x.Numero}",
                string.IsNullOrEmpty(x.PropietarioNombre) ? null : x.PropietarioNombre,
                $"{x.Numero} {x.TorreNombre} {x.PropietarioNombre}".Trim())).ToList();
        }
        catch { _unidades = new(); _busqUnidades = new(); }
        try
        {
            var z = await Auth().GetFromJsonAsync<List<ZonaMini>>("/api/mi-copropiedad/zonas");
            _zonas = z?.Select(x => new OpcionOrigen(x.Id, x.Nombre)).ToList() ?? new();
            _busqZonas = (z ?? new()).Select(x => new SelectorOrigenReferencia.OpcionBusqueda(x.Nombre, x.Nombre, null, x.Nombre)).ToList();
        }
        catch { _zonas = new(); _busqZonas = new(); }
        try
        {
            var e = await Auth().GetFromJsonAsync<List<EquipoMini>>("/api/mi-copropiedad/equipos");
            _equipos = e?.Select(x => new OpcionOrigen(x.Id, x.Nombre)).ToList() ?? new();
            _busqEquipos = (e ?? new()).Select(x => new SelectorOrigenReferencia.OpcionBusqueda(x.Nombre, x.Nombre, null, x.Nombre)).ToList();
        }
        catch { _equipos = new(); _busqEquipos = new(); }
    }

