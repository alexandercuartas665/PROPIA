    .tb-asig-drop { position: absolute; top: calc(100% + 4px); left: 0; z-index: 40; width: 235px; background: #fff; border: 1px solid #E1E8EE; border-radius: 10px; box-shadow: 0 12px 32px rgba(45,62,80,.2); padding: 5px; max-height: 270px; overflow-y: auto; }
    .tb-asig-item { display: flex; align-items: center; gap: 8px; width: 100%; border: 0; background: #fff; border-radius: 7px; padding: 6px 8px; cursor: pointer; font-size: 12.5px; color: #33475B; text-align: left; }
    .tb-asig-item:hover { background: #F5F1FE; }
    .tb-asig-item.on { background: #F1ECFD; }
    .tb-asig-chk { width: 15px; height: 15px; border-radius: 4px; border: 1.5px solid #C3D0DD; flex-shrink: 0; }
    .tb-asig-chk.on { background: #6D4FE3; border-color: #6D4FE3; box-shadow: inset 0 0 0 2px #fff; }
    .tb-asig-nom { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tb-asig-close { width: 100%; margin-top: 4px; border: 0; background: #33475B; color: #fff; border-radius: 7px; padding: 6px; font-size: 12px; font-weight: 700; cursor: pointer; }
    .tb-newrow { display: flex; align-items: center; gap: 12px; padding: 8px 18px; border-bottom: 1px solid #F4F7FA; background: #FCFDFF; }
    .tb-newrow:focus-within { background: #F7F5FE; }
    .tb-newrow-plus { width: 18px; text-align: center; color: #B7A6F0; font-weight: 700; flex-shrink: 0; font-size: 15px; }
    .tb-nf-inp { width: 100%; box-sizing: border-box; border: 1px dashed #D7E0EA; border-radius: 7px; padding: 5px 8px; font-size: 12.5px; color: #33475B; outline: none; background: #fff; font-family: inherit; }
    .tb-nf-inp:focus { border-style: solid; border-color: #6D4FE3; box-shadow: 0 0 0 2px rgba(109,79,227,.12); }
    .tb-nf-tit { flex: 1; min-width: 0; }
    .tb-nf-mut { color: #C3D0DD; font-size: 12px; }
    .tb-nf-crear { width: 26px; height: 26px; border-radius: 7px; display: flex; align-items: center; justify-content: center; color: #fff; background: #6D4FE3; border: 0; cursor: pointer; }
    .tb-nf-crear:hover { background: #5B3FD1; }
    .tb-nf-crear:disabled { background: #D7DCE6; cursor: default; }
    /* Compositor rapido en tarjetas (kanban) */
    .tb-composer { background: #fff; border: 1.5px solid #6D4FE3; border-radius: 11px; padding: 9px; box-shadow: 0 4px 14px rgba(109,79,227,.15); display: flex; flex-direction: column; gap: 7px; }
    .tb-composer-inp { width: 100%; border: 0; outline: none; font-size: 13px; color: #33475B; font-weight: 600; background: transparent; box-sizing: border-box; }
    .tb-composer-sub, .tb-composer-sel { width: 100%; box-sizing: border-box; border: 1px solid #E1E8EE; border-radius: 7px; padding: 6px 9px; font-size: 12.5px; color: #33475B; outline: none; background: #FAFBFC; font-family: inherit; }
    .tb-composer-sub:focus, .tb-composer-sel:focus { border-color: #6D4FE3; background: #fff; box-shadow: 0 0 0 2px rgba(109,79,227,.12); }
    .tb-composer-appear { animation: tbComposerIn .18s ease; }
    @@keyframes tbComposerIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
    .tb-composer-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 1px; }
    .tb-composer-hint { font-size: 10px; color: #A6B7C8; }
    .tb-composer-btn { border: 0; background: #6D4FE3; color: #fff; border-radius: 7px; padding: 5px 12px; font-size: 11.5px; font-weight: 700; cursor: pointer; }
    .tb-composer-btn:disabled { opacity: .5; cursor: default; }

    .tb-soon { background: #fff; border: 1.5px dashed #D7E0EA; border-radius: 16px; padding: 50px 24px; text-align: center; }
    .tb-soon-ic { width: 60px; height: 60px; border-radius: 16px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
    .tb-soon-t { font-size: 17px; font-weight: 800; color: #1B2A3A; }
    .tb-soon-s { font-size: 13px; color: #7C98B6; margin-top: 5px; max-width: 440px; margin-left: auto; margin-right: auto; }

    .tb-modal-bd { position: fixed; inset: 0; z-index: 1090; background: rgba(27,42,58,.55); display: flex; align-items: flex-start; justify-content: center; padding: 32px 20px; overflow-y: auto; }
    .tb-modal { width: 540px; max-width: 100%; background: #fff; border-radius: 18px; box-shadow: 0 30px 70px rgba(27,42,58,.4); margin: auto; overflow: hidden; }
    .tb-modal-head { display: flex; align-items: center; gap: 12px; padding: 18px 24px; border-bottom: 1px solid #EEF3F8; }
    .tb-modal-tt { flex: 1; }
    .tb-modal-h { font-size: 16.5px; font-weight: 800; letter-spacing: -.3px; color: #1B2A3A; }
    .tb-modal-s { font-size: 12px; color: #7C98B6; }
    .tb-modal-x { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: #7C98B6; border: 1px solid #E1E8EE; background: #fff; cursor: pointer; }
    .tb-modal-body { padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; }
    .tb-modal-foot { display: flex; align-items: center; gap: 9px; padding: 16px 24px; border-top: 1px solid #EEF3F8; }
    .tb-fld { display: flex; flex-direction: column; }
    .tb-fld label { font-size: 11px; color: #7C98B6; font-weight: 700; margin-bottom: 5px; }
    .tb-fld input, .tb-fld select, .tb-fld textarea { width: 100%; border: 1px solid #E1E8EE; border-radius: 9px; padding: 10px 12px; font-size: 13.5px; color: #33475B; outline: none; background: #fff; box-sizing: border-box; }
    .tb-fld input:focus, .tb-fld select:focus, .tb-fld textarea:focus { border-color: #6D4FE3; }
    .tb-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .tb-colors { display: flex; gap: 8px; flex-wrap: wrap; }
    .tb-color { width: 30px; height: 30px; border-radius: 8px; border: 3px solid transparent; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,.1); }
    .tb-color.on { border-color: #1B2A3A; }
    .tb-userlist { display: flex; flex-direction: column; gap: 7px; max-height: 230px; overflow-y: auto; }
    .tb-user { display: flex; align-items: center; gap: 11px; text-align: left; border: 1px solid #E1E8EE; background: #fff; border-radius: 10px; padding: 9px 12px; cursor: pointer; }
    .tb-user.on { border-color: #6D4FE3; background: #F5F1FE; }
    .tb-user .tb-ava { margin-right: 0; }
    .tb-user-nom { flex: 1; font-size: 13px; font-weight: 600; color: #33475B; }
    /* Buscador de miembros con autocompletado (reemplaza la lista de checkboxes) */
    .tb-userpick { display: flex; flex-direction: column; gap: 9px; }
    .tb-chips { display: flex; flex-wrap: wrap; gap: 7px; }
    .tb-chip { display: inline-flex; align-items: center; gap: 7px; background: #F5F1FE; border: 1px solid #DCD2F8; border-radius: 20px; padding: 3px 8px 3px 4px; font-size: 12.5px; font-weight: 600; color: #33475B; }
    .tb-chip-ava { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; flex-shrink: 0; }
    .tb-ava-sm { width: 24px; height: 24px; font-size: 9px; margin-right: 0; }
    .tb-chip-nom { max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tb-chip-x { border: none; background: transparent; color: #8B7BD8; font-size: 16px; line-height: 1; cursor: pointer; padding: 0 2px; }
    .tb-search-wrap { position: relative; }
    .tb-search-drop { position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20; background: #fff; border: 1px solid #E1E8EE; border-radius: 10px; box-shadow: 0 8px 24px rgba(45,62,80,.14); max-height: 240px; overflow-y: auto; padding: 4px; }
    .tb-search-item { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; border: none; background: #fff; border-radius: 8px; padding: 7px 9px; cursor: pointer; }
    .tb-search-item:hover { background: #F5F1FE; }
    .tb-search-nom { flex: 1; font-size: 13px; font-weight: 600; color: #33475B; }
    .tb-search-doc { font-size: 11.5px; color: #90A4B7; }
    .tb-search-empty { padding: 9px 11px; font-size: 12.5px; color: #90A4B7; font-style: italic; }
    .tb-note { font-size: 11.5px; color: #7C5CE8; background: #FBFAFE; border: 1px dashed #DCD2F8; border-radius: 9px; padding: 9px 11px; }
    .tb-invite { border-top: 1px dashed #E1E8EE; padding-top: 14px; }
    .tb-invite-hint { font-size: 11.5px; color: #90A4B7; margin: -3px 0 8px; }
    .tb-invite-grid { display: grid; grid-template-columns: 1.3fr 1fr .8fr auto; gap: 8px; align-items: center; }
    .tb-invite-grid .tb-input { min-width: 0; }
    .tb-invite-msg { margin-top: 9px; font-size: 12.5px; font-weight: 600; border-radius: 9px; padding: 8px 11px; }
    .tb-invite-msg.ok { color: #1E7A50; background: #EAF7F0; border: 1px solid #C6EAD6; }
    .tb-invite-msg.err { color: #B4453B; background: #FCEEEC; border: 1px solid #F2CFC9; }
    .tb-invite-link { display: flex; gap: 8px; align-items: center; margin-top: 9px; }
    .tb-invite-link .tb-input { flex: 1; font-size: 12px; color: #5A6B7B; background: #F7FAFC; }
    @@media (max-width: 620px) { .tb-invite-grid { grid-template-columns: 1fr 1fr; } }

    /* ===== Modal de tarjeta rico (3 columnas) ===== */
    /* Alto FIJO para que el modal no cambie de tamano al alternar entre las pestanas Detalle y Archivos. */
    .tbc-modal { width: 1380px; max-width: 96vw; height: 88vh; background: #fff; border-radius: 18px; box-shadow: 0 30px 70px rgba(27,42,58,.4); margin: auto; overflow: hidden; display: flex; flex-direction: column; max-height: 92vh; }
    .tbc-head { display: flex; align-items: center; gap: 12px; padding: 18px 24px; flex-shrink: 0; }
    .tbc-head-bar { width: 8px; height: 32px; border-radius: 5px; background: rgba(255,255,255,.85); flex-shrink: 0; }
    .tbc-head-id { flex: 1; min-width: 0; }
    .tbc-head-tt { font-size: 16px; font-weight: 800; letter-spacing: -.3px; color: #fff; display: flex; align-items: center; gap: 9px; text-shadow: 0 1px 2px rgba(0,0,0,.18); }
    .tbc-proy { display: inline-flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 800; color: #fff; background: rgba(255,255,255,.22); padding: 3px 9px; border-radius: 20px; }
    .tbc-head-bc { display: flex; align-items: center; gap: 6px; margin-top: 5px; font-size: 11.5px; font-weight: 600; color: rgba(255,255,255,.9); }
    .tbc-head-bc svg { flex-shrink: 0; }
    .tbc-sep { opacity: .7; }
    .tbc-bold { font-weight: 800; }
    .tbc-head-btn { display: flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 9px; border: 1px solid rgba(255,255,255,.45); background: rgba(255,255,255,.12); font-size: 12px; font-weight: 700; color: #fff; cursor: pointer; flex-shrink: 0; }
    .tbc-head-btn.on { background: rgba(255,255,255,.25); }
    .tbc-head-btn:hover { background: rgba(255,255,255,.3); }
    .tbc-head-x { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: #fff; border: 1px solid rgba(255,255,255,.45); background: rgba(255,255,255,.12); cursor: pointer; flex-shrink: 0; }
    .tbc-head-x:hover { background: rgba(255,255,255,.28); }

    /* El cuerpo ya no scrollea como un todo: cada columna hace su propio scroll (independiente),
       asi el contenido largo de la izquierda no arrastra ni rompe el layout de las demas. */
    .tbc-body { flex: 1; min-height: 0; overflow: hidden; padding: 16px 22px; display: grid; grid-template-columns: minmax(0, 1fr) 290px 400px; grid-template-rows: minmax(0, 1fr); gap: 16px 16px; }
    .tbc-col { display: flex; flex-direction: column; gap: 10px; min-width: 0; min-height: 0; box-sizing: border-box; overflow-y: auto; overflow-x: hidden; scroll-behavior: smooth; padding-right: 6px; scrollbar-width: thin; scrollbar-color: #C3D0DD transparent; }
    .tbc-col::-webkit-scrollbar { width: 7px; }
    .tbc-col::-webkit-scrollbar-track { background: transparent; }
    .tbc-col::-webkit-scrollbar-thumb { background: #C3D0DD; border-radius: 4px; }
    .tbc-col::-webkit-scrollbar-thumb:hover { background: #A6B7C8; }
    .tbc-col-act { border-left: 1px solid #EEF3F8; padding-left: 12px; padding-right: 0; gap: 10px; overflow: hidden; }
    .tbc-fld { display: flex; flex-direction: column; }
    .tbc-fld > label, .tbc-lbl { font-size: 11px; color: #7C98B6; font-weight: 700; margin-bottom: 6px; }
    .tbc-mut { color: #A6B7C8; font-weight: 600; }
    .tbc-fld input, .tbc-fld select, .tbc-fld textarea { width: 100%; border: 1px solid #E1E8EE; border-radius: 9px; padding: 9px 11px; font-size: 12.5px; color: #33475B; outline: none; background: #fff; box-sizing: border-box; font-family: inherit; }
    .tbc-fld textarea { line-height: 1.5; resize: vertical; }
    .tbc-fld input:focus, .tbc-fld select:focus, .tbc-fld textarea:focus { border-color: #6D4FE3; }
    .tbc-grow { flex: 1; min-width: 140px; }
    .tbc-w80 { width: 84px; flex-shrink: 0; }
    .tbc-row2 { display: flex; gap: 8px; }

    .tbc-origen { background: #FBFAFE; border: 1px solid #DCD2F8; border-radius: 11px; padding: 13px 14px; display: flex; flex-direction: column; gap: 11px; }
    .tbc-origen-h { font-size: 10.5px; letter-spacing: .4px; color: #6D4FE3; font-weight: 800; }
    .tbc-origen-row { display: flex; gap: 10px; flex-wrap: wrap; }
    .tbc-origen-sel { color: #5838C9 !important; font-weight: 600; border-color: #DCD2F8 !important; }

    .tbc-sublist { display: flex; flex-direction: column; gap: 6px; }
    .tbc-sub { display: flex; align-items: center; gap: 9px; border: 1px solid #E1E8EE; border-radius: 9px; padding: 8px 11px; background: #FBFCFD; }
    .tbc-chk { width: 18px; height: 18px; border-radius: 6px; border: 1.5px solid #C3D0DD; background: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer; padding: 0; }
    .tbc-chk.on { border-color: #1A8754; background: #1A8754; }
    .tbc-sub-t { flex: 1; min-width: 0; font-size: 12.5px; font-weight: 600; color: #33475B; }
    .tbc-sub-t.done { color: #A6B7C8; text-decoration: line-through; }
    .tbc-sub-x { width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #C3D0DD; flex-shrink: 0; border: 0; background: transparent; cursor: pointer; }
    .tbc-sub-x:hover { background: #FDE7E7; color: #D7263D; }
    .tbc-subtask { cursor: pointer; }
    .tbc-subtask:hover { border-color: #B9AEF3; background: #F7F5FE; }
    .tbc-sub-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .tbc-sub-est { font-size: 10.5px; font-weight: 700; color: #7C98B6; background: #EEF3F8; border-radius: 20px; padding: 2px 8px; flex-shrink: 0; }
    .tbc-sub-add { display: flex; gap: 7px; }
    .tbc-sub-add input { flex: 1; min-width: 0; border: 1px solid #E1E8EE; border-radius: 8px; padding: 8px 11px; font-size: 12.5px; color: #33475B; outline: none; background: #fff; box-sizing: border-box; }
    .tbc-sub-add input:focus { border-color: #6D4FE3; }
    .tbc-add-btn { display: flex; align-items: center; gap: 5px; padding: 8px 13px; border-radius: 8px; border: 1px solid #DCD2F8; background: #F1ECFD; color: #6D4FE3; font-size: 12px; font-weight: 700; flex-shrink: 0; cursor: pointer; }
    .tbc-add-btn:hover { background: #E6DEFA; }

    .tbc-estados { display: flex; flex-direction: column; gap: 5px; }
    .tbc-est { text-align: left; font-size: 12px; font-weight: 700; padding: 8px 11px; border-radius: 8px; border: 1px solid #E1E8EE; color: #516F90; background: #fff; cursor: pointer; }
    .tbc-est:hover { border-color: #6D4FE3; }
    .tbc-est.on { border-color: #6D4FE3; color: #fff; background: #6D4FE3; }
    .tbc-prios { display: flex; gap: 5px; }
    .tbc-prio2 { flex: 1; font-size: 11.5px; font-weight: 700; padding: 8px 4px; border-radius: 8px; border: 1px solid #E1E8EE; color: #516F90; background: #fff; cursor: pointer; }
    .tbc-prio2:hover { border-color: #6D4FE3; }
    .tbc-prio2.on { border-color: #6D4FE3; color: #fff; background: #6D4FE3; }

    /* Progreso en el modal */
    .tbc-prog-edit, .tbc-prog-ro { display: flex; align-items: center; gap: 10px; }
    .tbc-prog-edit input[type=range] { flex: 1; }
    .tbc-prog-v { font-size: 12.5px; font-weight: 700; width: 42px; text-align: right; }

    /* Etiquetas (tags) en el modal */
    .tbc-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .tbc-tag { font-size: 11.5px; font-weight: 700; padding: 4px 11px; border-radius: 20px; border: 1px solid #E1E8EE; color: #516F90; background: #fff; cursor: pointer; }
    .tbc-tag:hover { border-color: #6D4FE3; }
    .tbc-tag.on { color: #fff; }
    .tbc-tag-add { display: flex; gap: 6px; margin-top: 8px; }
    .tbc-tag-add input { flex: 1; border: 1px solid #E1E8EE; border-radius: 8px; padding: 8px 10px; font-size: 12.5px; color: #33475B; outline: none; }
    .tbc-tag-add input:focus { border-color: #6D4FE3; }

    .tbc-resps { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 7px; }
    .tbc-resp { display: flex; align-items: center; gap: 6px; background: #F5F8FA; border: 1px solid #E1E8EE; border-radius: 20px; padding: 3px 9px 3px 3px; }
    .tbc-resp .tb-ava { width: 24px; height: 24px; font-size: 10px; border: 0; }
    .tbc-resp-nm { font-size: 11.5px; font-weight: 600; color: #33475B; }
    .tbc-resp-x { display: flex; color: #C3D0DD; border: 0; background: transparent; cursor: pointer; padding: 0; }
    .tbc-resp-x:hover { color: #D7263D; }
    .tbc-resp-add { display: flex; gap: 6px; }
    /* Solicitante (persona del directorio) */
    .tbc-solic { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; }
    .tbc-solic .tb-ava, .tbc-solic-ava { width: 26px; height: 26px; font-size: 10px; border: 0; margin: 0; }
    .tbc-solic-nm { font-size: 12.5px; font-weight: 700; color: #33475B; }
    .tbc-solic-sel { display: block; }
    .tbc-resp-add select { flex: 1; min-width: 0; border: 1px solid #E1E8EE; border-radius: 9px; padding: 8px 11px; font-size: 12.5px; color: #33475B; outline: none; background: #fff; box-sizing: border-box; }
    .tbc-resp-add select:focus { border-color: #6D4FE3; }
    .tbc-add-sq { width: 34px; flex-shrink: 0; border-radius: 9px; background: #6D4FE3; color: #fff; display: flex; align-items: center; justify-content: center; border: 0; cursor: pointer; }
    .tbc-add-sq:hover { background: #5838C9; }

    .tbc-log { display: flex; flex-direction: column; }
    .tbc-log-i { display: flex; gap: 9px; padding-bottom: 10px; }
    .tbc-log-rail { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
    .tbc-log-dot { width: 8px; height: 8px; border-radius: 50%; background: #6D4FE3; margin-top: 3px; }
    .tbc-log-line { width: 2px; flex: 1; background: #EEF3F8; margin-top: 2px; }
    .tbc-log-t { font-size: 11.5px; font-weight: 600; color: #33475B; line-height: 1.4; }
    .tbc-log-d { font-size: 10px; color: #A6B7C8; }

    .tbc-adjs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .tbc-adj { position: relative; border: 1px solid #E1E8EE; border-radius: 10px; overflow: hidden; background: #fff; }
    .tbc-adj-th { aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg,#F5F1FE,#E6DEFA); color: #6D4FE3; }
    .tbc-adj-th img { width: 100%; height: 100%; object-fit: cover; }
    .tbc-adj-nm { padding: 6px 8px; font-size: 10px; font-weight: 600; color: #33475B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tbc-adj-x { position: absolute; top: 5px; right: 5px; width: 22px; height: 22px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(27,42,58,.55); border: 0; cursor: pointer; }
    .tbc-adj-x:hover { background: #D7263D; }
    .tbc-adj-up { aspect-ratio: 1/1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; border: 1px dashed #D7E0EA; border-radius: 10px; cursor: pointer; font-size: 10.5px; font-weight: 700; color: #6D4FE3; background: #FBFAFE; text-align: center; }
    .tbc-adj-up:hover { border-color: #6D4FE3; background: #F5F1FE; }
    .tbc-adj-up-t { font-size: 10px; }
    .tbc-adj-hint { grid-column: 1 / -1; font-size: 11px; color: #A6B7C8; background: #F8FAFC; border: 1px dashed #D7E0EA; border-radius: 10px; padding: 11px; text-align: center; line-height: 1.4; }

    .tbc-foot { display: flex; align-items: center; gap: 9px; padding: 16px 24px; border-top: 1px solid #EEF3F8; flex-shrink: 0; }

    /* ===== Pestanas del modal de tarjeta ===== */
    .tbc-tabs { display: flex; align-items: center; gap: 2px; padding: 0 22px; border-bottom: 1px solid #EEF3F8; flex-shrink: 0; }
    .tbc-tab { display: inline-flex; align-items: center; gap: 6px; padding: 12px 14px; border: 0; background: transparent; font-family: inherit; font-size: 12.5px; font-weight: 700; color: #7C98B6; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .tbc-tab:hover { color: #6D4FE3; }
    .tbc-tab.on { color: #6D4FE3; border-bottom-color: #6D4FE3; }
    .tbc-tab-badge { font-size: 10px; font-weight: 800; min-width: 17px; height: 17px; padding: 0 5px; border-radius: 9px; background: #F1ECFD; color: #6D4FE3; display: inline-flex; align-items: center; justify-content: center; }
    .tbc-tab.on .tbc-tab-badge { background: #6D4FE3; color: #fff; }

    /* ===== Pestana Archivos: miniaturas + visor grande ===== */
    .tbc-files { flex: 1; min-height: 0; padding: 16px 22px; display: flex; gap: 16px; }
    .tbc-files-hint { flex: 1; align-self: center; text-align: center; font-size: 12.5px; color: #A6B7C8; background: #F8FAFC; border: 1px dashed #D7E0EA; border-radius: 10px; padding: 22px; }
    .tbc-thumbs { width: 216px; flex-shrink: 0; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; padding-right: 3px; }
    .tbc-thumb { position: relative; display: flex; align-items: center; gap: 9px; border: 1px solid #E1E8EE; border-radius: 10px; padding: 7px 9px; background: #fff; cursor: pointer; }
    .tbc-thumb:hover { border-color: #B9AEF3; background: #FBFAFE; }
    .tbc-thumb.on { border-color: #6D4FE3; background: #F5F1FE; box-shadow: 0 0 0 1px #6D4FE3; }
    .tbc-thumb-ic { width: 44px; height: 44px; border-radius: 8px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg,#F5F1FE,#E6DEFA); color: #6D4FE3; overflow: hidden; }
    .tbc-thumb-ic img { width: 100%; height: 100%; object-fit: cover; }
    .tbc-thumb-nm { flex: 1; min-width: 0; font-size: 11.5px; font-weight: 600; color: #33475B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tbc-thumb-x { width: 24px; height: 24px; flex-shrink: 0; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #C3D0DD; border: 0; background: transparent; cursor: pointer; }
    .tbc-thumb-x:hover { background: #FDE7E7; color: #D7263D; }
    .tbc-thumb-up { display: flex; align-items: center; justify-content: center; gap: 7px; border: 1px dashed #D7E0EA; border-radius: 10px; padding: 12px; cursor: pointer; font-size: 11.5px; font-weight: 700; color: #6D4FE3; background: #FBFAFE; flex-shrink: 0; }
    .tbc-thumb-up:hover { border-color: #6D4FE3; background: #F5F1FE; }
    .tbc-thumb-up-t { font-size: 11.5px; }
    .tbc-viewer { flex: 1; min-width: 0; border: 1px solid #E1E8EE; border-radius: 12px; background: #FAFBFD; display: flex; flex-direction: column; overflow: hidden; }
    .tbc-viewer-imgwrap { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 14px; background: #F1F5F9; overflow: auto; }
    .tbc-viewer-img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 6px; box-shadow: 0 4px 16px rgba(27,42,58,.15); }
    .tbc-viewer-pdfwrap { flex: 1; min-height: 460px; display: flex; background: #525659; }
    .tbc-viewer-pdf { flex: 1; width: 100%; height: 100%; min-height: 460px; border: 0; }
    .tbc-viewer-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 14px; border-top: 1px solid #EEF3F8; background: #fff; }
    .tbc-viewer-nm { font-size: 12px; font-weight: 700; color: #33475B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tbc-viewer-open { font-size: 11.5px; font-weight: 700; color: #6D4FE3; text-decoration: none; border: 1px solid #DCD2F8; border-radius: 8px; padding: 6px 13px; background: #F1ECFD; flex-shrink: 0; }
    .tbc-viewer-open:hover { background: #E6DEFA; }
    .tbc-viewer-empty, .tbc-viewer-file { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; color: #A6B7C8; text-align: center; padding: 24px; }
    .tbc-viewer-empty p, .tbc-viewer-file p { font-size: 13.5px; font-weight: 700; color: #516F90; margin: 0; max-width: 320px; word-break: break-word; }
    .tbc-viewer-empty span { font-size: 11.5px; color: #A6B7C8; max-width: 300px; }
    .tbc-viewer-file { color: #6D4FE3; }

    /* ===== Pestana Actividad: reportar + comentarios + historial ===== */
    .tbc-activity { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 22px; display: flex; flex-direction: column; gap: 16px; }
    .tbc-act-report { display: flex; flex-direction: column; gap: 8px; }
    .tbc-act-input { width: 100%; box-sizing: border-box; border: 1px solid #E1E8EE; border-radius: 9px; padding: 10px 12px; font-size: 12.5px; color: #33475B; outline: none; resize: vertical; font-family: inherit; line-height: 1.5; }
    .tbc-act-input:focus { border-color: #6D4FE3; }
    .tbc-act-actions { display: flex; align-items: center; gap: 9px; }
    .tbc-act-cols { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px 20px; align-items: start; }
    .tbc-act-col { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .tbc-act-empty { font-size: 12px; color: #A6B7C8; font-style: italic; background: #F8FAFC; border: 1px dashed #E1E8EE; border-radius: 9px; padding: 12px; text-align: center; }
    .tbc-cmts { display: flex; flex-direction: column; gap: 10px; }
    .tbc-cmt { display: flex; gap: 10px; }
    .tbc-cmt-ava { width: 30px; height: 30px; font-size: 11px; flex-shrink: 0; border: 0; margin-right: 0; }
    .tbc-cmt-body { flex: 1; min-width: 0; background: #F8FAFC; border: 1px solid #EEF3F8; border-radius: 10px; padding: 9px 12px; }
    .tbc-cmt-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 3px; }
    .tbc-cmt-au { font-size: 12px; font-weight: 700; color: #33475B; }
    .tbc-cmt-dt { font-size: 10.5px; color: #A6B7C8; font-weight: 600; flex-shrink: 0; }
    .tbc-cmt-tx { font-size: 12.5px; color: #33475B; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }

    /* ===== Registro de actividad estilo CHAT (dos tonos, avatar a ambos lados, nombre+hora arriba, separador de dia) ===== */
    .tbc-chat { display: flex; flex-direction: column; gap: 12px; padding: 2px; }
    /* Separador de dia centrado (Hoy / Ayer / fecha) */
    .tbc-daysep { display: flex; align-items: center; justify-content: center; margin: 2px 0; }
    .tbc-daysep span { font-size: 10.5px; font-weight: 800; color: #8598AE; background: #EEF2F7; border-radius: 20px; padding: 3px 12px; }
    /* Cada mensaje: avatar + (nombre/hora arriba, burbuja abajo). Entrante a la izquierda, propio a la derecha. */
    .tbc-msg { display: flex; gap: 8px; align-items: flex-end; max-width: 90%; align-self: flex-start; }
    .tbc-msg.mine { align-self: flex-end; flex-direction: row-reverse; }
    .tbc-msg-ava { width: 28px; height: 28px; font-size: 10.5px; flex-shrink: 0; border: 0; margin: 0; }
    .tbc-msg-col { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .tbc-msg.mine .tbc-msg-col { align-items: flex-end; }
    .tbc-msg-meta { display: flex; align-items: baseline; gap: 7px; padding: 0 4px; }
    .tbc-msg-au { font-size: 11.5px; font-weight: 800; color: #33475B; }
    .tbc-msg.mine .tbc-msg-au { color: #4B6FD1; }
    .tbc-msg-dt { font-size: 10.5px; color: #A6B7C8; font-weight: 600; }
    /* Burbuja: entrante = crema, propia = azul; esquina "cola" hacia su avatar */
    .tbc-bubble { min-width: 0; max-width: 100%; background: #FEF8E6; border: 1px solid #F5EBC7; border-radius: 14px 14px 14px 4px; padding: 9px 12px; }
    .tbc-msg.mine .tbc-bubble { background: #E9F1FD; border-color: #D2E1F7; border-radius: 14px 14px 4px 14px; }
    .tbc-bubble.has-file { max-width: 260px; }
    .tbc-bubble-tx { font-size: 13px; color: #2B3B4E; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }

    /* ===== Actividad como CHAT (columna 3 del tab Detalle): timeline arriba + compositor abajo ===== */
    .tbc-actchat { display: flex; flex-direction: column; min-height: 0; height: 100%; gap: 8px; }
    .tbc-actchat-h { display: flex; align-items: baseline; gap: 8px; }
    /* Sin caja: el chat es solo el area con las burbujas (sin borde/fondo/sombra). */
    .tbc-chat-scroll { flex: 1 1 auto; min-height: 120px; overflow-y: auto; overflow-x: hidden; padding: 2px 2px 6px; background: transparent; border: 0; }
    .tbc-chat-scroll::-webkit-scrollbar { width: 6px; }
    .tbc-chat-scroll::-webkit-scrollbar-thumb { background: #CBD6E2; border-radius: 4px; }
    .tbc-chat-composer { display: flex; align-items: flex-end; gap: 6px; border: 1px solid #E1E8EE; border-radius: 24px; padding: 5px 6px; background: #fff; box-shadow: 0 1px 3px rgba(27,42,58,.05); }
    .tbc-chat-composer:focus-within { border-color: #6D4FE3; box-shadow: 0 0 0 3px rgba(109,79,227,.12); }
    .tbc-chat-clip { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; color: #6D4FE3; background: #F3F0FE; cursor: pointer; flex-shrink: 0; }
    .tbc-chat-clip:hover { background: #E7E0FC; }
    .tbc-chat-clip-load { font-size: 15px; font-weight: 800; color: #6D4FE3; }
    .tbc-chat-input { flex: 1 1 auto; border: 0; outline: none; resize: none; font-family: inherit; font-size: 13px; color: #33475B; line-height: 1.5; padding: 8px 6px; max-height: 96px; background: transparent; }
    .tbc-chat-send { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; border: 0; background: #6D4FE3; color: #fff; cursor: pointer; flex-shrink: 0; }
    .tbc-chat-send:disabled { background: #C7CEDA; cursor: not-allowed; }
    /* Compositor: contenedor relativo para anclar el popover de menciones y el chip de archivo. */
    .tbc-composerwrap { position: relative; display: flex; flex-direction: column; gap: 6px; }
    /* Chip del archivo pendiente (se sube junto con el comentario) */
    .tbc-pendfile { display: inline-flex; align-items: center; gap: 7px; align-self: flex-start; max-width: 100%; background: #F3F0FE; border: 1px solid #DED4FB; color: #4B3AA6; border-radius: 10px; padding: 6px 10px; font-size: 12px; font-weight: 700; }
    .tbc-pendfile-nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 220px; }
    .tbc-pendfile-x { display: inline-flex; border: 0; background: transparent; color: #7C6BC7; cursor: pointer; padding: 0; }
    .tbc-pendfile-x:hover { color: #4B3AA6; }
    /* Caption de un archivo (texto que acompana al adjunto dentro de la burbuja) */
    .tbc-bubble-cap { margin-top: 4px; }
    /* Popover de menciones (arroba usuario) */
    .tbc-mencion-pop { position: absolute; bottom: calc(100% + 6px); left: 0; right: 0; max-height: 210px; overflow-y: auto; background: #fff; border: 1px solid #E1E8EE; border-radius: 12px; box-shadow: 0 10px 30px rgba(27,42,58,.16); padding: 5px; z-index: 40; }
    .tbc-mencion-it { display: flex; align-items: center; gap: 9px; width: 100%; border: 0; background: transparent; padding: 7px 9px; border-radius: 8px; cursor: pointer; text-align: left; font-family: inherit; }
    .tbc-mencion-it:hover { background: #F3F0FE; }
    .tbc-mencion-ava { width: 26px; height: 26px; font-size: 10px; flex-shrink: 0; border: 0; margin: 0; }
    .tbc-mencion-nm { font-size: 12.5px; font-weight: 700; color: #33475B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    [data-bs-theme="dark"] .tbc-mencion-pop { background: #1a1a35; border-color: #3a3a5a; }
    [data-bs-theme="dark"] .tbc-mencion-it:hover { background: #262647; }
    [data-bs-theme="dark"] .tbc-mencion-nm { color: #d5d9f0; }
    [data-bs-theme="dark"] .tbc-pendfile { background: #262647; border-color: #3a3a5a; color: #b9a8f5; }
    /* Burbuja con archivo adjunto dentro del chat: previsualizacion (imagen o PDF) + chip con el nombre */
    .tbc-bubble-img { margin: 2px 0 5px; border-radius: 8px; overflow: hidden; cursor: zoom-in; max-width: 100%; }
    .tbc-bubble-img img { display: block; width: 100%; max-height: 220px; object-fit: cover; }
    .tbc-bubble-pdf { position: relative; display: block; margin: 2px 0 5px; border: 1px solid #E7EDF3; border-radius: 8px; overflow: hidden; height: 160px; background: #fff; cursor: pointer; }
    .tbc-bubble-pdf-fr { width: 100%; height: 100%; border: 0; pointer-events: none; background: #fff; }
    .tbc-bubble-pdf-hint { position: absolute; right: 6px; bottom: 6px; font-size: 10px; font-weight: 800; color: #fff; background: rgba(27,42,58,.72); border-radius: 12px; padding: 2px 9px; }
    .tbc-bubble-file { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: #4B3AA6; background: rgba(109,79,227,.08); border: 1px solid rgba(109,79,227,.18); border-radius: 8px; padding: 5px 9px; font-size: 12px; font-weight: 700; max-width: 100%; }
    .tbc-bubble-file:hover { background: rgba(109,79,227,.15); }
    .tbc-bubble-fnm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ===== Tab Historial ===== */
    .tbc-histtab { padding: 12px 18px 14px 20px; overflow-y: auto; }

    /* ===== Bandeja CERRADOS: tabla de consulta plana (sin diseno de tablero) ===== */
    .tb-cerr { overflow-x: auto; }
    .tb-cerr-empty { font-size: 13px; color: #90A4BC; background: #F8FAFC; border: 1px dashed #DCE6EF; border-radius: 12px; padding: 34px; text-align: center; }
    .tb-cerr-tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .tb-cerr-tbl thead th { text-align: left; font-size: 10.5px; letter-spacing: .4px; text-transform: uppercase; color: #90A4BC; font-weight: 800; padding: 8px 12px; border-bottom: 2px solid #EEF3F8; white-space: nowrap; }
    .tb-cerr-row { cursor: pointer; border-bottom: 1px solid #F1F5F9; }
    .tb-cerr-row:hover { background: #F8FAFC; }
    .tb-cerr-tbl td { padding: 10px 12px; color: #33475B; vertical-align: middle; }
    .tb-cerr-num { font-weight: 800; color: #6D4FE3; white-space: nowrap; }
    .tb-cerr-tit { font-weight: 700; }
    .tb-cerr-prio { font-size: 10.5px; font-weight: 800; padding: 2px 8px; border-radius: 20px; background: #EEF3F8; color: #64748B; }
    .tb-cerr-prio-Urgente { background: #FDE7E7; color: #D8443C; }
    .tb-cerr-prio-Alta { background: #FEF0E1; color: #C77B18; }
    .tb-cerr-prio-Normal { background: #E7EEFB; color: #3B62C0; }
    .tb-cerr-prio-Baja { background: #EAF5EE; color: #2F8B54; }
    .tb-cerr-est { display: inline-block; font-size: 10.5px; font-weight: 800; color: #fff; padding: 2px 9px; border-radius: 20px; white-space: nowrap; }
    .tb-cerr-mot { color: #5A6B7E; }
    .tb-cerr-dt { color: #90A4BC; white-space: nowrap; }
    .tb-cerr-act { text-align: right; white-space: nowrap; }
    .tb-cerr-reab { display: inline-flex; align-items: center; gap: 5px; border: 1px solid #E1E8EE; background: #fff; color: #4B3AA6; font-size: 11.5px; font-weight: 800; padding: 5px 10px; border-radius: 8px; cursor: pointer; }
    .tb-cerr-reab:hover { background: #F3F0FE; border-color: #C9BCF7; }
    [data-bs-theme="dark"] .tbc-chat-scroll { background: transparent; border: 0; }
    [data-bs-theme="dark"] .tbc-chat-composer { background: #1a1a35; border-color: #3a3a5a; }
    [data-bs-theme="dark"] .tbc-chat-input { color: #d5d9f0; }
    [data-bs-theme="dark"] .tb-cerr-tbl td { color: #c5cae0; }
    [data-bs-theme="dark"] .tb-cerr-row { border-bottom-color: #24243f; }
    [data-bs-theme="dark"] .tb-cerr-row:hover { background: #1c1c38; }
    [data-bs-theme="dark"] .tb-cerr-reab { background: #1a1a35; border-color: #3a3a5a; color: #b9a8f5; }

    /* ===== Etiqueta "subido por" en adjuntos ===== */
    .tbc-thumb-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    .tbc-thumb-by { display: inline-flex; align-items: center; gap: 3px; font-size: 9.5px; font-weight: 700; color: #7C98B6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tbc-viewer-meta { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    .tbc-viewer-by { font-size: 10.5px; font-weight: 700; color: #7C98B6; }

    /* ===== Visor de imagen ampliable + lightbox a pantalla completa ===== */
    .tbc-viewer-imgwrap--zoom { position: relative; cursor: zoom-in; }
    .tbc-viewer-zoom { position: absolute; right: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 800; color: #fff; background: rgba(27,42,58,.72); border-radius: 20px; padding: 5px 11px; pointer-events: none; }
    .tbc-lightbox { position: fixed; inset: 0; z-index: 3200; background: rgba(8,12,20,.9); display: flex; align-items: center; justify-content: center; padding: 30px; cursor: zoom-out; }
    .tbc-lightbox-img { max-width: 94vw; max-height: 94vh; object-fit: contain; border-radius: 8px; box-shadow: 0 12px 60px rgba(0,0,0,.5); cursor: default; }
    .tbc-lightbox-x { position: fixed; top: 18px; right: 22px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255,255,255,.14); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .tbc-lightbox-x:hover { background: rgba(255,255,255,.28); }

    /* Traza de copias */
    .tbc-copia-bc { display: inline-flex; align-items: center; gap: 4px; border: 0; background: rgba(255,255,255,.22); color: #fff; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 20px; cursor: pointer; }
    .tbc-copia-bc:hover { background: rgba(255,255,255,.35); }
    .tbc-copia-ic { width: 20px; height: 20px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #6D4FE3; background: #F1ECFD; border-radius: 6px; }
    /* Mini-modal copiar tarea */
    .tbcopy { width: min(460px, 94vw); background: #fff; border-radius: 16px; box-shadow: 0 24px 60px rgba(45,62,80,.28); overflow: hidden; display: flex; flex-direction: column; }
    .tbcopy-h { display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; border-bottom: 1px solid #EEF3F8; }
    .tbcopy-h span { display: flex; align-items: center; gap: 8px; font-size: 14.5px; font-weight: 800; color: #33475B; }
    .tbcopy-bd { padding: 16px 18px; display: flex; flex-direction: column; gap: 12px; }
    .tbcopy-src { font-size: 12px; color: #7C98B6; }
    .tbcopy-src b { color: #33475B; }
    .tbcopy-row { display: flex; gap: 10px; }
    .tbcopy-grow { flex: 1; }
    .tbcopy-cant { width: 84px; flex-shrink: 0; }
    .tbcopy-bd input, .tbcopy-bd select { width: 100%; box-sizing: border-box; border: 1px solid #D7E0EA; border-radius: 8px; padding: 7px 10px; font-size: 13px; color: #33475B; outline: none; }
    .tbcopy-bd input:focus, .tbcopy-bd select:focus { border-color: #6D4FE3; }
    .tbcopy-tglbl { font-size: 11px; font-weight: 700; letter-spacing: .3px; color: #A6B7C8; }
    .tbcopy-toggles { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 12px; }
    .tbcopy-tg { display: flex; align-items: center; gap: 7px; font-size: 12.5px; color: #516F90; font-weight: 600; cursor: pointer; }
    .tbcopy-tg input { width: auto !important; accent-color: #6D4FE3; }
    .tbcopy-note { font-size: 11.5px; color: #7C98B6; background: #F7F9FB; border-radius: 8px; padding: 8px 10px; }
    .tbcopy-foot { display: flex; align-items: center; justify-content: flex-end; gap: 9px; padding: 14px 18px; border-top: 1px solid #EEF3F8; }

    /* ===== Modal Configurar tablero ===== */
    .tbcfg-h { font-size: 11px; letter-spacing: .5px; color: #A6B7C8; font-weight: 700; margin-bottom: 10px; }
    .tbcfg-list { display: flex; flex-direction: column; gap: 7px; margin-bottom: 10px; }
    .tbcfg-est { display: flex; align-items: center; gap: 10px; border: 1px solid #E1E8EE; border-radius: 10px; padding: 10px 12px; }
    .tbcfg-dot { width: 11px; height: 11px; border-radius: 50%; flex-shrink: 0; }
    .tbcfg-est-nom { flex: 1; font-size: 13px; font-weight: 700; color: #33475B; }
    .tbcfg-est-cnt { font-size: 11px; color: #A6B7C8; }
    .tbcfg-del { width: 26px; height: 26px; border-radius: 7px; display: flex; align-items: center; justify-content: center; color: #C3D0DD; border: 0; background: transparent; cursor: pointer; flex-shrink: 0; }
    .tbcfg-del:hover { background: #FDE7E7; color: #D7263D; }
    .tbcfg-add { display: flex; gap: 7px; }
    .tbcfg-add input { flex: 1; min-width: 0; border: 1px solid #E1E8EE; border-radius: 8px; padding: 9px 11px; font-size: 13px; color: #33475B; outline: none; background: #fff; box-sizing: border-box; }
    .tbcfg-add input:focus { border-color: #6D4FE3; }
