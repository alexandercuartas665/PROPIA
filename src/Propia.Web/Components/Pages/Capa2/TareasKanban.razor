    // Lista mutable de tareas (copia de _board.Tareas) para edicion inline optimista sin recargar todo el board.
    private List<TareaListaDto> _tareas = new();
    private void SyncTareas() => _tareas = _board?.Tareas.ToList() ?? new();

    private async Task AbrirBoardAsync(Guid id)
    {
        _board = await Auth().GetFromJsonAsync<TableroBoardDto>($"/api/tareas/tableros/{id}/board");
        SyncTareas();
        await RestaurarColsAsync();   // config de columnas guardada para ESTE tablero (por usuario)
        _boardMode = await LeerVistaGuardadaAsync();   // abre en el ultimo modo de vista del usuario
        try { await Js.InvokeVoidAsync("localStorage.setItem", TbLastKey, id.ToString()); } catch { }
        _expandidas.Clear();
        _nuevaFilas.Clear();
        LimpiarFiltros();
        if (_personas is null)
        {
            try { var raw = await Auth().GetFromJsonAsync<List<PersonaRaw>>("/api/directorio/personas") ?? new(); _personas = raw.Select(p => new PersonaMini(p.Id, ($"{p.Nombres} {p.Apellidos}").Trim())).ToList(); }
            catch { _personas = new(); }
        }
        if (_unidades is null || _zonas is null || _equipos is null) await CargarContextoAsync();
    }

