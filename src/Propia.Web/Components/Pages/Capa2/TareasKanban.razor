    /* Selector de copropiedad (prototipo v2) */
    .tb-cosel { position: relative; flex-shrink: 0; }
    .tb-cosel-btn { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid #E1E8EE; border-radius: 10px; padding: 9px 12px; font-size: 13px; font-weight: 700; color: #33475B; cursor: pointer; }
    .tb-cosel-btn:hover:not(:disabled) { border-color: #6D4FE3; }
