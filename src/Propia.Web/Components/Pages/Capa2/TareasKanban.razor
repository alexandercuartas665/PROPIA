    .tb-color.on { border-color: #1B2A3A; }
    .tb-userlist { display: flex; flex-direction: column; gap: 7px; max-height: 230px; overflow-y: auto; }
    .tb-user { display: flex; align-items: center; gap: 11px; text-align: left; border: 1px solid #E1E8EE; background: #fff; border-radius: 10px; padding: 9px 12px; cursor: pointer; }
    .tb-user.on { border-color: #6D4FE3; background: #F5F1FE; }
    .tb-user .tb-ava { margin-right: 0; }
    .tb-user-nom { flex: 1; font-size: 13px; font-weight: 600; color: #33475B; }
    .tb-note { font-size: 11.5px; color: #7C5CE8; background: #FBFAFE; border: 1px dashed #DCD2F8; border-radius: 9px; padding: 9px 11px; }
</style>

@code {
    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");
    private string? _jwt;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";

    private List<TableroDto>? _tableros;
    private TableroBoardDto? _board;
    private string _boardMode = "tablero";
    private List<PersonaMini>? _personas;
    private readonly HashSet<Guid> _expandidas = new();

    private string _fEstado = ""; private string _fResp = ""; private string _fPrio = ""; private bool _sortTitulo;

    private TableroDraft? _tableroDraft;
    private CardDraft? _cardDraft;

    private static readonly string[] _colores = { "#6D4FE3", "#2563EB", "#1A8754", "#F59E0B", "#EF4444", "#7C3AED", "#0EA5E9", "#EC4899" };

    private record ModeDef(string Key, string Label, string Icon);
    private readonly List<ModeDef> _modes = new()
    {
        new("tablero", "Tablero", "<svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='3' width='7' height='18' rx='1'/><rect x='14' y='3' width='7' height='12' rx='1'/></svg>"),
        new("lista", "Lista", "<svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01'/></svg>"),
        new("calendario", "Calendario", "<svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg>"),
        new("gantt", "Gantt", "<svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M3 6h10M3 12h14M3 18h7'/></svg>"),
    };

    private class TableroDraft
    {
        public Guid? Id { get; set; }
        public string Nombre { get; set; } = "";
        public string? Descripcion { get; set; }
        public string Color { get; set; } = "#6D4FE3";
        public HashSet<Guid> UsuarioIds { get; set; } = new();
    }

    private class CardDraft
    {
        public Guid? Id { get; set; }
        public string Titulo { get; set; } = "";
        public string? Descripcion { get; set; }
        public PrioridadTarea Prioridad { get; set; } = PrioridadTarea.Normal;
        public Guid EstadoId { get; set; }
        public Guid? AsignadoPersonaId { get; set; }
        public DateTime? FechaVencimiento { get; set; }
        public string Color { get; set; } = "#6D4FE3";
    }

    private record PersonaMini(Guid Id, string Nombre);
    private record PersonaRaw(Guid Id, string Nombres, string Apellidos);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            _tableros = await Auth().GetFromJsonAsync<List<TableroDto>>("/api/tareas/tableros") ?? new();
            if (_personas is null)
            {
                try
                {
                    var raw = await Auth().GetFromJsonAsync<List<PersonaRaw>>("/api/directorio/personas") ?? new();
                    _personas = raw.Select(p => new PersonaMini(p.Id, ($"{p.Nombres} {p.Apellidos}").Trim())).ToList();
                }
                catch { _personas = new(); }
            }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task AbrirBoardAsync(Guid id)
    {
        _board = await Auth().GetFromJsonAsync<TableroBoardDto>($"/api/tareas/tableros/{id}/board");
        _boardMode = "tablero";
        _expandidas.Clear();
        LimpiarFiltros();
    }
    private void CerrarBoard() { _board = null; }
    private async Task RecargarBoard() { if (_board is not null) _board = await Auth().GetFromJsonAsync<TableroBoardDto>($"/api/tareas/tableros/{_board.Tablero.Id}/board"); }

    private List<TareaListaDto> RaicesPorEstado(Guid estadoId) =>
        _board?.Tareas.Where(t => t.PadreId == null && t.EstadoId == estadoId).ToList() ?? new();
    private List<TareaListaDto> Hijos(Guid padreId) =>
        _board?.Tareas.Where(t => t.PadreId == padreId).ToList() ?? new();

    private bool HayFiltros => !string.IsNullOrEmpty(_fEstado) || !string.IsNullOrEmpty(_fResp) || !string.IsNullOrEmpty(_fPrio);
    private void LimpiarFiltros() { _fEstado = ""; _fResp = ""; _fPrio = ""; }
    private IEnumerable<string> RespOptions() =>
        (_board?.Tareas ?? new List<TareaListaDto>()).Where(t => !string.IsNullOrWhiteSpace(t.AsignadoNombre))
            .Select(t => t.AsignadoNombre!).Distinct().OrderBy(x => x);
    private bool PasaFiltros(TareaListaDto t)
    {
        if (!string.IsNullOrEmpty(_fEstado) && t.EstadoId.ToString() != _fEstado) return false;
        if (!string.IsNullOrEmpty(_fResp) && t.AsignadoNombre != _fResp) return false;
        if (!string.IsNullOrEmpty(_fPrio) && t.Prioridad.ToString() != _fPrio) return false;
        return true;
    }

    private RenderFragment RenderFila(TareaListaDto t, int depth) => __builder =>
    {
        var tarea = t;
        <div class="tb-row" style="border-left-color:@(t.Color ?? "transparent")">
            <div class="tb-row-tit" style="padding-left:@(depth * 22)px">
                @if (depth == 0 && t.CantidadSubtareas > 0)
                {
                    <button class="tb-exp" @onclick="() => ToggleExp(tarea.Id)">
                        @if (_expandidas.Contains(t.Id))
                        { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14"/></svg> }
                        else { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M5 12h14"/></svg> }
                    </button>
                }
                <button class="tb-row-titbtn" @onclick="() => AbrirCardDraft(tarea, null)">
                    <div class="tb-row-t">@t.Titulo</div>
                </button>
            </div>
            <div style="width:130px;flex-shrink:0">
                @if (depth == 0)
                {
                    <select class="tb-est-sel" style="background:@(t.EstadoColor ?? "#6D4FE3")" value="@t.EstadoId" @onchange="(e) => CambiarEstadoFila(tarea.Id, e)">
                        @if (_board is not null) { @foreach (var e in _board.Estados) { <option value="@e.Id" style="background:#fff;color:#33475B">@e.Nombre</option> } }
                    </select>
                }
                else { <span class="tb-subtag">Subtarea</span> }
            </div>
            <div class="tb-row-resp">@(string.IsNullOrWhiteSpace(t.AsignadoNombre) ? "-" : t.AsignadoNombre)</div>
            <div class="tb-row-prog">
                <input type="range" min="0" max="100" step="5" value="@t.Progreso" style="accent-color:@(t.Progreso >= 100 ? "#1A8754" : "#6D4FE3")" @onchange="(e) => CambiarProgresoFila(tarea.Id, e)" />
                <span class="tb-row-progv" style="color:@(t.Progreso >= 100 ? "#1A8754" : "#516F90")">@t.Progreso%</span>
            </div>
            <div class="tb-row-prio"><span class="tb-prio" style="color:@PrioFg(t.Prioridad);background:@PrioBg(t.Prioridad)">@t.Prioridad</span></div>
            <div class="tb-row-due">@(t.FechaVencimiento.HasValue ? FechaCorta(t.FechaVencimiento.Value) : "-")</div>
        </div>
    };

    private void ToggleExp(Guid id) { if (!_expandidas.Add(id)) _expandidas.Remove(id); }

    private async Task CambiarEstadoFila(Guid tareaId, ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var estadoId)) return;
        var resp = await Auth().PutAsJsonAsync($"/api/tareas/{tareaId}/estado", new CambiarEstadoRequest(estadoId, null));
        if (resp.IsSuccessStatusCode) await RecargarBoard();
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }
    private async Task CambiarProgresoFila(Guid tareaId, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var p)) return;
        await Auth().PutAsJsonAsync($"/api/tareas/{tareaId}/progreso", new ActualizarProgresoRequest(p));
        await RecargarBoard();
    }

    private void AbrirTableroDraft(TableroDto? b)
    {
        _tableroDraft = b is null
            ? new TableroDraft()
            : new TableroDraft { Id = b.Id, Nombre = b.Nombre, Descripcion = b.Descripcion, Color = b.Color, UsuarioIds = b.Usuarios.Select(u => u.PersonaId).ToHashSet() };
    }
    private void ToggleUsuario(Guid pid) { if (_tableroDraft is null) return; if (!_tableroDraft.UsuarioIds.Add(pid)) _tableroDraft.UsuarioIds.Remove(pid); }
    private async Task GuardarTablero()
    {
        if (_tableroDraft is null || string.IsNullOrWhiteSpace(_tableroDraft.Nombre)) return;
        _busy = true;
        try
        {
            var req = new GuardarTableroRequest(_tableroDraft.Nombre.Trim(), _tableroDraft.Descripcion, _tableroDraft.Color, _tableroDraft.UsuarioIds.ToList());
            var resp = _tableroDraft.Id is null
                ? await Auth().PostAsJsonAsync("/api/tareas/tableros", req)
                : await Auth().PutAsJsonAsync($"/api/tareas/tableros/{_tableroDraft.Id}", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _tableroDraft = null;
            await CargarAsync();
            await RecargarBoard();
        }
        finally { _busy = false; }
    }
    private async Task EliminarTablero()
    {
        if (_tableroDraft?.Id is null) return;
        if (!await Js.InvokeAsync<bool>("confirm", "Eliminar este tablero? Sus tarjetas se conservan pero el tablero deja de mostrarse.")) return;
        var resp = await Auth().DeleteAsync($"/api/tareas/tableros/{_tableroDraft.Id}");
        if (resp.IsSuccessStatusCode) { _tableroDraft = null; _board = null; await CargarAsync(); }
    }

    private void AbrirCardDraft(TareaListaDto? t, Guid? estadoIdDefault)
    {
        if (t is null)
        {
            _cardDraft = new CardDraft { EstadoId = estadoIdDefault ?? _board?.Estados.FirstOrDefault()?.Id ?? Guid.Empty };
        }
        else
        {
            _cardDraft = new CardDraft
            {
                Id = t.Id, Titulo = t.Titulo, Prioridad = t.Prioridad, EstadoId = t.EstadoId,
                AsignadoPersonaId = t.AsignadoPersonaId, Color = t.Color ?? "#6D4FE3",
                FechaVencimiento = t.FechaVencimiento?.ToDateTime(TimeOnly.MinValue)
            };
        }
    }
    private async Task GuardarCard()
    {
        if (_cardDraft is null || _board is null || string.IsNullOrWhiteSpace(_cardDraft.Titulo)) return;
        _busy = true;
        try
        {
            var venc = _cardDraft.FechaVencimiento.HasValue ? DateOnly.FromDateTime(_cardDraft.FechaVencimiento.Value) : (DateOnly?)null;
            HttpResponseMessage resp;
            if (_cardDraft.Id is null)
            {
                var req = new CrearTareaRequest(_cardDraft.Titulo.Trim(), _cardDraft.Descripcion, _cardDraft.Prioridad,
                    _cardDraft.EstadoId, _cardDraft.AsignadoPersonaId == Guid.Empty ? null : _cardDraft.AsignadoPersonaId,
                    null, venc, null, null, _board.Tablero.Id);
                resp = await Auth().PostAsJsonAsync("/api/tareas", req);
            }
            else
            {
                var req = new ActualizarTareaRequest(_cardDraft.Titulo.Trim(), _cardDraft.Descripcion, _cardDraft.Prioridad,
                    _cardDraft.AsignadoPersonaId == Guid.Empty ? null : _cardDraft.AsignadoPersonaId, null, venc);
                resp = await Auth().PutAsJsonAsync($"/api/tareas/{_cardDraft.Id}", req);
                await Auth().PutAsJsonAsync($"/api/tareas/{_cardDraft.Id}/estado", new CambiarEstadoRequest(_cardDraft.EstadoId, null));
            }
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _cardDraft = null;
            await RecargarBoard();
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private static string Iniciales(string? n)
    {
        var p = (n ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0) return "?";
        if (p.Length == 1) return p[0].Substring(0, Math.Min(2, p[0].Length)).ToUpperInvariant();
        return ("" + p[0][0] + p[1][0]).ToUpperInvariant();
    }
    private static string FechaCorta(DateOnly d)
    {
        var dia = d.ToString("ddd", Es);
        dia = char.ToUpper(dia[0]) + dia.Substring(1);
        return dia + " " + d.Day + " " + d.ToString("MMM", Es);
    }
    private static string PrioFg(PrioridadTarea p) => p switch { PrioridadTarea.Urgente => "#C0383C", PrioridadTarea.Alta => "#B45309", PrioridadTarea.Normal => "#2563EB", _ => "#516F90" };
    private static string PrioBg(PrioridadTarea p) => p switch { PrioridadTarea.Urgente => "#FDE7E7", PrioridadTarea.Alta => "#FEF3DC", PrioridadTarea.Normal => "#E6F2FB", _ => "#EEF3F8" };
}
