@page "/tareas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Propia.Application.Tareas
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<PageTitle>Tareas y proyectos - PROPIA</PageTitle>

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="tb-wrap">

    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

    @* ===================== LISTA DE TABLEROS ===================== *@
    @if (_board is null)
    {
        <div class="tb-head">
            <div>
                <h1 class="tb-title">Tableros de trabajo</h1>
                <p class="tb-sub">Gestiona las acciones de la copropiedad en tableros configurables.</p>
            </div>
            <button class="tb-btn tb-btn-primary" @onclick="() => AbrirTableroDraft(null)"><i class="fi fi-rr-plus"></i>Nuevo tablero</button>
        </div>

        @if (_tableros is null)
        {
            <div class="text-center py-5"><div class="spinner-border" style="color:#6D4FE3"></div></div>
        }
        else
        {
            <div class="tb-grid">
                @foreach (var b in _tableros)
                {
                    var board = b;
                    <div class="tb-card">
                        <div class="tb-card-bar" style="background:@b.Color"></div>
                        <div class="tb-card-body">
                            <div class="tb-card-top">
                                <div class="tb-card-id">
                                    <div class="tb-card-nom">@b.Nombre</div>
                                    <div class="tb-card-desc">@b.Descripcion</div>
                                </div>
                                <button class="tb-card-edit" title="Editar tablero" @onclick="() => AbrirTableroDraft(board)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                            </div>
                            <div class="tb-card-foot">
                                <div class="tb-avatars">
                                    @foreach (var u in b.Usuarios.Take(3)) { <div class="tb-ava" title="@u.Nombre">@u.Iniciales</div> }
                                    @if (b.Usuarios.Count > 3) { <div class="tb-ava tb-ava-more">+@(b.Usuarios.Count - 3)</div> }
                                </div>
                                <span class="tb-card-count">@b.NCards tarjetas</span>
                            </div>
                            <button class="tb-card-open" @onclick="() => AbrirBoardAsync(board.Id)">Abrir tablero<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg></button>
                        </div>
                    </div>
                }
                <button class="tb-card-new" @onclick="() => AbrirTableroDraft(null)">
                    <div class="tb-card-new-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg></div>
                    <span>Crear tablero</span>
                </button>
            </div>
        }
    }

    @* ===================== VISTA DE TABLERO ===================== *@
    else
    {
        <div class="tb-board-head">
            <button class="tb-icon-btn" title="Volver" @onclick="CerrarBoard"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
            <div class="tb-board-color" style="background:@_board.Tablero.Color"></div>
            <div class="tb-board-id">
                <h1 class="tb-board-nom">@_board.Tablero.Nombre</h1>
                <p class="tb-board-desc">@_board.Tablero.Descripcion</p>
            </div>
            <div class="tb-avatars tb-avatars-lg">
                @foreach (var u in _board.Tablero.Usuarios.Take(4)) { <div class="tb-ava" title="@u.Nombre">@u.Iniciales</div> }
            </div>
            <div class="tb-modeswitch">
                @foreach (var m in _modes)
                {
                    var mode = m.Key;
                    <button class="tb-mode @(_boardMode == mode ? "on" : "")" @onclick="() => _boardMode = mode" title="@m.Label">
                        @((MarkupString)m.Icon)<span>@m.Label</span>
                    </button>
                }
            </div>
            <button class="tb-btn tb-btn-soft" @onclick="() => AbrirTableroDraft(_tableros?.FirstOrDefault(x => x.Id == _board!.Tablero.Id))"><i class="fi fi-rr-settings"></i>Configurar</button>
            <button class="tb-btn tb-btn-primary" @onclick="() => AbrirCardDraft(null, _board.Estados.FirstOrDefault()?.Id)"><i class="fi fi-rr-plus"></i>Nueva tarjeta</button>
        </div>

        @* ---------- TABLERO (Kanban) ---------- *@
        @if (_boardMode == "tablero")
        {
            <div class="tb-kanban" style="grid-template-columns:repeat(@_board.Estados.Count, minmax(260px, 1fr))">
                @foreach (var est in _board.Estados)
                {
                    var estado = est;
                    var cards = RaicesPorEstado(est.Id);
                    <div class="tb-col">
                        <div class="tb-col-head">
                            <span class="tb-col-dot" style="background:@(est.Color ?? "#94a3b8")"></span>
                            <span class="tb-col-nom">@est.Nombre</span>
                            <span class="tb-col-count">@cards.Count</span>
                        </div>
                        <div class="tb-col-body">
                            @foreach (var t in cards)
                            {
                                var tarea = t;
                                <button class="tb-tcard" style="border-left-color:@(t.Color ?? est.Color ?? "#6D4FE3")" @onclick="() => AbrirCardDraft(tarea, null)">
                                    <div class="tb-tcard-tit">@t.Titulo</div>
                                    <div class="tb-tcard-meta">
                                        <span class="tb-prio" style="color:@PrioFg(t.Prioridad);background:@PrioBg(t.Prioridad)">@t.Prioridad</span>
                                        @if (t.FechaVencimiento.HasValue) { <span class="tb-due @(t.Vencida ? "venc" : "")">@FechaCorta(t.FechaVencimiento.Value)</span> }
                                    </div>
                                    <div class="tb-tcard-foot">
                                        <span class="tb-tcard-resp">@(string.IsNullOrWhiteSpace(t.AsignadoNombre) ? "Sin asignar" : t.AsignadoNombre)</span>
                                        @if (t.CantidadSubtareas > 0) { <span class="tb-chip">@t.CantidadSubtareas sub</span> }
                                    </div>
                                </button>
                            }
                            <button class="tb-col-add" @onclick="() => AbrirCardDraft(null, estado.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>Agregar</button>
                        </div>
                    </div>
                }
            </div>
        }

        @* ---------- LISTA ---------- *@
        else if (_boardMode == "lista")
        {
            <div class="tb-filters">
                <select class="tb-filter" @bind="_fEstado">
                    <option value="">Todas las etapas</option>
                    @foreach (var e in _board.Estados) { <option value="@e.Id">@e.Nombre</option> }
                </select>
                <select class="tb-filter" @bind="_fResp">
                    <option value="">Todos los responsables</option>
                    @foreach (var r in RespOptions()) { <option value="@r">@r</option> }
                </select>
                <select class="tb-filter" @bind="_fPrio">
                    <option value="">Toda prioridad</option>
                    @foreach (var p in Enum.GetValues<PrioridadTarea>()) { <option value="@p">@p</option> }
                </select>
                @if (HayFiltros) { <button class="tb-filter-clear" @onclick="LimpiarFiltros">Limpiar</button> }
                <div class="tb-flex"></div>
                <button class="tb-filter-btn @(_sortTitulo ? "on" : "")" @onclick="() => _sortTitulo = !_sortTitulo" title="Ordenar por titulo">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h11M3 12h7M3 18h4M17 5v14M17 19l3-3M17 19l-3-3"/></svg>@(_sortTitulo ? "Titulo A-Z" : "Orden")
                </button>
            </div>

            <div class="tb-list">
                <div class="tb-list-hdr">
                    <div class="tb-lc tb-lc-tit">TITULO</div>
                    <div class="tb-lc tb-lc-est">ETAPA</div>
                    <div class="tb-lc tb-lc-resp">ASIGNADO</div>
                    <div class="tb-lc tb-lc-prog">PROGRESO</div>
                    <div class="tb-lc tb-lc-prio">PRIORIDAD</div>
                    <div class="tb-lc tb-lc-due">VENCE</div>
                </div>
                @foreach (var est in _board.Estados)
                {
                    var grupo = RaicesPorEstado(est.Id).Where(PasaFiltros).ToList();
                    if (_sortTitulo) grupo = grupo.OrderBy(t => t.Titulo).ToList();
                    if (!string.IsNullOrEmpty(_fEstado) && _fEstado != est.Id.ToString()) { continue; }
                    var estado = est;
                    <div class="tb-list-group">
                        <span class="tb-col-dot" style="background:@(est.Color ?? "#94a3b8")"></span>
                        <span class="tb-group-nom">@est.Nombre</span>
                        <span class="tb-col-count">@grupo.Count</span>
                        <div class="tb-flex"></div>
                        <button class="tb-group-add" @onclick="() => AbrirCardDraft(null, estado.Id)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>Agregar</button>
                    </div>
                    @foreach (var t in grupo)
                    {
                        @RenderFila(t, 0)
                        @if (_expandidas.Contains(t.Id))
                        {
                            foreach (var hijo in Hijos(t.Id)) { @RenderFila(hijo, 1) }
                        }
                    }
                }
            </div>
        }

        @* ---------- CALENDARIO (preparado) ---------- *@
        else if (_boardMode == "calendario")
        {
            <div class="tb-soon">
                <div class="tb-soon-ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
                <div class="tb-soon-t">Vista Calendario</div>
                <div class="tb-soon-s">Las tarjetas con fecha de vencimiento se veran en un calendario mensual. Proximamente.</div>
            </div>
        }

        @* ---------- GANTT (preparado) ---------- *@
        else if (_boardMode == "gantt")
        {
            <div class="tb-soon">
                <div class="tb-soon-ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h10M3 12h14M3 18h7M21 4v16"/></svg></div>
                <div class="tb-soon-t">Vista Gantt</div>
                <div class="tb-soon-s">Cronograma de barras por tarea (inicio - vencimiento) con dependencias. Proximamente.</div>
            </div>
        }
    }
</div>

@* ===================== Modal crear/editar tablero ===================== *@
@if (_tableroDraft is not null)
{
    <div class="tb-modal-bd" @onclick="() => _tableroDraft = null">
        <div class="tb-modal" @onclick:stopPropagation="true">
            <div class="tb-modal-head">
                <div class="tb-modal-tt">
                    <div class="tb-modal-h">@(_tableroDraft.Id is null ? "Nuevo tablero" : "Editar tablero")</div>
                    <div class="tb-modal-s">Nombre, color y equipo de trabajo</div>
                </div>
                <button class="tb-modal-x" @onclick="() => _tableroDraft = null"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="tb-modal-body">
                <div class="tb-fld"><label>Nombre del tablero *</label><input @bind="_tableroDraft.Nombre" placeholder="Ej. Mantenimiento general" /></div>
                <div class="tb-fld"><label>Descripcion</label><textarea rows="2" @bind="_tableroDraft.Descripcion" placeholder="Para que sirve este tablero?"></textarea></div>
                <div class="tb-fld">
                    <label>Color</label>
                    <div class="tb-colors">
                        @foreach (var c in _colores)
                        {
                            var col = c;
                            <button class="tb-color @(_tableroDraft.Color == col ? "on" : "")" style="background:@col" @onclick="() => _tableroDraft.Color = col"></button>
                        }
                    </div>
                </div>
                <div class="tb-fld">
                    <label>Usuarios que pueden trabajar en el tablero</label>
                    <div class="tb-userlist">
                        @if (_personas is not null)
                        {
                            @foreach (var p in _personas)
                            {
                                var pid = p.Id;
                                var on = _tableroDraft.UsuarioIds.Contains(pid);
                                <button class="tb-user @(on ? "on" : "")" @onclick="() => ToggleUsuario(pid)">
                                    <div class="tb-ava">@Iniciales(p.Nombre)</div>
                                    <span class="tb-user-nom">@p.Nombre</span>
                                    @if (on) { <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#6D4FE3" stroke-width="2.6"><path d="M5 12l5 5 9-11"/></svg> }
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="tb-modal-foot">
                @if (_tableroDraft.Id is not null) { <button class="tb-btn-danger" @onclick="EliminarTablero"><i class="fi fi-rr-trash"></i>Eliminar</button> }
                <div class="tb-flex"></div>
                <button class="tb-btn tb-btn-ghost" @onclick="() => _tableroDraft = null">Cancelar</button>
                <button class="tb-btn tb-btn-primary" @onclick="GuardarTablero" disabled="@(_busy || string.IsNullOrWhiteSpace(_tableroDraft.Nombre))">@(_busy ? "Guardando..." : "Guardar tablero")</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal crear/editar tarjeta (basico - Stage 5 lo hara rico) ===================== *@
@if (_cardDraft is not null)
{
    <div class="tb-modal-bd" @onclick="() => _cardDraft = null">
        <div class="tb-modal" @onclick:stopPropagation="true">
            <div class="tb-modal-head" style="background:@(_cardDraft.Color);">
                <div class="tb-modal-tt">
                    <div class="tb-modal-h" style="color:#fff">@(_cardDraft.Id is null ? "Nueva tarjeta" : "Editar tarjeta")</div>
                    <div class="tb-modal-s" style="color:rgba(255,255,255,.85)">@_board?.Tablero.Nombre</div>
                </div>
                <button class="tb-modal-x" style="color:#fff;border-color:rgba(255,255,255,.4);background:rgba(255,255,255,.12)" @onclick="() => _cardDraft = null"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="tb-modal-body">
                <div class="tb-fld"><label>Titulo *</label><input @bind="_cardDraft.Titulo" placeholder="Ej. Cambio de luminarias piso 3" /></div>
                <div class="tb-fld"><label>Descripcion</label><textarea rows="3" @bind="_cardDraft.Descripcion" placeholder="Detalle de la tarea..."></textarea></div>
                <div class="tb-grid2">
                    <div class="tb-fld"><label>Etapa</label>
                        <select @bind="_cardDraft.EstadoId">@if (_board is not null) { @foreach (var e in _board.Estados) { <option value="@e.Id">@e.Nombre</option> } }</select>
                    </div>
                    <div class="tb-fld"><label>Prioridad</label>
                        <select @bind="_cardDraft.Prioridad">@foreach (var p in Enum.GetValues<PrioridadTarea>()) { <option value="@p">@p</option> }</select>
                    </div>
                </div>
                <div class="tb-grid2">
                    <div class="tb-fld"><label>Responsable</label>
                        <select @bind="_cardDraft.AsignadoPersonaId">
                            <option value="">Sin asignar</option>
                            @if (_personas is not null) { @foreach (var p in _personas) { <option value="@p.Id">@p.Nombre</option> } }
                        </select>
                    </div>
                    <div class="tb-fld"><label>Vence</label><input type="date" @bind="_cardDraft.FechaVencimiento" /></div>
                </div>
                <div class="tb-fld">
                    <label>Color de la tarjeta</label>
                    <div class="tb-colors">
                        @foreach (var c in _colores) { var col = c; <button class="tb-color @(_cardDraft.Color == col ? "on" : "")" style="background:@col" @onclick="() => _cardDraft.Color = col"></button> }
                    </div>
                </div>
                <div class="tb-note">La ficha completa de la tarjeta (origen, proyecto, responsables, subtareas, adjuntos, trazabilidad) llega en la siguiente etapa.</div>
            </div>
            <div class="tb-modal-foot">
                <div class="tb-flex"></div>
                <button class="tb-btn tb-btn-ghost" @onclick="() => _cardDraft = null">Cancelar</button>
                <button class="tb-btn tb-btn-primary" @onclick="GuardarCard" disabled="@(_busy || string.IsNullOrWhiteSpace(_cardDraft.Titulo))">@(_busy ? "Guardando..." : "Guardar")</button>
            </div>
        </div>
    </div>
}
}

<style>
    .tb-wrap { max-width: 1240px; margin: 0 auto; padding: 6px 4px 60px; font-family: 'Lexend', sans-serif; }
    .tb-head, .tb-board-head { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 20px; }
    .tb-head { justify-content: space-between; }
    .tb-title { font-size: 27px; font-weight: 800; letter-spacing: -.6px; color: #1B2A3A; margin: 0; }
    .tb-sub { font-size: 14px; color: #7C98B6; margin: 4px 0 0; }
    .tb-btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 15px; border-radius: 10px; font-size: 13px; font-weight: 700; border: 0; cursor: pointer; white-space: nowrap; }
    .tb-btn-primary { background: #6D4FE3; color: #fff; box-shadow: 0 6px 16px rgba(109,79,227,.3); }
    .tb-btn-primary:hover { background: #5838C9; color: #fff; }
    .tb-btn-primary:disabled { opacity: .6; cursor: default; }
    .tb-btn-soft { background: #F1ECFD; color: #6D4FE3; border: 1px solid #DCD2F8; }
    .tb-btn-soft:hover { background: #E6DEFA; }
    .tb-btn-ghost { background: #fff; color: #516F90; border: 1px solid #E1E8EE; }
    .tb-btn-ghost:hover { border-color: #C3D0DD; }
    .tb-btn-danger { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; color: #D7263D; padding: 9px 13px; border-radius: 9px; border: 1px solid #FBD5D5; background: #fff; cursor: pointer; }
    .tb-btn-danger:hover { background: #FFF5F5; }
    .tb-flex { flex: 1; }

    .tb-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .tb-card { background: #fff; border: 1px solid #E1E8EE; border-radius: 15px; overflow: hidden; box-shadow: 0 1px 2px rgba(45,62,80,.05); }
    .tb-card-bar { height: 7px; }
    .tb-card-body { padding: 17px 18px; }
    .tb-card-top { display: flex; align-items: flex-start; gap: 10px; }
    .tb-card-id { flex: 1; min-width: 0; }
    .tb-card-nom { font-size: 15.5px; font-weight: 800; color: #1B2A3A; letter-spacing: -.2px; }
    .tb-card-desc { font-size: 12px; color: #7C98B6; margin-top: 3px; line-height: 1.45; }
    .tb-card-edit { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #A6B7C8; border: 1px solid #E1E8EE; background: #fff; flex-shrink: 0; cursor: pointer; }
    .tb-card-edit:hover { border-color: #6D4FE3; color: #6D4FE3; }
    .tb-card-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 15px; }
    .tb-avatars { display: flex; align-items: center; }
    .tb-ava { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg,#8366F0,#5838C9); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; border: 2px solid #fff; margin-right: -8px; }
    .tb-ava-more { background: #EEF3F8; color: #516F90; }
    .tb-avatars-lg .tb-ava { width: 30px; height: 30px; }
    .tb-card-count { font-size: 11px; font-weight: 700; color: #7C98B6; background: #F5F8FA; border: 1px solid #E1E8EE; padding: 3px 10px; border-radius: 20px; }
    .tb-card-open { width: 100%; margin-top: 15px; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 9px; border-radius: 9px; background: #F1ECFD; color: #6D4FE3; font-size: 12.5px; font-weight: 700; border: 0; cursor: pointer; }
    .tb-card-open:hover { background: #E6DEFA; }
    .tb-card-new { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; min-height: 180px; border: 1.5px dashed #D7E0EA; border-radius: 15px; background: #FBFCFD; color: #7C98B6; font-size: 12.5px; font-weight: 700; cursor: pointer; }
    .tb-card-new:hover { border-color: #6D4FE3; color: #6D4FE3; background: #F5F1FE; }
    .tb-card-new-ic { width: 42px; height: 42px; border-radius: 12px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; }

    .tb-icon-btn { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #516F90; border: 1px solid #E1E8EE; background: #fff; flex-shrink: 0; cursor: pointer; margin-top: 3px; }
    .tb-icon-btn:hover { border-color: #6D4FE3; color: #6D4FE3; }
    .tb-board-color { width: 8px; height: 38px; border-radius: 5px; flex-shrink: 0; margin-top: 3px; }
    .tb-board-id { flex: 1; min-width: 0; }
    .tb-board-nom { font-size: 24px; font-weight: 800; letter-spacing: -.5px; color: #1B2A3A; margin: 0; }
    .tb-board-desc { font-size: 13px; color: #7C98B6; margin: 2px 0 0; }
    .tb-modeswitch { display: flex; align-items: center; gap: 2px; background: #F1F5F9; border: 1px solid #E1E8EE; border-radius: 9px; padding: 3px; flex-shrink: 0; margin-top: 3px; }
    .tb-mode { display: flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 7px; font-size: 12px; font-weight: 700; color: #7C98B6; background: transparent; border: 0; cursor: pointer; }
    .tb-mode.on { color: #6D4FE3; background: #fff; box-shadow: 0 1px 2px rgba(45,62,80,.12); }

    .tb-kanban { display: grid; gap: 13px; align-items: start; overflow-x: auto; padding-bottom: 8px; }
    .tb-col { background: #F8FAFC; border: 1px solid #ECEEF2; border-radius: 14px; padding: 12px; }
    .tb-col-head { display: flex; align-items: center; gap: 8px; padding: 4px 6px 12px; }
