    select.tb-frule-lead.tb-frule-logic { flex: 0 0 60px; text-align: left; border: 1px solid #E1E8EE; border-radius: 8px; padding: 5px 6px; background: #FAFBFC; color: #6D4FE3; font-weight: 800; cursor: pointer; outline: none; }
