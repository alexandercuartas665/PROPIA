    // ---- Cambio de estado con cierre (motivo) al llegar a una columna terminal ----
    private (Guid TareaId, Guid EstadoId)? _cierreTarget;
    private string _cierreTareaTitulo = "";
    private string _cierreMotivoId = "";
    private List<MotivoCierreDto> _motivosTareas = new();

    private bool EstadoEsTerminal(Guid estadoId) => _board?.Estados.FirstOrDefault(e => e.Id == estadoId)?.EsTerminal ?? false;

    // Si la columna destino es terminal, se pide motivo de cierre (la tarea se cierra y desaparece).
    private async Task CambiarEstadoOCerrar(Guid tareaId, Guid estadoId)
    {
        if (EstadoEsTerminal(estadoId))
        {
            if (_motivosTareas.Count == 0) await CargarMotivosTareasAsync();
            _cierreTareaTitulo = _tareas.FirstOrDefault(t => t.Id == tareaId)?.Titulo ?? "";
            _cierreMotivoId = "";
            _cierreTarget = (tareaId, estadoId);
        }
        else
        {
            await EjecutarCambioEstado(tareaId, estadoId, null);
        }
    }
    private async Task EjecutarCambioEstado(Guid tareaId, Guid estadoId, Guid? motivoId)
    {
        var resp = await Auth().PutAsJsonAsync($"/api/tareas/{tareaId}/estado", new CambiarEstadoRequest(estadoId, null, motivoId));
        if (resp.IsSuccessStatusCode) await RecargarBoard();
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }
    // Reabre una tarea cerrada moviendola al primer estado NO terminal (vuelve al tablero activo y sale de "Cerrados").
    private async Task ReabrirTareaCerrada(Guid tareaId)
    {
        var destino = _board?.Estados.FirstOrDefault(e => !e.EsTerminal && e.Activo)
                   ?? _board?.Estados.FirstOrDefault(e => !e.EsTerminal);
        if (destino is null) { _msg = "No hay un estado activo al cual reabrir."; _msgClass = "alert-danger"; return; }
        await EjecutarCambioEstado(tareaId, destino.Id, null);
    }
    private async Task ConfirmarCierreTarea()
    {
        if (_cierreTarget is not { } tgt) return;
        if (!Guid.TryParse(_cierreMotivoId, out var mid)) { _msg = "Elige un motivo de cierre."; _msgClass = "alert-danger"; return; }
        _cierreTarget = null;
        await EjecutarCambioEstado(tgt.TareaId, tgt.EstadoId, mid);
    }
    private async Task CargarMotivosTareasAsync()
    {
        try { _motivosTareas = (await Auth().GetFromJsonAsync<List<MotivoCierreDto>>("/api/cierre/motivos?modulo=tareas&incluirInactivos=true")) ?? new(); }
        catch { _motivosTareas = new(); }
    }
    private static string ClasifTareaTexto(ClasificacionCierre c) => c switch
    {
        ClasificacionCierre.ViaInternaAgotada => "via interna agotada",
        ClasificacionCierre.Perdida => "perdida",
        _ => "cierre correcto"
    };
    // Cambio de estado DESDE el modal de tarjeta: si el destino es terminal y la tarea ya existe,
    // se cierra pidiendo motivo (cierra el modal y abre el de cierre). Si no, solo cambia el estado.
    private async Task OnCardEstadoChange(ChangeEventArgs e)
    {
        if (_cardDraft is null || !Guid.TryParse(e.Value?.ToString(), out var estadoId)) return;
        if (_cardDraft.Id is Guid tid && EstadoEsTerminal(estadoId))
        {
            _cardDraft = null;   // cierra el modal de la tarjeta; el modal de cierre pide el motivo
            await CambiarEstadoOCerrar(tid, estadoId);
            return;
        }
        _cardDraft.EstadoId = estadoId;
    }
