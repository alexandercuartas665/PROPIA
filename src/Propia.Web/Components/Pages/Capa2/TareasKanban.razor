        ? Array.Empty<string>()
        : c.Opciones.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private static string TipoCampoLabel(TipoCampoTablero t) => t switch
    {
        TipoCampoTablero.Texto => "Texto", TipoCampoTablero.AreaTexto => "Parrafo", TipoCampoTablero.Numero => "Numero",
        TipoCampoTablero.Moneda => "Moneda", TipoCampoTablero.Fecha => "Fecha", TipoCampoTablero.Hora => "Hora",
        TipoCampoTablero.Telefono => "Telefono", TipoCampoTablero.Seleccion => "Seleccion", TipoCampoTablero.Booleano => "Si/No",
        TipoCampoTablero.Url => "URL", TipoCampoTablero.Email => "Email",
        TipoCampoTablero.Separador => "Separador", TipoCampoTablero.Total => "Total (suma)", _ => "Texto"
    };

    private string CampoDeTarea(TareaListaDto t, Guid campoId) => t.CamposValores?.FirstOrDefault(v => v.CampoId == campoId)?.Valor ?? "";

    // ----- Campos avanzados (Total / multivalor / suma) -----
    private static HashSet<Guid> ParseCamposSuma(string? csv) =>
        string.IsNullOrWhiteSpace(csv) ? new()
        : csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
             .Select(s => Guid.TryParse(s, out var g) ? g : Guid.Empty).Where(g => g != Guid.Empty).ToHashSet();
    private IEnumerable<TableroCampoDto> CamposSumables => (_board?.Tablero.Campos ?? new List<TableroCampoDto>())
        .Where(c => c.Tipo == TipoCampoTablero.Numero || c.Tipo == TipoCampoTablero.Moneda);
    private void ToggleCampoSuma(Guid id) { if (!_campoDraft.CamposSuma.Remove(id)) _campoDraft.CamposSuma.Add(id); }
    // Total en el modal de tarjeta (lee el borrador) y en la lista (lee la tarea guardada).
    private string CalcularTotal(TableroCampoDto c) => SumarCampos(c, id => CampoVal(id));
    private string CalcularTotalTarea(TareaListaDto t, TableroCampoDto c) => SumarCampos(c, id => CampoDeTarea(t, id));
    private string SumarCampos(TableroCampoDto c, Func<Guid, string> getVal)
    {
        decimal sum = 0m;
        foreach (var id in ParseCamposSuma(c.CamposSuma))
            if (decimal.TryParse(getVal(id), NumberStyles.Any, CultureInfo.InvariantCulture, out var d)) sum += d;
        return Math.Round(sum).ToString("N0", Es);
    }

    private string CampoDisplay(TareaListaDto t, TableroCampoDto c)
    {
        if (c.Tipo == TipoCampoTablero.Total) return "$ " + CalcularTotalTarea(t, c);
        var v = CampoDeTarea(t, c.Id);
        if (string.IsNullOrWhiteSpace(v)) return "-";
        if (c.PermiteVarios) return string.Join(", ", v.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return c.Tipo switch
        {
            TipoCampoTablero.Booleano => string.Equals(v, "true", StringComparison.OrdinalIgnoreCase) ? "Si" : "No",
            TipoCampoTablero.Moneda => decimal.TryParse(v, NumberStyles.Any, CultureInfo.InvariantCulture, out var d) ? "$ " + Math.Round(d).ToString("N0", Es) : v,
            _ => v
        };
    }


