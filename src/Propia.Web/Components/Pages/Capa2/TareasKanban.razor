    private async Task SubirArchivoConCaption(Microsoft.AspNetCore.Components.Forms.IBrowserFile file, string? caption)
    {
        if (_cardDraft?.Id is null) return;
        _subiendo = true; _cardMsg = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(file.OpenReadStream(10_000_000));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType);
            content.Add(sc, "file", file.Name);
            var cap = string.IsNullOrWhiteSpace(caption) ? null : caption.Trim();
            if (cap is not null) content.Add(new StringContent(cap), "texto");
            var resp = await Auth().PostAsync($"/api/tareas/{_cardDraft.Id}/adjuntos", content);
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<TareaAdjuntoDto>();
                if (dto is not null)
                {
                    _cardDraft.Adjuntos.Add(new AdjuntoVM(dto.Id, dto.Nombre, dto.Url, dto.SubidoPorNombre, dto.SubidoAt ?? DateTimeOffset.Now, dto.SubidoPorUsuarioId ?? _miUsuarioId, dto.Texto));
                    _cardDraft.Historial.Add(new LogVM($"Adjunto agregado: {dto.Nombre}", dto.SubidoAt ?? DateTimeOffset.Now));
                    _adjSel = dto.Id;
                }
                _pendingFile = null; _pendingFileName = null; _nuevoComentario = ""; _scrollChatPend = true;
            }
            else { _cardMsg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _cardMsg = ex.Message; }
        finally { _subiendo = false; }
    }

    // Detecta si se esta escribiendo una @mencion al final del texto y filtra el directorio (_personas).
    private void DetectarMencion()
    {
        var t = _nuevoComentario ?? "";
        var m = System.Text.RegularExpressions.Regex.Match(t, @"(?:^|\s)@([\p{L}0-9._-]*)$");
        if (!m.Success) { _mencionQuery = null; _mencionMatches.Clear(); return; }
        _mencionQuery = m.Groups[1].Value;
        var q = _mencionQuery.ToLowerInvariant().Replace(".", "");
        var fuente = _personas ?? new List<PersonaMini>();
        _mencionMatches = fuente
            .Where(p => string.IsNullOrEmpty(q)
                     || p.Nombre.ToLowerInvariant().Replace(" ", "").Contains(q)
                     || MencionToken(p.Nombre).Replace(".", "").Contains(q))
            .Take(6).ToList();
    }
    private void InsertarMencion(PersonaMini p)
    {
        var t = _nuevoComentario ?? "";
        t = System.Text.RegularExpressions.Regex.Replace(t, @"(^|\s)@([\p{L}0-9._-]*)$", $"$1@{MencionToken(p.Nombre)} ");
        _nuevoComentario = t;
        _mencionQuery = null; _mencionMatches.Clear();
    }
    // Formato que resuelve el backend (NotificarMencionesAsync): nombre en minusculas con espacios -> puntos.
    private static string MencionToken(string nombre) => nombre.Trim().ToLowerInvariant().Replace(" ", ".");

    private async Task EliminarAdjunto(Guid adjuntoId)
    {
        if (_cardDraft?.Id is null) return;
        var resp = await Auth().DeleteAsync($"/api/tareas/{_cardDraft.Id}/adjuntos/{adjuntoId}");
        if (resp.IsSuccessStatusCode)
        {
            _cardDraft.Adjuntos.RemoveAll(a => a.Id == adjuntoId);
            if (_adjSel == adjuntoId) _adjSel = _cardDraft.Adjuntos.FirstOrDefault()?.Id;
        }
    }

    // Reporta la actividad realizada sobre la tarea (comentario). El backend registra autor y fecha.
    private async Task AgregarComentarioCard()
    {
        if (_cardDraft?.Id is null || string.IsNullOrWhiteSpace(_nuevoComentario)) return;
        _busy = true; _cardMsg = null;
        try
        {
            var texto = _nuevoComentario.Trim();
            var resp = await Auth().PostAsJsonAsync($"/api/tareas/{_cardDraft.Id}/comentarios", new CrearComentarioRequest(texto));
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<TareaComentarioDto>();
                // El comentario nuevo se antepone (mas reciente primero, igual que el backend).
                _cardDraft.Comentarios.Insert(0, new ComentarioVM(dto?.AutorNombre, texto, dto?.CreatedAt ?? DateTimeOffset.Now, dto?.AutorUsuarioId ?? _miUsuarioId));
                _cardDraft.Historial.Add(new LogVM("Comentario agregado", dto?.CreatedAt ?? DateTimeOffset.Now));
                _nuevoComentario = ""; _mencionQuery = null; _mencionMatches.Clear(); _scrollChatPend = true;
            }
            else { _cardMsg = await resp.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { _cardMsg = ex.Message; }
        finally { _busy = false; }
    }

    private static bool EsImg(string url)
    {
        // Quitar el ?query (ej. ?v=...) antes de mirar la extension, si no las imagenes con querystring no previsualizan.
        var u = url.ToLowerInvariant().Split('?')[0].TrimEnd();
        return u.EndsWith(".jpg") || u.EndsWith(".jpeg") || u.EndsWith(".png") || u.EndsWith(".webp") || u.EndsWith(".gif") || u.EndsWith(".bmp") || u.EndsWith(".svg");
    }
    private static bool EsPdf(string url) => url.ToLowerInvariant().Split('?')[0].TrimEnd().EndsWith(".pdf");
    private static string FechaHora(DateTimeOffset f)
    {
        var l = f.ToLocalTime();
        return l.ToString("d MMM yyyy, HH:mm", Es);
    }

    private static string Iniciales(string? n)
    {
        var p = (n ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0) return "?";
        if (p.Length == 1) return p[0].Substring(0, Math.Min(2, p[0].Length)).ToUpperInvariant();
        return ("" + p[0][0] + p[1][0]).ToUpperInvariant();
    }
    private static string FechaCorta(DateOnly d)
    {
        var dia = d.ToString("ddd", Es);
        dia = char.ToUpper(dia[0]) + dia.Substring(1);
        return dia + " " + d.Day + " " + d.ToString("MMM", Es);
    }
    private static string PrioFg(PrioridadTarea p) => p switch { PrioridadTarea.Urgente => "#C0383C", PrioridadTarea.Alta => "#B45309", PrioridadTarea.Normal => "#2563EB", _ => "#516F90" };
    private static string PrioBg(PrioridadTarea p) => p switch { PrioridadTarea.Urgente => "#FDE7E7", PrioridadTarea.Alta => "#FEF3DC", PrioridadTarea.Normal => "#E6F2FB", _ => "#EEF3F8" };
}
