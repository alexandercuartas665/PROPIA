    // ----- Archivar / restaurar campos (retirar sin perder datos) -----
    private List<TableroCampoDto> _camposArchivados = new();
    private async Task CargarCamposArchivados()
    {
        if (_board is null) { _camposArchivados = new(); return; }
        try { _camposArchivados = await Auth().GetFromJsonAsync<List<TableroCampoDto>>($"/api/tareas/tableros/{_board.Tablero.Id}/campos-archivados") ?? new(); }
        catch { _camposArchivados = new(); }
    }
    private async Task ArchivarCampo(Guid campoId)
    {
        if (_board is null) return;
        var resp = await Auth().PutAsync($"/api/tareas/tableros/{_board.Tablero.Id}/campos/{campoId}/archivar?archivar=true", null);
        if (resp.IsSuccessStatusCode)
        {
            if (_campoDraft.Id == campoId) _campoDraft = new CampoDraft();
            _cardDraft?.Campos.Remove(campoId);
            await RecargarBoard();
            await CargarCamposArchivados();
        }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }
