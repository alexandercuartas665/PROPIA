    .tb-frule-del { flex: 0 0 auto; width: 28px; height: 28px; border-radius: 7px; border: 1px solid #E1E8EE; background: #fff; color: #90A4B7; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .tb-frule-del:hover { background: #FDE7E7; color: #D7263D; border-color: #F2CFC9; }
    .tb-filterpop-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 4px; padding-top: 10px; border-top: 1px solid #EEF3F8; }
    .tb-filter-add { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; color: #6D4FE3; background: #F1ECFD; border: 0; border-radius: 8px; padding: 7px 12px; cursor: pointer; }
    .tb-filter-add:hover { background: #E5DEFB; }
    .tb-filter-clear2 { font-size: 12px; font-weight: 700; color: #C0383C; background: transparent; border: 0; border-radius: 8px; padding: 7px 10px; cursor: pointer; }
    .tb-filter-clear2:hover { background: #FDE7E7; }
