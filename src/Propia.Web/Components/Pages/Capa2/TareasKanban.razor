    // Item unificado del chat de actividad: comentario (Texto), adjunto (Adj), o separador de dia (EsSepDia).
    private record ActItem(DateTimeOffset Fecha, bool EsMio, string? Autor, string? Texto, AdjuntoVM? Adj, bool EsSepDia = false, string? SepTexto = null);
    // Fusiona comentarios + adjuntos en una sola linea de tiempo cronologica (mas antiguo arriba) e inserta separadores por dia.
    private List<ActItem> ActTimeline(CardDraft d)
    {
        var items = new List<ActItem>();
        foreach (var c in d.Comentarios)
            items.Add(new ActItem(c.Fecha, c.AutorId != Guid.Empty && c.AutorId == _miUsuarioId, c.Autor, c.Texto, null));
        foreach (var a in d.Adjuntos)
            items.Add(new ActItem(a.SubidoAt ?? DateTimeOffset.MinValue, a.SubidoPorId is Guid g && g == _miUsuarioId, a.SubidoPor, null, a));
        var ordenados = items.OrderBy(i => i.Fecha).ToList();
        var res = new List<ActItem>();
        DateTime? dia = null;
        foreach (var it in ordenados)
        {
            var d0 = it.Fecha.ToLocalTime().Date;
            if (dia != d0) { res.Add(new ActItem(it.Fecha, false, null, null, null, true, SepDia(it.Fecha))); dia = d0; }
            res.Add(it);
        }
        return res;
    }
    // Rotulo del separador de dia: "Hoy" / "Ayer" / fecha larga.
    private static string SepDia(DateTimeOffset f)
    {
        var d = f.ToLocalTime().Date; var hoy = DateTime.Now.Date;
        if (d == hoy) return "Hoy";
        if (d == hoy.AddDays(-1)) return "Ayer";
        return f.ToLocalTime().ToString("dddd, d 'de' MMMM yyyy", Es);
    }
    private static string FechaSoloHora(DateTimeOffset f) => f.ToLocalTime().ToString("HH:mm");
