    /* El header del tablero envuelve: si no cabe, las acciones bajan a otra linea en vez de machucar el titulo. */
    .tb-board-head { flex-wrap: wrap; align-items: center; row-gap: 10px; }
    .tb-board-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-left: auto; }
    /* Pestanas Activos/Cerrados + buscador */
    .tb-board-tabs { display: flex; align-items: center; gap: 4px; border-bottom: 1px solid #EEF3F8; margin-bottom: 14px; }
