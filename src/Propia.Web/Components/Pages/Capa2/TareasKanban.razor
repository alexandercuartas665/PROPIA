    private async Task ConfirmarCopia()
    {
        if (_copiaDlg is null) return;
        _copiaBusy = true;
        try
        {
            var d = _copiaDlg;
            var req = new CopiarTareaRequest(
                string.IsNullOrWhiteSpace(d.Titulo) ? null : d.Titulo.Trim(),
                d.EstadoId, Math.Clamp(d.Cantidad, 1, 20),
                d.ConservarResponsables, d.ConservarEtiquetas, d.ConservarRelacion, d.ConservarCampos);
            var resp = await Auth().PostAsJsonAsync($"/api/tareas/{d.TareaId}/copiar", req);
            if (resp.IsSuccessStatusCode)
            {
                var srcId = d.TareaId;
                _copiaDlg = null;
                await RecargarBoard();
                if (_cardDraft?.Id == srcId)   // refrescar la traza si el modal del original sigue abierto
                {
                    var t2 = _tareas.FirstOrDefault(x => x.Id == srcId);
                    if (t2 is not null) await AbrirCardDraft(t2, null);
                }
            }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _copiaBusy = false; }
