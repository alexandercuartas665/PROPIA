        await RecargarBoard();
    }

    private async Task AbrirTableroDraft(TableroDto? b)
    {
        _tableroDraft = b is null
            ? new TableroDraft()
            : new TableroDraft { Id = b.Id, Nombre = b.Nombre, Descripcion = b.Descripcion, Color = b.Color, UsuarioIds = b.Usuarios.Select(u => u.PersonaId).ToHashSet() };
        // Info de display de los miembros ya seleccionados (nombre + iniciales; sin foto en el DTO del tablero).
        _tbSelInfo = b?.Usuarios.ToDictionary(u => u.PersonaId, u => (u.Nombre, (string?)null)) ?? new();
        _tbBuscar = ""; _tbResultados.Clear();
        // Reset del bloque "invitar externo"
        _extEmail = ""; _extNombre = ""; _extRolId = ""; _extLink = null; _extMsg = null; _extError = false;
        // El bloque solo aplica a tableros que ya existen (se necesita su Id).
        if (b is not null)
        {
            if (_rolesInv.Count == 0)
            {
                try { _rolesInv = await Auth().GetFromJsonAsync<List<RolMini>>("/api/roles") ?? new(); }
                catch { _rolesInv = new(); }
            }
            // Rol por defecto: el primero que no sea Administrador (o el primero disponible).
            _extRolId = (_rolesInv.FirstOrDefault(r => r.Nombre != "Administrador")?.Id
                         ?? _rolesInv.FirstOrDefault()?.Id)?.ToString() ?? "";
        }
    }
    private void ToggleUsuario(Guid pid) { if (_tableroDraft is null) return; if (!_tableroDraft.UsuarioIds.Add(pid)) _tableroDraft.UsuarioIds.Remove(pid); }

