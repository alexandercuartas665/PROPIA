@code {
    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");
    private string? _jwt;
    private Guid _miUsuarioId;   // usuario actual (del JWT) para alinear "mis" mensajes a la derecha en el chat
    private bool _authChecked;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";

    private List<TableroDto>? _tableros;
    private ResumenTareasDto? _resumen;   // KPIs globales del modulo (todos los tableros)
    private List<TenantInfoDto> _tenants = new();   // copropiedades a las que tiene acceso el usuario
    private Guid? _activeTenantId;
    private bool _coMenuOpen;
    private bool _coBusy;
    private TableroBoardDto? _board;
    private string _boardMode = "tablero";
    // Persistencia por usuario (localStorage): ultimo tablero abierto + modo de vista. Al entrar
    // al modulo se reabre el ultimo tablero en su ultimo modo; al abrir cualquier otro, mismo modo.
    private const string TbViewKey = "propia_tb_view";
    private const string TbLastKey = "propia_tb_last";
    private async Task SetBoardMode(string mode)
    {
        _boardMode = mode;
        try { await Js.InvokeVoidAsync("localStorage.setItem", TbViewKey, mode); } catch { }
    }
    private async Task<string> LeerVistaGuardadaAsync()
    {
        try
        {
            var v = await Js.InvokeAsync<string?>("localStorage.getItem", TbViewKey);
            return v is "tablero" or "lista" or "calendario" or "gantt" ? v : "tablero";
        }
        catch { return "tablero"; }
    }
    private async Task AbrirUltimoTableroAsync()
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", TbLastKey);
            if (Guid.TryParse(raw, out var id) && _tableros.Any(t => t.Id == id))
                await AbrirBoardAsync(id);
        }
        catch { }
    }
    private List<PersonaMini>? _personas;
    private readonly HashSet<Guid> _expandidas = new();

    // ---- Constructor de filtros (vista Lista): varias reglas Campo/Condicion/Valor, combinadas Y u O ----
    private sealed class FiltroRegla
    {
        public string Campo { get; set; } = "estado"; // "estado","resp","prio","etiqueta","titulo","descripcion","vence","valor" o el guid de un campo dinamico
        public string Op { get; set; } = "es";        // operador (depende del tipo de campo)
        public string Valor { get; set; } = "";       // valor/comparando (id de estado, texto, numero, fecha, etc.)
    }
    private readonly List<FiltroRegla> _reglas = new();
    private string _filtroLogica = "and"; // "and" = todas las reglas, "or" = cualquiera
    private bool _filtrosMenu;
    // Ordenamiento por columna (vista Lista): clic en el encabezado ordena; reclic invierte.
    private string _sortCol = ""; private bool _sortAsc = true;
    private void SortBy(string col) { if (_sortCol == col) _sortAsc = !_sortAsc; else { _sortCol = col; _sortAsc = true; } }
    private MarkupString SortInd(string col) => _sortCol == col ? (MarkupString)(_sortAsc ? " &#9650;" : " &#9660;") : (MarkupString)"";
    private IEnumerable<TareaListaDto> AplicarSort(List<TareaListaDto> g)
    {
        if (string.IsNullOrEmpty(_sortCol)) return g;
        Func<TareaListaDto, object?> key = _sortCol switch
        {
            "titulo" => t => t.Titulo,
            "asignado" => t => t.AsignadoNombre ?? "",
            "progreso" => t => t.Progreso,
            "prioridad" => t => (int)t.Prioridad,
            "vence" => t => t.FechaVencimiento ?? DateOnly.MaxValue,
            "valor" => t => t.Valor ?? 0m,
            "origen" => t => t.OrigenReferencia ?? "",
            _ => t => Guid.TryParse(_sortCol, out var cid) ? CampoDeTarea(t, cid) : ""
        };
        return _sortAsc ? g.OrderBy(key) : g.OrderByDescending(key);
    }

    // ---- Vista Tablero (tarjetas): ordenar + agrupar por dimension (incluye ubicacion) ----
    private bool _cardSortMenu; private bool _cardGroupMenu; private string _cardGroup = "";
    private void SetCardSort(string k) { if (string.IsNullOrEmpty(k)) _sortCol = ""; else SortBy(k); _cardSortMenu = false; }
    private async Task SetCardGroup(string k) { _cardGroup = k; _cardGroupMenu = false; await PersistGroupAsync(); }
    private async Task ClearCardGroup() { _cardGroup = ""; _cardGroupMenu = false; await PersistGroupAsync(); }
    private IEnumerable<(string Key, string Label)> OpcionesOrden()
    {
        yield return ("titulo", "Titulo");
        yield return ("prioridad", "Prioridad");
        yield return ("vence", "Vencimiento");
        yield return ("valor", "Valor");
        yield return ("asignado", "Responsable");
        yield return ("progreso", "Progreso");
        foreach (var c in CamposDelTablero.Where(c => c.Tipo != TipoCampoTablero.Separador))
            yield return (c.Id.ToString(), c.Label);
    }
    private string OrdenLabel(string k) => OpcionesOrden().FirstOrDefault(o => o.Key == k).Label ?? k;
    private IEnumerable<(string Key, string Label)> OpcionesGrupo()
    {
        yield return ("", "Etapa");
        yield return ("none", "Sin agrupar");
        yield return ("prioridad", "Prioridad");
        yield return ("responsable", "Responsable");
        yield return ("torre", "Torre");
        yield return ("unidad", "Unidad privada");
        yield return ("relacionado", "Relacionado con");
    }
    private string GrupoLabel(string k) => OpcionesGrupo().FirstOrDefault(o => o.Key == k).Label ?? k;

    // ===== Totales por grupo (estilo Airtable) =====
    // Funcion de agregacion por columna numerica. Clave: "valor" (columna fija) o el Id (string) del
    // campo dinamico Numero/Moneda. Valor: sum|avg|min|max|count|none. Se guarda por tablero.
    private Dictionary<string, string> _agg = new();
    private string? _aggMenuCol;   // columna cuyo menu de funcion esta abierto (solo en la fila TOTAL)
    private static readonly (string Key, string Label)[] AggOpciones =
        new[] { ("sum", "Suma"), ("avg", "Promedio"), ("min", "Minimo"), ("max", "Maximo"), ("count", "Conteo"), ("none", "Ninguno") };
    private void ToggleAggMenu(string col) { _aggMenuCol = _aggMenuCol == col ? null : col; }
    private string AggFn(string col) => _agg.TryGetValue(col, out var f) && !string.IsNullOrEmpty(f) ? f : "sum";
    private async Task SetAgg(string col, string fn) { _agg[col] = fn; _aggMenuCol = null; await PersistAggAsync(); }
    private static string AggLabel(string fn) => fn switch { "avg" => "Prom", "min" => "Min", "max" => "Max", "count" => "Cont", "none" => "-", _ => "Suma" };
    private bool CampoEsNumerico(TableroCampoDto c) => c.Tipo == TipoCampoTablero.Numero || c.Tipo == TipoCampoTablero.Moneda;
    private bool HayColumnasNumericas => _colValor || CamposVisibles.Any(CampoEsNumerico);
    private decimal? ValorNumColumna(TareaListaDto t, string col)
    {
        if (col == "valor") return t.Valor;
        if (Guid.TryParse(col, out var cid) && decimal.TryParse(CampoDeTarea(t, cid), NumberStyles.Any, CultureInfo.InvariantCulture, out var d)) return d;
        return null;
    }
    private decimal SumaCampoGrupo(string col, IEnumerable<TareaListaDto> items)
        => items.Select(t => ValorNumColumna(t, col)).Where(v => v.HasValue).Sum(v => v!.Value);
    private string AgregadoColumna(string col, bool esMoneda, IEnumerable<TareaListaDto> items)
    {
        var fn = AggFn(col);
        if (fn == "none") return "";
        var vals = items.Select(t => ValorNumColumna(t, col)).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        if (fn == "count") return vals.Count.ToString("N0", Es);
        if (vals.Count == 0) return "-";
        decimal r = fn switch { "avg" => vals.Average(), "min" => vals.Min(), "max" => vals.Max(), _ => vals.Sum() };
        var num = Math.Round(r).ToString("N0", Es);
        return esMoneda ? "$ " + num : num;
    }

    // Totales compactos para el TITULO del grupo (chips "Columna valor"). Solo columnas numericas
    // visibles con agregado no vacio. La funcion (suma/prom/min/max/conteo) se cambia en la fila TOTAL.
    private RenderFragment TotalesGrupoTitulo(IReadOnlyList<TareaListaDto> items)
    {
        return
    @<text>
        @if (HayColumnasNumericas)
        {
            @if (_colValor)
            {
                var v = AgregadoColumna("valor", true, items);
                if (!string.IsNullOrEmpty(v) && v != "-") { <span class="tb-glt">Valor <b>@v</b></span> }
            }
