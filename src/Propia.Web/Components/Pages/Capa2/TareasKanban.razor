    .tb-search-nom { flex: 1; font-size: 13px; font-weight: 600; color: #33475B; }
    .tb-search-doc { font-size: 11.5px; color: #90A4B7; }
    .tb-search-empty { padding: 9px 11px; font-size: 12.5px; color: #90A4B7; font-style: italic; }
