    .tb-soon { background: #fff; border: 1.5px dashed #D7E0EA; border-radius: 16px; padding: 50px 24px; text-align: center; }
    .tb-soon-ic { width: 60px; height: 60px; border-radius: 16px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
    .tb-soon-t { font-size: 17px; font-weight: 800; color: #1B2A3A; }
