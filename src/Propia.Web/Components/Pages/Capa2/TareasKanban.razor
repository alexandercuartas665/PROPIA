    .tb-modal-body { padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; }
    .tb-modal-foot { display: flex; align-items: center; gap: 9px; padding: 16px 24px; border-top: 1px solid #EEF3F8; }
    .tb-fld { display: flex; flex-direction: column; }
    .tb-fld label { font-size: 11px; color: #7C98B6; font-weight: 700; margin-bottom: 5px; }
