    private void AgregarRegla() { _reglas.Add(new FiltroRegla { Campo = "estado", Op = "es", Valor = "" }); }
    private void QuitarRegla(int idx) { if (idx >= 0 && idx < _reglas.Count) { _reglas.RemoveAt(idx); _ = PersistFiltrosAsync(); } }
    private void SetFiltroLogica(ChangeEventArgs e) { _filtroLogica = e.Value?.ToString() == "or" ? "or" : "and"; _ = PersistFiltrosAsync(); }
    private void SetReglaCampo(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _reglas.Count) return;
        _reglas[idx].Campo = e.Value?.ToString() ?? "estado";
        // Al cambiar de campo, el operador anterior puede no aplicar: se ajusta al primero valido.
        var ops = OperadoresDe(_reglas[idx].Campo);
        if (!ops.Any(o => o.Key == _reglas[idx].Op)) _reglas[idx].Op = ops.First().Key;
        _reglas[idx].Valor = "";
        _ = PersistFiltrosAsync();
    }
    private void SetReglaOp(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglas.Count) { _reglas[idx].Op = e.Value?.ToString() ?? "es"; _ = PersistFiltrosAsync(); } }
    private void SetReglaValor(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglas.Count) { _reglas[idx].Valor = e.Value?.ToString() ?? ""; _ = PersistFiltrosAsync(); } }

    // Catalogo de campos disponibles para filtrar (fijos + campos dinamicos del tablero).
    private IEnumerable<(string Key, string Label)> CamposFiltro()
    {
        yield return ("estado", "Etapa");
        yield return ("resp", "Asignado");
        yield return ("prio", "Prioridad");
        if (_etiquetasCat.Count > 0) yield return ("etiqueta", "Etiqueta");
        yield return ("titulo", "Titulo");
        yield return ("descripcion", "Descripcion");
        yield return ("vence", "Vence");
        yield return ("valor", "Valor");
        foreach (var c in CamposDelTablero.Where(c => c.Tipo != TipoCampoTablero.Separador && c.Tipo != TipoCampoTablero.Total))
            yield return (c.Id.ToString(), c.Label);
    }
    private string CampoFiltroLabel(string key) => CamposFiltro().FirstOrDefault(o => o.Key == key).Label ?? key;
    private TableroCampoDto? CampoDinamico(string campo) => Guid.TryParse(campo, out var g) ? CamposDelTablero.FirstOrDefault(c => c.Id == g) : null;

    // Clase de un campo, que determina operadores y editor de valor.
    private string FiltroKind(string campo) => campo switch
    {
        "estado" => "sel-estado",
        "prio" => "sel-prio",
        "resp" => "resp",
        "etiqueta" => "etiqueta",
        "titulo" or "descripcion" => "texto",
        "vence" => "fecha",
        "valor" => "num",
        _ => CampoDinamico(campo)?.Tipo switch
        {
            TipoCampoTablero.Numero or TipoCampoTablero.Moneda => "num",
            TipoCampoTablero.Fecha => "fecha",
            TipoCampoTablero.Seleccion => "sel-din",
            _ => "texto"
        }
    };
    private IEnumerable<(string Key, string Label)> OperadoresDe(string campo)
    {
        var kind = FiltroKind(campo);
        switch (kind)
        {
            case "num":
                return new[] { ("=", "es igual a"), ("!=", "es distinto de"), (">", "mayor que"), (">=", "mayor o igual"),
                               ("<", "menor que"), ("<=", "menor o igual"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            case "fecha":
                return new[] { ("es", "es"), ("antes", "antes de"), ("despues", "despues de"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            case "etiqueta":
                return new[] { ("tiene", "tiene"), ("no_tiene", "no tiene") };
            case "sel-estado":
            case "sel-prio":
            case "sel-din":
            case "resp":
                return new[] { ("es", "es"), ("no_es", "no es"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            default: // texto
                return new[] { ("contiene", "contiene"), ("no_contiene", "no contiene"), ("es", "es"), ("no_es", "no es"),
                               ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
        }
    }
    // Una regla influye en el resultado solo si aporta condicion (operador de vacio, o valor elegido).
    private bool ReglaActiva(FiltroRegla r) => r.Op is "vacio" or "no_vacio" || !string.IsNullOrWhiteSpace(r.Valor);

    private bool PasaFiltros(TareaListaDto t)
    {
        // Buscador (por titulo / numero de tarea), como en PQRSD.
        if (!string.IsNullOrWhiteSpace(_buscarTarea))
        {
            var qn = _buscarTarea.Trim();
            var ok = (t.Titulo ?? "").Contains(qn, StringComparison.OrdinalIgnoreCase)
                  || (t.NumeroTarea ?? "").Contains(qn, StringComparison.OrdinalIgnoreCase);
            if (!ok) return false;
        }
        var activas = _reglas.Where(ReglaActiva).ToList();
        if (activas.Count == 0) return true;
        return _filtroLogica == "or" ? activas.Any(r => EvalRegla(t, r)) : activas.All(r => EvalRegla(t, r));
    }
    private string _buscarTarea = "";
    // Texto comparable de un campo (para operadores de texto/seleccion/asignado).
    private string ValorTextoFiltro(TareaListaDto t, string campo) => campo switch
    {
        "estado" => t.EstadoId.ToString(),
        "resp" => t.AsignadoNombre ?? "",
        "prio" => t.Prioridad.ToString(),
        "titulo" => t.Titulo ?? "",
        "descripcion" => t.Descripcion ?? "",
        "valor" => t.Valor?.ToString(CultureInfo.InvariantCulture) ?? "",
        "vence" => t.FechaVencimiento?.ToString("yyyy-MM-dd") ?? "",
        _ => CampoDeTarea(t, Guid.TryParse(campo, out var g) ? g : Guid.Empty)
    };
    private DateOnly? FechaFiltro(TareaListaDto t, string campo)
    {
        if (campo == "vence") return t.FechaVencimiento;
        return DateOnly.TryParse(CampoDeTarea(t, Guid.TryParse(campo, out var g) ? g : Guid.Empty), out var d) ? d : null;
    }
    private bool EvalRegla(TareaListaDto t, FiltroRegla r)
    {
        var kind = FiltroKind(r.Campo);
        if (kind == "etiqueta")
        {
            var has = !string.IsNullOrEmpty(r.Valor) && t.Etiquetas.Any(e => e.Id.ToString() == r.Valor);
            return r.Op == "no_tiene" ? !has : has;
        }
        if (kind == "num")
        {
            var nv = ValorNumColumna(t, r.Campo);
            if (r.Op == "vacio") return nv is null;
            if (r.Op == "no_vacio") return nv is not null;
            if (!decimal.TryParse(r.Valor, NumberStyles.Any, CultureInfo.InvariantCulture, out var rv)) return true;
            if (nv is null) return false;
            return r.Op switch { "=" => nv == rv, "!=" => nv != rv, ">" => nv > rv, ">=" => nv >= rv, "<" => nv < rv, "<=" => nv <= rv, _ => true };
        }
        if (kind == "fecha")
        {
            var dv = FechaFiltro(t, r.Campo);
            if (r.Op == "vacio") return dv is null;
            if (r.Op == "no_vacio") return dv is not null;
            if (!DateOnly.TryParse(r.Valor, out var rd)) return true;
            if (dv is null) return false;
            return r.Op switch { "es" => dv == rd, "antes" => dv < rd, "despues" => dv > rd, _ => true };
        }
        // texto / seleccion / asignado
        var sv = ValorTextoFiltro(t, r.Campo);
        if (r.Op == "vacio") return string.IsNullOrWhiteSpace(sv);
        if (r.Op == "no_vacio") return !string.IsNullOrWhiteSpace(sv);
        if (string.IsNullOrEmpty(r.Valor)) return true;
        return r.Op switch
        {
            "es" => string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_es" => !string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "contiene" => sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_contiene" => !sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }
    // Editor de valor de una regla (segun el tipo de campo). Se oculta para vacio/no_vacio.
    private RenderFragment RenderValorFiltro(int idx) => builder =>
    {
        if (idx < 0 || idx >= _reglas.Count) return;
        var r = _reglas[idx];
        var kind = FiltroKind(r.Campo);
        void Select(IEnumerable<(string Val, string Txt)> opts, string ph)
        {
            builder.OpenElement(0, "select");
            builder.AddAttribute(1, "class", "tb-frule-v");
            builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValor(idx, e)));
            builder.OpenElement(3, "option");
            builder.AddAttribute(4, "value", "");
            builder.AddAttribute(5, "selected", string.IsNullOrEmpty(r.Valor));
            builder.AddContent(6, ph);
            builder.CloseElement();
            var k = 7;
            foreach (var (val, txt) in opts)
            {
                builder.OpenElement(k++, "option");
                builder.AddAttribute(k++, "value", val);
                builder.AddAttribute(k++, "selected", r.Valor == val);
                builder.AddContent(k++, txt);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        void Input(string type)
        {
            builder.OpenElement(20, "input");
            builder.AddAttribute(21, "class", "tb-frule-v");
            builder.AddAttribute(22, "type", type);
            builder.AddAttribute(23, "value", r.Valor);
            builder.AddAttribute(24, "placeholder", "Valor");
            builder.AddAttribute(25, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValor(idx, e)));
            builder.CloseElement();
        }
        switch (kind)
        {
            case "sel-estado":
                Select((_board?.Estados ?? new List<EstadoTareaDto>()).Select(es => (es.Id.ToString(), es.Nombre)), "Elegir etapa...");
                break;
            case "sel-prio":
                Select(Enum.GetValues<PrioridadTarea>().Select(p => (p.ToString(), p.ToString())), "Elegir prioridad...");
                break;
            case "resp":
                Select(RespOptions().Select(x => (x, x)), "Elegir responsable...");
                break;
            case "etiqueta":
                Select(_etiquetasCat.Select(et => (et.Id.ToString(), et.Nombre)), "Elegir etiqueta...");
                break;
            case "sel-din":
                Select(CampoOpciones(CampoDinamico(r.Campo)!).Select(o => (o, o)), "Elegir opcion...");
                break;
            case "num":
                Input("number");
                break;
            case "fecha":
                Input("date");
                break;
            default:
                Input("text");
                break;
        }
    };

    // ----- Vista Calendario (mensual por fecha de vencimiento) -----
    private static readonly string[] _diasSemana = { "LUN", "MAR", "MIE", "JUE", "VIE", "SAB", "DOM" };
    private int _calYear; private int _calMonth; private bool _calInit;
    private string _calMode = "mes";          // "mes" | "semana"
    private DateOnly _calWeek;                  // lunes de la semana mostrada
    private record CalCelda(int Dia, bool EsMes, bool EsHoy, bool EsFinde, List<TareaListaDto> Cards);
    private record CalDia(string Dow, int Dia, string Mes, bool EsHoy, List<TareaListaDto> Cards);

    private static DateOnly LunesDe(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));

    private void CalInit()
    {
        if (_calInit) return;
        var t = DateTime.Today; _calYear = t.Year; _calMonth = t.Month;
        _calWeek = LunesDe(DateOnly.FromDateTime(t)); _calInit = true;
    }
    private void CalMover(int delta)
    {
        CalInit();
        if (_calMode == "mes") { var d = new DateTime(_calYear, _calMonth, 1).AddMonths(delta); _calYear = d.Year; _calMonth = d.Month; }
        else { _calWeek = _calWeek.AddDays(7 * delta); }
    }
    private void CalHoy() { var t = DateTime.Today; _calYear = t.Year; _calMonth = t.Month; _calWeek = LunesDe(DateOnly.FromDateTime(t)); _calInit = true; }
    private string CalTitulo()
    {
        CalInit();
        if (_calMode == "semana")
        {
            var fin = _calWeek.AddDays(6);
            return $"{_calWeek.Day} {_calWeek.ToString("MMM", Es)} - {fin.Day} {fin.ToString("MMM yyyy", Es)}";
        }
        var s = new DateTime(_calYear, _calMonth, 1).ToString("MMMM yyyy", Es);
        return char.ToUpper(s[0]) + s.Substring(1);
    }

    private List<CalDia> CalSemanaDias()
    {
        CalInit();
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var porDia = _tareas.AsEnumerable()
            .Where(t => t.FechaVencimiento.HasValue)
            .GroupBy(t => t.FechaVencimiento!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(t => t.Prioridad).ToList());
        var dows = new[] { "LUN", "MAR", "MIE", "JUE", "VIE", "SAB", "DOM" };
        var res = new List<CalDia>(7);
        for (int i = 0; i < 7; i++)
        {
            var d = _calWeek.AddDays(i);
            res.Add(new CalDia(dows[i], d.Day, d.ToString("MMM", Es), d == hoy,
                porDia.GetValueOrDefault(d, new List<TareaListaDto>())));
        }
        return res;
    }
    private List<TareaListaDto> CalCards() => _tareas.Where(t => t.FechaVencimiento.HasValue).ToList();

    private List<CalCelda> CalCeldas()
    {
        CalInit();
        var primero = new DateTime(_calYear, _calMonth, 1);
        int offset = ((int)primero.DayOfWeek + 6) % 7; // semana inicia lunes
        var inicio = primero.AddDays(-offset);
        int dias = DateTime.DaysInMonth(_calYear, _calMonth);
        int total = (int)Math.Ceiling((offset + dias) / 7.0) * 7;
        var hoy = DateTime.Today;
        var porDia = _tareas.AsEnumerable()
            .Where(t => t.FechaVencimiento.HasValue)
            .GroupBy(t => t.FechaVencimiento!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(t => t.Prioridad).ToList());
        var celdas = new List<CalCelda>(total);
        for (int i = 0; i < total; i++)
        {
            var f = inicio.AddDays(i);
            celdas.Add(new CalCelda(
                f.Day,
                f.Month == _calMonth,
                f.Date == hoy.Date,
                f.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday,
                porDia.GetValueOrDefault(DateOnly.FromDateTime(f), new List<TareaListaDto>())));
        }
        return celdas;
    }

    // ----- Vista Gantt (cronograma de barras inicio-fin) -----
    private const int GColW = 34;
    private DateOnly? GIni(TareaListaDto t) => t.FechaInicio ?? t.FechaVencimiento;
    private DateOnly? GFin(TareaListaDto t) => t.FechaVencimiento ?? t.FechaInicio;
    private List<TareaListaDto> GanttTareas() =>
        _tareas.AsEnumerable().Where(t => GIni(t).HasValue)
            .OrderBy(t => GIni(t)!.Value).ThenBy(t => t.Titulo).ToList();
    private List<TareaListaDto> GanttSinFecha() =>
        _tareas.AsEnumerable().Where(t => !GIni(t).HasValue && t.PadreId == null && Hijos(t.Id).All(h => !GIni(h).HasValue)).ToList();

    // Una tarea entra al gantt si ella o alguna descendiente tiene fecha.
    private bool GanttVisible(TareaListaDto t) => GIni(t).HasValue || Hijos(t.Id).Any(GanttVisible);

    // Filas del gantt en orden jerarquico, respetando expandidas.
    private List<(TareaListaDto t, int depth)> GanttFilasOrden()
    {
        var res = new List<(TareaListaDto, int)>();
        void Walk(TareaListaDto t, int depth)
        {
            res.Add((t, depth));
            if (_expandidas.Contains(t.Id))
                foreach (var h in Hijos(t.Id).Where(GanttVisible).OrderBy(x => GIni(x) ?? DateOnly.MaxValue).ThenBy(x => x.Titulo))
                    Walk(h, depth + 1);
        }
        var raices = _tareas.AsEnumerable()
            .Where(t => t.PadreId == null && GanttVisible(t))
            .OrderBy(t => GIni(t) ?? DateOnly.MaxValue).ThenBy(t => t.Titulo);
        foreach (var r in raices) Walk(r, 0);
        return res;
    }

    // El cronograma usa una ventana fija de GanttDias dias anclada en _ganttAncla, navegable
    // con los botones Anterior/Siguiente/Hoy (igual que el calendario). Las tareas fuera de la
    // ventana siguen listadas a la izquierda, pero su barra solo se dibuja cuando entra en rango.
    private DateOnly _ganttAncla; private bool _ganttInit;
    private const int GanttDias = 35;   // ancho de la ventana visible (5 semanas)
    private const int GanttPaso = 14;   // dias que avanza/retrocede cada salto

    private void GanttInitRango()
    {
        if (_ganttInit) return;
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var ds = GanttTareas();
        var primera = ds.Count > 0 ? ds.Min(t => GIni(t)!.Value) : hoy;
        _ganttAncla = (primera < hoy ? primera : hoy).AddDays(-2);
        _ganttInit = true;
    }
    private (DateOnly ini, int dias) GanttRango()
    {
        GanttInitRango();
        return (_ganttAncla, GanttDias);
    }
    private void GanttMover(int delta) { GanttInitRango(); _ganttAncla = _ganttAncla.AddDays(GanttPaso * delta); }
    private void GanttHoy() { _ganttAncla = DateOnly.FromDateTime(DateTime.Today).AddDays(-4); _ganttInit = true; }

    private static string DowLetra(DateOnly d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday => "Lu", DayOfWeek.Tuesday => "Ma", DayOfWeek.Wednesday => "Mi",
        DayOfWeek.Thursday => "Ju", DayOfWeek.Friday => "Vi", DayOfWeek.Saturday => "Sa", _ => "Do"
    };
    private static string FechaCortaSimple(DateOnly d) => d.Day + " " + d.ToString("MMM yyyy", Es);

    @* Render recursivo: la fila + sus tareas hijas (encadenadas) cuando esta expandida. Hasta 3 niveles, como el prototipo. *@
    private RenderFragment RenderArbol(TareaListaDto t, int depth) => __builder =>
    {
        @RenderFila(t, depth)
        @if (t.CantidadSubtareas > 0 && _expandidas.Contains(t.Id) && depth < 3)
        {
            foreach (var h in Hijos(t.Id))
            {
                @RenderArbol(h, depth + 1)
            }
        }
    };

    private string? CampoValor(TareaListaDto t, Guid campoId) => t.CamposValores?.FirstOrDefault(v => v.CampoId == campoId)?.Valor;

    private RenderFragment RenderFila(TareaListaDto t, int depth) => __builder =>
    {
        var tarea = t;
        var esHija = depth > 0;
        <div class="tb-row @(esHija ? "tb-row-child" : "")" style="border-left-color:@(t.Color ?? (esHija ? "#E1E8EE" : "transparent"))">
            @* ---- TITULO (editable inline) ---- *@
            <div class="tb-row-tit @(_pinTitulo ? "tb-pin" : "")" style="padding-left:@(depth * 22)px">
                @if (t.CantidadSubtareas > 0)
                {
                    <button class="tb-exp" @onclick="() => ToggleExp(tarea.Id)" title="Ver tareas hijas">
                        @if (_expandidas.Contains(t.Id))
                        { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14"/></svg> }
                        else { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M5 12h14"/></svg> }
                    </button>
                }
                else if (esHija)
                {
                    <span class="tb-row-kidmark">&rsaquo;</span>
                }
                @if (EnEd(t.Id, "titulo"))
                {
                    <input class="tb-cell-inp" @bind="_editVal" @bind:event="oninput" autofocus
                           @onblur='() => GuardarEd(tarea.Id, "titulo")' @onkeydown='@(e => EdKeydown(e, tarea.Id, "titulo"))' />
                }
                else
                {
                    <div class="tb-row-t tb-editable" title="@TooltipEstado(t) - Click para editar" @onclick='() => IniciarEd(tarea.Id, "titulo", tarea.Titulo)'>@t.Titulo</div>
                }
                @if (depth < 3)
                {
                    <button class="tb-row-addsub" title="Agregar tarea hija" @onclick="() => AbrirSubtareaDraft(tarea)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"/></svg></button>
                }
                <button class="tb-row-open" title="Abrir detalle" @onclick="() => AbrirCardDraft(tarea, null)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></button>
            </div>
            @* ---- DESCRIPCION (click -> caja expandible) ---- *@
            @if (_colDesc)
            {
                <div class="tb-row-desc">
                    @if (EnEd(t.Id, "descripcion"))
                    {
                        <textarea class="tb-cell-area" rows="3" @bind="_editVal" @bind:event="oninput" autofocus
                                  @onblur='() => GuardarEd(tarea.Id, "descripcion")' @onkeydown='@(e => { if (e.Key == "Escape") CancelarEd(); })'></textarea>
                    }
                    else
                    {
                        <div class="tb-editable tb-row-desc-prev" title="Click para editar" @onclick='() => IniciarEd(tarea.Id, "descripcion", tarea.Descripcion)'>@(string.IsNullOrWhiteSpace(t.Descripcion) ? "—" : t.Descripcion)</div>
                    }
                </div>
            }
            @* ---- ETAPA ---- *@
            <div class="tb-row-cell-est">
                @if (!esHija)
                {
                    <select class="tb-est-sel" style="background:@(t.EstadoColor ?? "#6D4FE3")" value="@t.EstadoId" @onchange="(e) => CambiarEstadoFila(tarea.Id, e)">
                        @if (_board is not null) { @foreach (var e in _board.Estados) { <option value="@e.Id" style="background:#fff;color:#33475B">@e.Nombre</option> } }
                    </select>
                }
                else { <span class="tb-subtag">Subtarea</span> }
            </div>
            @* ---- ASIGNADO (multi-select) ---- *@
            @if (_colResp)
            {
                var resp = tarea.Responsables ?? new List<ResponsableMiniDto>();
                <div class="tb-row-resp tb-editable" @onclick="() => AbrirAsigDrop(tarea)">
                    @if (resp.Count == 0) { <span class="tb-row-resp-empty">Sin asignar</span> }
                    else
                    {
                        @foreach (var r in resp.Take(3)) { <span class="tb-ava tb-ava-sm" title="@r.Nombre">@Iniciales(r.Nombre)</span> }
                        @if (resp.Count > 3) { <span class="tb-ava-more">+@(resp.Count - 3)</span> }
                    }
                    @if (_asigDropId == tarea.Id)
                    {
                        <div class="tb-asig-drop" @onclick:stopPropagation="true">
                            @foreach (var u in _personas ?? new List<PersonaMini>())
                            {
                                var uu = u;
                                <button type="button" class="tb-asig-item @(_asigSel.Contains(u.Id) ? "on" : "")" @onclick="() => ToggleAsig(tarea.Id, uu.Id)">
                                    <span class="tb-asig-chk @(_asigSel.Contains(u.Id) ? "on" : "")"></span>
                                    <span class="tb-ava tb-ava-sm">@Iniciales(u.Nombre)</span><span class="tb-asig-nom">@u.Nombre</span>
                                </button>
                            }
                            @if ((_personas ?? new()).Count == 0) { <div class="tb-asig-empty">Sin personas en el directorio</div> }
                            <button type="button" class="tb-asig-close" @onclick="CerrarAsigDrop">Listo</button>
                        </div>
                    }
                </div>
            }
            @* ---- PROGRESO ---- *@
            <div class="tb-row-prog">
                @if (t.CantidadSubtareas == 0)
                {
                    <input type="range" min="0" max="100" step="5" value="@t.Progreso" style="accent-color:@(t.Progreso >= 100 ? "#1A8754" : "#6D4FE3")" @onchange="(e) => CambiarProgresoFila(tarea.Id, e)" />
                }
                else
                {
                    <div class="tb-prog-bar" title="Se calcula desde las subtareas"><div class="tb-prog-fill" style="width:@(t.Progreso)%;background:@(t.Progreso >= 100 ? "#1A8754" : "#6D4FE3")"></div></div>
                }
                <span class="tb-row-progv" style="color:@(t.Progreso >= 100 ? "#1A8754" : "#516F90")">@t.Progreso%</span>
            </div>
            @* ---- ETIQUETAS (chips contenidos; texto editable inline + swatch de color al final) ---- *@
            @if (_colEtiq)
            {
                <div class="tb-row-etiq">
                    @foreach (var tag in t.Etiquetas)
                    {
                        var et = tag;
                        var etCol = string.IsNullOrWhiteSpace(et.Color) ? "#6D4FE3" : et.Color!;
                        <span class="tb-tag" style="background:@etCol;border-color:@etCol;color:@TagTextColor(etCol)">
                            @if (_tagEditId == et.Id)
                            {
                                <input class="tb-tag-inp" @bind="_tagEditVal" @bind:event="oninput" autofocus
                                       @onblur="() => GuardarTagNombre(et)" @onkeydown="(e) => TagKeydown(e, et)" />
                            }
                            else
                            {
                                <span class="tb-tag-tx" title="Click para renombrar la etiqueta" @onclick="() => IniciarTagEdit(et)">@et.Nombre</span>
                            }
                            <button type="button" class="tb-tag-sw" title="Cambiar color de la etiqueta" @onclick:stopPropagation="true" @onclick="() => ToggleTagColor(et.Id)"></button>
                            @if (_tagColorId == et.Id)
                            {
                                <div class="tb-tagpop-bd" @onclick="() => _tagColorId = null"></div>
                                <div class="tb-tag-colors" @onclick:stopPropagation="true">
                                    @foreach (var c in _colores)
                                    {
                                        var cc = c;
                                        <button type="button" class="tb-tag-copt @(string.Equals(et.Color, cc, StringComparison.OrdinalIgnoreCase) ? "on" : "")" style="background:@cc" title="@cc" @onclick="() => GuardarTagColor(et, cc)"></button>
                                    }
                                </div>
                            }
                        </span>
                    }
                </div>
            }
            @* ---- PRIORIDAD (inline select) ---- *@
            @if (_colPrio)
            {
                <div class="tb-row-prio">
                    <select class="tb-prio-sel" style="color:@PrioFg(t.Prioridad);background:@PrioBg(t.Prioridad)" value="@t.Prioridad" @onchange="(e) => CambiarPrioridadFila(tarea.Id, e)">
                        @foreach (var pr in Enum.GetValues<PrioridadTarea>()) { <option value="@pr" style="background:#fff;color:#33475B">@pr</option> }
                    </select>
                </div>
            }
            @* ---- VENCE (inline date) ---- *@
            @if (_colDue)
            {
                <div class="tb-row-due">
                    @if (EnEd(t.Id, "fechaVencimiento"))
                    {
                        <input type="date" class="tb-cell-inp" value="@_editVal" @oninput='e => _editVal = e.Value?.ToString() ?? string.Empty' autofocus
                               @onblur='() => GuardarEd(tarea.Id, "fechaVencimiento")' @onkeydown='@(e => EdKeydown(e, tarea.Id, "fechaVencimiento"))' />
                    }
                    else
                    {
                        <div class="tb-editable" @onclick='() => IniciarEd(tarea.Id, "fechaVencimiento", tarea.FechaVencimiento?.ToString("yyyy-MM-dd"))'>@(t.FechaVencimiento.HasValue ? FechaCorta(t.FechaVencimiento.Value) : "—")</div>
                    }
                </div>
            }
            @* ---- VALOR (inline number) ---- *@
            @if (_colValor)
            {
                <div class="tb-row-valor tb-num">
                    @if (EnEd(t.Id, "valor"))
                    {
                        <input type="number" step="1000" class="tb-cell-inp" @bind="_editVal" @bind:event="oninput" autofocus
                               @onblur='() => GuardarEd(tarea.Id, "valor")' @onkeydown='@(e => EdKeydown(e, tarea.Id, "valor"))' />
                    }
                    else
                    {
                        <div class="tb-editable" @onclick='() => IniciarEd(tarea.Id, "valor", tarea.Valor?.ToString(System.Globalization.CultureInfo.InvariantCulture))'>@(t.Valor.HasValue ? "$" + t.Valor.Value.ToString("N0") : "—")</div>
                    }
                </div>
            }
            @* ---- RELACIONADO CON (inmueble / zona / equipo) ---- *@
            @if (_colOrigen)
            {
                <div class="tb-row-orig">
                    <select class="tb-orig-tsel" value="@(t.OrigenTipo ?? "")" @onchange="(e) => CambiarOrigenTipoFila(tarea.Id, e)">
                        <option value="">Sin relacion</option>
                        <option value="inmueble">Inmueble</option>
                        <option value="zona">Zona comun</option>
                        <option value="equipo">Equipo/activo</option>
                    </select>
                    @if (!string.IsNullOrEmpty(t.OrigenTipo))
                    {
                        <SelectorOrigenReferencia InputClass="tb-orig-rsel"
                                                  Placeholder="@OrigenPlaceholder(t.OrigenTipo)"
                                                  Opciones="@OrigenBusquedaDe(t.OrigenTipo)"
                                                  Value="@t.OrigenReferencia"
                                                  ValueChanged="@(v => PatchLocal(tarea.Id, x => x with { OrigenReferencia = string.IsNullOrEmpty(v) ? null : v }))"
                                                  OnCommit="@(v => CambiarOrigenRefFilaVal(tarea.Id, tarea.OrigenTipo, v))" />
                    }
                </div>
            }
            @* ---- CAMPOS PERSONALIZADOS (editable por tipo) ---- *@
            @foreach (var c in CamposVisibles)
            {
                var campo = c;
                <div class="tb-row-campo tb-cc-@campo.Id @(CampoEsNumerico(campo) ? "tb-num" : "")">
                    @if (EnEd(t.Id, "campo:" + campo.Id))
                    {
                        @if (campo.Tipo == TipoCampoTablero.AreaTexto || campo.Tipo == TipoCampoTablero.Texto || campo.Tipo == TipoCampoTablero.Telefono)
                        {
                            <textarea class="tb-cell-area" rows="3" @bind="_editVal" @bind:event="oninput" autofocus
                                      @onblur="() => GuardarCampoValor(tarea.Id, campo.Id)" @onkeydown="@(e => CampoKeydown(e, tarea.Id, campo.Id))"></textarea>
                        }
                        else if (campo.Tipo == TipoCampoTablero.Numero || campo.Tipo == TipoCampoTablero.Moneda)
                        {
                            <input type="number" class="tb-cell-inp" @bind="_editVal" @bind:event="oninput" autofocus
                                   @onblur="() => GuardarCampoValor(tarea.Id, campo.Id)" @onkeydown="@(e => CampoKeydown(e, tarea.Id, campo.Id))" />
                        }
                        else if (campo.Tipo == TipoCampoTablero.Fecha)
                        {
                            <input type="date" class="tb-cell-inp" value="@_editVal" @oninput='e => _editVal = e.Value?.ToString() ?? string.Empty' autofocus
                                   @onblur="() => GuardarCampoValor(tarea.Id, campo.Id)" @onkeydown="@(e => CampoKeydown(e, tarea.Id, campo.Id))" />
                        }
                        else
                        {
                            <input class="tb-cell-inp" @bind="_editVal" @bind:event="oninput" autofocus
                                   @onblur="() => GuardarCampoValor(tarea.Id, campo.Id)" @onkeydown="@(e => CampoKeydown(e, tarea.Id, campo.Id))" />
                        }
                    }
                    else
                    {
                        <div class="tb-editable" title="Click para editar" @onclick='() => IniciarEd(tarea.Id, "campo:" + campo.Id, CampoValor(tarea, campo.Id))'>@(string.IsNullOrWhiteSpace(CampoDisplay(t, campo)) ? "—" : CampoDisplay(t, campo))</div>
                    }
                </div>
            }
            @* ---- ACCIONES ---- *@
            <div class="tb-row-acc">
                <button class="tb-acc-btn" title="Copiar tarea" @onclick="() => AbrirCopiaDialog(tarea.Id, tarea.Titulo, tarea.EstadoId)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg></button>
                <button class="tb-acc-btn tb-acc-del" title="Eliminar tarea" @onclick="() => EliminarFila(tarea.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
            </div>
        </div>
    };

    private void ToggleExp(Guid id) { if (!_expandidas.Add(id)) _expandidas.Remove(id); }

    private void AbrirSubtareaDraft(TareaListaDto padre)
    {
        _subNew = ""; _respPick = "";
        _cardDraft = new CardDraft
        {
            PadreId = padre.Id,
            PadreTitulo = padre.Titulo,
            EstadoId = padre.EstadoId,
            Color = padre.Color ?? "#6D4FE3"
        };
    }

    private async Task CambiarEstadoFila(Guid tareaId, ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var estadoId)) return;
        if (EstadoEsTerminal(estadoId))
        {
            // Cerrar pide motivo; no parcheamos local (si confirma, la tarea desaparece del activo).
            await CambiarEstadoOCerrar(tareaId, estadoId);
            return;
        }
        PatchLocal(tareaId, t => t with { EstadoId = estadoId, EstadoNombre = _board?.Estados.FirstOrDefault(x => x.Id == estadoId)?.Nombre ?? t.EstadoNombre, EstadoColor = _board?.Estados.FirstOrDefault(x => x.Id == estadoId)?.Color ?? t.EstadoColor });
        var resp = await Auth().PutAsJsonAsync($"/api/tareas/{tareaId}/estado", new CambiarEstadoRequest(estadoId, null));
        if (resp.IsSuccessStatusCode) await RecargarBoard();
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; await RecargarBoard(); }
    }

    // ================= Edicion inline tipo Excel (vista tabla) =================
    private string? _editKey;      // "{tareaId}:{campo}" de la celda en edicion
    private string _editVal = "";  // valor temporal
    private bool _editBusy;

    private bool EnEd(Guid id, string campo) => _editKey == id + ":" + campo;
    private void IniciarEd(Guid id, string campo, string? actual) { _editKey = id + ":" + campo; _editVal = actual ?? ""; }
    private void CancelarEd() { _editKey = null; _editVal = ""; }

    private void PatchLocal(Guid id, Func<TareaListaDto, TareaListaDto> f)
    {
        var i = _tareas.FindIndex(x => x.Id == id);
        if (i >= 0) _tareas[i] = f(_tareas[i]);
    }

    private async Task GuardarEd(Guid id, string campo)
    {
        if (_editKey != id + ":" + campo || _editBusy) return;
        _editBusy = true;
        try
        {
            object? body = null;
            switch (campo)
            {
                case "titulo":
                    var tit = _editVal.Trim();
                    if (string.IsNullOrWhiteSpace(tit)) { CancelarEd(); return; }
                    PatchLocal(id, t => t with { Titulo = tit });
                    body = new { Campo = "titulo", Texto = tit };
                    break;
                case "descripcion":
                    var des = string.IsNullOrWhiteSpace(_editVal) ? null : _editVal.Trim();
                    PatchLocal(id, t => t with { Descripcion = des });
                    body = new { Campo = "descripcion", Texto = des };
                    break;
                case "valor":
                    decimal? val = decimal.TryParse(_editVal, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var dv) ? dv : (decimal?)null;
                    PatchLocal(id, t => t with { Valor = val });
                    body = new { Campo = "valor", Numero = val };
                    break;
                case "fechaVencimiento":
                    DateOnly? fv = DateOnly.TryParse(_editVal, out var d0) ? d0 : (DateOnly?)null;
                    PatchLocal(id, t => t with { FechaVencimiento = fv });
                    body = new { Campo = "fechaVencimiento", Fecha = fv };
                    break;
            }
            CancelarEd();
            if (body is not null)
            {
                var resp = await Auth().PatchAsJsonAsync($"/api/tareas/{id}/inline", body);
                if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; await RecargarBoard(); }
            }
        }
        finally { _editBusy = false; }
    }

    private async Task EdKeydown(KeyboardEventArgs e, Guid id, string campo)
    {
        if (e.Key == "Enter") await GuardarEd(id, campo);
        else if (e.Key == "Escape") CancelarEd();
    }

    private async Task CambiarPrioridadFila(Guid id, ChangeEventArgs e)
    {
        if (!Enum.TryParse<PrioridadTarea>(e.Value?.ToString(), out var pr)) return;
        PatchLocal(id, t => t with { Prioridad = pr });
        var resp = await Auth().PatchAsJsonAsync($"/api/tareas/{id}/inline", new { Campo = "prioridad", Texto = pr.ToString() });
        if (!resp.IsSuccessStatusCode) await RecargarBoard();
    }

    // ---- Valor de un campo personalizado inline ----
    private async Task GuardarCampoValor(Guid id, Guid campoId)
    {
        if (_editKey != id + ":campo:" + campoId || _editBusy) return;
        _editBusy = true;
        try
        {
            var val = _editVal;
            PatchLocal(id, t =>
            {
                var lista = (t.CamposValores ?? new List<TareaCampoValorDto>()).Where(v => v.CampoId != campoId).ToList();
                if (!string.IsNullOrWhiteSpace(val)) lista.Add(new TareaCampoValorDto(campoId, val.Trim()));
                return t with { CamposValores = lista };
            });
            CancelarEd();
            var resp = await Auth().PutAsJsonAsync($"/api/tareas/{id}/campo-valor/{campoId}", new { Valor = val });
            if (!resp.IsSuccessStatusCode) await RecargarBoard();
        }
        finally { _editBusy = false; }
    }
    private async Task CampoKeydown(KeyboardEventArgs e, Guid id, Guid campoId)
    {
        if (e.Key == "Enter") await GuardarCampoValor(id, campoId);
        else if (e.Key == "Escape") CancelarEd();
    }

    // ---- Asignados inline (multi-select desde miembros del tablero) ----
    private Guid? _asigDropId;
    private HashSet<Guid> _asigSel = new();
    private async Task AbrirAsigDrop(TareaListaDto t)
    {
        _asigDropId = t.Id;
        _asigSel = (t.Responsables ?? new List<ResponsableMiniDto>()).Select(r => r.PersonaId).ToHashSet();
        if (_personas is null)
        {
            try { var raw = await Auth().GetFromJsonAsync<List<PersonaRaw>>("/api/directorio/personas") ?? new(); _personas = raw.Select(p => new PersonaMini(p.Id, ($"{p.Nombres} {p.Apellidos}").Trim())).ToList(); }
            catch { _personas = new(); }
        }
    }
    private void CerrarAsigDrop() { _asigDropId = null; }
    private string NombreMiembro(Guid pid) => _personas?.FirstOrDefault(p => p.Id == pid)?.Nombre ?? PersonaNombre(pid);
    private async Task ToggleAsig(Guid tareaId, Guid personaId)
    {
        if (!_asigSel.Add(personaId)) _asigSel.Remove(personaId);
        var ids = _asigSel.ToList();
        PatchLocal(tareaId, t =>
        {
            var resp = ids.Select(pid => new ResponsableMiniDto(pid, NombreMiembro(pid), null)).ToList();
            return t with { Responsables = resp, AsignadoPersonaId = ids.Count > 0 ? ids[0] : (Guid?)null, AsignadoNombre = ids.Count > 0 ? NombreMiembro(ids[0]) : null };
        });
        var r = await Auth().PatchAsJsonAsync($"/api/tareas/{tareaId}/inline", new { Campo = "asignados", Guids = ids });
        if (!r.IsSuccessStatusCode) await RecargarBoard();
    }

    // ---- Duplicar / eliminar fila ----
    private async Task EliminarFila(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/tareas/{id}");
        if (resp.IsSuccessStatusCode) _tareas.RemoveAll(t => t.Id == id);
    }

    // ---- Fila "nueva tarea" inline tipo Excel: Tab entre campos, Enter crea con todo lo lleno ----
    private class NuevaFilaDraft
    {
        public string Titulo = "";
        public string Descripcion = "";
        public Guid EstadoId;
        public PrioridadTarea Prioridad = PrioridadTarea.Normal;
        public DateOnly? FechaVencimiento;
        public decimal? Valor;
        public List<Guid> Asignados = new();
        public Dictionary<Guid, string?> Campos = new();
        public string? OrigenTipo;
        public string? OrigenReferencia;
    }
    private readonly Dictionary<Guid, NuevaFilaDraft> _nuevaFilas = new();
    private Guid? _nfFocusEstado;   // columna cuyo titulo hay que reenfocar tras crear en la vista Lista
    private NuevaFilaDraft NuevaFilaDe(Guid estadoId)
    {
        if (!_nuevaFilas.TryGetValue(estadoId, out var d)) { d = new NuevaFilaDraft { EstadoId = estadoId }; _nuevaFilas[estadoId] = d; }
        return d;
    }
    private void SetNuevaFilaAsignado(NuevaFilaDraft d, ChangeEventArgs e)
        => d.Asignados = Guid.TryParse(e.Value?.ToString(), out var g) && g != Guid.Empty ? new List<Guid> { g } : new List<Guid>();

    private async Task NuevaFilaKeydown(KeyboardEventArgs e, Guid estadoId)
    {
        if (e.Key == "Enter") await CrearDesdeNuevaFila(estadoId);
        else if (e.Key == "Escape") _nuevaFilas[estadoId] = new NuevaFilaDraft { EstadoId = estadoId };
    }
    private async Task CrearDesdeNuevaFila(Guid estadoId)
    {
        var d = NuevaFilaDe(estadoId);
        if (string.IsNullOrWhiteSpace(d.Titulo) || _board is null) return;
        var camposValores = d.Campos.Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
            .Select(kv => new TareaCampoValorDto(kv.Key, kv.Value)).ToList();
        var oTipo = string.IsNullOrWhiteSpace(d.OrigenTipo) ? null : d.OrigenTipo;
        var oRef = oTipo is null || string.IsNullOrWhiteSpace(d.OrigenReferencia) ? null : d.OrigenReferencia;
        var req = new CrearTareaRequest(d.Titulo.Trim(), string.IsNullOrWhiteSpace(d.Descripcion) ? null : d.Descripcion.Trim(),
            d.Prioridad, d.EstadoId, null, null, d.FechaVencimiento, null, new List<Guid>(), _board.Tablero.Id,
            null, false, d.Valor, null, null, oTipo, oRef, d.Asignados.ToList(), new List<SubtareaCheckItem>(), camposValores);
        var resp = await Auth().PostAsJsonAsync("/api/tareas", req);
        if (resp.IsSuccessStatusCode) { _nuevaFilas[estadoId] = new NuevaFilaDraft { EstadoId = estadoId }; _nfFocusEstado = estadoId; await RecargarBoard(); }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    // Compositor progresivo en la vista tarjetas (kanban): titulo primero y, a medida
    // que se tabula, van apareciendo los demas campos (descripcion, asignado, prioridad,
    // vence, valor y campos personalizados). Enter crea, Esc cierra. Reusa NuevaFilaDraft.
    private Guid? _composerEstado;
    private NuevaFilaDraft _composerDraft = new();
    private int _composerReveal;   // indice del ultimo campo revelado (0 = solo titulo)
    private int _composerNonce;    // cambia al abrir/crear: recrea el input de titulo (lo limpia sin value=)
    private bool _composerFocusPending;   // pide devolver el foco al titulo tras recrearlo
    private ElementReference _composerTituloRef;
    private int ComposerMaxIdx => 6 + (_board?.Tablero.Campos?.Count ?? 0);
    private void AbrirComposer(Guid estadoId) { _composerEstado = estadoId; _composerDraft = new NuevaFilaDraft { EstadoId = estadoId }; _composerReveal = 0; _composerNonce++; _composerFocusPending = true; }
    private void CerrarComposer() { _composerEstado = null; }
    private void RevealComposerNext(int idx)
    {
        var target = idx + 1;
        if (target <= ComposerMaxIdx && _composerReveal < target) _composerReveal = target;
    }
    private void SetComposerAsignado(ChangeEventArgs e)
        => _composerDraft.Asignados = Guid.TryParse(e.Value?.ToString(), out var g) && g != Guid.Empty ? new List<Guid> { g } : new List<Guid>();
    private async Task ComposerKeydown(KeyboardEventArgs e, Guid estadoId, int idx)
    {
        if (e.Key == "Enter") await CrearDesdeComposer(estadoId);
        else if (e.Key == "Escape") CerrarComposer();
        // Tab: foco nativo; el siguiente campo ya fue revelado por el @onfocus del campo actual.
    }
    private async Task CrearDesdeComposer(Guid estadoId)
    {
        var d = _composerDraft;
        if (string.IsNullOrWhiteSpace(d.Titulo) || _board is null) return;
        var camposValores = d.Campos.Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
            .Select(kv => new TareaCampoValorDto(kv.Key, kv.Value)).ToList();
        var oTipo = string.IsNullOrWhiteSpace(d.OrigenTipo) ? null : d.OrigenTipo;
        var oRef = oTipo is null || string.IsNullOrWhiteSpace(d.OrigenReferencia) ? null : d.OrigenReferencia;
        var req = new CrearTareaRequest(d.Titulo.Trim(), string.IsNullOrWhiteSpace(d.Descripcion) ? null : d.Descripcion.Trim(),
            d.Prioridad, estadoId, null, null, d.FechaVencimiento, null, new List<Guid>(), _board.Tablero.Id,
            null, false, d.Valor, null, null, oTipo, oRef, d.Asignados.ToList(), new List<SubtareaCheckItem>(), camposValores);
        var resp = await Auth().PostAsJsonAsync("/api/tareas", req);
        if (resp.IsSuccessStatusCode) { _composerDraft = new NuevaFilaDraft { EstadoId = estadoId }; _composerReveal = 0; _composerNonce++; _composerFocusPending = true; await RecargarBoard(); }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    // ---- Drag & drop de tarjetas entre columnas del Kanban ----
    private Guid? _dragTareaId;

    private void IniciarArrastre(Guid tareaId) => _dragTareaId = tareaId;

    private async Task SoltarEnEstado(Guid estadoId)
    {
        var tareaId = _dragTareaId;
        _dragTareaId = null;
        if (tareaId is null || _board is null) return;
        var tarea = _tareas.FirstOrDefault(t => t.Id == tareaId.Value);
        if (tarea is null || tarea.EstadoId == estadoId) return;  // misma columna: nada que hacer
