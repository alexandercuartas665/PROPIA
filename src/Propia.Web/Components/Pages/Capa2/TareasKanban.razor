    private void CerrarCard() { _cardDraft = null; _subNew = ""; _respPick = ""; }

    private async Task AbrirCardDraft(TareaListaDto? t, Guid? estadoIdDefault)
    {
        _subNew = ""; _respPick = "";
        if (t is null)
        {
            _cardDraft = new CardDraft { EstadoId = estadoIdDefault ?? _board?.Estados.FirstOrDefault()?.Id ?? Guid.Empty };
            return;
        }

        // Tarjeta existente: traer la ficha completa.
        try
        {
            var det = await Auth().GetFromJsonAsync<TareaDetalleDto>($"/api/tareas/{t.Id}");
            if (det is null) return;
            var responsables = new List<Guid>();
            if (det.AsignadoPersonaId is { } ap) responsables.Add(ap);
            responsables.AddRange(det.Colaboradores.Select(c => c.PersonaId).Where(p => !responsables.Contains(p)));
            _cardDraft = new CardDraft
            {
                Id = det.Id,
                PadreId = det.PadreId,
                PadreTitulo = det.PadreTitulo,
                Titulo = det.Titulo,
                Descripcion = det.Descripcion,
                Prioridad = det.Prioridad,
                EstadoId = det.Estado.Id,
                Color = det.Color ?? t.Color ?? "#6D4FE3",
                EsProyecto = det.EsProyecto,
                Valor = det.Valor,
                Progreso = det.Progreso,
                FechaInicio = det.FechaInicio?.ToDateTime(TimeOnly.MinValue),
                FechaVencimiento = det.FechaVencimiento?.ToDateTime(TimeOnly.MinValue),
                HoraInicio = det.HoraInicio,
                HoraFin = det.HoraFin,
                OrigenTipo = det.OrigenTipo,
                OrigenReferencia = det.OrigenReferencia,
                Responsables = responsables,
                Checklist = (det.Checklist ?? new List<SubtareaCheckDto>()).Select(s => new SubChk { Titulo = s.Titulo, Hecho = s.Hecho }).ToList(),
                Adjuntos = (det.Adjuntos ?? new List<TareaAdjuntoDto>()).Select(a => new AdjuntoVM(a.Id, a.Nombre, a.Url)).ToList(),
                Historial = det.Historial.OrderBy(h => h.OcurridoAt).Select(h => new LogVM(h.Descripcion, h.OcurridoAt)).ToList()
            };
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task GuardarCard()
    {
        if (_cardDraft is null || _board is null || string.IsNullOrWhiteSpace(_cardDraft.Titulo)) return;
        var d = _cardDraft;
        _busy = true;
        try
        {
            var ini = d.FechaInicio.HasValue ? DateOnly.FromDateTime(d.FechaInicio.Value) : (DateOnly?)null;
            var venc = d.FechaVencimiento.HasValue ? DateOnly.FromDateTime(d.FechaVencimiento.Value) : (DateOnly?)null;
            var origenTipo = string.IsNullOrWhiteSpace(d.OrigenTipo) ? null : d.OrigenTipo;
            var origenRef = string.IsNullOrWhiteSpace(d.OrigenReferencia) ? null : d.OrigenReferencia;
            var responsables = d.Responsables.Count > 0 ? d.Responsables.ToList() : new List<Guid>();
            var checklist = d.Checklist.Where(x => !string.IsNullOrWhiteSpace(x.Titulo))
                .Select(x => new SubtareaCheckItem(x.Titulo.Trim(), x.Hecho)).ToList();

            HttpResponseMessage resp;
            if (d.Id is null)
            {
                var req = new CrearTareaRequest(
                    d.Titulo.Trim(), d.Descripcion, d.Prioridad, d.EstadoId,
                    null, ini, venc, d.PadreId, null, _board.Tablero.Id,
                    d.Color, d.EsProyecto, d.Valor, d.HoraInicio, d.HoraFin,
                    origenTipo, origenRef, responsables, checklist);
                resp = await Auth().PostAsJsonAsync("/api/tareas", req);
            }
            else
            {
                var req = new ActualizarTareaRequest(
                    d.Titulo.Trim(), d.Descripcion, d.Prioridad, null, ini, venc,
                    d.EstadoId, d.Color, d.EsProyecto, d.Valor, d.Progreso, d.HoraInicio, d.HoraFin,
                    origenTipo, origenRef, responsables, checklist);
                resp = await Auth().PutAsJsonAsync($"/api/tareas/{d.Id}", req);
            }
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            // Si era una tarea hija, deja el padre expandido para verla en la lista.
            if (d.PadreId is { } pid) { _expandidas.Add(pid); if (_boardMode == "tablero") _boardMode = "lista"; }
            CerrarCard();
            await RecargarBoard();
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task EliminarCard()
    {
        if (_cardDraft?.Id is null) return;
        if (!await Js.InvokeAsync<bool>("confirm", "Eliminar esta tarjeta? Esta accion no se puede deshacer.")) return;
        _busy = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/tareas/{_cardDraft.Id}");
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            CerrarCard();
            await RecargarBoard();
        }
        finally { _busy = false; }
    }

