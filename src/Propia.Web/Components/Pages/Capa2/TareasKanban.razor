    .tb-cosel-menu { position: absolute; top: calc(100% + 6px); right: 0; min-width: 250px; background: #fff; border: 1px solid #E1E8EE; border-radius: 12px; box-shadow: 0 12px 30px rgba(45,62,80,.16); padding: 6px; z-index: 60; max-height: 340px; overflow-y: auto; }
    .tb-cosel-item { display: flex; align-items: center; gap: 9px; width: 100%; text-align: left; background: transparent; border: 0; border-radius: 8px; padding: 9px 10px; font-size: 13px; font-weight: 600; color: #33475B; cursor: pointer; }
