    private string _tbBuscar = "";
    private List<PersonaResumenDto> _tbResultados = new();
    private Dictionary<Guid, (string Nombre, string? Foto)> _tbSelInfo = new();

    private (string Nombre, string? Foto) SelInfo(Guid pid)
        => _tbSelInfo.TryGetValue(pid, out var v) ? v : (PersonaNombre(pid), (string?)null);

    private async Task BuscarPersonasTb()
    {
        var q = _tbBuscar?.Trim() ?? "";
        if (q.Length < 2) { _tbResultados.Clear(); return; }
        try
        {
            _tbResultados = await Auth().GetFromJsonAsync<List<PersonaResumenDto>>(
                $"/api/directorio/personas?q={Uri.EscapeDataString(q)}") ?? new();
        }
