@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals

@* Equipos y activos: modulo propio (antes era una seccion del acordeon de Mi copropiedad).
   Mismo contenido que tenia alli - resumen, tarjetas/lista y alta rapida - sin acordeon y
   sin numeral. El detalle vive en FichaEquipoModal; el alta masiva en
   GestionarEquiposActivosModal.

   CSS con prefijo ea-* y propio: las clases mc-* solo existen mientras se renderiza
   MiCopropiedad, asi que en esta pagina no estarian disponibles. *@

<div class="mod-pagehead">
    <div>
        <h1 class="mod-pagetitle">Equipos y Activos</h1>
        <p class="mod-pagesub">Ascensores, bombas, plantas y demas activos fisicos de la copropiedad, con su estado.</p>
    </div>
    @if (_authChecked && _jwt is not null)
    {
        <div class="ea-plantilla">
            <button type="button" class="ea-btn-ghost" @onclick="DescargarPlantillaAsync" disabled="@_impBusy" title="Descargar plantilla Excel">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
                Descargar plantilla
            </button>
            <label class="propia-btn-brand @(_impBusy ? "is-busy" : "")" style="cursor:pointer;" title="Cargar plantilla Excel (crea o actualiza)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V9m0 0l-4 4m4-4l4 4M4 3h16"/></svg>
                @(_impBusy ? "Cargando..." : "Cargar plantilla")
                <InputFile OnChange="OnPlantillaImport" accept=".xlsx" style="display:none" disabled="@_impBusy" />
            </label>
        </div>
    }
</div>

@if (_impResult is not null)
{
    <div class="ea-impres">
        <b>Carga completa:</b> @_impResult.Creados creados, @_impResult.Actualizados actualizados, @_impResult.CamposCargados campos.
        @if (_impResult.FilasConError > 0)
        {
            <span class="ea-impres-err"> · @_impResult.FilasConError con error</span>
            <ul class="ea-impres-list">@foreach (var er in _impResult.Errores.Take(10)) { <li>Fila @er.Fila: @er.Mensaje</li> }</ul>
        }
    </div>
}

@if (!_authChecked)
{
    <div class="ea-loading"><div class="spinner-border" style="color: var(--propia-brand, var(--propia-brand));"></div></div>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    @* Sin value= en el buscador: Blazor Server se come pulsaciones al reafirmarlo en cada re-render. *@
    <div class="mod-filtros">
        @* Boton "Filtros" PRIMERO y luego el buscador (orden estandar de los modulos). *@
        <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="StateHasChanged" />
        <div class="mod-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="mod-search-inp" placeholder="Buscar equipo o activo..."
                   @oninput="@(e => { _q = e.Value?.ToString() ?? string.Empty; _pagina = 1; })" />
        </div>
        @* Campos: unica entrada a la configuracion del modulo, en la posicion canonica de Unidades
           (barra de herramientas, junto al toggle). No se limita a la vista tabla porque configura
           CAMPOS, no solo columnas: en Tarjetas tambien hace falta. *@
        <div class="ea-menu-wrap" style="margin-left:auto;">
            <button type="button" class="ea-fbtn @(_selAbierto ? "on" : "")" @onclick="() => _selAbierto = true" title="Campos de los equipos: orden, visibilidad, nombre y campos propios">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                <span>Campos</span>
            </button>
        </div>
        <div class="ea-viewtoggle">
            <button type="button" class="ea-vt @(_view == "cards" ? "on" : "")" @onclick='() => SetVista("cards")' title="Tarjetas">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Tarjetas
            </button>
            <button type="button" class="ea-vt @(_view == "list" ? "on" : "")" @onclick='() => SetVista("list")' title="Tabla">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                Tabla
            </button>
        </div>
    </div>

    @if (_view == "cards")
    {
        <div class="ea-grid">
            @foreach (var e in Filtrados())
            {
                var eq = e;
                <div class="ea-card" @onclick="@(() => AbrirFichaEquipoAsync(eq))">
                    <div class="ea-card-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h6M9 11h6M10 16h4"/></svg>
                    </div>
                    <div class="ea-card-body">
                        <div class="ea-card-name">
                            @e.Nombre
                            @if (e.Tipo == TipoElemento.Activo && e.Cantidad > 1) { <span class="ea-qty">x@(e.Cantidad)</span> }
                        </div>
                        <div class="ea-card-meta">
                            @e.Categoria
                            @if (e.EsReservable) { <span class="ea-flag">reservable</span> }
                        </div>
                    </div>
                    <span class="ea-badge ea-badge--@EstadoBadge(e.Estado)">@EstadoTextoCorto(e.Estado)</span>
                    <span class="ea-card-del" role="button" @onclick:stopPropagation="true" @onclick="() => EliminarEquipoAsync(eq.Id, eq.Nombre)" title="Eliminar equipo/activo">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                    </span>
                </div>
            }

            @* Compositor progresivo: la tarjeta crece a medida que se agregan datos. *@
            @if (_composerOpen)
            {
                <div class="ea-composer">
                    @* SIN value=: en Blazor Server se reafirma en cada re-render y se come pulsaciones.
                       El ojito crea el equipo/activo y abre su ficha de una vez. *@
                    <div class="ea-inp-wrap">
                        <input class="ea-composer-inp" placeholder="Nombre del equipo o activo..." autofocus
                               @oninput="@(e => { _draft.Nombre = e.Value?.ToString() ?? string.Empty; Reveal(0); })"
                               @onkeydown="Keydown" />
                        @if (!string.IsNullOrWhiteSpace(_draft.Nombre))
                        {
                            <button type="button" class="ea-inp-eye" title="Crear y abrir ficha"
                                    @onclick="CrearYAbrirFichaAsync" disabled="@_busy">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        }
                    </div>
                    @if (_reveal >= 1)
                    {
                        <select class="ea-composer-sel" @bind="_draft.Categoria" @onfocus="@(() => Reveal(1))">
                            @foreach (var c in Enum.GetValues<CategoriaEquipo>()) { <option value="@c">@c</option> }
                        </select>
                    }
                    @if (_reveal >= 2)
                    {
                        <select class="ea-composer-sel" @bind="_draft.Tipo" @onfocus="@(() => Reveal(2))">
                            <option value="@TipoElemento.Equipo">Equipo (unitario)</option>
                            <option value="@TipoElemento.Activo">Activo (agrupado)</option>
                        </select>
                    }
                    @if (_reveal >= 3 && _draft.Tipo == TipoElemento.Activo)
                    {
                        <input type="number" min="1" class="ea-composer-sel" placeholder="Cantidad"
                               @bind="_draft.Cantidad" @onfocus="@(() => Reveal(3))" />
                    }
                    @if (_reveal >= 3)
                    {
                        <select class="ea-composer-sel" @onfocus="@(() => Reveal(3))"
                                @onchange="@(e => _draft.EsReservable = e.Value?.ToString() == "true")">
                            <option value="false" selected="@(!_draft.EsReservable)">No reservable</option>
                            <option value="true" selected="@_draft.EsReservable">Reservable</option>
                        </select>
                    }
                    <div class="ea-composer-foot">
                        <button type="button" class="ea-composer-cancel" @onclick="CancelarComposer">Cancelar</button>
                        <button type="button" class="ea-composer-ok" @onclick="CrearDesdeDraftAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft.Nombre))">@(_busy ? "Creando..." : "Crear")</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="ea-add-card" @onclick="AbrirComposer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                    Agregar equipo o activo
                </button>
            }
        </div>
    }
    else
    {
        var listaE = Filtrados().ToList();
        var totalPagE = listaE.Count == 0 ? 1 : (int)Math.Ceiling(listaE.Count / (double)_porPagina);
        var pagE = Math.Clamp(_pagina, 1, totalPagE);
        var pageE = listaE.Skip((pagE - 1) * _porPagina).Take(_porPagina);
        <div class="ea-list">
            @* Columnas dirigidas por la config compartida (unidades-config, entidad 'equipo'): sistema y
               propias en UNA sola secuencia, con el orden/visibilidad/alias del Selector de Campos. *@
            <div class="ea-list-head ea-listgrid" style="@EaGridStyle">
                <div></div>
                @foreach (var k in ColsVisibles()) { <div title="@(EsCustom(k) ? "Campo personalizado" : null)">@ColLabel(k).ToUpperInvariant()</div> }
                <div></div>
            </div>
            @foreach (var e in pageE)
            {
                var eq = e;
                @* Datos editables inline; el expansor (primera columna, se ve al hover) abre la ficha. *@
                <div class="ea-list-row ea-listgrid" style="@EaGridStyle">
                    <div class="ea-col-exp">
                        <button type="button" class="ea-exp-fijo" title="Abrir la ficha para editar" @onclick="() => AbrirFichaEquipoAsync(eq)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @foreach (var k in ColsVisibles())
                    {
                        if (CampoCustom(k) is EquipoCampoDefinicionDto cd)
                        {
                            var cdd = cd;
                            var vv = ValorCampo(eq.Id, cd.Id);
                            switch (cd.Tipo)
                            {
                                case TipoCampoTablero.Seleccion:
                                    <select class="ea-cell" value="@vv" @onchange="(ev) => GuardarCampoValorEquipo(eq, cdd, ev.Value?.ToString())">
                                        <option value="">-</option>
                                        @foreach (var op in OpcionesDe(cd)) { <option value="@op" selected="@(vv == op)">@op</option> }
                                    </select>
                                    break;
                                case TipoCampoTablero.Numero:
                                case TipoCampoTablero.Moneda:
                                    <input class="ea-cell" type="number" step="any" value="@vv" @onchange="(ev) => GuardarCampoValorEquipo(eq, cdd, ev.Value?.ToString())" />
                                    break;
                                case TipoCampoTablero.Fecha:
                                    <input class="ea-cell" type="date" value="@vv" @onchange="(ev) => GuardarCampoValorEquipo(eq, cdd, ev.Value?.ToString())" />
                                    break;
                                case TipoCampoTablero.Booleano:
                                    <select class="ea-cell" value="@vv" @onchange="(ev) => GuardarCampoValorEquipo(eq, cdd, ev.Value?.ToString())">
                                        <option value="">-</option>
                                        <option value="Si" selected="@(vv == "Si")">Si</option>
                                        <option value="No" selected="@(vv == "No")">No</option>
                                    </select>
                                    break;
                                case TipoCampoTablero.Formula:
                                    @* Calculado en lectura (viene computado del backend): solo lectura. *@
                                    <div class="ea-list-c" title="Se calcula automaticamente">@(string.IsNullOrWhiteSpace(vv) ? "-" : vv)</div>
                                    break;
                                case TipoCampoTablero.Usuario:
                                    <select class="ea-cell" value="@vv" @onchange="(ev) => GuardarCampoValorEquipo(eq, cdd, ev.Value?.ToString())">
                                        <option value="">-</option>
                                        @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId" selected="@(vv == u.PersonaId.ToString())">@u.NombreCompleto</option> }
                                    </select>
                                    break;
                                case TipoCampoTablero.Directorio:
                                    <SelectorPersona Flotante="true" Jwt="@_jwt" Placeholder="Buscar persona..."
                                                     Seleccionada="@CandidatoDe(vv)"
                                                     SeleccionadaChanged="(c) => OnDirectorioCelda(eq, cdd, c)" />
                                    break;
                                default:
                                    <input class="ea-cell" value="@vv" @onchange="(ev) => GuardarCampoValorEquipo(eq, cdd, ev.Value?.ToString())" title="@cd.Label" />
                                    break;
                            }
                            continue;
                        }
                        switch (k)
                        {
                            case "nombre":
                                <input class="ea-cell ea-cell-nom" value="@e.Nombre" @onchange="@(ev => GuardarEquipoInline(eq, "nombre", ev))" />
                                break;
                            case "categoria":
                                <select class="ea-cell" @onchange="@(ev => GuardarEquipoInline(eq, "categoria", ev))">
                                    @foreach (var c in Enum.GetValues<CategoriaEquipo>()) { <option value="@c" selected="@(e.Categoria == c)">@c</option> }
                                </select>
                                break;
                            case "tipo":
                                <select class="ea-cell" @onchange="@(ev => GuardarEquipoInline(eq, "tipo", ev))">
                                    <option value="@TipoElemento.Equipo" selected="@(e.Tipo == TipoElemento.Equipo)">Equipo</option>
                                    <option value="@TipoElemento.Activo" selected="@(e.Tipo == TipoElemento.Activo)">Activo</option>
                                </select>
                                break;
                            case "cantidad":
                                <input type="number" min="1" class="ea-cell ea-num" value="@e.Cantidad" @onchange="@(ev => GuardarEquipoInline(eq, "cantidad", ev))" />
                                break;
                            case "estado":
                                <select class="ea-cell ea-cell-est" @onchange="@(ev => GuardarEquipoInline(eq, "estado", ev))">
                                    @foreach (var s in Enum.GetValues<EstadoEquipoActivo>()) { <option value="@s" selected="@(e.Estado == s)">@EstadoTextoCorto(s)</option> }
                                </select>
                                break;
                            case "reservable":
                                <select class="ea-cell" @onchange="@(ev => GuardarEquipoInline(eq, "reservable", ev))">
                                    <option value="false" selected="@(!e.EsReservable)">No</option>
                                    <option value="true" selected="@e.EsReservable">Si</option>
                                </select>
                                break;
                            case "modelo":
                                <input class="ea-cell" value="@e.Modelo" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "modelo", ev))" />
                                break;
                            case "serie":
                                <input class="ea-cell" value="@e.NumeroSerie" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "serie", ev))" />
                                break;
                            case "ubicacion":
                                <input class="ea-cell" value="@e.Ubicacion" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "ubicacion", ev))" />
                                break;
                            case "observaciones":
                                <input class="ea-cell" value="@e.Observaciones" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "observaciones", ev))" />
                                break;
                            case "vidautil":
                                <input type="number" min="0" class="ea-cell ea-num" value="@e.VidaUtilAnios" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "vidautil", ev))" />
                                break;
                            case "valoradq":
                                <input type="number" step="any" min="0" class="ea-cell ea-num" value="@e.ValorAdquisicion" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "valoradq", ev))" />
                                break;
                            case "proveedor":
                                <input class="ea-cell" value="@e.Proveedor" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "proveedor", ev))" />
                                break;
                            case "numfactura":
                                <input class="ea-cell" value="@e.NumeroFactura" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "numfactura", ev))" />
                                break;
                            case "marca":
                                <input class="ea-cell" value="@e.Marca" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "marca", ev))" />
                                break;
                            case "codigobarra":
                                <input class="ea-cell" value="@e.CodigoBarra" placeholder="-" @onchange="@(ev => GuardarEquipoInline(eq, "codigobarra", ev))" />
                                break;
                            case "fechainstalacion":
                                <input type="date" class="ea-cell" value="@(e.FechaInstalacion?.ToString("yyyy-MM-dd"))" @onchange="@(ev => GuardarEquipoInline(eq, "fechainstalacion", ev))" />
                                break;
                            case "garantiahasta":
                                <input type="date" class="ea-cell" value="@(e.GarantiaHasta?.ToString("yyyy-MM-dd"))" @onchange="@(ev => GuardarEquipoInline(eq, "garantiahasta", ev))" />
                                break;
                            case "fechaadquisicion":
                                <input type="date" class="ea-cell" value="@(e.FechaAdquisicion?.ToString("yyyy-MM-dd"))" @onchange="@(ev => GuardarEquipoInline(eq, "fechaadquisicion", ev))" />
                                break;
                        }
                    }
                    <div class="ea-list-act">
                        <button type="button" class="ea-row-del" @onclick="() => EliminarEquipoAsync(eq.Id, eq.Nombre)" title="Eliminar">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                        </button>
                    </div>
                </div>
            }
            @* @@key limpia la fila al crear; @@oninput SIN value= evita perder pulsaciones. *@
            <div class="ea-list-newrow ea-listgrid" style="@EaGridStyle" @key="_nonce">
                <div class="ea-col-exp">
                    <button type="button" class="ea-exp-fijo" tabindex="-1" title="Crear y abrir la ficha completa"
                            @onclick="CrearYAbrirFichaAsync" disabled="@_busy">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                </div>
                @foreach (var k in ColsVisibles())
                {
                    if (CampoCustom(k) is EquipoCampoDefinicionDto cd)
                    {
                        var cdd = cd;
                        var val = _nuCampos.GetValueOrDefault(cd.Id);
                        switch (cd.Tipo)
                        {
                            case TipoCampoTablero.Seleccion:
                                <select class="ea-row-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                    <option value="">- elegir -</option>
                                    @foreach (var op in OpcionesDe(cd)) { <option value="@op">@op</option> }
                                </select>
                                break;
                            case TipoCampoTablero.Numero:
                            case TipoCampoTablero.Moneda:
                                <input class="ea-row-inp" type="number" step="any" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" placeholder="@cd.Label" />
                                break;
                            case TipoCampoTablero.Fecha:
                                <input class="ea-row-inp" type="date" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" />
                                break;
                            case TipoCampoTablero.Booleano:
                                <select class="ea-row-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                    <option value="">- elegir -</option><option value="Si">Si</option><option value="No">No</option>
                                </select>
                                break;
                            case TipoCampoTablero.Formula:
                                @* Calculado y de solo lectura: no se captura, se computa al leer. *@
                                <div class="ea-list-c" title="Se calcula automaticamente">(se calcula)</div>
                                break;
                            case TipoCampoTablero.Usuario:
                                <select class="ea-row-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                    <option value="">- elegir -</option>
                                    @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId">@u.NombreCompleto</option> }
                                </select>
                                break;
                            case TipoCampoTablero.Directorio:
                                <SelectorPersona Flotante="true" Jwt="@_jwt" Placeholder="Buscar persona..."
                                                 SeleccionadaChanged="(c) => OnDirectorioAlta(cdd.Id, c)" />
                                break;
                            default:
                                <input class="ea-row-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" placeholder="@cd.Label" />
                                break;
                        }
                        continue;
                    }
                    switch (k)
                    {
                        case "nombre":
                            <input class="ea-row-inp" @ref="_nombreRef" placeholder="Nuevo equipo o activo..."
                                   @oninput="@(e => _draft.Nombre = e.Value?.ToString() ?? string.Empty)" @onkeydown="Keydown" />
                            break;
                        case "categoria":
                            <select class="ea-row-inp" @bind="_draft.Categoria">
                                @foreach (var c in Enum.GetValues<CategoriaEquipo>()) { <option value="@c">@c</option> }
                            </select>
                            break;
                        case "tipo":
                            <select class="ea-row-inp" @bind="_draft.Tipo">
                                <option value="@TipoElemento.Equipo">Equipo</option>
                                <option value="@TipoElemento.Activo">Activo</option>
                            </select>
                            break;
                        case "cantidad":
                            <input type="number" min="1" class="ea-row-inp" @bind="_draft.Cantidad" disabled="@(_draft.Tipo == TipoElemento.Equipo)" />
                            break;
                        case "reservable":
                            <select class="ea-row-inp" @onchange="@(e => _draft.EsReservable = e.Value?.ToString() == "true")">
                                <option value="false" selected="@(!_draft.EsReservable)">No</option>
                                <option value="true" selected="@_draft.EsReservable">Si</option>
                            </select>
                            break;
                        case "estado":
                            <div class="ea-list-c">Operativo</div>
                            break;
                        default:
                            @* Ficha tecnica (modelo, serie, fechas...): se completa en la ficha tras crear. *@
                            <div class="ea-list-c">-</div>
                            break;
                    }
                }
                <div class="ea-list-act">
                    <button type="button" class="ea-row-add" @onclick="CrearDesdeDraftAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft.Nombre))">+ Agregar</button>
                </div>
            </div>
            @* Footer canonico: visible SIEMPRE con la tabla, incluso con 0 filas ("Mostrando 0 de 0"). *@
            <TablaPager Total="listaE.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="equipos"
                        PaginaChanged="p => _pagina = p"
                        PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
        </div>
    }

    @* En vista Tabla, la propia tabla (cabecera + fila de alta + footer) comunica el vacio; el
       cartel de vacio solo va en Tarjetas (donde no hay footer). *@
    @if (_view == "cards" && !Filtrados().Any())
    {
        <div class="ea-empty">
            @(HayFiltros ? "Ningun equipo o activo coincide con el filtro." : "Aun no hay equipos ni activos registrados.")
        </div>
    }

    @if (!string.IsNullOrEmpty(_msg)) { <div class="ea-msg @(_msgOk ? "ok" : "bad")">@_msg</div> }
}

@* Selector de Campos (Fase 1): el gestor propio de campos dinamicos se reemplaza por el componente
   compartido. Orden/visibilidad/alias viven en unidades-config (entidad 'equipo'); los campos
   propios en equipos-campos. *@
@if (_selAbierto)
{
    <div class="ea-cfg-back" @onclick="() => _selAbierto = false">
        <div class="ea-cfg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="ea-cfg-head">
                <div>
                    <div class="ea-cfg-title">Campos de equipos y activos</div>
                    <div class="ea-cfg-sub">Orden, visibilidad, nombre y campos propios de la tabla y la ficha.</div>
                </div>
                <button class="ea-cfg-x" type="button" @onclick="() => _selAbierto = false" aria-label="Cerrar">&times;</button>
            </div>
            <div class="ea-cfg-body">
                <ConfigCamposEntidad Prefijo="equipos"
                                     EntidadConfig="equipo"
                                     TiposAvanzados="true"
                                     Catalogo="@EquipoCatalogo"
                                     TituloSingular="equipo"
                                     TituloPlural="Equipos"
                                     Ejemplo="Ej. Aseguradora, Responsable"
                                     Jwt="@_jwt"
                                     Cambiado="RecargarCamposYConfigAsync" />
            </div>
        </div>
    </div>
}

@* ModalHost debe declararse en CADA pagina: IModalService es scoped por circuito. *@
<ModalHost />

@code {
    private List<EquipoActivoDto> _equipos = new();
    private string? _jwt;
    private bool _authChecked;
    private string? _loadError;

    private string _view = "cards";
    private int _pagina = 1;
    private int _porPagina = 25;
    private const string VistaKey = "propia_view_equipos";
    private bool _composerOpen;
    private int _reveal;
    private bool _busy;
    private bool _impBusy;
    private ImportarPlantillaResultado? _impResult;
    private readonly EquipoDraft _draft = new();
    private int _nonce;
    private bool _focusPending;
    private ElementReference _nombreRef;

    private string _msg = "";
    private bool _msgOk = true;

    // Filtros (client-side: el inventario de una copropiedad cabe de sobra en memoria).
    // Un solo boton "Filtros" con reglas dinamicas (componente compartido FiltroDinamico).
    private string _q = "";
    private FiltroDinamico? _fd;

    private bool HayFiltros => !string.IsNullOrWhiteSpace(_q) || (_fd?.Hay ?? false);

    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "nombre", Label = "Nombre", Kind = "texto" },
        new() { Key = "categoria", Label = "Categoria", Kind = "sel",
                Opciones = Enum.GetValues<CategoriaEquipo>().Select(c => (c.ToString(), c.ToString())).ToList() },
        new() { Key = "estado", Label = "Estado", Kind = "sel",
                Opciones = Enum.GetValues<EstadoEquipoActivo>().Select(s => (s.ToString(), EstadoTextoCorto(s))).ToList() },
        new() { Key = "tipo", Label = "Tipo", Kind = "sel",
                Opciones = new() { (TipoElemento.Equipo.ToString(), "Equipo"), (TipoElemento.Activo.ToString(), "Activo") } },
        new() { Key = "reservable", Label = "Reservable", Kind = "sel",
                Opciones = new() { ("si", "Si"), ("no", "No") } },
        new() { Key = "ubicacion", Label = "Ubicacion", Kind = "texto" },
        new() { Key = "marca", Label = "Marca", Kind = "texto" },
        new() { Key = "cantidad", Label = "Cantidad", Kind = "num" },
    };

    private IEnumerable<EquipoActivoDto> Filtrados()
    {
        var q = _q.Trim();
        return _equipos
            .Where(e => q == "" || e.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Where(e => _fd?.Pasa(campo => campo switch
            {
                "nombre" => e.Nombre,
                "categoria" => e.Categoria.ToString(),
                "estado" => e.Estado.ToString(),
                "tipo" => e.Tipo.ToString(),
                "reservable" => e.EsReservable ? "si" : "no",
                "ubicacion" => e.Ubicacion ?? "",
                "marca" => e.Marca ?? "",
                "cantidad" => e.Cantidad.ToString(),
                _ => ""
            }) ?? true);
    }

    private sealed class EquipoDraft
    {
        public string Nombre = "";
        public CategoriaEquipo Categoria = CategoriaEquipo.Otros;
        public TipoElemento Tipo = TipoElemento.Equipo;
        public int Cantidad = 1;
        public bool EsReservable;
        public void Reset() { Nombre = ""; Categoria = CategoriaEquipo.Otros; Tipo = TipoElemento.Equipo; Cantidad = 1; EsReservable = false; }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    // La vista (Tarjetas/Lista) se recuerda por modulo en localStorage: sobrevive al cierre
    // de sesion (el logout solo borra llaves puntuales, no hace localStorage.clear()).
    private async Task SetVista(string v)
    {
        _view = v;
        try { await Js.InvokeVoidAsync("localStorage.setItem", VistaKey, v); } catch { }
    }

    private async Task RestaurarVistaAsync()
    {
        try
        {
            var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey);
            if (v == "cards" || v == "list") _view = v;
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jwt is null)
        {
            try
            {
                var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
                _authChecked = true;
                if (string.IsNullOrWhiteSpace(stored))
                {
                    Nav.NavigateTo("/login?returnUrl=%2Fequipos-activos", true);
                    return;
                }
                _jwt = stored;
                await RestaurarVistaAsync();
                await CargarAsync();
                StateHasChanged();
            }
            catch { /* prerender */ }
            return;
        }
        if (_focusPending)
        {
            _focusPending = false;
            try { await _nombreRef.FocusAsync(); } catch { }
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/equipos");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (nuevoJwt is null) return;
                _jwt = nuevoJwt;
                resp = await Auth().GetAsync("/api/mi-copropiedad/equipos");
            }
            resp.EnsureSuccessStatusCode();
            _equipos = await resp.Content.ReadFromJsonAsync<List<EquipoActivoDto>>() ?? new();
            await CargarCamposYConfigAsync();
            _loadError = null;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private async Task CargarCamposYConfigAsync()
    {
        try { _camposDef = await Auth().GetFromJsonAsync<List<EquipoCampoDefinicionDto>>("/api/mi-copropiedad/equipos-campos") ?? new(); } catch { _camposDef = new(); }
        try
        {
            var flat = await Auth().GetFromJsonAsync<List<EquipoCampoValorFlatDto>>("/api/mi-copropiedad/equipos-campos-valores") ?? new();
            _camposValores = flat.GroupBy(v => v.EquipoActivoId).ToDictionary(g => g.Key, g => g.ToDictionary(x => x.DefinicionId, x => x.Valor));
        }
        catch { _camposValores = new(); }
        try
        {
            var cfg = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config?entidad=equipo") ?? new();
            _cfgEquipo = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
        }
        catch { _cfgEquipo = new(StringComparer.Ordinal); }
        // Fase 2: usuarios del tenant (picker del campo Usuario) + mapa id->nombre para el render de
        // Usuario/Directorio (personas vinculadas al tenant; tenant-scoped por RLS).
        try { _usuariosTenant = await Auth().GetFromJsonAsync<List<UsuarioOpc>>("/api/usuarios") ?? new(); } catch { _usuariosTenant = new(); }
        try
        {
            var vinc = await Auth().GetFromJsonAsync<List<UsuarioOpc>>("/api/mi-copropiedad/personas-vinculadas") ?? new();
            _usuarioNombre = vinc.ToDictionary(v => v.PersonaId, v => v.NombreCompleto);
        }
        catch { _usuarioNombre = new(); }
    }

    // ===== Fase 2 (Formula/Usuario/Directorio) =====
    private List<UsuarioOpc> _usuariosTenant = new();
    private Dictionary<Guid, string> _usuarioNombre = new();
    private sealed record UsuarioOpc(Guid PersonaId, string NombreCompleto, string? Email);

    // Semilla del SelectorPersona en la celda Directorio: el valor guardado es el Guid; el nombre sale del
    // mapa de personas vinculadas (o queda el selector vacio si aun no resuelve).
    private Propia.Application.Directorio.PersonaCandidatoDto? CandidatoDe(string? valor)
        => !string.IsNullOrWhiteSpace(valor) && Guid.TryParse(valor, out var g)
            ? new Propia.Application.Directorio.PersonaCandidatoDto(
                g, _usuarioNombre.GetValueOrDefault(g, "Persona"), default, "", true, Array.Empty<string>())
            : null;

    private async Task OnDirectorioCelda(EquipoActivoDto eq, EquipoCampoDefinicionDto cd, Propia.Application.Directorio.PersonaCandidatoDto? c)
    {
        if (c is not null) _usuarioNombre[c.PersonaId] = c.NombreCompleto;
        await GuardarCampoValorEquipo(eq, cd, c?.PersonaId.ToString());
    }

    private void OnDirectorioAlta(Guid defId, Propia.Application.Directorio.PersonaCandidatoDto? c)
    {
        if (c is null) { _nuCampos[defId] = null; return; }
        _nuCampos[defId] = c.PersonaId.ToString();
        _usuarioNombre[c.PersonaId] = c.NombreCompleto;
    }

    // ===== Campos dinamicos (columnas + config) =====
    private List<EquipoCampoDefinicionDto> _camposDef = new();
    private Dictionary<Guid, Dictionary<Guid, string?>> _camposValores = new();
    private readonly Dictionary<Guid, string?> _nuCampos = new();
    private string? ValorCampo(Guid equipoId, Guid defId) => _camposValores.TryGetValue(equipoId, out var m) && m.TryGetValue(defId, out var v) ? v : null;

    private async Task GuardarCampoValorEquipo(EquipoActivoDto eq, EquipoCampoDefinicionDto cd, string? valor)
    {
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{eq.Id}/campos/{cd.Id}", new SetCampoValorRequest(valor));
            if (resp.IsSuccessStatusCode)
            {
                if (!_camposValores.TryGetValue(eq.Id, out var m)) { m = new(); _camposValores[eq.Id] = m; }
                m[cd.Id] = string.IsNullOrWhiteSpace(valor) ? null : valor;
            }
        }
        catch { }
    }
    // ---- Selector de Campos (Fase 1): columnas dirigidas por unidades-config (entidad 'equipo') ----
    // Reemplaza el gestor propio: orden/visibilidad/alias de las columnas (de sistema y propias) viven
    // en la config compartida por copropiedad; el componente ConfigCamposEntidad las escribe y aqui se
    // leen para pintar la tabla (mismo patron que Unidades/Seguros).
    private bool _selAbierto;
    private Dictionary<string, UnidadCampoConfigDto> _cfgEquipo = new(StringComparer.Ordinal);

    // Catalogo de campos de SISTEMA mapeado a la forma neutra del componente. Las columnas se renderizan
    // por clave con editor fijo: TiposIntercambiables vacio (tipo fijo) + SinFormato.
    private static readonly IReadOnlyList<CampoSistemaDef> EquipoCatalogo =
        EquipoCamposSistema.Todos.Select(c => new CampoSistemaDef(
            c.Clave, c.Label, c.Tipo, c.VisiblePorDefecto, c.Fija,
            OpcionesEditables: false, Semilla: null, Entero: false, Ayuda: null,
            TiposIntercambiables: Array.Empty<TipoCampoTablero>(), ListaExterna: false, SinFormato: true)).ToList();

    // Clave de config de un campo propio (misma convencion que el componente: "cd:{id}").
    private static string ClaveCustom(EquipoCampoDefinicionDto c) => "cd:" + c.Id;
    private static bool EsCustom(string clave) => clave.StartsWith("cd:", StringComparison.Ordinal);
    private EquipoCampoDefinicionDto? CampoCustom(string clave)
        => EsCustom(clave) && Guid.TryParse(clave[3..], out var g) ? _camposDef.FirstOrDefault(c => c.Id == g) : null;

    // Claves candidatas: sistema (orden del catalogo) + propias. Se ordenan y filtran por config.
    private IEnumerable<string> ClavesCandidatas()
        => EquipoCamposSistema.Todos.Select(c => c.Clave).Concat(_camposDef.OrderBy(d => d.Orden).Select(ClaveCustom));
    private bool VisibleColDefault(string clave)
        => EsCustom(clave) || (EquipoCamposSistema.Por(clave)?.VisiblePorDefecto ?? true);
    private bool VisibleCol(string clave)
        => _cfgEquipo.TryGetValue(clave, out var c) ? !c.Oculto : VisibleColDefault(clave);
    private int OrdenCol(string clave, int fallback)
        => _cfgEquipo.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;
    private IEnumerable<string> ClavesOrdenadas()
        => ClavesCandidatas().Select((k, i) => (k, ord: OrdenCol(k, i))).OrderBy(x => x.ord).Select(x => x.k);
    private IEnumerable<string> ColsVisibles() => ClavesOrdenadas().Where(VisibleCol);

    private string ColLabel(string clave)
    {
        if (_cfgEquipo.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias)) return c.Alias!;
        return CampoCustom(clave)?.Label ?? EquipoCamposSistema.Por(clave)?.Label ?? clave;
    }
    private static string ColWidth(string clave) => clave switch
    {
        "nombre" => "2fr",
        "categoria" => "1.2fr",
        "tipo" => "1fr",
        "cantidad" or "vidautil" => ".6fr",
        "estado" => "1.1fr",
        "reservable" => ".7fr",
        "valoradq" => ".9fr",
        "observaciones" => "minmax(140px,1.4fr)",
        "fechainstalacion" or "garantiahasta" or "fechaadquisicion" => "minmax(115px,.9fr)",
        _ when !EsCustom(clave) => "minmax(110px,1fr)",   // modelo, serie, ubicacion, proveedor, ...
        _ => "minmax(120px,150px)"                        // campos propios
    };
    private string EaGridStyle => "grid-template-columns: 34px " + string.Join(" ", ColsVisibles().Select(ColWidth)) + " 60px";

    private static string[] OpcionesDe(EquipoCampoDefinicionDto d) => string.IsNullOrWhiteSpace(d.Opciones)
        ? System.Array.Empty<string>() : d.Opciones.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // El gestor compartido cambio algo (alias/orden/visibilidad/campo propio): refresca todo.
    private async Task RecargarCamposYConfigAsync()
    {
        try { await CargarCamposYConfigAsync(); } catch { }
        StateHasChanged();
    }

    // ---- Plantilla Excel (descargar / cargar con upsert + campos dinamicos) ----
    private async Task DescargarPlantillaAsync()
    {
        _impBusy = true;
        try
        {
            var bytes = await Auth().GetByteArrayAsync("/api/mi-copropiedad/equipos/plantilla");
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", "plantilla-equipos-propia.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Msg("No se pudo descargar la plantilla: " + ex.Message, false); }
        finally { _impBusy = false; }
    }

    private async Task OnPlantillaImport(InputFileChangeEventArgs e)
    {
        if (e.File is null) return;
        _impBusy = true; _impResult = null; StateHasChanged();
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StreamContent(e.File.OpenReadStream(10 * 1024 * 1024)), "file", e.File.Name);
            var resp = await Auth().PostAsync("/api/mi-copropiedad/equipos/importar", content);
            if (resp.IsSuccessStatusCode)
            {
                _impResult = await resp.Content.ReadFromJsonAsync<ImportarPlantillaResultado>();
                await CargarAsync();
                Msg("Plantilla cargada.", true);
            }
            else Msg("Error al cargar: " + await resp.Content.ReadAsStringAsync(), false);
        }
        catch (Exception ex) { Msg("Error al cargar: " + ex.Message, false); }
        finally { _impBusy = false; StateHasChanged(); }
    }

    private async Task AbrirGestionarEquiposAsync()
    {
        var parameters = new ModalParameters().Set("Jwt", _jwt);
        var options = new ModalOptions { Width = "640px", Height = "540px" };
        var creado = await Modals.OpenAsync<GestionarEquiposActivosModal, EquipoActivoDto?>(parameters, options);
        if (creado is not null)
        {
            await CargarAsync();
            // Tras agregar el activo se abre su ficha para completar la configuracion.
            await AbrirFichaEquipoAsync(creado);
        }
    }

    private async Task AbrirFichaEquipoAsync(EquipoActivoDto equipo, bool abrirEnEdicion = false)
    {
        var parameters = new ModalParameters().Set("Jwt", _jwt).Set("Equipo", equipo).Set("AbrirEnEdicion", abrirEnEdicion);
        var options = new ModalOptions { Width = "1280px", Height = "88vh" };
        var hubo = await Modals.OpenAsync<FichaEquipoModal, bool>(parameters, options);
        if (hubo == true) { await CargarAsync(); Msg("Ficha actualizada.", true); }
    }

    private void AbrirComposer() { _draft.Reset(); _reveal = 0; _composerOpen = true; }
    private void CancelarComposer() { _composerOpen = false; _draft.Reset(); _reveal = 0; }
    private void Reveal(int idx) { var t = idx + 1; if (t <= 3 && _reveal < t) _reveal = t; }

    private async Task Keydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_draft.Nombre)) await CrearDesdeDraftAsync();
        else if (e.Key == "Escape") CancelarComposer();
    }

    // Edicion inline en la vista Tabla: guarda al salir del campo. Nombre/categoria/tipo/cantidad
    // van por PUT /equipos/{id} (conservando la ficha); el estado por su propio endpoint.
    private async Task GuardarEquipoInline(EquipoActivoDto e, string campo, ChangeEventArgs ev)
    {
        var val = ev.Value?.ToString() ?? "";
        try
        {
            if (campo == "estado")
            {
                if (!Enum.TryParse<EstadoEquipoActivo>(val, out var est) || est == e.Estado) return;
                var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{e.Id}/estado", new CambiarEstadoEquipoRequest(est));
                if (r.IsSuccessStatusCode) { var i = _equipos.FindIndex(x => x.Id == e.Id); if (i >= 0) _equipos[i] = e with { Estado = est }; Msg("Equipo actualizado.", true); }
                else Msg(await MensajeDeError(r, "No se pudo actualizar."), false);
                return;
            }
            var nombre = e.Nombre; var categoria = e.Categoria; var tipo = e.Tipo; var cantidad = e.Cantidad;
            var reservable = e.EsReservable; var modelo = e.Modelo; var serie = e.NumeroSerie;
            var fInst = e.FechaInstalacion; var garantia = e.GarantiaHasta; var ubicacion = e.Ubicacion;
            var obs = e.Observaciones; var vidaUtil = e.VidaUtilAnios; var fAdq = e.FechaAdquisicion;
            var valorAdq = e.ValorAdquisicion; var proveedor = e.Proveedor; var numFactura = e.NumeroFactura;
            var codBarra = e.CodigoBarra;
            // Marca es MERGE en el PUT: null = no tocar; solo se envia cuando ESTA celda cambio.
            string? marcaReq = null;
            static string? Txt(string v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
            static DateOnly? Fecha(string v) => DateOnly.TryParse(v, out var f) ? f : (DateOnly?)null;
            switch (campo)
            {
                case "nombre": if (string.IsNullOrWhiteSpace(val) || val.Trim() == e.Nombre) return; nombre = val.Trim(); break;
                case "categoria": if (!Enum.TryParse<CategoriaEquipo>(val, out categoria) || categoria == e.Categoria) return; break;
                case "tipo": if (!Enum.TryParse<TipoElemento>(val, out tipo) || tipo == e.Tipo) return; if (tipo == TipoElemento.Equipo) cantidad = 1; break;
                case "cantidad": cantidad = int.TryParse(val, out var c) ? Math.Max(1, c) : e.Cantidad; if (cantidad == e.Cantidad) return; break;
                case "reservable": reservable = val == "true"; if (reservable == e.EsReservable) return; break;
                case "modelo": modelo = Txt(val); if (modelo == e.Modelo) return; break;
                case "serie": serie = Txt(val); if (serie == e.NumeroSerie) return; break;
                case "ubicacion": ubicacion = Txt(val); if (ubicacion == e.Ubicacion) return; break;
                case "observaciones": obs = Txt(val); if (obs == e.Observaciones) return; break;
                case "vidautil": vidaUtil = int.TryParse(val, out var vu) ? vu : (int?)null; if (vidaUtil == e.VidaUtilAnios) return; break;
                case "valoradq": valorAdq = decimal.TryParse(val, out var va) ? va : (decimal?)null; if (valorAdq == e.ValorAdquisicion) return; break;
                case "proveedor": proveedor = Txt(val); if (proveedor == e.Proveedor) return; break;
                case "numfactura": numFactura = Txt(val); if (numFactura == e.NumeroFactura) return; break;
                case "marca": if (Txt(val) == e.Marca) return; marcaReq = val.Trim(); break;
                case "codigobarra": codBarra = Txt(val); if (codBarra == e.CodigoBarra) return; break;
                case "fechainstalacion": fInst = Fecha(val); if (fInst == e.FechaInstalacion) return; break;
                case "garantiahasta": garantia = Fecha(val); if (garantia == e.GarantiaHasta) return; break;
                case "fechaadquisicion": fAdq = Fecha(val); if (fAdq == e.FechaAdquisicion) return; break;
            }
            var req = new ActualizarEquipoActivoRequest(nombre, categoria, tipo, cantidad, reservable,
                modelo, serie, fInst, garantia, ubicacion, obs,
                vidaUtil, fAdq, valorAdq, proveedor, numFactura, codBarra, e.CondicionesUso, marcaReq);
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{e.Id}", req);
            if (resp.IsSuccessStatusCode)
            {
                var upd = await resp.Content.ReadFromJsonAsync<EquipoActivoDto>();
                var i = _equipos.FindIndex(x => x.Id == e.Id);
                if (upd is not null && i >= 0) _equipos[i] = upd;
                Msg("Equipo actualizado.", true);
            }
            else Msg(await MensajeDeError(resp, "No se pudo actualizar."), false);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
    }

    private async Task CrearDesdeDraftAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.Nombre)) return;
        _busy = true;
        try
        {
            // Un "Equipo" es unitario (cantidad 1); solo un "Activo" agrupa varias unidades.
            var cant = _draft.Tipo == TipoElemento.Equipo ? 1 : Math.Max(1, _draft.Cantidad);
            var req = new CrearEquipoActivoRequest(_draft.Nombre.Trim(), _draft.Categoria, _draft.Tipo, cant, _draft.EsReservable);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/equipos", req);
            if (resp.IsSuccessStatusCode)
            {
                // Persistir valores de campos dinamicos capturados en la fila de alta.
                if (_nuCampos.Count > 0)
                {
                    try
                    {
                        var creado = await resp.Content.ReadFromJsonAsync<EquipoActivoDto>();
                        if (creado is not null)
                            foreach (var kv in _nuCampos)
                                if (!string.IsNullOrWhiteSpace(kv.Value))
                                    await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{creado.Id}/campos/{kv.Key}", new SetCampoValorRequest(kv.Value));
                    }
                    catch { }
                    _nuCampos.Clear();
                }
                _draft.Reset(); _reveal = 0; _composerOpen = false; _nonce++; _focusPending = true;
                await CargarAsync();
                Msg("Equipo/activo creado. Haz clic en el para completar la ficha.", true);
            }
            else Msg(await MensajeDeError(resp, "No se pudo crear el equipo."), false);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
        _busy = false;
    }

    // El ojito del composer: crea el equipo/activo, lee el DTO devuelto y abre su ficha para
    // seguir completando (ficha tecnica, fotos, ventanas, etc.) sin buscarlo en la lista.
    private async Task CrearYAbrirFichaAsync()
    {
        // Desde el expansor la fila puede estar vacia: se usa un nombre por defecto y se completa en la ficha.
        var nombre = string.IsNullOrWhiteSpace(_draft.Nombre) ? "Nuevo equipo" : _draft.Nombre.Trim();
        _busy = true;
        EquipoActivoDto? creado = null;
        try
        {
            var cant = _draft.Tipo == TipoElemento.Equipo ? 1 : Math.Max(1, _draft.Cantidad);
            var req = new CrearEquipoActivoRequest(nombre, _draft.Categoria, _draft.Tipo, cant, _draft.EsReservable);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/equipos", req);
            if (resp.IsSuccessStatusCode)
            {
                creado = await resp.Content.ReadFromJsonAsync<EquipoActivoDto>();
                _draft.Reset(); _reveal = 0; _composerOpen = false; _nonce++;
                await CargarAsync();
            }
            else Msg(await MensajeDeError(resp, "No se pudo crear el equipo."), false);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
        _busy = false;
        if (creado is not null) await AbrirFichaEquipoAsync(creado, abrirEnEdicion: true);
    }

    private async Task EliminarEquipoAsync(Guid id, string nombre)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Eliminar el equipo/activo \"{nombre}\"?")) return;
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/equipos/{id}");
        if (resp.IsSuccessStatusCode) { await CargarAsync(); Msg("Equipo eliminado.", true); }
        else Msg(await MensajeDeError(resp, "No se pudo eliminar el equipo."), false);
    }

    private void Msg(string m, bool ok) { _msg = m; _msgOk = ok; }

    private static string EstadoBadge(EstadoEquipoActivo s) => s switch
    {
        EstadoEquipoActivo.Operativo => "ok",
        EstadoEquipoActivo.EnMantenimiento => "mant",
        EstadoEquipoActivo.FueraDeServicio => "fuera",
        _ => "ok"
    };

    private static string EstadoTextoCorto(EstadoEquipoActivo s) => s switch
    {
        EstadoEquipoActivo.Operativo => "Operativo",
        EstadoEquipoActivo.EnMantenimiento => "Mantenimiento",
        EstadoEquipoActivo.FueraDeServicio => "Fuera",
        _ => s.ToString()
    };

    private static async Task<string> MensajeDeError(HttpResponseMessage resp, string porDefecto)
    {
        try
        {
            var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (err is not null && err.TryGetValue("error", out var m) && !string.IsNullOrWhiteSpace(m)) return m;
        }
        catch { }
        return porDefecto;
    }
}

