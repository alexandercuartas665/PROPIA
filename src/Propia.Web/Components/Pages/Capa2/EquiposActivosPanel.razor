<TablaCtxMenu Abierto="_ctxOpenE" X="_ctxXE" Y="_ctxYE" Items="_ctxItemsE" Cerrado="() => _ctxOpenE = false" />

@if (_selAbierto)
{
    <div class="ea-cfg-back" @onclick="() => _selAbierto = false">
