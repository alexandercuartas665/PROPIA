            "vidautil" => e.VidaUtilAnios?.ToString(ci) ?? "",
            "valoradq" => e.ValorAdquisicion?.ToString(ci) ?? "",
            "proveedor" => e.Proveedor ?? "",
            "numfactura" => e.NumeroFactura ?? "",
            "marca" => e.Marca ?? "",
