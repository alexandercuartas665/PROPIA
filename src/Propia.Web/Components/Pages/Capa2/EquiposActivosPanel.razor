@* ModalHost debe declararse en CADA pagina: IModalService es scoped por circuito. *@
<ModalHost />

@code {
    // Embebido en el hub de Configuracion como pestaña "Equipos": oculta su cabecera propia (titulo +
    // plantilla), porque el hub pone su titulo y una carga unificada multi-hoja.
    [Parameter] public bool Embedded { get; set; }

    private List<EquipoActivoDto> _equipos = new();
    private string? _jwt;
    private bool _authChecked;
    private string? _loadError;

    private string _view = "cards";
    private int _pagina = 1;
    private int _porPagina = 25;
    private const string VistaKey = "propia_view_equipos";
    private bool _composerOpen;
    private int _reveal;
    private bool _busy;
    private bool _impBusy;
    private ImportarPlantillaResultado? _impResult;
    private readonly EquipoDraft _draft = new();
    private int _nonce;
    private bool _focusPending;
    private ElementReference _nombreRef;

    private string _msg = "";
    private bool _msgOk = true;

    // Filtros (client-side: el inventario de una copropiedad cabe de sobra en memoria).
    // Un solo boton "Filtros" con reglas dinamicas (componente compartido FiltroDinamico).
    private string _q = "";
    private FiltroDinamico? _fd;

    private bool HayFiltros => !string.IsNullOrWhiteSpace(_q) || (_fd?.Hay ?? false);

    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "nombre", Label = "Nombre", Kind = "texto" },
        new() { Key = "categoria", Label = "Categoria", Kind = "sel",
                Opciones = Enum.GetValues<CategoriaEquipo>().Select(c => (c.ToString(), c.ToString())).ToList() },
        new() { Key = "estado", Label = "Estado", Kind = "sel",
                Opciones = Enum.GetValues<EstadoEquipoActivo>().Select(s => (s.ToString(), EstadoTextoCorto(s))).ToList() },
        new() { Key = "tipo", Label = "Tipo", Kind = "sel",
                Opciones = new() { (TipoElemento.Equipo.ToString(), "Equipo"), (TipoElemento.Activo.ToString(), "Activo") } },
        new() { Key = "reservable", Label = "Reservable", Kind = "sel",
                Opciones = new() { ("si", "Si"), ("no", "No") } },
        new() { Key = "ubicacion", Label = "Ubicacion", Kind = "texto" },
        new() { Key = "marca", Label = "Marca", Kind = "texto" },
        new() { Key = "cantidad", Label = "Cantidad", Kind = "num" },
    };

    private IEnumerable<EquipoActivoDto> Filtrados()
    {
        var q = _q.Trim();
        var baseSeq = _equipos
            .Where(e => q == "" || e.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Where(e => _fd?.Pasa(campo => campo switch
            {
                "nombre" => e.Nombre,
                "categoria" => e.Categoria.ToString(),
                "estado" => e.Estado.ToString(),
                "tipo" => e.Tipo.ToString(),
                "reservable" => e.EsReservable ? "si" : "no",
                "ubicacion" => e.Ubicacion ?? "",
                "marca" => e.Marca ?? "",
                "cantidad" => e.Cantidad.ToString(),
                _ => ""
            }) ?? true);
        // Orden multi-criterio (menu "Ordenar" / clic en header); sin sort mantiene el orden natural del backend.
        if (_sortsE.Count > 0)
        {
            var sorts = _sortsE;
            var cmp = Comparer<EquipoActivoDto>.Create((a, b) =>
            {
                foreach (var s in sorts)
                {
                    var c = CmpValTabla(SortStrE(a, s.Key), SortStrE(b, s.Key)) * s.Dir;
                    if (c != 0) return c;
                }
                return 0;
            });
            return baseSeq.OrderBy(e => e, cmp);
        }
        return baseSeq;
    }

    private sealed class EquipoDraft
    {
        public string Nombre = "";
        public CategoriaEquipo Categoria = CategoriaEquipo.Otros;
        public TipoElemento Tipo = TipoElemento.Equipo;
        public int Cantidad = 1;
        public bool EsReservable;
        public void Reset() { Nombre = ""; Categoria = CategoriaEquipo.Otros; Tipo = TipoElemento.Equipo; Cantidad = 1; EsReservable = false; }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    // La vista (Tarjetas/Lista) se recuerda por modulo en localStorage: sobrevive al cierre
    // de sesion (el logout solo borra llaves puntuales, no hace localStorage.clear()).
    private async Task SetVista(string v)
    {
        _view = v;
        try { await Js.InvokeVoidAsync("localStorage.setItem", VistaKey, v); } catch { }
    }

    private async Task RestaurarVistaAsync()
    {
        try
        {
            var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey);
            if (v == "cards" || v == "list") _view = v;
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jwt is null)
        {
            try
            {
                var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
                _authChecked = true;
                if (string.IsNullOrWhiteSpace(stored))
                {
                    Nav.NavigateTo("/login?returnUrl=%2Fequipos-activos", true);
                    return;
                }
                _jwt = stored;
                await RestaurarVistaAsync();
                await CargarAsync();
                StateHasChanged();
            }
            catch { /* prerender */ }
            return;
        }
        if (_focusPending)
        {
            _focusPending = false;
            try { await _nombreRef.FocusAsync(); } catch { }
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/equipos");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (nuevoJwt is null) return;
                _jwt = nuevoJwt;
                resp = await Auth().GetAsync("/api/mi-copropiedad/equipos");
            }
            resp.EnsureSuccessStatusCode();
            _equipos = await resp.Content.ReadFromJsonAsync<List<EquipoActivoDto>>() ?? new();
            await CargarCamposYConfigAsync();
            _loadError = null;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private async Task CargarCamposYConfigAsync()
    {
        try { _camposDef = await Auth().GetFromJsonAsync<List<EquipoCampoDefinicionDto>>("/api/mi-copropiedad/equipos-campos") ?? new(); } catch { _camposDef = new(); }
        try
        {
            var flat = await Auth().GetFromJsonAsync<List<EquipoCampoValorFlatDto>>("/api/mi-copropiedad/equipos-campos-valores") ?? new();
            _camposValores = flat.GroupBy(v => v.EquipoActivoId).ToDictionary(g => g.Key, g => g.ToDictionary(x => x.DefinicionId, x => x.Valor));
        }
        catch { _camposValores = new(); }
        try
        {
            var cfg = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config?entidad=equipo") ?? new();
            _cfgEquipo = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchosE();
        }
        catch { _cfgEquipo = new(StringComparer.Ordinal); }
    }

    // ===== Campos dinamicos (columnas + config) =====
    private List<EquipoCampoDefinicionDto> _camposDef = new();
    private Dictionary<Guid, Dictionary<Guid, string?>> _camposValores = new();
    private readonly Dictionary<Guid, string?> _nuCampos = new();
    private string? ValorCampo(Guid equipoId, Guid defId) => _camposValores.TryGetValue(equipoId, out var m) && m.TryGetValue(defId, out var v) ? v : null;

    private async Task GuardarCampoValorEquipo(EquipoActivoDto eq, EquipoCampoDefinicionDto cd, string? valor)
    {
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{eq.Id}/campos/{cd.Id}", new SetCampoValorRequest(valor));
            if (resp.IsSuccessStatusCode)
            {
                if (!_camposValores.TryGetValue(eq.Id, out var m)) { m = new(); _camposValores[eq.Id] = m; }
                m[cd.Id] = string.IsNullOrWhiteSpace(valor) ? null : valor;
            }
        }
        catch { }
    }
    // ---- Selector de Campos (Fase 1): columnas dirigidas por unidades-config (entidad 'equipo') ----
    // Reemplaza el gestor propio: orden/visibilidad/alias de las columnas (de sistema y propias) viven
    // en la config compartida por copropiedad; el componente ConfigCamposEntidad las escribe y aqui se
    // leen para pintar la tabla (mismo patron que Unidades/Seguros).
    private bool _selAbierto;
    private Dictionary<string, UnidadCampoConfigDto> _cfgEquipo = new(StringComparer.Ordinal);

    // Catalogo de campos de SISTEMA mapeado a la forma neutra del componente. Las columnas se renderizan
    // por clave con editor fijo: TiposIntercambiables vacio (tipo fijo) + SinFormato.
    private static readonly IReadOnlyList<CampoSistemaDef> EquipoCatalogo =
        EquipoCamposSistema.Todos.Select(c => new CampoSistemaDef(
            c.Clave, c.Label, c.Tipo, c.VisiblePorDefecto, c.Fija,
            OpcionesEditables: false, Semilla: null, Entero: false, Ayuda: null,
            TiposIntercambiables: Array.Empty<TipoCampoTablero>(), ListaExterna: false, SinFormato: true)).ToList();

    // Clave de config de un campo propio (misma convencion que el componente: "cd:{id}").
    private static string ClaveCustom(EquipoCampoDefinicionDto c) => "cd:" + c.Id;
    private static bool EsCustom(string clave) => clave.StartsWith("cd:", StringComparison.Ordinal);
    private EquipoCampoDefinicionDto? CampoCustom(string clave)
        => EsCustom(clave) && Guid.TryParse(clave[3..], out var g) ? _camposDef.FirstOrDefault(c => c.Id == g) : null;

    // Claves candidatas: sistema (orden del catalogo) + propias. Se ordenan y filtran por config.
    private IEnumerable<string> ClavesCandidatas()
        => EquipoCamposSistema.Todos.Select(c => c.Clave).Concat(_camposDef.OrderBy(d => d.Orden).Select(ClaveCustom));
    private bool VisibleColDefault(string clave)
        => EsCustom(clave) || (EquipoCamposSistema.Por(clave)?.VisiblePorDefecto ?? true);
    private bool VisibleCol(string clave)
        => _cfgEquipo.TryGetValue(clave, out var c) ? !c.Oculto : VisibleColDefault(clave);
    private int OrdenCol(string clave, int fallback)
        => _cfgEquipo.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;
    private IEnumerable<string> ClavesOrdenadas()
        => ClavesCandidatas().Select((k, i) => (k, ord: OrdenCol(k, i))).OrderBy(x => x.ord).Select(x => x.k);
    private IEnumerable<string> ColsVisibles() => ClavesOrdenadas().Where(VisibleCol);

    private string ColLabel(string clave)
    {
        if (_cfgEquipo.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias)) return c.Alias!;
        return CampoCustom(clave)?.Label ?? EquipoCamposSistema.Por(clave)?.Label ?? clave;
    }
    private static string ColWidth(string clave) => clave switch
    {
