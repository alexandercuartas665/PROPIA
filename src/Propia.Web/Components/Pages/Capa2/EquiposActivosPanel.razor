    // Redimensionar columnas; el ancho PERSISTE por copropiedad en el JSON de Formato (clave "w").
    private readonly Dictionary<string, int> _colWE = new(StringComparer.Ordinal);
    private DotNetObjectReference<EquiposActivosPanel>? _selfE;
    private async Task IniciarResizeE(MouseEventArgs e, string clave)
    {
        _selfE ??= DotNetObjectReference.Create(this);
