                        default:
                            @* Ficha tecnica (modelo, serie, fechas...): se completa en la ficha tras crear. *@
                            <div class="ea-list-c">-</div>
                            break;
                    }
                }
                <div class="ea-list-act ea-nf-actbtns">
                    <button type="button" class="ea-nf-ok" title="Guardar (Enter)" @onclick="CrearDesdeDraftAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft.Nombre))">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                    </button>
                    <button type="button" class="ea-nf-cancel" title="Cancelar (Esc)" @onclick="CerrarAltaE" disabled="@_busy">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                </div>
                <div class="ea-addcol-cell"></div>
            </div>
            }
            else
            {
            <div class="ea-list-newrow ea-newrow--cta ea-listgrid" style="@EaGridStyle">
                <div class="ea-sel-cell"></div>
                <div class="ea-col-exp"></div>
                <div class="ea-nf-ctacell" style="grid-column: 3 / -1;">
                    <button type="button" class="ea-nf-cta" @onclick="AbrirAltaE">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                        Agregar registro
                    </button>
                </div>
            </div>
            }
            @* Footer canonico: visible SIEMPRE con la tabla, incluso con 0 filas ("Mostrando 0 de 0"). *@
            <TablaPager Total="listaE.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="equipos"
                        PaginaChanged="p => _pagina = p"
                        PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
        </div>
    }

    @* En vista Tabla, la propia tabla (cabecera + fila de alta + footer) comunica el vacio; el
       cartel de vacio solo va en Tarjetas (donde no hay footer). *@
    @if (_view == "cards" && !Filtrados().Any())
    {
        <div class="ea-empty">
            @(HayFiltros ? "Ningun equipo o activo coincide con el filtro." : "Aun no hay equipos ni activos registrados.")
        </div>
    }

    @if (!string.IsNullOrEmpty(_msg)) { <div class="ea-msg @(_msgOk ? "ok" : "bad")">@_msg</div> }
}

@* Selector de Campos (Fase 1): el gestor propio de campos dinamicos se reemplaza por el componente
   compartido. Orden/visibilidad/alias viven en unidades-config (entidad 'equipo'); los campos
   propios en equipos-campos. *@

@* Crear / editar UN campo (modal focalizado, replica de la maqueta). "+" crea; engranaje edita. *@
@if (_crearCampoAbiertoE)
{
    <CrearCampoModal Prefijo="equipos"
                     TituloSingular="equipo"
                     Ejemplo="Ej. Aseguradora, Responsable"
                     Jwt="@_jwt"
                     Editar="_campoAEditarE"
                     TiposAvanzados="false"
                     Guardado="RecargarTrasCrearCampoE"
