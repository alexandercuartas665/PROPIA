    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var cd = CampoCustom(k);
        if (cd is not null) return ValorCampo(e.Id, cd.Id) ?? "";
        return k switch
        {
            "nombre" => e.Nombre ?? "",
            "categoria" => e.Categoria.ToString(),
            "tipo" => e.Tipo.ToString(),
            "cantidad" => e.Cantidad.ToString(ci),
