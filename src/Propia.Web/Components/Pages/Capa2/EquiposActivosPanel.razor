    }
    private Task ResetResizeE(string clave) => OnColResize(clave, 0);
    [JSInvokable]
    public async Task OnColResize(string clave, int width)
    {
        int? w = width <= 0 ? null : Math.Max(70, width);
        if (w is null) _colWE.Remove(clave); else _colWE[clave] = w.Value;
        var fila = FilaConfigE(clave);
        await GuardarCfgEAsync(fila with { Formato = ConAnchoTablaE(fila.Formato, w) });
        await CargarCfgEAsync(); HidratarAnchosE(); StateHasChanged();
    }
    private void HidratarAnchosE()
    {
        _colWE.Clear();
        foreach (var kv in _cfgEquipo) { var w = AnchoDeFormatoTablaE(kv.Value.Formato); if (w is > 0) _colWE[kv.Key] = w.Value; }
    }
    private static int? AnchoDeFormatoTablaE(string? json)
    {
        try { var o = System.Text.Json.Nodes.JsonNode.Parse(json ?? "") as System.Text.Json.Nodes.JsonObject; return o? ["w"]?.GetValue<int>(); }
        catch { return null; }
    }
    private static string? ConAnchoTablaE(string? json, int? w)
    {
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(json) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (w is null) o.Remove("w"); else o["w"] = w.Value;
        return o.Count == 0 ? null : o.ToJsonString();
    }
