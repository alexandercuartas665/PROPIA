                        case "cantidad":
                            <input type="number" min="1" class="ea-row-inp" @bind="_draft.Cantidad" disabled="@(_draft.Tipo == TipoElemento.Equipo)" />
                            break;
                        case "reservable":
                            <select class="ea-row-inp" @onchange="@(e => _draft.EsReservable = e.Value?.ToString() == "true")">
                                <option value="false" selected="@(!_draft.EsReservable)">No</option>
                                <option value="true" selected="@_draft.EsReservable">Si</option>
                            </select>
                            break;
                        case "estado":
                            <div class="ea-list-c">Operativo</div>
