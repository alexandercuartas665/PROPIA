    // Clic en cabecera: opera _sortsE como un unico criterio (reclic invierte, otra columna reemplaza).
    private void OrdenarPorColumnaE(string clave)
    {
        var ex = _sortsE.FirstOrDefault(s => s.Key == clave);
        if (_sortsE.Count == 1 && ex is not null) ex.Dir = -ex.Dir;
        else _sortsE = new() { new TablaOrdenarMenu.Sort { Key = clave, Dir = 1 } };
        _pagina = 1;
    }
