            "fechainstalacion" => e.FechaInstalacion?.ToString("yyyy-MM-dd") ?? "",
            "garantiahasta" => e.GarantiaHasta?.ToString("yyyy-MM-dd") ?? "",
            "fechaadquisicion" => e.FechaAdquisicion?.ToString("yyyy-MM-dd") ?? "",
            _ => ""
        };
