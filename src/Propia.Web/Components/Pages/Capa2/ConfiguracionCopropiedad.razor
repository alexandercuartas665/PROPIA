@page "/configuracion-copropiedad"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@* Hub de Configuracion Copropiedad: reune en pestañas todos los modulos de configuracion de la PH,
   reutilizando cada componente COMPLETO (su tabla, su gestor de campos Fase 2, su toggle). Cada
   modulo vive en un *Panel sin @rendermode (lo hereda de este hub interactivo) y expone un parametro
   Embedded para ocultar su page-head redundante. Las rutas sueltas (/residentes, /vehiculos, ...) y
   los accesos del sidebar siguen existiendo por separado. Solo se monta la pestaña activa. *@

<PageTitle>Configuracion Copropiedad - PROPIA</PageTitle>

<div class="cfg-head">
    <h1 class="cfg-title">Configuracion Copropiedad</h1>
    <p class="cfg-sub">Todo lo que define tu copropiedad, reunido en un solo lugar.</p>
</div>

<div class="cfg-tabs">
    @foreach (var t in Tabs)
    {
        var key = t.Key;
        <button type="button" class="cfg-tab @(_tab == key ? "on" : "")" @onclick="() => _tab = key">
            <i class="fi @t.Icon"></i> <span>@t.Label</span>
        </button>
    }
</div>

<div class="cfg-body">
    @* Solo se monta la pestaña activa (evita cargar los 9 modulos de golpe). Cada modulo carga sus
       datos al montarse, igual que su ruta suelta. *@
    @if (_tab == "general")
    {
        <MiCopropiedadPanel Embedded="true" @key="_tab" />
    }
    else if (_tab == "unidades")
    {
        <DistribucionPanel Embedded="true" @key="_tab" />
    }
    else if (_tab == "residentes")
    {
        <ResidentesPanel Embedded="true" @key="_tab" />
    }
    else if (_tab == "mascotas")
    {
        <MascotasPanel Embedded="true" @key="_tab" />
    }
    else if (_tab == "vehiculos")
    {
        <VehiculosPanel Embedded="true" @key="_tab" />
    }
    else if (_tab == "zonas")
    {
        <ZonasComunesPanel @key="_tab" />
    }
    else if (_tab == "equipos")
    {
        <EquiposActivosPanel @key="_tab" />
    }
    else if (_tab == "usuarios")
    {
        <UsuariosPanel Embedded="true" @key="_tab" />
    }
    else if (_tab == "directorio")
    {
        <DirectorioPanel Embedded="true" @key="_tab" />
    }
</div>

@code {
    private string _tab = "general";

    private sealed record TabDef(string Key, string Label, string Icon);
    private static readonly TabDef[] Tabs =
    {
        new("general", "General", "fi-rr-building"),
        new("unidades", "Unidades", "fi-rr-apps"),
        new("residentes", "Residentes", "fi-rr-users"),
        new("mascotas", "Mascotas", "fi-rr-paw"),
        new("vehiculos", "Vehiculos", "fi-rr-car"),
        new("zonas", "Zonas Comunes", "fi-rr-trees"),
        new("equipos", "Equipos", "fi-rr-settings"),
        new("usuarios", "Usuarios y Roles", "fi-rr-users-alt"),
        new("directorio", "Directorio", "fi-rr-address-book"),
    };
}

<style>
    .cfg-head { margin-bottom: 14px; }
    .cfg-title { font-size: 26px; font-weight: 800; color: var(--propia-text-h1); margin: 0; }
    .cfg-sub { font-size: 13.5px; color: var(--propia-text-muted); margin: 4px 0 0; }

    .cfg-tabs { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--propia-border-card); margin: 0 0 14px; padding: 0 2px; }
    .cfg-tab {
        display: inline-flex; align-items: center; gap: 7px;
        background: none; border: none; cursor: pointer;
        padding: 11px 16px 12px; font-size: 13.5px; font-weight: 600; color: var(--propia-text-muted);
        border-bottom: 2.5px solid transparent; margin-bottom: -1px; font-family: inherit;
        transition: color .15s, border-color .15s; white-space: nowrap;
    }
    .cfg-tab i { font-size: 15px; }
    .cfg-tab:hover { color: var(--propia-brand); }
    .cfg-tab.on { color: var(--propia-brand); border-bottom-color: var(--propia-brand); }
</style>
