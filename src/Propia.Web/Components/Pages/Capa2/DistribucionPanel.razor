    private async Task CargarCamposConfigAsync()
    {
        try
        {
            var list = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config");
            _camposConfig = list?.ToDictionary(x => x.CampoClave, StringComparer.Ordinal) ?? new();
            HidratarAnchos();
        }
        catch { }
    }
    // Hidrata los anchos persistidos (JSON de Formato, clave "w") en el cache _colW.
    private void HidratarAnchos()
    {
        _colW.Clear();
        foreach (var kv in _camposConfig) { var w = AnchoDeFormato(kv.Value.Formato); if (w is > 0) _colW[kv.Key] = w.Value; }
    }

