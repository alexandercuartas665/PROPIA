    // ===== Edicion inline (vista Tabla). El UnidadDto de la lista ya trae todos los campos,
    // asi que se arma el ActualizarUnidadRequest sin traer el detalle. =====
    private async Task GuardarUnidadInline(UnidadDto u, string campo, string? val)
    {
        var v = val?.Trim();
        var numero = u.Numero; var tipo = u.Tipo; var piso = u.Piso;
        var coef = u.CoeficientePropiedad; var area = u.AreaM2;
        var matricula = u.MatriculaInmobiliaria; var refpago = u.ReferenciaPago;
        var tipoCustom = u.TipoCustomId;
        var habitaciones = u.Habitaciones; var banos = u.Banos; var parqueaderos = u.Parqueaderos;
        var estado = u.Estado; var observaciones = u.Observaciones;
        var pagaAdmin = u.PagaAdministracion; var cuota = u.CuotaMensual;
        var mc1 = u.ModuloContributivo1; var mc2 = u.ModuloContributivo2; var mc3 = u.ModuloContributivo3;
        var mc4 = u.ModuloContributivo4; var mc5 = u.ModuloContributivo5;
        switch (campo)
        {
            // Modulos contributivos (1..5): porcentaje decimal, vacio = sin definir.
            case { } k when ModContribNumero(k) is { } n:
                var nuevo = string.IsNullOrWhiteSpace(v) ? (decimal?)null
                    : (decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var mv) ? mv : ModContribValor(u, n));
                if (nuevo == ModContribValor(u, n)) return;
                switch (n) { case 1: mc1 = nuevo; break; case 2: mc2 = nuevo; break; case 3: mc3 = nuevo; break; case 4: mc4 = nuevo; break; default: mc5 = nuevo; break; }
                break;
            case "num": if (string.IsNullOrWhiteSpace(v) || v == u.Numero) return; numero = v; break;
            case "tipo": var (tp, tc) = ParseTipoKey(v); if (tp == u.Tipo && tc == u.TipoCustomId) return; tipo = tp; tipoCustom = tc; break;
            case "piso": var pi = string.IsNullOrWhiteSpace(v) ? (int?)null : (int.TryParse(v, out var pp) ? pp : u.Piso); if (pi == u.Piso) return; piso = pi; break;
            case "coef": if (!decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var cf) || cf == u.CoeficientePropiedad) return; coef = cf; break;
            case "area": var ar = string.IsNullOrWhiteSpace(v) ? (decimal?)null : (decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var aa) ? aa : u.AreaM2); if (ar == u.AreaM2) return; area = ar; break;
            case "matricula": var mt = string.IsNullOrWhiteSpace(v) ? null : v; if (mt == u.MatriculaInmobiliaria) return; matricula = mt; break;
            case "refpago": var rp = v ?? ""; if (rp == (u.ReferenciaPago ?? "")) return; refpago = rp; break;
            case "estado": var es = string.IsNullOrWhiteSpace(v) ? null : v; if (string.Equals(es, u.Estado, StringComparison.Ordinal)) return; estado = es; break;
            case "habitaciones": var hb = string.IsNullOrWhiteSpace(v) ? (int?)null : (int.TryParse(v, out var hh) ? hh : u.Habitaciones); if (hb == u.Habitaciones) return; habitaciones = hb; break;
            case "banos": var bn = string.IsNullOrWhiteSpace(v) ? (int?)null : (int.TryParse(v, out var bb) ? bb : u.Banos); if (bn == u.Banos) return; banos = bn; break;
            case "parqueaderos": var pq = string.IsNullOrWhiteSpace(v) ? (int?)null : (int.TryParse(v, out var qq) ? qq : u.Parqueaderos); if (pq == u.Parqueaderos) return; parqueaderos = pq; break;
            case "pagaadmin": var pa = string.Equals(v, "true", StringComparison.OrdinalIgnoreCase); if (pa == u.PagaAdministracion) return; pagaAdmin = pa; break;
            case "cuota": var cu = string.IsNullOrWhiteSpace(v) ? (decimal?)null : (decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var cc2) ? cc2 : u.CuotaMensual); if (cu == u.CuotaMensual) return; cuota = cu; break;
            case "observaciones": var ob = string.IsNullOrWhiteSpace(v) ? null : v; if (string.Equals(ob, u.Observaciones, StringComparison.Ordinal)) return; observaciones = ob; break;
            default: return;
        }
        var req = new ActualizarUnidadRequest(numero, tipo, piso, coef, area,
            habitaciones, banos, parqueaderos, estado, observaciones,
            matricula, pagaAdmin, cuota, refpago, TipoCustomId: tipoCustom,
            ModuloContributivo1: mc1, ModuloContributivo2: mc2, ModuloContributivo3: mc3,
            ModuloContributivo4: mc4, ModuloContributivo5: mc5);
        try
        {
            var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{u.Id}", req);
            if (r.IsSuccessStatusCode)
            {
                var nombreCustom = tipoCustom is { } cg ? _tiposCustom.FirstOrDefault(x => x.Id == cg)?.Nombre : null;
                var i = _unidades.FindIndex(x => x.Id == u.Id);
                if (i >= 0) _unidades[i] = u with { Numero = numero, Tipo = tipo, TipoCustomId = tipoCustom, TipoCustomNombre = nombreCustom, Piso = piso, CoeficientePropiedad = coef, AreaM2 = area, Habitaciones = habitaciones, Banos = banos, Parqueaderos = parqueaderos, Estado = estado, Observaciones = observaciones, PagaAdministracion = pagaAdmin, CuotaMensual = cuota, MatriculaInmobiliaria = matricula, ReferenciaPago = refpago, ModuloContributivo1 = mc1, ModuloContributivo2 = mc2, ModuloContributivo3 = mc3, ModuloContributivo4 = mc4, ModuloContributivo5 = mc5 };
            }
        }
        catch { }
    }

    private Task Inline(UnidadDto u, string campo, ChangeEventArgs e) => GuardarUnidadInline(u, campo, e.Value?.ToString());

    /// <summary>Valor del modulo contributivo N de una unidad (1..5).</summary>
    private static decimal? ModContribValor(UnidadDto u, int n) => n switch
    {
        1 => u.ModuloContributivo1, 2 => u.ModuloContributivo2, 3 => u.ModuloContributivo3,
        4 => u.ModuloContributivo4, 5 => u.ModuloContributivo5, _ => null
    };

    // ===== Alta inline: crea una unidad desde la fila de alta de la tabla. Si abrir=true, abre la
    // ficha recien creada (para asignar propietario/detalle); si no, la deja resaltada en la lista. =====
    private async Task CrearUnidadDesdeAltaAsync(bool abrir)
    {
        if (_creandoUnidad) return;
        if (string.IsNullOrWhiteSpace(_nuNum)) { _inlineMsgU = "El numero de la unidad es obligatorio."; return; }
        _creandoUnidad = true;
        try
        {
            var ci = System.Globalization.CultureInfo.InvariantCulture;
            int? piso = int.TryParse(_nuPiso, out var pp) ? pp : null;
            // El codigo de la unidad ES su Numero (texto libre): se guarda tal cual lo escribio el usuario.
            var numero = _nuNum.Trim();

            decimal? area = decimal.TryParse(_nuArea, System.Globalization.NumberStyles.Any, ci, out var aa) ? aa : null;
            decimal coef = decimal.TryParse(_nuCoef, System.Globalization.NumberStyles.Any, ci, out var cc) ? cc : 0m;
            var (nuTipo, nuTipoCustom) = ParseTipoKey(_nuTipoKey);
            // Resto de campos de sistema capturados en el alta inline (mismos que en edicion/ficha).
            int? hab = int.TryParse(_nuHab, out var hh) ? hh : null;
            int? banos = int.TryParse(_nuBanos, out var bn) ? bn : null;
            int? parq = int.TryParse(_nuParq, out var pq) ? pq : null;
            string? estado = string.IsNullOrWhiteSpace(_nuEstado) ? null : _nuEstado.Trim();
            string? obs = string.IsNullOrWhiteSpace(_nuObs) ? null : _nuObs.Trim();
            bool pagaAdmin = !string.Equals(_nuPagaAdmin, "false", StringComparison.OrdinalIgnoreCase);
            decimal? cuota = decimal.TryParse(_nuCuota, System.Globalization.NumberStyles.Any, ci, out var cq) ? cq : null;
            decimal? ModAlta(int n) => _nuMod.TryGetValue(n, out var s) && decimal.TryParse(s, System.Globalization.NumberStyles.Any, ci, out var mv) ? mv : null;
            var req = new CrearUnidadRequest(numero, nuTipo, piso, coef, area,
                hab, banos, parq, estado, obs,
                MatriculaInmobiliaria: string.IsNullOrWhiteSpace(_nuMatricula) ? null : _nuMatricula.Trim(),
                PagaAdministracion: pagaAdmin,
                CuotaMensual: cuota,
                ReferenciaPago: string.IsNullOrWhiteSpace(_nuRefPago) ? null : _nuRefPago.Trim(),
                TipoCustomId: nuTipoCustom,
                ModuloContributivo1: ModAlta(1), ModuloContributivo2: ModAlta(2),
                ModuloContributivo3: ModAlta(3), ModuloContributivo4: ModAlta(4),
                ModuloContributivo5: ModAlta(5));
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
            if (resp.IsSuccessStatusCode)
            {
                UnidadDto? creada = null;
                try { creada = await resp.Content.ReadFromJsonAsync<UnidadDto>(); } catch { }
                if (creada is not null)
                {
                    // Persistir los valores de campos dinamicos capturados en la fila de alta.
                    var valsNuevos = new Dictionary<Guid, string?>();
                    foreach (var kv in _nuCampos)
                    {
                        if (string.IsNullOrWhiteSpace(kv.Value)) continue;
                        try { await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{creada.Id}/campos/{kv.Key}", new SetCampoValorRequest(kv.Value)); valsNuevos[kv.Key] = kv.Value; } catch { }
                    }
                    if (valsNuevos.Count > 0) _camposValores[creada.Id] = valsNuevos;  // que las columnas muestren el valor sin recargar
                    // La unidad nace Individual (queda al final, en verde). Convertirla en anexo se hace
                    // luego desde su ficha (modal), no en el alta inline.
                    _unidades.Add(creada);
                    _uniRecienCreados.Add(creada.Id);
                    _inlineMsgU = $"Unidad {creada.Numero} creada.";
                    _nuNum = ""; _nuPiso = ""; _nuArea = ""; _nuCoef = ""; _nuTipoKey = "e:Apartamento"; _nuMatricula = ""; _nuRefPago = ""; _nuCampos.Clear();
                    _nuEstado = ""; _nuHab = ""; _nuBanos = ""; _nuParq = ""; _nuPagaAdmin = "true"; _nuCuota = ""; _nuObs = ""; _nuMod.Clear();
                    _altaAbierta = false;  // la fila nueva se cierra al guardar (vuelve al CTA "Agregar registro")
                    if (abrir) await AbrirModalAsync(creada.Id);
                }
                else { await CargarAsync(); }
            }
            else
            {
                var detalle = await resp.Content.ReadAsStringAsync();
                // El API devuelve { "error": "..." }; mostramos solo el mensaje (ej. "Ya existe la unidad 'X'...").
                string? msg = null;
                try { if (System.Text.Json.JsonDocument.Parse(detalle).RootElement.TryGetProperty("error", out var e)) msg = e.GetString(); } catch { }
                _inlineMsgU = !string.IsNullOrWhiteSpace(msg) ? msg
                    : (string.IsNullOrWhiteSpace(detalle) ? "No se pudo crear la unidad." : $"No se pudo crear: {detalle}");
            }
        }
        catch (Exception ex) { _inlineMsgU = "Error al crear la unidad: " + ex.Message; }
        finally { _creandoUnidad = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jwt is null)
        {
            try
            {
                var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
                _authChecked = true;
                if (!string.IsNullOrWhiteSpace(stored))
                {
                    _jwt = stored;
                    await RestaurarVistaAsync();
                    await RestaurarPrefsAsync();
                    await CargarAsync();
                }
                else
                {
                    Nav.NavigateTo("/login?returnUrl=%2Fdistribucion", true);
                    return;
                }
                StateHasChanged();
            }
            catch { /* prerender */ }
        }

        // Scroll infinito + FAB (solo vista Tabla sin agrupar): (re)instala los observers cuando cambia
        // el lote mostrado, el alta o el total. Sin agrupar se muestra todo (no hay scroll infinito).
        if (_jwt is not null && _vista == "tabla" && _gruposU.Count == 0)
        {
            var sig = $"{_shown}|{_altaAbierta}|{Filtradas.Count}";
            if (sig != _wiredSig)
            {
                _wiredSig = sig;
                _self ??= DotNetObjectReference.Create(this);
                try { await Js.InvokeVoidAsync("propiaUI.dstInfinite", _self, ".dst-scroll.tblscroll"); } catch { }
                // Guardado invisible de la fila de alta (sin ✓/×): activa/desactiva el auto-guardado robusto
                // (clic fuera + Tab fuera; ignora pickers nativos y el panel flotante del selector de persona).
                if (_altaAbierta) { try { await Js.InvokeVoidAsync("propiaUI.altaAutoSave", _self, ".newrow--edit", "AltaBlurGuardar", ".sp-pop"); } catch { } }
                else { try { await Js.InvokeVoidAsync("propiaUI.altaAutoSaveOff"); } catch { } }
            }
        }

        // Scroll al fondo pendiente (FAB "+ Agregar registro"): ya se pintaron todas las filas + la fila
        // de alta, asi que ahora si el fondo es alcanzable.
        if (_scrollBottomPending)
        {
            _scrollBottomPending = false;
            try { await Js.InvokeVoidAsync("propiaUI.dstScrollToCta", ".dst-scroll.tblscroll"); } catch { }
        }
    }

