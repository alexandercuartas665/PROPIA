    }

    // Tipos de unidad ofrecidos en los selectores (se excluye ZonaComun: las zonas comunes son otro modulo).
    // El valor del enum se conserva por compatibilidad de datos historicos.
    private static IEnumerable<TipoUnidad> TiposUnidadSel => Enum.GetValues<TipoUnidad>().Where(t => t != TipoUnidad.ZonaComun);

    // Universo de tipos base que la copropiedad puede ELEGIR: respeta el 'activo' del catalogo global
    // (A&D, unidad.tipo), igual que Estado usa _catEstado. Si el catalogo no cargo (_catTipo vacio) cae
    // al enum completo (fallback). Las unidades que ya usan un tipo desactivado lo conservan via
    // TiposBaseConVigente. NOTA: la validacion de nombre de tipo propio (al crear) sigue usando el enum
    // completo (TiposUnidadSel) para no permitir colisiones con un tipo base aunque este desactivado.
    private IEnumerable<TipoUnidad> TiposBaseUniverso
        => _catTipo.Count > 0 ? TiposUnidadSel.Where(t => _catTipo.ContainsKey("e:" + t)) : TiposUnidadSel;

    // Del catalogo compartido: la plantilla de carga ofrece estas MISMAS etiquetas y el importador
    // las resuelve, asi que lo que el usuario ve aqui es lo que puede escribir en el Excel.
    // Label de un tipo del sistema: el del catalogo global (unidad.tipo, editable por A&D) si cargo;
    // si no, la etiqueta de codigo (fallback). La clave enum no cambia: solo el texto visible.
    private string Etiqueta(TipoUnidad t)
        => _catTipo.TryGetValue("e:" + t, out var l) && !string.IsNullOrWhiteSpace(l) ? l : TiposUnidadCatalogo.Etiqueta(t);
}

