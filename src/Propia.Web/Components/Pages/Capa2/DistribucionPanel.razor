    // copropiedad dentro del JSON de Formato de la config del campo (clave "w"), sin migracion. ----
    private readonly Dictionary<string, int> _colW = new(StringComparer.Ordinal);
    private DotNetObjectReference<DistribucionPanel>? _self;
    private async Task IniciarResize(MouseEventArgs e, string clave)
    {
