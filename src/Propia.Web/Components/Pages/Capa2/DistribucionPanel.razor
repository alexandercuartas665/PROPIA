    // override por copropiedad (unidad_campos_config / tipos propios) se compone encima, como siempre. =====
    private Dictionary<string, string> _catTipo = new(StringComparer.Ordinal);   // "e:<Enum>" -> label global
    private List<CatalogoOpcionDto> _catEstado = new();                          // universo global de estados (label/orden)
    // Universo de estados: el del catalogo si cargo; si no, la semilla de codigo (fallback).
    private IReadOnlyList<string> EstadoUniverso
        => _catEstado.Count > 0 ? _catEstado.Select(o => o.Label).ToList() : EstadoSemilla;

