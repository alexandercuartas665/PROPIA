    private string SortStr(UnidadDto u, string k)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        if (k.StartsWith("cd:", StringComparison.Ordinal) && Guid.TryParse(k[3..], out var g))
        { var cd = _camposDef.FirstOrDefault(c => c.Id == g); return cd is null ? "" : (MostrarCampoCelda(u.Id, cd) ?? ""); }
        return k switch
        {
            "num" => u.Numero ?? "",
            "piso" => u.Piso?.ToString(ci) ?? "",
            "tipo" => EtiquetaU(u),
            "estado" => u.Estado ?? "",
            "area" => u.AreaM2?.ToString(ci) ?? "",
            "coef" => u.CoeficientePropiedad.ToString(ci),
            "matricula" => u.MatriculaInmobiliaria ?? "",
            "refpago" => u.ReferenciaPago ?? "",
            "prop" => u.PropietarioNombre ?? "",
            "habitaciones" => u.Habitaciones?.ToString(ci) ?? "",
            "banos" => u.Banos?.ToString(ci) ?? "",
            "parqueaderos" => u.Parqueaderos?.ToString(ci) ?? "",
            "cuota" => u.CuotaMensual?.ToString(ci) ?? "",
            "observaciones" => u.Observaciones ?? "",
            "agrupacion" => AgrupacionDe(u),
            _ => ""
        };
    }
    // Compara numerico si ambos son numeros; si no, texto (ordinal, ignora mayus/minus).
    private static int CmpVal(string a, string b)
    {
        var na = decimal.TryParse(a, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var da);
        var nb = decimal.TryParse(b, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var db);
        if (na && nb) return da.CompareTo(db);
        if (na) return -1;   // numeros antes que texto
        if (nb) return 1;
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    // ---- Mover columna por ARRASTRE de puntero (JS propiaTablaColReorder; persiste como el menu). ----
    private async Task IniciarReorder(MouseEventArgs e, string clave)
    {
        _self ??= DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _self, clave, e.ClientX, e.ClientY); } catch { }
    }
    [JSInvokable]
    public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        var keys = ColumnasOrdenadas.Select(it => it.Key).ToList();
        var from = keys.IndexOf(src); var to = keys.IndexOf(dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, src);
        // Optimista: aplica el nuevo orden EN MEMORIA y repinta YA (antes se esperaba a persistir las 13
        // columnas + recargar -> segundos de lag que se sentian como "no funciona").
        _ordenLocal = keys.Select((k, i) => (k, i)).ToDictionary(x => x.k, x => x.i);
        StateHasChanged();
        // Persiste en background y luego recarga la config (que ya trae el orden) y suelta el override.
        for (int i = 0; i < keys.Count; i++) await GuardarCampoConfigAsync(FilaConfig(keys[i]) with { Orden = i });
        await CargarCamposConfigAsync();
        _ordenLocal = null;
        StateHasChanged();
    }

