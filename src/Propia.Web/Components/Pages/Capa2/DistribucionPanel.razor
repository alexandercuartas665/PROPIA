@using Propia.Application.MiCopropiedad
@using Propia.Application.Catalogos
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals
@implements IDisposable

@if (!Embedded) { <PageTitle>Unidades Privadas - PROPIA</PageTitle> }

@* Unidades Privadas: modulo propio (antes era la seccion 2 "Distribucion" del acordeon de
   Mi copropiedad). Muestra la composicion de la PH (agrupaciones, unidades, coeficientes) y
   lista todas las unidades en tabla. El detalle y la edicion siguen viviendo en
   GestionarUnidadesModal: la tabla es de consulta y el clic en una fila abre la ficha.
   La ruta sigue siendo /distribucion para no romper enlaces guardados. *@

<div class="dst-pagehead">
    @if (!Embedded)
    {
        <div>
            <h1 class="dst-pagetitle">Unidades Privadas</h1>
            <p class="dst-pagesub">Composicion de @(_resumen?.Identidad.Nombre ?? "la copropiedad") &mdash; unidades con su codigo y coeficiente.</p>
        </div>
    }
    @if (!Embedded && _authChecked && _jwt is not null)
    {
        @* La DESCARGA de la plantilla vive UNICAMENTE en el hub Configuracion Copropiedad
           (componente HubCargaMasiva): se retiro de aqui por pedido de Alex para no duplicar el
           punto de descarga. En la vista Unidades standalone se conserva solo CARGAR (para importar
           una plantilla ya descargada del hub). Dentro del hub (Embedded) tambien se oculta. *@
        <div class="dst-head-actions">
            <button class="propia-btn-brand" type="button" @onclick="AbrirCargaModal" title="Cargar la plantilla Excel: se procesa cada hoja y se muestra el detalle">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V9m0 0l-4 4m4-4l4 4M4 3h16"/></svg>
                Cargar plantilla (Excel)
            </button>
        </div>
    }
</div>

@if (_impResult is not null)
{
    <div class="dst-impres @(_impResult.Aceptado ? "ok" : "err")">
        @if (_impResult.Aceptado)
        {
            <b>Carga completa:</b> <span>@_impResult.UnidadesCreadas unidades creadas (suma de coeficientes @_impResult.SumaCoeficientes.ToString("0.####")%).</span>
        }
        else
        {
            <b>No se pudo cargar la plantilla.</b>
            <ul class="dst-impres-list">@foreach (var er in _impResult.Errores.Take(12)) { <li>@(er.Fila > 0 ? $"Fila {er.Fila} - " : "")@er.Campo: @er.Mensaje</li> }</ul>
        }
        <button type="button" class="dst-impres-x" @onclick="() => _impResult = null" title="Cerrar">&times;</button>
    </div>
}

@* ============ Modal de carga por Excel (seleccion + log detallado por hoja) ============ *@
@if (_showCargaModal)
{
    <div class="cg-back" @onclick="CerrarCargaModal">
        <div class="cg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="cg-head">
                <div>
                    <div class="cg-title">Cargar plantilla (Excel)</div>
                    <div class="cg-sub">Se procesa cada hoja y se muestra el detalle de creados y errores.</div>
                </div>
                <button class="cg-x" type="button" @onclick="CerrarCargaModal" aria-label="Cerrar">&times;</button>
            </div>

            <div class="cg-body">
                @if (_cargaResult is null && !_confirmCarga)
                {
                    @* Paso 1: seleccionar archivo *@
                    <label class="cg-drop">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V9m0 0l-4 4m4-4l4 4M4 3h16"/></svg>
                        <span class="cg-drop-t">@(_cargaFileName ?? "Selecciona el archivo .xlsx")</span>
                        <span class="cg-drop-h">Usa la plantilla descargada. Formato .xlsx</span>
                        <InputFile OnChange="OnFileSelected" accept=".xlsx" style="display:none" disabled="@_cargaBusy" />
                    </label>
                    <div class="cg-note">
                        Al procesar: las <b>unidades</b> existentes se <b>actualizan</b>; personas, vehículos,
                        mascotas, zonas comunes y equipos que traiga el archivo se <b>reemplazan</b> por los del
                        archivo (los actuales de esta copropiedad se retiran; los vehiculos con historial de
                        porteria se conservan como inactivos).
                    </div>
                    <div class="cg-actions">
                        <button class="cg-btn-ghost" type="button" @onclick="CerrarCargaModal" disabled="@_cargaBusy">Cancelar</button>
                        <button class="cg-btn-brand" type="button" @onclick="PedirConfirmacionCarga" disabled="@(_cargaBusy || _cargaBytes is null)">
                            Continuar
                        </button>
                    </div>
                }
                else if (_cargaResult is null && _confirmCarga)
                {
                    @* Paso 1b: confirmacion (reemplazo destructivo de dependientes) *@
                    <div class="cg-confirm">
                        <div class="cg-confirm-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
                        </div>
                        <div class="cg-confirm-title">Confirmar carga con reemplazo</div>
                        <div class="cg-confirm-sub">
                            Vas a procesar <b>@_cargaFileName</b>. Las <b>unidades</b> se actualizan (sin borrar),
                            pero <b>personas, vehículos, mascotas, zonas comunes y equipos</b> que incluya el archivo
                            <b>reemplazan</b> a los actuales de esta copropiedad: los registros vigentes se retiran y
                            se cargan los del archivo (los vehiculos con historial de porteria quedan inactivos).
                            Esta accion <b>no se puede deshacer</b>.
                        </div>
                        <label class="cg-confirm-chk">
                            <input type="checkbox" checked="@_confirmChecked"
                                   @onchange="@(e => _confirmChecked = (bool)(e.Value ?? false))" disabled="@_cargaBusy" />
                            <span>Entiendo que se reemplazaran esas categorías y confirmo la carga.</span>
                        </label>
                        @if (_cargaBusy)
                        {
                            <div class="cg-progress" role="progressbar" aria-label="Procesando la plantilla"><div class="cg-progress-bar"></div></div>
                            <div class="cg-progress-txt">Procesando la plantilla, no cierres esta ventana...</div>
                        }
                        <div class="cg-actions">
                            <button class="cg-btn-ghost" type="button" @onclick="VolverSeleccion" disabled="@_cargaBusy">Volver</button>
                            <button class="cg-btn-danger" type="button" @onclick="EjecutarCargaAsync" disabled="@(_cargaBusy || !_confirmChecked)">
                                @(_cargaBusy ? "Procesando..." : "Reemplazar y cargar")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    @* Paso 2: resultado con log detallado por hoja *@
                    var okTotal = _cargaResult.Errores.Count == 0;
                    <div class="cg-summary @(okTotal ? "ok" : "warn")">
                        @if (okTotal) { <strong>Carga completa sin errores.</strong> }
                        else { <strong>Carga con @_cargaResult.Errores.Count advertencia(s).</strong> }
                        <span>@_cargaResult.Copropiedades copropiedad(es) procesada(s).</span>
                    </div>

                    <table class="cg-tbl">
                        <thead><tr><th>Hoja</th><th>Creados</th><th>Actualizados</th><th>Errores</th></tr></thead>
                        <tbody>
                            @foreach (var f in ResumenHojas())
                            {
                                <tr class="@(f.Errores > 0 ? "cg-row-warn" : "")">
                                    <td>@f.Hoja</td>
                                    <td>@f.Creados</td>
                                    <td>@(f.Actualizados > 0 ? f.Actualizados.ToString() : "-")</td>
                                    <td>@(f.Errores > 0 ? f.Errores.ToString() : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (_cargaResult.Errores.Count > 0)
                    {
                        <div class="cg-log-title">Detalle de errores</div>
                        <div class="cg-log">
                            @foreach (var er in _cargaResult.Errores)
                            {
                                <div class="cg-log-item">
                                    <span class="cg-log-hoja">@er.Hoja</span>
                                    @if (er.Fila > 0) { <span class="cg-log-fila">fila @er.Fila</span> }
                                    <span class="cg-log-msg">@er.Motivo</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="cg-actions">
                        <button class="cg-btn-ghost" type="button" @onclick="ReiniciarCarga">Cargar otro</button>
                        <button class="cg-btn-brand" type="button" @onclick="CerrarCargaModal">Cerrar</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* Crear / editar UN campo (modal focalizado, replica de la maqueta). El "+" del header crea; el
   engranaje de una columna dinamica edita (con Eliminar). La Formula y ajustes avanzados delegan
   en el gestor completo (AbrirGestorAvanzado). *@
@if (_crearCampoAbierto)
{
    <CrearCampoModal Prefijo="unidades"
                     TituloSingular="unidad"
                     Ejemplo="Ej. N de medidor, Color de fachada"
                     Jwt="@_jwt"
                     Editar="_campoAEditar"
                     TiposAvanzados="true"
                     Guardado="RecargarTrasCrearCampo"
                     Cerrado="() => { _crearCampoAbierto = false; _campoAEditar = null; _insertTargetKey = null; }"
                     AbrirGestorAvanzado="AbrirGestorDesdeCrear" />
}

@if (_editSisClave is not null)
{
    <EditarCampoSistemaModal Clave="@_editSisClave" DefLabel="@_editSisLabel" Tipo="_editSisTipo" Requerido="_editSisReq"
                             EntidadConfig="unidad" TituloSingular="unidad" Jwt="@_jwt"
                             OpcionesLista="@(_editSisTipo == TipoCampoTablero.Seleccion ? OpcionesVistaDe(_editSisClave) : null)"
                             OnAgregarOpcion="@((t) => AgregarOpcionDesdeModalAsync(_editSisClave, t))"
                             Guardado="RecargarTrasCrearCampo" Cerrado="() => _editSisClave = null" />
}

@* Menu contextual (clic derecho sobre una fila de la tabla). *@
<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />

@* Menu de columna (estilo Airtable): lo abre la flecha del header de cada columna. Calca de Tareas. *@
<TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" />
@if (_colToast is not null)
{
    <div style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--propia-text-h1);color:var(--propia-text-inverse);padding:8px 16px;border-radius:9px;z-index:5000;font-size:12.5px;cursor:pointer;box-shadow:0 6px 18px rgba(27,42,58,.28);" @onclick="() => _colToast = null">@_colToast</div>
}

@if (_configCamposAbierto)
{
    <div class="cg-back" @onclick="() => _configCamposAbierto = false">
        <div class="cg-modal cg-modal--wide" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="cg-head">
                <div>
                    <div class="cg-title">Configuración avanzada de campos</div>
                    <div class="cg-sub">Orden, visibilidad, tipo y comportamiento de cada campo de la unidad.</div>
                </div>
                <button class="cg-x" type="button" @onclick="() => _configCamposAbierto = false" aria-label="Cerrar">&times;</button>
            </div>
            <div class="cg-body">
                @* Panel de campos de la unidad: usa el componente compartido ConfigCamposEntidad
                   (Fase 0). Estado se administra con el editor interno del componente (opciones +
                   semilla + color); Tipo de unidad delega su lista en el popup de esta pagina (enum
                   TipoUnidad + tipos propios) via OnGestionarLista. *@
                <ConfigCamposEntidad Prefijo="unidades"
                                     EntidadConfig="unidad"
                                     Catalogo="@UnidadCatalogo"
                                     TiposAvanzados="true"
                                     TituloSingular="unidad"
                                     TituloPlural="unidades"
                                     Ejemplo="Ej. N de medidor, Color de fachada"
                                     Jwt="@_jwt"
                                     OnGestionarLista="AbrirEditarCampoSistema"
                                     ContarOpcionesExterna="ContarOpcionesLista"
                                     Cambiado="RecargarCamposTrasComponente" />
            </div>
        </div>

        @* ===== Popup de opciones de una lista del sistema (Tipo / Estado) =====
           Va ENCIMA del modal de configuracion: administrarla aqui evita empujar la grilla hacia
           abajo. Las opciones SEMILLA no se eliminan, se OCULTAN. *@
        @if (_listaAbierta is not null)
        {
            var lk = _listaAbierta;
            var ops = LeerOpciones(lk);
            <div class="cgl-back" @onclick="CerrarLista">
                <div class="cgl-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                    <div class="cg-head">
                        <div>
                            <div class="cg-title">Opciones de @AliasCampo(lk, lk == "tipo" ? "Tipo" : "Estado")</div>
                            <div class="cg-sub">
                                Las opciones de fabrica no se pueden eliminar, pero si ocultar: dejan de ofrecerse
                                sin perder las unidades que ya las usan.
                            </div>
                        </div>
                        <button class="cg-x" type="button" @onclick="CerrarLista" aria-label="Cerrar">&times;</button>
                    </div>
                    <div class="cg-body">
                        <div class="cga-opts-list cgl-list">
                            @for (var i = 0; i < ops.Count; i++)
                            {
                                var idx = i;
                                var op = ops[i];
                                var semilla = EsSemilla(lk, op.K);
                                var usos = UsosDeOpcion(lk, op.K);
                                <div class="cga-opt-row @(op.Oculta ? "cga-opt-row--oculta" : "")">
                                    <div class="cga-opt-move">
                                        <button type="button" class="cga-mini" title="Subir" disabled="@(idx == 0 || _cfgBusy)" @onclick="() => MoverOpcionListaAsync(lk, op.K, -1)">&#9650;</button>
                                        <button type="button" class="cga-mini" title="Bajar" disabled="@(idx == ops.Count - 1 || _cfgBusy)" @onclick="() => MoverOpcionListaAsync(lk, op.K, 1)">&#9660;</button>
                                    </div>
                                    @* Color de la opcion: mismo modelo que OpcionesLista (swatch -> paleta pastel) *@
                                    <div class="ol-sw-wrap">
                                        <button type="button" class="ol-sw" style="background:@(op.Color ?? PaletaChips.Neutro)" title="Color de la opción"
                                                @onclick="() => _palSisIdx = (_palSisIdx == idx ? null : idx)" disabled="@_cfgBusy"></button>
                                        @if (_palSisIdx == idx)
                                        {
                                            <div class="ol-pal-bd" @onclick="() => _palSisIdx = null"></div>
                                            <div class="ol-pal">
                                                @foreach (var c in PaletaChips.ColoresPasteles)
                                                {
                                                    var cc = c;
                                                    <button type="button" class="ol-pal-sw @(string.Equals(op.Color, cc, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                                            style="background:@cc" title="@cc" @onclick="() => SetColorOpcionSistemaAsync(lk, op.K, cc)"></button>
                                                }
                                                <button type="button" class="ol-pal-sw ol-pal-none @(op.Color is null ? "on" : "")" title="Sin color" @onclick="() => SetColorOpcionSistemaAsync(lk, op.K, null)">&times;</button>
                                            </div>
                                        }
                                    </div>
                                    @if (semilla)
                                    {
                                        <svg class="cga-opt-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" title="Opción de fabrica: se puede ocultar, no eliminar"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                                        <span class="cga-opt-name">@EtiquetaOpcion(lk, op.K)</span>
                                    }
                                    else
                                    {
                                        <span class="cga-opt-dot"></span>
                                        <input class="cga-inp cga-opt-inp" value="@EtiquetaOpcion(lk, op.K)" title="Renombrar la opción"
                                               @onchange="@(e => RenombrarOpcionListaAsync(lk, op.K, e.Value?.ToString()))" disabled="@_cfgBusy" />
                                    }
                                    @if (usos > 0) { <span class="cgl-usos" title="@usos unidad(es) usan esta opcion">@usos</span> }
                                    <button type="button" class="cga-eye @(op.Oculta ? "" : "on")"
                                            title="@(op.Oculta ? "Oculta: no se ofrece al elegir" : "Visible")"
                                            @onclick="() => ToggleOcultaOpcionAsync(lk, op.K)" disabled="@_cfgBusy">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    @if (!semilla)
                                    {
                                        <button type="button" class="cga-opt-x" title="Eliminar la opción" @onclick="() => QuitarOpcionListaAsync(lk, op.K)" disabled="@_cfgBusy">&times;</button>
                                    }
                                </div>
                            }
                            <div class="cga-opt-add">
                                <input class="cga-inp" placeholder="Añadir nueva opción..." @bind="_nuevaOpcion" @bind:event="oninput" @onkeyup="OnNuevaOpcionKeyUp" />
                                <button class="cga-add-btn" type="button" @onclick="() => AgregarOpcionListaAsync(lk)" disabled="@(_cfgBusy || string.IsNullOrWhiteSpace(_nuevaOpcion))">Añadir</button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_listaMsg)) { <div class="dst-cfg-msg">@_listaMsg</div> }
                        <div class="cgl-foot">
                            <button class="dst-btn-soft" type="button" @onclick="() => RestaurarListaSemillaAsync(lk)" disabled="@_cfgBusy">Restaurar semilla</button>
                            <button class="dst-btn-soft" type="button" @onclick="CerrarLista">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!_authChecked)
{
    <div class="dst-loading"><div class="spinner-border" style="color: var(--propia-brand, var(--propia-brand));"></div></div>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    @* Filtros. Sin value= en el buscador: Blazor Server lo reafirma en cada re-render y
       se come pulsaciones mientras el round-trip esta en vuelo. *@
    @* Barra de herramientas SIEMPRE visible (canon regla 14): con 0 unidades tambien se ven
       Filtros/Buscar/Agrupar/Campos + el selector Tarjetas/Tabla, para empezar a cargar. *@
        <div class="dst-filtros">
            @* Boton "Filtros" (reglas dinamicas, componente compartido) PRIMERO y luego el buscador,
               orden estandar. Reemplaza los selects sueltos "Todo tipo"/"Toda torre". *@
            <FiltroDinamico @ref="_fd" Campos="CamposFiltroU" OnChanged="@(() => { _pagina = 1; _shown = InfBatch; StateHasChanged(); })" />
            <div class="dst-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input class="dst-search-inp" placeholder="Buscar unidad o propietario..."
                       @oninput="@(e => { _q = e.Value?.ToString() ?? string.Empty; _pagina = 1; _shown = InfBatch; })" />
            </div>
            <div class="dst-filtros-spacer"></div>
            @* Ordenar (multi-criterio apilable): fuente unica compartida. *@
            <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sorts" SortsChanged="OnSortsChanged" />
            @* Agrupar multi-nivel: menu compartido (mismo componente que el resto de modulos del epico). *@
            <TablaAgruparMenu Columnas="ColsAgrupablesU()" Grupos="_gruposU" GruposChanged="OnGruposUChanged" />
            @* Campos: unica entrada a la configuracion. Antes habia dos que se pisaban (este menu,
               que solo hacia orden y visibilidad, y un boton "Configurar" en la cabecera con el
               panel completo). No se limita a la vista tabla porque configura CAMPOS, no solo
               columnas: en Tarjetas tambien hace falta. *@
            @* "Columnas" (inline): orden, visibilidad y borrar campo dinamico. Crear campo nuevo = "+" del header. *@
            <div class="dst-menu-wrap">
                <button type="button" class="dst-fbtn @(_showColMenu ? "on" : "")" @onclick="() => _showColMenu = !_showColMenu" title="Columnas: orden, visibilidad y campos">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                    <span>Columnas</span>
                </button>
                @if (_showColMenu)
                {
                    <div class="dst-menu-bd" @onclick="() => _showColMenu = false"></div>
                    <div class="dst-menu dst-colmenu">
                        <div class="dst-col-search">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                            <input placeholder="Buscar campo..." value="@_colQ" @oninput="@(e => _colQ = e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="dst-col-list">
                            @{ var _cols = ColumnasOrdenadas.ToList(); }
                            @for (int _ci = 0; _ci < _cols.Count; _ci++)
                            {
                                var it = _cols[_ci];
                                var idx = _ci;
                                var label = it.EsCustom ? it.Campo!.Label : Etiqueta(it.Def!);
                                if (!string.IsNullOrWhiteSpace(_colQ) && !label.Contains(_colQ, StringComparison.OrdinalIgnoreCase)) { continue; }
                                var fija = idx == 0;
                                var visible = VisibleDe(it.Key);
                                <div class="dst-col-it">
                                    <button class="dst-col-mv" disabled="@(idx <= 1)" @onclick="() => MoverColumnaAsync(it.Key, -1)">▲</button>
                                    <button class="dst-col-mv" disabled="@(idx == 0 || idx == _cols.Count - 1)" @onclick="() => MoverColumnaAsync(it.Key, 1)">▼</button>
                                    <span class="dst-col-name">@label @if (it.EsCustom) { <span class="dst-col-dyn" title="Campo personalizado">din</span> }</span>
                                    @if (fija) { <span class="dst-col-fija">fija</span> }
                                    else
                                    {
                                        <button class="dst-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => ToggleVisibleColAsync(it.Key)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                    }
                                    @if (it.EsCustom) { <button class="dst-col-del" title="Eliminar campo (definicion y valores)" @onclick="() => _campoAEliminar = it.Campo"><i class="fi fi-rr-trash"></i></button> }
                                </div>
                            }
                        </div>
                        <div class="dst-col-massacts">
                            <button type="button" class="dst-col-mass" @onclick="OcultarTodasColAsync"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                            <button type="button" class="dst-col-mass" @onclick="MostrarTodasColAsync"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                            <button type="button" class="dst-col-reset" @onclick="RestablecerColAsync">Restablecer</button>
                        </div>
                    </div>
                }
            </div>
            @* Toggle Lista/Tabla, igual que en los demas modulos: la seleccion se recuerda por
               modulo (propia_view_unidades) y sobrevive al cierre de sesion. *@
            <div class="dst-viewtoggle">
                @* Orden y nomenclatura estandar del sistema: Tarjetas primero, Tabla despues. *@
                <button type="button" class="dst-vt @(_vista == "lista" ? "on" : "")" @onclick='() => SetVista("lista")' title="Tarjetas">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    Tarjetas
                </button>
                <button type="button" class="dst-vt @(_vista == "tabla" ? "on" : "")" @onclick='() => SetVista("tabla")' title="Tabla">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                    Tabla
                </button>
            </div>
        </div>

    @* Barra de seleccion multiple (estandar): aparece al haber filas marcadas. *@
    @if (_sel.Count > 0 && (_vista == "tabla" || _unidades.Count == 0))
    {
        <div class="dst-selbar">
            <span class="dst-selbar-n">@_sel.Count seleccionada@(_sel.Count == 1 ? "" : "s")</span>
            <button type="button" class="dst-selbar-del" @onclick="() => _confirmDelSel = true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                Eliminar
            </button>
            <button type="button" class="dst-selbar-x" @onclick="LimpiarSel">Deseleccionar</button>
        </div>
    }
    @if (_confirmDelSel)
    {
        <div class="dst-cfg-back" @onclick="() => { if (!_delBusy) _confirmDelSel = false; }">
            <div class="dst-cfg" style="width:440px" @onclick:stopPropagation="true">
                <div class="dst-cfg-head"><strong>Eliminar @_sel.Count unidad@(_sel.Count == 1 ? "" : "es")</strong></div>
                <div class="dst-cfg-sub">Esta accion elimina las unidades seleccionadas de forma permanente y no se puede deshacer. Los anexos y datos asociados tambien se veran afectados.</div>
                <div class="dst-cfg-actions">
                    <button type="button" class="dst-fbtn" @onclick="() => _confirmDelSel = false" disabled="@_delBusy">Cancelar</button>
                    <button type="button" class="dst-selbar-del" @onclick="EliminarSeleccionadasAsync" disabled="@_delBusy">@(_delBusy ? "Eliminando..." : "Si, eliminar")</button>
                </div>
            </div>
        </div>
    }

    @if (_campoAEliminar is not null)
    {
        <div class="dst-cfg-back" @onclick="() => { if (!_colBusy) _campoAEliminar = null; }">
            <div class="dst-cfg" style="width:440px" @onclick:stopPropagation="true">
                <div class="dst-cfg-head"><strong>Eliminar campo &quot;@_campoAEliminar.Label&quot;</strong></div>
                <div class="dst-cfg-sub">Se elimina la definicion del campo y sus valores en TODAS las unidades. Esta accion no se puede deshacer.</div>
                <div class="dst-cfg-actions">
                    <button type="button" class="dst-fbtn" @onclick="() => _campoAEliminar = null" disabled="@_colBusy">Cancelar</button>
                    <button type="button" class="dst-selbar-del" @onclick="EliminarCampoDinAsync" disabled="@_colBusy">@(_colBusy ? "Eliminando..." : "Si, eliminar campo")</button>
                </div>
            </div>
        </div>
    }

    @if (_unidades.Count > 0 && Filtradas.Count == 0)
    {
        <div class="dst-empty">
            <strong>Ninguna unidad coincide con el filtro.</strong>
            <span>Ajusta la busqueda o limpia los filtros.</span>
        </div>
    }
    else
    {
        <div class="dst-table">
            @* Con cero unidades se muestra igual la tabla (cabecera + fila de alta) para poder
               escribir la primera unidad directo aqui, en vez de un estado vacio sin accion. *@
            @if (_vista == "tabla" || _unidades.Count == 0)
            {
                @* Tabla: primera columna Expandir (hover -> abre ficha) + celdas editables inline.
                   Columnas configurables (mostrar/ocultar/renombrar) y agrupables. *@
                <div class="tblwrap">
                <div class="dst-scroll tblscroll">
                <table class="tbl">
                    <colgroup>
                        <col style="width:38px" /><col style="width:34px" />
                        @foreach (var it in ColumnasVisibles) { <col style="width:@AnchoCol(it)" /> }
                        <col style="width:76px" />
                    </colgroup>
                    <thead>
                        <tr>
                        <th class="tbl-sel"><label class="tbl-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodasSeleccionadas" @onchange="@(e => ToggleSelAll((bool)(e.Value ?? false)))" /></label></th>
                        <th class="tbl-exp"></th>
                        @foreach (var it in ColumnasVisibles)
                        {
                            var itc = it;
                            var clave = itc.Key;
                            var lbl = itc.EsCustom ? itc.Campo!.Label : Etiqueta(itc.Def!);
                            <th class="tbl-th--menu@(itc.EsCustom ? " tbl-th--dyn" : "")" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                                @onmousedown="e => IniciarReorder(e, clave)" @onclick="() => OrdenarPorColumna(clave)">
                                <span class="tbl-th-lbl">@lbl</span>
                                @if (_sortKey == clave) { <span class="tbl-th-arrow">@((MarkupString)(_sortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                                @ChevCol(clave, lbl, itc.EsCustom)
                                <span class="tbl-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResize(clave)" @ondblclick:stopPropagation="true"></span>
                            </th>
                        }
                        <th class="tbl-addcol"><button type="button" class="tbl-addcol-btn" title="Crear campo nuevo (columna)" @onclick="AbrirCrearCampo"><i class="fi fi-rr-plus"></i></button></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in FilasRender())
                    {
                        if (item.EsGrupo)
                        {
                            <tr class="tgrt-hd tgrt-l@(item.Nivel > 2 ? 2 : item.Nivel)"><td colspan="@ColSpanTotal"><span class="tgrt-lead" style="padding-left:@(14 + item.Nivel * 16)px;"><span class="tgrt-tit">@item.GrupoTitulo</span> <span class="tgrt-cnt">@item.GrupoConteo</span></span></td></tr>
                            continue;
                        }
                        var uu = item.Unidad!;
                        <tr class="dst-row--tr @(_sel.Contains(uu.Id) ? "dst-row-sel" : "") @(_uniRecienCreados.Contains(uu.Id) ? "tbl-row-new" : "")" @oncontextmenu="e => AbrirCtx(e, uu)" @oncontextmenu:preventDefault="true">
                            <td class="tbl-sel"><label class="tbl-chk"><input type="checkbox" checked="@_sel.Contains(uu.Id)" @onchange="@(e => ToggleSel(uu.Id, (bool)(e.Value ?? false)))" @onclick:stopPropagation="true" /></label></td>
                            <td class="tbl-exp">
                                <button type="button" class="tbl-exp-btn" title="Abrir la ficha de la unidad" @onclick="() => AbrirFichaAsync(uu)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                </button>
                            </td>
                            @foreach (var it in ColumnasVisibles)
                            {
                                if (it.EsCustom)
                                {
                                    var cdd = it.Campo!;
                                    var raw = ValorCampo(uu.Id, cdd.Id);
                                    switch (cdd.Tipo)
                                    {
                                        case TipoCampoTablero.Seleccion:
                                            <td title="@cdd.Label"><select class="tbl-cell" @onchange="(e) => InlineCampoAsync(uu, cdd, e.Value?.ToString())">
                                                <option value="" selected="@(string.IsNullOrWhiteSpace(raw))">-</option>
                                                @foreach (var o in OpcionCampo.Parse(cdd.Opciones).Where(x => !x.Oculta))
                                                {
                                                    <option value="@o.K" selected="@(string.Equals(raw, o.K, StringComparison.OrdinalIgnoreCase))">@o.K</option>
                                                }
                                            </select></td>
                                            break;
                                        case TipoCampoTablero.Numero:
                                        case TipoCampoTablero.Moneda:
                                            <td title="@cdd.Label"><input class="tbl-cell tbl-cell-num" type="number" step="any" value="@raw" placeholder="-" @onchange="(e) => InlineCampoAsync(uu, cdd, e.Value?.ToString())" /></td>
                                            break;
                                        case TipoCampoTablero.Fecha:
                                            <td title="@cdd.Label"><input class="tbl-cell" type="date" value="@raw" @onchange="(e) => InlineCampoAsync(uu, cdd, e.Value?.ToString())" /></td>
                                            break;
                                        case TipoCampoTablero.Booleano:
                                            <td title="@cdd.Label"><select class="tbl-cell" @onchange="(e) => InlineCampoAsync(uu, cdd, e.Value?.ToString())">
                                                <option value="" selected="@(string.IsNullOrWhiteSpace(raw))">-</option>
                                                <option value="Si" selected="@(raw == "Si")">Si</option>
                                                <option value="No" selected="@(raw == "No")">No</option>
                                            </select></td>
                                            break;
                                        case TipoCampoTablero.Formula:
                                            @* Calculado y de solo lectura: se computa en el backend. *@
                                            <td class="nf-mut" title="Se calcula automaticamente">@MostrarCampoCelda(uu.Id, cdd)</td>
                                            break;
                                        case TipoCampoTablero.Usuario:
                                            <td title="@cdd.Label"><select class="tbl-cell" @onchange="(e) => InlineCampoAsync(uu, cdd, e.Value?.ToString())">
                                                <option value="" selected="@(string.IsNullOrWhiteSpace(raw))">-</option>
                                                @foreach (var us in _usuariosTenant) { <option value="@us.PersonaId" selected="@(raw == us.PersonaId.ToString())">@us.NombreCompleto</option> }
                                            </select></td>
                                            break;
                                        case TipoCampoTablero.Directorio:
                                            @* El tipo Directorio (persona) se edita desde la ficha: un SelectorPersona por fila
                                               (x279) seria pesado. Aqui se muestra el nombre resuelto. *@
                                            <td class="nf-mut" title="@cdd.Label - Editar desde la ficha">@MostrarCampoCelda(uu.Id, cdd)</td>
                                            break;
                                        default:
                                            <td title="@cdd.Label"><input class="tbl-cell" value="@raw" placeholder="-" @onchange="(e) => InlineCampoAsync(uu, cdd, e.Value?.ToString())" /></td>
                                            break;
                                    }
                                    continue;
                                }
                                switch (it.Def!.Key)
                                {
                                    case "num":
                                        <td><input class="tbl-cell tbl-cell-cod" value="@uu.Numero" @onchange="@(e => Inline(uu, "num", e))" /></td>
                                        break;
                                    case "piso":
                                        <td><input class="tbl-cell tbl-cell-num" type="number" value="@(uu.Piso?.ToString() ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "piso", e))" /></td>
                                        break;
                                    case "tipo":
                                        @* Si el tipo de la unidad quedo oculto se ofrece igual: si no, el select
                                           mostraria otra opcion y al tocar la celda se guardaria un valor que
                                           nadie eligio. *@
                                        <td><select class="tbl-cell" @onchange="@(e => Inline(uu, "tipo", e))">
                                            @foreach (var t in TiposBaseConVigente(uu))
                                            {
                                                <option value="@($"e:{t}")" selected="@(uu.TipoCustomId is null && uu.Tipo == t)">@Etiqueta(t)</option>
                                            }
                                            @{ var tcv = TiposCustomConVigente(uu); }
                                            @if (tcv.Count > 0)
                                            {
                                                <optgroup label="Tipos propios">
                                                    @foreach (var tc in tcv) { <option value="@($"c:{tc.Id}")" selected="@(uu.TipoCustomId == tc.Id)">@tc.Nombre</option> }
                                                </optgroup>
                                            }
                                        </select></td>
                                        break;
                                    case "estado":
                                        <td><select class="tbl-cell" @onchange="@(e => Inline(uu, "estado", e))">
                                            @foreach (var es in EstadosConVigente(uu.Estado))
                                            {
                                                <option value="@es" selected="@(string.Equals(uu.Estado, es, StringComparison.OrdinalIgnoreCase))">@es</option>
                                            }
                                        </select></td>
                                        break;
                                    case "area":
                                        <td><input class="tbl-cell tbl-cell-num" type="number" step="@PasoDe("area")" value="@NumeroCelda(uu.AreaM2, "area")" placeholder="-" @onchange="@(e => Inline(uu, "area", e))" /></td>
                                        break;
                                    case "coef":
                                        <td><input class="tbl-cell tbl-cell-num" type="number" step="@PasoDe("coef")" value="@NumeroCelda(uu.CoeficientePropiedad, "coef")" @onchange="@(e => Inline(uu, "coef", e))" /></td>
                                        break;
                                    case { } mc when ModContribNumero(mc) is not null:
                                        <td><input class="tbl-cell tbl-cell-num" type="number" step="@PasoDe(mc)" placeholder="-"
                                               value="@NumeroCelda(ModContribValor(uu, ModContribNumero(mc)!.Value), mc)"
                                               @onchange="@(e => Inline(uu, mc, e))" /></td>
                                        break;
                                    case "habitaciones":
                                        <td><input class="tbl-cell tbl-cell-num" type="number" value="@(uu.Habitaciones?.ToString() ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "habitaciones", e))" /></td>
                                        break;
                                    case "banos":
                                        <td><input class="tbl-cell tbl-cell-num" type="number" value="@(uu.Banos?.ToString() ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "banos", e))" /></td>
                                        break;
                                    case "parqueaderos":
                                        <td><input class="tbl-cell tbl-cell-num" type="number" value="@(uu.Parqueaderos?.ToString() ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "parqueaderos", e))" /></td>
                                        break;
                                    case "pagaadmin":
                                        <td><select class="tbl-cell" @onchange="@(e => Inline(uu, "pagaadmin", e))">
                                            <option value="true" selected="@(uu.PagaAdministracion)">Si</option>
                                            <option value="false" selected="@(!uu.PagaAdministracion)">No</option>
                                        </select></td>
                                        break;
                                    case "cuota":
                                        <td><input class="tbl-cell tbl-cell-num" type="number" step="@PasoDe("cuota")" value="@NumeroCelda(uu.CuotaMensual, "cuota")" placeholder="-" @onchange="@(e => Inline(uu, "cuota", e))" /></td>
                                        break;
                                    case "observaciones":
                                        <td><input class="tbl-cell" type="@TipoInput("observaciones")" maxlength="@MaxDe("observaciones")" value="@(uu.Observaciones ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "observaciones", e))" /></td>
                                        break;
                                    case "agrupacion":
                                        @* Solo lectura: la agrupacion (Individual / Principal) es derivada y los anexos
                                           se gestionan desde la ficha de la unidad (modal), no inline. *@
                                        <td class="tbl-ro" title="Los anexos se gestionan desde la ficha de la unidad">@AgrupacionDe(uu)</td>
                                        break;
                                    case "matricula":
                                        <td><input class="tbl-cell" type="@TipoInput("matricula")" maxlength="@MaxDe("matricula")" value="@(uu.MatriculaInmobiliaria ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "matricula", e))" /></td>
                                        break;
                                    case "refpago":
                                        <td><input class="tbl-cell" type="@TipoInput("refpago")" maxlength="@MaxDe("refpago")" value="@(uu.ReferenciaPago ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "refpago", e))" /></td>
                                        break;
                                    case "prop":
                                        <td>
                                            <div class="tbl-prop">
                                                @if (!string.IsNullOrWhiteSpace(uu.PropietarioNombre))
                                                {
                                                    <span class="tbl-prop-nom">@uu.PropietarioNombre</span>
                                                    @if (uu.PropietariosCount > 1) { <span class="dst-mas" title="@uu.PropietariosCount propietarios">+@(uu.PropietariosCount - 1)</span> }
                                                }
                                                <SelectorPersona Flotante="true" Jwt="@_jwt"
                                                                 Placeholder="@(string.IsNullOrWhiteSpace(uu.PropietarioNombre) ? "Asignar propietario..." : "Cambiar / agregar...")"
                                                                 SeleccionadaChanged="(c) => AsignarPropietarioAsync(uu, c)" />
                                            </div>
                                        </td>
                                        break;
                                }
                            }
                            <td class="tbl-addcol"></td>
                        </tr>
                    }
                    @* Fila de alta inline: crear unidad desde la tabla (como Zonas/Seguros). El propietario
                       se asigna despues en la ficha (expander). El expander de esta fila crea y abre la ficha. *@
                    @if (_altaAbierta)
                    {
                    <tr class="newrow newrow--edit" @onkeydown="OnAltaKeydown">
                        <td class="tbl-sel"></td>
                        <td class="tbl-exp">
                            <button type="button" class="tbl-exp-btn" title="Crear y abrir la ficha con lo escrito" style="opacity:1" @onclick="() => CrearUnidadDesdeAltaAsync(true)" disabled="@_creandoUnidad">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </td>
                        @foreach (var it in ColumnasVisibles)
                        {
                            if (it.EsCustom)
                            {
                                var cdd = it.Campo!;
                                var val = _nuCampos.GetValueOrDefault(cdd.Id);
                                switch (cdd.Tipo)
                                {
                                    case TipoCampoTablero.Seleccion:
                                        <td class="nf-cell"><select class="nf-in" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                            <option value="">- elegir -</option>
                                            @foreach (var o in OpcionCampo.Parse(cdd.Opciones).Where(x => !x.Oculta))
                                            {
                                                <option value="@o.K" style="@(o.Color is null ? null : $"background:{o.Color}")">@o.K</option>
                                            }
                                        </select></td>
                                        break;
                                    case TipoCampoTablero.Numero:
                                    case TipoCampoTablero.Moneda:
                                        <td class="nf-cell"><input class="nf-in" type="number" step="any" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" placeholder="@cdd.Label" /></td>
                                        break;
                                    case TipoCampoTablero.Fecha:
                                        <td class="nf-cell"><input class="nf-in" type="date" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" /></td>
                                        break;
                                    case TipoCampoTablero.Booleano:
                                        <td class="nf-cell"><select class="nf-in" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                            <option value="">- elegir -</option>
                                            <option value="Si">Si</option>
                                            <option value="No">No</option>
                                        </select></td>
                                        break;
                                    case TipoCampoTablero.Formula:
                                        @* Calculado y de solo lectura: no se captura, se computa al guardar/leer. *@
                                        <td class="nf-mut" title="Se calcula automaticamente">(se calcula)</td>
                                        break;
                                    case TipoCampoTablero.Usuario:
                                        <td class="nf-cell"><select class="nf-in" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                            <option value="">- elegir -</option>
                                            @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId">@u.NombreCompleto</option> }
                                        </select></td>
                                        break;
                                    case TipoCampoTablero.Directorio:
                                        <td class="nf-cell"><SelectorPersona Flotante="true" Jwt="@_jwt" Placeholder="Buscar persona..."
                                                         SeleccionadaChanged="(c) => OnDirectorioSel(cdd.Id, c)" /></td>
                                        break;
                                    default:
                                        <td class="nf-cell"><input class="nf-in" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" placeholder="@cdd.Label" /></td>
                                        break;
                                }
                                continue;
                            }
                            switch (it.Def!.Key)
                            {
                                case "num":
                                    <td class="nf-cell"><input class="nf-in" placeholder="A1-202" title="Código de la unidad (texto libre, ej. A1-202). Debe ser único en la copropiedad." @bind="_nuNum" @bind:event="oninput" /></td>
                                    break;
                                case "piso":
                                    <td class="nf-cell"><input class="nf-in nf-in-num" type="number" placeholder="-" @bind="_nuPiso" @bind:event="oninput" /></td>
                                    break;
                                case "tipo":
                                    <td class="nf-cell"><select class="nf-in" @bind="_nuTipoKey">
                                        @foreach (var t in TiposBaseVisibles) { <option value="@($"e:{t}")">@Etiqueta(t)</option> }
                                        @if (TiposCustomVisibles.Count > 0)
                                        {
                                            <optgroup label="Tipos propios">
                                                @foreach (var tc in TiposCustomVisibles) { <option value="@($"c:{tc.Id}")">@tc.Nombre</option> }
                                            </optgroup>
                                        }
                                    </select></td>
                                    break;
                                case "area":
                                    <td class="nf-cell"><input class="nf-in" type="number" step="@PasoDe("area")" placeholder="-" @bind="_nuArea" @bind:event="oninput" /></td>
                                    break;
                                case "coef":
                                    <td class="nf-cell"><input class="nf-in" type="number" step="@PasoDe("coef")" placeholder="0" @bind="_nuCoef" @bind:event="oninput" /></td>
                                    break;
                                case "agrupacion":
                                    @* La unidad nueva nace Individual; para convertirla en anexo se usa su ficha (modal). *@
                                    <td class="nf-mut" title="La unidad nueva nace Individual; conviertela en anexo desde su ficha">Individual</td>
                                    break;
                                case "matricula":
                                    <td class="nf-cell"><input class="nf-in" type="@TipoInput("matricula")" maxlength="@MaxDe("matricula")" placeholder="@AliasCampo("matricula", "Matricula")" @bind="_nuMatricula" @bind:event="oninput" /></td>
                                    break;
                                case "refpago":
                                    <td class="nf-cell"><input class="nf-in" type="@TipoInput("refpago")" maxlength="@MaxDe("refpago")" placeholder="@AliasCampo("refpago", "Ref. pago")" @bind="_nuRefPago" @bind:event="oninput" /></td>
                                    break;
                                case "estado":
                                    <td class="nf-cell"><select class="nf-in" @bind="_nuEstado">
                                        <option value="">- elegir -</option>
                                        @foreach (var es in EstadosConfig()) { <option value="@es">@es</option> }
                                    </select></td>
                                    break;
                                case "habitaciones":
                                    <td class="nf-cell"><input class="nf-in" type="number" placeholder="-" @bind="_nuHab" @bind:event="oninput" /></td>
                                    break;
                                case "banos":
                                    <td class="nf-cell"><input class="nf-in" type="number" placeholder="-" @bind="_nuBanos" @bind:event="oninput" /></td>
                                    break;
                                case "parqueaderos":
                                    <td class="nf-cell"><input class="nf-in" type="number" placeholder="-" @bind="_nuParq" @bind:event="oninput" /></td>
                                    break;
                                case "pagaadmin":
                                    <td class="nf-cell"><select class="nf-in" @bind="_nuPagaAdmin">
                                        <option value="true">Si</option>
                                        <option value="false">No</option>
                                    </select></td>
                                    break;
                                case "cuota":
                                    <td class="nf-cell"><input class="nf-in" type="number" step="@PasoDe("cuota")" placeholder="-" @bind="_nuCuota" @bind:event="oninput" /></td>
                                    break;
                                case "observaciones":
                                    <td class="nf-cell"><input class="nf-in" type="@TipoInput("observaciones")" maxlength="@MaxDe("observaciones")" placeholder="-" @bind="_nuObs" @bind:event="oninput" /></td>
                                    break;
                                case { } mc when ModContribNumero(mc) is not null:
                                    <td class="nf-cell"><input class="nf-in" type="number" step="@PasoDe(mc)" placeholder="-"
                                           value="@(_nuMod.GetValueOrDefault(ModContribNumero(mc)!.Value, string.Empty))"
                                           @onchange="(e) => _nuMod[ModContribNumero(mc)!.Value] = e.Value?.ToString() ?? string.Empty" /></td>
                                    break;
                                default:
                                    <td class="nf-mut" title="Se define en la ficha de la unidad">En la ficha</td>
                                    break;
                            }
                        }
                        @* Guardado invisible: sin ✓/×. Se guarda al salir de la fila (clic fuera) o al terminar
                           el tabulado (Tab tras el ultimo campo); Enter tambien guarda, Esc cancela. Celda de
                           acciones vacia para conservar la alineacion. *@
                        <td class="tbl-addcol"></td>
                    </tr>
                    @* Fila-aviso bajo la fila de alta: recuerda como guardar ahora que no hay boton. *@
                    <tr class="newrow dst-nf-hint">
                        <td class="tbl-sel"></td>
                        <td class="tbl-exp"></td>
                        <td class="dst-nf-hint-cell" colspan="@(ColSpanTotal - 2)">
                            <span class="dst-nf-hint-txt">
                                <kbd class="dst-kbd">Tab</kbd> o clic fuera para guardar la fila
                                <span class="dst-nf-hint-sep">&middot;</span>
                                <kbd class="dst-kbd">Esc</kbd> para cancelar
                            </span>
                        </td>
                    </tr>
                    }
                    else
                    {
                    <tr class="newrow" id="dst-cta-row">
                        <td class="tbl-sel"></td>
                        <td class="tbl-exp"></td>
                        <td colspan="@(ColSpanTotal - 2)">
                            <button type="button" class="row-add--sm" @onclick="AbrirAlta">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                                Agregar registro
                            </button>
                        </td>
                    </tr>
                    }
                    </tbody>
                </table>
                @* Centinela de scroll infinito (div, NO <tr>): dispara CargarMas y controla el FAB. *@
                <div id="dst-inf-bottom" class="tbl-inf-sentinel">
                    @if (_gruposU.Count == 0 && Mostradas < Filtradas.Count) { <span class="tbl-inf-dot"></span> <span>Cargando mas...</span> }
                </div>
                </div>
                <button type="button" class="tbl-fab" hidden="@_ctaVisible" @onclick="FabAgregarAsync" title="Agregar registro">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    Agregar registro
                </button>
                </div>
                @* Footer del scroll infinito: SOLO sin agrupar. Con agrupacion se muestran los grupos
                   completos (sin paginar), asi que el footer no aplica (homogeneo con el resto + skill §14). *@
                @if (_gruposU.Count == 0)
                {
                    <div class="tbl-foot">@Filtradas.Count registros &middot; mostrando @Mostradas</div>
                }
                @if (!string.IsNullOrEmpty(_inlineMsgU)) { <div class="dst-toast" @onclick="() => _inlineMsgU = null">@_inlineMsgU</div> }
            }
            else
            {
                @* Vista Lista: fila compacta y amigable por unidad (icono + numero + torre/piso/tipo
                   + propietario + tags de area y coeficiente). Comparte paginacion con la Tabla. *@
                <div class="dst-lista">
                    @foreach (var item in FilasRender())
                    {
                        if (item.EsGrupo)
                        {
                            <div class="dst-group" style="padding-left:@(16 + item.Nivel * 16)px;"><span class="dst-group-t">@item.GrupoTitulo</span><span class="dst-group-n">@item.GrupoConteo</span></div>
                            continue;
                        }
                        var uu = item.Unidad!;
                        var u = uu;
                        <div class="dst-lrow" @onclick="() => AbrirFichaAsync(uu)" title="Abrir ficha de la unidad">
                            <span class="dst-lav">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-6 9 6v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
                            </span>
                            <span class="dst-lmain">
                                <span class="dst-lnum">@u.Numero</span>
                                <span class="dst-lmeta">@(u.Piso is null ? "" : $"{LabelPisoSingular} {u.Piso} - ")@EtiquetaU(u)</span>
                            </span>
                            <span class="dst-lprop">
                                @if (string.IsNullOrWhiteSpace(u.PropietarioNombre))
                                {
                                    <span class="dst-sin">Sin propietario</span>
                                }
                                else
                                {
                                    <span>@u.PropietarioNombre</span>
                                    @if (u.PropietariosCount > 1)
                                    {
                                        <span class="dst-mas" title="@u.PropietariosCount propietarios">+@(u.PropietariosCount - 1)</span>
                                    }
                                }
                            </span>
                            <span class="dst-ltags">
                                @if (u.AreaM2 is not null)
                                {
                                    <span class="dst-ltag">@($"{u.AreaM2:0.##} m2")</span>
                                }
                                <span class="dst-ltag dst-ltag--coef">Coef @u.CoeficientePropiedad.ToString("0.####")</span>
                            </span>
                            <svg class="dst-lchev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C3D0DD" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                        </div>
                    }
                </div>
            }

            @* Paginacion: SOLO en la vista Lista. La vista Tabla usa scroll infinito (piloto Unidades)
               con su propio footer "N registros - mostrando M". Con agrupacion no se pagina. *@
            @if (_vista != "tabla" && _gruposU.Count == 0)
            {
            <div class="dst-pager">
                <div class="dst-pager-info">
                    Mostrando @(Filtradas.Count == 0 ? 0 : Desde + 1)-@Hasta de @Filtradas.Count unidades
                </div>
                <div class="dst-pager-ctrl">
                    <select class="dst-pager-sel" @onchange="CambiarTamanoPagina">
                        @foreach (var n in TamanosPagina)
                        {
                            <option value="@n" selected="@(n == _porPagina)">@n por pagina</option>
                        }
                    </select>
                    @if (TotalPaginas > 1)
                    {
                        <button class="dst-pager-btn" disabled="@(_pagina <= 1)" @onclick="() => IrAPagina(_pagina - 1)" title="Anterior">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
                        </button>
                        <span class="dst-pager-pos">@_pagina / @TotalPaginas</span>
                        <button class="dst-pager-btn" disabled="@(_pagina >= TotalPaginas)" @onclick="() => IrAPagina(_pagina + 1)" title="Siguiente">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                        </button>
                    }
                </div>
            </div>
            }
        </div>
    }
}


@* Obligatorio en cada pagina que abre modales: IModalService es Scoped por circuit y
   MainLayout vive en otro boundary de render, asi que el host debe estar aqui dentro
   (sin esto el modal se registra pero no se pinta hasta navegar a otra pagina). *@
<ModalHost />

@code {
    // Embebido en el hub de Configuracion: oculta su page-head/PageTitle (conserva las acciones).
    [Parameter] public bool Embedded { get; set; }

    private string? _jwt;
    private bool _authChecked;
    private string? _loadError;

    private ResumenMiCopropiedadDto? _resumen;
    private List<UnidadDto> _unidades = new();
    private List<TipoUnidadCustomDto> _tiposCustom = new();   // tipos propios del tenant (Configurar)

    // Alta inline (crear unidad desde la vista Tabla, como Zonas/Seguros).
    private string _nuNum = "";
    private string _nuPiso = "";
    private string _nuTipoKey = "e:Apartamento";   // "e:<enum>" o "c:<guidCustom>"

    // Etiqueta del tipo de una unidad: nombre propio si tiene TipoCustomId, si no el enum.
    private string EtiquetaU(UnidadDto u) => u.TipoCustomNombre ?? Etiqueta(u.Tipo);
    // Parsea la key del selector de tipo a (enum, customId).
    private (TipoUnidad tipo, Guid? custom) ParseTipoKey(string? key)
    {
        if (!string.IsNullOrEmpty(key) && key.StartsWith("c:") && Guid.TryParse(key[2..], out var g)) return (TipoUnidad.Apartamento, g);
        if (!string.IsNullOrEmpty(key) && key.StartsWith("e:") && Enum.TryParse<TipoUnidad>(key[2..], out var t)) return (t, null);
        return (TipoUnidad.Apartamento, null);
    }
    private string _nuArea = "";
    private string _nuCoef = "";
    private string _nuMatricula = "";
    private string _nuRefPago = "";
    // Resto de campos de sistema capturables en el alta inline (antes solo en la ficha/edicion):
    // estado, habitaciones, banos, parqueaderos, paga admin, cuota, observaciones y modulos contributivos.
    private string _nuEstado = "";          // vacio = sin estado (null)
    private string _nuHab = "";
    private string _nuBanos = "";
    private string _nuParq = "";
    private string _nuPagaAdmin = "true";   // "Si" por defecto (coincide con el default del request)
    private string _nuCuota = "";
    private string _nuObs = "";
    private readonly Dictionary<int, string> _nuMod = new();  // modcontrib 1..5 -> valor tecleado
    // Campos dinamicos: definiciones (catalogo del tenant) + valores capturados en la fila de alta.
    private List<UnidadCampoDefinicionDto> _camposDef = new();
    private readonly Dictionary<Guid, string?> _nuCampos = new();
    // Valores por unidad (para pintar los campos dinamicos como columnas): unidadId -> (definicionId -> valor).
    private Dictionary<Guid, Dictionary<Guid, string?>> _camposValores = new();
    private string? ValorCampo(Guid unidadId, Guid defId)
        => _camposValores.TryGetValue(unidadId, out var m) && m.TryGetValue(defId, out var v) ? v : null;

    // Fase 2: usuarios del tenant (para el campo tipo Usuario) + mapa id->nombre para el render.
    private List<UsuarioOpc> _usuariosTenant = new();
    private Dictionary<Guid, string> _usuarioNombre = new();
    private sealed record UsuarioOpc(Guid PersonaId, string NombreCompleto, string? Email);

    // Texto a mostrar en la celda de un campo propio: Formula/Numero/... = el valor tal cual (la Formula
    // ya viene computada del backend); Usuario/Directorio = el nombre resuelto por id (no el Guid crudo).
    private string MostrarCampoCelda(Guid unidadId, UnidadCampoDefinicionDto def)
    {
        var v = ValorCampo(unidadId, def.Id);
        if (string.IsNullOrWhiteSpace(v)) return "-";
        if ((def.Tipo == TipoCampoTablero.Usuario || def.Tipo == TipoCampoTablero.Directorio)
            && Guid.TryParse(v, out var g) && _usuarioNombre.TryGetValue(g, out var n))
            return n;
        return v;
    }

    // Color del chip para el valor de un campo Lista (segun la opcion elegida). null = sin color / no aplica.
    private string? ColorCampoCelda(Guid unidadId, UnidadCampoDefinicionDto def)
    {
        if (def.Tipo != TipoCampoTablero.Seleccion) return null;
        var v = ValorCampo(unidadId, def.Id);
        if (string.IsNullOrWhiteSpace(v)) return null;
        return OpcionCampo.Parse(def.Opciones)
            .FirstOrDefault(o => string.Equals(o.K, v, StringComparison.OrdinalIgnoreCase))?.Color;
    }

    // Campo Directorio en la fila de alta: guarda el id de la persona y cachea su nombre para el render.
    private void OnDirectorioSel(Guid defId, Propia.Application.Directorio.PersonaCandidatoDto? c)
    {
        if (c is null) { _nuCampos[defId] = null; return; }
        _nuCampos[defId] = c.PersonaId.ToString();
        _usuarioNombre[c.PersonaId] = c.NombreCompleto;
    }

    // Edicion inline de un campo custom en una fila YA creada: guarda el valor (PUT) y refresca el cache
    // local para que la celda muestre el valor sin recargar. Mismo endpoint que usa el alta.
    private async Task InlineCampoAsync(UnidadDto u, UnidadCampoDefinicionDto def, string? valor)
    {
        var v = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{u.Id}/campos/{def.Id}", new SetCampoValorRequest(v));
            if (resp.IsSuccessStatusCode)
            {
                if (!_camposValores.TryGetValue(u.Id, out var m)) { m = new(); _camposValores[u.Id] = m; }
                m[def.Id] = v;
            }
            else { _inlineMsgU = "No se pudo guardar el campo."; }
        }
        catch (Exception ex) { _inlineMsgU = "Error al guardar el campo: " + ex.Message; }
        StateHasChanged();
    }

    // Propietario inline: asigna la persona elegida (SelectorPersona) como Propietario de la unidad.
    // Reusa la API de miembros de unidad (PersonaId ya resuelto -> no exige documento). Refresca al terminar.
    private async Task AsignarPropietarioAsync(UnidadDto u, Propia.Application.Directorio.PersonaCandidatoDto? c)
    {
        if (c is null) return;
        try
        {
            var req = new AgregarPersonaUnidadRequest("", "", "", null, null, RolUnidadPersona.Propietario, PersonaId: c.PersonaId);
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{u.Id}/personas", req);
            if (resp.IsSuccessStatusCode) { _inlineMsgU = $"Propietario asignado a {u.Numero}."; await CargarAsync(); }
            else { _inlineMsgU = "No se pudo asignar propietario: " + await resp.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { _inlineMsgU = "Error al asignar propietario: " + ex.Message; }
    }

    // Config de campos dinamicos (modal "Configurar", ahora renderizado por ConfigCamposEntidad).
    private bool _configCamposAbierto;
    private bool _cfgBusy;   // lo comparten el guardado de config y el popup de listas (Tipo)

    // Agrupacion derivada: Anexo (es hija), Principal (tiene hijas) o Individual.
    private string AgrupacionDe(UnidadDto u)
        => u.PrincipalId is not null ? "Anexo" : (_unidades.Any(x => x.PrincipalId == u.Id) ? "Principal" : "Individual");

    // Expander de la fila de alta: si esta vacia, abre el modal de creacion; si hay codigo, crea inline y abre la ficha.
    // Al hacer clic en el expansor de la fila de alta: SIEMPRE abrir el modal de creacion (no crear inline).
    private async Task OnExpandNuevaFila() => await AbrirModalAsync(null);
    private bool _creandoUnidad;
    private string? _inlineMsgU;
    private readonly HashSet<Guid> _uniRecienCreados = new();

    // ===== Seleccion multiple + borrado masivo (estandar vista tabla) =====
    private readonly HashSet<Guid> _sel = new();
    private bool _confirmDelSel;   // dialogo de confirmacion del borrado masivo
    private bool _delBusy;
    private void ToggleSel(Guid id, bool on) { if (on) _sel.Add(id); else _sel.Remove(id); }
    private void LimpiarSel() => _sel.Clear();
    private void ToggleSelAll(bool on)
    {
        _sel.Clear();
        if (on) foreach (var it in FilasRender()) if (!it.EsGrupo && it.Unidad is not null) _sel.Add(it.Unidad.Id);
    }
    private bool TodasSeleccionadas
    {
        get { var ids = FilasRender().Where(x => !x.EsGrupo && x.Unidad is not null).Select(x => x.Unidad!.Id).ToList(); return ids.Count > 0 && ids.All(_sel.Contains); }
    }
    private async Task EliminarSeleccionadasAsync()
    {
        if (_sel.Count == 0) return;
        _delBusy = true;
        int ok = 0, fail = 0;
        foreach (var id in _sel.ToList())
        {
            try { var r = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades/{id}"); if (r.IsSuccessStatusCode) ok++; else fail++; }
            catch { fail++; }
        }
        _sel.Clear(); _confirmDelSel = false; _delBusy = false;
        _inlineMsgU = fail == 0 ? $"{ok} unidad(es) eliminada(s)." : $"{ok} eliminada(s), {fail} con error.";
        await CargarAsync();
        StateHasChanged();
    }

    // ===== Alta inline "nace fila" (estandar): boton CTA -> fila nueva editable con Confirmar/Cancelar =====
    private bool _altaAbierta;
    private void AbrirAlta() => _altaAbierta = true;
    private void CerrarAlta() => _altaAbierta = false;

    // FAB "+ Agregar registro": carga TODO el listado (para que el final sea alcanzable con el scroll
    // infinito), abre la fila de alta y marca que hay que bajar al fondo tras el render (OnAfterRenderAsync).
    // Sin cargar todo, el scroll infinito aleja el fondo y no se llega nunca a la fila de alta.
    private bool _scrollBottomPending;
    private void FabAgregarAsync()
    {
        _shown = Filtradas.Count;   // muestra todas: el fondo deja de alejarse
        _altaAbierta = true;
        _scrollBottomPending = true;   // el scroll real se hace en OnAfterRenderAsync (post-render)
        StateHasChanged();
    }
    private async Task OnAltaKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CerrarAlta();
        else if (e.Key == "Enter") await CrearUnidadDesdeAltaAsync(false);
    }

    // Guardado invisible: lo invoca propiaUI.altaAutoSave cuando el foco/clic SALE de la fila de alta
    // (Tab tras el ultimo campo o clic fuera). Con codigo -> crea; vacia -> descarta sin error.
    [JSInvokable] public async Task AltaBlurGuardar()
    {
        if (!_altaAbierta || _creandoUnidad) return;
        if (string.IsNullOrWhiteSpace(_nuNum)) { CerrarAlta(); StateHasChanged(); return; }
        await CrearUnidadDesdeAltaAsync(false);
        StateHasChanged();
    }

    // ===== Menu "Columnas" inline (orden/visibilidad + borrar DIN). Crear campo = "+" del header (gestor completo). =====
    private bool _showColMenu;
    private string _colQ = "";
    private bool _colBusy;
    private UnidadCampoDefinicionDto? _campoAEliminar;
    private async Task ToggleVisibleColAsync(string clave)
    {
        var visible = VisibleDe(clave);
        await GuardarCampoConfigAsync(FilaConfig(clave) with { Oculto = visible });
        await CargarCamposConfigAsync();
        StateHasChanged();
    }
    private async Task MoverColumnaAsync(string clave, int dir)
    {
        var keys = ColumnasOrdenadas.Select(it => it.Key).ToList();
        var i = keys.IndexOf(clave); var j = i + dir;
        if (i <= 0 || j <= 0 || j >= keys.Count) return; // la 1a columna ('num') queda fija
        (keys[i], keys[j]) = (keys[j], keys[i]);
        for (int k = 0; k < keys.Count; k++) await GuardarCampoConfigAsync(FilaConfig(keys[k]) with { Orden = k });
        await CargarCamposConfigAsync();
        StateHasChanged();
    }
    private async Task OcultarTodasColAsync()
    {
        foreach (var it in ColumnasOrdenadas)
        {
            if (!it.EsCustom && !it.Def!.Hideable) continue; // 'num' no se oculta
            await GuardarCampoConfigAsync(FilaConfig(it.Key) with { Oculto = true });
        }
        await CargarCamposConfigAsync(); StateHasChanged();
    }
    private async Task MostrarTodasColAsync()
    {
        foreach (var it in ColumnasOrdenadas) await GuardarCampoConfigAsync(FilaConfig(it.Key) with { Oculto = false });
        await CargarCamposConfigAsync(); StateHasChanged();
    }
    private async Task RestablecerColAsync()
    {
        foreach (var it in ColumnasOrdenadas) await GuardarCampoConfigAsync(FilaConfig(it.Key) with { Oculto = !VisiblePorDefecto(it.Key), Orden = null });
        await CargarCamposConfigAsync(); StateHasChanged();
    }
    private async Task EliminarCampoDinAsync()
    {
        if (_campoAEliminar is null) return;
        _colBusy = true;
        try
        {
            var r = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-campos/{_campoAEliminar.Id}");
            _inlineMsgU = r.IsSuccessStatusCode ? $"Campo \"{_campoAEliminar.Label}\" eliminado." : "No se pudo eliminar el campo.";
            if (r.IsSuccessStatusCode) { await RecargarCamposDefAsync(); await CargarCamposConfigAsync(); }
        }
        catch (Exception ex) { _inlineMsgU = "Error al eliminar el campo: " + ex.Message; }
        _campoAEliminar = null; _colBusy = false; StateHasChanged();
    }

    // ===== Menu de columna (estilo Airtable): la flecha del header abre TablaColMenu y aqui se
    // mapea cada accion a los metodos reales del modulo. Fijas: las que no aplican avisan por toast. =====
    private TablaColMenu? _colMenu;
    private double _colMenuX, _colMenuY;
    private string? _colToast;
    private void ColToast(string m) { _colToast = m; }
    private void AbrirColMenu(MouseEventArgs e, string clave, string label, bool dyn)
    {
        _colMenuX = e.ClientX; _colMenuY = e.ClientY;
        _colMenu?.Abrir(new TablaColMenu.Ctx(clave, label, dyn), e.ClientX, e.ClientY);
    }
    // La clave de una columna dinamica es "cd:{guid}"; resuelve su definicion o null si es fija.
    private UnidadCampoDefinicionDto? CampoDeClave(string clave)
        => clave.StartsWith("cd:", StringComparison.Ordinal) && Guid.TryParse(clave[3..], out var g)
            ? _camposDef.FirstOrDefault(c => c.Id == g) : null;
    private async Task OnColAccion((TablaColMenu.Accion Accion, TablaColMenu.Ctx Col) a)
    {
        var (accion, col) = a;
        switch (accion)
        {
            case TablaColMenu.Accion.OrdenarAsc:
                _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = 1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.OrdenarDesc:
                _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = -1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.Editar:
            case TablaColMenu.Accion.Descripcion:
                {
                    var campo = CampoDeClave(col.Key);
                    if (campo is not null) AbrirEditarCampo(campo);
                    else AbrirEditarCampoSistema(col.Key);   // sistema: editor focalizado (alias/descripcion/visibilidad)
                }
                break;
            case TablaColMenu.Accion.CopiarUrl:
                try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}distribucion#campo-{col.Key}"); ColToast("Enlace del campo copiado."); }
                catch { ColToast("No se pudo copiar el enlace."); }
                break;
            case TablaColMenu.Accion.Eliminar:
                {
                    var campo = CampoDeClave(col.Key);
                    if (campo is not null) _campoAEliminar = campo;   // abre el modal de confirmacion existente
                    else ColToast("Los campos del sistema no se eliminan aquí.");
                }
                break;
            case TablaColMenu.Accion.Duplicar:
                {
                    var campo = CampoDeClave(col.Key);
                    if (campo is not null)
                    {
                        var req = new CrearCampoDefinicionRequest(campo.Label + " (copia)", campo.Tipo, campo.Opciones, campo.Descripcion);
                        var r = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades-campos", req);
                        if (r.IsSuccessStatusCode) { await RecargarCamposDefAsync(); await CargarCamposConfigAsync(); ColToast("Campo duplicado."); }
                        else ColToast("No se pudo duplicar el campo.");
                    }
                    else ColToast("Solo se pueden duplicar campos propios.");
                }
                break;
            case TablaColMenu.Accion.InsertarIzq:
            case TablaColMenu.Accion.InsertarDer:
                _insertTargetKey = col.Key;
                _insertSide = accion == TablaColMenu.Accion.InsertarIzq ? -1 : 1;
                _defsAntesInsert = _camposDef.Select(d => d.Id).ToHashSet();
                AbrirCrearCampo();
                break;
            case TablaColMenu.Accion.Ocultar:
                await ToggleVisibleColAsync(col.Key);   // el header solo pinta columnas visibles, asi que aqui oculta
                break;
            case TablaColMenu.Accion.Agrupar:
                {
                    if (col.EsDinamico && col.Key.StartsWith("cd:", StringComparison.Ordinal) && CampoDeClave(col.Key) is not null)
                    { await SetGrupoU(col.Key); break; }
                    var g = col.Key switch { "prop" => "propietario", "estado" => "estado", "tipo" => "tipo", _ => (string?)null };
                    if (g is null) { ColToast("Agrupar por este campo aun no esta disponible."); break; }
                    await SetGrupoU(g);
                }
                break;
            case TablaColMenu.Accion.Filtrar:
                if (_fd is not null && CamposFiltroU.Any(c => c.Key == col.Key))
                    await _fd.AgregarReglaCampo(col.Key);
                else ColToast("Filtrar por este campo aun no esta disponible; usa el boton Filtros.");
                break;
            case TablaColMenu.Accion.TituloIa:
                {
                    var campo = CampoDeClave(col.Key);
                    if (campo is not null)
                    {
                        ColToast("Sugiriendo un título con IA...");
                        var _t = await Propia.Web.Components.Shared.IaCampoTitulo.SugerirAsync(Auth(), "unidades", campo.Label);
                        if (_t.Ok && !string.IsNullOrWhiteSpace(_t.Titulo))
                        {
                            try
                            {
                                var _rr = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-campos/{campo.Id}",
                                    new ActualizarCampoDefinicionRequest(_t.Titulo!, campo.Tipo, campo.Opciones, campo.Orden, campo.Descripcion));
                                if (_rr.IsSuccessStatusCode) { await RecargarCamposDefAsync(); await CargarCamposConfigAsync(); ColToast($"Titulo IA aplicado: {_t.Titulo}"); }
                                else ColToast("No se pudo aplicar el título sugerido.");
                            }
                            catch { ColToast("No se pudo aplicar el título sugerido."); }
                        }
                        else ColToast("La IA no pudo sugerir un título ahora.");
                    }
                    else ColToast("Sugerir título con IA solo aplica a campos propios.");
                }
                break;
            default:
                ColToast("En construcción: " + accion + ".");
                break;
        }
        StateHasChanged();
    }
