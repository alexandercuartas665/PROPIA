    .cg-drop { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; padding: 26px 16px; border: 2px dashed var(--propia-border-input); border-radius: 12px; color: var(--propia-brand, var(--propia-brand)); cursor: pointer; transition: border-color .12s, background .12s; }
