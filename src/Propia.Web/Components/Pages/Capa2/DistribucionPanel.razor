    // Valor de agrupacion de una unidad para una dimension (item+clave -> ValorGrupo), para el motor compartido.
    private IEnumerable<ValorGrupo> ValorGrupoU(UnidadDto u, string clave)
    {
        if (clave.StartsWith("cd:", StringComparison.Ordinal))
        {
            if (CampoDeClave(clave) is UnidadCampoDefinicionDto gcd)
            {
                var val = ValorCampo(u.Id, gcd.Id);
                var t = string.IsNullOrWhiteSpace(val) ? "(Sin dato)" : val!;
                yield return new ValorGrupo(t, t);
            }
            yield break;
        }
        switch (clave)
        {
            case "estado": var es = string.IsNullOrWhiteSpace(u.Estado) ? "Sin estado" : u.Estado!; yield return new ValorGrupo(es, es); break;
            case "tipo": var tp = EtiquetaU(u); yield return new ValorGrupo(tp, tp); break;
            case "propietario": var pr = string.IsNullOrWhiteSpace(u.PropietarioNombre) ? "Sin propietario" : u.PropietarioNombre!; yield return new ValorGrupo(pr, pr); break;
        }
    }

