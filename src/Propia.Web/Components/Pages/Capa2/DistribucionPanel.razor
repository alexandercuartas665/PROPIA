    // ===== Tipo de dato y formato por campo (configurables por copropiedad) =====

    // Tipo que trae de fabrica cada campo del sistema.
    private static TipoCampoTablero TipoSistema(string clave) => clave switch
    {
        "tipo" or "estado" => TipoCampoTablero.Seleccion,
        _ when ModContribNumero(clave) is not null => TipoCampoTablero.Numero,
        "coef" or "area" or "piso" or "habitaciones" or "banos" or "parqueaderos" => TipoCampoTablero.Numero,
        "cuota" => TipoCampoTablero.Moneda,
        "pagaadmin" => TipoCampoTablero.Booleano,
        "observaciones" => TipoCampoTablero.AreaTexto,
        _ => TipoCampoTablero.Texto
    };

    private static readonly TipoCampoTablero[] TiposTexto =
        { TipoCampoTablero.Texto, TipoCampoTablero.AreaTexto, TipoCampoTablero.Telefono, TipoCampoTablero.Email, TipoCampoTablero.Url };
    private static readonly TipoCampoTablero[] TiposNumericos = { TipoCampoTablero.Numero, TipoCampoTablero.Moneda };

    // El tipo efectivo de un campo (override del tenant o el de fabrica). Lo usa la tabla/alta/ficha.
    private TipoCampoTablero TipoEfectivo(string clave)
        => _camposConfig.TryGetValue(clave, out var c) && c.Tipo is { } t ? t : TipoSistema(clave);

    // ===== Formato de presentacion (JSON simple guardado en la config del campo) =====
    private sealed record FormatoCampo(int? Dec = null, bool Miles = false, string? Moneda = null, int? Max = null);

    private static FormatoCampo FormatoPorDefecto(string clave) => clave switch
    {
        // Los modulos contributivos son porcentajes como el coeficiente: misma precision.
        _ when ModContribNumero(clave) is not null => new FormatoCampo(Dec: 4),
        "coef" => new FormatoCampo(Dec: 4),
        "area" => new FormatoCampo(Dec: 2),
        "cuota" => new FormatoCampo(Dec: 0, Miles: true, Moneda: "COP"),
        "piso" or "habitaciones" or "banos" or "parqueaderos" => new FormatoCampo(Dec: 0),
        _ => new FormatoCampo()
    };

    private FormatoCampo FormatoDe(string clave)
    {
        if (_camposConfig.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Formato))
        {
            try { return System.Text.Json.JsonSerializer.Deserialize<FormatoCampo>(c.Formato!) ?? FormatoPorDefecto(clave); }
            catch { }
        }
        return FormatoPorDefecto(clave);
    }

    // Cola de escrituras de configuracion: garantiza que cada cambio parta del estado ya guardado.
    private Task _cfgCola = Task.CompletedTask;
    private Task EnCola(Func<Task> accion)
    {
        var anterior = _cfgCola;
        _cfgCola = Ejecutar();
        return _cfgCola;
        async Task Ejecutar()
        {
            try { await anterior; } catch { }
            await accion();
        }
    }

    // ===== Aplicacion del formato en la tabla =====
    // 'step' del input numerico segun los decimales configurados.
    private string PasoDe(string clave)
    {
        var d = FormatoDe(clave).Dec ?? 2;
        return d <= 0 ? "1" : "0." + new string('0', d - 1) + "1";
    }
    private int? MaxDe(string clave) => FormatoDe(clave).Max;
    // Valor numerico redondeado a los decimales configurados. Se emite en cultura invariante porque
    // es lo que entiende <input type=number> (el separador de miles NO se aplica en celdas editables:
    // meterlo dentro del input es justo donde se corrompen los datos al re-parsear).
    private string NumeroCelda(decimal? v, string clave)
        => v is null ? "" : Math.Round(v.Value, Math.Clamp(FormatoDe(clave).Dec ?? 2, 0, 6))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
    // Tipo de <input> segun el tipo de dato configurado (texto/email/url/telefono).
    private string TipoInput(string clave) => TipoEfectivo(clave) switch
    {
        TipoCampoTablero.Email => "email",
        TipoCampoTablero.Url => "url",
        TipoCampoTablero.Telefono => "tel",
        _ => "text"
    };
