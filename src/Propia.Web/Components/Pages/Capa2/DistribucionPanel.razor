    .dst-col-search svg { color: var(--propia-text-faint); flex-shrink: 0; }
    .dst-col-search input { border: 0; outline: none; background: transparent; padding: 7px 0; font-size: 12.5px; color: var(--propia-text-body); font-family: inherit; width: 100%; }
    .dst-col-list { display: flex; flex-direction: column; max-height: 320px; overflow: auto; }
