    /* Separadores verticales SUTILES SOLO en la cabecera (entre columnas de datos); nada en seleccion/expander/trailing ni en el cuerpo. */
    .dst-head.dst-grid2 > div { border-right: 1px solid var(--propia-border-divider); }
    .dst-head.dst-grid2 > div:first-child, .dst-head.dst-grid2 > div:nth-child(2), .dst-head.dst-grid2 > div:nth-last-child(2), .dst-head.dst-grid2 > div:last-child { border-right: 0; }
