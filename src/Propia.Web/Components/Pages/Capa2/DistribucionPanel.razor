    private List<UnidadDto> Filtradas
    {
        get
        {
            var q = _q.Trim();
            var ci = System.Globalization.CultureInfo.InvariantCulture;
            IEnumerable<UnidadDto> filtradas = _unidades
                .Where(u => u.PrincipalId is null)   // los anexos (parqueaderos/cuartos) se anidan bajo su principal, no van al top-level
                .Where(u => q == ""
                    || u.Numero.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (u.PropietarioNombre ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
                .Where(u => _fd?.Pasa(campo => campo switch
                {
                    "numero" => u.Numero,
                    "tipo" => EtiquetaU(u),
                    "estado" => u.Estado ?? "",
                    "piso" => u.Piso?.ToString() ?? "",
                    "area" => u.AreaM2?.ToString(ci) ?? "",
                    "coef" => u.CoeficientePropiedad.ToString(ci),
                    "propietario" => u.PropietarioNombre ?? "",
                    _ => ""
                }) ?? true);
            // Orden multi-criterio (boton "Ordenar" y clic en header). OrderBy estable conserva el orden natural si no hay sort.
            if (_sorts.Count > 0)
            {
                var cmp = Comparer<UnidadDto>.Create((a, b) =>
                {
                    foreach (var s in _sorts)
                    {
                        var c = CmpVal(SortStr(a, s.Key), SortStr(b, s.Key)) * s.Dir;
                        if (c != 0) return c;
                    }
                    return 0;
                });
                filtradas = filtradas.OrderBy(u => u, cmp);
            }
            // Las unidades recien creadas quedan SIEMPRE al final (verde) hasta el proximo refresco,
            // aunque haya orden/sort activo. OrderBy es estable: el resto conserva su posicion.
            if (_uniRecienCreados.Count > 0)
                filtradas = filtradas.OrderBy(u => _uniRecienCreados.Contains(u.Id) ? 1 : 0);
            return filtradas.ToList();
        }
    }

    private int TotalPaginas => Filtradas.Count == 0 ? 1 : (int)Math.Ceiling(Filtradas.Count / (double)_porPagina);
    private int Desde => (_pagina - 1) * _porPagina;
    private int Hasta => Math.Min(Desde + _porPagina, Filtradas.Count);
    private IEnumerable<UnidadDto> UnidadesPagina => Filtradas.Skip(Desde).Take(_porPagina);

    private void IrAPagina(int p) => _pagina = Math.Clamp(p, 1, TotalPaginas);

