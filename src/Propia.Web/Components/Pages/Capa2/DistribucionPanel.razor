    // ===== Configuracion de columnas (POR COPROPIEDAD, en unidad_campos_config) =====
    // El orden (Orden) y la visibilidad (Oculto) de cada campo se guardan en la config del tenant,
    // ya no en localStorage: lo que configura un administrador lo ve toda la copropiedad.
    // Orden por defecto: TODOS los campos del sistema (mas 'agrupacion' derivado) pueden ser columnas.
    // La 'ubicacion' de un campo = su posicion en este orden (que es el orden de columnas de la tabla).
    // Sale del catalogo UNICO de campos de sistema (Propia.Application.MiCopropiedad.UnidadCamposSistema),
    // el mismo que usan la plantilla de carga y el importador. Antes cada uno tenia su lista y se
    // desalinearon: habia campos activables aqui que la plantilla ni emitia ni sabia importar.
    private static readonly string[] ColDefaultOrder =
        UnidadCamposSistema.Todos.Select(c => c.Clave).ToArray();
    // Claves de los 5 modulos contributivos (coeficientes adicionales por unidad).
    private static readonly string[] ModContribClaves = { "modcontrib1", "modcontrib2", "modcontrib3", "modcontrib4", "modcontrib5" };
    private static int? ModContribNumero(string clave)
        => clave.StartsWith("modcontrib", StringComparison.Ordinal) && int.TryParse(clave[10..], out var n) ? n : null;
    // Columnas visibles por defecto (las demas quedan disponibles pero ocultas hasta que se activen).
    private static readonly HashSet<string> ColVisibleDefault =
        new(UnidadCamposSistema.ClavesVisiblesPorDefecto, StringComparer.Ordinal);

    private sealed record ColDef(string Key, string DefLabel, string Width, bool Hideable);
    // Ancho de cada columna (lo unico que es propio de la tabla: el catalogo compartido no sabe de UI).
    private static readonly Dictionary<string, string> ColAnchos = new(StringComparer.Ordinal)
    {
        // Anchos FIJOS en px. Cada fila (head/dato/alta) es su PROPIA grilla; con fr/minmax + max-content
        // cada fila resolvia distinto (segun su contenido) y se desalineaban a partir de la 4a columna.
        // Con px fijos TODAS comparten el mismo track -> alinean; la grilla crece a su suma y la tabla
        // scrollea en horizontal (no se comprime, no se topan).
        ["num"] = "130px", ["tipo"] = "150px", ["estado"] = "150px",
        ["agrupacion"] = "130px", ["coef"] = "120px",
        ["modcontrib1"] = "160px", ["modcontrib2"] = "160px", ["modcontrib3"] = "160px",
        ["modcontrib4"] = "160px", ["modcontrib5"] = "160px",
        ["area"] = "100px", ["piso"] = "80px", ["habitaciones"] = "100px", ["banos"] = "80px",
        ["parqueaderos"] = "110px", ["matricula"] = "150px", ["refpago"] = "140px",
        ["pagaadmin"] = "110px", ["cuota"] = "140px", ["observaciones"] = "190px",
    };
    // TODOS los campos del sistema son columnas potenciales (mostrar/ocultar/reordenar). Se derivan
    // del catalogo compartido: agregar un campo alli lo hace aparecer aqui, en el panel de Configurar
    // y en la plantilla de carga, sin tres listas que mantener a mano.
    // 'num' es la unica columna fija (no se puede ocultar: identifica la fila).
    private ColDef[] Catalogo => UnidadCamposSistema.Todos
        .Select(c => new ColDef(c.Clave,
            c.Clave == "num" ? "UNIDAD" : c.Encabezado,
            ColAnchos.TryGetValue(c.Clave, out var w) ? w : "1fr",
            Hideable: c.Clave != "num"))
        .ToArray();

    // Catalogo para el componente compartido de campos (Fase 0): mapea el catalogo de sistema de la
    // unidad a la forma neutra que consume ConfigCamposEntidad. El tipo, los enteros y los tipos
    // intercambiables se derivan igual que en la tabla (TipoSistema); Estado usa el editor interno del
    // componente (opciones + semilla + color); Tipo de unidad delega su lista en esta pagina (enum
    // TipoUnidad + tipos propios) via OnGestionarLista, porque su universo de opciones no vive en la
    // config sino en un enum + la tabla de tipos propios.
    private IReadOnlyList<CampoSistemaDef> UnidadCatalogo => UnidadCamposSistema.Todos.Select(c =>
        new CampoSistemaDef(
            Clave: c.Clave,
            Label: c.Label,
            Tipo: TipoSistema(c.Clave),
            VisibleDefault: c.VisiblePorDefecto,
            Fija: c.Clave == "num",
            OpcionesEditables: c.EsLista,
            Semilla: c.Clave == "estado" ? EstadoUniverso.ToArray() : null,
            Entero: c.Clave is "piso" or "habitaciones" or "banos" or "parqueaderos",
            Ayuda: c.Clave switch
            {
                "num" => "Identificador unico de la unidad (TORRE-NUMERO)",
                "agrupacion" => "Segun el codigo / anexos",
                _ => null
            },
            TiposIntercambiables: c.Clave switch
            {
                "area" or "cuota" => TiposNumericos,
                "matricula" or "refpago" or "observaciones" => TiposTexto,
                _ => Array.Empty<TipoCampoTablero>()
            },
            ListaExterna: c.Clave == "tipo",
            SinFormato: c.Clave is "num" or "agrupacion"))
        .ToList();

    // Conteo de opciones de una lista administrada por la pagina (Tipo de unidad), para la pista del
    // componente. Reusa LeerOpciones (misma fuente que el popup).
    private (int Visibles, int Ocultas) ContarOpcionesLista(string clave)
    {
        var ops = LeerOpciones(clave);
        return (ops.Count(o => !o.Oculta), ops.Count(o => o.Oculta));
    }

    // Item unificado de columna: campo del sistema (Def) o campo personalizado (Campo). El orden y la
    // visibilidad de ambos viven en la MISMA config del tenant, asi todo se arrastra junto.
    private sealed record ColItem(string Key, bool EsCustom, ColDef? Def, UnidadCampoDefinicionDto? Campo);
    private static string CampoKey(UnidadCampoDefinicionDto d) => "cd:" + d.Id;
    private static bool EsClaveCustom(string clave) => clave.StartsWith("cd:", StringComparison.Ordinal);

    // Visibilidad: lo guardado por la copropiedad; si el campo no tiene config, su default.
    private static bool VisiblePorDefecto(string clave) => EsClaveCustom(clave) || ColVisibleDefault.Contains(clave);
    private bool VisibleDe(string clave)
        => _camposConfig.TryGetValue(clave, out var c) ? !c.Oculto : VisiblePorDefecto(clave);
    private bool EsVisible(ColDef c) => !c.Hideable || VisibleDe(c.Key);   // 'num' siempre visible
    private bool EsVisibleItem(ColItem it) => it.EsCustom ? VisibleDe(it.Key) : EsVisible(it.Def!);

    // Encabezado de columna: alias de la copropiedad (Configurar) > etiqueta por defecto.
    private string Etiqueta(ColDef c) => AliasCampo(c.Key, c.DefLabel);

    // Orden efectivo: el 'orden' guardado por campo. Los que no lo tienen (todavia nadie los movio)
    // van despues, conservando el orden por defecto del catalogo.
    // Override de orden EN MEMORIA (para reorden optimista por arrastre: repinta ya, persiste en background).
    private Dictionary<string, int>? _ordenLocal;
    private int OrdenDe(string clave, int fallback)
        => _ordenLocal is not null && _ordenLocal.TryGetValue(clave, out var lo) ? lo
           : (_camposConfig.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback);

    // Todas las columnas (sistema + personalizados) en el orden configurado.
    private IEnumerable<ColItem> ColumnasOrdenadas
    {
        get
        {
            var items = new List<ColItem>();
            var bySys = Catalogo.ToDictionary(c => c.Key, StringComparer.Ordinal);
            foreach (var k in ColDefaultOrder) if (bySys.TryGetValue(k, out var c)) items.Add(new ColItem(c.Key, false, c, null));
            foreach (var c in Catalogo) if (!ColDefaultOrder.Contains(c.Key)) items.Add(new ColItem(c.Key, false, c, null));
            foreach (var d in _camposDef) items.Add(new ColItem(CampoKey(d), true, null, d));
            // OrderBy es estable: los que caen en el fallback conservan el orden por defecto.
            return items.Select((it, i) => (it, ord: OrdenDe(it.Key, i))).OrderBy(x => x.ord).Select(x => x.it);
        }
    }
    private IEnumerable<ColItem> ColumnasVisibles => ColumnasOrdenadas.Where(EsVisibleItem);
    private string GridCols => "38px 34px "
