    // Unidades planas mostradas (para seleccionar todo): agrupado = todas; si no, el lote/pagina visible.
    private IEnumerable<UnidadDto> UnidadesMostradas()
        => _gruposU.Count > 0 ? Filtradas : (_vista == "tabla" ? Filtradas.Take(Mostradas) : UnidadesPagina);

    // Entrada a pintar (vista Lista + sel-all): cabecera de grupo (nivel/conteo) o unidad. La vista Tabla
    // usa el render compartido para los grupos; esta secuencia aplana el mismo arbol para Lista.
    private readonly record struct FilaUni(bool EsGrupo, string? GrupoTitulo, int GrupoConteo, int Nivel, UnidadDto? Unidad, bool EsAnexo = false);
    private IEnumerable<FilaUni> FilasRender()
    {
        if (_gruposU.Count == 0)
        {
            var fuente = _vista == "tabla" ? Filtradas.Take(Mostradas) : UnidadesPagina;
            foreach (var u in fuente)
            {
                // Los anexos ya NO se anidan inline en la tabla: se ven/gestionan desde la ficha (modal).
                yield return new FilaUni(false, null, 0, 0, u);
            }
            yield break;
        }
        foreach (var f in AplanarArbol(ArbolGrupos())) yield return f;
    }
    private IEnumerable<FilaUni> AplanarArbol(IReadOnlyList<NodoGrupo<UnidadDto>> nodos)
    {
        foreach (var n in nodos)
        {
            yield return new FilaUni(true, n.Titulo, n.Conteo, n.Nivel, null);
            if (n.EsHoja)
            {
                foreach (var u in n.Filas)
                {
                    yield return new FilaUni(false, null, 0, 0, u);
                }
            }
            else
            {
                foreach (var f in AplanarArbol(n.Subgrupos)) yield return f;
            }
        }
    }

