    {
        EstadoPresupuesto.EnEjecucion => "#1A8754",
        EstadoPresupuesto.Aprobado => "#2563EB",
        EstadoPresupuesto.EnAprobacion => "#B45309",
        EstadoPresupuesto.Cerrado => "#516F90",
        _ => "#7C98B6"
    };
    private static string EstadoBg(EstadoPresupuesto e) => e switch
    {
        EstadoPresupuesto.EnEjecucion => "#E6F6EE",
        EstadoPresupuesto.Aprobado => "#E6F2FB",
        EstadoPresupuesto.EnAprobacion => "#FEF3DC",
        EstadoPresupuesto.Cerrado => "#EEF3F8",
        _ => "#F1F5F9"
    };
    private static string Tint(string? hex) => string.IsNullOrWhiteSpace(hex) ? "#F1F5F9" : "#F5F8FA";

    private class CrearForm
    {
        public string Nombre { get; set; } = $"Presupuesto {DateTime.UtcNow.Year}";
        public DateTime Inicio { get; set; } = new DateTime(DateTime.UtcNow.Year, 1, 1);
        public DateTime Fin { get; set; } = new DateTime(DateTime.UtcNow.Year, 12, 31);
        public bool Catalogo { get; set; } = true;
    }
}
