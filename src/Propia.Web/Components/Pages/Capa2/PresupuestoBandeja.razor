@page "/presupuesto"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Propia.Application.Presupuesto
@using Propia.Application.Cartera
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<PageTitle>Finanzas - PROPIA</PageTitle>

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="fz-wrap">
    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

    <div class="fz-head">
        <h1 class="fz-title">Finanzas</h1>
        <p class="fz-sub">Presupuesto, cuotas y pagos de la copropiedad — el motor financiero operativo.</p>
    </div>

    <div class="fz-tabs">
        @foreach (var t in _tabs)
        {
            var k = t.Key;
            <button class="fz-tab @(_tab == k ? "on" : "")" @onclick="() => _tab = k">@t.Label</button>
        }
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color:#6D4FE3"></div></div>
    }

    @* ===================== TAB RESUMEN ===================== *@
    else if (_tab == "resumen")
    {
        <div class="fz-kpis">
            <div class="fz-kpi">
                <div class="fz-kpi-l">Cuota vigente</div>
                <div class="fz-kpi-v">@(_detalle is not null ? Money(_detalle.CuotaProyectadaPromedioMes) : "—")</div>
                <div class="fz-kpi-s">promedio mensual por unidad</div>
            </div>
            <div class="fz-kpi">
                <div class="fz-kpi-l">Recaudo del mes</div>
                <div class="fz-kpi-v" style="color:#1A8754">@(_recaudo is not null ? _recaudo.PorcentajeRecaudo.ToString("0.0") : "0") %</div>
                <div class="fz-bar"><div class="fz-bar-f" style="width:@((_recaudo?.PorcentajeRecaudo ?? 0).ToString("0", Inv))%;background:linear-gradient(90deg,#22A565,#1A8754)"></div></div>
            </div>
            <div class="fz-kpi">
                <div class="fz-kpi-l">Presupuesto anual</div>
                <div class="fz-kpi-v">@(_activa is not null ? Money(_activa.MontoTotal) : "—")</div>
                <div class="fz-kpi-s">aprobado vigente</div>
            </div>
            <div class="fz-kpi fz-kpi-danger">
                <div class="fz-kpi-l" style="color:#C0383C">Cartera en mora</div>
                <div class="fz-kpi-v" style="color:#C0383C">@(_cartera is not null ? Money(_cartera.Kpis.TotalMoraCop) : "—")</div>
                <div class="fz-kpi-s" style="color:#D98A8C">total adeudado</div>
            </div>
        </div>

        @* Unidades en mora *@
        <div class="fz-card fz-mb">
            <div class="fz-card-head">
                <div class="fz-card-ic" style="background:#FFF5F5;color:#C0383C"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg></div>
                <div class="fz-card-id"><div class="fz-card-t">Unidades en mora</div><div class="fz-card-d">@(_cartera?.UnidadesEnMora.Count ?? 0) unidades con saldo pendiente</div></div>
                <a class="fz-btn fz-btn-soft" href="/cartera">Ver cartera</a>
            </div>
            @if (_cartera is null || _cartera.UnidadesEnMora.Count == 0)
            {
                <div class="fz-empty">Sin unidades en mora. Recaudo al dia.</div>
            }
            else
            {
                <div class="fz-thead">
                    <div class="fz-c fz-c-uni">PROPIETARIO / UNIDAD</div>
                    <div class="fz-c fz-c-dias">DIAS MORA</div>
                    <div class="fz-c fz-c-est">ESTADO</div>
                    <div class="fz-c fz-c-val">SALDO</div>
                </div>
                @foreach (var u in _cartera.UnidadesEnMora.Take(8))
                {
                    <div class="fz-row">
                        <div class="fz-c fz-c-uni">
                            <div class="fz-row-nom">@(string.IsNullOrWhiteSpace(u.PropietarioNombre) ? "Sin propietario" : u.PropietarioNombre)</div>
                            <div class="fz-row-sub">@u.UnidadNumero@(string.IsNullOrWhiteSpace(u.TorreNombre) ? "" : " · " + u.TorreNombre)</div>
                        </div>
                        <div class="fz-c fz-c-dias"><span class="@(u.DiasMora > 90 ? "fz-dias-crit" : "fz-dias")">@u.DiasMora dias</span></div>
                        <div class="fz-c fz-c-est">@if (!string.IsNullOrWhiteSpace(u.EstadoGestionNombre)) { <span class="fz-pill" style="color:@(u.EstadoGestionColor ?? "#516F90");background:@(Tint(u.EstadoGestionColor))">@u.EstadoGestionNombre</span> }</div>
                        <div class="fz-c fz-c-val">@Money(u.SaldoTotal)</div>
                    </div>
                }
            }
        </div>

        <div class="fz-grid-2">
            <div class="fz-card fz-pad">
                <div class="fz-card-t fz-mb2">Ejecucion presupuestal</div>
                <div class="fz-prog-row">
                    <div class="fz-prog-l"><span>Recaudo del mes</span><span style="color:#1A8754">@((_recaudo?.PorcentajeRecaudo ?? 0).ToString("0.0"))%</span></div>
                    <div class="fz-bar fz-bar-lg"><div class="fz-bar-f" style="width:@((_recaudo?.PorcentajeRecaudo ?? 0).ToString("0", Inv))%;background:linear-gradient(90deg,#22A565,#1A8754)"></div></div>
                </div>
                <div class="fz-disp">
                    <span>Esperado del mes</span>
                    <span class="fz-disp-v">@(_recaudo is not null ? Money(_recaudo.Esperado) : "—")</span>
                </div>
                <div class="fz-disp">
                    <span>Recibido</span>
                    <span class="fz-disp-v" style="color:#1A8754">@(_recaudo is not null ? Money(_recaudo.Recibido) : "—")</span>
                </div>
                <div class="fz-disp">
                    <span>Pendiente</span>
                    <span class="fz-disp-v" style="color:#B45309">@(_recaudo is not null ? Money(_recaudo.Pendiente) : "—")</span>
                </div>
            </div>

            <div class="fz-card">
                <div class="fz-card-head"><div class="fz-card-t" style="flex:1">Parametros base</div></div>
                <div class="fz-params">
                    <div class="fz-param"><span>Moneda</span><span>COP — Peso colombiano</span></div>
                    <div class="fz-param"><span>Tasa de mora mensual</span><span>@(_cfg is not null ? _cfg.TasaMoraMensual.ToString("0.0") + "%" : "—")</span></div>
                    <div class="fz-param"><span>Periodo de gracia</span><span>@(_cfg is not null ? _cfg.PeriodoGraciaDias + " dias" : "—")</span></div>
                    <div class="fz-param"><span>Validez paz y salvo</span><span>@(_cfg is not null ? _cfg.ValidezPazSalvoDias + " dias" : "—")</span></div>
                </div>
                <div class="fz-params-foot"><a class="fz-btn fz-btn-ghost fz-w100" href="/cartera">Editar en Cartera</a></div>
            </div>
        </div>
    }

    @* ===================== TAB PRESUPUESTO ===================== *@
    else if (_tab == "presupuesto")
    {
        @if (_detalle is null)
        {
            <div class="fz-card fz-pad fz-empty-cta">
                <div class="fz-empty-t">Sin presupuesto creado</div>
                <div class="fz-empty-s">Crea la primera vigencia para empezar a liquidar cuotas a las unidades.</div>
                <button class="fz-btn fz-btn-primary" @onclick="() => AbrirCrear()"><i class="fi fi-rr-plus"></i>Nuevo presupuesto</button>
            </div>
        }
        else
        {
            var d = _detalle;
            <div class="fz-card fz-mb">
                <div class="fz-vig-head">
                    <div class="fz-vig-id">
                        <div class="fz-vig-top">
                            @if (_presupuestos.Count > 1)
                            {
                                <select class="fz-vig-sel" @onchange="OnSelVigencia">
                                    @foreach (var p in _presupuestos) { <option value="@p.Id" selected="@(p.Id == _selId)">@p.Nombre</option> }
                                </select>
                            }
                            else { <span class="fz-vig-nom">@d.Nombre</span> }
                            <span class="fz-pill" style="color:@EstadoFg(d.Estado);background:@EstadoBg(d.Estado)">@EstadoLabel(d.Estado)</span>
                        </div>
                        <div class="fz-vig-fechas">@d.VigenciaInicio.ToString("d 'de' MMMM yyyy", Es) – @d.VigenciaFin.ToString("d 'de' MMMM yyyy", Es) · solo una vigencia En ejecucion a la vez</div>
                    </div>
                    <div class="fz-vig-acts">
                        @if (d.Estado == EstadoPresupuesto.Borrador)
                        {
                            <button class="fz-btn fz-btn-primary" @onclick="EnviarAprobacion" disabled="@_busy">Enviar a aprobacion<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 18l6-6-6-6"/></svg></button>
                        }
                        else if (d.Estado == EstadoPresupuesto.EnAprobacion)
                        {
                            <button class="fz-btn fz-btn-primary" @onclick="() => _showAprobar = true" disabled="@_busy"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>Aprobar (acta)</button>
                        }
                        else if (d.Estado == EstadoPresupuesto.Aprobado)
                        {
                            <button class="fz-btn fz-btn-green" @onclick="Activar" disabled="@_busy"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z"/></svg>Activar vigencia</button>
                        }
                        else if (d.Estado == EstadoPresupuesto.EnEjecucion)
                        {
                            <button class="fz-btn fz-btn-soft" @onclick="Liquidar" disabled="@_busy"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>Liquidar cuotas del mes</button>
                            <button class="fz-btn fz-btn-ghost" @onclick="Cerrar" disabled="@_busy">Cerrar vigencia</button>
                        }
                        else if (d.Estado == EstadoPresupuesto.Cerrado)
                        {
                            <button class="fz-btn fz-btn-primary" @onclick="() => AbrirCrear()"><i class="fi fi-rr-plus"></i>Nueva vigencia</button>
                        }
                    </div>
                </div>
                <div class="fz-stepper">
                    @foreach (var s in _steps)
                    {
                        var est = EstadoOrden(d.Estado);
                        var done = s.Orden < est;
                        var cur = s.Orden == est;
                        <div class="fz-step">
                            <div class="fz-step-dot @(done ? "done" : cur ? "cur" : "")">
                                @if (done) { <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5 9-11"/></svg> }
                                else if (cur) { <span class="fz-step-pt"></span> }
                            </div>
                            <span class="fz-step-lbl @(done || cur ? "act" : "")">@s.Label</span>
                            @if (s.Orden < 5) { <span class="fz-step-line"></span> }
                        </div>
                    }
                </div>
            </div>

            <div class="fz-grid-rubros">
                <div class="fz-card">
                    <div class="fz-card-head">
                        <span class="fz-card-t" style="flex:1">Rubros presupuestales</span>
                        @if (d.Estado == EstadoPresupuesto.Borrador) { <span class="fz-pill" style="color:#6D4FE3;background:#F1ECFD">Edicion inline · calculo en tiempo real</span> }
                        else { <span class="fz-pill" style="color:#7C98B6;background:#EEF3F8">Solo lectura — @EstadoLabel(d.Estado)</span> }
                    </div>
                    <div class="fz-rub-head">
                        <div style="flex:1">RUBRO</div>
                        <div class="fz-rub-monto">MONTO ANUAL</div>
                        <div class="fz-rub-pct">%</div>
                        <div class="fz-rub-x"></div>
                    </div>
                    @foreach (var r in d.Rubros.OrderBy(x => x.Orden))
                    {
                        var rubro = r;
                        var pct = d.MontoTotal > 0 ? (r.MontoAnual / d.MontoTotal * 100m) : 0m;
                        <div class="fz-rub">
                            <div class="fz-rub-n">
                                <span>@r.Nombre</span>
                                @if (r.EsFondoImprevistos) { <span class="fz-tag-ob">Obligatorio · Ley 675</span> }
                            </div>
                            <div class="fz-rub-monto">
                                @if (d.Estado == EstadoPresupuesto.Borrador)
                                {
                                    <input type="number" step="1000" value="@r.MontoAnual" @onchange="(e) => GuardarRubro(rubro, e)" />
                                }
                                else { <div class="fz-rub-mtxt">@Money(r.MontoAnual)</div> }
                            </div>
                            <div class="fz-rub-pct">@pct.ToString("0.0")%</div>
                            <div class="fz-rub-x">
                                @if (!r.EsFondoImprevistos && d.Estado == EstadoPresupuesto.Borrador)
                                {
                                    <button class="fz-rub-del" title="Eliminar rubro" @onclick="() => EliminarRubro(rubro)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
                                }
                            </div>
                        </div>
                    }
                    @if (d.Estado == EstadoPresupuesto.Borrador)
                    {
                        <div class="fz-rub-add">
                            <input @bind="_rubNombre" @bind:event="oninput" placeholder="Nuevo rubro personalizado" />
                            <input type="number" step="1000" @bind="_rubMonto" placeholder="Monto anual" class="fz-rub-add-m" />
                            <button class="fz-btn fz-btn-primary" @onclick="AgregarRubro" disabled="@(_busy || string.IsNullOrWhiteSpace(_rubNombre))">Agregar</button>
                        </div>
                    }
                    <div class="fz-rub-total"><span style="flex:1">Presupuesto total</span><span>@Money(d.MontoTotal)</span></div>
                </div>

                <div class="fz-side">
                    <div class="fz-cuota-card">
                        <div class="fz-cuota-l">CUOTA PROYECTADA / UNIDAD</div>
                        <div class="fz-cuota-v">@Money(d.CuotaProyectadaPromedioMes)</div>
                        <div class="fz-cuota-s">promedio mensual · recalculo en tiempo real</div>
                    </div>
                    @if (d.CumpleMinimoFondoImprevistos)
                    {
                        <div class="fz-fondo ok"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1A8754" stroke-width="2.4"><path d="M5 12l5 5 9-11"/></svg><div>El <b>Fondo de imprevistos</b> cumple el minimo del <b>1%</b> (Art. 39, Ley 675).</div></div>
                    }
                    else
                    {
                        <div class="fz-fondo warn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B45309" stroke-width="2"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><div>El <b>Fondo de imprevistos</b> esta por debajo del <b>1%</b> del total (Art. 39, Ley 675). Advertencia suave.</div></div>
                    }
                    <div class="fz-card fz-pad">
                        <div class="fz-como-h">COMO SE CREA</div>
                        <div class="fz-como">
                            <div><b>1.</b>Ajusta la estructura de rubros (edicion inline).</div>
                            <div><b>2.</b>Envialo a aprobacion — asamblea o acta manual.</div>
                            <div><b>3.</b>Activa la vigencia: el motor liquida cuotas por unidad.</div>
                            <div><b>4.</b>Liquida cada mes y haz seguimiento del recaudo.</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @* ===================== TAB EJECUCION ===================== *@
    else if (_tab == "ejecucion")
    {
        @if (_detalle is null)
        {
            <div class="fz-card fz-pad fz-empty-cta">
                <div class="fz-empty-t">Sin presupuesto</div>
                <div class="fz-empty-s">Crea y activa una vigencia para hacer seguimiento del gasto.</div>
            </div>
        }
        else
        {
            <div class="fz-ejec-head">
                <div class="fz-ejec-note">Seguimiento operativo del gasto — <b>Presupuestado − Comprometido − Ejecutado = Disponible</b>. No reemplaza la contabilidad.</div>
                <button class="fz-btn fz-btn-primary" @onclick="AbrirGasto"><i class="fi fi-rr-plus"></i>Registrar gasto</button>
            </div>
            <div class="fz-kpis">
                <div class="fz-kpi"><div class="fz-kpi-l">Presupuestado</div><div class="fz-kpi-v">@(_ejec is not null ? Money(_ejec.Presupuestado) : "—")</div></div>
                <div class="fz-kpi"><div class="fz-kpi-l">Comprometido</div><div class="fz-kpi-v" style="color:#B45309">@(_ejec is not null ? Money(_ejec.Comprometido) : "—")</div></div>
                <div class="fz-kpi"><div class="fz-kpi-l">Ejecutado</div><div class="fz-kpi-v" style="color:#6D4FE3">@(_ejec is not null ? Money(_ejec.Ejecutado) : "—")</div></div>
                <div class="fz-kpi"><div class="fz-kpi-l">Disponible</div><div class="fz-kpi-v" style="color:#1A8754">@(_ejec is not null ? Money(_ejec.Disponible) : "—")</div></div>
            </div>
            <div class="fz-card">
                <div class="fz-ejec-thead">
                    <div style="flex:1">RUBRO</div>
                    <div class="fz-ec">PRESUP.</div>
                    <div class="fz-ec">COMPROM.</div>
                    <div class="fz-ec">EJECUTADO</div>
                    <div class="fz-ec">DISPONIBLE</div>
                    <div class="fz-ec-pct">% EJEC.</div>
                </div>
                @if (_ejec is not null)
                {
                    @foreach (var r in _ejec.Rubros)
                    {
                        <div class="fz-ejec-row">
                            <div class="fz-ejec-n">@r.Nombre</div>
                            <div class="fz-ec">@Money(r.Presupuestado)</div>
                            <div class="fz-ec" style="color:#B45309">@Money(r.Comprometido)</div>
                            <div class="fz-ec" style="color:#6D4FE3">@Money(r.Ejecutado)</div>
                            <div class="fz-ec" style="color:@(r.Disponible < 0 ? "#C0383C" : "#1A8754");font-weight:800">@Money(r.Disponible)</div>
                            <div class="fz-ec-pct">
                                <div class="fz-ec-bar"><div class="fz-ec-fill" style="width:@(Math.Min(100, r.PctEjecutado).ToString("0", Inv))%;background:@(r.PctEjecutado > 100 ? "#C0383C" : "#6D4FE3")"></div></div>
                                <span>@r.PctEjecutado.ToString("0")%</span>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }
</div>

@* ===================== Modal crear presupuesto ===================== *@
@if (_showCrear)
{
    <div class="fz-modal-bd" @onclick="() => _showCrear = false">
        <div class="fz-modal" @onclick:stopPropagation="true">
            <div class="fz-modal-head">
                <div class="fz-modal-tt"><div class="fz-modal-h">Nuevo presupuesto</div><div class="fz-modal-s">Define la vigencia anual</div></div>
                <button class="fz-modal-x" @onclick="() => _showCrear = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="fz-modal-body">
                <div class="fz-fld"><label>Nombre</label><input @bind="_crear.Nombre" placeholder="Presupuesto 2026" /></div>
                <div class="fz-grid2">
                    <div class="fz-fld"><label>Inicio vigencia</label><input type="date" @bind="_crear.Inicio" /></div>
                    <div class="fz-fld"><label>Fin vigencia</label><input type="date" @bind="_crear.Fin" /></div>
                </div>
                <label class="fz-check"><input type="checkbox" @bind="_crear.Catalogo" /> Incluir catalogo base de rubros (recomendado)</label>
            </div>
            <div class="fz-modal-foot">
                <div style="flex:1"></div>
                <button class="fz-btn fz-btn-ghost" @onclick="() => _showCrear = false">Cancelar</button>
                <button class="fz-btn fz-btn-primary" @onclick="CrearPresupuesto" disabled="@(_busy || string.IsNullOrWhiteSpace(_crear.Nombre))">@(_busy ? "Creando..." : "Crear presupuesto")</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal aprobar ===================== *@
@if (_showAprobar)
{
    <div class="fz-modal-bd" @onclick="() => _showAprobar = false">
        <div class="fz-modal" @onclick:stopPropagation="true">
            <div class="fz-modal-head">
                <div class="fz-modal-tt"><div class="fz-modal-h">Aprobar presupuesto</div><div class="fz-modal-s">Registra el acta de aprobacion</div></div>
                <button class="fz-modal-x" @onclick="() => _showAprobar = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="fz-modal-body">
                <div class="fz-fld"><label>Tipo de aprobacion</label>
                    <select @bind="_aprobarTipo">
                        <option value="@TipoAprobacion.Manual">Acta manual (Consejo)</option>
                        <option value="@TipoAprobacion.Asamblea">Asamblea</option>
                    </select>
                </div>
                <div class="fz-fld"><label>Fecha del acta</label><input type="date" @bind="_aprobarFecha" /></div>
                <div class="fz-fld"><label>URL del acta (opcional)</label><input @bind="_aprobarActa" placeholder="https://..." /></div>
            </div>
            <div class="fz-modal-foot">
                <div style="flex:1"></div>
                <button class="fz-btn fz-btn-ghost" @onclick="() => _showAprobar = false">Cancelar</button>
                <button class="fz-btn fz-btn-primary" @onclick="Aprobar" disabled="@_busy">@(_busy ? "..." : "Aprobar")</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal registrar gasto ===================== *@
@if (_showGasto && _detalle is not null)
{
    <div class="fz-modal-bd" @onclick="() => _showGasto = false">
        <div class="fz-modal" @onclick:stopPropagation="true">
            <div class="fz-modal-head">
                <div class="fz-modal-tt"><div class="fz-modal-h">Registrar gasto</div><div class="fz-modal-s">Actualiza el ejecutado o el comprometido del rubro</div></div>
                <button class="fz-modal-x" @onclick="() => _showGasto = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="fz-modal-body">
                <div class="fz-fld"><label>Rubro</label>
                    <select @bind="_gastoRubro">
                        @foreach (var r in _detalle.Rubros.OrderBy(x => x.Orden)) { <option value="@r.Id">@r.Nombre</option> }
                    </select>
                </div>
                <div class="fz-grid2">
                    <div class="fz-fld"><label>Tipo</label>
                        <select @bind="_gastoTipo">
                            <option value="@TipoGasto.Ejecutado">Ejecutado (pagado)</option>
                            <option value="@TipoGasto.Comprometido">Comprometido</option>
                        </select>
                    </div>
                    <div class="fz-fld"><label>Fecha</label><input type="date" @bind="_gastoFecha" /></div>
                </div>
                <div class="fz-fld"><label>Monto (COP) *</label><input type="number" step="1000" @bind="_gastoMonto" placeholder="Ej. 4500000" /></div>
                <div class="fz-fld"><label>Descripcion</label><input @bind="_gastoDesc" placeholder="Ej. Factura 8841 - recarga extintores" /></div>
            </div>
            <div class="fz-modal-foot">
                <div style="flex:1"></div>
                <button class="fz-btn fz-btn-ghost" @onclick="() => _showGasto = false">Cancelar</button>
                <button class="fz-btn fz-btn-primary" @onclick="RegistrarGasto" disabled="@(_busy || _gastoMonto is null or <= 0 || _gastoRubro == Guid.Empty)">@(_busy ? "..." : "Registrar")</button>
            </div>
        </div>
    </div>
}
}

