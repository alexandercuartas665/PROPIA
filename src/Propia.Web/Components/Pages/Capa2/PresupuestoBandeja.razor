@code {
    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private string? _jwt;
    private bool _busy;
    private bool _loading = true;
    private string? _msg; private string _msgClass = "alert-info";
    private string _tab = "resumen";

    private List<PresupuestoDto> _presupuestos = new();
    private PresupuestoDto? _activa;
    private Guid? _selId;
    private PresupuestoDetalleDto? _detalle;
    private RecaudoResumenDto? _recaudo;
    private CarteraTableroDto? _cartera;
    private CarteraConfigDto? _cfg;

    private bool _showCrear;
    private CrearForm _crear = new();
    private string _rubNombre = "";
    private decimal? _rubMonto;

    private bool _showAprobar;
    private TipoAprobacion _aprobarTipo = TipoAprobacion.Manual;
    private DateTime _aprobarFecha = DateTime.Today;
    private string? _aprobarActa;

    private EjecucionResumenDto? _ejec;
    private bool _showGasto;
    private Guid _gastoRubro;
    private TipoGasto _gastoTipo = TipoGasto.Ejecutado;
    private decimal? _gastoMonto;
    private string? _gastoDesc;
    private DateTime _gastoFecha = DateTime.Today;

    private record TabDef(string Key, string Label);
    private readonly List<TabDef> _tabs = new() { new("resumen", "Resumen"), new("presupuesto", "Presupuesto"), new("ejecucion", "Ejecucion") };
    private record StepDef(int Orden, string Label);
    private readonly List<StepDef> _steps = new()
    {
        new(1, "Borrador"), new(2, "En aprobacion"), new(3, "Aprobado"), new(4, "En ejecucion"), new(5, "Cerrado")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarAsync();
                _loading = false;
                StateHasChanged();
            }
            else { _loading = false; StateHasChanged(); }
        }
        catch { _loading = false; }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _presupuestos = await http.GetFromJsonAsync<List<PresupuestoDto>>("/api/presupuesto") ?? new();
            _activa = _presupuestos.FirstOrDefault(p => p.Estado == EstadoPresupuesto.EnEjecucion);
            _selId ??= _activa?.Id ?? _presupuestos.FirstOrDefault()?.Id;
            if (_selId is not null)
            {
                _detalle = await http.GetFromJsonAsync<PresupuestoDetalleDto>($"/api/presupuesto/{_selId}");
                try { _ejec = await http.GetFromJsonAsync<EjecucionResumenDto>($"/api/presupuesto/{_selId}/ejecucion"); } catch { }
            }
            if (_activa is not null)
            {
                var hoy = DateOnly.FromDateTime(DateTime.UtcNow);
                try { _recaudo = await http.GetFromJsonAsync<RecaudoResumenDto>($"/api/presupuesto/recaudo?periodo={hoy:yyyy-MM-dd}"); } catch { }
            }
            try { _cartera = await http.GetFromJsonAsync<CarteraTableroDto>("/api/cartera/tablero"); } catch { }
            try { _cfg = await http.GetFromJsonAsync<CarteraConfigDto>("/api/cartera/config"); } catch { }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task Recargar() { await CargarAsync(); StateHasChanged(); }

    private async Task OnSelVigencia(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selId = id;
            _detalle = await Auth().GetFromJsonAsync<PresupuestoDetalleDto>($"/api/presupuesto/{id}");
            try { _ejec = await Auth().GetFromJsonAsync<EjecucionResumenDto>($"/api/presupuesto/{id}/ejecucion"); } catch { _ejec = null; }
        }
    }

    private void AbrirGasto()
    {
        _gastoRubro = _detalle?.Rubros.OrderBy(r => r.Orden).FirstOrDefault()?.Id ?? Guid.Empty;
        _gastoTipo = TipoGasto.Ejecutado; _gastoMonto = null; _gastoDesc = ""; _gastoFecha = DateTime.Today;
        _showGasto = true;
    }

    private async Task RegistrarGasto()
    {
        if (_detalle is null || _gastoRubro == Guid.Empty || _gastoMonto is null or <= 0) return;
        _busy = true; _msg = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/presupuesto/{_detalle.Id}/gastos",
                new RegistrarGastoRequest(_gastoRubro, _gastoTipo, _gastoMonto.Value, string.IsNullOrWhiteSpace(_gastoDesc) ? null : _gastoDesc, DateOnly.FromDateTime(_gastoFecha)));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _showGasto = false;
            _ejec = await Auth().GetFromJsonAsync<EjecucionResumenDto>($"/api/presupuesto/{_detalle.Id}/ejecucion");
        }
        finally { _busy = false; }
    }

    private void AbrirCrear() { _crear = new(); _showCrear = true; }

    private async Task CrearPresupuesto()
    {
        if (string.IsNullOrWhiteSpace(_crear.Nombre)) return;
        _busy = true; _msg = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/presupuesto",
                new CrearPresupuestoRequest(_crear.Nombre.Trim(), DateOnly.FromDateTime(_crear.Inicio), DateOnly.FromDateTime(_crear.Fin), _crear.Catalogo));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            var p = await resp.Content.ReadFromJsonAsync<PresupuestoDto>();
            _showCrear = false;
            _selId = p?.Id;
            _tab = "presupuesto";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task GuardarRubro(RubroDto r, ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, Inv, out var monto)) return;
        var resp = await Auth().PutAsJsonAsync($"/api/presupuesto/rubros/{r.Id}",
            new ActualizarRubroRequest(r.Nombre, monto, r.BaseLiquidacion, r.Activo, r.Orden, r.NotasInternas));
        if (resp.IsSuccessStatusCode) await Recargar();
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    private async Task AgregarRubro()
    {
        if (_detalle is null || string.IsNullOrWhiteSpace(_rubNombre)) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/presupuesto/{_detalle.Id}/rubros",
                new AgregarRubroPersonalizadoRequest(_rubNombre.Trim(), _rubMonto ?? 0, BaseLiquidacion.Coeficiente));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _rubNombre = ""; _rubMonto = null;
            await Recargar();
        }
        finally { _busy = false; }
    }

    private async Task EliminarRubro(RubroDto r)
    {
        var resp = await Auth().DeleteAsync($"/api/presupuesto/rubros/{r.Id}");
        if (resp.IsSuccessStatusCode) await Recargar();
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    private async Task TransicionAsync(string verbo, string path)
    {
        if (_detalle is null) return;
        _busy = true; _msg = null;
        try
        {
            var resp = await Auth().PutAsync($"/api/presupuesto/{_detalle.Id}/{path}", null);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = verbo; _msgClass = "alert-success";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private Task EnviarAprobacion() => TransicionAsync("Presupuesto enviado a aprobacion.", "enviar-aprobacion");
    private Task Activar() => TransicionAsync("Vigencia activada. El motor liquidara cuotas.", "activar");
    private Task Cerrar() => TransicionAsync("Vigencia cerrada.", "cerrar");

    private async Task Aprobar()
    {
        if (_detalle is null) return;
        _busy = true; _msg = null;
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/presupuesto/{_detalle.Id}/aprobar",
                new AprobarPresupuestoRequest(_aprobarTipo, DateOnly.FromDateTime(_aprobarFecha), string.IsNullOrWhiteSpace(_aprobarActa) ? null : _aprobarActa, null));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _showAprobar = false;
            _msg = "Presupuesto aprobado."; _msgClass = "alert-success";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task Liquidar()
    {
        if (_detalle is null) return;
        var hoy = DateTime.UtcNow;
        var periodo = new DateOnly(hoy.Year, hoy.Month, 1);
        if (!await Js.InvokeAsync<bool>("confirm", $"Liquidar las cuotas del periodo {periodo:MMMM yyyy}? El motor es idempotente (no duplica).")) return;
        _busy = true; _msg = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/presupuesto/liquidaciones", new EmitirLiquidacionRequest(_detalle.Id, periodo));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Cuotas liquidadas para el periodo."; _msgClass = "alert-success";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private static string Money(decimal v) => "$ " + Math.Round(v).ToString("N0", Es);
