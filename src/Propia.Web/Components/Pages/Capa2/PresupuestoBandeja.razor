    {
        EstadoPresupuesto.Borrador => "Borrador",
        EstadoPresupuesto.EnAprobacion => "En aprobacion",
        EstadoPresupuesto.Aprobado => "Aprobado",
        EstadoPresupuesto.EnEjecucion => "En ejecucion",
        EstadoPresupuesto.Cerrado => "Cerrado",
        _ => ""
    };
