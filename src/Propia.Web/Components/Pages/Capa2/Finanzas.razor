@page "/finanzas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Nav
<PageTitle>Finanzas - PROPIA</PageTitle>

@* /finanzas es el encabezado del grupo del rail (Presupuesto 2.6 + Cartera 2.7 + Servicios y contratos),
   no un modulo en si: igual que los demas grupos, no tiene pagina propia. Si alguien aterriza en la ruta
   (URL directa o enlace antiguo), lo enviamos al primer modulo del grupo en vez de mostrar un placeholder. *@

@code {
    protected override void OnInitialized() => Nav.NavigateTo("/presupuesto", replace: true);
}
