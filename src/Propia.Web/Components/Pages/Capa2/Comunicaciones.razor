@page "/comunicaciones"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Comunicaciones
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Comunicaciones - PROPIA</PageTitle>

<div class="dst-pagehead">
    <div>
        <h1 class="dst-pagetitle">Comunicaciones</h1>
        <p class="dst-pagesub">Circulares, avisos y anuncios a la comunidad con entrega por WhatsApp</p>
    </div>
    <div class="dst-head-actions">
        <button class="propia-btn-brand" type="button" @onclick="AbrirCrear">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg> Nuevo comunicado
        </button>
    </div>
</div>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

@if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

@* === Barra canonica de la vista tabla (= Unidades): Filtros, Buscar ... Ordenar, Agrupar, Columnas, Descargar === *@
<div class="dst-filtros">
    <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="@(() => { _pagina = 1; StateHasChanged(); })" />
    <div class="dst-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input class="dst-search-inp" placeholder="Buscar por asunto..." @bind="_query"
               @bind:event="oninput" @bind:after="() => _pagina = 1" />
    </div>
    <div class="dst-filtros-spacer"></div>
    <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sorts" SortsChanged="() => { _pagina = 1; StateHasChanged(); }" />
    <TablaAgruparMenu Columnas="ColsAgrupables()" Grupos="_grupos" GruposChanged="OnGruposChanged" />
    <div class="dst-menu-wrap">
        <button type="button" class="dst-fbtn @(_showCampos ? "on" : "")" @onclick="() => _showCampos = !_showCampos" title="Columnas: orden, visibilidad y campos">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
            <span>Columnas</span>
        </button>
        @if (_showCampos)
        {
            <div class="dst-menu-bd" @onclick="() => _showCampos = false"></div>
            <div class="dst-menu dst-colmenu">
                <div class="dst-col-search">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                    <input placeholder="Buscar campo..." @bind="_colQ" @bind:event="oninput" />
                </div>
                <div class="dst-col-list">
                    @for (int i = 0; i < _colOrder.Count; i++)
                    {
                        var idx = i;
                        var col = Catalogo.First(c => c.Key == _colOrder[idx]);
                        var key = col.Key;
                        if (!string.IsNullOrWhiteSpace(_colQ) && !col.Label.Contains(_colQ, StringComparison.OrdinalIgnoreCase)) { continue; }
                        var visible = !_colHidden.Contains(key);
                        <div class="dst-col-it">
                            <button class="dst-col-mv" disabled="@(idx == 0)" @onclick="() => MoverCol(idx, -1)">▲</button>
                            <button class="dst-col-mv" disabled="@(idx == _colOrder.Count - 1)" @onclick="() => MoverCol(idx, 1)">▼</button>
                            <span class="dst-col-name">@col.Label</span>
                            @if (!col.Hideable) { <span class="dst-col-fija">fija</span> }
                            else
                            {
                                <button class="dst-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => SetColVisible(key, !visible)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                            }
                        </div>
                    }
                </div>
                <div class="dst-col-massacts">
                    <button type="button" class="dst-col-mass" @onclick="OcultarTodo"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                    <button type="button" class="dst-col-mass" @onclick="MostrarTodo"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                    <button type="button" class="dst-col-reset" @onclick="RestablecerCol">Restablecer</button>
                </div>
            </div>
        }
    </div>
    <TablaExportar Vista="VistaExport" />
</div>

@if (_lista is null)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-brand);"></div></div>
}
else if (Items.Count > 0 && Filtrados.Count == 0)
{
    <div class="dst-empty">
        <strong>Ningun comunicado coincide con el filtro.</strong>
        <span>Ajusta la busqueda o limpia los filtros.</span>
    </div>
}
else
{
    var cols = ColsVisibles.ToList();
    var niveles = Niveles;
    <div class="dst-table">
        <div class="tblwrap">
        <div class="dst-scroll tblscroll">
        <table class="tbl">
            <colgroup>
                <col style="width:34px" />
                @foreach (var key in cols) { <col style="@ColStyle(key)" /> }
                <col style="width:76px" />
            </colgroup>
            <thead>
                <tr>
                    <th class="tbl-exp"></th>
                    @foreach (var key in cols)
                    {
                        var k = key;
                        <th class="tbl-th--menu" data-clave="@k" title="Clic: ordenar | arrastra: mover columna" @onmousedown="e => IniciarReorder(e, k)" @onclick="() => OrdenarPorClic(k)">
                            <span class="tbl-th-lbl">@ColLabel(k)</span>
                            @SortInd(k)
                            @ChevCol(k)
                            <span class="tbl-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, k)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResize(k)" @ondblclick:stopPropagation="true"></span>
                        </th>
                    }
                    <th class="tbl-addcol"></th>
                </tr>
            </thead>
            <tbody>
                @if (niveles.Count > 0)
                {
                    <TablaGruposRenderTr T="ComunicadoListaDto" Nodos="@ArbolGrupos(niveles)" FilaTemplate="FilaTpl" Colspan="@(cols.Count + 2)" />
                }
                else
                {
                    @foreach (var c in Pagina) { @FilaTpl(c) }
                }
            </tbody>
        </table>
        </div>
        </div>
        @if (niveles.Count == 0)
        {
            <TablaPager Total="Filtrados.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="comunicados"
                        PaginaChanged="p => { _pagina = p; }"
                        PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
        }
    </div>
}

<TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" />

@* ===== Modal Crear comunicado (wizard 3 pasos) ===== *@
@if (_showCrear)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">Nuevo comunicado - Paso @_paso de 3</h5>
                        <small class="text-muted">@(_paso == 1 ? "Punto de partida" : _paso == 2 ? "Editor" : "Envio")</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CancelarCrearAsync"></button>
                </div>
                <div class="modal-body">
                    @if (_paso == 1)
                    {
                        <p class="text-muted small">Elige una plantilla o empieza desde cero.</p>
                        <div class="list-group mb-3">
                            <button class="list-group-item list-group-item-action @(_plantillaSeleccionada is null ? "active" : "")"
                                    @onclick="() => { _plantillaSeleccionada = null; _crearAsunto = null; _crearCuerpoHtml = null; }">
                                <strong>Escribir desde cero</strong>
                                <br><small>Empieza con un comunicado en blanco.</small>
                            </button>
                            @if (_plantillas is not null)
                            {
                                @foreach (var p in _plantillas)
                                {
                                    var pid = p.Id;
                                    <button class="list-group-item list-group-item-action @(_plantillaSeleccionada?.Id == pid ? "active" : "")"
                                            @onclick="() => UsarPlantilla(pid)">
                                        <div class="d-flex justify-content-between">
                                            <strong>@p.Nombre</strong>
                                            <small>@(p.EsGlobal ? "(global)" : "(personal)")</small>
                                        </div>
                                        <small class="text-muted">@p.AsuntoModelo</small>
                                    </button>
                                }
                            }
                        </div>
                    }
                    else if (_paso == 2)
                    {
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small d-flex align-items-center justify-content-between">Tipo *
                                    <button type="button" class="btn btn-link btn-sm p-0 text-muted" title="Gestionar opciones de la lista" @onclick="() => _gestTipoCom = true"><i class="fi fi-rr-settings-sliders"></i></button>
                                </label>
                                <select class="form-select form-select-sm" @bind="_crearTipo">
                                    @foreach (var t in Enum.GetValues<TipoComunicadoBase>().Where(t => !OcultaTipoCom(t))) { <option value="@t">@LblTipoCom(t)</option> }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small">Asunto *</label>
                                <input class="form-control form-control-sm" @bind="_crearAsunto" @bind:event="oninput" maxlength="150" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small">Cuerpo (HTML) *</label>
                                <textarea class="form-control form-control-sm" rows="8" @bind="_crearCuerpoHtml" @bind:event="oninput"></textarea>
                                <small class="text-muted">Mínimo 20 caracteres. Acepta HTML básico.</small>
                            </div>
                            <div class="col-md-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="_crearRequiereAcuse" id="acuseChk" />
                                    <label class="form-check-label small" for="acuseChk">Solicitar acuse de recibo</label>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_paso == 3)
                    {
                        <h6>Segmento de destinatarios</h6>
                        <div class="mb-3">
                            <select class="form-select form-select-sm w-50 d-inline-block" @bind="_segmentoTipo">
                                <option value="Broadcast">Toda la comunidad</option>
                                <option value="Etiqueta">Por etiqueta del Directorio</option>
                            </select>
                            <button class="btn btn-sm btn-outline-dark ms-2" @onclick="AgregarSegmento">Aplicar</button>
                        </div>
                        @if (_segmentosActuales.Count > 0)
                        {
                            <p class="small">
                                <strong>Aplicados:</strong>
                                @foreach (var s in _segmentosActuales)
                                {
                                    <span class="badge bg-light text-dark me-1">@s.Tipo</span>
                                }
                            </p>
                        }
                        @if (_preview is not null)
                        {
                            <div class="card bg-light p-3 mb-3">
                                <strong>@_preview.Total destinatario(s) elegibles</strong>
                                <small class="text-muted">
                                    @_preview.TotalSinWhatsapp sin WhatsApp registrado &middot;
                                    @_preview.TotalSinAutorizacion sin autorizacion de datos
                                </small>
                            </div>
                        }
                        <hr>
                        <h6>Programación</h6>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="envio" id="rInm" @onchange="() => _envioInmediato = true" checked="@_envioInmediato" />
                                    <label class="form-check-label small" for="rInm">Envio inmediato</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="envio" id="rProg" @onchange="() => _envioInmediato = false" checked="@(!_envioInmediato)" />
                                    <label class="form-check-label small" for="rProg">Programar envio</label>
                                </div>
                            </div>
                            @if (!_envioInmediato)
                            {
                                <div class="col-md-6">
                                    <label class="form-label small">Fecha y hora *</label>
                                    <input type="datetime-local" class="form-control form-control-sm"
                                           value="@(_fechaProgramada?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
                                           @onchange="(e) => _fechaProgramada = string.IsNullOrEmpty(e.Value?.ToString()) ? null : new DateTimeOffset(DateTime.Parse(e.Value!.ToString()!), TimeZoneInfo.Local.BaseUtcOffset)" />
                                    <small class="text-muted">Mínimo 5 minutos en el futuro.</small>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (_paso > 1)
                    {
                        <button class="btn btn-sm btn-outline-dark" @onclick="() => _paso--">&larr; Atrás</button>
                    }
                    <button class="btn btn-sm btn-outline-dark" @onclick="CancelarCrearAsync">Cancelar</button>
                    @if (_paso == 1)
                    {
                        <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="() => _paso = 2">Siguiente &rarr;</button>
                    }
                    else if (_paso == 2)
                    {
                        <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="GuardarYAvanzar"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_crearAsunto) || string.IsNullOrWhiteSpace(_crearCuerpoHtml) || _crearAsunto!.Length < 5 || _crearCuerpoHtml!.Length < 20)">
                            @(_busy ? "..." : (_borradorId is null ? "Crear borrador y continuar" : "Guardar y continuar")) &rarr;
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-success" @onclick="ConfirmarEnviar"
                                disabled="@(_busy || _segmentosActuales.Count == 0 || (!_envioInmediato && _fechaProgramada is null))">
                            @(_busy ? "..." : (_envioInmediato ? "Enviar ahora" : "Programar"))
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* Gestion por-copropiedad de las opciones de "Tipo de comunicado" (Ola 4b-2). *@
@if (_gestTipoCom)
{
    <GestionarOpcionesListaModal Lista="comunicacion.tipocomunicado" Titulo="Comunicaciones · Tipo de comunicado"
                                 Jwt="@_jwt" PermiteAgregar="false"
                                 Guardado="RecargarTipoCom" Cerrado="() => _gestTipoCom = false" />
}

@* ===== Modal Ficha + Acuses ===== *@
@if (_ficha is not null)
{
    var c = _ficha;
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@c.Asunto</h5>
                        <small class="text-muted">@RenderTipo(c.TipoComunicado) &middot; @RenderEstado(c.Estado)</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _ficha = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        @if (c.FechaEnvio.HasValue) { <div class="col-md-3"><small class="text-muted">Enviado</small><br>@c.FechaEnvio.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div> }
                        @if (c.FechaProgramada.HasValue) { <div class="col-md-3"><small class="text-muted">Programado</small><br>@c.FechaProgramada.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div> }
                        <div class="col-md-3"><small class="text-muted">Acuse</small><br>@(c.RequiereAcuse ? "Si" : "No")</div>
                        <div class="col-md-3"><small class="text-muted">Destinatarios</small><br>@(c.TotalDestinatarios ?? 0)</div>
                    </div>

                    <h6>Contenido</h6>
                    <div class="card bg-light p-3 mb-3"><div>@((MarkupString)c.CuerpoHtml)</div></div>

                    @if (c.Estado == EstadoComunicado.Enviado && c.RequiereAcuse && _acuses is not null)
                    {
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Acuse de recibo</h6>
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => ReenviarPendientes(c.Id)">Reenviar a pendientes</button>
                        </div>
                        <div class="my-2">
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: @(_acuses.TasaApertura)%"></div>
                            </div>
                            <small class="text-muted">@_acuses.Confirmados confirmados &middot; @_acuses.Pendientes pendientes &middot; @(_acuses.TasaApertura.ToString("0.0"))%</small>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="small">Confirmados (@_acuses.Confirmados)</h6>
                                @foreach (var a in _acuses.Confirmadas.Take(20))
                                {
                                    <div class="small"><span class="text-success">&#10004;</span> @a.NombreCompleto - <small class="text-muted">@a.AbiertoAt?.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</small></div>
                                }
                            </div>
                            <div class="col-md-6">
                                <h6 class="small">Pendientes (@_acuses.Pendientes)</h6>
                                @foreach (var a in _acuses.NoAbiertos.Take(20))
                                {
                                    <div class="small"><span class="text-warning">&#9203;</span> @a.NombreCompleto</div>
                                }
                            </div>
                        </div>
                    }

                    @if (c.Estado == EstadoComunicado.Borrador || c.Estado == EstadoComunicado.Programado)
                    {
                        <hr>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelarComunicado(c.Id)">Cancelar comunicado</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* La barra y la tabla son las canonicas (bandeja-canonica.css + tabla-base.css). Aqui solo lo propio. */
    .com-td-asunto strong { font-weight: 600; color: var(--propia-text-h1); }
    .com-row td.com-td { cursor: pointer; }
</style>

@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private bool _gestTipoCom;   // modal "Gestionar opciones" de comunicacion.tipocomunicado (por copropiedad)
    private string? _msg;
    private string _msgClass = "alert-info";

    private List<ComunicadoListaDto>? _lista;
    private List<PlantillaDto>? _plantillas;
    private ResumenComunicacionesDto? _resumen;
    private ComunicadoDetalleDto? _ficha;
    private AcuseListaDto? _acuses;

    private string _query = "";
    private string? _copropiedadNombre;   // para el titulo de la descarga

    // ===== Barra / vista tabla canonica =====
    private FiltroDinamico? _fd;
    private bool _showCampos;
    private string _colQ = "";
    // Orden multi-criterio (TablaOrdenarMenu + clic en el encabezado). Por defecto: fecha mas reciente primero.
    private List<TablaOrdenarMenu.Sort> _sorts = new() { new TablaOrdenarMenu.Sort { Key = "fecha", Dir = -1 } };
    // Agrupar multi-nivel (TablaAgruparMenu + motor TablaAgrupador), recordado por navegador.
    private List<string> _grupos = new();
    private const string GruposKey = "propia_comunicaciones_grupos";
    private int _pagina = 1; private int _porPagina = 25;

    private sealed record ColDef(string Key, string Label, bool Hideable);
    private static readonly ColDef[] Catalogo =
    {
        new("asunto", "Asunto", false),
        new("tipo", "Tipo", true),
        new("segmento", "Segmento", true),
        new("fecha", "Fecha", true),
        new("estado", "Estado", true),
        new("acuse", "Acuse", true),
    };
    private List<string> _colOrder = Catalogo.Select(c => c.Key).ToList();
    private readonly HashSet<string> _colHidden = new();

    // Config de columnas por copropiedad (orden/visibilidad/ancho), discriminada por entidad 'comunicacion'
    // en la tabla generica unidad_campos_config (sin backend nuevo). _colW = ancho px por columna.
    private const string EntCfg = "comunicacion";
    private Dictionary<string, UnidadCampoConfigDto> _cfg = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _colW = new(StringComparer.Ordinal);
    private DotNetObjectReference<Comunicaciones>? _self;

    private IEnumerable<string> ColsVisibles => _colOrder.Where(k => !_colHidden.Contains(k));
    private static string ColLabel(string k) => Catalogo.First(c => c.Key == k).Label;

    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "asunto", Label = "Asunto", Kind = "texto" },
        new() { Key = "tipo", Label = "Tipo", Kind = "sel",
                Opciones = Enum.GetValues<TipoComunicadoBase>().Select(t => (t.ToString(), LblTipoCom(t))).ToList() },
        new() { Key = "estado", Label = "Estado", Kind = "sel",
                Opciones = Enum.GetValues<EstadoComunicado>().Select(e => (e.ToString(), e.ToString())).ToList() },
        new() { Key = "segmento", Label = "Segmento", Kind = "texto" },
        new() { Key = "fecha", Label = "Fecha", Kind = "fecha" },
    };

    private IReadOnlyList<ComunicadoListaDto> Items => _lista ?? (IReadOnlyList<ComunicadoListaDto>)Array.Empty<ComunicadoListaDto>();

    private static DateTimeOffset FechaDe(ComunicadoListaDto c) => c.FechaEnvio ?? c.FechaProgramada ?? c.CreadoAt;

    private string? ValorCrudo(ComunicadoListaDto c, string key) => key switch
    {
        "asunto" => c.Asunto,
        "tipo" => c.TipoComunicado.ToString(),
        "segmento" => c.SegmentoResumen,
        "estado" => c.Estado.ToString(),
        "fecha" => FechaDe(c).LocalDateTime.ToString("yyyy-MM-dd"),
        _ => null,
    };

    private List<ComunicadoListaDto> Filtrados
    {
        get
        {
            var q = Items.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_query))
                q = q.Where(c => c.Asunto.Contains(_query, StringComparison.OrdinalIgnoreCase));
            if (_fd is not null)
                q = q.Where(c => _fd.Pasa(key => ValorCrudo(c, key)));
            return Ordenar(q).ToList();
        }
    }

    // Orden multi-criterio (estable). Sin criterios queda el del API.
    private IEnumerable<ComunicadoListaDto> Ordenar(IEnumerable<ComunicadoListaDto> src)
    {
        if (_sorts.Count == 0) return src;
        IOrderedEnumerable<ComunicadoListaDto>? o = null;
        foreach (var srt in _sorts)
        {
            Func<ComunicadoListaDto, IComparable> sel = c => ValorOrden(c, srt.Key);
            o = o is null ? (srt.Dir >= 0 ? src.OrderBy(sel) : src.OrderByDescending(sel))
                          : (srt.Dir >= 0 ? o.ThenBy(sel) : o.ThenByDescending(sel));
        }
        return o!;
    }
    private IComparable ValorOrden(ComunicadoListaDto c, string k) => k switch
    {
        "asunto" => c.Asunto ?? "",
        "tipo" => LblTipoCom(c.TipoComunicado),
        "segmento" => c.SegmentoResumen ?? "",
        "estado" => c.Estado.ToString(),
        "acuse" => c.TasaApertura ?? -1m,
        _ => FechaDe(c),
    };
    private List<TablaOrdenarMenu.Col> ColsOrdenables() => ColsVisibles.Select(k => new TablaOrdenarMenu.Col(k, ColLabel(k))).ToList();
    private void OrdenarPorClic(string k)
    {
        var dir = _sorts.Count == 1 && _sorts[0].Key == k ? -_sorts[0].Dir : 1;
        _sorts = new() { new TablaOrdenarMenu.Sort { Key = k, Dir = dir } };
        _pagina = 1;
    }
    private RenderFragment SortInd(string k)
    {
        var srt = _sorts.FirstOrDefault(x => x.Key == k);
        return srt is null ? (__b => { }) : (@<span class="tbl-th-arrow">@((MarkupString)(srt.Dir >= 0 ? "&#9650;" : "&#9660;"))</span>);
    }

    // Agrupar (multi-nivel): mismas etiquetas que la tabla; fechas por dia (mas reciente primero).
    private List<TablaAgruparMenu.Col> ColsAgrupables() => ColsVisibles.Select(k => new TablaAgruparMenu.Col(k, ColLabel(k))).ToList();
    private List<string> Niveles => _grupos.Where(k => ColsVisibles.Contains(k)).ToList();
    private async Task OnGruposChanged()
    {
        _pagina = 1;
        try { await Js.InvokeVoidAsync("localStorage.setItem", GruposKey, string.Join(",", _grupos)); } catch { }
        StateHasChanged();
    }
    private IReadOnlyList<NodoGrupo<ComunicadoListaDto>> ArbolGrupos(List<string> niveles)
        => TablaAgrupador.Agrupar(Filtrados, niveles, ValorGrupoDe, "(Sin dato)");
    private IEnumerable<ValorGrupo> ValorGrupoDe(ComunicadoListaDto c, string k)
    {
        if (k == "fecha")
        {
            var d = DateOnly.FromDateTime(FechaDe(c).LocalDateTime);
            yield return new ValorGrupo(d.ToString("yyyy-MM-dd"), d.ToString("yyyy-MM-dd"), Orden: -d.DayNumber);
            yield break;
        }
        var v = TextoCelda(c, k);
        yield return string.IsNullOrWhiteSpace(v) ? new ValorGrupo("", "(Sin dato)") : new ValorGrupo(v, v);
    }
    // Texto visible de una celda (agrupar y descargar usan el mismo texto que se ve en la tabla).
    private string TextoCelda(ComunicadoListaDto c, string k) => k switch
    {
        "asunto" => c.Asunto ?? "",
        "tipo" => LblTipoCom(c.TipoComunicado),
        "segmento" => c.SegmentoResumen ?? "",
        "fecha" => FechaDe(c).LocalDateTime.ToString("yyyy-MM-dd HH:mm"),
        "estado" => c.Estado.ToString(),
        "acuse" => c.RequiereAcuse && c.Estado == EstadoComunicado.Enviado && c.TotalDestinatarios > 0
            ? $"{c.TotalAbiertos}/{c.TotalDestinatarios} ({c.TasaApertura ?? 0m:0.0}%)" : "",
        _ => "",
    };

    // Menu de columna (flecha del encabezado): ordenar, filtrar, agrupar y ocultar. Sin campos propios.
    private TablaColMenu? _colMenu;
    private RenderFragment ChevCol(string clave) =>@<button type="button" class="tbl-th-edit" title="Opciones de columna" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="(e) => _colMenu?.Abrir(new TablaColMenu.Ctx(clave, ColLabel(clave), false), e.ClientX, e.ClientY)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg></button>;
    private async Task OnColAccion((TablaColMenu.Accion Accion, TablaColMenu.Ctx Col) a)
    {
        var (accion, col) = a;
        switch (accion)
        {
            case TablaColMenu.Accion.OrdenarAsc: _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = 1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.OrdenarDesc: _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = -1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.Filtrar:
                if (_fd is not null && CamposFiltro.Any(c => c.Key == col.Key)) await _fd.AgregarReglaCampo(col.Key);
                else { _msg = "Filtrar por este campo aun no esta disponible; usa el boton Filtros."; _msgClass = "alert-info"; }
                break;
            case TablaColMenu.Accion.Agrupar: _grupos = new() { col.Key }; await OnGruposChanged(); break;
            case TablaColMenu.Accion.Ocultar:
                if (!Catalogo.First(c => c.Key == col.Key).Hideable) { _msg = "Esta columna es fija y no se puede ocultar."; _msgClass = "alert-info"; }
                else await SetColVisible(col.Key, false);
                break;
            default: _msg = "Comunicaciones no tiene campos propios: esta opcion no aplica aqui."; _msgClass = "alert-info"; break;
        }
        StateHasChanged();
    }

    // Descargar la vista tal como se ve (TablaExportar): columnas visibles, todas las filas filtradas y ordenadas, grupos.
    private ExportVista VistaExport()
    {
        var cols = ColsVisibles.ToList();
        var columnas = cols.Select(k => new ExportColumna(ColLabel(k))).ToList();
        ExportFila Fila(ComunicadoListaDto c, IReadOnlyList<string>? ruta)
            => new(cols.Select(k => { var t = TextoCelda(c, k); return (object?)(string.IsNullOrWhiteSpace(t) ? null : t); }).ToList(), Ruta: ruta);
        var filas = new List<ExportFila>();
        var niveles = Niveles;
        if (niveles.Count == 0) filas.AddRange(Filtrados.Select(c => Fila(c, null)));
        else
        {
            void Recorrer(IReadOnlyList<NodoGrupo<ComunicadoListaDto>> nodos, List<string> ruta)
            {
                foreach (var n in nodos)
                {
                    filas.Add(ExportFila.DeGrupo(n.Titulo, n.Nivel, n.Conteo));
                    var r = new List<string>(ruta) { n.Titulo };
                    if (n.EsHoja) filas.AddRange(n.Filas.Select(c => Fila(c, r)));
                    else Recorrer(n.Subgrupos, r);
                }
            }
            Recorrer(ArbolGrupos(niveles), new());
        }
        var criterios = new List<string>();
        if (!string.IsNullOrWhiteSpace(_query)) criterios.Add($"Búsqueda: \"{_query.Trim()}\"");
        if (_fd?.Resumen() is { Length: > 0 } fr) criterios.Add("Filtros: " + fr);
        if (_sorts.Count > 0) criterios.Add("Orden: " + string.Join(", ", _sorts.Select(x => $"{ColLabel(x.Key)} {(x.Dir >= 0 ? "ascendente" : "descendente")}")));
        if (niveles.Count > 0) criterios.Add("Agrupado por: " + string.Join(" > ", niveles.Select(ColLabel)));
        criterios.Add($"{Filtrados.Count} comunicados");
        return new ExportVista("Comunicaciones", _copropiedadNombre, columnas, filas, criterios, niveles.Select(ColLabel).ToList());
    }

    private async Task MoverCol(int idx, int delta)
    {
        var j = idx + delta;
        if (j < 0 || j >= _colOrder.Count) return;
        (_colOrder[idx], _colOrder[j]) = (_colOrder[j], _colOrder[idx]);
        for (int i = 0; i < _colOrder.Count; i++) await GuardarCfg(FilaConfig(_colOrder[i]) with { Orden = i });
        await CargarConfigAsync();
    }

    private async Task SetColVisible(string key, bool visible)
    {
        if (!Catalogo.First(c => c.Key == key).Hideable) return;
        if (visible) _colHidden.Remove(key); else _colHidden.Add(key);
        await GuardarCfg(FilaConfig(key) with { Oculto = !visible });
        await CargarConfigAsync();
    }

    private async Task MostrarTodo()
    { foreach (var c in Catalogo) await GuardarCfg(FilaConfig(c.Key) with { Oculto = false }); await CargarConfigAsync(); }
    private async Task OcultarTodo()
    { foreach (var c in Catalogo.Where(c => c.Hideable)) await GuardarCfg(FilaConfig(c.Key) with { Oculto = true }); await CargarConfigAsync(); }

    // ===== Config de columnas (orden/visibilidad/ancho) por copropiedad, entidad 'comunicacion' =====
    private UnidadCampoConfigDto? CfgDe(string k) => _cfg.TryGetValue(k, out var c) ? c : null;
    private GuardarUnidadCampoConfigRequest FilaConfig(string clave)
    {
        var c = CfgDe(clave);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato, Oculto: c?.Oculto ?? false, Orden: c?.Orden, Entidad: EntCfg, Descripcion: c?.Descripcion);
    }
    private async Task GuardarCfg(GuardarUnidadCampoConfigRequest req)
    { try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { } }
    private async Task CargarConfigAsync()
    {
        try
        {
            var lista = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>($"/api/mi-copropiedad/unidades-config?entidad={EntCfg}") ?? new();
            _cfg = lista.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
        }
        catch { _cfg = new(StringComparer.Ordinal); }
        _colOrder = Catalogo.Select((c, i) => (c.Key, ord: CfgDe(c.Key)?.Orden ?? (1000 + i)))
                            .OrderBy(x => x.ord).Select(x => x.Key).ToList();
        _colHidden.Clear();
        foreach (var c in Catalogo) if (c.Hideable && (CfgDe(c.Key)?.Oculto ?? false)) _colHidden.Add(c.Key);
        HidratarAnchos();
    }
    private void HidratarAnchos()
    {
        _colW.Clear();
        foreach (var kv in _cfg) { var w = AnchoDeFormato(kv.Value.Formato); if (w is > 0) _colW[kv.Key] = w.Value; }
    }
    private static int? AnchoDeFormato(string? json)
    { try { var o = System.Text.Json.Nodes.JsonNode.Parse(json ?? "") as System.Text.Json.Nodes.JsonObject; return o?["w"]?.GetValue<int>(); } catch { return null; } }
    private static string? ConAncho(string? json, int? w)
    {
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(json) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (w is null) o.Remove("w"); else o["w"] = w.Value;
        return o.Count == 0 ? null : o.ToJsonString();
    }
    private string ColStyle(string k) => $"width:{(_colW.TryGetValue(k, out var w) ? w : AnchoDefault(k))}px";
    private static int AnchoDefault(string k) => k switch { "asunto" => 320, "segmento" => 200, "acuse" => 180, "fecha" => 150, _ => 130 };

    // ===== Reordenar (drag) + redimensionar columnas (JS compartido propiaTablaColReorder/propiaTablaResize) =====
    private async Task IniciarReorder(MouseEventArgs e, string k)
    { _self ??= DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _self, k, e.ClientX, e.ClientY); } catch { } }
    [JSInvokable]
    public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        var keys = ColsVisibles.ToList();
        var from = keys.IndexOf(src); var to = keys.IndexOf(dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, src);
        var full = keys.Concat(_colOrder.Where(k => !keys.Contains(k))).ToList();
        for (int i = 0; i < full.Count; i++) await GuardarCfg(FilaConfig(full[i]) with { Orden = i });
        await CargarConfigAsync(); StateHasChanged();
    }
    private async Task IniciarResize(MouseEventArgs e, string k)
    { _self ??= DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("propiaTablaResize.start", _self, k, e.ClientX); } catch { } }
    private Task ResetResize(string k) => OnColResize(k, 0);
    [JSInvokable]
    public async Task OnColResize(string clave, int width)
    {
        int? w = width <= 0 ? null : Math.Max(70, width);
        if (w is null) _colW.Remove(clave); else _colW[clave] = w.Value;
        await GuardarCfg(FilaConfig(clave) with { Formato = ConAncho(CfgDe(clave)?.Formato, w) });
        await CargarConfigAsync(); StateHasChanged();
    }
    public void Dispose() { _self?.Dispose(); }

    // Fila canonica: expander (abre la ficha) + celdas de solo lectura (clic = abrir) + columna final.
