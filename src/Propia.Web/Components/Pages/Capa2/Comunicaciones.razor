@page "/comunicaciones"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Comunicaciones
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Comunicaciones - PROPIA</PageTitle>

<div class="mb-4 d-flex justify-content-between align-items-start">
    <div>
        <h1 class="h3 mb-1 fw-semibold">Comunicaciones</h1>
        <p class="text-muted mb-0">Circulares, avisos y anuncios a la comunidad con entrega por WhatsApp</p>
    </div>
    <button class="btn" style="background: var(--propia-primary); color: white;" @onclick="AbrirCrear">+ Nuevo comunicado</button>
</div>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

@if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

@* === Barra canonica: [Filtros] [Buscar] ... spacer ... [Agrupar] [Campos] === *@
<div class="com-tool">
    <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="@(() => { _pagina = 1; StateHasChanged(); })" />
    <div class="com-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input class="com-search-inp" placeholder="Buscar por asunto..." value="@_query"
               @oninput="@(e => { _query = e.Value?.ToString() ?? string.Empty; _pagina = 1; })" />
    </div>
    <div class="com-tool-spacer"></div>
    <div class="com-menu-wrap">
        <button type="button" class="com-fbtn @(_agruparPor != "" ? "on" : "")" @onclick="() => _showAgrupar = !_showAgrupar" title="Agrupar comunicados">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <span>Agrupar@(_agruparPor != "" ? ": " + AgruparLabel(_agruparPor) : "")</span>
        </button>
        @if (_showAgrupar)
        {
            <div class="com-menu-bd" @onclick="() => _showAgrupar = false"></div>
            <div class="com-menu">
                @foreach (var (gk, gl) in AgruparOpciones)
                {
                    var key = gk;
                    <button class="com-menu-it @(_agruparPor == key ? "on" : "")" @onclick="() => SetAgrupar(key)">@gl</button>
                }
            </div>
        }
    </div>
    <div class="com-menu-wrap">
        <button type="button" class="com-fbtn @(_showCampos ? "on" : "")" @onclick="() => _showCampos = !_showCampos" title="Campos y columnas de la tabla">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
            <span>Campos</span>
        </button>
        @if (_showCampos)
        {
            <div class="com-menu-bd" @onclick="() => _showCampos = false"></div>
            <div class="com-colsmenu">
                <div class="com-colsmenu-h">COLUMNAS (orden y visibilidad)</div>
                @for (int i = 0; i < _colOrder.Count; i++)
                {
                    var idx = i;
                    var col = Catalogo.First(c => c.Key == _colOrder[idx]);
                    var key = col.Key;
                    <div class="com-colsmenu-i">
                        <div class="com-colsmenu-ord">
                            <button class="com-colsmenu-mv" disabled="@(idx == 0)" @onclick="() => MoverCol(idx, -1)" title="Subir">&#9650;</button>
                            <button class="com-colsmenu-mv" disabled="@(idx == _colOrder.Count - 1)" @onclick="() => MoverCol(idx, 1)" title="Bajar">&#9660;</button>
                        </div>
                        <label class="com-cfg-vis" title="@(col.Hideable ? "Mostrar u ocultar" : "Columna requerida, siempre visible")">
                            <input type="checkbox" checked="@(!_colHidden.Contains(key))" disabled="@(!col.Hideable)" @onchange="@(e => SetColVisible(key, (bool)(e.Value ?? false)))" />
                        </label>
                        <span class="com-colsmenu-lbl">@col.Label</span>
                        @if (!col.Hideable) { <span class="com-cfg-req">fija</span> }
                    </div>
                }
                <div class="com-colsmenu-acts">
                    <button type="button" class="com-colsmenu-act" @onclick="MostrarTodo">Mostrar todo</button>
                    <button type="button" class="com-colsmenu-act" @onclick="OcultarTodo">Ocultar todo</button>
                </div>
            </div>
        }
    </div>
</div>

@if (_lista is null)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
}
else
{
    <div class="com-box">
        <div class="com-table-wrap">
            <table class="com-table">
                <thead>
                    <tr>
                        <th class="com-th-exp"></th>
                        @foreach (var key in ColsVisibles)
                        {
                            var k = key;
                            <th @onclick="() => Ordenar(k)" title="Ordenar">
                                <span class="com-th-lbl">@ColLabel(k)@(_sortCol == k ? (_sortAsc ? " ▲" : " ▼") : "")</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (_agruparPor == "")
                    {
                        @foreach (var c in Pagina) { @RenderFila(c) }
                    }
                    else
                    {
                        @foreach (var g in Grupos)
                        {
                            <tr class="com-grp-row">
                                <td class="com-grp-cell" colspan="@(ColsVisibles.Count() + 1)">@g.Key <span class="com-grp-count">@g.Count()</span></td>
                            </tr>
                            @foreach (var c in g) { @RenderFila(c) }
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_agruparPor == "")
        {
            <TablaPager Total="Filtrados.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="comunicados"
                        PaginaChanged="p => { _pagina = p; }"
                        PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
        }
    </div>
}

@* ===== Modal Crear comunicado (wizard 3 pasos) ===== *@
@if (_showCrear)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">Nuevo comunicado - Paso @_paso de 3</h5>
                        <small class="text-muted">@(_paso == 1 ? "Punto de partida" : _paso == 2 ? "Editor" : "Envio")</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CerrarCrear"></button>
                </div>
                <div class="modal-body">
                    @if (_paso == 1)
                    {
                        <p class="text-muted small">Elige una plantilla o empieza desde cero.</p>
                        <div class="list-group mb-3">
                            <button class="list-group-item list-group-item-action @(_plantillaSeleccionada is null ? "active" : "")"
                                    @onclick="() => { _plantillaSeleccionada = null; _crearAsunto = null; _crearCuerpoHtml = null; }">
                                <strong>Escribir desde cero</strong>
                                <br><small>Empieza con un comunicado en blanco.</small>
                            </button>
                            @if (_plantillas is not null)
                            {
                                @foreach (var p in _plantillas)
                                {
                                    var pid = p.Id;
                                    <button class="list-group-item list-group-item-action @(_plantillaSeleccionada?.Id == pid ? "active" : "")"
                                            @onclick="() => UsarPlantilla(pid)">
                                        <div class="d-flex justify-content-between">
                                            <strong>@p.Nombre</strong>
                                            <small>@(p.EsGlobal ? "(global)" : "(personal)")</small>
                                        </div>
                                        <small class="text-muted">@p.AsuntoModelo</small>
                                    </button>
                                }
                            }
                        </div>
                    }
                    else if (_paso == 2)
                    {
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small">Tipo *</label>
                                <select class="form-select form-select-sm" @bind="_crearTipo">
                                    @foreach (var t in Enum.GetValues<TipoComunicadoBase>()) { <option value="@t">@t</option> }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small">Asunto *</label>
                                <input class="form-control form-control-sm" @bind="_crearAsunto" @bind:event="oninput" maxlength="150" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small">Cuerpo (HTML) *</label>
                                <textarea class="form-control form-control-sm" rows="8" @bind="_crearCuerpoHtml" @bind:event="oninput"></textarea>
                                <small class="text-muted">Minimo 20 caracteres. Acepta HTML basico.</small>
                            </div>
                            <div class="col-md-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="_crearRequiereAcuse" id="acuseChk" />
                                    <label class="form-check-label small" for="acuseChk">Solicitar acuse de recibo</label>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_paso == 3)
                    {
                        <h6>Segmento de destinatarios</h6>
                        <div class="mb-3">
                            <select class="form-select form-select-sm w-50 d-inline-block" @bind="_segmentoTipo">
                                <option value="Broadcast">Toda la comunidad</option>
                                <option value="Etiqueta">Por etiqueta del Directorio</option>
                            </select>
                            <button class="btn btn-sm btn-outline-dark ms-2" @onclick="AgregarSegmento">Aplicar</button>
                        </div>
                        @if (_segmentosActuales.Count > 0)
                        {
                            <p class="small">
                                <strong>Aplicados:</strong>
                                @foreach (var s in _segmentosActuales)
                                {
                                    <span class="badge bg-light text-dark me-1">@s.Tipo</span>
                                }
                            </p>
                        }
                        @if (_preview is not null)
                        {
                            <div class="card bg-light p-3 mb-3">
                                <strong>@_preview.Total destinatario(s) elegibles</strong>
                                <small class="text-muted">
                                    @_preview.TotalSinWhatsapp sin WhatsApp registrado &middot;
                                    @_preview.TotalSinAutorizacion sin autorizacion de datos
                                </small>
                            </div>
                        }
                        <hr>
                        <h6>Programacion</h6>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="envio" id="rInm" @onchange="() => _envioInmediato = true" checked="@_envioInmediato" />
                                    <label class="form-check-label small" for="rInm">Envio inmediato</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="envio" id="rProg" @onchange="() => _envioInmediato = false" checked="@(!_envioInmediato)" />
                                    <label class="form-check-label small" for="rProg">Programar envio</label>
                                </div>
                            </div>
                            @if (!_envioInmediato)
                            {
                                <div class="col-md-6">
                                    <label class="form-label small">Fecha y hora *</label>
                                    <input type="datetime-local" class="form-control form-control-sm"
                                           value="@(_fechaProgramada?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
                                           @onchange="(e) => _fechaProgramada = string.IsNullOrEmpty(e.Value?.ToString()) ? null : new DateTimeOffset(DateTime.Parse(e.Value!.ToString()!), TimeZoneInfo.Local.BaseUtcOffset)" />
                                    <small class="text-muted">Minimo 5 minutos en el futuro.</small>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (_paso > 1)
                    {
                        <button class="btn btn-sm btn-outline-dark" @onclick="() => _paso--">&larr; Atras</button>
                    }
                    <button class="btn btn-sm btn-outline-dark" @onclick="CerrarCrear">Cancelar</button>
                    @if (_paso == 1)
                    {
                        <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="() => _paso = 2">Siguiente &rarr;</button>
                    }
                    else if (_paso == 2)
                    {
                        <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="GuardarYAvanzar"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_crearAsunto) || string.IsNullOrWhiteSpace(_crearCuerpoHtml) || _crearAsunto!.Length < 5 || _crearCuerpoHtml!.Length < 20)">
                            @(_busy ? "..." : (_borradorId is null ? "Crear borrador y continuar" : "Guardar y continuar")) &rarr;
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-success" @onclick="ConfirmarEnviar"
                                disabled="@(_busy || _segmentosActuales.Count == 0 || (!_envioInmediato && _fechaProgramada is null))">
                            @(_busy ? "..." : (_envioInmediato ? "Enviar ahora" : "Programar"))
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal Ficha + Acuses ===== *@
@if (_ficha is not null)
{
    var c = _ficha;
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@c.Asunto</h5>
                        <small class="text-muted">@RenderTipo(c.TipoComunicado) &middot; @RenderEstado(c.Estado)</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _ficha = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        @if (c.FechaEnvio.HasValue) { <div class="col-md-3"><small class="text-muted">Enviado</small><br>@c.FechaEnvio.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div> }
                        @if (c.FechaProgramada.HasValue) { <div class="col-md-3"><small class="text-muted">Programado</small><br>@c.FechaProgramada.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div> }
                        <div class="col-md-3"><small class="text-muted">Acuse</small><br>@(c.RequiereAcuse ? "Si" : "No")</div>
                        <div class="col-md-3"><small class="text-muted">Destinatarios</small><br>@(c.TotalDestinatarios ?? 0)</div>
                    </div>

                    <h6>Contenido</h6>
                    <div class="card bg-light p-3 mb-3"><div>@((MarkupString)c.CuerpoHtml)</div></div>

                    @if (c.Estado == EstadoComunicado.Enviado && c.RequiereAcuse && _acuses is not null)
                    {
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Acuse de recibo</h6>
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => ReenviarPendientes(c.Id)">Reenviar a pendientes</button>
                        </div>
                        <div class="my-2">
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: @(_acuses.TasaApertura)%"></div>
                            </div>
                            <small class="text-muted">@_acuses.Confirmados confirmados &middot; @_acuses.Pendientes pendientes &middot; @(_acuses.TasaApertura.ToString("0.0"))%</small>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="small">Confirmados (@_acuses.Confirmados)</h6>
                                @foreach (var a in _acuses.Confirmadas.Take(20))
                                {
                                    <div class="small"><span class="text-success">&#10004;</span> @a.NombreCompleto - <small class="text-muted">@a.AbiertoAt?.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</small></div>
                                }
                            </div>
                            <div class="col-md-6">
                                <h6 class="small">Pendientes (@_acuses.Pendientes)</h6>
                                @foreach (var a in _acuses.NoAbiertos.Take(20))
                                {
                                    <div class="small"><span class="text-warning">&#9203;</span> @a.NombreCompleto</div>
                                }
                            </div>
                        </div>
                    }

                    @if (c.Estado == EstadoComunicado.Borrador || c.Estado == EstadoComunicado.Programado)
                    {
                        <hr>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelarComunicado(c.Id)">Cancelar comunicado</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .com-tool { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
    .com-tool-spacer { flex: 1; }
    .com-search { display: flex; align-items: center; gap: 7px; border: 1px solid var(--propia-border-card); border-radius: 9px; padding: 0 11px; background: var(--propia-bg-card); }
    .com-search svg { color: var(--propia-text-faint); flex-shrink: 0; }
    .com-search:focus-within { border-color: var(--propia-brand, var(--propia-brand)); }
    .com-search-inp { border: 0; outline: none; padding: 8px 0; font-size: 12.5px; color: var(--propia-text-body); font-family: inherit; width: 240px; background: transparent; }

    .com-fbtn { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 8px 12px; border-radius: 9px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-secondary); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; }
    .com-fbtn:hover { border-color: #CBD6E2; }
    .com-fbtn.on { background: var(--propia-brand-soft); border-color: var(--propia-brand-border); color: var(--propia-brand, var(--propia-brand)); }

    .com-menu-wrap { position: relative; }
    .com-menu-bd { position: fixed; inset: 0; z-index: 40; }
    .com-menu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 41; min-width: 180px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 12px; box-shadow: 0 12px 30px rgba(30,40,60,.18); padding: 6px; }
    .com-menu-it { display: block; width: 100%; text-align: left; border: 0; background: transparent; border-radius: 8px; padding: 8px 10px; font-size: 12.5px; font-weight: 600; color: var(--propia-text-body); cursor: pointer; font-family: inherit; }
    .com-menu-it:hover { background: var(--propia-brand-soft); }
    .com-menu-it.on { background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); }

    .com-colsmenu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 41; min-width: 240px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 12px; box-shadow: 0 12px 30px rgba(30,40,60,.18); padding: 8px; }
    .com-colsmenu-h { font-size: 10px; font-weight: 700; letter-spacing: .4px; color: var(--propia-text-faint); padding: 4px 6px 8px; }
    .com-colsmenu-i { display: flex; align-items: center; gap: 8px; padding: 4px 6px; }
    .com-colsmenu-ord { display: flex; flex-direction: column; }
    .com-colsmenu-mv { border: 0; background: transparent; color: var(--propia-text-muted); cursor: pointer; font-size: 9px; line-height: 1; padding: 1px; }
    .com-colsmenu-mv:disabled { opacity: .3; cursor: default; }
    .com-colsmenu-lbl { flex: 1; font-size: 12.5px; font-weight: 600; color: var(--propia-text-body); }
    .com-cfg-req { font-size: 10px; color: var(--propia-text-faint); font-weight: 700; }
    .com-colsmenu-acts { display: flex; gap: 6px; border-top: 1px solid var(--propia-border-divider); margin-top: 6px; padding-top: 8px; }
    .com-colsmenu-act { flex: 1; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); border-radius: 7px; padding: 6px 8px; font-size: 11.5px; font-weight: 600; color: var(--propia-text-secondary); cursor: pointer; font-family: inherit; }
    .com-colsmenu-act:hover { background: var(--propia-brand-soft); border-color: var(--propia-brand-border); color: var(--propia-brand, var(--propia-brand)); }

    .com-box { border: 1px solid var(--propia-border-card); border-radius: 12px; overflow: hidden; background: var(--propia-bg-card); }
    .com-table-wrap { overflow: auto; max-height: calc(100vh - 260px); }
    .com-table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: max-content; }
    .com-table thead th { position: sticky; top: 0; z-index: 8; background: var(--propia-bg-table-head); border-bottom: 1px solid var(--propia-border-divider); padding: 10px 14px; text-align: left; font-size: 10.5px; font-weight: 700; letter-spacing: .4px; color: var(--propia-text-faint); text-transform: uppercase; white-space: nowrap; cursor: pointer; user-select: none; box-shadow: 0 2px 4px -2px rgba(27,42,58,.12); }
    .com-table thead th.com-th-exp { cursor: default; width: 34px; }
    .com-table tbody td { padding: 9px 14px; border-bottom: 1px solid var(--propia-border-divider); font-size: 13px; color: var(--propia-text-body); vertical-align: middle; }
    .com-table tbody tr:hover td { background: var(--propia-bg-hover); }
    .com-td-exp { width: 34px; text-align: center; padding: 0 4px; }
    .com-exp { border: 0; background: transparent; color: var(--propia-text-faint); cursor: pointer; opacity: 0; padding: 4px; }
    .com-table tbody tr:hover .com-exp { opacity: 1; }
    .com-td-asunto strong { font-weight: 600; color: var(--propia-text-h1); }

    .com-grp-row td { background: var(--propia-bg-hover); }
    .com-grp-cell { font-size: 12px; font-weight: 700; color: var(--propia-text-secondary); text-transform: uppercase; letter-spacing: .3px; }
    .com-grp-count { display: inline-flex; min-width: 20px; justify-content: center; margin-left: 8px; background: var(--propia-border-card); color: var(--propia-text-secondary); border-radius: 10px; padding: 0 7px; font-size: 11px; }

    [data-bs-theme="dark"] .com-box { background: var(--propia-bg-card); border-color: var(--propia-border-card); }
    [data-bs-theme="dark"] .com-table thead th { background: var(--propia-bg-table-head); color: var(--propia-text-muted); }
    [data-bs-theme="dark"] .com-table tbody td { color: var(--propia-text-body); border-color: var(--propia-border-card); }
    [data-bs-theme="dark"] .com-table tbody tr:hover td { background: var(--propia-bg-table-head); }
</style>

@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";

    private List<ComunicadoListaDto>? _lista;
    private List<PlantillaDto>? _plantillas;
    private ResumenComunicacionesDto? _resumen;
    private ComunicadoDetalleDto? _ficha;
    private AcuseListaDto? _acuses;

    private string _query = "";

    // ===== Barra / vista tabla canonica =====
    private FiltroDinamico? _fd;
    private bool _showAgrupar; private bool _showCampos;
    private string _agruparPor = "";
    private string _sortCol = "fecha"; private bool _sortAsc = false;   // fecha desc por defecto
    private int _pagina = 1; private int _porPagina = 25;

    private sealed record ColDef(string Key, string Label, bool Hideable);
    private static readonly ColDef[] Catalogo =
    {
        new("asunto", "Asunto", false),
        new("tipo", "Tipo", true),
        new("segmento", "Segmento", true),
        new("fecha", "Fecha", true),
        new("estado", "Estado", true),
        new("acuse", "Acuse", true),
    };
    private List<string> _colOrder = Catalogo.Select(c => c.Key).ToList();
    private readonly HashSet<string> _colHidden = new();

    private IEnumerable<string> ColsVisibles => _colOrder.Where(k => !_colHidden.Contains(k));
    private static string ColLabel(string k) => Catalogo.First(c => c.Key == k).Label;

    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "asunto", Label = "Asunto", Kind = "texto" },
        new() { Key = "tipo", Label = "Tipo", Kind = "sel",
                Opciones = Enum.GetValues<TipoComunicadoBase>().Select(t => (t.ToString(), t.ToString())).ToList() },
        new() { Key = "estado", Label = "Estado", Kind = "sel",
                Opciones = Enum.GetValues<EstadoComunicado>().Select(e => (e.ToString(), e.ToString())).ToList() },
        new() { Key = "segmento", Label = "Segmento", Kind = "texto" },
        new() { Key = "fecha", Label = "Fecha", Kind = "fecha" },
    };

    private static readonly (string, string)[] AgruparOpciones =
    {
        ("", "Sin agrupar"), ("estado", "Estado"), ("tipo", "Tipo"),
    };
    private static string AgruparLabel(string v) => v switch { "estado" => "Estado", "tipo" => "Tipo", _ => "" };

    private IReadOnlyList<ComunicadoListaDto> Items => _lista ?? (IReadOnlyList<ComunicadoListaDto>)Array.Empty<ComunicadoListaDto>();

    private static DateTimeOffset FechaDe(ComunicadoListaDto c) => c.FechaEnvio ?? c.FechaProgramada ?? c.CreadoAt;

    private string? ValorCrudo(ComunicadoListaDto c, string key) => key switch
    {
        "asunto" => c.Asunto,
        "tipo" => c.TipoComunicado.ToString(),
        "segmento" => c.SegmentoResumen,
        "estado" => c.Estado.ToString(),
        "fecha" => FechaDe(c).LocalDateTime.ToString("yyyy-MM-dd"),
        _ => null,
    };

    private List<ComunicadoListaDto> Filtrados
    {
        get
        {
            var q = Items.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_query))
                q = q.Where(c => c.Asunto.Contains(_query, StringComparison.OrdinalIgnoreCase));
            if (_fd is not null)
                q = q.Where(c => _fd.Pasa(key => ValorCrudo(c, key)));
            return Ordenar(q).ToList();
        }
    }

    private IEnumerable<ComunicadoListaDto> Ordenar(IEnumerable<ComunicadoListaDto> src) => _sortCol switch
    {
        "asunto" => _sortAsc ? src.OrderBy(c => c.Asunto) : src.OrderByDescending(c => c.Asunto),
        "tipo" => _sortAsc ? src.OrderBy(c => c.TipoComunicado.ToString()) : src.OrderByDescending(c => c.TipoComunicado.ToString()),
        "segmento" => _sortAsc ? src.OrderBy(c => c.SegmentoResumen) : src.OrderByDescending(c => c.SegmentoResumen),
        "estado" => _sortAsc ? src.OrderBy(c => c.Estado.ToString()) : src.OrderByDescending(c => c.Estado.ToString()),
        "acuse" => _sortAsc ? src.OrderBy(c => c.TasaApertura ?? -1m) : src.OrderByDescending(c => c.TasaApertura ?? -1m),
        _ => _sortAsc ? src.OrderBy(FechaDe) : src.OrderByDescending(FechaDe),
    };

    private IEnumerable<IGrouping<string, ComunicadoListaDto>> Grupos =>
        Filtrados.GroupBy(GrupoClave).OrderBy(g => g.Key);

    private string GrupoClave(ComunicadoListaDto c) => _agruparPor switch
    {
        "estado" => c.Estado.ToString(),
        "tipo" => c.TipoComunicado.ToString(),
        _ => "",
    };

    private IEnumerable<ComunicadoListaDto> Pagina =>
        Filtrados.Skip((_pagina - 1) * _porPagina).Take(_porPagina);

    private void Ordenar(string k)
    {
        if (_sortCol == k) _sortAsc = !_sortAsc;
        else { _sortCol = k; _sortAsc = true; }
    }

    private void SetAgrupar(string v) { _agruparPor = v; _showAgrupar = false; _pagina = 1; }

    private void MoverCol(int idx, int delta)
    {
        var j = idx + delta;
        if (j < 0 || j >= _colOrder.Count) return;
        (_colOrder[idx], _colOrder[j]) = (_colOrder[j], _colOrder[idx]);
    }

    private void SetColVisible(string key, bool visible)
    {
        if (!Catalogo.First(c => c.Key == key).Hideable) return;
        if (visible) _colHidden.Remove(key); else _colHidden.Add(key);
    }

    private void MostrarTodo() => _colHidden.Clear();
    private void OcultarTodo()
    {
        _colHidden.Clear();
        foreach (var c in Catalogo.Where(c => c.Hideable)) _colHidden.Add(c.Key);
    }

    private RenderFragment RenderFila(ComunicadoListaDto c) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "tr");
        // Expander (abre la ficha)
        builder.OpenElement(seq++, "td");
        builder.AddAttribute(seq++, "class", "com-td-exp");
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "com-exp");
        builder.AddAttribute(seq++, "title", "Abrir el comunicado");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => AbrirFicha(c.Id)));
        builder.AddMarkupContent(seq++, "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7\"/></svg>");
        builder.CloseElement();
        builder.CloseElement();

        foreach (var key in ColsVisibles)
        {
            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", key == "asunto" ? "com-td-asunto" : "");
            builder.AddAttribute(seq++, "style", "cursor:pointer;");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => AbrirFicha(c.Id)));
            builder.AddContent(seq++, CeldaContenido(c, key));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment CeldaContenido(ComunicadoListaDto c, string key) => builder =>
    {
        switch (key)
        {
            case "asunto":
                builder.OpenElement(0, "strong");
                builder.AddContent(1, c.Asunto);
                builder.CloseElement();
                break;
            case "tipo":
                builder.AddContent(0, RenderTipo(c.TipoComunicado));
                break;
            case "segmento":
                builder.AddContent(0, c.SegmentoResumen);
                break;
            case "fecha":
                builder.AddContent(0, FechaDe(c).LocalDateTime.ToString("yyyy-MM-dd HH:mm"));
                break;
            case "estado":
                builder.AddContent(0, RenderEstado(c.Estado));
                break;
            case "acuse":
                if (c.RequiereAcuse && c.Estado == EstadoComunicado.Enviado && c.TotalDestinatarios > 0)
                {
                    var pct = c.TasaApertura ?? 0m;
                    builder.AddMarkupContent(0, $"<div class=\"progress\" style=\"height:6px;width:100px;\"><div class=\"progress-bar bg-success\" style=\"width:{pct}%\"></div></div><small class=\"text-muted\">{c.TotalAbiertos}/{c.TotalDestinatarios} ({pct:0.0}%)</small>");
                }
                else { builder.AddMarkupContent(0, "<small class=\"text-muted\">-</small>"); }
                break;
        }
    };

    private bool _showCrear;
    private int _paso = 1;
    private PlantillaDto? _plantillaSeleccionada;
    private Guid? _borradorId;
    private TipoComunicadoBase _crearTipo = TipoComunicadoBase.Circular;
    private string? _crearAsunto;
    private string? _crearCuerpoHtml;
    private bool _crearRequiereAcuse;
    private string _segmentoTipo = "Broadcast";
    private List<SegmentoDto> _segmentosActuales = new();
    private PreviewDestinatariosDto? _preview;
    private bool _envioInmediato = true;
    private DateTimeOffset? _fechaProgramada;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _resumen = await http.GetFromJsonAsync<ResumenComunicacionesDto>("/api/comunicaciones/resumen");
            // Carga completa: el filtrado/busqueda/orden/agrupacion se hacen client-side (canon vista tabla).
            _lista = await http.GetFromJsonAsync<List<ComunicadoListaDto>>("/api/comunicaciones") ?? new();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task AbrirCrear()
    {
        _showCrear = true;
        _paso = 1;
        _borradorId = null;
        _plantillaSeleccionada = null;
        _crearAsunto = _crearCuerpoHtml = null;
        _crearTipo = TipoComunicadoBase.Circular;
        _crearRequiereAcuse = false;
        _segmentosActuales.Clear();
        _preview = null;
        _envioInmediato = true;
        _fechaProgramada = null;
        try
        {
            // Listar TODAS las plantillas (globales + tenant). Si se quisiera solo tenant, usar ?soloGlobales=false.
            _plantillas = await Auth().GetFromJsonAsync<List<PlantillaDto>>("/api/comunicaciones/plantillas");
        }
        catch { _plantillas = new(); }
    }

    private void UsarPlantilla(Guid id)
    {
        var p = _plantillas?.FirstOrDefault(x => x.Id == id);
        if (p is null) return;
        _plantillaSeleccionada = p;
        _crearTipo = p.TipoComunicado;
        _crearAsunto = p.AsuntoModelo;
        _crearCuerpoHtml = p.CuerpoModelo;
        _crearRequiereAcuse = p.AcusePorDefecto;
    }

    private async Task GuardarYAvanzar()
    {
        _busy = true; _msg = null;
        try
        {
            if (_borradorId is null)
            {
                var req = new CrearBorradorRequest(_plantillaSeleccionada?.Id, _crearTipo,
                    _crearAsunto!, _crearCuerpoHtml!, null, _crearRequiereAcuse);
                var resp = await Auth().PostAsJsonAsync("/api/comunicaciones", req);
                if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
                var det = await resp.Content.ReadFromJsonAsync<ComunicadoDetalleDto>();
                _borradorId = det!.Id;
            }
            else
            {
                var req = new ActualizarBorradorRequest(_crearTipo, _crearAsunto!, _crearCuerpoHtml!, null, _crearRequiereAcuse);
                await Auth().PutAsJsonAsync($"/api/comunicaciones/{_borradorId}", req);
            }
            _paso = 3;
        }
        finally { _busy = false; }
    }

    private async Task AgregarSegmento()
    {
        if (_borradorId is null) return;
        var tipo = Enum.Parse<TipoSegmento>(_segmentoTipo);
        var req = new AgregarSegmentoRequest(tipo, "{}");
        var resp = await Auth().PostAsJsonAsync($"/api/comunicaciones/{_borradorId}/segmentos", req);
        if (resp.IsSuccessStatusCode)
        {
            var seg = await resp.Content.ReadFromJsonAsync<SegmentoDto>();
            if (seg is not null)
            {
                // Si fue Broadcast, los demas fueron removidos en el backend
                if (tipo == TipoSegmento.Broadcast) _segmentosActuales.Clear();
                _segmentosActuales.Add(seg);
            }
            _preview = await Auth().GetFromJsonAsync<PreviewDestinatariosDto>($"/api/comunicaciones/{_borradorId}/preview-destinatarios");
        }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    private async Task ConfirmarEnviar()
    {
        if (_borradorId is null) return;
        _busy = true;
        try
        {
            var req = new EnviarRequest(_envioInmediato ? null : _fechaProgramada);
            var resp = await Auth().PostAsJsonAsync($"/api/comunicaciones/{_borradorId}/enviar", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = _envioInmediato ? "Comunicado enviado." : "Comunicado programado."; _msgClass = "alert-success";
            CerrarCrear();
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private void CerrarCrear() { _showCrear = false; _borradorId = null; _segmentosActuales.Clear(); }

    private async Task AbrirFicha(Guid id)
    {
        try
        {
            _ficha = await Auth().GetFromJsonAsync<ComunicadoDetalleDto>($"/api/comunicaciones/{id}");
            _acuses = (_ficha?.RequiereAcuse == true && _ficha.Estado == EstadoComunicado.Enviado)
                ? await Auth().GetFromJsonAsync<AcuseListaDto>($"/api/comunicaciones/{id}/acuses")
                : null;
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task CancelarComunicado(Guid id)
    {
        var resp = await Auth().PostAsJsonAsync($"/api/comunicaciones/{id}/cancelar", new CancelarRequest("Cancelado por administrador"));
        if (resp.IsSuccessStatusCode) { _ficha = null; await CargarAsync(); }
    }

    private async Task ReenviarPendientes(Guid id)
    {
        var resp = await Auth().PostAsync($"/api/comunicaciones/{id}/reenviar-pendientes", null);
        if (resp.IsSuccessStatusCode)
        {
            _msg = "Reenvio encolado a destinatarios pendientes."; _msgClass = "alert-success";
        }
    }

    private MarkupString RenderTipo(TipoComunicadoBase t) => t switch
    {
        TipoComunicadoBase.Circular => new MarkupString("<span class='badge bg-secondary'>Circular</span>"),
        TipoComunicadoBase.AvisoOperativo => new MarkupString("<span class='badge bg-info'>Aviso</span>"),
        TipoComunicadoBase.AnuncioGeneral => new MarkupString("<span class='badge bg-primary'>Anuncio</span>"),
        TipoComunicadoBase.ComunicadoUrgente => new MarkupString("<span class='badge bg-danger'>Urgente</span>"),
        _ => new MarkupString("")
    };

    private MarkupString RenderEstado(EstadoComunicado e) => e switch
    {
        EstadoComunicado.Borrador => new MarkupString("<span class='badge bg-light text-dark'>Borrador</span>"),
        EstadoComunicado.Programado => new MarkupString("<span class='badge bg-warning text-dark'>Programado</span>"),
        EstadoComunicado.Enviando => new MarkupString("<span class='badge bg-info'>Enviando</span>"),
        EstadoComunicado.Enviado => new MarkupString("<span class='badge bg-success'>Enviado</span>"),
        EstadoComunicado.Cancelado => new MarkupString("<span class='badge bg-dark'>Cancelado</span>"),
        _ => new MarkupString("")
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}
