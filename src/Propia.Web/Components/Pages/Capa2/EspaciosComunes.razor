@page "/espacios"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@* Union de "Zonas Comunes" y "Equipos y Activos" en una sola pagina con dos tabs.
   Reutiliza EXACTAMENTE los mismos componentes/funcionalidades: cada tab renderiza el
   panel extraido del modulo original (ZonasComunesPanel / EquiposActivosPanel). Las rutas
   /zonas-comunes y /equipos-activos siguen funcionando por separado (sus wrappers). *@

<PageTitle>Equipos y zonas comunes - PROPIA</PageTitle>

<div class="ez-tabs">
    <button type="button" class="ez-tab @(_tab == "zonas" ? "on" : "")" @onclick='() => _tab = "zonas"'>
        <i class="fi fi-rr-trees"></i> Zonas Comunes
    </button>
    <button type="button" class="ez-tab @(_tab == "equipos" ? "on" : "")" @onclick='() => _tab = "equipos"'>
        <i class="fi fi-rr-settings"></i> Equipos y Activos
    </button>
</div>

@* Solo se monta el tab activo (evita doble carga de datos). Al cambiar de tab se recarga
   ese modulo, con su comportamiento identico al de su pagina propia. *@
@if (_tab == "zonas")
{
    <ZonasComunesPanel />
}
else
{
    <EquiposActivosPanel />
}

@code {
    private string _tab = "zonas";
}

<style>
    .ez-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--propia-border-card); margin: 0 0 4px; padding: 0 4px; }
    .ez-tab {
        display: inline-flex; align-items: center; gap: 7px;
        background: none; border: none; cursor: pointer;
        padding: 12px 18px 13px; font-size: 14px; font-weight: 600; color: var(--propia-text-muted);
        border-bottom: 2.5px solid transparent; margin-bottom: -1px; font-family: inherit;
        transition: color .15s, border-color .15s;
    }
    .ez-tab i { font-size: 15px; }
    .ez-tab:hover { color: var(--propia-primary, var(--propia-brand)); }
    .ez-tab.on { color: var(--propia-primary, var(--propia-brand)); border-bottom-color: var(--propia-primary, var(--propia-brand)); }
</style>
