@page "/ia/lista-negra"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.InfraestructuraIa
@using Propia.Application.MiCopropiedad
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Lista negra - PROPIA</PageTitle>

@* Modulo IA - Lista negra global del tenant (portado de CUBOT.travels).
   Numeros que ningun agente de IA debe atender. La consulta el dispatcher antes de cada respuesta. *@

<div class="ln-page">
    <div class="ln-head">
        <div>
            <h1 class="ln-title">Lista negra</h1>
            <p class="ln-sub">Números que ningun agente de IA debe atender. Compartida por todos los agentes del tenant.</p>
        </div>
    </div>

    @if (!_authChecked)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else if (string.IsNullOrEmpty(_jwt))
    {
        <div class="ln-empty">Sesión expirada. <a href="/login?returnUrl=%2Fia%2Flista-negra">Iniciar sesión</a>.</div>
    }
    else
    {
    <div class="ln-add">
        <input class="ln-input" @bind="_telefono" @bind:event="oninput" placeholder="Teléfono (ej. 573001234567 o +57 300 123 4567)" />
        <input class="ln-input ln-input--note" @bind="_nota" @bind:event="oninput" placeholder="Nota opcional (motivo, contexto)" />
        <button class="ln-btn-brand" type="button" @onclick="BloquearAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_telefono))">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 13l4 4L19 7"/></svg>
            Bloquear
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="ln-msg @(_msgError ? "ln-msg--err" : "ln-msg--ok")">@_msg</div>
    }

    @if (_items is null)
    {
        <div class="ln-loading">Cargando...</div>
    }
    else if (_items.Count == 0)
    {
        <div class="ln-empty">No hay números bloqueados todavia. Agrega el primero arriba.</div>
    }
    else
    {
        <div style="overflow-x:auto">
        <table class="ln-table">
            <colgroup>
                @foreach (var key in ColsVisibles) { <col style="@ColStyle(key)" /> }
                <col style="width:130px" />
            </colgroup>
            <thead>
                <tr>
                    @foreach (var key in ColsVisibles)
                    {
                        var k = key;
                        <th data-clave="@k" title="Arrastra: mover columna" @onmousedown="e => IniciarReorder(e, k)">
                            @ColLabel(k)
                            <span class="ln-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, k)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResize(k)" @ondblclick:stopPropagation="true"></span>
                        </th>
                    }
                    <th class="ln-th-right">Accion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in _items)
                {
                    var nn = n;
                    <tr>
                        @foreach (var key in ColsVisibles) { <td class="@CeldaClass(key)">@CeldaContenido(nn, key)</td> }
                        <td class="ln-cel-acc">
                            <button class="ln-btn-ghost-danger" type="button" @onclick="@(() => DesbloquearAsync(nn.Id))" disabled="@_busy">
                                Desbloquear
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    }
</div>

<style>
    .ln-page { padding: 22px 28px; font-family: var(--propia-font-base, 'Lexend', sans-serif); }
    .ln-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
    .ln-title { font-size: 27px; font-weight: 800; letter-spacing: -0.6px; color: var(--propia-text-h1); margin: 0; }
    .ln-sub { font-size: 14px; color: var(--propia-text-muted); margin: 4px 0 0; }
    .ln-empty { background: var(--propia-bg-app); border: 1px dashed var(--propia-border-input); border-radius: 12px; padding: 30px; text-align: center; color: var(--propia-text-faint); }
    .ln-loading { padding: 30px; text-align: center; color: var(--propia-text-faint); }

    .ln-add { display: flex; gap: 9px; margin-bottom: 14px; flex-wrap: wrap; }
    .ln-input { border: 1.5px solid var(--propia-border-card); border-radius: 9px; padding: 10px 12px; font-size: 13.5px; color: var(--propia-text-body); font-family: inherit; outline: none; background: var(--propia-bg-card); min-width: 240px; }
    .ln-input--note { flex: 1; min-width: 280px; }
    .ln-input:focus { border-color: var(--propia-brand, var(--propia-brand)); }
    .ln-btn-brand {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 10px 18px; border-radius: 9px; border: 0;
        background: var(--propia-brand, var(--propia-brand)); color: var(--propia-text-inverse);
        font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
        box-shadow: 0 4px 12px rgba(109,79,227,.25);
    }
    .ln-btn-brand:hover { background: var(--propia-brand-hover, var(--propia-brand-hover)); }
    .ln-btn-brand:disabled { opacity: .55; cursor: not-allowed; }

    .ln-msg { margin: 6px 0 14px; padding: 10px 14px; border-radius: 9px; font-size: 12.5px; font-weight: 600; }
    .ln-msg--ok { background: var(--propia-ok-soft); color: #15703F; }
    .ln-msg--err { background: #FEE2E2; color: #B91C1C; }

    .ln-table { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--propia-bg-card); border: 1px solid var(--propia-border-divider); border-radius: 12px; overflow: hidden; }
    .ln-table thead { background: var(--propia-bg-hover); }
    .ln-table th { position: relative; font-size: 11px; font-weight: 800; color: var(--propia-text-muted); text-transform: uppercase; letter-spacing: .4px; padding: 11px 16px; text-align: left; border-bottom: 1px solid var(--propia-border-divider); }
    /* Handle de redimensionar (= .mas-col-rz del canon); la guia la pinta el JS compartido propiaTablaResize.
       El cursor grab del th lo da [data-clave] (tabla-base.css). */
    .ln-col-rz { position: absolute; top: 0; right: -4px; width: 8px; height: 100%; cursor: col-resize; z-index: 3; }
    .ln-col-rz::after { content: ""; position: absolute; top: 6px; bottom: 6px; left: 3px; width: 2px; border-radius: 2px; background: transparent; transition: background .12s; }
    .ln-col-rz:hover::after { background: var(--propia-brand); }
    .ln-table td { font-size: 13px; color: var(--propia-text-body); padding: 11px 16px; border-bottom: 1px solid var(--propia-border-divider); }
    .ln-table tbody tr:last-child td { border-bottom: 0; }
    .ln-th-right, .ln-cel-acc { text-align: right; }
    .ln-cel-tel { font-weight: 700; color: var(--propia-text-h1); }
    .ln-cel-fecha { color: var(--propia-text-muted); font-size: 12px; }
    .ln-btn-ghost-danger {
        padding: 5px 12px; border-radius: 7px;
        border: 1px solid #FECACA; background: var(--propia-bg-card);
        font-size: 11.5px; font-weight: 700; color: #B91C1C;
        cursor: pointer; font-family: inherit;
    }
    .ln-btn-ghost-danger:hover { background: #FEE2E2; }
    .ln-btn-ghost-danger:disabled { opacity: .55; cursor: not-allowed; }
</style>

@code {
    private string? _jwt;
    private bool _authChecked;
    private List<NumeroEnListaNegraDto>? _items;
    private string _telefono = "";
    private string _nota = "";
    private bool _busy;
    private string? _msg;
    private bool _msgError;

    // ===== Columnas: catalogo + config (orden/ancho) por copropiedad, entidad 'listanegra' =====
    private sealed record ColDef(string Key, string Label);
    private static readonly ColDef[] Catalogo = { new("tel", "Teléfono"), new("nota", "Nota"), new("fecha", "Bloqueado el") };
    private List<string> _colOrder = Catalogo.Select(c => c.Key).ToList();
    private const string EntCfg = "listanegra";
    private Dictionary<string, UnidadCampoConfigDto> _cfg = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _colW = new(StringComparer.Ordinal);
    private DotNetObjectReference<IaListaNegra>? _self;
    private IEnumerable<string> ColsVisibles => _colOrder;
    private static string ColLabel(string k) => Catalogo.First(c => c.Key == k).Label;
    private static string CeldaClass(string k) => k switch { "tel" => "ln-cel-tel", "fecha" => "ln-cel-fecha", _ => "" };
    private RenderFragment CeldaContenido(NumeroEnListaNegraDto n, string key) => builder =>
    {
        switch (key)
        {
            case "tel": builder.AddContent(0, FormatoTelefono(n.Telefono)); break;
            case "nota": builder.AddContent(0, n.Nota ?? "-"); break;
            case "fecha": builder.AddContent(0, n.CreatedAt.ToCo().ToString("dd MMM yyyy HH:mm")); break;
        }
    };

    private UnidadCampoConfigDto? CfgDe(string k) => _cfg.TryGetValue(k, out var c) ? c : null;
    private GuardarUnidadCampoConfigRequest FilaConfig(string clave)
    {
        var c = CfgDe(clave);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato, Oculto: c?.Oculto ?? false, Orden: c?.Orden, Entidad: EntCfg);
    }
    private async Task GuardarCfg(GuardarUnidadCampoConfigRequest req)
    { try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { } }
    private async Task CargarConfigAsync()
    {
        try
        {
            var lista = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>($"/api/mi-copropiedad/unidades-config?entidad={EntCfg}") ?? new();
            _cfg = lista.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
        }
        catch { _cfg = new(StringComparer.Ordinal); }
        _colOrder = Catalogo.Select((c, i) => (c.Key, ord: CfgDe(c.Key)?.Orden ?? (1000 + i)))
                            .OrderBy(x => x.ord).Select(x => x.Key).ToList();
        HidratarAnchos();
    }
    private void HidratarAnchos()
    {
        _colW.Clear();
        foreach (var kv in _cfg) { var w = AnchoDeFormato(kv.Value.Formato); if (w is > 0) _colW[kv.Key] = w.Value; }
    }
    private static int? AnchoDeFormato(string? json)
    { try { var o = System.Text.Json.Nodes.JsonNode.Parse(json ?? "") as System.Text.Json.Nodes.JsonObject; return o?["w"]?.GetValue<int>(); } catch { return null; } }
    private static string? ConAncho(string? json, int? w)
    {
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(json) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (w is null) o.Remove("w"); else o["w"] = w.Value;
        return o.Count == 0 ? null : o.ToJsonString();
    }
    private string ColStyle(string k) => $"width:{(_colW.TryGetValue(k, out var w) ? w : AnchoDefault(k))}px";
    private static int AnchoDefault(string k) => k switch { "nota" => 320, "fecha" => 190, _ => 200 };

    private async Task IniciarReorder(MouseEventArgs e, string k)
    { _self ??= DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _self, k, e.ClientX, e.ClientY); } catch { } }
    [JSInvokable]
    public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        var keys = _colOrder.ToList();
        var from = keys.IndexOf(src); var to = keys.IndexOf(dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, src);
        for (int i = 0; i < keys.Count; i++) await GuardarCfg(FilaConfig(keys[i]) with { Orden = i });
        await CargarConfigAsync(); StateHasChanged();
    }
    private async Task IniciarResize(MouseEventArgs e, string k)
    { _self ??= DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("propiaTablaResize.start", _self, k, e.ClientX); } catch { } }
    private Task ResetResize(string k) => OnColResize(k, 0);
    [JSInvokable]
    public async Task OnColResize(string clave, int width)
    {
        int? w = width <= 0 ? null : Math.Max(70, width);
        if (w is null) _colW.Remove(clave); else _colW[clave] = w.Value;
        await GuardarCfg(FilaConfig(clave) with { Formato = ConAncho(CfgDe(clave)?.Formato, w) });
        await CargarConfigAsync(); StateHasChanged();
    }
    public void Dispose() { _self?.Dispose(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true; }
            catch { _jwt = null; }
            if (!string.IsNullOrEmpty(_jwt)) await CargarAsync();
            StateHasChanged();
        }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        if (string.IsNullOrEmpty(_jwt)) return;
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/ia/lista-negra");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevoJwt)) return;
                _jwt = nuevoJwt;
                http = Auth();
                resp = await http.GetAsync("/api/ia/lista-negra");
            }
            resp.EnsureSuccessStatusCode();
            _items = await resp.Content.ReadFromJsonAsync<List<NumeroEnListaNegraDto>>() ?? new();
            await CargarConfigAsync();   // orden/ancho de columnas por copropiedad
        }
        catch (Exception ex) { Toast(ex.Message, true); }
    }

    private async Task BloquearAsync()
    {
        if (string.IsNullOrWhiteSpace(_telefono)) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/ia/lista-negra",
                new AgregarNumeroBloqueadoRequest(_telefono.Trim(), string.IsNullOrWhiteSpace(_nota) ? null : _nota.Trim()));
            if (resp.IsSuccessStatusCode)
            {
                _telefono = "";
                _nota = "";
                await CargarAsync();
                Toast("Número bloqueado.", false);
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Toast("No se pudo bloquear: " + err, true);
            }
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

    private async Task DesbloquearAsync(Guid id)
    {
        _busy = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/ia/lista-negra/{id}");
            if (resp.IsSuccessStatusCode)
            {
                await CargarAsync();
                Toast("Número desbloqueado.", false);
            }
            else { Toast("No se pudo desbloquear.", true); }
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

    private void Toast(string m, bool err) { _msg = m; _msgError = err; }

    private static string FormatoTelefono(string digits)
    {
        if (digits.Length == 12 && digits.StartsWith("57"))
        {
            return $"+57 {digits.Substring(2, 3)} {digits.Substring(5, 3)} {digits.Substring(8)}";
        }
        if (digits.Length == 10) return $"+57 {digits.Substring(0, 3)} {digits.Substring(3, 3)} {digits.Substring(6)}";
        return "+" + digits;
    }
}
