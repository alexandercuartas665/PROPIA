@page "/residentes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.MiCopropiedad
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Residentes - PROPIA</PageTitle>

@* Residentes: vista agregada de TODAS las personas de las unidades (propietarios, residentes,
   arrendatarios, familiares, apoderados). Misma vista tabla estandar del sistema: barra de
   filtros + agrupacion + columnas, expander por fila, alta inline al pie y footer con paginacion.
   Toda alta reutiliza el endpoint de Unidades Privadas, que ya asegura el registro en Directorio. *@

<div class="res-pagehead">
    <h1 class="res-pagetitle">Residentes</h1>
    <p class="res-pagesub">Todas las personas de las unidades de @(_copNombre ?? "la copropiedad"). Cada registro queda tambien en el Directorio.</p>
</div>

@if (!_authChecked || _jwt is null)
{
    <div class="res-loading"><div class="spinner-border" style="color: var(--propia-brand, #6D4FE3);"></div></div>
}
else
{
    @* ===== Barra estandar: Filtros + buscador + Agrupar + Columnas ===== *@
    <div class="res-filtros">
        <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="@(() => { _pagina = 1; StateHasChanged(); })" />
        <div class="res-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="res-search-inp" placeholder="Buscar por nombre, documento o unidad..."
                   @oninput="@(e => { _q = e.Value?.ToString() ?? string.Empty; _pagina = 1; })" />
        </div>
        <div class="res-filtros-spacer"></div>

        @* Agrupar *@
        <div class="res-menu-wrap">
            <button type="button" class="res-fbtn @(_agruparPor != "" ? "on" : "")" @onclick="() => _showAgrupar = !_showAgrupar" title="Agrupar residentes">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <span>Agrupar@(_agruparPor != "" ? ": " + AgruparLabel(_agruparPor) : "")</span>
            </button>
            @if (_showAgrupar)
            {
                <div class="res-menu-bd" @onclick="() => _showAgrupar = false"></div>
                <div class="res-menu">
                    @foreach (var g in new[] { ("", "Sin agrupar"), ("rol", "Rol"), ("unidad", "Unidad"), ("torre", "Torre") })
                    {
                        var gk = g.Item1;
                        <button class="res-menu-it @(_agruparPor == gk ? "on" : "")" @onclick="() => SetAgrupar(gk)">@g.Item2</button>
                    }
                </div>
            }
        </div>

        @* Columnas *@
        <div class="res-menu-wrap">
            <button type="button" class="res-fbtn @(_showCols ? "on" : "")" @onclick="() => _showCols = !_showCols" title="Campos y columnas de la tabla">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                <span>Columnas</span>
            </button>
            @if (_showCols)
            {
                <div class="res-menu-bd" @onclick="() => _showCols = false"></div>
                <div class="res-colsmenu">
                    <div class="res-colsmenu-h">COLUMNAS (orden, visibilidad y nombre)</div>
                    @for (int i = 0; i < _colOrder.Count; i++)
                    {
                        var idx = i;
                        var col = Catalogo.First(c => c.Key == _colOrder[idx]);
                        var pref = PrefDe(col.Key);
                        var key = col.Key;
                        <div class="res-colsmenu-i">
                            <div class="res-colsmenu-ord">
                                <button class="res-colsmenu-mv" disabled="@(idx == 0)" @onclick="() => MoverCol(idx, -1)" title="Subir">&#9650;</button>
                                <button class="res-colsmenu-mv" disabled="@(idx == _colOrder.Count - 1)" @onclick="() => MoverCol(idx, 1)" title="Bajar">&#9660;</button>
                            </div>
                            <label class="res-cfg-vis" title="@(col.Hideable ? "Mostrar u ocultar" : "Columna requerida, siempre visible")">
                                <input type="checkbox" checked="@pref.Visible" disabled="@(!col.Hideable)" @onchange="@(e => SetColVisible(key, (bool)(e.Value ?? false)))" />
                            </label>
                            <input class="res-cfg-inp" value="@(string.IsNullOrWhiteSpace(pref.Label) ? col.DefLabel : pref.Label)" placeholder="@col.DefLabel" @onchange="@(e => SetColLabel(key, e.Value?.ToString()))" />
                            @if (!col.Hideable) { <span class="res-cfg-req">fija</span> }
                        </div>
                    }
                    <div class="res-colsmenu-acts">
                        <button type="button" class="res-colsmenu-act" @onclick="RestablecerCols">Restablecer</button>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_msg)) { <div class="res-msg @(_msgError ? "err" : "ok")">@_msg</div> }

    @* ===== Tabla ===== *@
    <div class="res-table">
        <div class="res-scroll">
            <div class="res-head res-grid" style="grid-template-columns:@GridCols">
                <div></div>
                @foreach (var c in ColsVisibles) { <div class="@(c.Center ? "res-c" : "")">@Etiqueta(c)</div> }
                <div></div>
            </div>

            @foreach (var item in FilasRender())
            {
                if (item.EsGrupo)
                {
                    <div class="res-group">
                        <span class="res-group-chip">@item.GrupoTitulo</span>
                        <span class="res-group-n">@item.GrupoCount</span>
                    </div>
                    continue;
                }
                var r = item.Fila!;
                <div class="res-row res-grid" style="grid-template-columns:@GridCols">
                    <div class="res-exp-col">
                        <button type="button" class="res-exp" title="Abrir la ficha en el Directorio" @onclick="() => AbrirFicha(r)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @foreach (var c in ColsVisibles)
                    {
                        switch (c.Key)
                        {
                            case "unidad": <div class="res-c-cell"><span class="res-cod">@r.UnidadCodigo</span></div>; break;
                            case "nombre": <div class="res-c-cell res-nom">@r.Nombre @if (r.EntidadTipo == EntidadDirectorio.Empresa) { <span class="res-tag">Empresa</span> }</div>; break;
                            case "documento": <div class="res-c-cell">@r.Documento</div>; break;
                            case "rol": <div class="res-c-cell res-c">@RolBadge(r.Rol)</div>; break;
                            case "telefono": <div class="res-c-cell res-mut">@(string.IsNullOrWhiteSpace(r.Telefono) ? "-" : r.Telefono)</div>; break;
                            case "email": <div class="res-c-cell res-mut">@(string.IsNullOrWhiteSpace(r.Email) ? "-" : r.Email)</div>; break;
                            case "habita": <div class="res-c-cell res-c">@(r.Habita ? "Si" : "No")</div>; break;
                        }
                    }
                    <div></div>
                </div>
            }

            @* Alta inline al pie, alineada a las columnas (misma logica que el modal de Unidades
               Privadas: se escribe la persona y se hace buscar-o-crear por documento; asi tambien
               queda en el Directorio). El expander crea y abre la ficha; "+ Agregar" solo crea. *@
            <div class="res-newrow res-grid" style="grid-template-columns:@GridCols">
                <div class="res-exp-col">
                    <button type="button" class="res-exp res-exp-nf" tabindex="-1" title="Agregar y abrir la ficha" @onclick="() => AgregarAsync(true)" disabled="@(_busy || !AltaValida)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                </div>
                @foreach (var c in ColsVisibles)
                {
                    switch (c.Key)
                    {
                        case "unidad":
                            <div class="res-nf-unidad">
                                <input class="res-nf-inp" placeholder="Ej. A1-101" @bind="_unidadQuery" @bind:event="oninput" @onfocus="() => _unidadDrop = true" autocomplete="off" />
                                @if (_unidadDrop && UnidadesFiltradas().Any())
                                {
                                    <div class="res-drop">
                                        @foreach (var u in UnidadesFiltradas())
                                        {
                                            <button type="button" class="res-drop-it" @onclick="() => ElegirUnidad(u)">
                                                <span class="res-drop-cod">@CodigoUnidad(u)</span>
                                                <span class="res-drop-meta">@u.Tipo@(u.PropietarioNombre is { Length: > 0 } pn ? " - " + pn : "")</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            break;
                        case "nombre":
                            @* Control de terceros: busca en el Directorio de la organizacion y, si no
                               existe, lo crea ahi mismo. El panel FLOTA (position:fixed) para no
                               deformar la celda. Toda persona nace del Directorio por esta via. *@
                            <div class="res-nf-persona">
                                <SelectorPersona @bind-Seleccionada="_personaSel" Jwt="@_jwt" PermiteEmpresa="true" Flotante="true" Placeholder="Buscar o crear tercero..." />
                            </div>
                            break;
                        case "documento":
                            <div class="res-nf-ro">@(_personaSel is null ? "" : $"{_personaSel.TipoDocumento} {_personaSel.DocumentoEnmascarado}")</div>
                            break;
                        case "rol":
                            <select class="res-nf-inp" @bind="_rolNuevo">
                                @foreach (var r in Enum.GetValues<RolUnidadPersona>()) { <option value="@r">@RolLabel(r)</option> }
                            </select>
                            break;
                        case "telefono":
                            <div class="res-nf-ro"></div>
                            break;
                        case "email":
                            <div class="res-nf-ro"></div>
                            break;
                        case "habita":
                            <label class="res-nf-habchk" title="Reside en la unidad"><input type="checkbox" @bind="_habitaNuevo" /> <span>Si</span></label>
                            break;
                    }
                }
                <div class="res-nf-act">
                    <button type="button" class="res-nf-add" @onclick="() => AgregarAsync(false)" disabled="@(_busy || !AltaValida)">@(_busy ? "..." : "+ Agregar")</button>
                </div>
            </div>

            @if (_residentes.Count > 0 && Filtrados.Count == 0)
            {
                <div class="res-empty">Ningun registro coincide con el filtro.</div>
            }
            else if (_residentes.Count == 0)
            {
                <div class="res-empty">Aun no hay personas en las unidades. Agrega la primera en la fila de arriba.</div>
            }
        </div>

        @* Footer canonico (solo sin agrupacion: agrupar y paginar juntos confunde). *@
        @if (_agruparPor == "")
        {
            <TablaPager Total="Filtrados.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="residentes"
                        PaginaChanged="p => { _pagina = p; }"
                        PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
        }
    </div>
}

@code {
    private bool _authChecked;
    private string? _jwt;
    private string? _copNombre;
    private bool _busy;
    private string _msg = "";
    private bool _msgError;

    private List<ResidenteResumenDto> _residentes = new();
    private List<UnidadDto> _unidades = new();

    // Filtros
    private FiltroDinamico? _fd;
    private string _q = "";

    // Agrupacion
    private string _agruparPor = "";
    private bool _showAgrupar;
    private const string AgruparKey = "propia_residentes_group";

    // Paginacion
    private int _porPagina = 25;
    private int _pagina = 1;

    // Columnas
    private bool _showCols;
    private const string ColsKey = "propia_residentes_cols";

    // Alta: la unidad por codigo (autocompletado) + la persona por el control de terceros
    // (SelectorPersona), que la busca/crea en el Directorio. El backend asegura el vinculo.
    private string _unidadQuery = "";
    private bool _unidadDrop;
    private PersonaCandidatoDto? _personaSel;
    private RolUnidadPersona _rolNuevo = RolUnidadPersona.Residente;
    private bool _habitaNuevo = true;

    // La unidad se resuelve por el codigo escrito (o elegido del desplegable): el boton se activa
    // aunque no se haya hecho clic en la sugerencia, siempre que el codigo exista.
    private UnidadDto? UnidadElegida =>
        _unidades.FirstOrDefault(u => string.Equals(CodigoUnidad(u), _unidadQuery.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool AltaValida => UnidadElegida is not null && _personaSel is not null;

    // ---------- Catalogo de columnas ----------
    private sealed record ColDef(string Key, string DefLabel, string Width, bool Hideable, bool Center = false);
    private static readonly ColDef[] Catalogo =
    {
        new("unidad", "UNIDAD", "150px", false),
        new("nombre", "NOMBRE", "1.4fr", false),
        new("documento", "DOCUMENTO", "1.1fr", false),
        new("rol", "ROL", "128px", false, true),
        new("telefono", "TELEFONO", "1.1fr", true),
        new("email", "EMAIL", "1.6fr", true),
        new("habita", "HABITA", "80px", true, true),
    };
    private sealed class ColPref { public bool Visible { get; set; } = true; public string? Label { get; set; } }
    private Dictionary<string, ColPref> _colPrefs = new();
    private List<string> _colOrder = Catalogo.Select(c => c.Key).ToList();

    private ColPref PrefDe(string key) => _colPrefs.TryGetValue(key, out var p) ? p : (_colPrefs[key] = new ColPref());
    private bool EsVisible(ColDef c) => !c.Hideable || !_colPrefs.TryGetValue(c.Key, out var p) || p.Visible;
    private string Etiqueta(ColDef c) => (_colPrefs.TryGetValue(c.Key, out var p) && !string.IsNullOrWhiteSpace(p.Label)) ? p.Label! : c.DefLabel;
    private IEnumerable<ColDef> ColsVisibles
    {
        get
        {
            var byKey = Catalogo.ToDictionary(c => c.Key);
            return _colOrder.Where(byKey.ContainsKey).Select(k => byKey[k]).Where(EsVisible);
        }
    }
    private string GridCols => "34px " + string.Join(" ", ColsVisibles.Select(c => c.Width)) + " 116px";

    private async Task SetColVisible(string key, bool vis) { PrefDe(key).Visible = vis; await GuardarColsAsync(); }
    private async Task SetColLabel(string key, string? label) { PrefDe(key).Label = string.IsNullOrWhiteSpace(label) ? null : label!.Trim(); await GuardarColsAsync(); }
    private async Task MoverCol(int idx, int dir)
    {
        var j = idx + dir;
        if (j < 0 || j >= _colOrder.Count) return;
        (_colOrder[idx], _colOrder[j]) = (_colOrder[j], _colOrder[idx]);
        await GuardarColsAsync();
    }
    private async Task RestablecerCols()
    {
        _colPrefs = new();
        _colOrder = Catalogo.Select(c => c.Key).ToList();
        await GuardarColsAsync();
    }
    private async Task GuardarColsAsync()
    {
        try
        {
            var data = new { order = _colOrder, prefs = _colPrefs.ToDictionary(k => k.Key, v => new { v.Value.Visible, v.Value.Label }) };
            await Js.InvokeVoidAsync("localStorage.setItem", ColsKey, System.Text.Json.JsonSerializer.Serialize(data));
        }
        catch { }
    }
    private async Task RestaurarColsAsync()
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", ColsKey);
            if (string.IsNullOrWhiteSpace(raw)) return;
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            if (doc.RootElement.TryGetProperty("order", out var ord) && ord.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                var keys = ord.EnumerateArray().Select(e => e.GetString()).Where(s => s is not null).Cast<string>().ToList();
                var valid = Catalogo.Select(c => c.Key).ToHashSet();
                _colOrder = keys.Where(valid.Contains).Concat(Catalogo.Select(c => c.Key).Where(k => !keys.Contains(k))).ToList();
            }
            if (doc.RootElement.TryGetProperty("prefs", out var pr) && pr.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var p in pr.EnumerateObject())
                {
                    var cp = new ColPref();
                    if (p.Value.TryGetProperty("Visible", out var v)) cp.Visible = v.GetBoolean();
                    if (p.Value.TryGetProperty("Label", out var l) && l.ValueKind == System.Text.Json.JsonValueKind.String) cp.Label = l.GetString();
                    _colPrefs[p.Name] = cp;
                }
            }
        }
        catch { }
    }

    // ---------- Carga / auth ----------
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (string.IsNullOrWhiteSpace(stored)) { Nav.NavigateTo("/login?returnUrl=%2Fresidentes", true); return; }
            _jwt = stored;
            await RestaurarColsAsync();
            try { var g = await Js.InvokeAsync<string?>("localStorage.getItem", AgruparKey); if (g is "rol" or "unidad" or "torre") _agruparPor = g; } catch { }
            await CargarAsync();
            StateHasChanged();
        }
        catch { /* prerender */ }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/residentes");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevoJwt)) return;
                _jwt = nuevoJwt; http = Auth();
                resp = await http.GetAsync("/api/mi-copropiedad/residentes");
            }
            resp.EnsureSuccessStatusCode();
            _residentes = await resp.Content.ReadFromJsonAsync<List<ResidenteResumenDto>>() ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            try { _copNombre = (await http.GetFromJsonAsync<ResumenMiCopropiedadDto>("/api/mi-copropiedad/resumen"))?.Identidad?.Nombre; } catch { }
        }
        catch (Exception ex) { _msg = "No se pudo cargar: " + ex.Message; _msgError = true; }
    }

    // ---------- Filtro dinamico de la tabla ----------
    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "rol", Label = "Rol", Kind = "sel",
                Opciones = Enum.GetValues<RolUnidadPersona>().Select(r => (r.ToString(), RolLabel(r))).ToList() },
        new() { Key = "unidad", Label = "Unidad", Kind = "texto" },
        new() { Key = "torre", Label = "Torre", Kind = "sel",
                Opciones = TorresDistintas().Select(t => (t, t)).ToList() },
        new() { Key = "habita", Label = "Habita", Kind = "sel",
                Opciones = new List<(string, string)> { ("si", "Si"), ("no", "No") } },
    };

    private IEnumerable<string> TorresDistintas() =>
        _residentes.Where(r => !string.IsNullOrWhiteSpace(r.TorreNombre)).Select(r => r.TorreNombre!).Distinct().OrderBy(x => x);

    private string? ValorFiltro(ResidenteResumenDto r, string key) => key switch
    {
        "rol" => r.Rol.ToString(),
        "unidad" => r.UnidadCodigo,
        "torre" => r.TorreNombre,
        "habita" => r.Habita ? "si" : "no",
        _ => null
    };

    private List<ResidenteResumenDto> Filtrados
    {
        get
        {
            var seq = _residentes.AsEnumerable();
            if (_fd is not null && _fd.Hay)
                seq = seq.Where(r => _fd.Pasa(k => ValorFiltro(r, k)));
            var q = _q.Trim();
            if (q.Length > 0)
                seq = seq.Where(r =>
                    r.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || r.Documento.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || r.UnidadCodigo.Contains(q, StringComparison.OrdinalIgnoreCase));
            return seq.ToList();
        }
    }

    private int TotalPaginas => Filtrados.Count == 0 ? 1 : (int)Math.Ceiling(Filtrados.Count / (double)_porPagina);
    private IEnumerable<ResidenteResumenDto> Pagina => Filtrados.Skip((_pagina - 1) * _porPagina).Take(_porPagina);

    // ---------- Agrupacion ----------
    private async Task SetAgrupar(string v)
    {
        _agruparPor = v; _pagina = 1; _showAgrupar = false;
        try { await Js.InvokeVoidAsync("localStorage.setItem", AgruparKey, v); } catch { }
    }
    private string AgruparLabel(string k) => k switch { "rol" => "Rol", "unidad" => "Unidad", "torre" => "Torre", _ => "" };

    private readonly record struct FilaR(bool EsGrupo, string? GrupoTitulo, int GrupoCount, ResidenteResumenDto? Fila);

    private IEnumerable<FilaR> FilasRender()
    {
        if (_agruparPor == "")
        {
            foreach (var r in Pagina) yield return new FilaR(false, null, 0, r);
            yield break;
        }
        // Agrupacion sobre la lista filtrada completa (sin paginar).
        Func<ResidenteResumenDto, string> clave = _agruparPor switch
        {
            "rol" => r => RolLabel(r.Rol),
            "unidad" => r => r.UnidadCodigo,
            "torre" => r => string.IsNullOrWhiteSpace(r.TorreNombre) ? "Sin torre" : r.TorreNombre!,
            _ => r => ""
        };
        foreach (var g in Filtrados.GroupBy(clave).OrderBy(g => g.Key))
        {
            yield return new FilaR(true, g.Key, g.Count(), null);
            foreach (var r in g) yield return new FilaR(false, null, 0, r);
        }
    }

    // ---------- Autocompletado de unidad ----------
    private static string CodigoUnidad(UnidadDto u)
    {
        var torreShort = string.IsNullOrWhiteSpace(u.TorreNombre) ? "" : u.TorreNombre!.Split(' ').Last();
        return torreShort.Length > 0 ? $"{torreShort}-{u.Numero}" : u.Numero;
    }
    private IEnumerable<UnidadDto> UnidadesFiltradas()
    {
        var q = _unidadQuery.Trim();
        var seq = _unidades.AsEnumerable();
        if (q.Length > 0)
            seq = seq.Where(u => CodigoUnidad(u).Contains(q, StringComparison.OrdinalIgnoreCase)
                                 || u.Numero.Contains(q, StringComparison.OrdinalIgnoreCase));
        return seq.OrderBy(CodigoUnidad).Take(8);
    }
    private void ElegirUnidad(UnidadDto u) { _unidadQuery = CodigoUnidad(u); _unidadDrop = false; }

    // ---------- Alta ----------
    private async Task AgregarAsync(bool abrir)
    {
        if (_busy || UnidadElegida is not { } unidad || _personaSel is not { } sel) return;
        _busy = true; _msg = ""; _msgError = false;
        try
        {
            var esEmpresa = sel.EntidadTipo == EntidadDirectorio.Empresa;
            var req = new AgregarPersonaUnidadRequest(
                "", "", "", null, null,
                _rolNuevo, _habitaNuevo, null,
                PersonaId: esEmpresa ? null : sel.PersonaId,
                EntidadTipo: sel.EntidadTipo,
                EmpresaId: esEmpresa ? sel.PersonaId : null);
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{unidad.Id}/personas", req);
            if (!resp.IsSuccessStatusCode)
            {
                _msg = "No se pudo agregar: " + await resp.Content.ReadAsStringAsync(); _msgError = true; return;
            }
            var creada = await resp.Content.ReadFromJsonAsync<UnidadPersonaDto>();
            _msg = $"{sel.NombreCompleto} agregado a {_unidadQuery}."; _msgError = false;
            _personaSel = null; _rolNuevo = RolUnidadPersona.Residente; _habitaNuevo = true; _unidadQuery = ""; _unidadDrop = false;
            await CargarAsync();
            if (abrir && creada is not null)
            {
                if (creada.EntidadTipo == EntidadDirectorio.Empresa && creada.EmpresaId is Guid eid) Nav.NavigateTo($"/directorio/empresas/{eid}");
                else if (creada.PersonaId != Guid.Empty) Nav.NavigateTo($"/directorio/personas/{creada.PersonaId}");
            }
        }
        catch (Exception ex) { _msg = "Error: " + ex.Message; _msgError = true; }
        finally { _busy = false; }
    }

    private void AbrirFicha(ResidenteResumenDto r)
    {
        if (r.EntidadTipo == EntidadDirectorio.Empresa && r.EmpresaId is Guid eid) Nav.NavigateTo($"/directorio/empresas/{eid}");
        else if (r.PersonaId is Guid pid) Nav.NavigateTo($"/directorio/personas/{pid}");
    }

    private static string RolLabel(RolUnidadPersona r) => r switch
    {
        RolUnidadPersona.Propietario => "Propietario",
        RolUnidadPersona.Residente => "Residente",
        RolUnidadPersona.Familiar => "Familiar",
        RolUnidadPersona.Arrendatario => "Arrendatario",
        RolUnidadPersona.Apoderado => "Apoderado",
        _ => r.ToString()
    };

    private RenderFragment RolBadge(RolUnidadPersona r) => builder =>
    {
        var cls = r switch
        {
            RolUnidadPersona.Propietario => "res-rol res-rol-prop",
            RolUnidadPersona.Residente => "res-rol res-rol-resi",
            RolUnidadPersona.Arrendatario => "res-rol res-rol-arr",
            _ => "res-rol res-rol-otro"
        };
        builder.AddMarkupContent(0, $"<span class=\"{cls}\">{RolLabel(r)}</span>");
    };
}

