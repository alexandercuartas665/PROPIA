    .dsh-chips { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .dsh-chip { font-size: .78rem; color: var(--propia-text-secondary); background: var(--propia-bg-card); border: 1px solid var(--propia-border-divider); border-radius: 20px; padding: 4px 12px; }
    .dsh-chip strong { color: var(--propia-brand); }
