    .dsh-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 10px; font-size: .84rem; font-weight: 700; text-decoration: none; color: var(--propia-text-body); background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); transition: border-color .12s, background .12s; }
    .dsh-btn:hover { border-color: var(--propia-brand); color: var(--propia-brand); }
    .dsh-btn-brand { background: var(--propia-brand); border-color: var(--propia-brand); color: var(--propia-text-inverse); }
    .dsh-btn-brand:hover { background: #4B47C4; color: var(--propia-text-inverse); }

    /* ===== Alertas ===== */
    .dsh-alertas { background: var(--propia-bg-card)7F7; border: 1px solid #F3C9C9; border-radius: 14px; padding: 12px 16px; }
    .dsh-alertas-head { display: flex; align-items: center; gap: 7px; color: var(--propia-error-strong); font-size: .86rem; margin-bottom: 6px; }
    .dsh-alerta { display: flex; align-items: center; gap: 10px; padding: 6px 0; border-top: 1px solid #F8E3E3; font-size: .84rem; color: #513A3A; }
    .dsh-alerta-tag { flex: 0 0 auto; font-size: .68rem; font-weight: 800; background: var(--propia-error-strong); color: var(--propia-text-inverse); border-radius: 20px; padding: 2px 9px; }
    .dsh-alerta-tx { flex: 1; min-width: 0; }
