    .dsh-alerta-ok:hover { background: var(--propia-danger-soft); }
    .dsh-alertas-more { display: inline-flex; align-items: center; gap: 5px; margin-top: 6px; border: 0; background: transparent; color: var(--propia-error-strong); font-size: .78rem; font-weight: 800; cursor: pointer; padding: 4px 2px; }
    .dsh-alertas-more:hover { text-decoration: underline; }

    /* ===== KPIs ===== */
    .dsh-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
    .dsh-kpi { display: flex; flex-direction: column; gap: 4px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-divider); border-radius: 14px; padding: 16px; text-decoration: none; transition: box-shadow .14s, transform .14s, border-color .14s; }
    a.dsh-kpi:hover { border-color: #D9D2F6; box-shadow: 0 8px 22px rgba(89, 85, 209, .10); transform: translateY(-2px); }
    .dsh-kpi--gauge { flex-direction: row; align-items: center; gap: 12px; grid-row: span 1; }
