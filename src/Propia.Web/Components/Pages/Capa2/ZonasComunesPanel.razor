    .zc-stat--mant .zc-stat-dot { background: #E0A106; }
    .zc-stat--res .zc-stat-dot { background: var(--propia-brand, var(--propia-brand)); }

    .zc-filtros { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .zc-search { display: flex; align-items: center; gap: 7px; border: 1px solid var(--propia-border-card); border-radius: 9px; padding: 0 11px; background: var(--propia-bg-card); }
    .zc-search svg { color: var(--propia-text-faint); flex-shrink: 0; }
    .zc-search:focus-within { border-color: var(--propia-brand, var(--propia-brand)); }
    .zc-search-inp { border: 0; outline: none; padding: 8px 0; font-size: 12.5px; color: var(--propia-text-body); font-family: inherit; width: 170px; background: transparent; }
    .zc-fsel { border: 1px solid var(--propia-border-card); border-radius: 9px; padding: 8px 10px; font-size: 12px; color: var(--propia-text-secondary); background: var(--propia-bg-card); outline: none; font-family: inherit; cursor: pointer; }
    .zc-fsel:focus { border-color: var(--propia-brand, var(--propia-brand)); }
    .zc-fclear { border: 1px solid var(--propia-brand-border); border-radius: 9px; padding: 8px 12px; font-size: 11.5px; font-weight: 700; color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft); cursor: pointer; font-family: inherit; }

    /* Toggle segmentado tipo pildora (milimetrico a Unidades/maqueta). */
    .zc-viewtoggle { display: inline-flex; gap: 3px; background: var(--propia-bg-app); border: 1px solid var(--propia-border-card); border-radius: 11px; padding: 4px; }
    .zc-vt { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; padding: 8px 15px; border: 0; border-radius: 8px; background: transparent; color: var(--propia-text-secondary); cursor: pointer; font-family: inherit; white-space: nowrap; transition: background .14s, color .14s, box-shadow .14s; }
    .zc-vt svg { opacity: .9; }
    .zc-vt:hover { color: var(--propia-text-body); background: var(--propia-bg-hover); }
    .zc-vt.on { background: var(--propia-bg-card); color: var(--propia-brand, var(--propia-brand)); box-shadow: 0 1px 3px rgba(27,42,58,.12); }
    .zc-vt.on svg { opacity: 1; }

    .zc-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 10px; }
    .zc-card { display: flex; align-items: center; gap: 11px; padding: 12px 14px; border: 1px solid var(--propia-border-card); border-radius: 12px; background: var(--propia-bg-card); cursor: pointer; text-align: left; font-family: inherit; }
    .zc-card:hover { border-color: var(--propia-brand, var(--propia-brand)); box-shadow: 0 4px 14px rgba(109,79,227,.10); }
    .zc-card-ic { width: 38px; height: 38px; border-radius: 10px; background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .zc-card-id { flex: 1; min-width: 0; }
    .zc-card-nom { font-size: 13.5px; font-weight: 700; color: var(--propia-text-body); }
    .zc-card-meta { font-size: 11px; color: var(--propia-text-faint); }
    .zc-card-mant { font-size: 10px; font-weight: 700; color: #9A6A00; background: var(--propia-warn-soft); border: 1px solid #F5E2AE; border-radius: 6px; padding: 3px 7px; }
    .zc-card-del { color: var(--propia-text-faint); display: flex; align-items: center; }
    .zc-card-del:hover { color: #D7263D; }
    .zc-card-arrow { color: var(--propia-text-faint); flex-shrink: 0; }

    .zc-add-card { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; border: 1.5px dashed var(--propia-text-faint); border-radius: 12px; background: transparent; color: var(--propia-brand, var(--propia-brand)); font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .zc-add-card:hover { border-color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); }

    .zc-composer { display: flex; flex-direction: column; gap: 7px; padding: 12px; border: 1.5px solid var(--propia-brand, var(--propia-brand)); border-radius: 12px; background: var(--propia-bg-card); box-shadow: 0 6px 18px rgba(109,79,227,.12); }
    .zc-composer-inp, .zc-composer-sel { border: 1px solid var(--propia-border-card); border-radius: 8px; padding: 9px 11px; font-size: 13px; color: var(--propia-text-body); outline: none; font-family: inherit; width: 100%; box-sizing: border-box; }
    .zc-composer-inp:focus, .zc-composer-sel:focus { border-color: var(--propia-brand, var(--propia-brand)); }

    /* Expander estilo Airtable DENTRO del textbox: wrapper relative + boton absoluto a la derecha.
       Nace oculto y crece (scale + opacity) cuando la fila tiene texto escrito. */
    .zc-inp-wrap { position: relative; width: 100%; }
    .zc-inp--exp { padding-right: 36px; }
    .zc-nf-exp { position: absolute; right: 5px; top: 50%; width: 26px; height: 26px; border: 0; border-radius: 7px; background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0; transform: translateY(-50%) scale(.4); pointer-events: none; transition: opacity .18s ease, transform .18s ease; }
    .zc-inp-wrap--con-texto .zc-nf-exp { opacity: 1; transform: translateY(-50%) scale(1); pointer-events: auto; }
    .zc-nf-exp:hover:not(:disabled) { background: var(--propia-brand-soft); }
    .zc-nf-exp:disabled { opacity: .5; cursor: default; }

    /* Botones de plantilla (descargar / cargar) */
    .zc-plantilla { display: flex; align-items: center; gap: 8px; }
    .zc-btn-ghost { display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border: 1px solid var(--propia-brand-border); border-radius: 9px; background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .zc-btn-ghost:hover { background: var(--propia-brand-soft); }
    .zc-btn-ghost:disabled { opacity: .5; cursor: default; }
    .propia-btn-brand.is-busy { opacity: .6; pointer-events: none; }
    .zc-impres { margin: 10px 0 0; font-size: 12.5px; color: var(--propia-text-body); background: #F1F8F4; border: 1px solid #CDE9D8; border-radius: 10px; padding: 10px 14px; }
    .zc-impres-err { color: #C0383C; font-weight: 700; }
    .zc-impres-list { margin: 6px 0 0; padding-left: 18px; color: #C0383C; font-size: 12px; }
    .zc-composer-foot { display: flex; justify-content: flex-end; gap: 7px; margin-top: 3px; }
    .zc-composer-cancel { font-size: 12px; font-weight: 600; color: var(--propia-text-muted); background: transparent; border: 0; cursor: pointer; padding: 7px 12px; font-family: inherit; }
    .zc-composer-ok { font-size: 12.5px; font-weight: 700; color: var(--propia-text-inverse); background: var(--propia-brand, var(--propia-brand)); border: 0; border-radius: 8px; padding: 8px 16px; cursor: pointer; font-family: inherit; }
    .zc-composer-ok:disabled { opacity: .5; cursor: default; }

    .zc-list { border: 1px solid var(--propia-border-card); border-radius: 12px; overflow: hidden; background: var(--propia-bg-card); }
    /* Primera columna fija (34px) para el expansor: abrir/editar la ficha del registro. */
    /* Columnas via estilo inline (ZcGridStyle) para soportar orden/visibilidad configurables. */
    .zc-grid { display: grid; gap: 10px; align-items: center; }
    /* Barra: Filtros/Buscar a la izquierda, spacer, Agrupar/Campos y toggle a la derecha. */
    .zc-bar-spacer { flex: 1 1 auto; min-width: 8px; }
    .zc-menu-wrap { position: relative; }
    .zc-fbtn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--propia-border-card); border-radius: 9px; padding: 8px 12px; font-size: 13px; font-weight: 600; color: var(--propia-text-secondary); background: var(--propia-bg-card); cursor: pointer; font-family: inherit; }
    .zc-fbtn:hover { border-color: var(--propia-brand, var(--propia-brand)); }
    .zc-fbtn.on { border-color: var(--propia-brand, var(--propia-brand)); color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft); font-weight: 700; }
    .zc-menu-bd { position: fixed; inset: 0; z-index: 40; }
    .zc-menu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 41; min-width: 190px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 12px; box-shadow: 0 12px 30px rgba(30,40,60,.18); padding: 6px; }
    .zc-menu-it { display: block; width: 100%; text-align: left; border: 0; background: transparent; border-radius: 8px; padding: 8px 10px; font-size: 12.5px; font-weight: 600; color: var(--propia-text-body); cursor: pointer; font-family: inherit; }
    .zc-menu-it:hover { background: var(--propia-brand-soft); }
    .zc-menu-it.on { background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); }
    /* Menu "Columnas" inline (milimetrico a .dst-col-* de Unidades): orden/visibilidad + borrar DIN. */
    .zc-colmenu { min-width: 252px; }
    .zc-col-search { display: flex; align-items: center; gap: 7px; border: 1px solid var(--propia-border-card); border-radius: 8px; padding: 0 9px; background: var(--propia-bg-card); margin-bottom: 6px; }
    .zc-col-search svg { color: var(--propia-text-faint); flex-shrink: 0; }
    .zc-col-search input { border: 0; outline: none; background: transparent; padding: 7px 0; font-size: 12.5px; color: var(--propia-text-body); font-family: inherit; width: 100%; }
    .zc-col-list { display: flex; flex-direction: column; max-height: 320px; overflow: auto; }
    .zc-col-it { display: flex; align-items: center; gap: 6px; padding: 5px 6px; border-radius: 7px; }
    .zc-col-it:hover { background: var(--propia-brand-soft-2); }
    .zc-col-mv { width: 22px; height: 22px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); border-radius: 6px; cursor: pointer; color: var(--propia-text-muted); font-size: 10px; line-height: 1; display: inline-flex; align-items: center; justify-content: center; }
    .zc-col-mv:hover:not(:disabled) { color: var(--propia-brand); border-color: var(--propia-brand); }
    .zc-col-mv:disabled { opacity: .35; cursor: default; }
    .zc-col-name { flex: 1; font-size: 13px; color: var(--propia-text-body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .zc-col-dyn { font-size: 9px; font-weight: 800; letter-spacing: .3px; text-transform: uppercase; color: var(--propia-brand); background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); border-radius: 5px; padding: 1px 5px; margin-left: 4px; }
    .zc-col-fija { font-size: 10.5px; color: var(--propia-text-faint); background: var(--propia-bg-app); border: 1px solid var(--propia-border-card); border-radius: 6px; padding: 2px 7px; }
    .zc-col-eye { width: 26px; height: 24px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); border-radius: 6px; cursor: pointer; color: var(--propia-text-faint); display: inline-flex; align-items: center; justify-content: center; }
    .zc-col-eye.on { color: var(--propia-brand); border-color: var(--propia-brand-border); }
    .zc-col-del { width: 26px; height: 24px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); border-radius: 6px; cursor: pointer; color: var(--propia-text-faint); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .zc-col-del:hover { color: #D7263D; border-color: #F0C9C9; background: #FBEBEB; }
    .zc-col-massacts { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--propia-border-divider); }
    .zc-col-mass { flex: 1 1 auto; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 8px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); border-radius: 8px; cursor: pointer; font-size: 11.5px; font-weight: 700; color: var(--propia-text-secondary); font-family: inherit; white-space: nowrap; }
    .zc-col-mass:hover { border-color: var(--propia-brand); color: var(--propia-brand); }
    .zc-col-reset { flex: 1 1 100%; padding: 8px; border: 1px dashed var(--propia-border-card-2); background: transparent; border-radius: 8px; cursor: pointer; font-size: 12.5px; font-weight: 600; color: var(--propia-text-secondary); font-family: inherit; }
    .zc-col-reset:hover { color: var(--propia-brand); border-color: var(--propia-brand); }
    /* "+" de columna en el header (crea campo nuevo -> abre el gestor de campos). */
    .zc-addcol-h { display: flex; align-items: center; justify-content: center; }
    .zc-addcol-btn { width: 26px; height: 26px; border-radius: 7px; border: 1px dashed var(--propia-border-card-2); background: transparent; color: var(--propia-text-muted); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; }
    .zc-addcol-btn:hover { border-color: var(--propia-brand); color: var(--propia-brand); border-style: solid; }
    /* Engranaje en cabecera de columnas dinamicas: editar/eliminar el campo (aparece al hover del th). */
    .zc-th-dyn { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .zc-th-lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .zc-th-edit { opacity: 0; flex: 0 0 auto; width: 20px; height: 20px; border: 0; background: transparent; color: var(--propia-text-muted); border-radius: 5px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; transition: opacity .12s, color .12s, background .12s; }
    .zc-list-head .zc-th-dyn:hover .zc-th-edit, .zc-th-edit:focus-visible { opacity: 1; }
    .zc-th-edit:hover { color: var(--propia-brand); background: var(--propia-brand-soft); }
    .zc-th-sortable { cursor: pointer; user-select: none; position: relative; }
    .zc-th-sortable:hover .zc-th-lbl { color: var(--propia-brand); }
    .zc-th-arrow { flex: 0 0 auto; font-size: 8px; color: var(--propia-brand); line-height: 1; }
    .zc-th-over { box-shadow: inset 2px 0 0 var(--propia-brand); }
    .zc-col-rz { position: absolute; top: 0; right: -4px; width: 8px; height: 100%; cursor: col-resize; z-index: 3; }
    .zc-col-rz::after { content: ""; position: absolute; top: 4px; bottom: 4px; left: 3px; width: 2px; border-radius: 2px; background: transparent; transition: background .12s; }
    .zc-col-rz:hover::after { background: var(--propia-brand); }
    .zc-group { display: flex; align-items: center; gap: 8px; padding: 10px 6px 4px; font-size: 12px; font-weight: 800; letter-spacing: .3px; text-transform: uppercase; color: var(--propia-brand-hover); }
    .zc-group-n { background: var(--propia-brand-soft); color: var(--propia-brand-hover); font-size: 11px; font-weight: 800; border-radius: 20px; padding: 1px 8px; }
    .zc-col-exp { display: flex; align-items: center; justify-content: center; }
    /* Variante FIJA del expansor (columna propia): aparece solo al pasar el mouse por la fila
       (o al estar escribiendo en la fila de alta). */
    .zc-nf-exp.zc-exp-fijo { position: static; opacity: 0; transform: none; pointer-events: auto; transition: opacity .12s, background .12s; }
    .zc-list-row:hover .zc-exp-fijo,
    .zc-list-newrow:hover .zc-exp-fijo,
    .zc-list-newrow:focus-within .zc-exp-fijo { opacity: 1; }
    .zc-nf-exp.zc-exp-fijo:disabled { opacity: 0; cursor: default; }
    .zc-list-newrow:hover .zc-exp-fijo:disabled,
    .zc-list-newrow:focus-within .zc-exp-fijo:disabled { opacity: .35; }
    .zc-list-head { padding: 14px 14px; background: var(--propia-bg-app); font-size: 11.5px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--propia-text-secondary); border-bottom: 1px solid var(--propia-border-card); }
    /* Separadores verticales SUTILES solo en la cabecera (entre columnas de datos). */
    .zc-list-head.zc-grid > div { border-right: 1px solid var(--propia-border-divider); }
    .zc-list-head.zc-grid > div:first-child, .zc-list-head.zc-grid > div:nth-child(2), .zc-list-head.zc-grid > div:nth-last-child(2), .zc-list-head.zc-grid > div:last-child { border-right: 0; }
    .zc-list-row { padding: 11px 14px; border-bottom: 1px solid #F3F7FA; }
    /* Seleccion multiple + barra bulk (milimetrico maqueta). */
    .zc-sel-cell { display: flex; align-items: center; justify-content: center; }
    .zc-chk { display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
    .zc-chk input { width: 16px; height: 16px; accent-color: var(--propia-brand); cursor: pointer; margin: 0; }
    .zc-row-sel { background: var(--propia-brand-soft) !important; }
    .zc-selbar { display: flex; align-items: center; gap: 12px; padding: 8px 14px; background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); border-radius: 10px; margin-bottom: 10px; }
    .zc-selbar-n { font-size: 12.5px; font-weight: 800; color: var(--propia-brand, var(--propia-brand)); }
    .zc-selbar-del { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #F0C9C9; background: var(--propia-bg-card); color: #D7263D; font-size: 12px; font-weight: 700; cursor: pointer; border-radius: 8px; padding: 5px 11px; font-family: inherit; margin-left: auto; }
    .zc-selbar-del:hover:not(:disabled) { background: #FBEBEB; }
    .zc-selbar-del:disabled { opacity: .6; cursor: default; }
    .zc-selbar-x { border: 0; background: transparent; color: var(--propia-brand, var(--propia-brand)); font-size: 12px; font-weight: 700; cursor: pointer; text-decoration: underline; }
    .zc-confirm { background: var(--propia-bg-card); border-radius: 14px; width: 440px; max-width: calc(100vw - 32px); box-shadow: 0 20px 60px rgba(20,30,50,.3); padding: 18px 20px 16px; }
    .zc-confirm-t { font-size: 15px; font-weight: 800; color: var(--propia-text-h1); }
    .zc-confirm-s { font-size: 12.5px; color: var(--propia-text-muted); margin: 6px 0 14px; }
    .zc-confirm-acts { display: flex; justify-content: flex-end; gap: 10px; }
    .zc-list-row:hover { background: var(--propia-bg-card-soft); }
    /* Celdas editables inline: se leen como texto (borde invisible) y se marcan al hover/foco. */
    .zc-cell { width: 100%; box-sizing: border-box; border: 1px solid transparent; border-radius: 7px; padding: 6px 8px; font-size: 12.5px; color: var(--propia-text-secondary); background: transparent; outline: none; font-family: inherit; }
    .zc-cell:hover { border-color: var(--propia-border-card); background: var(--propia-bg-card-soft); }
    .zc-cell:focus { border-color: var(--propia-brand, var(--propia-brand)); background: var(--propia-bg-card); color: var(--propia-text-body); }
    .zc-cell-nom { font-weight: 700; color: var(--propia-text-body); }
    select.zc-cell { cursor: pointer; }
    .zc-cell.zc-num { text-align: left; }
    .zc-list-c { font-size: 12.5px; color: var(--propia-text-secondary); }
    .zc-list-badge { font-size: 10.5px; font-weight: 700; color: var(--propia-text-secondary); background: var(--propia-border-divider); border-radius: 6px; padding: 3px 8px; }
    .zc-list-act { display: flex; justify-content: flex-end; }
    .zc-row-del { width: 26px; height: 26px; border-radius: 7px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-faint); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .zc-row-del:hover { color: #D7263D; border-color: #F0C9C9; }
    .zc-list-newrow { padding: 10px 14px; background: var(--propia-bg-app); }
    /* Alta canonica (skill 9-A): punteada gris en reposo; solida violeta + glow al focus. */
    .zc-row-inp { border: 1px dashed var(--propia-border-input); border-radius: 7px; padding: 5px 8px; font-size: 12.5px; color: var(--propia-text-body); background: var(--propia-bg-card); outline: none; font-family: inherit; width: 100%; box-sizing: border-box; }
    .zc-row-inp:focus { border-style: solid; border-color: var(--propia-brand, var(--propia-brand)); box-shadow: 0 0 0 2px rgba(109,79,227,.12); }
    .zc-row-add { font-size: 11.5px; font-weight: 700; color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); border-radius: 7px; padding: 6px 10px; cursor: pointer; font-family: inherit; white-space: nowrap; }
    .zc-row-add:disabled { opacity: .5; cursor: default; }
    /* Alta "nace fila" (milimetrico maqueta): CTA morado + fila editable + foco redondeado + acciones ✓/×. */
    .zc-nf-cta { display: inline-flex; align-items: center; gap: 5px; background: var(--propia-brand-soft); color: var(--propia-brand); border: 1px solid var(--propia-brand-border); border-radius: 8px; padding: 8px 12px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap; transition: background .14s, border-color .14s; }
    .zc-nf-cta:hover { background: var(--propia-brand-soft-3, var(--propia-brand-soft)); border-color: var(--propia-brand); }
    .zc-newrow--cta { cursor: default; }
