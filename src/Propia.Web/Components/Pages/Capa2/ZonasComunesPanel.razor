    // ===== Agrupar (boton "Agrupar"): agrupa la lista por un campo. =====
    private string _agruparZ = "";
    private bool _showAgruparZ;
    private static string AgruparLabelZ(string k) => k switch { "categoria" => "Categoria", "reserva" => "Reserva", "estado" => "Estado", _ => "" };
    private void SetAgruparZ(string k) { _agruparZ = k; _showAgruparZ = false; _paginaZ = 1; }
    private IEnumerable<IGrouping<string, ZonaComunDto>> AgruparZonas(IEnumerable<ZonaComunDto> zonas) => _agruparZ switch
    {
        "categoria" => zonas.GroupBy(z => z.Categoria.ToString()),
        "reserva" => zonas.GroupBy(z => z.EsReservable ? "Reservable" : "No reservable"),
        "estado" => zonas.GroupBy(z => z.Estado.ToString()),
        _ => PaginarSinGrupoZ(zonas)   // sin agrupar: se pagina (footer canonico)
    };
    // Envuelve la pagina actual en un unico "grupo" sin titulo (el header de grupo se oculta cuando
    // _agruparZ == ""). Asi la vista tabla reusa el mismo render pero paginado.
    private IEnumerable<IGrouping<string, ZonaComunDto>> PaginarSinGrupoZ(IEnumerable<ZonaComunDto> zonas)
    {
        var list = zonas as IList<ZonaComunDto> ?? zonas.ToList();
        var totalPag = list.Count == 0 ? 1 : (int)Math.Ceiling(list.Count / (double)_porPaginaZ);
        var pag = Math.Clamp(_paginaZ, 1, totalPag);
        return list.Skip((pag - 1) * _porPaginaZ).Take(_porPaginaZ).GroupBy(_ => "");
    }

    // Filtros (client-side: la lista de zonas de una copropiedad es corta).
    // Un solo boton "Filtros" con reglas dinamicas (componente compartido FiltroDinamico).
    private string _q = "";
    private FiltroDinamico? _fd;

    private bool HayFiltros => !string.IsNullOrWhiteSpace(_q) || (_fd?.Hay ?? false);

    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "nombre", Label = "Nombre", Kind = "texto" },
        new() { Key = "categoria", Label = "Categoria", Kind = "sel",
                Opciones = Enum.GetValues<CategoriaZonaComun>().Select(c => (c.ToString(), c.ToString())).ToList() },
        new() { Key = "estado", Label = "Estado", Kind = "sel",
                Opciones = Enum.GetValues<EstadoZonaComunMantenimiento>().Select(s => (s.ToString(), s.ToString())).ToList() },
        new() { Key = "reservable", Label = "Reservable", Kind = "sel",
                Opciones = new() { ("si", "Si"), ("no", "No") } },
        new() { Key = "aforo", Label = "Aforo", Kind = "num" },
    };

    private IEnumerable<ZonaComunDto> Filtradas()
    {
        var q = _q.Trim();
        var baseSeq = _zonas
            .Where(z => q == "" || z.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Where(z => _fd?.Pasa(campo => campo switch
            {
                "nombre" => z.Nombre,
                "categoria" => z.Categoria.ToString(),
                "estado" => z.Estado.ToString(),
                "reservable" => z.EsReservable ? "si" : "no",
                "aforo" => z.CapacidadPersonas?.ToString() ?? "",
                _ => ""
            }) ?? true);
        // Orden multi-criterio (menu "Ordenar" / clic en header); sin sort, orden por defecto (categoria + nombre).
        if (_sortsZ.Count > 0)
        {
            var sorts = _sortsZ;
            var cmp = Comparer<ZonaComunDto>.Create((a, b) =>
            {
                foreach (var s in sorts)
                {
                    var c = CmpValTabla(SortStrZ(a, s.Key), SortStrZ(b, s.Key)) * s.Dir;
                    if (c != 0) return c;
                }
                return 0;
            });
            return baseSeq.OrderBy(z => z, cmp);
        }
        return baseSeq.OrderBy(z => z.Categoria).ThenBy(z => z.Nombre);
    }

