@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals
@implements IDisposable

@* Zonas comunes: modulo propio (antes era una seccion del acordeon de Mi copropiedad).
   Mismo contenido que tenia alli - resumen, tarjetas/lista y alta rapida - pero sin
   acordeon y sin numeral. El detalle vive en FichaZonaModal; el alta masiva en
   GestionarZonasModal.

   El CSS va con prefijo zc-* y propio: las clases mc-* solo existen mientras se renderiza
   MiCopropiedad, asi que en esta pagina no estarian disponibles. *@

<div class="mod-pagehead">
    <div>
        <h1 class="mod-pagetitle">Zonas Comunes</h1>
        <p class="mod-pagesub">Salones, zonas deportivas, parques y demas areas de uso comun de la copropiedad.</p>
    </div>
    @if (_authChecked && _jwt is not null)
    {
        <div class="zc-plantilla">
            <button type="button" class="zc-btn-ghost" @onclick="DescargarPlantillaAsync" disabled="@_impBusy" title="Descargar plantilla Excel">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
                Descargar plantilla
            </button>
            <label class="propia-btn-brand @(_impBusy ? "is-busy" : "")" style="cursor:pointer;" title="Cargar plantilla Excel (crea o actualiza)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V9m0 0l-4 4m4-4l4 4M4 3h16"/></svg>
                @(_impBusy ? "Cargando..." : "Cargar plantilla")
                <InputFile OnChange="OnPlantillaImport" accept=".xlsx" style="display:none" disabled="@_impBusy" />
            </label>
        </div>
    }
</div>

@if (_impResult is not null)
{
    <div class="zc-impres">
        <b>Carga completa:</b> @_impResult.Creados creadas, @_impResult.Actualizados actualizadas, @_impResult.CamposCargados campos.
        @if (_impResult.FilasConError > 0)
        {
            <span class="zc-impres-err"> · @_impResult.FilasConError con error</span>
            <ul class="zc-impres-list">@foreach (var er in _impResult.Errores.Take(10)) { <li>Fila @er.Fila: @er.Mensaje</li> }</ul>
        }
    </div>
}

@if (!_authChecked)
{
    <div class="zc-loading"><div class="spinner-border" style="color: var(--propia-brand, var(--propia-brand));"></div></div>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    @* Sin value= en el buscador: Blazor Server se come pulsaciones al reafirmarlo en cada re-render. *@
    <div class="mod-filtros">
        @* Boton "Filtros" PRIMERO y luego el buscador (orden estandar de los modulos). *@
        <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="StateHasChanged" />
        <div class="mod-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="mod-search-inp" placeholder="Buscar zona..."
                   @oninput="@(e => { _q = e.Value?.ToString() ?? string.Empty; _paginaZ = 1; })" />
        </div>
        <div class="zc-bar-spacer"></div>
        @if (_view == "list")
        {
            @* Ordenar (multi-criterio apilable): fuente unica compartida. *@
            <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sortsZ" SortsChanged="OnSortsChanged" />
            @* Agrupar (menu) + Campos (menu), a la derecha, patron estandar. *@
            <div class="zc-menu-wrap">
                <button type="button" class="zc-fbtn @(_agruparZ != "" ? "on" : "")" @onclick="() => _showAgruparZ = !_showAgruparZ" title="Agrupar zonas">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    <span>Agrupar@(_agruparZ != "" ? ": " + AgruparLabelZ(_agruparZ) : "")</span>
                </button>
                @if (_showAgruparZ)
                {
                    <div class="zc-menu-bd" @onclick="() => _showAgruparZ = false"></div>
                    <div class="zc-menu">
                        @foreach (var g in new[] { ("", "Sin agrupar"), ("categoria", "Categoria"), ("reserva", "Reserva"), ("estado", "Estado") })
                        {
                            var gk = g.Item1;
                            <button class="zc-menu-it @(_agruparZ == gk ? "on" : "")" @onclick="() => SetAgruparZ(gk)">@g.Item2</button>
                        }
                    </div>
                }
            </div>
            @* "Columnas" (inline, milimetrico a Unidades): orden, visibilidad y borrar campo dinamico.
               Crear campo nuevo = "+" del header de la tabla; editar/eliminar = engranaje de la columna. *@
            <div class="zc-menu-wrap">
                <button type="button" class="zc-fbtn @(_showColMenuZ ? "on" : "")" @onclick="() => _showColMenuZ = !_showColMenuZ" title="Columnas: orden, visibilidad y campos">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                    <span>Columnas</span>
                </button>
                @if (_showColMenuZ)
                {
                    <div class="zc-menu-bd" @onclick="() => _showColMenuZ = false"></div>
                    <div class="zc-menu zc-colmenu">
                        <div class="zc-col-search">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                            <input placeholder="Buscar campo..." value="@_colQZ" @oninput="@(e => _colQZ = e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="zc-col-list">
                            @{ var _colsZ = ClavesOrdenadas().ToList(); }
                            @for (int _ci = 0; _ci < _colsZ.Count; _ci++)
                            {
                                var k = _colsZ[_ci];
                                var idx = _ci;
                                var label = ColLabel(k);
                                if (!string.IsNullOrWhiteSpace(_colQZ) && !label.Contains(_colQZ, StringComparison.OrdinalIgnoreCase)) { continue; }
                                var fija = idx == 0;
                                var visible = VisibleCol(k);
                                var custom = CampoCustom(k);
                                <div class="zc-col-it">
                                    <button class="zc-col-mv" disabled="@(idx <= 1)" @onclick="() => MoverColumnaZAsync(k, -1)">&#9650;</button>
                                    <button class="zc-col-mv" disabled="@(idx == 0 || idx == _colsZ.Count - 1)" @onclick="() => MoverColumnaZAsync(k, 1)">&#9660;</button>
                                    <span class="zc-col-name">@label @if (custom is not null) { <span class="zc-col-dyn" title="Campo personalizado">din</span> }</span>
                                    @if (fija) { <span class="zc-col-fija">fija</span> }
                                    else
                                    {
                                        <button class="zc-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => ToggleVisibleColZAsync(k)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                    }
                                    @if (custom is not null) { <button class="zc-col-del" title="Eliminar campo (definicion y valores)" @onclick="() => _campoAEliminarZ = custom"><i class="fi fi-rr-trash"></i></button> }
                                </div>
                            }
                        </div>
                        <div class="zc-col-massacts">
                            <button type="button" class="zc-col-mass" @onclick="OcultarTodasColZAsync"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                            <button type="button" class="zc-col-mass" @onclick="MostrarTodasColZAsync"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                            <button type="button" class="zc-col-reset" @onclick="RestablecerColZAsync">Restablecer</button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @* En Tarjetas no hay columnas ni "+": aqui se mantiene la entrada a la config de campos. *@
            <div class="zc-menu-wrap">
                <button type="button" class="zc-fbtn @(_selAbierto ? "on" : "")" @onclick="() => _selAbierto = true" title="Campos de las zonas: orden, visibilidad, nombre y campos propios">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                    <span>Campos</span>
                </button>
            </div>
        }
        <div class="zc-viewtoggle">
            <button type="button" class="zc-vt @(_view == "cards" ? "on" : "")" @onclick='() => SetVista("cards")' title="Tarjetas">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Tarjetas
            </button>
            <button type="button" class="zc-vt @(_view == "list" ? "on" : "")" @onclick='() => SetVista("list")' title="Tabla">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                Tabla
            </button>
        </div>
    </div>

    @if (_view == "cards")
    {
        <div class="zc-cards">
            @foreach (var z in Filtradas())
            {
                var zona = z;
                <button type="button" class="zc-card" @onclick="() => AbrirFichaZonaAsync(zona)" title="Abrir ficha de la zona">
                    <div class="zc-card-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V8h14v13M9 12h.01M15 12h.01"/></svg></div>
                    <div class="zc-card-id">
                        <div class="zc-card-nom">@z.Nombre</div>
                        <div class="zc-card-meta">@z.Categoria@(z.CapacidadPersonas.HasValue ? $" · Aforo {z.CapacidadPersonas}" : "") · @(z.EsReservable ? "Reservable" : "No reservable")</div>
                    </div>
                    @if (z.Estado == EstadoZonaComunMantenimiento.EnMantenimiento) { <span class="zc-card-mant">Mant.</span> }
                    <span class="zc-card-del" role="button" @onclick:stopPropagation="true" @onclick="() => EliminarZonaAsync(zona.Id, zona.Nombre)" title="Eliminar zona">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                    </span>
                    <svg class="zc-card-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
                </button>
            }

            @* Compositor progresivo: la tarjeta crece a medida que se agregan datos. *@
            @if (_composerOpen)
            {
                <div class="zc-composer">
                    @* SIN value=: en Blazor Server se reafirma en cada re-render y se come
                       pulsaciones mientras el round-trip esta en vuelo. El ojito crea la zona y
                       abre su ficha de una vez (mismo patron pedido en Directorio). *@
                    @* Expander estilo Airtable DENTRO del textbox: crece cuando empiezas a escribir
                       y al hacer click crea la zona y abre su ficha para terminar el registro alli. *@
                    <div class="zc-inp-wrap @(string.IsNullOrWhiteSpace(_draft.Nombre) ? "" : "zc-inp-wrap--con-texto")">
                        <input class="zc-composer-inp zc-inp--exp" placeholder="Nombre de la zona..." autofocus
                               @oninput="@(e => { _draft.Nombre = e.Value?.ToString() ?? string.Empty; Reveal(0); })"
                               @onkeydown="Keydown" />
                        <button type="button" class="zc-nf-exp" tabindex="-1" title="Crear y abrir la ficha completa"
                                @onclick="CrearYAbrirFichaAsync" disabled="@_busy">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @if (_reveal >= 1)
                    {
                        <select class="zc-composer-sel" @bind="_draft.Categoria" @onfocus="@(() => Reveal(1))">
                            @foreach (var c in Enum.GetValues<CategoriaZonaComun>()) { <option value="@c">@c</option> }
                        </select>
                    }
                    @if (_reveal >= 2)
                    {
                        <select class="zc-composer-sel" @onfocus="@(() => Reveal(2))"
                                @onchange="@(e => _draft.EsReservable = e.Value?.ToString() == "true")">
                            <option value="false" selected="@(!_draft.EsReservable)">No reservable</option>
                            <option value="true" selected="@_draft.EsReservable">Reservable</option>
                        </select>
                    }
                    @if (_reveal >= 3)
                    {
                        <input type="number" min="0" class="zc-composer-sel" placeholder="Aforo (personas)"
                               @bind="_draft.Aforo" @onfocus="@(() => Reveal(3))" />
                    }
                    <div class="zc-composer-foot">
                        <button type="button" class="zc-composer-cancel" @onclick="CancelarComposer">Cancelar</button>
                        <button type="button" class="zc-composer-ok" @onclick="CrearDesdeDraftAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft.Nombre))">@(_busy ? "Creando..." : "Crear")</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="zc-add-card" @onclick="AbrirComposer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                    Agregar zona comun
                </button>
            }
        </div>
    }
    else
    {
        @if (_selZ.Count > 0)
        {
            <div class="zc-selbar">
                <span class="zc-selbar-n">@_selZ.Count seleccionada@(_selZ.Count == 1 ? "" : "s")</span>
                <button type="button" class="zc-selbar-del" @onclick="() => _confirmDelSelZ = true">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                    Eliminar
                </button>
                <button type="button" class="zc-selbar-x" @onclick="LimpiarSelZ">Deseleccionar</button>
            </div>
        }
        @if (_confirmDelSelZ)
        {
            <div class="zc-cfg-back" @onclick="() => { if (!_delBusyZ) _confirmDelSelZ = false; }">
                <div class="zc-confirm" @onclick:stopPropagation="true">
                    <div class="zc-confirm-t">Eliminar @_selZ.Count zona@(_selZ.Count == 1 ? "" : "s")</div>
                    <div class="zc-confirm-s">Esta accion elimina las zonas seleccionadas de forma permanente y no se puede deshacer.</div>
                    <div class="zc-confirm-acts">
                        <button type="button" class="zc-fbtn" @onclick="() => _confirmDelSelZ = false" disabled="@_delBusyZ">Cancelar</button>
                        <button type="button" class="zc-selbar-del" @onclick="EliminarSelZonasAsync" disabled="@_delBusyZ">@(_delBusyZ ? "Eliminando..." : "Si, eliminar")</button>
                    </div>
                </div>
            </div>
        }
        @if (_campoAEliminarZ is not null)
        {
            <div class="zc-cfg-back" @onclick="() => { if (!_colBusyZ) _campoAEliminarZ = null; }">
                <div class="zc-confirm" @onclick:stopPropagation="true">
                    <div class="zc-confirm-t">Eliminar campo "@_campoAEliminarZ.Label"</div>
                    <div class="zc-confirm-s">Se elimina la definicion del campo y todos sus valores en las zonas. No se puede deshacer.</div>
                    <div class="zc-confirm-acts">
                        <button type="button" class="zc-fbtn" @onclick="() => _campoAEliminarZ = null" disabled="@_colBusyZ">Cancelar</button>
                        <button type="button" class="zc-selbar-del" @onclick="EliminarCampoDinZAsync" disabled="@_colBusyZ">@(_colBusyZ ? "Eliminando..." : "Si, eliminar campo")</button>
                    </div>
                </div>
            </div>
        }
        <div class="zc-list">
            @* El expansor tiene su PROPIA columna (la primera, siempre visible): abre la ficha
               del registro para editarlo; en la fila de alta crea la zona y abre su ficha. *@
            @* Columnas dirigidas por la config compartida (unidades-config, entidad 'zona'): sistema y
               propias en UNA sola secuencia, con el orden/visibilidad/alias del Selector de Campos. *@
            <div class="zc-list-head zc-grid" style="@ZcGridStyle">
                <div class="zc-sel-cell"><label class="zc-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodasSelZ" @onchange="@(e => ToggleSelAllZ((bool)(e.Value ?? false)))" /></label></div>
                <div></div>
                @foreach (var k in ColsVisibles())
                {
                    var clave = k;
                    if (CampoCustom(clave) is not null)
                    {
                        <div class="zc-th-dyn zc-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                             @onmousedown="e => IniciarReorderZ(e, clave)" @onclick="() => OrdenarPorColumnaZ(clave)">
                            <span class="zc-th-lbl">@ColLabel(clave).ToUpperInvariant()</span>
                            @if (_sortKeyZ == clave) { <span class="zc-th-arrow">@((MarkupString)(_sortDirZ > 0 ? "&#9650;" : "&#9660;"))</span> }
                            <button type="button" class="zc-th-edit" title="Editar o eliminar campo" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="() => AbrirEditarCampoZ(CampoCustom(clave)!)"><i class="fi fi-rr-settings"></i></button>
                            <span class="zc-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResizeZ(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResizeZ(clave)" @ondblclick:stopPropagation="true"></span>
                        </div>
                    }
                    else
                    {
                        <div class="zc-th-dyn zc-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                             @onmousedown="e => IniciarReorderZ(e, clave)" @onclick="() => OrdenarPorColumnaZ(clave)">
                            <span class="zc-th-lbl">@ColLabel(clave).ToUpperInvariant()</span>
                            @if (_sortKeyZ == clave) { <span class="zc-th-arrow">@((MarkupString)(_sortDirZ > 0 ? "&#9650;" : "&#9660;"))</span> }
                            <span class="zc-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResizeZ(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResizeZ(clave)" @ondblclick:stopPropagation="true"></span>
                        </div>
                    }
                }
                <div></div>
                <div class="zc-addcol-h"><button type="button" class="zc-addcol-btn" title="Crear campo nuevo (columna)" @onclick="AbrirCrearCampoZ"><i class="fi fi-rr-plus"></i></button></div>
            </div>
            @foreach (var grupo in AgruparZonas(Filtradas()))
            {
                @if (_agruparZ != "")
                {
                    <div class="zc-group"><span class="zc-group-t">@grupo.Key</span><span class="zc-group-n">@grupo.Count()</span></div>
                }
                @foreach (var z in grupo)
                {
                    var zona = z;
                    <div class="zc-list-row zc-grid @(_selZ.Contains(zona.Id) ? "zc-row-sel" : "")" style="@ZcGridStyle" @oncontextmenu="e => AbrirCtxZ(e, zona)" @oncontextmenu:preventDefault="true">
                        <div class="zc-sel-cell"><label class="zc-chk"><input type="checkbox" checked="@_selZ.Contains(zona.Id)" @onchange="@(e => ToggleSelZ(zona.Id, (bool)(e.Value ?? false)))" @onclick:stopPropagation="true" /></label></div>
                        <div class="zc-col-exp">
                            <button type="button" class="zc-nf-exp zc-exp-fijo" title="Abrir la ficha para editar" @onclick="() => AbrirFichaZonaAsync(zona)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </div>
                        @* Datos editables inline (value= + @onchange guarda al salir del campo). Una sola
                           secuencia de columnas: las de sistema por clave, las propias via CampoCustom. *@
                        @foreach (var k in ColsVisibles())
                        {
                            if (CampoCustom(k) is ZonaCampoDefinicionDto cd)
                            {
                                var cdd = cd;
                                var vv = ValorCampo(zona.Id, cd.Id);
                                switch (cd.Tipo)
                                {
                                    case TipoCampoTablero.Seleccion:
                                        <select class="zc-cell" value="@vv" @onchange="(ev) => GuardarCampoValorZona(zona, cdd, ev.Value?.ToString())">
                                            <option value="">-</option>
                                            @foreach (var op in OpcionesDe(cd)) { <option value="@op" selected="@(vv == op)">@op</option> }
                                        </select>
                                        break;
                                    case TipoCampoTablero.Numero:
                                    case TipoCampoTablero.Moneda:
                                        <input class="zc-cell" type="number" step="any" value="@vv" @onchange="(ev) => GuardarCampoValorZona(zona, cdd, ev.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Fecha:
                                        <input class="zc-cell" type="date" value="@vv" @onchange="(ev) => GuardarCampoValorZona(zona, cdd, ev.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Booleano:
                                        <select class="zc-cell" value="@vv" @onchange="(ev) => GuardarCampoValorZona(zona, cdd, ev.Value?.ToString())">
                                            <option value="">-</option>
                                            <option value="Si" selected="@(vv == "Si")">Si</option>
                                            <option value="No" selected="@(vv == "No")">No</option>
                                        </select>
                                        break;
                                    default:
                                        <input class="zc-cell" value="@vv" @onchange="(ev) => GuardarCampoValorZona(zona, cdd, ev.Value?.ToString())" title="@cd.Label" />
                                        break;
                                }
                                continue;
                            }
                            switch (k)
                            {
                                case "nombre":
                                    <input class="zc-cell zc-cell-nom" value="@z.Nombre" @onchange="@(e => GuardarZonaInline(zona, "nombre", e))" />
                                    break;
                                case "categoria":
                                    <select class="zc-cell" @onchange="@(e => GuardarZonaInline(zona, "categoria", e))">
                                        @foreach (var c in Enum.GetValues<CategoriaZonaComun>()) { <option value="@c" selected="@(z.Categoria == c)">@c</option> }
                                    </select>
                                    break;
                                case "reservable":
                                    <select class="zc-cell" @onchange="@(e => GuardarZonaInline(zona, "reservable", e))">
                                        <option value="false" selected="@(!z.EsReservable)">No</option>
                                        <option value="true" selected="@z.EsReservable">Si</option>
                                    </select>
                                    break;
                                case "aforo":
                                    <input type="number" min="0" class="zc-cell zc-num" value="@z.CapacidadPersonas" placeholder="-" @onchange="@(e => GuardarZonaInline(zona, "aforo", e))" />
                                    break;
                                case "estado":
                                    <select class="zc-cell zc-cell-est" @onchange="@(e => GuardarZonaInline(zona, "estado", e))">
                                        @foreach (var s in Enum.GetValues<EstadoZonaComunMantenimiento>()) { <option value="@s" selected="@(z.Estado == s)">@s</option> }
                                    </select>
                                    break;
                                case "descripcion":
                                    <input class="zc-cell" value="@z.Descripcion" placeholder="-" @onchange="@(e => GuardarZonaInline(zona, "descripcion", e))" />
                                    break;
                                case "tarifa":
                                    <input type="number" step="any" min="0" class="zc-cell zc-num" value="@z.TarifaReserva" placeholder="-" @onchange="@(e => GuardarZonaInline(zona, "tarifa", e))" />
                                    break;
                                case "reglas":
                                    <input class="zc-cell" value="@z.ReglasUso" placeholder="-" @onchange="@(e => GuardarZonaInline(zona, "reglas", e))" />
                                    break;
                            }
                        }
                        <div class="zc-list-act">
                            <button type="button" class="zc-row-del" @onclick="() => EliminarZonaAsync(zona.Id, zona.Nombre)" title="Eliminar">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                            </button>
                        </div>
                        <div class="zc-addcol-cell"></div>
                    </div>
                }
            }
            @* Alta inline. @@key limpia la fila al crear; @@oninput SIN value= evita perder pulsaciones. *@
            @if (_altaAbiertaZ)
            {
            <div class="zc-list-newrow zc-newrow--edit zc-grid" style="@ZcGridStyle" @key="_nonce" @onkeydown="OnAltaKeydownZ">
                <div class="zc-sel-cell"></div>
                <div class="zc-col-exp">
                    <span class="zc-nf-exp zc-exp-mut" title="Nueva zona comun">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </span>
                </div>
                @foreach (var k in ColsVisibles())
                {
                    if (CampoCustom(k) is ZonaCampoDefinicionDto cd)
                    {
                        var cdd = cd;
                        var val = _nuCampos.GetValueOrDefault(cd.Id);
                        switch (cd.Tipo)
                        {
                            case TipoCampoTablero.Seleccion:
                                <select class="zc-row-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                    <option value="">- elegir -</option>
                                    @foreach (var op in OpcionesDe(cd)) { <option value="@op">@op</option> }
                                </select>
                                break;
                            case TipoCampoTablero.Numero:
                            case TipoCampoTablero.Moneda:
                                <input class="zc-row-inp" type="number" step="any" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" placeholder="@cd.Label" />
                                break;
                            case TipoCampoTablero.Fecha:
                                <input class="zc-row-inp" type="date" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" />
                                break;
                            case TipoCampoTablero.Booleano:
                                <select class="zc-row-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                    <option value="">- elegir -</option><option value="Si">Si</option><option value="No">No</option>
                                </select>
                                break;
                            default:
                                <input class="zc-row-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" placeholder="@cd.Label" />
                                break;
                        }
                        continue;
                    }
                    switch (k)
                    {
                        case "nombre":
                            <input class="zc-row-inp" @ref="_nombreRef" placeholder="Nueva zona comun..."
                                   @oninput="@(e => _draft.Nombre = e.Value?.ToString() ?? string.Empty)" @onkeydown="Keydown" />
                            break;
                        case "categoria":
                            <select class="zc-row-inp" @bind="_draft.Categoria">
                                @foreach (var c in Enum.GetValues<CategoriaZonaComun>()) { <option value="@c">@c</option> }
                            </select>
                            break;
                        case "reservable":
                            <select class="zc-row-inp" @onchange="@(e => _draft.EsReservable = e.Value?.ToString() == "true")">
                                <option value="false" selected="@(!_draft.EsReservable)">No</option>
                                <option value="true" selected="@_draft.EsReservable">Si</option>
                            </select>
                            break;
                        case "aforo":
                            <input type="number" min="0" class="zc-row-inp" placeholder="-" @bind="_draft.Aforo" />
                            break;
                        case "estado":
                            <div class="zc-list-c">Activa</div>
                            break;
                        default:
                            @* descripcion/tarifa/reglas se completan en la ficha tras crear. *@
                            <div class="zc-list-c">-</div>
                            break;
                    }
                }
                <div class="zc-list-act zc-nf-actbtns">
                    <button type="button" class="zc-nf-ok" title="Guardar (Enter)" @onclick="CrearDesdeDraftAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft.Nombre))">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                    </button>
                    <button type="button" class="zc-nf-cancel" title="Cancelar (Esc)" @onclick="CerrarAltaZ" disabled="@_busy">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                </div>
                <div class="zc-addcol-cell"></div>
            </div>
            }
            else
            {
            <div class="zc-list-newrow zc-newrow--cta zc-grid" style="@ZcGridStyle">
                <div class="zc-sel-cell"></div>
                <div class="zc-col-exp"></div>
                <div class="zc-nf-ctacell" style="grid-column: 3 / -1;">
                    <button type="button" class="zc-nf-cta" @onclick="AbrirAltaZ">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                        Agregar registro
                    </button>
                </div>
            </div>
            }
            @* Footer DENTRO del contenedor de la tabla (borde/radio/overflow), para que se integre
               como en Unidades y no se vea "pegado". *@
            @* Footer canonico: visible SIEMPRE con la tabla, incluso con 0 filas ("Mostrando 0 de 0");
               solo se oculta con agrupacion activa. *@
            @if (_agruparZ == "")
            {
                <TablaPager Total="Filtradas().Count()" Pagina="_paginaZ" PorPagina="_porPaginaZ" Entidad="zonas"
                            PaginaChanged="p => _paginaZ = p"
                            PorPaginaChanged="n => { _porPaginaZ = n; _paginaZ = 1; }" />
            }
        </div>
    }

    @* En vista Tabla, la propia tabla (cabecera + fila de alta + footer) comunica el vacio; el
       cartel de vacio solo va en Tarjetas (donde no hay footer). *@
    @if (_view == "cards" && !Filtradas().Any())
    {
        <div class="zc-empty">
            @(HayFiltros ? "Ninguna zona coincide con el filtro." : "Aun no hay zonas comunes registradas.")
        </div>
    }

    @if (!string.IsNullOrEmpty(_msg)) { <div class="zc-msg @(_msgOk ? "ok" : "bad")">@_msg</div> }
}

@* Selector de Campos (Fase 1): el gestor propio (columnas en memoria + modal de campos dinamicos)
   se reemplaza por el componente compartido. Orden/visibilidad/alias viven en unidades-config
   (entidad 'zona'); los campos propios en zonas-campos. *@

@* Crear / editar UN campo (modal focalizado, replica de la maqueta). "+" crea; engranaje edita. *@
@if (_crearCampoAbiertoZ)
{
    <CrearCampoModal Prefijo="zonas"
                     TituloSingular="zona"
                     Ejemplo="Ej. Aforo COVID, Piso"
                     Jwt="@_jwt"
                     Editar="_campoAEditarZ"
                     TiposAvanzados="false"
                     Guardado="RecargarTrasCrearCampoZ"
                     Cerrado="() => { _crearCampoAbiertoZ = false; _campoAEditarZ = null; }"
                     AbrirGestorAvanzado="AbrirGestorDesdeCrearZ" />
}

@* Menu contextual (clic derecho sobre una fila). *@
<TablaCtxMenu Abierto="_ctxOpenZ" X="_ctxXZ" Y="_ctxYZ" Items="_ctxItemsZ" Cerrado="() => _ctxOpenZ = false" />

@if (_selAbierto)
{
    <div class="zc-cfg-back" @onclick="() => _selAbierto = false">
        <div class="zc-cfg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="zc-cfg-head">
                <div>
                    <div class="zc-cfg-title">Campos de zonas comunes</div>
                    <div class="zc-cfg-sub">Orden, visibilidad, nombre y campos propios de la tabla y la ficha.</div>
                </div>
                <button class="zc-cfg-x" type="button" @onclick="() => _selAbierto = false" aria-label="Cerrar">&times;</button>
            </div>
            <div class="zc-cfg-body">
                <ConfigCamposEntidad Prefijo="zonas"
                                     EntidadConfig="zona"
                                     Catalogo="@ZonaCatalogo"
                                     TituloSingular="zona"
                                     TituloPlural="Zonas comunes"
                                     Ejemplo="Ej. Aforo COVID, Piso"
                                     TiposAvanzados="true"
                                     Jwt="@_jwt"
                                     Cambiado="RecargarCamposYConfigAsync" />
            </div>
        </div>
    </div>
}

@* ModalHost debe declararse en CADA pagina: IModalService es scoped por circuito y
   MainLayout es otra frontera de render (ver comentario en MainLayout.razor). *@
<ModalHost />

@code {
    private List<ZonaComunDto> _zonas = new();
    private string? _jwt;
    private bool _authChecked;
    private string? _loadError;

    private string _view = "cards";
    private const string VistaKey = "propia_view_zonas";
    private bool _composerOpen;
    private int _reveal;
    private bool _busy;
    private bool _impBusy;
    private ImportarPlantillaResultado? _impResult;
    private readonly ZonaDraft _draft = new();
    private int _nonce;
    private bool _focusPending;
    private ElementReference _nombreRef;

    private string _msg = "";
    private bool _msgOk = true;

    // ---- Selector de Campos (Fase 1): columnas dirigidas por unidades-config (entidad 'zona') ----
    // Reemplaza el gestor propio: orden/visibilidad/alias de las columnas (de sistema y propias) viven
    // en la config compartida por copropiedad; el componente ConfigCamposEntidad las escribe y aqui se
    // leen para pintar la tabla (mismo patron que Unidades/Seguros).
    private bool _selAbierto;
    private Dictionary<string, UnidadCampoConfigDto> _cfgZona = new(StringComparer.Ordinal);

    // Catalogo de campos de SISTEMA mapeado a la forma neutra del componente. Las columnas se renderizan
    // por clave con editor fijo: TiposIntercambiables vacio (tipo fijo) + SinFormato.
    private static readonly IReadOnlyList<CampoSistemaDef> ZonaCatalogo =
        ZonaCamposSistema.Todos.Select(c => new CampoSistemaDef(
            c.Clave, c.Label, c.Tipo, c.VisiblePorDefecto, c.Fija,
            OpcionesEditables: false, Semilla: null, Entero: false, Ayuda: null,
            TiposIntercambiables: Array.Empty<TipoCampoTablero>(), ListaExterna: false, SinFormato: true)).ToList();

    // Clave de config de un campo propio (misma convencion que el componente: "cd:{id}").
    private static string ClaveCustom(ZonaCampoDefinicionDto c) => "cd:" + c.Id;
    private static bool EsCustom(string clave) => clave.StartsWith("cd:", StringComparison.Ordinal);
    private ZonaCampoDefinicionDto? CampoCustom(string clave)
        => EsCustom(clave) && Guid.TryParse(clave[3..], out var g) ? _camposDef.FirstOrDefault(c => c.Id == g) : null;

    // Claves candidatas: sistema (orden del catalogo) + propias. Se ordenan y filtran por config.
    private IEnumerable<string> ClavesCandidatas()
        => ZonaCamposSistema.Todos.Select(c => c.Clave).Concat(_camposDef.OrderBy(d => d.Orden).Select(ClaveCustom));
    private bool VisibleColDefault(string clave)
        => EsCustom(clave) || (ZonaCamposSistema.Por(clave)?.VisiblePorDefecto ?? true);
    private bool VisibleCol(string clave)
        => _cfgZona.TryGetValue(clave, out var c) ? !c.Oculto : VisibleColDefault(clave);
    private int OrdenCol(string clave, int fallback)
        => _cfgZona.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;
    private IEnumerable<string> ClavesOrdenadas()
        => ClavesCandidatas().Select((k, i) => (k, ord: OrdenCol(k, i))).OrderBy(x => x.ord).Select(x => x.k);
    private IEnumerable<string> ColsVisibles() => ClavesOrdenadas().Where(VisibleCol);

    private string ColLabel(string clave)
    {
        if (_cfgZona.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias)) return c.Alias!;
        return CampoCustom(clave)?.Label ?? ZonaCamposSistema.Por(clave)?.Label ?? clave;
    }
    private static string ColWidth(string clave) => clave switch
    {
        "nombre" => "2fr",
        "categoria" => "1.2fr",
        "reservable" => ".8fr",
        "aforo" => ".8fr",
        "estado" => "1fr",
        "tarifa" => ".9fr",
        "descripcion" or "reglas" => "minmax(140px,1.4fr)",
        _ => "minmax(120px,150px)"   // campos propios
    };
    private string ZcGridStyle => "grid-template-columns: 38px 34px " + string.Join(" ", ColsVisibles().Select(k => _colWZ.TryGetValue(k, out var w) ? w + "px" : ColWidth(k))) + " 60px 40px";

    // ===== Menu "Columnas" inline (orden/visibilidad + borrar DIN). Crear campo = "+" del header; editar
    // /eliminar = engranaje. Persistencia identica a Unidades: unidades-config con Entidad="zona". =====
    private bool _showColMenuZ;
    private string _colQZ = "";
    private bool _colBusyZ;
    private ZonaCampoDefinicionDto? _campoAEliminarZ;

    private GuardarUnidadCampoConfigRequest FilaConfigZ(string clave)
    {
        _cfgZona.TryGetValue(clave, out var c);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato,
            Oculto: c?.Oculto ?? !VisibleColDefault(clave), Orden: c?.Orden, Entidad: "zona");
    }
    private async Task GuardarCfgZAsync(GuardarUnidadCampoConfigRequest req)
    {
        try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { }
    }
    private async Task CargarCfgZAsync()
    {
        try
        {
            var cfg = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config?entidad=zona") ?? new();
            _cfgZona = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchosZ();
        }
        catch { }
    }
    private async Task ToggleVisibleColZAsync(string clave)
    {
        var visible = VisibleCol(clave);
        await GuardarCfgZAsync(FilaConfigZ(clave) with { Oculto = visible });
        await CargarCfgZAsync(); StateHasChanged();
    }
    private async Task MoverColumnaZAsync(string clave, int dir)
    {
        var keys = ClavesOrdenadas().ToList();
        var i = keys.IndexOf(clave); var j = i + dir;
        if (i <= 0 || j <= 0 || j >= keys.Count) return; // la 1a columna ('nombre') queda fija
        (keys[i], keys[j]) = (keys[j], keys[i]);
        for (int k = 0; k < keys.Count; k++) await GuardarCfgZAsync(FilaConfigZ(keys[k]) with { Orden = k });
        await CargarCfgZAsync(); StateHasChanged();
    }
    private async Task OcultarTodasColZAsync()
    {
        var keys = ClavesOrdenadas().ToList();
        for (int k = 0; k < keys.Count; k++)
        {
            if (k == 0) continue; // 'nombre' no se oculta
            await GuardarCfgZAsync(FilaConfigZ(keys[k]) with { Oculto = true });
        }
        await CargarCfgZAsync(); StateHasChanged();
    }
    private async Task MostrarTodasColZAsync()
    {
        foreach (var k in ClavesOrdenadas()) await GuardarCfgZAsync(FilaConfigZ(k) with { Oculto = false });
        await CargarCfgZAsync(); StateHasChanged();
    }
    private async Task RestablecerColZAsync()
    {
        foreach (var k in ClavesOrdenadas()) await GuardarCfgZAsync(FilaConfigZ(k) with { Oculto = !VisibleColDefault(k), Orden = null });
        await CargarCfgZAsync(); StateHasChanged();
    }
    private async Task EliminarCampoDinZAsync()
    {
        if (_campoAEliminarZ is null) return;
        _colBusyZ = true;
        try
        {
            var r = await Auth().DeleteAsync($"/api/mi-copropiedad/zonas-campos/{_campoAEliminarZ.Id}");
            Msg(r.IsSuccessStatusCode ? $"Campo \"{_campoAEliminarZ.Label}\" eliminado." : "No se pudo eliminar el campo.", r.IsSuccessStatusCode);
            if (r.IsSuccessStatusCode) await CargarCamposYConfigAsync();
        }
        catch (Exception ex) { Msg("Error al eliminar el campo: " + ex.Message, false); }
        _campoAEliminarZ = null; _colBusyZ = false; StateHasChanged();
    }

    // ===== Crear / editar UN campo (modal focalizado, replica de la maqueta) =====
    private bool _crearCampoAbiertoZ;
    private CampoDinDef? _campoAEditarZ;
    private void AbrirCrearCampoZ() { _campoAEditarZ = null; _crearCampoAbiertoZ = true; }
    private void AbrirEditarCampoZ(ZonaCampoDefinicionDto c)
    {
        _campoAEditarZ = new CampoDinDef(c.Id, c.Label, c.Orden, c.Tipo, c.Opciones);
        _crearCampoAbiertoZ = true;
    }
    private async Task RecargarTrasCrearCampoZ()
    {
        _crearCampoAbiertoZ = false; _campoAEditarZ = null;
        await CargarCamposYConfigAsync();
        StateHasChanged();
    }
    private void AbrirGestorDesdeCrearZ()
    {
        _crearCampoAbiertoZ = false; _campoAEditarZ = null;
        _selAbierto = true;
    }

    // ===== Interacciones de tabla (como la maqueta): ordenar, mover columna, menu contextual =====
    private static int CmpValTabla(string a, string b)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var na = decimal.TryParse(a, System.Globalization.NumberStyles.Any, ci, out var da);
        var nb = decimal.TryParse(b, System.Globalization.NumberStyles.Any, ci, out var db);
        if (na && nb) return da.CompareTo(db);
        if (na) return -1; if (nb) return 1;
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }

    // Ordenar multi-criterio apilable (boton "Ordenar", canonico). El clic en cabecera es el caso de
    // un solo criterio, sincronizado con esta misma lista. El indicador de cabecera deriva del primero.
    private List<TablaOrdenarMenu.Sort> _sortsZ = new();
    private string? _sortKeyZ => _sortsZ.Count > 0 ? _sortsZ[0].Key : null;
    private int _sortDirZ => _sortsZ.Count > 0 ? _sortsZ[0].Dir : 1;
    // Columnas ofrecidas en el menu Ordenar: las visibles (fijas + dinamicas "cd:{id}"), con su etiqueta.
    private List<TablaOrdenarMenu.Col> ColsOrdenables()
        => ColsVisibles().Select(k => new TablaOrdenarMenu.Col(k, ColLabel(k))).ToList();
    private void OnSortsChanged() { _paginaZ = 1; StateHasChanged(); }
    // Clic en cabecera: opera _sortsZ como un unico criterio (reclic invierte, otra columna reemplaza).
    private void OrdenarPorColumnaZ(string clave)
    {
        var ex = _sortsZ.FirstOrDefault(s => s.Key == clave);
        if (_sortsZ.Count == 1 && ex is not null) ex.Dir = -ex.Dir;
        else _sortsZ = new() { new TablaOrdenarMenu.Sort { Key = clave, Dir = 1 } };
        _paginaZ = 1;
    }
    private string SortStrZ(ZonaComunDto z, string k)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var cd = CampoCustom(k);
        if (cd is not null) return ValorCampo(z.Id, cd.Id) ?? "";
        return k switch
        {
            "nombre" => z.Nombre ?? "",
            "categoria" => z.Categoria.ToString(),
            "reservable" => z.EsReservable ? "Si" : "No",
            "aforo" => z.CapacidadPersonas?.ToString(ci) ?? "",
            "estado" => z.Estado.ToString(),
            "tarifa" => z.TarifaReserva?.ToString(ci) ?? "",
            "descripcion" => z.Descripcion ?? "",
            "reglas" => z.ReglasUso ?? "",
            _ => ""
        };
    }

    // Mover columna por ARRASTRE de puntero (JS propiaTablaColReorder; persiste como el menu Columnas)
    private async Task IniciarReorderZ(MouseEventArgs e, string clave)
    {
        _selfZ ??= DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _selfZ, clave, e.ClientX, e.ClientY); } catch { }
    }
    [JSInvokable]
    public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        var keys = ClavesOrdenadas().ToList();
        var from = keys.IndexOf(src); var to = keys.IndexOf(dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, src);
        for (int i = 0; i < keys.Count; i++) await GuardarCfgZAsync(FilaConfigZ(keys[i]) with { Orden = i });
        await CargarCfgZAsync(); StateHasChanged();
    }

    // Menu contextual (clic derecho)
    private bool _ctxOpenZ;
    private double _ctxXZ, _ctxYZ;
    private List<TablaCtxMenu.Item> _ctxItemsZ = new();
    private void AbrirCtxZ(MouseEventArgs e, ZonaComunDto z)
    {
        _ctxXZ = e.ClientX; _ctxYZ = e.ClientY;
        _ctxItemsZ = new()
        {
