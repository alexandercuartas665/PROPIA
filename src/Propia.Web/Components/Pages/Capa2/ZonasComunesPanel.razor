    private readonly Dictionary<string, int> _colWZ = new(StringComparer.Ordinal);
    private DotNetObjectReference<ZonasComunesPanel>? _selfZ;
    private async Task IniciarResizeZ(MouseEventArgs e, string clave)
    {
