    .zc-stat-val { font-size: 19px; font-weight: 800; color: var(--bs-heading-color, var(--propia-text-h1)); line-height: 1.05; }
    .zc-stat-lbl { font-size: 10.5px; color: var(--propia-text-faint); font-weight: 700; letter-spacing: .2px; white-space: nowrap; }
