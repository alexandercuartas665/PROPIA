    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jwt is null)
        {
            // Mismo arranque que las demas paginas de Capa 2: el JWT vive en sessionStorage
            // y solo es legible tras el primer render (no existe en prerender).
            try
            {
                var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
                _authChecked = true;
                if (string.IsNullOrWhiteSpace(stored))
                {
                    Nav.NavigateTo("/login?returnUrl=%2Fzonas-comunes", true);
                    return;
                }
                _jwt = stored;
                await RestaurarVistaAsync();
                await CargarAsync();
                StateHasChanged();
            }
            catch { /* prerender */ }
            return;
        }
        if (_focusPending)
        {
            _focusPending = false;
            try { await _nombreRef.FocusAsync(); } catch { }
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/zonas");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (nuevoJwt is null) return;
                _jwt = nuevoJwt;
                resp = await Auth().GetAsync("/api/mi-copropiedad/zonas");
            }
            resp.EnsureSuccessStatusCode();
            _zonas = await resp.Content.ReadFromJsonAsync<List<ZonaComunDto>>() ?? new();
            await CargarCamposYConfigAsync();
            _loadError = null;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private async Task CargarCamposYConfigAsync()
    {
        try { _camposDef = await Auth().GetFromJsonAsync<List<ZonaCampoDefinicionDto>>("/api/mi-copropiedad/zonas-campos") ?? new(); } catch { _camposDef = new(); }
        try
        {
            var flat = await Auth().GetFromJsonAsync<List<ZonaCampoValorFlatDto>>("/api/mi-copropiedad/zonas-campos-valores") ?? new();
            _camposValores = flat.GroupBy(v => v.ZonaComunId).ToDictionary(g => g.Key, g => g.ToDictionary(x => x.DefinicionId, x => x.Valor));
        }
        catch { _camposValores = new(); }
        try
        {
            var cfg = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config?entidad=zona") ?? new();
            _cfgZona = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchosZ();
        }
        catch { _cfgZona = new(StringComparer.Ordinal); }
    }

