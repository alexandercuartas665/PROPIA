    private Task ResetResizeZ(string clave) => OnColResize(clave, 0);
    [JSInvokable]
    public async Task OnColResize(string clave, int width)
    {
        int? w = width <= 0 ? null : Math.Max(70, width);
        if (w is null) _colWZ.Remove(clave); else _colWZ[clave] = w.Value;
        var fila = FilaConfigZ(clave);
        await GuardarCfgZAsync(fila with { Formato = ConAnchoTabla(fila.Formato, w) });
