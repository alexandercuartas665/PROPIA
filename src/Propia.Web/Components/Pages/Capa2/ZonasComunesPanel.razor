    // Edicion inline de una celda en la vista Tabla: arma el request con el valor cambiado y
    // conserva el resto (reserva/aforo van como null cuando no cambian, para no pisarlos).
    private async Task GuardarZonaInline(ZonaComunDto z, string campo, ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        var nombre = z.Nombre; var categoria = z.Categoria; var estado = z.Estado;
        var descripcion = z.Descripcion; var tarifa = z.TarifaReserva; var reglas = z.ReglasUso;
        bool? reservable = null; int? aforo = null;
        switch (campo)
        {
            case "nombre":
                if (string.IsNullOrWhiteSpace(val) || val.Trim() == z.Nombre) return;
                nombre = val.Trim(); break;
            case "categoria":
                if (!Enum.TryParse<CategoriaZonaComun>(val, out categoria) || categoria == z.Categoria) return;
                break;
            case "estado":
                if (!Enum.TryParse<EstadoZonaComunMantenimiento>(val, out estado) || estado == z.Estado) return;
                break;
            case "reservable":
                var r = val == "true";
                if (r == z.EsReservable) return;
                reservable = r; break;
            case "aforo":
                aforo = int.TryParse(val, out var a) ? a : (int?)null;
                if (aforo == z.CapacidadPersonas) return;
                break;
            case "descripcion":
                descripcion = string.IsNullOrWhiteSpace(val) ? null : val.Trim();
                if (descripcion == z.Descripcion) return;
                break;
            case "tarifa":
                tarifa = decimal.TryParse(val, out var t) ? t : (decimal?)null;
                if (tarifa == z.TarifaReserva) return;
                break;
            case "reglas":
                reglas = string.IsNullOrWhiteSpace(val) ? null : val.Trim();
                if (reglas == z.ReglasUso) return;
                break;
        }
        try
        {
            var req = new ActualizarZonaComunRequest(nombre, categoria, descripcion, tarifa, reglas, estado, reservable, aforo);
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/zonas/{z.Id}", req);
            if (resp.IsSuccessStatusCode)
            {
                var upd = await resp.Content.ReadFromJsonAsync<ZonaComunDto>();
                var idx = _zonas.FindIndex(x => x.Id == z.Id);
                if (upd is not null && idx >= 0) _zonas[idx] = upd;
                Msg("Zona actualizada.", true);
            }
            else Msg(await MensajeDeError(resp, "No se pudo actualizar la zona."), false);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
    }

    private async Task CrearDesdeDraftAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.Nombre)) return;
        _busy = true;
        try
        {
            var req = new CrearZonaComunRequest(_draft.Nombre.Trim(), _draft.Categoria, null,
                _draft.EsReservable, null, _draft.Aforo, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/zonas", req);
            if (resp.IsSuccessStatusCode)
            {
                if (_nuCampos.Count > 0)
                {
                    try
                    {
                        var creada = await resp.Content.ReadFromJsonAsync<ZonaComunDto>();
                        if (creada is not null)
                            foreach (var kv in _nuCampos)
                                if (!string.IsNullOrWhiteSpace(kv.Value))
                                    await Auth().PutAsJsonAsync($"/api/mi-copropiedad/zonas/{creada.Id}/campos/{kv.Key}", new SetCampoValorRequest(kv.Value));
                    }
                    catch { }
                    _nuCampos.Clear();
                }
                _draft.Reset(); _reveal = 0; _composerOpen = false; _altaAbiertaZ = false; _nonce++; _focusPending = true;
                await CargarAsync();
                Msg("Zona comun creada. Haz clic en ella para completar la ficha.", true);
            }
            else Msg(await MensajeDeError(resp, "No se pudo crear la zona."), false);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
        _busy = false;
    }

    // El ojito del composer: crea la zona, lee el DTO devuelto y abre su ficha para seguir
    // completando (imagen, horarios, etc.) sin tener que buscarla en la lista.
    private async Task CrearYAbrirFichaAsync()
    {
        // Desde el expansor la fila puede estar vacia: se usa un nombre por defecto y se completa en la ficha.
        var nombre = string.IsNullOrWhiteSpace(_draft.Nombre) ? "Nueva zona comun" : _draft.Nombre.Trim();
        _busy = true;
        ZonaComunDto? creada = null;
        try
        {
            var req = new CrearZonaComunRequest(nombre, _draft.Categoria, null,
                _draft.EsReservable, null, _draft.Aforo, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/zonas", req);
            if (resp.IsSuccessStatusCode)
            {
                creada = await resp.Content.ReadFromJsonAsync<ZonaComunDto>();
                _draft.Reset(); _reveal = 0; _composerOpen = false; _nonce++;
                await CargarAsync();
            }
            else Msg(await MensajeDeError(resp, "No se pudo crear la zona."), false);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
        _busy = false;
        if (creada is not null) await AbrirFichaZonaAsync(creada, abrirEnEdicion: true);
    }

    private async Task EliminarZonaAsync(Guid id, string nombre)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Eliminar la zona \"{nombre}\"?")) return;
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/zonas/{id}");
        if (resp.IsSuccessStatusCode) { await CargarAsync(); Msg("Zona eliminada.", true); }
        else Msg(await MensajeDeError(resp, "No se pudo eliminar la zona."), false);
    }

    private void Msg(string m, bool ok) { _msg = m; _msgOk = ok; }

    private static async Task<string> MensajeDeError(HttpResponseMessage resp, string porDefecto)
    {
        try
        {
            var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (err is not null && err.TryGetValue("error", out var m) && !string.IsNullOrWhiteSpace(m)) return m;
        }
        catch { }
        return porDefecto;
    }
