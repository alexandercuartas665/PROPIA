@page "/asambleas"
@page "/asambleas/nueva"
@page "/asambleas/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Asambleas
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Asambleas
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals
@implements IDisposable

<PageTitle>Asambleas - PROPIA</PageTitle>

@* Modulo 2.8 Asambleas. Bandeja CANONICA (= Unidades / replica RP.modAsambleas): Filtros / Buscar / Ordenar /
   Agrupar / Columnas / Descargar + toggle Tarjetas | Tabla, de SOLO LECTURA (el ciclo de la sesion se gestiona en
   la ficha). La ficha y el asistente "Nueva sesion" se abren en MODAL encima de la bandeja; /asambleas/{Id} y
   /asambleas/nueva quedan como enlaces profundos que abren ese modal. Logica en Asambleas.Bandeja.cs. *@

<div class="mb-4 d-flex justify-content-between align-items-start gap-2 flex-wrap">
    <div>
        <h1 class="h3 mb-1 fw-semibold">Asambleas y Organos de Gobierno</h1>
        <p class="text-muted mb-0">Ciclo documental Ley 675/2001 + Decreto 1074/2015</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-1" href="/ayuda/asambleas.html" target="_blank" rel="noopener" title="Manual de usuario del módulo">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg> Manual
        </a>
        <button type="button" class="btn btn-outline-secondary" @onclick="AbrirGobiernoAsync" disabled="@string.IsNullOrEmpty(_jwt)" title="Consejo de administración, comités y revisor fiscal">Órganos de gobierno</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConfigAsync" disabled="@string.IsNullOrEmpty(_jwt)">Configuración</button>
        <button type="button" class="btn" style="background: var(--propia-primary); color: var(--propia-text-inverse);" @onclick="AbrirNuevaAsync" disabled="@string.IsNullOrEmpty(_jwt)">+ Nueva sesión</button>
    </div>
</div>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
}
else if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else if (_b is null)
{
    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }
    else { <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div> }
}
else
{
    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

    <div class="asm-bandeja">
        <div class="dst-filtros">
            <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="StateHasChanged" />
            <div class="dst-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input class="dst-search-inp" placeholder="Buscar por título..." @bind="_q" @bind:event="oninput" />
            </div>
            <div class="dst-filtros-spacer"></div>
            <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sorts" SortsChanged="StateHasChanged" />
            <TablaAgruparMenu Columnas="ColsAgrupables()" Grupos="_grupos" GruposChanged="OnGruposChanged" />
            <div class="dst-menu-wrap">
                <button type="button" class="dst-fbtn @(_showColMenu ? "on" : "")" @onclick="() => _showColMenu = !_showColMenu" title="Columnas: orden, visibilidad y ancho">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
                    <span>Columnas</span>
                </button>
                @if (_showColMenu)
                {
                    <div class="dst-menu-bd" @onclick="() => _showColMenu = false"></div>
                    <div class="dst-menu dst-colmenu">
                        <div class="dst-col-search">
                            <input placeholder="Buscar campo..." @bind="_colQ" @bind:event="oninput" />
                        </div>
                        <div class="dst-col-list">
                            @for (var i = 0; i < _colOrder.Count; i++)
                            {
                                var idx = i;
                                var key = _colOrder[idx];
                                var label = ColLabel(key);
                                if (!string.IsNullOrWhiteSpace(_colQ) && !label.Contains(_colQ.Trim(), StringComparison.OrdinalIgnoreCase)) continue;
                                var visible = !_colHidden.Contains(key);
                                <div class="dst-col-it">
                                    <button class="dst-col-mv" disabled="@(idx <= 1)" @onclick="() => MoverCol(idx, -1)">▲</button>
                                    <button class="dst-col-mv" disabled="@(idx == 0 || idx == _colOrder.Count - 1)" @onclick="() => MoverCol(idx, 1)">▼</button>
                                    <span class="dst-col-name">@label</span>
                                    @if (idx == 0) { <span class="dst-col-fija">fija</span> }
                                    else
                                    {
                                        <button class="dst-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => SetColVisible(key, !visible)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="dst-col-massacts">
                            <button type="button" class="dst-col-mass" @onclick="OcultarTodo"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                            <button type="button" class="dst-col-mass" @onclick="MostrarTodo"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                            <button type="button" class="dst-col-reset" @onclick="RestablecerCol">Restablecer</button>
                        </div>
                    </div>
                }
            </div>
            @if (_vista == "tabla")
            {
                <TablaExportar Vista="VistaExport" />
            }
            <TablaVistaToggle Opciones="@VistasOpc" Valor="@_vista" OnCambiar="SetVista" />
        </div>

        @if (_sel.Count > 0 && _vista == "tabla")
        {
            <div class="dst-selbar">
                <span class="dst-selbar-n">@(_sel.Count + " seleccionada" + (_sel.Count == 1 ? "" : "s"))</span>
                <button type="button" class="dst-selbar-del" @onclick="() => _confirmDel = true">
                    <i class="fi fi-rr-trash"></i> Eliminar
                </button>
                <button type="button" class="dst-selbar-x" @onclick="() => _sel.Clear()">Deseleccionar</button>
            </div>
        }
        @if (_confirmDel)
        {
            <div class="dst-cfg-back" @onclick="() => { if (!_delBusy) _confirmDel = false; }">
                <div class="dst-cfg" style="width:440px" @onclick:stopPropagation="true">
                    <div class="dst-cfg-head"><strong>@("Eliminar " + _sel.Count + " sesión" + (_sel.Count == 1 ? "" : "es"))</strong></div>
                    <div class="dst-cfg-sub">Solo se pueden eliminar sesiones en Borrador o Canceladas. Las que ya siguen su ciclo (citada, en curso, cerrada) no se borran.</div>
                    <div class="dst-cfg-actions">
                        <button type="button" class="dst-fbtn" @onclick="() => _confirmDel = false" disabled="@_delBusy">Cancelar</button>
                        <button type="button" class="dst-selbar-del" @onclick="EliminarSeleccionadasAsync" disabled="@_delBusy">Si, eliminar</button>
                    </div>
                </div>
            </div>
        }

        @if (_vista == "tarjetas")
        {
            var niveles = Niveles;
            var filas = Ordenadas().ToList();
            <div class="dst-table">
                @if (filas.Count == 0)
                {
                    <div class="dst-empty"><strong>Ninguna asamblea coincide con el filtro.</strong><span>Ajusta la búsqueda o los filtros.</span></div>
                }
                else if (niveles.Count > 0)
                {
                    <div class="dst-lista">
                        @foreach (var item in Aplanar(ArbolGrupos(niveles)))
                        {
                            if (item.Grupo is { } g)
                            {
                                <div class="dst-group" style="padding-left:@(16 + g.Nivel * 16)px;"><span class="dst-group-t">@g.Titulo</span><span class="dst-group-n">@g.Conteo</span></div>
                            }
                            else { @TarjetaTpl(item.Fila!) }
                        }
                    </div>
                }
                else
                {
                    <div class="dst-lista">
                        @foreach (var s in filas) { @TarjetaTpl(s) }
                    </div>
                }
            </div>
        }
        else if (Items.Count > 0 && Filtradas().Count == 0)
        {
            <div class="dst-empty"><strong>Ninguna asamblea coincide con el filtro.</strong><span>Ajusta la búsqueda o los filtros.</span></div>
        }
        else
        {
            var cols = ColsVisibles.ToList();
            var niveles = Niveles;
            <div class="dst-table">
                <div class="tblwrap">
                <div class="dst-scroll tblscroll">
                <table class="tbl">
                    <colgroup>
                        <col style="width:38px" /><col style="width:34px" />
                        @foreach (var k in cols) { <col style="@ColStyle(k)" /> }
                        <col style="width:56px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="tbl-sel"><label class="tbl-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodasSeleccionadas" @onchange="@(e => ToggleSelAll((bool)(e.Value ?? false)))" /></label></th>
                            <th class="tbl-exp"></th>
                            @foreach (var k in cols)
                            {
                                var clave = k;
                                var lbl = ColLabel(k);
                                <th class="tbl-th--menu @(EsNum(k) ? "tbl-num" : "")" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                                    @onmousedown="e => IniciarReorder(e, clave)" @onclick="() => OrdenarPorClic(clave)">
                                    <span class="tbl-th-lbl">@lbl</span>
                                    @SortInd(clave)
                                    @ChevCol(clave, lbl)
                                    <span class="tbl-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => OnColResize(clave, 0)" @ondblclick:stopPropagation="true"></span>
                                </th>
                            }
                            <th class="tbl-addcol"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (niveles.Count > 0)
                        {
                            <TablaGruposRenderTr T="SesionListaDto" Nodos="@ArbolGrupos(niveles)" FilaTemplate="FilaTpl" Colspan="@ColSpanTotal" CabeceraTemplate="CabeceraGrupoTpl" />
                        }
                        else
                        {
                            @foreach (var s in Ordenadas()) { @FilaTpl(s) }
                        }
                    </tbody>
                </table>
                </div>
                </div>
                @if (niveles.Count == 0)
                {
                    <div class="tbl-foot">@Filtradas().Count registros &middot; mostrando @Filtradas().Count</div>
                }
            </div>
        }
    </div>
    @if (!string.IsNullOrEmpty(_toast)) { <div class="dst-toast @(_toastErr ? "err" : "")" @onclick="() => _toast = null">@_toast</div> }
}

@* Modal Configuracion de asambleas (por copropiedad): criterio de mayoria + parametros de citacion *@
@if (_asmCfg is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Configuración de asambleas</h5>
                    <button type="button" class="btn-close" @onclick="() => _asmCfg = null"></button>
                </div>
                <div class="modal-body small">
                    <label class="form-label fw-semibold mb-1">Criterio de mayoría al cerrar una votación</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="cm-masde" name="cm" checked="@(_asmCfg.Criterio == CriterioMayoria.MasDe)"
                               @onchange="() => _asmCfg.Criterio = CriterioMayoria.MasDe" />
                        <label class="form-check-label" for="cm-masde"><strong>Más del porcentaje</strong> (mayoría absoluta, Ley 675). Con mayoría del 50 %, un empate 50/50 <em>no</em> se aprueba.</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" id="cm-almenos" name="cm" checked="@(_asmCfg.Criterio == CriterioMayoria.AlMenos)"
                               @onchange="() => _asmCfg.Criterio = CriterioMayoria.AlMenos" />
                        <label class="form-check-label" for="cm-almenos"><strong>Al menos el porcentaje</strong>. Con mayoría del 50 %, un empate 50/50 <em>sí</em> se aprueba.</label>
                    </div>
                    <div class="text-muted mb-3">El porcentaje de cada punto (por ejemplo 50 % o 70 %) se define al crear la sesión. El cambio aplica a las votaciones que se cierren desde ahora.</div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label mb-1" for="cfg-plazo">Plazo de citación (días)</label>
                            <input id="cfg-plazo" type="number" min="0" max="60" class="form-control form-control-sm" @bind="_asmCfg.PlazoCitacionDias" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1" for="cfg-poderes">Poderes por persona (0 = sin límite)</label>
                            <input id="cfg-poderes" type="number" min="0" max="50" class="form-control form-control-sm" @bind="_asmCfg.LimitePoderes" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1" for="cfg-gracia">Gracia de reconexión (segundos)</label>
                            <input id="cfg-gracia" type="number" min="0" max="3600" class="form-control form-control-sm" @bind="_asmCfg.GraciaReconexionSeg" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1" for="cfg-recordatorio">Recordatorio (días antes)</label>
                            <input id="cfg-recordatorio" type="number" min="0" max="30" class="form-control form-control-sm" @bind="_asmCfg.NotifRecordatorioDias" />
                        </div>
                    </div>
                    @if (_asmCfgError is not null) { <div class="alert alert-danger py-2 small mt-3 mb-0">@_asmCfgError</div> }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-dark" @onclick="() => _asmCfg = null">Cancelar</button>
                    <button class="btn btn-sm btn-primary" @onclick="GuardarConfigAsync" disabled="@_asmCfgBusy">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />
<TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" ModoAgregado="AggOferta" />
<ModalHost />

@code {
    // ===== Fila de la Tabla (solo lectura: clic / expandir abren la ficha) =====
    private RenderFragment<SesionListaDto> FilaTpl => s => @<tr class="dst-row--tr @(_sel.Contains(s.Id) ? "dst-row-sel" : "")" @key="s.Id" @oncontextmenu="e => AbrirCtx(e, s)" @oncontextmenu:preventDefault="true">
        <td class="tbl-sel"><label class="tbl-chk"><input type="checkbox" checked="@_sel.Contains(s.Id)" @onchange="@(e => ToggleSel(s.Id, (bool)(e.Value ?? false)))" @onclick:stopPropagation="true" /></label></td>
        <td class="tbl-exp">
            <button type="button" class="tbl-exp-btn" title="Abrir la asamblea" @onclick="() => AbrirFichaAsync(s.Id)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </button>
        </td>
        @foreach (var k in ColsVisibles) { @Celda(s, k) }
        <td class="tbl-addcol"></td>
    </tr>;

    private RenderFragment Celda(SesionListaDto s, string k)
    {
        switch (k)
        {
            case "titulo":
                return @<td class="tbl-ro" style="cursor:pointer" @onclick="() => AbrirFichaAsync(s.Id)"><strong>@s.Titulo</strong>@if (s.SegundaConvocatoria) {<span class="badge bg-warning text-dark ms-1">2da convocatoria</span>}@if (s.ActaPublicada) {<span class="badge bg-success ms-1">Acta publicada</span>}</td>;
            case "tipo":
                return @<td class="tbl-ro"><span class="badge bg-light text-dark border">@TipoTexto(s.Tipo)</span></td>;
            case "estado":
                return @<td class="tbl-ro">@BadgeEstado(s.Estado)</td>;
            case "puntos":
            case "participantes":
                return @<td class="tbl-ro tbl-num">@TextoCelda(s, k)</td>;
            default:
                return @<td class="tbl-ro">@TextoCelda(s, k)</td>;
        }
    }

    // ===== Vista Tarjetas (lista compacta, como la replica) =====
    private RenderFragment TarjetaTpl(SesionListaDto s) => @<div class="dst-lrow" title="Abrir la asamblea" @key="s.Id" @onclick="() => AbrirFichaAsync(s.Id)" @oncontextmenu="e => AbrirCtx(e, s)" @oncontextmenu:preventDefault="true">
        <span class="dst-lav"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 7h8l1 4H7zM5 11h14v1a7 7 0 0 1-14 0zM12 19v2M9 21h6"/></svg></span>
        <span class="dst-lmain"><span class="dst-lnum">@s.Titulo</span><span class="dst-lmeta">@TipoTexto(s.Tipo) &middot; @s.Modalidad &middot; @s.FechaSesion.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span></span>
        <span class="dst-lprop">@BadgeEstado(s.Estado)@if (s.SegundaConvocatoria) {<span class="badge bg-warning text-dark ms-1">2da conv.</span>}</span>
        <span class="dst-ltags"><span class="dst-ltag">@s.CantidadPuntos puntos</span><span class="dst-ltag">@s.CantidadParticipantes unidades</span></span>
        <svg class="dst-lchev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--propia-text-faint);"><path d="M9 6l6 6-6 6"/></svg>
    </div>;

    // ===== Cabecera de grupo con totales por columna (Suma/Prom/Min/Max/Contar) =====
    private RenderFragment<NodoGrupo<SesionListaDto>> CabeceraGrupoTpl => nodo =>
    @<tr class="tgrt-hd tgrt-l@(nodo.Nivel > 2 ? 2 : nodo.Nivel)">
        @{
            var colsG = ColsVisibles.ToList();
            var idxAgg = colsG.FindIndex(c => ModoActivo(c) != "off");
        }
        @if (idxAgg < 0)
        {
            <td colspan="@ColSpanTotal">
                <span class="tgrt-lead" style="padding-left:@(14 + nodo.Nivel * 16)px;">
                    <span class="tgrt-tit">@nodo.Titulo</span>
                    <span class="tgrt-cnt">@nodo.Conteo</span>
                </span>
            </td>
        }
        else
        {
            var miembros = TodasFilas(nodo);
            <td colspan="@(2 + idxAgg)">
                <span class="tgrt-lead" style="padding-left:@(14 + nodo.Nivel * 16)px;">
                    <span class="tgrt-tit">@nodo.Titulo</span>
                    <span class="tgrt-cnt">@nodo.Conteo</span>
                </span>
            </td>
            @for (int ci = idxAgg; ci < colsG.Count; ci++)
            {
                var colG = colsG[ci];
                var (hayG, txtG, tagG) = AggCelda(miembros, colG);
                <td class="tgrt-agg">
                    @if (hayG)
                    {
                        <span class="tgrt-aggv" title="@TituloAgg(tagG)">@txtG@if (tagG.Length > 0) { <span class="tgrt-aggtag">@tagG</span> }</span>
                    }
                </td>
            }
            <td class="tbl-addcol"></td>
        }
    </tr>;

    private RenderFragment SortInd(string k)
    {
        var s = _sorts.FirstOrDefault(x => x.Key == k);
        return s is null ? (__b => { }) : (@<span class="tbl-th-arrow">@((MarkupString)(s.Dir >= 0 ? "&#9650;" : "&#9660;"))</span>);
    }
    private RenderFragment ChevCol(string clave, string label) =>@<button type="button" class="tbl-th-edit" title="Opciones de columna" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="(e) => _colMenu?.Abrir(new TablaColMenu.Ctx(clave, label, false), e.ClientX, e.ClientY)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg></button>;

    private static RenderFragment BadgeEstado(EstadoSesion e) => e switch
    {
        EstadoSesion.Borrador => @<span class="badge bg-light text-dark border">Borrador</span>,
        EstadoSesion.Citada => @<span class="badge bg-info text-dark">Citada</span>,
        EstadoSesion.EnCurso => @<span class="badge bg-primary">En curso</span>,
        EstadoSesion.Cerrada => @<span class="badge bg-success">Cerrada</span>,
        EstadoSesion.QuorumFallido => @<span class="badge bg-warning text-dark">Quórum fallido</span>,
        EstadoSesion.Cancelada => @<span class="badge bg-secondary">Cancelada</span>,
        _ => __b => { }
    };
}
