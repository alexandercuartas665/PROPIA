    private async Task CrearYAsignarEtiqueta()
    {
        if (_editUser is null || string.IsNullOrWhiteSpace(_nuevaEtqNombre)) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/usuarios/etiquetas",
                new CrearEtiquetaUsuarioRequest(_nuevaEtqNombre.Trim(), _nuevaEtqColor));
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                _msg = err is not null && err.TryGetValue("error", out var m) ? m : "No se pudo crear la etiqueta.";
                _msgClass = "alert-danger";
                return;
            }
            var creada = await resp.Content.ReadFromJsonAsync<EtiquetaUsuarioDto>();
            _nuevaEtqNombre = ""; _nuevaEtqColor = "#6D4FE3";
            if (creada is not null)
                await Auth().PostAsync($"/api/usuarios/{_editUser.UsuarioTenantId}/etiquetas/{creada.Id}", null);
            await RecargarSinCerrarModalAsync();
        }
        finally { _busy = false; }
    }

