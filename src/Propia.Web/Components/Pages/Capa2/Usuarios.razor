    // La vista (Lista/Tabla) se recuerda por modulo en localStorage: sobrevive al cierre de
    // sesion (el logout solo borra llaves puntuales, no hace localStorage.clear()).
    private async Task SetVista(string v)
    {
        _vista = v;
        try { await Js.InvokeVoidAsync("localStorage.setItem", VistaKey, v); } catch { }
    }

    private async Task RestaurarVistaAsync()
    {
        try
        {
            var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey);
            if (v == "lista" || v == "tabla") _vista = v;
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await RestaurarVistaAsync();
                await CargarRolesAsync();
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { /* prerender */ }
    }

    private void SetTab(EstadoUsuarioTenant tab) { _tab = tab; _ = CargarAsync(); }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync($"/api/usuarios?q={Uri.EscapeDataString(_query)}");
            if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden) { _sinPermiso = true; _usuarios = new(); _pendientes = new(); return; }
            resp.EnsureSuccessStatusCode();
            _usuarios = await resp.Content.ReadFromJsonAsync<List<UsuarioListaDto>>() ?? new();
            _pendientes = await http.GetFromJsonAsync<List<InvitacionDto>>("/api/usuarios/invitaciones") ?? new();
            _etiquetas = await http.GetFromJsonAsync<List<EtiquetaUsuarioDto>>("/api/usuarios/etiquetas") ?? new();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

