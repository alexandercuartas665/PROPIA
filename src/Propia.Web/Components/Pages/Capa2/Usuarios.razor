@code {
    private string? _jwt;
    private EstadoUsuarioTenant _tab = EstadoUsuarioTenant.Activo;
    private string _query = "";
    private bool _busy;
    private bool _sinPermiso;
    private string? _msg; private string _msgClass = "alert-info";

    private List<UsuarioListaDto>? _usuarios;
    private List<InvitacionDto>? _pendientes;
    private List<RolDto> _roles = new();

    // Invitar
    private bool _showInvitar;
    private string _buscarPersona = "";
    private List<PersonaResumenDto> _personasEncontradas = new();
    private PersonaResumenDto? _personaSel;
    private Guid _invRolId;
    private CanalEnvioInvitacion _invCanal = CanalEnvioInvitacion.Email;
    private InvitacionDto? _ultimaInvitacion;

    // Editar usuario
    private UsuarioListaDto? _editUser;
    private Guid _editRolId;

    // Roles y permisos
    private bool _showRoles;
    private Guid? _rolEditando;
    private RolDetalleDto? _detalleEdit;
    private bool _creandoRol;
    private string _nuevoNombre = "";
    private string _copiarDe = "";

    private static readonly string[] ModulosVisibles =
    {
        "DASHBOARD", "MI_COPROPIEDAD", "DIRECTORIO", "USUARIOS_ACCESOS",
        "PRESUPUESTO", "CARTERA", "ASAMBLEAS", "PQRS", "TAREAS",
        "MANTENIMIENTO", "PORTERIA", "RESERVAS", "COMUNICACIONES", "DOCUMENTOS", "REPORTES"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarRolesAsync();
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { /* prerender */ }
    }

    private void SetTab(EstadoUsuarioTenant tab) { _tab = tab; _ = CargarAsync(); }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync($"/api/usuarios?q={Uri.EscapeDataString(_query)}");
            if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden) { _sinPermiso = true; _usuarios = new(); _pendientes = new(); return; }
            resp.EnsureSuccessStatusCode();
            _usuarios = await resp.Content.ReadFromJsonAsync<List<UsuarioListaDto>>() ?? new();
            _pendientes = await http.GetFromJsonAsync<List<InvitacionDto>>("/api/usuarios/invitaciones") ?? new();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task CargarRolesAsync()
    {
        try
        {
            var http = Auth();
            _roles = await http.GetFromJsonAsync<List<RolDto>>("/api/roles") ?? new();
        }
        catch { /* sin roles no podemos invitar pero el resto funciona */ }
    }

    // ---------------- Invitar ----------------
    private void AbrirInvitar()
    {
        _showInvitar = true;
        _personaSel = null; _buscarPersona = ""; _personasEncontradas.Clear();
        _invRolId = Guid.Empty; _invCanal = CanalEnvioInvitacion.Email; _ultimaInvitacion = null;
    }
    private void CerrarInvitar() => _showInvitar = false;

    private async Task BuscarPersonas()
    {
        if (string.IsNullOrWhiteSpace(_buscarPersona) || _buscarPersona.Length < 3)
        {
            _personasEncontradas.Clear();
            return;
        }
        var http = Auth();
        _personasEncontradas = await http.GetFromJsonAsync<List<PersonaResumenDto>>(
            $"/api/directorio/personas?q={Uri.EscapeDataString(_buscarPersona)}") ?? new();
    }

    private void SeleccionarPersona(PersonaResumenDto p) { _personaSel = p; _personasEncontradas.Clear(); }

    private async Task EnviarInvitacion()
    {
        if (_personaSel is null || _invRolId == Guid.Empty) return;
        _busy = true; _msg = null; _ultimaInvitacion = null;
        try
        {
            var http = Auth();
            var resp = await http.PostAsJsonAsync("/api/usuarios/invitaciones",
                new CrearInvitacionRequest(_personaSel.Id, _invRolId, _invCanal));
            if (!resp.IsSuccessStatusCode)
            {
                _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return;
            }
            _ultimaInvitacion = await resp.Content.ReadFromJsonAsync<InvitacionDto>();
            _msg = $"Invitacion enviada a {_personaSel.Nombres} {_personaSel.Apellidos}."; _msgClass = "alert-success";
            _personaSel = null; _buscarPersona = ""; _invRolId = Guid.Empty;
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task Reenviar(Guid id)
    {
        var http = Auth();
        await http.PutAsync($"/api/usuarios/invitaciones/{id}/reenviar", null);
        _msg = "Token regenerado y vigencia restablecida (72h)."; _msgClass = "alert-success";
        await CargarAsync();
    }

    private async Task Cancelar(Guid id)
    {
        var http = Auth();
        await http.DeleteAsync($"/api/usuarios/invitaciones/{id}");
        await CargarAsync();
    }

    private async Task CopiarLink(InvitacionDto i)
    {
        var url = $"{Nav.BaseUri.TrimEnd('/')}{i.LinkAceptacion}";
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
        _msg = $"Link copiado al portapapeles: {url}"; _msgClass = "alert-info";
    }

    private string LinkInvitacion(InvitacionDto i) => $"{Nav.BaseUri.TrimEnd('/')}{i.LinkAceptacion}";

    private async Task CopiarLinkUltima()
    {
        if (_ultimaInvitacion is null) return;
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", LinkInvitacion(_ultimaInvitacion));
        _msg = "Link copiado al portapapeles."; _msgClass = "alert-info";
    }

    // ---------------- Editar usuario ----------------
    private void AbrirEditar(UsuarioListaDto u)
    {
        _editUser = u;
        _editRolId = u.RolId ?? Guid.Empty;
    }
    private void CerrarEditar() => _editUser = null;

    private async Task GuardarEditar()
    {
        if (_editUser is null) return;
        _busy = true; _msg = null;
        try
        {
            if (_editRolId != Guid.Empty && _editRolId != _editUser.RolId)
            {
                var http = Auth();
                var resp = await http.PutAsJsonAsync($"/api/usuarios/{_editUser.UsuarioTenantId}/rol",
                    new CambiarRolUsuarioRequest(_editRolId));
                if (!resp.IsSuccessStatusCode)
                {
                    _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return;
                }
                _msg = "Rol actualizado."; _msgClass = "alert-success";
            }
            _editUser = null;
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task RevocarAccesoAsync(Guid usuarioTenantId)
    {
        var http = Auth();
        var resp = await http.PostAsJsonAsync($"/api/usuarios/{usuarioTenantId}/revocar",
            new RevocarAccesoRequest(null));
        if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
        _msg = "Acceso revocado. Sesion invalidada."; _msgClass = "alert-success";
        _editUser = null;
        await CargarAsync();
    }

    private async Task Reactivar(Guid usuarioTenantId)
    {
        var http = Auth();
        await http.PostAsync($"/api/usuarios/{usuarioTenantId}/reactivar", null);
        _msg = "Acceso reactivado."; _msgClass = "alert-success";
        await CargarAsync();
    }

    // ---------------- Roles y permisos ----------------
    private async Task AbrirRoles()
    {
        _showRoles = true; _rolEditando = null; _detalleEdit = null; _creandoRol = false;
        await CargarRolesAsync();
    }
    private void CerrarRoles() { _showRoles = false; _rolEditando = null; _detalleEdit = null; _creandoRol = false; }
    private void VolverARoles() { _rolEditando = null; _detalleEdit = null; }

    private async Task EditarRol(Guid rolId)
    {
        _rolEditando = rolId;
        var http = Auth();
        _detalleEdit = await http.GetFromJsonAsync<RolDetalleDto>($"/api/roles/{rolId}");
    }

    private async Task TogglePermiso(string modulo, AccionPermiso accion, bool habilitado)
    {
        if (_rolEditando is null || _detalleEdit is null) return;
        var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == modulo && p.Accion == accion);
        var nivel = celda?.NivelDato ?? NivelDato.Copropiedad;
        if (habilitado && nivel == NivelDato.SinAcceso) nivel = NivelDato.Copropiedad;

        var http = Auth();
        var resp = await http.PutAsJsonAsync($"/api/roles/{_rolEditando}/permisos",
            new ActualizarPermisoRequest(modulo, accion, habilitado, nivel));
        if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        await EditarRol(_rolEditando.Value);
    }

    private async Task CambiarNivel(string modulo, NivelDato nivel)
    {
        if (_rolEditando is null || _detalleEdit is null) return;
        var http = Auth();
        foreach (var accion in Enum.GetValues<AccionPermiso>())
        {
            var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == modulo && p.Accion == accion);
            if (celda is null || !celda.Habilitado) continue;
            await http.PutAsJsonAsync($"/api/roles/{_rolEditando}/permisos",
                new ActualizarPermisoRequest(modulo, accion, true, nivel));
        }
        await EditarRol(_rolEditando.Value);
    }

    private async Task ToggleExtendido(Guid rolId)
    {
        var http = Auth();
        await http.PutAsync($"/api/roles/{rolId}/activar", null);
        await CargarRolesAsync();
    }

    private async Task CrearRol()
    {
        if (string.IsNullOrWhiteSpace(_nuevoNombre)) return;
        _busy = true; _msg = null;
        try
        {
            var http = Auth();
            Guid? copiar = Guid.TryParse(_copiarDe, out var g) ? g : null;
            var resp = await http.PostAsJsonAsync("/api/roles",
                new CrearRolRequest(_nuevoNombre.Trim(), null, copiar));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = $"Rol '{_nuevoNombre}' creado."; _msgClass = "alert-success";
            _nuevoNombre = ""; _copiarDe = ""; _creandoRol = false;
            await CargarRolesAsync();
        }
        finally { _busy = false; }
    }

    private async Task EliminarRol(Guid rolId)
    {
        var http = Auth();
        var resp = await http.DeleteAsync($"/api/roles/{rolId}");
        if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
        _msg = "Rol eliminado."; _msgClass = "alert-success";
        await CargarRolesAsync();
    }

    // ---------------- Helpers ----------------
    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private static string Iniciales(string s)
    {
        var parts = s.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

