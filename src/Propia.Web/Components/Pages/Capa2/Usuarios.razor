@page "/usuarios"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.UsuariosAccesos
@using Propia.Application.Directorio
@using Propia.Application.MiCopropiedad
@using Propia.Application.Tareas
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Usuarios y Accesos - PROPIA</PageTitle>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

@if (_sinPermiso)
{
    <SinPermiso />
    return;
}

<div class="usr-wrap">

    @* ===================== Encabezado ===================== *@
    <div class="mod-pagehead">
        <div>
            <h1 class="mod-pagetitle">Usuarios y Roles</h1>
            <p class="mod-pagesub">Quien puede ingresar y con que permisos. La identidad vive en el Directorio.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="usr-btn-ghost" @onclick="AbrirRoles">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.1A1.6 1.6 0 0 0 6 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.6 1.6 0 0 0 4.6 15H4.5a2 2 0 1 1 0-4h.1A1.6 1.6 0 0 0 6 8.6a1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H10a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V8c0 .7.4 1.3 1 1.5h.1a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1 1.5z"></path></svg>
                Roles y permisos
            </button>
            <button class="usr-btn-primary" @onclick="AbrirInvitar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6"></path></svg>
                Invitar usuario
            </button>
        </div>
    </div>

    @* Las etiquetas se administran dentro del usuario (modal Editar): alli se asignan, se quitan
       y se crean. El catalogo es del tenant, asi que una etiqueta creada queda para todos. *@

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @_msgClass py-2 small">@_msg</div>
    }

    @* Mini-KPIs que ademas hacen de tabs (Activos / Pendientes / Inactivos), mismo patron que
       Unidades Privadas. La tarjeta activa se resalta y filtra la lista de abajo. *@
    <div class="mod-stats">
        <div class="mod-stat mod-stat--btn mod-stat--ok @(_tab == EstadoUsuarioTenant.Activo ? "active" : "")" @onclick="() => SetTab(EstadoUsuarioTenant.Activo)">
            <div class="mod-stat-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5 9-11"/></svg></div>
            <div><div class="mod-stat-n">@(_usuarios?.Count(u => u.Estado == EstadoUsuarioTenant.Activo) ?? 0)</div><div class="mod-stat-l">activos</div></div>
        </div>
        <div class="mod-stat mod-stat--btn mod-stat--warn @(_tab == EstadoUsuarioTenant.Pendiente ? "active" : "")" @onclick="() => SetTab(EstadoUsuarioTenant.Pendiente)">
            <div class="mod-stat-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
            <div><div class="mod-stat-n">@(_pendientes?.Count ?? 0)</div><div class="mod-stat-l">pendientes</div></div>
        </div>
        <div class="mod-stat mod-stat--btn @(_tab == EstadoUsuarioTenant.Inactivo ? "active" : "")" @onclick="() => SetTab(EstadoUsuarioTenant.Inactivo)">
            <div class="mod-stat-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg></div>
            <div><div class="mod-stat-n">@(_usuarios?.Count(u => u.Estado == EstadoUsuarioTenant.Inactivo) ?? 0)</div><div class="mod-stat-l">inactivos</div></div>
        </div>
    </div>

    @* ===================== Buscador + filtros + vista ===================== *@
    <div class="mod-filtros">
        <div class="mod-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="mod-search-inp" style="width:280px;" placeholder="Buscar por nombre, documento, email o rol..." @bind="_query" @bind:event="oninput" @onkeyup="CargarAsync" />
        </div>
        @if (_tab != EstadoUsuarioTenant.Pendiente)
        {
            <select class="mod-fsel" @bind="_filtroRolId">
                <option value="@Guid.Empty">Todos los roles</option>
                @foreach (var r in RolesDisponibles())
                {
                    <option value="@r.Id">@r.Nombre</option>
                }
            </select>
            <select class="mod-fsel" @bind="_filtroEtiquetaId">
                <option value="@Guid.Empty">Todas las etiquetas</option>
                @foreach (var e in _etiquetas)
                {
                    <option value="@e.Id">@e.Nombre</option>
                }
            </select>
            @* Dos vistas, las mismas que el Directorio: Lista (filas con avatar) y Tabla
               (todas las columnas + alta inline). Mismo toggle para que se lean igual. *@
            <div class="usr-viewtoggle" style="margin-left:auto;">
                <button class="usr-vbtn @(_vista == "lista" ? "on" : "")" @onclick='() => SetVista("lista")'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                    Lista
                </button>
                <button class="usr-vbtn @(_vista == "tabla" ? "on" : "")" @onclick='() => SetVista("tabla")'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                    Tabla
                </button>
            </div>
        }
    </div>

    @* ===================== Tabla Pendientes (invitaciones) ===================== *@
    @if (_tab == EstadoUsuarioTenant.Pendiente)
    {
        @if (_pendientes is null)
        {
            <div class="text-center py-5"><div class="spinner-border" style="color:#6D4FE3"></div></div>
        }
        else if (_pendientes.Count == 0)
        {
            <div class="usr-empty">Sin invitaciones pendientes.</div>
        }
        else
        {
            <div class="usr-table">
                <div class="usr-th">
                    <div style="width:42px;flex-shrink:0"></div>
                    <div style="width:280px;flex-shrink:0">PERSONA</div>
                    <div style="flex:1">ROL</div>
                    <div style="width:170px;flex-shrink:0">ESTADO</div>
                    <div style="width:240px;flex-shrink:0;text-align:right">ACCIONES</div>
                </div>
                @foreach (var i in _pendientes)
                {
                    var iid = i.Id;
                    var vencida = i.ExpiraAt < DateTimeOffset.UtcNow;
                    <div class="usr-row">
                        <div class="usr-av">@Iniciales(i.PersonaNombre)</div>
                        <div style="width:280px;flex-shrink:0;min-width:0">
                            <div class="usr-name">@i.PersonaNombre</div>
                            <div class="usr-email">@i.PersonaDocumento</div>
                        </div>
                        <div style="flex:1"><span class="usr-rol">@i.RolNombre</span></div>
                        <div style="width:170px;flex-shrink:0">
                            @if (vencida)
                            {
                                <span class="usr-badge-inact">Invitacion vencida</span>
                            }
                            else
                            {
                                <span class="usr-badge-pend">Invitacion enviada</span>
                            }
                            <div class="usr-email mt-1">Expira @i.ExpiraAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                        <div style="width:240px;flex-shrink:0;text-align:right" class="d-flex gap-1 justify-content-end">
                            <button class="usr-rowbtn" @onclick="() => CopiarLink(i)">Copiar link</button>
                            <button class="usr-rowbtn" @onclick="() => Reenviar(iid)">Reenviar</button>
                            <button class="usr-rowbtn usr-rowbtn-danger" @onclick="() => Cancelar(iid)">Cancelar</button>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @* ===================== Tabla Activos / Inactivos ===================== *@
        @if (_usuarios is null)
        {
            <div class="text-center py-5"><div class="spinner-border" style="color:#6D4FE3"></div></div>
        }
        else
        {
            var lista = _usuarios.Where(u => u.Estado == _tab)
                .Where(u => _filtroRolId == Guid.Empty || u.RolId == _filtroRolId)
                .Where(u => _filtroEtiquetaId == Guid.Empty || u.Etiquetas.Any(e => e.Id == _filtroEtiquetaId))
                .ToList();
            @if (lista.Count == 0 && _vista == "lista")
            {
                <div class="usr-empty">Sin usuarios @_tab.ToString().ToLower() en esta copropiedad.</div>
            }
            else if (_vista == "lista")
            {
                <UsuariosListaVista Usuarios="lista" OnEditar="AbrirEditar" OnReactivar="Reactivar" />
            }
            else
            {
                @* La Tabla siempre se pinta aunque no haya usuarios: su fila de alta es la
                   via para invitar en caliente (mismo criterio que el Directorio). *@
                <UsuariosTablaVista Usuarios="lista" Roles="_roles" OnEditar="AbrirEditar"
                                    OnReactivar="Reactivar" OnInvitar="InvitarUsuarioTabla" />
            }
        }
    }
</div>

@* ============================================================ *@
@* MODAL: Invitar usuario                                       *@
@* ============================================================ *@
@if (_showInvitar)
{
    <div class="usr-modal-bg" @onclick="CerrarInvitar">
        <div class="usr-modal" @onclick:stopPropagation="true">
            <div class="usr-modal-head">
                <div class="usr-modal-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6"></path></svg>
                </div>
                <div class="flex-grow-1">
                    <div class="usr-modal-title">Invitar usuario</div>
                    <div class="usr-modal-subtitle">Busca la persona en el Directorio y asignale un rol</div>
                </div>
                <button class="usr-modal-x" @onclick="CerrarInvitar">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="usr-modal-body">
                <label class="usr-label">Buscar en el Directorio</label>
                <input class="usr-input" placeholder="Nombre, documento o email" @bind="_buscarPersona" @bind:event="oninput" @onkeyup="BuscarPersonas" disabled="@(_personaSel is not null)" />

                @if (_personaSel is null)
                {
                    @if (_personasEncontradas.Count > 0)
                    {
                        <div class="usr-results">
                            @foreach (var p in _personasEncontradas)
                            {
                                var pp = p;
                                <button type="button" class="usr-result" @onclick="() => SeleccionarPersona(pp)">
                                    <div class="usr-av" style="width:34px;height:34px;font-size:12px">@Iniciales($"{p.Nombres} {p.Apellidos}")</div>
                                    <div class="min-w-0">
                                        <div class="usr-name">@p.Nombres @p.Apellidos</div>
                                        <div class="usr-email">@p.TipoDocumento @p.Documento @(string.IsNullOrEmpty(p.Email) ? "" : $". {p.Email}")</div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="usr-hint">El acceso siempre se otorga a una persona existente en el Directorio (RN-02). Si no aparece, agregala primero alli.</div>
                    }
                }
                else
                {
                    <div class="usr-pick">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="usr-av">@Iniciales($"{_personaSel.Nombres} {_personaSel.Apellidos}")</div>
                            <div class="min-w-0">
                                <div class="usr-name">@_personaSel.Nombres @_personaSel.Apellidos</div>
                                <div class="usr-email">@_personaSel.TipoDocumento @_personaSel.Documento @(string.IsNullOrEmpty(_personaSel.Email) ? "" : $". {_personaSel.Email}")</div>
                            </div>
                            <button class="usr-rowbtn ms-auto" @onclick="() => _personaSel = null">Cambiar</button>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="usr-label">Rol a asignar</label>
                                <select class="usr-select" @bind="_invRolId">
                                    <option value="@Guid.Empty">- Selecciona -</option>
                                    @foreach (var r in _roles.Where(r => r.Activo))
                                    {
                                        <option value="@r.Id">@r.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="usr-label">Canal de envio</label>
                                <select class="usr-select" @bind="_invCanal">
                                    <option value="@CanalEnvioInvitacion.Email">Email</option>
                                    <option value="@CanalEnvioInvitacion.Whatsapp">WhatsApp</option>
                                    <option value="@CanalEnvioInvitacion.Ambos">Email + WhatsApp</option>
                                </select>
                            </div>
                        </div>
                        <div class="usr-note">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                            El token de invitacion expira en 72 horas (RN-11).
                        </div>
                    </div>
                }

                @if (_ultimaInvitacion is not null)
                {
                    <div class="usr-link-ok">
                        <div class="fw-bold mb-1" style="color:#15703F">Invitacion creada. Comparte este link:</div>
                        <code class="user-select-all d-block mb-2" style="word-break:break-all">@LinkInvitacion(_ultimaInvitacion)</code>
                        <button class="usr-rowbtn" @onclick="CopiarLinkUltima">Copiar link</button>
                    </div>
                }
            </div>
            <div class="usr-modal-foot">
                <button class="usr-btn-ghost" @onclick="CerrarInvitar">Cerrar</button>
                <button class="usr-btn-primary" @onclick="EnviarInvitacion" disabled="@(_busy || _personaSel is null || _invRolId == Guid.Empty)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
                    @(_busy ? "Generando..." : "Enviar invitacion")
                </button>
            </div>
        </div>
    </div>
}

@* ============================================================ *@
@* MODAL: Editar usuario                                        *@
@* ============================================================ *@
@if (_editUser is not null)
{
    <div class="usr-modal-bg" @onclick="CerrarEditar">
        <div class="usr-modal usr-modal-user" @onclick:stopPropagation="true">
            <div class="usr-modal-head">
                <div class="usr-modal-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </div>
                <div class="flex-grow-1">
                    <div class="usr-modal-title">Editar usuario</div>
                    <div class="usr-modal-subtitle">Rol de acceso, etiquetas y participacion en la copropiedad</div>
                </div>
                <button class="usr-modal-x" @onclick="CerrarEditar">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="usr-modal-body">
            <div class="usr-mgrid">
            @* ---------- Columna izquierda: quien es, que rol tiene y como se clasifica ---------- *@
            <div class="usr-mcol">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="usr-av-edit">
                        @if (!string.IsNullOrWhiteSpace(_editFotoUrl))
                        {
                            <img class="usr-av usr-av-img" style="width:64px;height:64px;border-radius:15px" src="@_editFotoUrl" alt="@_editUser.NombreCompleto" />
                        }
                        else
                        {
                            <div class="usr-av" style="width:64px;height:64px;border-radius:15px;font-size:21px">@Iniciales(_editUser.NombreCompleto)</div>
                        }
                        <label class="usr-av-cam" title="Cambiar foto">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                            <InputFile OnChange="SubirFoto" accept="image/png,image/jpeg,image/webp" style="display:none" />
                        </label>
                    </div>
                    <div>
                        <div class="usr-name" style="font-size:16px">@_editUser.NombreCompleto</div>
                        <div class="usr-email">@(_editUser.Email ?? "Sin correo") @(_editUser.TieneCuentaPropia ? ". Con cuenta propia" : ". Solo en directorio")</div>
                        @if (_subiendoFoto) { <div class="usr-email" style="color:#1E88E5">Subiendo foto...</div> }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="usr-label">Nombre completo</label>
                    <input class="usr-input" value="@_editUser.NombreCompleto" disabled />
                </div>
                <div class="mb-3">
                    <label class="usr-label">Correo de acceso</label>
                    <input class="usr-input" value="@(_editUser.Email ?? "")" disabled />
                </div>
                <div class="usr-hint mb-3">Nombre y correo se editan en el Directorio (la identidad vive alli).</div>

                <div class="mb-2">
                    <label class="usr-label">Rol</label>
                    <select class="usr-select" @bind="_editRolId">
                        @foreach (var r in _roles.Where(r => r.Activo || r.Id == _editUser.RolId))
                        {
                            <option value="@r.Id">@r.Nombre</option>
                        }
                    </select>
                </div>

                @* ---------- Etiquetas del usuario (catalogo compartido por toda la copropiedad) ---------- *@
                <div class="usr-gob-sec">
                    <div class="usr-gob-sec-t">ETIQUETAS</div>
                    <div class="usr-gob-sec-hint">Clasifica a esta persona (Consejo, Aseo, Mantenimiento...). Las que crees quedan disponibles para todos los usuarios de la copropiedad.</div>

                    <div class="usr-etq-list" style="margin-bottom:10px">
                        @foreach (var et in _editUser.Etiquetas)
                        {
                            var etId = et.Id;
                            <span class="usr-etq-chip" style="background:@ChipBg(et.Color);color:@(et.Color ?? "#6D4FE3");border-color:@(et.Color ?? "#DCD2F8")">
                                @et.Nombre
                                <button class="usr-etq-x" @onclick="() => QuitarEtiquetaDelUsuario(etId)" disabled="@_busy" title="Quitar de este usuario">&times;</button>
                            </span>
                        }
                        @if (_editUser.Etiquetas.Count == 0) { <span class="usr-etq-empty">Este usuario no tiene etiquetas.</span> }
                    </div>

                    @{ var disponibles = _etiquetas.Where(e => _editUser!.Etiquetas.All(a => a.Id != e.Id)).ToList(); }
                    @if (disponibles.Count > 0)
                    {
                        <div class="usr-etq-disp-t">Disponibles - clic para asignar</div>
                        <div class="usr-etq-list" style="margin-bottom:10px">
                            @foreach (var e in disponibles)
                            {
                                var eid = e.Id; var enom = e.Nombre;
                                <span class="usr-etq-off">
                                    <button class="usr-etq-pick2" @onclick="() => AsignarEtiquetaAlUsuario(eid)" disabled="@_busy">
                                        <span class="usr-etq-dot" style="background:@(e.Color ?? "#6D4FE3")"></span>@e.Nombre
                                    </button>
                                    <button class="usr-etq-del" @onclick="() => EliminarEtiquetaDelCatalogo(eid, enom)" disabled="@_busy" title="Eliminar de la copropiedad">&times;</button>
                                </span>
                            }
                        </div>
                    }

                    <div class="usr-etq-form">
                        <input class="usr-etq-in" @bind="_nuevaEtqNombre" @bind:event="oninput" placeholder="Nueva etiqueta (ej. Aseo)" />
                        <input type="color" class="usr-etq-color" @bind="_nuevaEtqColor" title="Color" />
                        <button class="usr-btn-primary usr-etq-add" @onclick="CrearYAsignarEtiqueta" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaEtqNombre))">Crear y asignar</button>
                    </div>
                </div>
            </div>

            @* ---------- Columna derecha: donde participa dentro de la copropiedad ---------- *@
            <div class="usr-mcol">
                @if (_gobUser is not null)
                {
                    <div class="usr-gob-sec">
                        <div class="usr-gob-sec-t">GOBIERNO Y EQUIPO DE TRABAJO</div>
                        <div class="usr-gob-sec-hint">Activa a esta persona en los grupos de gobierno. Un usuario puede estar en varios a la vez.</div>

                        @* Consejo de administracion *@
                        <div class="usr-gob-card @(_gobUser.Consejo is not null ? "on" : "")">
                            <div class="usr-gob-card-h">
                                <span class="usr-gob-card-name">Consejo de administracion</span>
                                @if (_gobUser.Consejo is not null) { <span class="usr-gob-badge">Miembro</span> }
                            </div>
                            @if (_gobUser.Consejo is not null)
                            {
                                <div class="usr-gob-tagrow">
                                    <span class="usr-gob-tag2">@CargoConsejoTxt(_gobUser.Consejo.Cargo)</span>
                                    <button class="usr-gob-quitar" @onclick="QuitarConsejo" disabled="@_busy">Quitar</button>
                                </div>
                            }
                            else
                            {
                                <div class="usr-gob-form">
                                    <select class="usr-gob-in" @bind="_gobCargoConsejo">
                                        @foreach (var c in Enum.GetValues<CargoConsejo>()) { <option value="@c">@CargoConsejoTxt(c)</option> }
                                    </select>
                                    <button class="usr-gob-add" @onclick="AgregarConsejo" disabled="@_busy">+ Agregar</button>
                                </div>
                            }
                        </div>

                        @* Comites *@
                        <div class="usr-gob-card @(_gobUser.Comites.Count > 0 ? "on" : "")">
                            <div class="usr-gob-card-h">
                                <span class="usr-gob-card-name">Comites</span>
                                @if (_gobUser.Comites.Count > 0) { <span class="usr-gob-badge">@_gobUser.Comites.Count</span> }
                            </div>
                            @if (_gobUser.Comites.Count > 0)
                            {
                                <div class="usr-gob-tagrow">
                                    @foreach (var cm in _gobUser.Comites)
                                    {
                                        var mid = cm.MiembroId;
                                        <span class="usr-gob-tag2">@cm.ComiteNombre <button class="usr-gob-x2" @onclick="() => QuitarComite(mid)" disabled="@_busy">&times;</button></span>
                                    }
                                </div>
                            }
                            @if (_comites.Count > 0)
                            {
                                <div class="usr-gob-form">
                                    <select class="usr-gob-in" @bind="_gobComiteId">
                                        <option value="@Guid.Empty">Elegir comite...</option>
                                        @foreach (var c in _comites.Where(c => _gobUser.Comites.All(m => m.ComiteId != c.Id)))
                                        {
                                            <option value="@c.Id">@c.Nombre</option>
                                        }
                                    </select>
                                    <button class="usr-gob-add" @onclick="AgregarComite" disabled="@(_busy || _gobComiteId == Guid.Empty)">+ Agregar</button>
                                </div>
                            }
                            else
                            {
                                <div class="usr-gob-note">No hay comites creados. Crealos en el modulo Gobierno.</div>
                            }
                        </div>

                        @* Revisor fiscal *@
                        <div class="usr-gob-card @(_gobUser.Revisor is not null ? "on" : "")">
                            <div class="usr-gob-card-h">
                                <span class="usr-gob-card-name">Revisor fiscal</span>
                                @if (_gobUser.Revisor is not null) { <span class="usr-gob-badge">Activo</span> }
                            </div>
                            @if (_gobUser.Revisor is not null)
                            {
                                <div class="usr-gob-tagrow">
                                    <span class="usr-gob-tag2">Revisor fiscal@(string.IsNullOrWhiteSpace(_gobUser.Revisor.NumeroTarjetaProfesional) ? "" : " - TP " + _gobUser.Revisor.NumeroTarjetaProfesional)</span>
                                    <button class="usr-gob-quitar" @onclick="QuitarRevisor" disabled="@_busy">Quitar</button>
                                </div>
                            }
                            else
                            {
                                <div class="usr-gob-form">
                                    <input class="usr-gob-in" @bind="_gobRevisorTp" placeholder="Tarjeta profesional (opcional)" />
                                    <button class="usr-gob-add" @onclick="DesignarRevisor" disabled="@_busy">+ Designar</button>
                                </div>
                            }
                        </div>

                        @* Equipo de trabajo *@
                        <div class="usr-gob-card @(_gobUser.Equipo is not null ? "on" : "")">
                            <div class="usr-gob-card-h">
                                <span class="usr-gob-card-name">Equipo de trabajo</span>
                                @if (_gobUser.Equipo is not null) { <span class="usr-gob-badge">Miembro</span> }
                            </div>
                            @if (_gobUser.Equipo is not null)
                            {
                                <div class="usr-gob-tagrow">
                                    <span class="usr-gob-tag2">@(string.IsNullOrWhiteSpace(_gobUser.Equipo.RolPersonalizado) ? RolEquipoTxt(_gobUser.Equipo.Rol) : _gobUser.Equipo.RolPersonalizado)</span>
                                    <button class="usr-gob-quitar" @onclick="QuitarEquipo" disabled="@_busy">Quitar</button>
                                </div>
                            }
                            else
                            {
                                <div class="usr-gob-form">
                                    <select class="usr-gob-in" @bind="_gobEquipoRol">
                                        @foreach (var rr in Enum.GetValues<RolEquipo>()) { <option value="@rr">@RolEquipoTxt(rr)</option> }
                                    </select>
                                    <select class="usr-gob-in" @bind="_gobEquipoTipo">
                                        <option value="@TipoVinculacion.Interno">Interno</option>
                                        <option value="@TipoVinculacion.Externo">Externo</option>
                                    </select>
                                    <button class="usr-gob-add" @onclick="AgregarEquipo" disabled="@_busy">+ Agregar</button>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_tablerosUser is not null)
                {
                    var misTableros = _tablerosUser.Where(t => t.Usuarios.Any(x => x.PersonaId == _editUser.PersonaId)).ToList();
                    var otrosTableros = _tablerosUser.Where(t => t.Usuarios.All(x => x.PersonaId != _editUser.PersonaId)).ToList();
                    <div class="usr-gob-sec">
                        <div class="usr-gob-sec-t">TABLEROS DE TRABAJO</div>
                        <div class="usr-gob-sec-hint">Tableros de tareas (2.10) en los que participa esta persona.</div>
                        @if (misTableros.Count > 0)
                        {
                            <div class="usr-gob-tagrow" style="margin-top:0">
                                @foreach (var t in misTableros)
                                {
                                    var tid = t.Id;
                                    <span class="usr-tab-chip">
                                        <span class="usr-tab-dot" style="background:@t.Color"></span>
                                        <a class="usr-tab-link" href="/tareas" title="Abrir Tareas">@t.Nombre</a>
                                        <span class="usr-tab-n">@t.NCards</span>
                                        <button class="usr-gob-x2" @onclick="() => QuitarTablero(tid)" disabled="@_busy" title="Quitar del tablero">&times;</button>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="usr-gob-note" style="margin-top:0">Esta persona no participa en ningun tablero.</div>
                        }
                        @if (otrosTableros.Count > 0)
                        {
                            <div class="usr-gob-form">
                                <select class="usr-gob-in" @bind="_tableroSel">
                                    <option value="@Guid.Empty">Agregar a un tablero...</option>
                                    @foreach (var t in otrosTableros)
                                    {
                                        <option value="@t.Id">@t.Nombre</option>
                                    }
                                </select>
                                <button class="usr-gob-add" @onclick="AgregarTablero" disabled="@(_busy || _tableroSel == Guid.Empty)">+ Agregar</button>
                            </div>
                        }
                    </div>
                }

                <div class="usr-dir-box @(_editUser.EnDirectorio ? "on" : "")">
                    <div class="usr-dir-ico">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <div class="flex-grow-1">
                        <div style="font-size:13px;font-weight:700;color:#33475B">Directorio de terceros</div>
                        @if (_editUser.EnDirectorio)
                        {
                            <div style="font-size:12px;color:#0F8A4F">Registrado en el Directorio de la copropiedad.</div>
                            @if (_perfilIncompletoAviso)
                            {
                                <div style="font-size:12px;color:#B45309">Perfil incompleto: <a href="/directorio">completar datos en el Directorio</a>.</div>
                            }
                        }
                        else
                        {
                            <div style="font-size:12px;color:#A6B7C8;line-height:1.4">Aun no aparece en el Directorio. Registralo para gestionarlo como tercero (datos, vinculos, etiquetas).</div>
                        }
                    </div>
                    @if (!_editUser.EnDirectorio)
                    {
                        <button class="usr-gob-add" @onclick="RegistrarDirectorioModal" disabled="@_busy">Registrar</button>
                    }
                </div>

                <div class="usr-security">
                    <div class="usr-sec-label">ZONA DE ACCESO</div>
                    <div class="d-flex align-items-center gap-3 usr-sec-box">
                        <div class="usr-sec-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>
                        <div class="flex-grow-1">
                            <div style="font-size:13px;font-weight:700;color:#33475B">Revocar acceso</div>
                            <div style="font-size:12px;color:#A6B7C8;line-height:1.4">Invalida la sesion y bloquea el ingreso a la copropiedad. Se puede reactivar luego.</div>
                        </div>
                        <button class="usr-rowbtn usr-rowbtn-danger" @onclick="() => RevocarAccesoAsync(_editUser!.UsuarioTenantId)">Revocar</button>
                    </div>
                </div>
            </div>
            </div>
            </div>
            <div class="usr-modal-foot">
                <button class="usr-btn-ghost" @onclick="CerrarEditar">Cancelar</button>
                <button class="usr-btn-primary" @onclick="GuardarEditar" disabled="@_busy">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"></path></svg>
                    Guardar cambios
                </button>
            </div>
        </div>
    </div>
}

@* ============================================================ *@
@* MODAL: Roles y permisos                                      *@
@* ============================================================ *@
@if (_showRoles)
{
    <div class="usr-modal-bg" @onclick="CerrarRoles">
        <div class="usr-modal usr-modal-wide" @onclick:stopPropagation="true">
            <div class="usr-modal-head">
                @if (_rolEditando is not null)
                {
                    <button class="usr-modal-x" @onclick="VolverARoles">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
                    </button>
                }
                else
                {
                    <div class="usr-modal-ico">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z"></path><path d="M9 12l2 2 4-4"></path></svg>
                    </div>
                }
                <div class="flex-grow-1">
                    @if (_rolEditando is not null && _detalleEdit is not null)
                    {
                        <div class="usr-modal-title">Editando: @_detalleEdit.Nombre</div>
                        <div class="usr-modal-subtitle">Matriz de permisos por modulo y accion</div>
                    }
                    else
                    {
                        <div class="usr-modal-title">Roles y permisos</div>
                        <div class="usr-modal-subtitle">Configura que puede ver y hacer cada rol</div>
                    }
                </div>
                <button class="usr-modal-x" @onclick="CerrarRoles">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="usr-modal-body">
                @if (_roles is null)
                {
                    <div class="text-center py-5"><div class="spinner-border" style="color:#6D4FE3"></div></div>
                }
                else if (_rolEditando is not null)
                {
                    @if (_detalleEdit is null)
                    {
                        <div class="text-center py-5"><div class="spinner-border" style="color:#6D4FE3"></div></div>
                    }
                    else
                    {
                        <div class="usr-rolcfg">
                            <div class="usr-rolcfg-row">
                                <div style="flex:1;min-width:0">
                                    <label class="usr-label">Nombre del rol</label>
                                    <input class="usr-input" @bind="_edNombre" disabled="@(_detalleEdit.Tipo == TipoRol.Base)" />
                                    @if (_detalleEdit.Tipo == TipoRol.Base) { <div class="usr-hint">Los roles base no se renombran (RN-03).</div> }
                                </div>
                                <button class="usr-rowbtn" style="align-self:flex-end" @onclick="GuardarConfigRol" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar")</button>
                            </div>
                            @if (_detalleEdit.Tipo == TipoRol.Personalizado)
                            {
                                <div class="usr-rolcfg-seed">
                                    <label class="usr-label">Semilla en la Distribucion . al asignar una persona a estas facetas se crea su usuario con este rol</label>
                                    <div class="usr-facetas">
                                        @foreach (var f in _facetasCat)
                                        {
                                            var fv = f.Val; var on = _edFacetas.Contains(fv);
                                            <button type="button" class="usr-faceta @(on ? "on" : "")" @onclick="() => ToggleFaceta(fv)">@f.Label</button>
                                        }
                                    </div>
                                    <label class="usr-seedchk">
                                        <input type="checkbox" @bind="_edSoloDir" />
                                        <span>Ocultar y permitir solo en Directorio <em>(no aparecen en la lista de Usuarios)</em></span>
                                    </label>
                                    <div class="usr-hint">Recuerda pulsar <b>Guardar</b> para aplicar la siembra (crea/actualiza los usuarios existentes de esas facetas).</div>
                                </div>
                            }
                        </div>

                        <div class="usr-matrix">
                            <div class="usr-matrix-head">
                                <div style="flex:1;font-size:11px;letter-spacing:.4px;font-weight:700;color:#A6B7C8">MODULO</div>
                                @foreach (var a in Enum.GetValues<AccionPermiso>())
                                {
                                    <div class="usr-matrix-col">@a.ToString().ToUpper()</div>
                                }
                                <div style="width:140px;flex-shrink:0;text-align:center;font-size:11px;letter-spacing:.3px;font-weight:700;color:#A6B7C8">NIVEL DE DATO</div>
                            </div>
                            @foreach (var mod in ModulosVisibles)
                            {
                                var modCodigo = mod;
                                var nivelActual = _detalleEdit.Permisos.Where(p => p.ModuloCodigo == mod).Select(p => p.NivelDato).DefaultIfEmpty(NivelDato.SinAcceso).Max();
                                <div class="usr-matrix-row">
                                    <div class="usr-matrix-mod">@LabelModulo(mod)</div>
                                    @foreach (var accion in Enum.GetValues<AccionPermiso>())
                                    {
                                        var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == mod && p.Accion == accion);
                                        var hab = celda?.Habilitado ?? false;
                                        var modC = mod; var accC = accion;
                                        <div class="usr-cell">
                                            <button class="usr-chk @(hab ? "on" : "")" @onclick="() => TogglePermiso(modC, accC, !hab)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5 9-11"></path></svg>
                                            </button>
                                        </div>
                                    }
                                    <div style="width:140px;flex-shrink:0;display:flex;justify-content:center">
                                        <select class="usr-select" style="font-size:12px;padding:5px 8px" @onchange="(e) => CambiarNivel(modCodigo, Enum.Parse<NivelDato>(e.Value!.ToString()!))">
                                            <option value="@NivelDato.SinAcceso" selected="@(nivelActual == NivelDato.SinAcceso)">Sin acceso</option>
                                            <option value="@NivelDato.Propio" selected="@(nivelActual == NivelDato.Propio)">Solo propio</option>
                                            <option value="@NivelDato.Copropiedad" selected="@(nivelActual == NivelDato.Copropiedad)">Toda la PH</option>
                                        </select>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="usr-hint mt-3">Los cambios se guardan al instante. La regla "Administrador conserva acceso a Usuarios y Accesos" se aplica automaticamente.</div>
                    }
                }
                else
                {
                    @* ---- Lista de roles ---- *@
                    <div class="usr-sec-label">ROLES BASE . no eliminables</div>
                    <div class="d-flex flex-column gap-2 mb-4">
                        @foreach (var r in _roles.Where(r => r.Tipo == TipoRol.Base))
                        {
                            var rr = r;
                            <div class="usr-rolecard">
                                <span class="usr-dot" style="background:#1A8754;flex-shrink:0"></span>
                                <div class="flex-grow-1">
                                    <div style="font-size:13.5px;font-weight:700;color:#33475B">@r.Nombre</div>
                                    <div class="usr-email">@(r.Descripcion ?? "Rol base del sistema")</div>
                                </div>
                                <span class="usr-count">@r.CantidadUsuariosActivos usuarios</span>
                                <button class="usr-rowbtn" @onclick="() => EditarRol(rr.Id)">Editar</button>
                            </div>
                        }
                    </div>

                    <div class="usr-sec-label">ROLES EXTENDIDOS . activables</div>
                    <div class="usr-ext-grid mb-3">
                        @foreach (var r in _roles.Where(r => r.Tipo == TipoRol.Extendido))
                        {
                            var rr = r;
                            <div class="usr-rolecard @(r.Activo ? "" : "usr-rolecard-off")">
                                <span class="usr-dot" style="background:@(r.Activo ? "#1A8754" : "#C3D0DD");flex-shrink:0"></span>
                                <div class="flex-grow-1 min-w-0">
                                    <div style="font-size:13px;font-weight:700;color:#33475B">@r.Nombre</div>
                                    <div class="usr-email">@(r.Activo ? $"Activo . {r.CantidadUsuariosActivos} usuarios" : "Inactivo")</div>
                                </div>
                                <div class="d-flex gap-1 flex-shrink-0">
                                    <button class="usr-link-btn" @onclick="() => ToggleExtendido(rr.Id)">@(r.Activo ? "Desactivar" : "Activar")</button>
                                    <button class="usr-link-btn" @onclick="() => EditarRol(rr.Id)">Editar</button>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_roles.Any(r => r.Tipo == TipoRol.Personalizado))
                    {
                        <div class="usr-sec-label">ROLES PERSONALIZADOS</div>
                        <div class="usr-ext-grid mb-3">
                            @foreach (var r in _roles.Where(r => r.Tipo == TipoRol.Personalizado))
                            {
                                var rr = r;
                                <div class="usr-rolecard">
                                    <span class="usr-dot" style="background:#6D4FE3;flex-shrink:0"></span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div style="font-size:13px;font-weight:700;color:#33475B">@r.Nombre</div>
                                        <div class="usr-email">@r.CantidadUsuariosActivos usuarios</div>
                                    </div>
                                    <div class="d-flex gap-1 flex-shrink-0">
                                        <button class="usr-link-btn" @onclick="() => EditarRol(rr.Id)">Editar</button>
                                        <button class="usr-link-btn text-danger" @onclick="() => EliminarRol(rr.Id)">Quitar</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (_creandoRol)
                    {
                        <div class="usr-newrole">
                            <label class="usr-label">Nombre del rol personalizado</label>
                            <input class="usr-input mb-2" placeholder="Ej. Coordinador de zonas" @bind="_nuevoNombre" />
                            <label class="usr-label">Copiar permisos de</label>
                            <select class="usr-select mb-2" @bind="_copiarDe">
                                <option value="">(Empezar vacio)</option>
                                @foreach (var r in _roles.Where(r => r.Tipo != TipoRol.Sistema))
                                {
                                    <option value="@r.Id">@r.Nombre</option>
                                }
                            </select>
                            <div class="d-flex gap-2">
                                <button class="usr-btn-ghost" @onclick="() => _creandoRol = false">Cancelar</button>
                                <button class="usr-btn-primary" @onclick="CrearRol" disabled="@_busy">Crear rol</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="usr-newrole-btn" @onclick="() => _creandoRol = true">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"></path></svg>
                            Crear rol personalizado
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

<style>
    .usr-wrap { width:100%; max-width:1900px; margin:0 auto; padding:6px 28px 60px; box-sizing:border-box; }
    .usr-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:20px; flex-wrap:wrap; }
    .usr-title { font-size:27px; font-weight:800; letter-spacing:-.6px; color:#1B2A3A; margin:0; }
    .usr-sub { font-size:14px; color:#7C98B6; margin-top:4px; margin-bottom:0; }

    .usr-btn-primary { display:inline-flex; align-items:center; gap:7px; padding:10px 16px; border-radius:10px; background:#6D4FE3; color:#fff; font-size:13px; font-weight:700; border:none; box-shadow:0 6px 16px rgba(109,79,227,.3); cursor:pointer; }
    .usr-btn-primary:hover { background:#5838C9; }
    .usr-btn-primary:disabled { opacity:.55; cursor:default; box-shadow:none; }
    .usr-btn-ghost { display:inline-flex; align-items:center; gap:7px; padding:10px 15px; border-radius:10px; border:1px solid #E1E8EE; background:#fff; font-size:13px; font-weight:600; color:#516F90; cursor:pointer; }
    .usr-btn-ghost:hover { border-color:#C3D0DD; color:#33475B; }

    .usr-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:18px; }
    .usr-stat { background:#fff; border:1px solid #E1E8EE; border-radius:14px; padding:18px; box-shadow:0 1px 2px rgba(45,62,80,.05); cursor:pointer; transition:border-color .15s, box-shadow .15s; }
    .usr-stat:hover { border-color:#C3D0DD; }
    .usr-stat.active { border-color:#6D4FE3; box-shadow:0 0 0 1px #6D4FE3; }
    .usr-stat-label { display:flex; align-items:center; gap:7px; font-size:12px; font-weight:700; color:#7C98B6; }
    .usr-dot { width:8px; height:8px; border-radius:50%; display:inline-block; }
    .usr-stat-num { font-size:30px; font-weight:800; color:#1B2A3A; letter-spacing:-1px; margin-top:5px; }

    .usr-tabs { display:flex; align-items:center; gap:8px; border-bottom:1px solid #E1E8EE; }
