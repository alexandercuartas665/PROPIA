@page "/zonas-comunes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals

<PageTitle>Zonas comunes - PROPIA</PageTitle>

@* Zonas comunes: modulo propio (antes era una seccion del acordeon de Mi copropiedad).
   Mismo contenido que tenia alli - resumen, tarjetas/lista y alta rapida - pero sin
   acordeon y sin numeral. El detalle vive en FichaZonaModal; el alta masiva en
   GestionarZonasModal.

   El CSS va con prefijo zc-* y propio: las clases mc-* solo existen mientras se renderiza
   MiCopropiedad, asi que en esta pagina no estarian disponibles. *@

<div class="mod-pagehead">
    <div>
        <h1 class="mod-pagetitle">Zonas Comunes</h1>
        <p class="mod-pagesub">Salones, zonas deportivas, parques y demas areas de uso comun de la copropiedad.</p>
    </div>
    @if (_authChecked && _jwt is not null)
    {
        <div class="zc-plantilla">
            <button type="button" class="zc-btn-ghost" @onclick="DescargarPlantillaAsync" disabled="@_impBusy" title="Descargar plantilla Excel">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
                Descargar plantilla
            </button>
            <label class="propia-btn-brand @(_impBusy ? "is-busy" : "")" style="cursor:pointer;" title="Cargar plantilla Excel (crea o actualiza)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V9m0 0l-4 4m4-4l4 4M4 3h16"/></svg>
                @(_impBusy ? "Cargando..." : "Cargar plantilla")
                <InputFile OnChange="OnPlantillaImport" accept=".xlsx" style="display:none" disabled="@_impBusy" />
            </label>
        </div>
    }
</div>

@if (_impResult is not null)
{
    <div class="zc-impres">
        <b>Carga completa:</b> @_impResult.Creados creadas, @_impResult.Actualizados actualizadas, @_impResult.CamposCargados campos.
        @if (_impResult.FilasConError > 0)
        {
            <span class="zc-impres-err"> · @_impResult.FilasConError con error</span>
            <ul class="zc-impres-list">@foreach (var er in _impResult.Errores.Take(10)) { <li>Fila @er.Fila: @er.Mensaje</li> }</ul>
        }
    </div>
}

@if (!_authChecked)
{
    <div class="zc-loading"><div class="spinner-border" style="color: var(--propia-brand, #6D4FE3);"></div></div>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    @* Header homogeneo (mismo patron que Unidades Privadas): mini-KPIs arriba, barra de
       filtros abajo. Las clases mod-* son globales (propia-tokens.css). *@
    <div class="mod-stats">
        <div class="mod-stat">
            <div class="mod-stat-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V8h14v13M9 12h.01M15 12h.01"/></svg></div>
            <div><div class="mod-stat-n">@_zonas.Count</div><div class="mod-stat-l">zonas comunes</div></div>
        </div>
        <div class="mod-stat mod-stat--ok">
            <div class="mod-stat-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5 9-11"/></svg></div>
            <div><div class="mod-stat-n">@_zonas.Count(z => z.Estado == EstadoZonaComunMantenimiento.Activa)</div><div class="mod-stat-l">activas</div></div>
        </div>
        <div class="mod-stat mod-stat--warn">
            <div class="mod-stat-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a5 5 0 0 0-6.3 6.3l-6 6 1.9 1.9 6-6a5 5 0 0 0 6.3-6.3l-3 3-2.6-2.6z"/></svg></div>
            <div><div class="mod-stat-n">@_zonas.Count(z => z.Estado == EstadoZonaComunMantenimiento.EnMantenimiento)</div><div class="mod-stat-l">en mantenimiento</div></div>
        </div>
        <div class="mod-stat">
            <div class="mod-stat-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
            <div><div class="mod-stat-n">@_zonas.Count(z => z.EsReservable)</div><div class="mod-stat-l">reservables</div></div>
        </div>
    </div>

    @* Sin value= en el buscador: Blazor Server se come pulsaciones al reafirmarlo en cada re-render. *@
    <div class="mod-filtros">
        @* Boton "Filtros" PRIMERO y luego el buscador (orden estandar de los modulos). *@
        <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="StateHasChanged" />
        <div class="mod-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="mod-search-inp" placeholder="Buscar zona..."
                   @oninput="@(e => _q = e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="zc-viewtoggle" style="margin-left:auto;">
            <button type="button" class="zc-vt @(_view == "cards" ? "on" : "")" @onclick='() => SetVista("cards")' title="Tarjetas">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Tarjetas
            </button>
            <button type="button" class="zc-vt @(_view == "list" ? "on" : "")" @onclick='() => SetVista("list")' title="Lista">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                Lista
            </button>
        </div>
    </div>

    @if (_view == "cards")
    {
        <div class="zc-cards">
            @foreach (var z in Filtradas())
            {
                var zona = z;
                <button type="button" class="zc-card" @onclick="() => AbrirFichaZonaAsync(zona)" title="Abrir ficha de la zona">
                    <div class="zc-card-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V8h14v13M9 12h.01M15 12h.01"/></svg></div>
                    <div class="zc-card-id">
                        <div class="zc-card-nom">@z.Nombre</div>
                        <div class="zc-card-meta">@z.Categoria@(z.CapacidadPersonas.HasValue ? $" · Aforo {z.CapacidadPersonas}" : "") · @(z.EsReservable ? "Reservable" : "No reservable")</div>
                    </div>
                    @if (z.Estado == EstadoZonaComunMantenimiento.EnMantenimiento) { <span class="zc-card-mant">Mant.</span> }
                    <span class="zc-card-del" role="button" @onclick:stopPropagation="true" @onclick="() => EliminarZonaAsync(zona.Id, zona.Nombre)" title="Eliminar zona">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                    </span>
                    <svg class="zc-card-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
                </button>
            }

            @* Compositor progresivo: la tarjeta crece a medida que se agregan datos. *@
            @if (_composerOpen)
            {
                <div class="zc-composer">
                    @* SIN value=: en Blazor Server se reafirma en cada re-render y se come
                       pulsaciones mientras el round-trip esta en vuelo. El ojito crea la zona y
                       abre su ficha de una vez (mismo patron pedido en Directorio). *@
                    @* Expander estilo Airtable DENTRO del textbox: crece cuando empiezas a escribir
                       y al hacer click crea la zona y abre su ficha para terminar el registro alli. *@
                    <div class="zc-inp-wrap @(string.IsNullOrWhiteSpace(_draft.Nombre) ? "" : "zc-inp-wrap--con-texto")">
                        <input class="zc-composer-inp zc-inp--exp" placeholder="Nombre de la zona..." autofocus
                               @oninput="@(e => { _draft.Nombre = e.Value?.ToString() ?? string.Empty; Reveal(0); })"
                               @onkeydown="Keydown" />
                        <button type="button" class="zc-nf-exp" tabindex="-1" title="Crear y abrir la ficha completa"
                                @onclick="CrearYAbrirFichaAsync" disabled="@_busy">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @if (_reveal >= 1)
                    {
                        <select class="zc-composer-sel" @bind="_draft.Categoria" @onfocus="@(() => Reveal(1))">
                            @foreach (var c in Enum.GetValues<CategoriaZonaComun>()) { <option value="@c">@c</option> }
                        </select>
                    }
                    @if (_reveal >= 2)
                    {
                        <select class="zc-composer-sel" @onfocus="@(() => Reveal(2))"
                                @onchange="@(e => _draft.EsReservable = e.Value?.ToString() == "true")">
                            <option value="false" selected="@(!_draft.EsReservable)">No reservable</option>
                            <option value="true" selected="@_draft.EsReservable">Reservable</option>
                        </select>
                    }
                    @if (_reveal >= 3)
                    {
                        <input type="number" min="0" class="zc-composer-sel" placeholder="Aforo (personas)"
                               @bind="_draft.Aforo" @onfocus="@(() => Reveal(3))" />
                    }
                    <div class="zc-composer-foot">
                        <button type="button" class="zc-composer-cancel" @onclick="CancelarComposer">Cancelar</button>
                        <button type="button" class="zc-composer-ok" @onclick="CrearDesdeDraftAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft.Nombre))">@(_busy ? "Creando..." : "Crear")</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="zc-add-card" @onclick="AbrirComposer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                    Agregar zona comun
                </button>
            }
        </div>
    }
    else
    {
        <div class="zc-list">
            <div class="zc-list-head zc-grid">
                <div>NOMBRE</div><div>CATEGORIA</div><div>RESERVA</div><div>AFORO</div><div>ESTADO</div><div></div>
            </div>
            @foreach (var z in Filtradas())
            {
                var zona = z;
                <div class="zc-list-row zc-grid">
                    <button type="button" class="zc-list-link" @onclick="() => AbrirFichaZonaAsync(zona)" title="Abrir ficha">@z.Nombre</button>
                    <div class="zc-list-c">@z.Categoria</div>
                    <div class="zc-list-c">@(z.EsReservable ? "Si" : "No")</div>
                    <div class="zc-list-c">@(z.CapacidadPersonas?.ToString() ?? "-")</div>
                    <div class="zc-list-c"><span class="zc-list-badge">@z.Estado</span></div>
                    <div class="zc-list-act">
                        <button type="button" class="zc-row-del" @onclick="() => EliminarZonaAsync(zona.Id, zona.Nombre)" title="Eliminar">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                        </button>
                    </div>
                </div>
            }
            @* Alta inline. @@key limpia la fila al crear; @@oninput SIN value= evita perder pulsaciones. *@
            <div class="zc-list-newrow zc-grid" @key="_nonce">
                @* Expander estilo Airtable DENTRO del textbox: crece al escribir; click crea y abre la ficha. *@
                <div class="zc-inp-wrap @(string.IsNullOrWhiteSpace(_draft.Nombre) ? "" : "zc-inp-wrap--con-texto")">
                    <input class="zc-row-inp zc-inp--exp" @ref="_nombreRef" placeholder="Nueva zona comun..."
                           @oninput="@(e => _draft.Nombre = e.Value?.ToString() ?? string.Empty)" @onkeydown="Keydown" />
                    <button type="button" class="zc-nf-exp" tabindex="-1" title="Crear y abrir la ficha completa"
                            @onclick="CrearYAbrirFichaAsync" disabled="@_busy">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                </div>
                <select class="zc-row-inp" @bind="_draft.Categoria">
                    @foreach (var c in Enum.GetValues<CategoriaZonaComun>()) { <option value="@c">@c</option> }
                </select>
                <select class="zc-row-inp" @onchange="@(e => _draft.EsReservable = e.Value?.ToString() == "true")">
                    <option value="false" selected="@(!_draft.EsReservable)">No</option>
                    <option value="true" selected="@_draft.EsReservable">Si</option>
                </select>
                <input type="number" min="0" class="zc-row-inp" placeholder="-" @bind="_draft.Aforo" />
                <div class="zc-list-c">Activa</div>
                <div class="zc-list-act">
                    <button type="button" class="zc-row-add" @onclick="CrearDesdeDraftAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft.Nombre))">+ Agregar</button>
                </div>
            </div>
        </div>
    }

    @if (!Filtradas().Any())
    {
        <div class="zc-empty">
            @(HayFiltros ? "Ninguna zona coincide con el filtro." : "Aun no hay zonas comunes registradas.")
        </div>
    }

    @if (!string.IsNullOrEmpty(_msg)) { <div class="zc-msg @(_msgOk ? "ok" : "bad")">@_msg</div> }
}

@* ModalHost debe declararse en CADA pagina: IModalService es scoped por circuito y
   MainLayout es otra frontera de render (ver comentario en MainLayout.razor). *@
<ModalHost />

@code {
    private List<ZonaComunDto> _zonas = new();
    private string? _jwt;
    private bool _authChecked;
    private string? _loadError;

    private string _view = "cards";
    private const string VistaKey = "propia_view_zonas";
    private bool _composerOpen;
    private int _reveal;
    private bool _busy;
    private bool _impBusy;
    private ImportarPlantillaResultado? _impResult;
    private readonly ZonaDraft _draft = new();
    private int _nonce;
    private bool _focusPending;
    private ElementReference _nombreRef;

    private string _msg = "";
    private bool _msgOk = true;

    // Filtros (client-side: la lista de zonas de una copropiedad es corta).
    // Un solo boton "Filtros" con reglas dinamicas (componente compartido FiltroDinamico).
    private string _q = "";
    private FiltroDinamico? _fd;

    private bool HayFiltros => !string.IsNullOrWhiteSpace(_q) || (_fd?.Hay ?? false);

    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "nombre", Label = "Nombre", Kind = "texto" },
        new() { Key = "categoria", Label = "Categoria", Kind = "sel",
                Opciones = Enum.GetValues<CategoriaZonaComun>().Select(c => (c.ToString(), c.ToString())).ToList() },
        new() { Key = "estado", Label = "Estado", Kind = "sel",
                Opciones = Enum.GetValues<EstadoZonaComunMantenimiento>().Select(s => (s.ToString(), s.ToString())).ToList() },
        new() { Key = "reservable", Label = "Reservable", Kind = "sel",
                Opciones = new() { ("si", "Si"), ("no", "No") } },
        new() { Key = "aforo", Label = "Aforo", Kind = "num" },
    };

    private IEnumerable<ZonaComunDto> Filtradas()
    {
        var q = _q.Trim();
        return _zonas
            .Where(z => q == "" || z.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Where(z => _fd?.Pasa(campo => campo switch
            {
                "nombre" => z.Nombre,
                "categoria" => z.Categoria.ToString(),
                "estado" => z.Estado.ToString(),
                "reservable" => z.EsReservable ? "si" : "no",
                "aforo" => z.CapacidadPersonas?.ToString() ?? "",
                _ => ""
            }) ?? true)
            .OrderBy(z => z.Categoria).ThenBy(z => z.Nombre);
    }

    private sealed class ZonaDraft
    {
        public string Nombre = "";
        public CategoriaZonaComun Categoria = CategoriaZonaComun.Social;
        public bool EsReservable;
        public int? Aforo;
        public void Reset() { Nombre = ""; Categoria = CategoriaZonaComun.Social; EsReservable = false; Aforo = null; }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    // La vista (Tarjetas/Lista) se recuerda por modulo en localStorage: sobrevive al cierre
    // de sesion (el logout solo borra llaves puntuales, no hace localStorage.clear()).
    private async Task SetVista(string v)
    {
        _view = v;
        try { await Js.InvokeVoidAsync("localStorage.setItem", VistaKey, v); } catch { }
    }

    private async Task RestaurarVistaAsync()
    {
        try
        {
            var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey);
            if (v == "cards" || v == "list") _view = v;
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jwt is null)
        {
            // Mismo arranque que las demas paginas de Capa 2: el JWT vive en sessionStorage
            // y solo es legible tras el primer render (no existe en prerender).
            try
            {
                var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
                _authChecked = true;
                if (string.IsNullOrWhiteSpace(stored))
                {
                    Nav.NavigateTo("/login?returnUrl=%2Fzonas-comunes", true);
                    return;
                }
                _jwt = stored;
                await RestaurarVistaAsync();
                await CargarAsync();
                StateHasChanged();
            }
            catch { /* prerender */ }
            return;
        }
        if (_focusPending)
        {
            _focusPending = false;
            try { await _nombreRef.FocusAsync(); } catch { }
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/zonas");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (nuevoJwt is null) return;
                _jwt = nuevoJwt;
                resp = await Auth().GetAsync("/api/mi-copropiedad/zonas");
            }
            resp.EnsureSuccessStatusCode();
            _zonas = await resp.Content.ReadFromJsonAsync<List<ZonaComunDto>>() ?? new();
            _loadError = null;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    // ---- Plantilla Excel (descargar / cargar con upsert + campos dinamicos) ----
    private async Task DescargarPlantillaAsync()
    {
        _impBusy = true;
        try
        {
            var bytes = await Auth().GetByteArrayAsync("/api/mi-copropiedad/zonas/plantilla");
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", "plantilla-zonas-propia.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Msg("No se pudo descargar la plantilla: " + ex.Message, false); }
        finally { _impBusy = false; }
    }

    private async Task OnPlantillaImport(InputFileChangeEventArgs e)
    {
        if (e.File is null) return;
        _impBusy = true; _impResult = null; StateHasChanged();
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StreamContent(e.File.OpenReadStream(10 * 1024 * 1024)), "file", e.File.Name);
            var resp = await Auth().PostAsync("/api/mi-copropiedad/zonas/importar", content);
            if (resp.IsSuccessStatusCode)
            {
                _impResult = await resp.Content.ReadFromJsonAsync<ImportarPlantillaResultado>();
                await CargarAsync();
                Msg("Plantilla cargada.", true);
            }
            else Msg("Error al cargar: " + await resp.Content.ReadAsStringAsync(), false);
        }
        catch (Exception ex) { Msg("Error al cargar: " + ex.Message, false); }
        finally { _impBusy = false; StateHasChanged(); }
    }

    private async Task AbrirGestionarZonasAsync()
    {
        var parameters = new ModalParameters().Set("Jwt", _jwt);
        var options = new ModalOptions { Width = "640px", Height = "540px" };
        var creada = await Modals.OpenAsync<GestionarZonasModal, ZonaComunDto?>(parameters, options);
        if (creada is not null)
        {
            await CargarAsync();
            // Tras crear la zona se abre su ficha para completar imagen, horarios, etc.
            await AbrirFichaZonaAsync(creada);
        }
    }

    private async Task AbrirFichaZonaAsync(ZonaComunDto zona, bool abrirEnEdicion = false)
    {
        var parameters = new ModalParameters().Set("Jwt", _jwt).Set("Zona", zona).Set("AbrirEnEdicion", abrirEnEdicion);
        var options = new ModalOptions { Width = "1280px", Height = "88vh" };
        var hubo = await Modals.OpenAsync<FichaZonaModal, bool>(parameters, options);
        if (hubo == true) { await CargarAsync(); Msg("Ficha de zona actualizada.", true); }
    }

    private void AbrirComposer() { _draft.Reset(); _reveal = 0; _composerOpen = true; }
    private void CancelarComposer() { _composerOpen = false; _draft.Reset(); _reveal = 0; }
    private void Reveal(int idx) { var t = idx + 1; if (t <= 3 && _reveal < t) _reveal = t; }

    private async Task Keydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_draft.Nombre)) await CrearDesdeDraftAsync();
        else if (e.Key == "Escape") CancelarComposer();
    }

    private async Task CrearDesdeDraftAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.Nombre)) return;
        _busy = true;
        try
        {
            var req = new CrearZonaComunRequest(_draft.Nombre.Trim(), _draft.Categoria, null,
                _draft.EsReservable, null, _draft.Aforo, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/zonas", req);
            if (resp.IsSuccessStatusCode)
            {
                _draft.Reset(); _reveal = 0; _composerOpen = false; _nonce++; _focusPending = true;
                await CargarAsync();
                Msg("Zona comun creada. Haz clic en ella para completar la ficha.", true);
            }
            else Msg(await MensajeDeError(resp, "No se pudo crear la zona."), false);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
        _busy = false;
    }

    // El ojito del composer: crea la zona, lee el DTO devuelto y abre su ficha para seguir
    // completando (imagen, horarios, etc.) sin tener que buscarla en la lista.
    private async Task CrearYAbrirFichaAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.Nombre)) return;
        _busy = true;
        ZonaComunDto? creada = null;
        try
        {
            var req = new CrearZonaComunRequest(_draft.Nombre.Trim(), _draft.Categoria, null,
                _draft.EsReservable, null, _draft.Aforo, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/zonas", req);
            if (resp.IsSuccessStatusCode)
            {
                creada = await resp.Content.ReadFromJsonAsync<ZonaComunDto>();
                _draft.Reset(); _reveal = 0; _composerOpen = false; _nonce++;
                await CargarAsync();
            }
            else Msg(await MensajeDeError(resp, "No se pudo crear la zona."), false);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
        _busy = false;
        if (creada is not null) await AbrirFichaZonaAsync(creada, abrirEnEdicion: true);
    }

    private async Task EliminarZonaAsync(Guid id, string nombre)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Eliminar la zona \"{nombre}\"?")) return;
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/zonas/{id}");
        if (resp.IsSuccessStatusCode) { await CargarAsync(); Msg("Zona eliminada.", true); }
        else Msg(await MensajeDeError(resp, "No se pudo eliminar la zona."), false);
    }

    private void Msg(string m, bool ok) { _msg = m; _msgOk = ok; }

    private static async Task<string> MensajeDeError(HttpResponseMessage resp, string porDefecto)
    {
        try
        {
            var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (err is not null && err.TryGetValue("error", out var m) && !string.IsNullOrWhiteSpace(m)) return m;
        }
        catch { }
        return porDefecto;
    }
}

