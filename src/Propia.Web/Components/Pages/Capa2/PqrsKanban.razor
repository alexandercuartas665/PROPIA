    private async Task Archivar(Guid id, bool archivar)
    {
        var resp = await Auth().PutAsync($"/api/pqrsd/{id}/archivar?archivar={(archivar ? "true" : "false")}", null);
        if (resp.IsSuccessStatusCode) { await CargarAsync(); Toast(archivar ? "PQR archivada." : "PQR restaurada.", false); }
        else { Toast("No se pudo archivar.", true); }
    }

