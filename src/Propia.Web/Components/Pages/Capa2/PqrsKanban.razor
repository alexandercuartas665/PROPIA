    .pk-cat { font-size: 10.5px; color: #7C98B6; font-weight: 600; }
    .pk-card-desc { font-size: 12px; color: #516F90; line-height: 1.4; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .pk-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 10.5px; color: #7C98B6; }
    .pk-radicador { display: inline-flex; align-items: center; gap: 4px; min-width: 0; }
    .pk-rsv { color: #DC2626; font-weight: 700; }
    .pk-vence { font-weight: 700; }
    .pk-vence-warn { color: #B45309; }
    .pk-vence-err { color: #DC2626; }
    .pk-card-flags { display: flex; gap: 5px; margin-top: 7px; flex-wrap: wrap; }
