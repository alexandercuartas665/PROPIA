</style>

@code {
    private string? _jwt;
    private bool _authChecked;
    private PqrsdBandejaDto? _bandeja;
    private List<PqrsdEstadoDto> _estados = new();
    private List<PqrsdCampoDto> _campos = new();
    private List<PqrsdCategoriaDto> _categorias = new();

    private string _buscar = "";
    private string _filtroTipo = "";
    private string _filtroCategoria = "";
    private string _filtroUnidad = "";
    private bool _busy;
    private string _msg = "";
    private bool _msgError;
    private bool _verArchivados;

    private string _boardMode = "tablero";
    private string _group = "ninguno";
    private bool _pin;
    private string? _pop;
    private readonly HashSet<string> _colsOcultas = new();
    private readonly HashSet<Guid> _camposOcultos = new();

    private Guid? _draggingId;

    // Compositor
    private Guid? _composerCol;
    private string _compTexto = "";
    private string _compTipo = TipoPqrsd.Peticion.ToString();
    private string _compCategoria = "";

    // Config columnas
    private bool _cfgOpen;
    private string _cfgMsg = "";
    private string _nuevaColNombre = "";
    private string _nuevaColColor = "#6D4FE3";

    private record ColFija(string Key, string Label);
    private readonly ColFija[] _colsFijas = new[]
    {
        new ColFija("radicado", "Radicado"),
        new ColFija("tipo", "Tipo"),
        new ColFija("categoria", "Categoria"),
        new ColFija("estado", "Columna"),
        new ColFija("semaforo", "Semaforo"),
        new ColFija("radicador", "Solicitante"),
        new ColFija("unidad", "Unidad"),
        new ColFija("vence", "Vence"),
    };

    private void SetCategoria(string nombre) { _filtroCategoria = nombre; }
    private void SetUnidad(string numero) { _filtroUnidad = numero; }
    private void TogglePop(string p) { _pop = _pop == p ? null : p; }

    private IEnumerable<PqrsdBandejaItemDto> ItemsFiltrados =>
        (_bandeja?.Items ?? new List<PqrsdBandejaItemDto>())
            .Where(x => string.IsNullOrEmpty(_buscar)
                || x.NumeroRadicado.Contains(_buscar, StringComparison.OrdinalIgnoreCase)
                || x.DescripcionResumen.Contains(_buscar, StringComparison.OrdinalIgnoreCase))
            .Where(x => string.IsNullOrEmpty(_filtroTipo) || x.Tipo == Enum.Parse<TipoPqrsd>(_filtroTipo))
            .Where(x => string.IsNullOrEmpty(_filtroCategoria) || x.CategoriaNombre == _filtroCategoria)
            .Where(x => string.IsNullOrEmpty(_filtroUnidad) || x.UnidadNumero == _filtroUnidad);

    private IEnumerable<IGrouping<string, PqrsdBandejaItemDto>> ItemsAgrupados
    {
        get
        {
            var items = ItemsFiltrados;
            return _group switch
            {
                "estado" => items.GroupBy(x => _estados.FirstOrDefault(e => e.Id == x.EstadoId)?.Nombre ?? "Sin columna"),
                "tipo" => items.GroupBy(x => TipoLabel(x.Tipo)),
                "categoria" => items.GroupBy(x => x.CategoriaNombre),
                "unidad" => items.GroupBy(x => string.IsNullOrEmpty(x.UnidadNumero) ? "Sin unidad" : x.UnidadNumero!),
                _ => items.GroupBy(_ => "")
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt"); _authChecked = true; }
            catch { _jwt = null; }
            await RestaurarPrefsAsync();
            if (!string.IsNullOrEmpty(_jwt)) { await CargarAsync(); }
            StateHasChanged();
        }
    }

    private async Task RestaurarPrefsAsync()
    {
        try
        {
            _boardMode = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_pqrs_view") ?? "tablero";
            _group = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_pqrs_group") ?? "ninguno";
            _pin = (await Js.InvokeAsync<string?>("localStorage.getItem", "propia_pqrs_pin")) == "1";
        }
        catch { }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        if (string.IsNullOrEmpty(_jwt))
        {
            try { _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt"); }
            catch { return; }
        }
        if (string.IsNullOrEmpty(_jwt)) return;
        _busy = true;
        try
        {
            var http = Auth();
            _bandeja = await http.GetFromJsonAsync<PqrsdBandejaDto>($"/api/pqrsd/bandeja?archivados={(_verArchivados ? "true" : "false")}");
            _estados = (await http.GetFromJsonAsync<List<PqrsdEstadoDto>>("/api/pqrsd/estados")) ?? new();
            _campos = (await http.GetFromJsonAsync<List<PqrsdCampoDto>>("/api/pqrsd/campos")) ?? new();
            _categorias = (await http.GetFromJsonAsync<List<PqrsdCategoriaDto>>("/api/pqrsd/categorias")) ?? new();
            if (string.IsNullOrEmpty(_compCategoria)) _compCategoria = _categorias.FirstOrDefault(c => c.Activa)?.Id.ToString() ?? "";
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

    private async Task CambiarTab(bool archivados)
    {
        if (_verArchivados == archivados) return;
        _verArchivados = archivados;
        _pop = null;
        await CargarAsync();
    }

    private async Task SetVista(string v)
    {
        _boardMode = v; _pop = null;
        try { await Js.InvokeVoidAsync("localStorage.setItem", "propia_pqrs_view", v); } catch { }
    }
    private async Task SetGroup(string g)
    {
        _group = g; _pop = null;
        try { await Js.InvokeVoidAsync("localStorage.setItem", "propia_pqrs_group", g); } catch { }
    }
    private async Task TogglePin()
    {
        _pin = !_pin;
        try { await Js.InvokeVoidAsync("localStorage.setItem", "propia_pqrs_pin", _pin ? "1" : "0"); } catch { }
    }
    private void ToggleCol(string key) { if (!_colsOcultas.Remove(key)) _colsOcultas.Add(key); }
    private void ToggleCampoCol(Guid id) { if (!_camposOcultos.Remove(id)) _camposOcultos.Add(id); }

    // ---------- Kanban drag ----------
    private void OnDragStart(Guid id) { _draggingId = id; }
    private void OnDragOver() { }
    private async Task OnDrop(Guid targetCol)
    {
        if (_draggingId is null) return;
        var id = _draggingId.Value; _draggingId = null;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{id}/mover", new MoverExpedienteEstadoRequest(targetCol));
        if (resp.IsSuccessStatusCode) { await CargarAsync(); }
        else { Toast("No se pudo mover: " + await resp.Content.ReadAsStringAsync(), true); }
    }
    private async Task MoverAdyacente(PqrsdBandejaItemDto it, int dir)
    {
        var orden = _estados.OrderBy(e => e.Orden).ToList();
        var idx = orden.FindIndex(e => e.Id == it.EstadoId);
        if (idx < 0) return;
        var j = idx + dir;
        if (j < 0 || j >= orden.Count) return;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{it.Id}/mover", new MoverExpedienteEstadoRequest(orden[j].Id));
        if (resp.IsSuccessStatusCode) { await CargarAsync(); Toast($"Movida a '{orden[j].Nombre}'.", false); }
        else { Toast("No se pudo mover.", true); }
    }

    // ---------- Archivar ----------
    private async Task Archivar(Guid id, bool archivar)
    {
        var resp = await Auth().PutAsync($"/api/pqrsd/{id}/archivar?archivar={(archivar ? "true" : "false")}", null);
        if (resp.IsSuccessStatusCode) { await CargarAsync(); Toast(archivar ? "PQR archivada." : "PQR restaurada.", false); }
        else { Toast("No se pudo archivar.", true); }
    }

    // ---------- Compositor ----------
    private void AbrirComposer(Guid col) { _composerCol = col; _compTexto = ""; }
    private void CerrarComposer() { _composerCol = null; _compTexto = ""; }
    private async Task ComposerKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CerrarComposer();
    }
    private async Task NuevaFilaKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _compTexto.Trim().Length >= 20) await CrearDesdeFila();
    }

    private async Task<Guid?> CrearRapidoAsync()
    {
        if (_compTexto.Trim().Length < 20) { Toast("La descripcion debe tener al menos 20 caracteres.", true); return null; }
        if (!Enum.TryParse<TipoPqrsd>(_compTipo, out var tipo)) tipo = TipoPqrsd.Peticion;
        if (!Guid.TryParse(_compCategoria, out var catId))
        {
            catId = _categorias.FirstOrDefault(c => c.Activa)?.Id ?? Guid.Empty;
            if (catId == Guid.Empty) { Toast("No hay categorias configuradas.", true); return null; }
        }
        var req = new RadicarPqrsdRequest(tipo, catId, _compTexto.Trim(), false, null);
        var resp = await Auth().PostAsJsonAsync("/api/pqrsd", req);
        if (!resp.IsSuccessStatusCode) { Toast("No se pudo crear: " + await resp.Content.ReadAsStringAsync(), true); return null; }
        var creado = await resp.Content.ReadFromJsonAsync<PqrsdExpedienteDetalleDto>();
        return creado?.Id;
    }

    private async Task CrearDesdeComposer(PqrsdEstadoDto col)
    {
        var id = await CrearRapidoAsync();
        if (id is null) return;
        // Colocar en la columna donde se creo (si no es Recibida).
        if (col.SemanticaLegal != EstadoPqrsd.Recibida)
            await Auth().PutAsJsonAsync($"/api/pqrsd/{id}/mover", new MoverExpedienteEstadoRequest(col.Id));
        CerrarComposer();
        await CargarAsync();
        Toast("PQR creada.", false);
    }

    private async Task CrearDesdeFila()
    {
        var id = await CrearRapidoAsync();
        if (id is null) return;
        _compTexto = "";
        await CargarAsync();
        Toast("PQR creada.", false);
    }

    // ---------- Config columnas ----------
    private void AbrirConfigColumnas() { _cfgOpen = true; _cfgMsg = ""; }
    private async Task AgregarColumna()
    {
        var resp = await Auth().PostAsJsonAsync("/api/pqrsd/estados", new CrearEstadoPqrsdRequest(_nuevaColNombre.Trim(), _nuevaColColor));
        if (resp.IsSuccessStatusCode) { _nuevaColNombre = ""; _cfgMsg = ""; await CargarAsync(); }
        else { _cfgMsg = await LeerError(resp); }
    }
    private async Task RenombrarEstado(PqrsdEstadoDto e, ChangeEventArgs ev)
    {
        var nombre = ev.Value?.ToString() ?? e.Nombre;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/estados/{e.Id}", new ActualizarEstadoPqrsdRequest(nombre, e.Color, e.Orden));
        if (resp.IsSuccessStatusCode) { _cfgMsg = ""; await CargarAsync(); } else { _cfgMsg = await LeerError(resp); }
    }
    private async Task CambiarColor(PqrsdEstadoDto e, ChangeEventArgs ev)
    {
        var color = ev.Value?.ToString() ?? e.Color;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/estados/{e.Id}", new ActualizarEstadoPqrsdRequest(e.Nombre, color, e.Orden));
        if (resp.IsSuccessStatusCode) { await CargarAsync(); }
    }
    private async Task ReordenarEstado(Guid id, string dir)
    {
        var resp = await Auth().PutAsync($"/api/pqrsd/estados/{id}/orden?direccion={dir}", null);
        if (resp.IsSuccessStatusCode) await CargarAsync();
    }
    private async Task EliminarEstado(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/pqrsd/estados/{id}");
        if (resp.IsSuccessStatusCode) { _cfgMsg = ""; await CargarAsync(); } else { _cfgMsg = await LeerError(resp); }
    }
    private static async Task<string> LeerError(HttpResponseMessage resp)
    {
        try { var d = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); return d?.GetValueOrDefault("error") ?? "Error."; }
        catch { return "Error."; }
    }

    private void Toast(string text, bool isError) { _msg = text; _msgError = isError; }

    private async Task IrNueva()
    {
        var parameters = new ModalParameters().Set("Jwt", _jwt);
        var options = new ModalOptions { Width = "880px" };
        var radicada = await Modals.OpenAsync<NuevaPqrsdWizardModal, bool>(parameters, options);
        if (radicada == true) { await CargarAsync(); Toast("PQR radicada correctamente.", false); }
    }

    private async Task IrA(Guid id)
    {
        var parameters = new ModalParameters().Set("Jwt", _jwt).Set("ExpedienteId", id);
        var options = new ModalOptions { Fullscreen = true };
        var hubo = await Modals.OpenAsync<GestionarPqrsdModal, bool>(parameters, options);
        if (hubo == true) { await CargarAsync(); Toast("Expediente actualizado.", false); }
    }

