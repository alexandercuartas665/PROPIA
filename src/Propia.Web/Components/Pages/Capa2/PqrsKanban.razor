    private async Task CambiarATabFormulario()
    {
        _cfgTab = "formulario"; _formGuardado = false;
        if (!_formCargado)
        {
            try
            {
                var cfg = await Auth().GetFromJsonAsync<PqrsdFormularioPublicoConfigDto>("/api/pqrsd/formulario-config");
                if (cfg is not null)
                {
                    _formTorre = cfg.MostrarTorre; _formCorreo = cfg.MostrarCorreo; _formTelefono = cfg.MostrarTelefono;
                    _formEncabezado = cfg.EncabezadoTexto ?? ""; _formPie = cfg.PieTexto ?? "";
                    _formOrden = (cfg.OrdenCamposFijos is { Count: > 0 })
                        ? cfg.OrdenCamposFijos.Where(OrdenFijosDefault.Contains).Distinct()
                            .Concat(OrdenFijosDefault.Where(k => !cfg.OrdenCamposFijos.Contains(k))).ToList()
                        : new List<string>(OrdenFijosDefault);
                }
                _formCargado = true;
            }
            catch { }
        }
    }

    private async Task GuardarFormCfg()
    {
        _formGuardado = false;
        var req = new PqrsdFormularioPublicoConfigDto(_formTorre, _formCorreo, _formTelefono,
            string.IsNullOrWhiteSpace(_formEncabezado) ? null : _formEncabezado.Trim(),
            string.IsNullOrWhiteSpace(_formPie) ? null : _formPie.Trim(),
            _formOrden);
        var resp = await Auth().PutAsJsonAsync("/api/pqrsd/formulario-config", req);
        if (resp.IsSuccessStatusCode) _formGuardado = true;
        else _cfgMsg = await LeerError(resp);
    }

    // Reordenar un campo fijo del formulario publico (sube/baja) y guardar.
    private async Task MoverCampoFijo(string key, int dir)
    {
        var i = _formOrden.IndexOf(key);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= _formOrden.Count) return;
        (_formOrden[i], _formOrden[j]) = (_formOrden[j], _formOrden[i]);
        await GuardarFormCfg();
    }

