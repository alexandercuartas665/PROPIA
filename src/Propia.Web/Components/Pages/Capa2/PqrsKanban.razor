    /* Tabla */
    /* Caja externa (borde/radio/overflow:hidden) que integra tabla + footer; el scroll va en el wrap interno. */
    .pk-tablebox { border: 1px solid #E1E8EE; border-radius: 12px; overflow: hidden; margin-bottom: 30px; background: #fff; }
