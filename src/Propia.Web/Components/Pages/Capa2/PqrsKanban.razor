    // ---------- Config motivos de cierre ----------
    private List<MotivoCierreDto> _motivos = new();
    private string _nuevoMotivoNombre = "";
    private string _nuevoMotivoClasif = "1";
    private async Task CargarMotivosAsync()
    {
        try { _motivos = (await Auth().GetFromJsonAsync<List<MotivoCierreDto>>("/api/cierre/motivos?modulo=pqrsd&incluirInactivos=true")) ?? new(); }
        catch { _motivos = new(); }
    }
    private async Task AgregarMotivo()
    {
        if (!int.TryParse(_nuevoMotivoClasif, out var c)) c = 1;
        var resp = await Auth().PostAsJsonAsync("/api/cierre/motivos?modulo=pqrsd",
            new GuardarMotivoCierreRequest(_nuevoMotivoNombre.Trim(), (ClasificacionCierre)c));
        if (resp.IsSuccessStatusCode) { _nuevoMotivoNombre = ""; _cfgMsg = ""; await CargarMotivosAsync(); }
        else { _cfgMsg = await LeerError(resp); }
    }
    private async Task RenombrarMotivo(MotivoCierreDto m, ChangeEventArgs e)
    {
        var nombre = e.Value?.ToString() ?? m.Nombre;
        if (string.IsNullOrWhiteSpace(nombre)) return;
        await Auth().PutAsJsonAsync($"/api/cierre/motivos/{m.Id}", new GuardarMotivoCierreRequest(nombre.Trim(), m.Clasificacion));
        await CargarMotivosAsync();
    }
    private async Task CambiarClasifMotivo(MotivoCierreDto m, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var c)) return;
        await Auth().PutAsJsonAsync($"/api/cierre/motivos/{m.Id}", new GuardarMotivoCierreRequest(m.Nombre, (ClasificacionCierre)c));
        await CargarMotivosAsync();
    }
    private async Task EliminarMotivo(Guid id)
    {
        await Auth().DeleteAsync($"/api/cierre/motivos/{id}");
        await CargarMotivosAsync();
    }
    private async Task RenombrarEstado(PqrsdEstadoDto e, ChangeEventArgs ev)
    {
        var nombre = ev.Value?.ToString() ?? e.Nombre;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/estados/{e.Id}", new ActualizarEstadoPqrsdRequest(nombre, e.Color, e.Orden));
        if (resp.IsSuccessStatusCode) { _cfgMsg = ""; await CargarAsync(); } else { _cfgMsg = await LeerError(resp); }
    }
    private async Task CambiarColor(PqrsdEstadoDto e, ChangeEventArgs ev)
    {
        var color = ev.Value?.ToString() ?? e.Color;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/estados/{e.Id}", new ActualizarEstadoPqrsdRequest(e.Nombre, color, e.Orden));
        if (resp.IsSuccessStatusCode) { await CargarAsync(); }
