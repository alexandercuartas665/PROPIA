    private async Task<Guid?> CrearRapidoAsync()
    {
        if (_compTexto.Trim().Length < 20) { Toast("La descripcion debe tener al menos 20 caracteres.", true); return null; }
        if (!Enum.TryParse<TipoPqrsd>(_compTipo, out var tipo)) tipo = TipoPqrsd.Peticion;
        if (!Guid.TryParse(_compCategoria, out var catId))
        {
            catId = _categorias.FirstOrDefault(c => c.Activa)?.Id ?? Guid.Empty;
            if (catId == Guid.Empty) { Toast("No hay categorias configuradas.", true); return null; }
        }
        var campos = _compCampos.Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
            .Select(kv => new PqrsdCampoValorDto(kv.Key, kv.Value)).ToList();
        var req = new RadicarPqrsdRequest(tipo, catId, _compTexto.Trim(), false, null,
            UnidadPrivadaId: _compUnidad, RadicadorPersonaId: _compRadicador?.PersonaId,
            Campos: campos.Count > 0 ? campos : null);
        var resp = await Auth().PostAsJsonAsync("/api/pqrsd", req);
        if (!resp.IsSuccessStatusCode) { Toast("No se pudo crear: " + await resp.Content.ReadAsStringAsync(), true); return null; }
        var creado = await resp.Content.ReadFromJsonAsync<PqrsdExpedienteDetalleDto>();
        return creado?.Id;
    }

    private async Task CrearDesdeComposer(PqrsdEstadoDto col)
    {
        var id = await CrearRapidoAsync();
        if (id is null) return;
        // Colocar en la columna donde se creo (si no es Recibida).
        if (col.SemanticaLegal != EstadoPqrsd.Recibida)
            await Auth().PutAsJsonAsync($"/api/pqrsd/{id}/mover", new MoverExpedienteEstadoRequest(col.Id));
        CerrarComposer();
        await CargarAsync();
        Toast("PQR creada.", false);
    }

    private async Task CrearDesdeFila()
    {
        var id = await CrearRapidoAsync();
        if (id is null) return;
        _compTexto = "";
        _compCampos.Clear();
        _compUnidad = null;
        _compRadicador = null;
        // Se mantiene el recien creado al final (y resaltado) hasta el proximo refresco de pantalla,
        // para que el usuario NO lo pierda de vista si el orden natural lo moveria a otra posicion.
        _recienCreados.Add(id.Value);
        await CargarAsync();
        Toast("PQR creada.", false);
    }

