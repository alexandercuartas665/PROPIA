    // ---------- Kanban drag ----------
    private void OnDragStart(Guid id) { _draggingId = id; }
    private void OnDragOver() { }
    private async Task OnDrop(Guid targetCol)
    {
        if (_draggingId is null) return;
        var id = _draggingId.Value; _draggingId = null;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{id}/mover", new MoverExpedienteEstadoRequest(targetCol));
        if (resp.IsSuccessStatusCode) { await CargarAsync(); }
        else { Toast("No se pudo mover: " + await resp.Content.ReadAsStringAsync(), true); }
    }
    private async Task MoverAdyacente(PqrsdBandejaItemDto it, int dir)
    {
        var orden = _estados.OrderBy(e => e.Orden).ToList();
        var idx = orden.FindIndex(e => e.Id == it.EstadoId);
        if (idx < 0) return;
        var j = idx + dir;
        if (j < 0 || j >= orden.Count) return;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{it.Id}/mover", new MoverExpedienteEstadoRequest(orden[j].Id));
        if (resp.IsSuccessStatusCode) { await CargarAsync(); Toast($"Movida a '{orden[j].Nombre}'.", false); }
        else { Toast("No se pudo mover.", true); }
    }

