    private async Task EliminarEstado(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/pqrsd/estados/{id}");
        if (resp.IsSuccessStatusCode) { _cfgMsg = ""; await CargarAsync(); } else { _cfgMsg = await LeerError(resp); }
    }
    private static async Task<string> LeerError(HttpResponseMessage resp)
    {
        try { var d = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); return d?.GetValueOrDefault("error") ?? "Error."; }
        catch { return "Error."; }
    }

