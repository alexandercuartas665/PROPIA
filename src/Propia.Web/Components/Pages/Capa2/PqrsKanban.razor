    /* Card */
    .pk-card { background: #fff; border: 1px solid #E1E8EE; border-radius: 11px; padding: 11px 13px; cursor: grab; box-shadow: 0 1px 2px rgba(45,62,80,.04); transition: box-shadow .15s, transform .1s; position: relative; }
