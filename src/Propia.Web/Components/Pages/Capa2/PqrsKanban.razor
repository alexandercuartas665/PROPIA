    // ===================== Ordenamiento por columna (vista Tabla): clic en el encabezado ordena; reclic invierte =====================
    private string _sortCol = ""; private bool _sortAsc = true;
    private void SortByPqr(string col) { if (_sortCol == col) _sortAsc = !_sortAsc; else { _sortCol = col; _sortAsc = true; } }
    private MarkupString SortIndPqr(string col) => _sortCol == col ? (MarkupString)(_sortAsc ? " ▲" : " ▼") : (MarkupString)"";
    private IEnumerable<PqrsdBandejaItemDto> AplicarSortPqr(IEnumerable<PqrsdBandejaItemDto> items)
    {
        if (string.IsNullOrEmpty(_sortCol)) return items;
        Func<PqrsdBandejaItemDto, IComparable> key = _sortCol switch
        {
            "radicado" => x => x.NumeroRadicado,
            "tipo" => x => TipoLabel(x.Tipo),
            "categoria" => x => x.CategoriaNombre ?? "",
            "estado" => x => _estados.FirstOrDefault(e => e.Id == x.EstadoId)?.Orden ?? 0,
            "semaforo" => x => (int)x.Semaforo,
            "radicador" => x => x.RadicadorNombre ?? "",
            "unidad" => x => x.UnidadNumero ?? "",
            "vence" => x => x.DiasHastaVencimiento,
            _ => x => Guid.TryParse(_sortCol, out var cid) ? (x.Campos?.FirstOrDefault(v => v.CampoId == cid)?.Valor ?? "") : ""
        };
        return _sortAsc ? items.OrderBy(key) : items.OrderByDescending(key);
    }

    // ===================== Color por columna (vista Tabla), persistido en localStorage =====================
    // Como la vista Tabla es un <table> real, colorear el <th>/<td> llena la celda completa (no solo la caja interna).
    private Dictionary<string, string> _colColor = new();
    private string? _colColorMenu;
    private static readonly string[] PastelCols = { "#FDE2E4", "#FCE8D5", "#FFF3C4", "#E4F4D4", "#D4F0EC", "#D6E6FB", "#E7DFFB", "#FBE0F0", "#ECEFF3" };
    private string? ColBg(string key) => _colColor.TryGetValue(key, out var c) && !string.IsNullOrEmpty(c) ? c : null;
    private void ToggleColColorMenu(string key) { _colColorMenu = _colColorMenu == key ? null : key; }
    private async Task SetColColor(string key, string? color)
    {
        if (string.IsNullOrEmpty(color)) _colColor.Remove(key); else _colColor[key] = color;
        _colColorMenu = null;
        await PersistColColorAsync();
    }
    private async Task SetColColorInput(string key, ChangeEventArgs e)
    {
        var color = e.Value?.ToString();
        if (!string.IsNullOrEmpty(color)) { _colColor[key] = color; await PersistColColorAsync(); }
    }
    private async Task PersistColColorAsync()
    {
        try { await Js.InvokeVoidAsync("localStorage.setItem", "propia_pqrs_colcolor", System.Text.Json.JsonSerializer.Serialize(_colColor)); } catch { }
    }
    private static string CssKey(string key) => Guid.TryParse(key, out _) ? "c" + key : key;
    private MarkupString ColumnColorCss
    {
        get
        {
            if (_colColor.Count == 0) return (MarkupString)"";
            var sb = new System.Text.StringBuilder("<style>");
            foreach (var kv in _colColor)
            {
                if (string.IsNullOrEmpty(kv.Value)) continue;
                sb.Append(".pk-table .pk-col-").Append(CssKey(kv.Key))
                  .Append("{background:").Append(kv.Value).Append(" !important;}");
            }
            sb.Append("</style>");
            return (MarkupString)sb.ToString();
        }
    }
    private RenderFragment ColorDot(string key)
