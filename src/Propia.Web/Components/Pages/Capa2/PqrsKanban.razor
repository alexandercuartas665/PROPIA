    // ===================== Constructor de filtros (multi-regla Y/O, estilo Tareas) =====================
    private sealed class PqrRegla { public string Campo { get; set; } = "tipo"; public string Op { get; set; } = "es"; public string Valor { get; set; } = ""; }
    private readonly List<PqrRegla> _reglas = new();
    private string _filtroLogica = "and";
    private bool _filtrosMenu;

    private int CuentaFiltros => _reglas.Count(ReglaActiva);
    private bool HayFiltros => _reglas.Any(ReglaActiva);
    private bool ReglaActiva(PqrRegla r) => r.Op is "vacio" or "no_vacio" || !string.IsNullOrWhiteSpace(r.Valor);
    private void ToggleFiltros() { _filtrosMenu = !_filtrosMenu; _pop = null; if (_filtrosMenu && _reglas.Count == 0) AgregarRegla(); }
    private void AgregarRegla() { _reglas.Add(new PqrRegla { Campo = "tipo", Op = "es", Valor = "" }); }
    private void QuitarRegla(int idx) { if (idx >= 0 && idx < _reglas.Count) { _reglas.RemoveAt(idx); _ = PersistFiltrosAsync(); } }
    private void LimpiarFiltros() { _reglas.Clear(); _filtroLogica = "and"; _ = PersistFiltrosAsync(); }
    private void SetFiltroLogica(ChangeEventArgs e) { _filtroLogica = e.Value?.ToString() == "or" ? "or" : "and"; _ = PersistFiltrosAsync(); }
    private void SetReglaCampo(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _reglas.Count) return;
        _reglas[idx].Campo = e.Value?.ToString() ?? "tipo";
        var ops = OperadoresDe(_reglas[idx].Campo);
        if (!ops.Any(o => o.Key == _reglas[idx].Op)) _reglas[idx].Op = ops.First().Key;
        _reglas[idx].Valor = "";
        _ = PersistFiltrosAsync();
    }
    private void SetReglaOp(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglas.Count) { _reglas[idx].Op = e.Value?.ToString() ?? "es"; _ = PersistFiltrosAsync(); } }
    private void SetReglaValor(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglas.Count) { _reglas[idx].Valor = e.Value?.ToString() ?? ""; _ = PersistFiltrosAsync(); } }

    private IEnumerable<(string Key, string Label)> CamposFiltro()
    {
        yield return ("tipo", "Tipo");
        yield return ("estado", "Etapa");
        yield return ("categoria", "Categoria");
        yield return ("semaforo", "Estado");
        yield return ("radicador", "Solicitante");
        yield return ("unidad", "Unidad");
        yield return ("resumen", "Resumen");
        yield return ("radicado", "Radicado");
        yield return ("vence", "Dias para vencer");
        foreach (var c in _campos.OrderBy(c => c.Orden)) yield return (c.Id.ToString(), c.Label);
    }
    private PqrsdCampoDto? CampoDin(string k) => Guid.TryParse(k, out var g) ? _campos.FirstOrDefault(c => c.Id == g) : null;
    private string FiltroKind(string campo) => campo switch
    {
        "tipo" => "sel-tipo",
        "estado" => "sel-estado",
        "categoria" => "sel-cat",
        "semaforo" => "sel-sem",
        "unidad" => "sel-unidad",
        "radicador" or "resumen" or "radicado" => "texto",
        "vence" => "num",
        _ => CampoDin(campo)?.Tipo switch
        {
            TipoCampoTablero.Numero or TipoCampoTablero.Moneda => "num",
            TipoCampoTablero.Fecha => "fecha",
            TipoCampoTablero.Seleccion => "sel-din",
            _ => "texto"
        }
    };
    private (string Key, string Label)[] OperadoresDe(string campo)
    {
        var k = FiltroKind(campo);
        return k switch
        {
            "num" => new[] { ("=", "es igual a"), ("!=", "es distinto de"), (">", "mayor que"), (">=", "mayor o igual"), ("<", "menor que"), ("<=", "menor o igual"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") },
            "fecha" => new[] { ("es", "es"), ("antes", "antes de"), ("despues", "despues de"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") },
            "texto" => new[] { ("contiene", "contiene"), ("no_contiene", "no contiene"), ("es", "es"), ("no_es", "no es"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") },
            _ => new[] { ("es", "es"), ("no_es", "no es"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") }
        };
    }
    private static Guid GuidDe(string k) => Guid.TryParse(k, out var g) ? g : Guid.Empty;
    private string ValorTexto(PqrsdBandejaItemDto it, string campo) => campo switch
    {
        "tipo" => it.Tipo.ToString(),
        "estado" => it.EstadoId?.ToString() ?? "",
        "categoria" => it.CategoriaNombre ?? "",
        "semaforo" => it.Semaforo.ToString(),
        "unidad" => it.UnidadNumero ?? "",
        "radicador" => it.RadicadorNombre ?? "",
        "resumen" => it.DescripcionResumen ?? "",
        "radicado" => it.NumeroRadicado ?? "",
        _ => it.Campos?.FirstOrDefault(v => v.CampoId == GuidDe(campo))?.Valor ?? ""
    };
    private decimal? ValorNum(PqrsdBandejaItemDto it, string campo)
    {
        if (campo == "vence") return it.DiasHastaVencimiento;
        var s = it.Campos?.FirstOrDefault(v => v.CampoId == GuidDe(campo))?.Valor;
        return decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;
    }
    private DateOnly? ValorFecha(PqrsdBandejaItemDto it, string campo)
    {
        var s = it.Campos?.FirstOrDefault(v => v.CampoId == GuidDe(campo))?.Valor;
        return DateOnly.TryParse(s, out var d) ? d : (DateOnly?)null;
    }
    private bool PasaReglas(PqrsdBandejaItemDto it)
    {
        var activas = _reglas.Where(ReglaActiva).ToList();
        if (activas.Count == 0) return true;
        return _filtroLogica == "or" ? activas.Any(r => EvalRegla(it, r)) : activas.All(r => EvalRegla(it, r));
    }
    private bool EvalRegla(PqrsdBandejaItemDto it, PqrRegla r)
    {
        var kind = FiltroKind(r.Campo);
        if (kind == "num")
        {
            var nv = ValorNum(it, r.Campo);
            if (r.Op == "vacio") return nv is null;
            if (r.Op == "no_vacio") return nv is not null;
            if (!decimal.TryParse(r.Valor, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var rv)) return true;
            if (nv is null) return false;
            return r.Op switch { "=" => nv == rv, "!=" => nv != rv, ">" => nv > rv, ">=" => nv >= rv, "<" => nv < rv, "<=" => nv <= rv, _ => true };
        }
        if (kind == "fecha")
        {
            var dv = ValorFecha(it, r.Campo);
            if (r.Op == "vacio") return dv is null;
            if (r.Op == "no_vacio") return dv is not null;
            if (!DateOnly.TryParse(r.Valor, out var rd)) return true;
            if (dv is null) return false;
            return r.Op switch { "es" => dv == rd, "antes" => dv < rd, "despues" => dv > rd, _ => true };
        }
        var sv = ValorTexto(it, r.Campo);
        if (r.Op == "vacio") return string.IsNullOrWhiteSpace(sv);
        if (r.Op == "no_vacio") return !string.IsNullOrWhiteSpace(sv);
        if (string.IsNullOrEmpty(r.Valor)) return true;
        return r.Op switch
        {
            "es" => string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_es" => !string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "contiene" => sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_contiene" => !sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }
    // Editor de valor de una regla (segun el tipo de campo). Se oculta para vacio/no_vacio.
    private RenderFragment RenderValorFiltro(int idx) => builder =>
    {
        if (idx < 0 || idx >= _reglas.Count) return;
        var r = _reglas[idx];
        var kind = FiltroKind(r.Campo);
        void Select(IEnumerable<(string Val, string Txt)> opts, string ph)
        {
            builder.OpenElement(0, "select");
            builder.AddAttribute(1, "class", "pk-frule-v");
            builder.AddAttribute(2, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValor(idx, e)));
            builder.OpenElement(3, "option"); builder.AddAttribute(4, "value", ""); builder.AddAttribute(5, "selected", string.IsNullOrEmpty(r.Valor)); builder.AddContent(6, ph); builder.CloseElement();
            var k = 7;
            foreach (var (val, txt) in opts)
            {
                builder.OpenElement(k++, "option");
                builder.AddAttribute(k++, "value", val);
                builder.AddAttribute(k++, "selected", r.Valor == val);
                builder.AddContent(k++, txt);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        void Input(string type)
        {
            builder.OpenElement(20, "input");
            builder.AddAttribute(21, "class", "pk-frule-v");
            builder.AddAttribute(22, "type", type);
            builder.AddAttribute(23, "value", r.Valor);
            builder.AddAttribute(24, "placeholder", "Valor");
            builder.AddAttribute(25, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValor(idx, e)));
            builder.CloseElement();
        }
        switch (kind)
        {
            case "sel-tipo": Select(Enum.GetValues<TipoPqrsd>().Select(t => (t.ToString(), TipoLabel(t))), "Elegir tipo..."); break;
            case "sel-estado": Select(_estados.OrderBy(e => e.Orden).Select(e => (e.Id.ToString(), e.Nombre)), "Elegir columna..."); break;
            case "sel-cat": Select(_categorias.Select(c => (c.Nombre, c.Nombre)), "Elegir categoria..."); break;
            case "sel-sem": Select(Enum.GetValues<SemaforoPqrsd>().Select(s => (s.ToString(), SemaforoLabel(s))), "Elegir semaforo..."); break;
            case "sel-unidad": Select(UnidadesDistintas().Select(u => (u, u)), "Elegir unidad..."); break;
            case "sel-din": Select(CampoOpciones(CampoDin(r.Campo)!).Select(o => (o, o)), "Elegir opcion..."); break;
            case "num": Input("number"); break;
            case "fecha": Input("date"); break;
            default: Input("text"); break;
        }
    };
    private IEnumerable<string> UnidadesDistintas() =>
        (_bandeja?.Items ?? new List<PqrsdBandejaItemDto>()).Where(x => !string.IsNullOrEmpty(x.UnidadNumero)).Select(x => x.UnidadNumero!).Distinct().OrderBy(x => x);
    private static string[] CampoOpciones(PqrsdCampoDto c) => string.IsNullOrWhiteSpace(c.Opciones)
        ? Array.Empty<string>()
        : c.Opciones.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private const string FiltrosKey = "propia_pqrs_filtros";
    private sealed class FiltrosGuardados { public string Logica { get; set; } = "and"; public List<PqrRegla> Reglas { get; set; } = new(); }
    private async Task PersistFiltrosAsync()
    {
        try { await Js.InvokeVoidAsync("localStorage.setItem", FiltrosKey, System.Text.Json.JsonSerializer.Serialize(new FiltrosGuardados { Logica = _filtroLogica, Reglas = _reglas })); } catch { }
    }
    private async Task RestaurarFiltrosAsync()
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", FiltrosKey);
            _reglas.Clear(); _filtroLogica = "and";
            if (!string.IsNullOrEmpty(raw))
            {
                var g = System.Text.Json.JsonSerializer.Deserialize<FiltrosGuardados>(raw);
                if (g is not null) { _filtroLogica = g.Logica == "or" ? "or" : "and"; _reglas.AddRange(g.Reglas); }
            }
        }
        catch { _reglas.Clear(); _filtroLogica = "and"; }
    }

    // ===================== Vista Calendario (mensual, por fecha de vencimiento) =====================
    private int _calYear;
    private int _calMonth;
    private bool _calInit;
    private void CalEnsure() { if (!_calInit) { var t = DateTime.Today; _calYear = t.Year; _calMonth = t.Month; _calInit = true; } }
    private string CalTitulo { get { CalEnsure(); var s = new DateTime(_calYear, _calMonth, 1).ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-CO")); return char.ToUpper(s[0]) + s.Substring(1); } }
    private void CalMover(int d) { CalEnsure(); var nf = new DateTime(_calYear, _calMonth, 1).AddMonths(d); _calYear = nf.Year; _calMonth = nf.Month; }
    private void CalHoy() { var t = DateTime.Today; _calYear = t.Year; _calMonth = t.Month; _calInit = true; }
    private sealed record CalCelda(int Dia, bool EsMes, bool EsHoy, List<PqrsdBandejaItemDto> Items);
    private List<CalCelda> CalCeldas()
    {
        CalEnsure();
        var primero = new DateTime(_calYear, _calMonth, 1);
        int offset = ((int)primero.DayOfWeek + 6) % 7; // la semana inicia el lunes
        var inicio = primero.AddDays(-offset);
        var hoy = DateTime.Today;
        var porDia = ItemsFiltrados.GroupBy(x => x.FechaVencimiento)
            .ToDictionary(g => g.Key, g => g.OrderBy(x => x.DiasHastaVencimiento).ToList());
        var res = new List<CalCelda>(42);
        for (int i = 0; i < 42; i++)
        {
            var f = inicio.AddDays(i);
            res.Add(new CalCelda(f.Day, f.Month == _calMonth, f.Date == hoy.Date,
                porDia.GetValueOrDefault(DateOnly.FromDateTime(f), new List<PqrsdBandejaItemDto>())));
        }
        return res;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt"); _authChecked = true; }
            catch { _jwt = null; }
            await RestaurarPrefsAsync();
            if (!string.IsNullOrEmpty(_jwt)) { await CargarAsync(); }
            StateHasChanged();
        }
        // Doble scroll horizontal (barra superior espejo) para la vista Tabla, igual que en Tareas.
        if (_boardMode == "tabla")
        {
            try { await Js.InvokeVoidAsync("propiaUI.syncTopScroll", "pkTopScroll", "pkTopScrollInner", "pkTableWrap"); } catch { }
        }
    }

    private async Task RestaurarPrefsAsync()
    {
        try
        {
            _boardMode = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_pqrs_view") ?? "tablero";
            _group = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_pqrs_group") ?? "ninguno";
            _pin = (await Js.InvokeAsync<string?>("localStorage.getItem", "propia_pqrs_pin")) == "1";
            try { var raw = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_pqrs_colcolor"); _colColor = string.IsNullOrEmpty(raw) ? new() : (System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(raw) ?? new()); } catch { _colColor = new(); }
            await RestaurarFiltrosAsync();
        }
        catch { }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        if (string.IsNullOrEmpty(_jwt))
        {
            try { _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt"); }
            catch { return; }
        }
        if (string.IsNullOrEmpty(_jwt)) return;
        _busy = true;
        try
        {
            var http = Auth();
            _bandeja = await http.GetFromJsonAsync<PqrsdBandejaDto>($"/api/pqrsd/bandeja?archivados={(_verArchivados ? "true" : "false")}");
            _estados = (await http.GetFromJsonAsync<List<PqrsdEstadoDto>>("/api/pqrsd/estados")) ?? new();
            _campos = (await http.GetFromJsonAsync<List<PqrsdCampoDto>>("/api/pqrsd/campos")) ?? new();
            _categorias = (await http.GetFromJsonAsync<List<PqrsdCategoriaDto>>("/api/pqrsd/categorias")) ?? new();
            if (string.IsNullOrEmpty(_compCategoria)) _compCategoria = _categorias.FirstOrDefault(c => c.Activa)?.Id.ToString() ?? "";
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

