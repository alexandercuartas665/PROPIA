    // Estado SLA en 3 categorias legibles: A tiempo (verde) / Por vencer (amarillo) / Vencida (rojo).
    // Amarillo (50-80%) y Rojo (80%+) se agrupan como "Por vencer"; Negro (paso el plazo) es "Vencida".
    private static string SemaforoLabel(SemaforoPqrsd s) => s switch
    {
        SemaforoPqrsd.Verde => "A tiempo",
        SemaforoPqrsd.Amarillo => "Por vencer",
        SemaforoPqrsd.Rojo => "Por vencer",
        SemaforoPqrsd.Negro => "Vencida",
        SemaforoPqrsd.TutelaActiva => "Tutela",
        _ => s.ToString()
    };

    private static string SemaforoClass(SemaforoPqrsd s) => s switch
    {
        SemaforoPqrsd.Verde => "pk-sem--verde",
        SemaforoPqrsd.Amarillo => "pk-sem--amarillo",
        SemaforoPqrsd.Rojo => "pk-sem--amarillo",
        SemaforoPqrsd.Negro => "pk-sem--rojo",
        SemaforoPqrsd.TutelaActiva => "pk-sem--tutela",
        _ => ""
    };

    // Dias al lado del estado: "hace Nd" si esta vencida, "N d" si aun no. Vacio para PQR cerradas (sin SLA activo).
    private static string DiasSlaTexto(PqrsdBandejaItemDto it)
    {
        if (it.Semaforo == SemaforoPqrsd.Verde && it.DiasHastaVencimiento < 0) return "";
        return it.DiasHastaVencimiento < 0 ? $"hace {Math.Abs(it.DiasHastaVencimiento)} d" : $"{it.DiasHastaVencimiento} d";
    }
