@page "/pqrs"
@page "/pqrsd"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Pqrsd
@using Propia.Application.Cierre
@using Propia.Application.MiCopropiedad
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals
@using Propia.Web.Components.Shared.Modals

<PageTitle>PQRSD - PROPIA</PageTitle>

@* Modulo 2.9 PQRSD - tablero con columnas configurables + vista tabla (port de Tareas 2.10).
   Kanban por columna (estado configurable), drag&drop via /mover, campos dinamicos, agrupar,
   compositor rapido, tab Archivados y edicion de columnas. *@

<div class="pk-page">
    <div class="pk-head">
        <div>
            <h1 class="pk-title">PQRSD y convivencia</h1>
            <p class="pk-sub">Peticiones, quejas, reclamos, sugerencias y denuncias con plazos legales (Ley 1755).</p>
        </div>
        <div class="pk-head-actions">
            @if (!(_authChecked && string.IsNullOrEmpty(_jwt)))
            {
                @* En Cerrados no hay diseno de tablero (solo tabla de consulta, como en Tareas):
                   el selector de vistas se oculta. *@
                @if (!_verArchivados)
                {
                    <div class="pk-seg">
                        <button class="pk-seg-btn @(_boardMode == "tablero" ? "pk-seg-btn--on" : "")" @onclick="@(() => SetVista("tablero"))">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="11" rx="1"/></svg>
                            Tarjetas
                        </button>
                        <button class="pk-seg-btn @(_boardMode == "tabla" ? "pk-seg-btn--on" : "")" @onclick="@(() => SetVista("tabla"))">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3zM3 9h18M3 15h18M9 3v18"/></svg>
                            Tabla
                        </button>
                        <button class="pk-seg-btn @(_boardMode == "calendario" ? "pk-seg-btn--on" : "")" @onclick="@(() => SetVista("calendario"))">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                            Calendario
                        </button>
                    </div>
                }
                <button class="pk-input-btn" @onclick="AbrirConfigColumnas" title="Configurar columnas del tablero">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
                    Configurar
                </button>
                <button class="pk-input-btn" @onclick="AbrirCompartir" title="Compartir el formulario publico de radicacion">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
                    Compartir
                </button>
            }
            <button class="pk-cta-brand" type="button" @onclick="IrNueva">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                Radicar nueva PQR
            </button>
        </div>
    </div>

    @if (_authChecked && string.IsNullOrEmpty(_jwt))
    {
        <div class="pk-empty">Sesion expirada. <a href="/login?returnUrl=%2Fpqrs">Iniciar sesion</a>.</div>
    }
    else
    {
        @* === Tabs Activos / Cerrados === *@
        <div class="pk-tabs">
            <button class="pk-tab @(!_verArchivados ? "pk-tab--on" : "")" @onclick="() => CambiarTab(false)">Activos</button>
            <button class="pk-tab @(_verArchivados ? "pk-tab--on" : "")" @onclick="() => CambiarTab(true)">Cerrados</button>
        </div>

        @* === KPIs === *@
        @if (_bandeja?.Kpis is not null && !_verArchivados)
        {
            var k = _bandeja.Kpis;
            @* Tarjetas KPI estandar del sistema (icono con fondo pastel + numero, como Contratos). *@
            <div class="pk-kpis">
                <div class="pk-kpi"><div class="pk-kpi-ic pk-kpi-ic--brand"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 12h-6l-2 3h-4l-2-3H2M5.4 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.4-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.8 1.1z"/></svg></div><div><div class="pk-kpi-val">@k.Total</div><div class="pk-kpi-lbl">total</div></div></div>
                <div class="pk-kpi"><div class="pk-kpi-ic pk-kpi-ic--mute"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg></div><div><div class="pk-kpi-val">@k.Recibidas</div><div class="pk-kpi-lbl">recibidas</div></div></div>
                <div class="pk-kpi"><div class="pk-kpi-ic pk-kpi-ic--brand"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM12 8v4l2 2"/></svg></div><div><div class="pk-kpi-val">@k.EnGestion</div><div class="pk-kpi-lbl">en gestion</div></div></div>
                <div class="pk-kpi"><div class="pk-kpi-ic pk-kpi-ic--ok"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6 9 17l-5-5"/></svg></div><div><div class="pk-kpi-val">@k.Respondidas</div><div class="pk-kpi-lbl">respondidas</div></div></div>
                <div class="pk-kpi"><div class="pk-kpi-ic pk-kpi-ic--mute"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/></svg></div><div><div class="pk-kpi-val">@k.Cerradas</div><div class="pk-kpi-lbl">cerradas</div></div></div>
                <div class="pk-kpi @(k.PorVencer > 0 ? "pk-kpi--warn" : "")"><div class="pk-kpi-ic pk-kpi-ic--warn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 8v4l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg></div><div><div class="pk-kpi-val">@k.PorVencer</div><div class="pk-kpi-lbl">por vencer</div></div></div>
                <div class="pk-kpi @(k.Vencidas > 0 ? "pk-kpi--err" : "")"><div class="pk-kpi-ic pk-kpi-ic--err"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg></div><div><div class="pk-kpi-val">@k.Vencidas</div><div class="pk-kpi-lbl">vencidas</div></div></div>
                <div class="pk-kpi @(k.ConTutela > 0 ? "pk-kpi--alert" : "")"><div class="pk-kpi-ic pk-kpi-ic--err"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M8 21h8M3 7l4 7a3.5 3.5 0 0 1-7 0l3-7zM21 7l3 7a3.5 3.5 0 0 1-7 0l4-7zM3 7h18"/></svg></div><div><div class="pk-kpi-val">@k.ConTutela</div><div class="pk-kpi-lbl">con tutela</div></div></div>
            </div>
        }

        @* === Toolbar: vista, agrupar, columnas, config === *@
        <div class="pk-toolbar">
            @* Barra de filtros al estilo Tareas: Filtros + buscador a la izquierda, controles a la derecha. *@
            <div class="pk-menu-wrap">
                <button class="pk-input-btn @(HayFiltros ? "pk-input-btn--on" : "")" @onclick="ToggleFiltros" title="Filtrar PQR">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
                    <span>Filtros</span>@if (CuentaFiltros > 0) { <span class="pk-filter-badge">@CuentaFiltros</span> }
                </button>
                @if (_filtrosMenu)
                {
                    <div class="pk-filterpop-bd" @onclick="() => _filtrosMenu = false"></div>
                    <div class="pk-filterpop" @onclick:stopPropagation="true">
                        @if (_reglas.Count == 0)
                        {
                            <div class="pk-filterpop-empty">Sin filtros aplicados.<br />Agrega una condicion para acotar las PQR.</div>
                        }
                        else
                        {
                            @for (int i = 0; i < _reglas.Count; i++)
                            {
                                var idx = i; var r = _reglas[idx];
                                <div class="pk-frule">
                                    @if (idx == 0)
                                    {
                                        <span class="pk-frule-lead">Donde</span>
                                    }
                                    else if (idx == 1)
                                    {
                                        <select class="pk-frule-lead pk-frule-logic" @onchange="SetFiltroLogica">
                                            <option value="and" selected="@(_filtroLogica == "and")">Y</option>
                                            <option value="or" selected="@(_filtroLogica == "or")">O</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="pk-frule-lead">@(_filtroLogica == "or" ? "O" : "Y")</span>
                                    }
                                    <select class="pk-frule-f" @onchange="(e) => SetReglaCampo(idx, e)">
                                        @foreach (var opt in CamposFiltro()) { <option value="@opt.Key" selected="@(r.Campo == opt.Key)">@opt.Label</option> }
                                    </select>
                                    <select class="pk-frule-op" @onchange="(e) => SetReglaOp(idx, e)">
                                        @foreach (var op in OperadoresDe(r.Campo)) { <option value="@op.Key" selected="@(r.Op == op.Key)">@op.Label</option> }
                                    </select>
                                    @if (r.Op is not "vacio" and not "no_vacio")
                                    {
                                        @RenderValorFiltro(idx)
                                    }
                                    <button type="button" class="pk-frule-del" title="Quitar condicion" @onclick="() => QuitarRegla(idx)">&times;</button>
                                </div>
                            }
                        }
                        <div class="pk-filterpop-foot">
                            <button type="button" class="pk-filter-add" @onclick="AgregarRegla">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"/></svg>Agregar filtro
                            </button>
                            @if (_reglas.Count > 0) { <button type="button" class="pk-filter-clear" @onclick="LimpiarFiltros">Limpiar todo</button> }
                        </div>
                    </div>
                }
            </div>

            <input class="pk-input" value="@_buscar" @oninput="e => { _buscar = e.Value?.ToString() ?? string.Empty; _pagina = 1; }" placeholder="Buscar por radicado o resumen..." />

            <div class="pk-filters-spacer"></div>

            <div class="pk-menu-wrap">
                <button class="pk-input-btn @(_group != "ninguno" ? "pk-input-btn--on" : "")" @onclick='() => TogglePop("group")'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    Agrupar@(_group != "ninguno" ? ": " + GroupLabel(_group) : "")
                </button>
                @if (_pop == "group")
                {
                    <div class="pk-pop">
                        @foreach (var g in new[] { "ninguno", "estado", "tipo", "categoria", "unidad" })
                        {
                            <button class="pk-pop-item @(_group == g ? "pk-pop-item--on" : "")" @onclick="() => SetGroup(g)">@GroupLabel(g)</button>
                        }
                    </div>
                }
            </div>

            @if (VistaEfectiva == "tabla")
            {
                <div class="pk-menu-wrap">
                    <button class="pk-input-btn" @onclick='() => TogglePop("cols")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                        Campos
                    </button>
                    @if (_pop == "cols")
                    {
                        <div class="pk-pop pk-pop--wide">
                            <div class="pk-pop-h">Columnas fijas</div>
                            @{ var _ord = ColsFijasOrd().ToList(); }
                            @for (int i = 0; i < _ord.Count; i++)
                            {
                                var idx = i; var col = _ord[idx];
                                <div class="pk-pop-row">
                                    <span class="pk-pop-ord">
                                        <button type="button" class="pk-pop-mv" disabled="@(idx == 0)" @onclick="() => MoverColPqr(idx, -1)" title="Subir">&#9650;</button>
                                        <button type="button" class="pk-pop-mv" disabled="@(idx == _ord.Count - 1)" @onclick="() => MoverColPqr(idx, 1)" title="Bajar">&#9660;</button>
                                    </span>
                                    <label class="pk-pop-chk">
                                        <input type="checkbox" checked="@(!_colsOcultas.Contains(col.Key))" @onchange="() => ToggleCol(col.Key)" />
                                        <span>@col.Label</span>
                                    </label>
                                </div>
                            }
                            @if (_campos.Count > 0)
                            {
                                <div class="pk-pop-h">Campos del tablero</div>
                                @foreach (var c in _campos.OrderBy(c => c.Orden))
                                {
                                    <label class="pk-pop-chk">
                                        <input type="checkbox" checked="@(!_camposOcultos.Contains(c.Id))" @onchange="() => ToggleCampoCol(c.Id)" />
                                        <span>@c.Label</span>
                                    </label>
                                }
                            }
                            <div class="pk-pop-acts">
                                <button type="button" class="pk-pop-act" @onclick="MostrarTodoCols">Mostrar todo</button>
                                <button type="button" class="pk-pop-act" @onclick="OcultarTodoCols">Ocultar todo</button>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>

        @* ===================== VISTA KANBAN ===================== *@
        @if (VistaEfectiva == "tablero")
        {
            <div class="pk-board" style="grid-template-columns: repeat(@Math.Max(_estados.Count, 1), minmax(240px, 1fr));">
                @foreach (var col in _estados.OrderBy(e => e.Orden))
                {
                    var items = ItemsFiltrados.Where(x => x.EstadoId == col.Id).ToList();
                    <div class="pk-col" @ondragover="OnDragOver" @ondragover:preventDefault="true" @ondrop="() => OnDrop(col.Id)">
                        <div class="pk-col-head">
                            <span class="pk-col-dot" style="background:@(col.Color ?? "#A6B7C8")"></span>
                            <span class="pk-col-name">@col.Nombre</span>
                            <span class="pk-col-count">@items.Count</span>
                        </div>
                        <div class="pk-col-body">
                            @foreach (var it in items)
                            {
                                <div class="pk-card @(it.TutelaActiva ? "pk-card--tutela" : "")" draggable="true"
                                     @ondragstart="() => OnDragStart(it.Id)" @onclick="() => IrA(it.Id)">
                                    @if (_verArchivados)
                                    {
                                        <button class="pk-icon-btn pk-card-arch" title="Reabrir" @onclick:stopPropagation="true" @onclick="() => Archivar(it.Id, false)">↻</button>
                                    }
                                    <div class="pk-card-head">
                                        <span class="pk-card-num">@it.NumeroRadicado</span>
                                        <span class="pk-sem @SemaforoClass(it.Semaforo)" title="@SemaforoLabel(it.Semaforo)"><span class="pk-sem-dot"></span>@SemaforoLabel(it.Semaforo)</span>
                                    </div>
                                    <div class="pk-card-tipo">
                                        <span class="pk-tipo-pill">@TipoLabel(it.Tipo)</span>
                                        <span class="pk-cat">@it.CategoriaNombre</span>
                                    </div>
                                    <div class="pk-card-desc">@it.DescripcionResumen</div>
                                    <div class="pk-card-foot">
                                        <span class="pk-radicador">
                                            @if (it.IdentidadReservada) { <span class="pk-rsv">[Reservada]</span> }
                                            else if (!string.IsNullOrEmpty(it.RadicadorNombre)) { <span>@it.RadicadorNombre</span> }
                                            @if (!string.IsNullOrEmpty(it.UnidadNumero)) { <span> - @it.UnidadNumero</span> }
                                        </span>
                                        <span class="pk-vence @(it.DiasHastaVencimiento < 0 ? "pk-vence-err" : it.DiasHastaVencimiento <= 3 ? "pk-vence-warn" : "")">
                                            @if (it.DiasHastaVencimiento < 0) { <span>vencida hace @Math.Abs(it.DiasHastaVencimiento)d</span> }
                                            else { <span>@it.DiasHastaVencimiento d</span> }
                                        </span>
                                    </div>
                                    @if (it.TutelaActiva || it.TieneComiteActivo)
                                    {
                                        <div class="pk-card-flags">
                                            @if (it.TutelaActiva) { <span class="pk-flag pk-flag--tutela">Tutela activa</span> }
                                            @if (it.TieneComiteActivo) { <span class="pk-flag pk-flag--comite">Comite</span> }
                                        </div>
                                    }
                                </div>
                            }
                            @* Compositor rapido *@
                            @if (_composerCol == col.Id)
                            {
                                <div class="pk-composer" @onclick:stopPropagation="true">
                                    <input class="pk-comp-input" placeholder="Describe la PQR (min 20 caracteres)..." @bind="_compTexto" @bind:event="oninput"
                                           @onkeydown="ComposerKeydown" />
                                    <div class="pk-comp-row">
                                        <select class="pk-comp-sel" @bind="_compTipo">
                                            @foreach (var t in Enum.GetValues<TipoPqrsd>()) { <option value="@t">@TipoLabel(t)</option> }
                                        </select>
                                        <select class="pk-comp-sel" @bind="_compCategoria">
                                            @foreach (var c in _categorias.Where(c => c.Activa)) { <option value="@c.Id">@c.Nombre</option> }
                                        </select>
                                    </div>
                                    <div class="pk-comp-actions">
                                        <button class="pk-comp-ok" @onclick="() => CrearDesdeComposer(col)" disabled="@(_compTexto.Trim().Length < 20)">Crear</button>
                                        <button class="pk-comp-x" @onclick="CerrarComposer">Cancelar</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="pk-add-card" @onclick="() => AbrirComposer(col.Id)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                                    Nueva PQR
                                </button>
                            }
                            @if (items.Count == 0 && _composerCol != col.Id) { <div class="pk-col-empty">Sin PQRs.</div> }
                        </div>
                    </div>
                }
            </div>
        }
        else if (VistaEfectiva == "calendario")
        {
            @* ===================== VISTA CALENDARIO (por fecha de vencimiento legal) ===================== *@
            <div class="pk-cal">
                <div class="pk-cal-bar">
                    <button class="pk-icon-btn pk-cal-nav" @onclick="() => CalMover(-1)">&#8249;</button>
                    <span class="pk-cal-title">@CalTitulo</span>
                    <button class="pk-icon-btn pk-cal-nav" @onclick="() => CalMover(1)">&#8250;</button>
                    <button class="pk-input-btn pk-cal-hoy" @onclick="CalHoy">Hoy</button>
                    <span class="pk-cal-hint">Las PQR se ubican por su fecha de vencimiento legal.</span>
                </div>
                <div class="pk-cal-head">
                    @foreach (var dw in new[] { "LUN", "MAR", "MIE", "JUE", "VIE", "SAB", "DOM" }) { <div class="pk-cal-dow">@dw</div> }
                </div>
                <div class="pk-cal-grid">
                    @foreach (var celda in CalCeldas())
                    {
                        <div class="pk-cal-cell @(celda.EsHoy ? "pk-cal-cell--hoy" : "") @(celda.EsMes ? "" : "pk-cal-cell--off")">
                            <div class="pk-cal-daynum">@celda.Dia</div>
                            @foreach (var it in celda.Items.Take(3))
                            {
                                <div class="pk-cal-ev @(it.DiasHastaVencimiento < 0 ? "pk-cal-ev--err" : it.DiasHastaVencimiento <= 3 ? "pk-cal-ev--warn" : "")"
                                     title="@it.NumeroRadicado - @it.DescripcionResumen" @onclick="() => IrA(it.Id)">
                                    <span class="pk-cal-ev-num">@it.NumeroRadicado</span>
                                </div>
                            }
                            @if (celda.Items.Count > 3) { <div class="pk-cal-more">+@(celda.Items.Count - 3) mas</div> }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @* ===================== VISTA TABLA ===================== *@
            @ColumnColorCss
            @* Doble scroll horizontal: barra superior espejo, sincronizada por JS con la tabla (igual que Tareas). *@
            <div class="pk-topscroll" id="pkTopScroll"><div id="pkTopScrollInner"></div></div>
            <div class="pk-tablebox">
            <div class="pk-table-wrap" id="pkTableWrap">
                <table class="pk-table @(_pin ? "pk-table--pin" : "")">
                    <thead>
                        <tr>
                            <th class="pk-th-exp"></th>
                            @foreach (var col in ColsFijasOrd().Where(c => !_colsOcultas.Contains(c.Key)))
                            {
                                var ck = col.Key;
                                <th class="pk-th-sort pk-col-@ck @(ck == "radicado" ? "pk-th-pin" : "")" @onclick="() => SortByPqr(ck)">
                                    <span class="pk-th-lbl">@col.Label@SortIndPqr(ck)</span>@ColorDot(ck)
                                </th>
                            }
                            @foreach (var c in _campos.Where(c => !_camposOcultos.Contains(c.Id)).OrderBy(c => c.Orden))
                            {
                                var cid = c.Id.ToString();
                                <th class="pk-th-sort pk-col-c@(c.Id)" @onclick="() => SortByPqr(cid)">
                                    <span class="pk-th-lbl">@c.Label@SortIndPqr(cid)</span>@ColorDot(cid)
                                </th>
                            }
                            <th class="pk-th-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grp in ItemsAgrupados)
                        {
                            @if (_group != "ninguno")
                            {
                                <tr class="pk-grp-row"><td colspan="99"><span class="pk-grp-lead">@grp.Key <span class="pk-grp-num">@grp.Count()</span></span></td></tr>
                            }
                            @foreach (var it in AplicarSortPqr(grp))
                            {
                                <tr class="pk-tr @(_recienCreados.Contains(it.Id) ? "pk-tr-nuevo" : "")" @onclick="() => IrA(it.Id)">
                                    <td class="pk-td-exp" @onclick:stopPropagation="true">
                                        <button type="button" class="pk-exp" title="Abrir la ficha" @onclick="() => IrA(it.Id)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                        </button>
                                    </td>
                                    @foreach (var col in ColsFijasOrd().Where(c => !_colsOcultas.Contains(c.Key)))
                                    {
                                        <td class="pk-col-@col.Key @(col.Key == "radicado" ? "pk-td-pin" : "")">
                                            @switch (col.Key)
                                            {
                                                case "radicado":
                                                    <strong>@it.NumeroRadicado</strong>
                                                    break;
                                                case "asunto":
                                                    <div class="pk-td-muted" style="max-width:380px;">@it.DescripcionResumen</div>
                                                    break;
                                                case "tipo": <span class="pk-tipo-pill">@TipoLabel(it.Tipo)</span> break;
                                                case "categoria": <span>@it.CategoriaNombre</span> break;
                                                case "estado": <span>@(_estados.FirstOrDefault(e => e.Id == it.EstadoId)?.Nombre ?? "-")</span> break;
                                                case "semaforo":
                                                    <span class="pk-sem @SemaforoClass(it.Semaforo)"><span class="pk-sem-dot"></span>@SemaforoLabel(it.Semaforo)</span>
                                                    <span class="pk-sem-dias @(it.DiasHastaVencimiento < 0 ? "pk-sem-dias--err" : it.DiasHastaVencimiento <= 3 ? "pk-sem-dias--warn" : "")">@DiasSlaTexto(it)</span>
                                                    break;
                                                case "radicador":
                                                    @if (it.IdentidadReservada) { <span class="pk-rsv">[Reservada]</span> } else { <span>@it.RadicadorNombre</span> }
                                                    break;
                                                case "unidad": <span>@it.UnidadNumero</span> break;
                                                case "vence":
                                                    <span class="pk-vence @(it.DiasHastaVencimiento < 0 ? "pk-vence-err" : it.DiasHastaVencimiento <= 3 ? "pk-vence-warn" : "")">
                                                        @(it.DiasHastaVencimiento < 0 ? $"-{Math.Abs(it.DiasHastaVencimiento)}d" : $"{it.DiasHastaVencimiento}d")
                                                    </span>
                                                    break;
                                            }
                                        </td>
                                    }
                                    @foreach (var c in _campos.Where(c => !_camposOcultos.Contains(c.Id)).OrderBy(c => c.Orden))
                                    {
                                        <td class="pk-td-muted pk-col-c@(c.Id)">@(it.Campos?.FirstOrDefault(v => v.CampoId == c.Id)?.Valor)</td>
                                    }
                                    <td class="pk-td-actions" @onclick:stopPropagation="true">
                                        @if (_verArchivados)
                                        {
                                            <button class="pk-icon-btn" title="Reabrir" @onclick="() => Archivar(it.Id, false)">&#8635;</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        @* Fila de alta inline (al final de la tabla). *@
                        @if (!_verArchivados)
                        {
                            <tr class="pk-tr pk-tr-new">
                                <td class="pk-td-exp">
                                    <button type="button" class="pk-exp pk-exp-fijo" title="Crear la PQR" @onclick="() => CrearDesdeFila()">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                    </button>
                                </td>
                                @foreach (var col in ColsFijasOrd().Where(c => !_colsOcultas.Contains(c.Key)))
                                {
                                    <td class="pk-col-@col.Key @(col.Key == "radicado" ? "pk-td-pin" : "")" @onclick:stopPropagation="true">
                                        @switch (col.Key)
                                        {
                                            case "radicado": <span class="pk-td-muted">(auto)</span> break;
                                            case "asunto":
                                                <input class="pk-cell-input" placeholder="Asunto / descripcion (min 20 caract.)..." @bind="_compTexto" @bind:event="oninput" @onkeydown="NuevaFilaKeydown" />
                                                break;
                                            case "tipo":
                                                <select class="pk-cell-input" @bind="_compTipo">
                                                    @foreach (var t in Enum.GetValues<TipoPqrsd>()) { <option value="@t">@TipoLabel(t)</option> }
                                                </select>
                                                break;
                                            case "categoria":
                                                <select class="pk-cell-input" @bind="_compCategoria">
                                                    <option value="">- Categoria -</option>
                                                    @foreach (var c in _categorias.Where(c => c.Activa)) { <option value="@c.Id">@c.Nombre</option> }
                                                </select>
                                                break;
                                            case "radicador":
                                                <SelectorPersona Jwt="@_jwt" @bind-Seleccionada="_compRadicador"
                                                                 Placeholder="Solicitante (opcional)..." PermiteEmpresa="true" Flotante="true" />
                                                break;
                                            case "unidad":
                                                <SelectorUnidadCascada Unidades="_unidades" UnidadId="_compUnidad"
                                                                       UnidadIdChanged="@(v => _compUnidad = v)"
                                                                       Class="pk-cell-input" MostrarLabels="false" />
                                                break;
                                            case "estado": <span class="pk-td-muted">Recibida</span> break;
                                            case "semaforo": <span class="pk-td-muted">(auto)</span> break;
                                            case "vence": <span class="pk-td-muted">(auto)</span> break;
                                            default: <span class="pk-td-muted">-</span> break;
                                        }
                                    </td>
                                }
                                @foreach (var c in _campos.Where(c => !_camposOcultos.Contains(c.Id)).OrderBy(c => c.Orden))
                                {
                                    var cid = c.Id;
                                    <td @onclick:stopPropagation="true">
                                        @switch (c.Tipo)
                                        {
                                            case TipoCampoTablero.Seleccion:
                                                <select class="pk-cell-input" value="@CompCampoVal(cid)" @onchange="e => SetCompCampo(cid, e.Value?.ToString())">
                                                    <option value="">@c.Label...</option>
                                                    @foreach (var o in CampoOpciones(c)) { <option value="@o">@o</option> }
                                                </select>
                                                break;
                                            case TipoCampoTablero.Fecha:
                                                <input class="pk-cell-input" type="date" value="@CompCampoVal(cid)" @oninput="e => SetCompCampo(cid, e.Value?.ToString())" />
                                                break;
                                            case TipoCampoTablero.Numero:
                                            case TipoCampoTablero.Moneda:
                                                <input class="pk-cell-input" type="number" placeholder="@c.Label" value="@CompCampoVal(cid)" @oninput="e => SetCompCampo(cid, e.Value?.ToString())" />
                                                break;
                                            default:
                                                <input class="pk-cell-input" placeholder="@c.Label" value="@CompCampoVal(cid)" @oninput="e => SetCompCampo(cid, e.Value?.ToString())" />
                                                break;
                                        }
                                    </td>
                                }
                                <td class="pk-td-actions">
                                    <button type="button" class="pk-newrow-save" title="Agregar la PQR y abrir el detalle para completar" @onclick="() => CrearDesdeFila()">+ Agregar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (ItemsFiltrados.Count() == 0) { <div class="pk-col-empty">Sin PQRs.</div> }
            </div>
            @if (_group == "ninguno" && ItemsFiltrados.Any())
            {
                <TablaPager Total="ItemsFiltrados.Count()" Pagina="_pagina" PorPagina="_porPagina" Entidad="PQRs"
                            PaginaChanged="p => _pagina = p"
                            PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
            }
            </div>
        }

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="pk-toast @(_msgError ? "pk-toast--err" : "pk-toast--ok")">@_msg</div>
        }
    }

    @* ===================== COMPARTIR FORMULARIO PUBLICO ===================== *@
    @if (_shareOpen)
    {
        <div class="pk-cfg-backdrop" @onclick="() => _shareOpen = false">
            <div class="pk-cfg pk-share" @onclick:stopPropagation="true">
                <div class="pk-cfg-head">
                    <h3>Compartir formulario de radicacion</h3>
                    <button class="npq-close" @onclick="() => _shareOpen = false">&times;</button>
                </div>
                <div class="pk-cfg-body">
                    @if (_shareLink is null)
                    {
                        <p class="pk-share-warn">No se pudo determinar la copropiedad de la sesion. Vuelve a iniciar sesion e intenta de nuevo.</p>
                    }
                    else
                    {
                        <p class="pk-share-intro">
                            Cualquier persona con este enlace puede radicar una PQRSD para tu copropiedad, sin necesidad de
                            iniciar sesion. Por seguridad, el formulario no permite buscar unidades: el solicitante escribe
                            su unidad exacta y su identificacion.
                        </p>

                        <label class="pk-share-lbl">Enlace publico</label>
                        <div class="pk-share-row">
                            <input class="pk-share-input" readonly value="@_shareLink" @onclick="SeleccionarTodo" />
                            <button class="pk-comp-ok" @onclick="() => Copiar(_shareLink!)">Copiar</button>
                        </div>

                        <label class="pk-share-lbl">Insertar en un sitio web (iframe)</label>
                        <div class="pk-share-row">
                            <textarea class="pk-share-input pk-share-ta" readonly rows="3" @onclick="SeleccionarTodo">@_shareIframe</textarea>
                            <button class="pk-comp-ok" @onclick="() => Copiar(_shareIframe!)">Copiar</button>
                        </div>

                        <label class="pk-share-lbl">Compartir por</label>
                        <div class="pk-share-btns">
                            <a class="pk-share-chip pk-share-wa" href="@WhatsAppUrl()" target="_blank" rel="noopener">WhatsApp</a>
                            <a class="pk-share-chip pk-share-mail" href="@MailUrl()">Correo</a>
                            <a class="pk-share-chip" href="@_shareLink" target="_blank" rel="noopener">Abrir en pestana nueva</a>
                        </div>

                        @if (_shareMsg is not null)
                        {
                            <div class="pk-share-ok">@_shareMsg</div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @* ===================== CONFIG DE COLUMNAS ===================== *@
    @if (_cfgOpen)
    {
        <div class="pk-cfg-backdrop" @onclick="() => _cfgOpen = false">
            <div class="pk-cfg" @onclick:stopPropagation="true">
                <div class="pk-cfg-head">
                    <h3>Configurar PQRSD</h3>
                    <button class="npq-close" @onclick="() => _cfgOpen = false">&times;</button>
                </div>
                <div class="pk-cfg-tabs">
                    <button type="button" class="pk-cfg-tab @(_cfgTab == "columnas" ? "on" : "")" @onclick='() => _cfgTab = "columnas"'>Columnas</button>
                    <button type="button" class="pk-cfg-tab @(_cfgTab == "motivos" ? "on" : "")" @onclick='() => _cfgTab = "motivos"'>Motivos de cierre</button>
                    <button type="button" class="pk-cfg-tab @(_cfgTab == "tipos" ? "on" : "")" @onclick='() => _cfgTab = "tipos"'>Tipos de PQR</button>
                    <button type="button" class="pk-cfg-tab @(_cfgTab == "categorias" ? "on" : "")" @onclick='() => _cfgTab = "categorias"'>Categorias</button>
                    <button type="button" class="pk-cfg-tab @(_cfgTab == "campos" ? "on" : "")" @onclick='() => _cfgTab = "campos"'>Campos dinamicos</button>
                    <button type="button" class="pk-cfg-tab @(_cfgTab == "formulario" ? "on" : "")" @onclick='CambiarATabFormulario'>Formulario publico</button>
                    <button type="button" class="pk-cfg-tab @(_cfgTab == "tareas" ? "on" : "")" @onclick='CambiarATabTareasCfg'>Tareas</button>
                </div>
                <div class="pk-cfg-body">
                  @if (_cfgTab == "columnas")
                  {
                    <div class="pk-cfg-sec-hint">Columnas (etapas) del tablero. Las columnas legales manejan los plazos de ley.</div>
                    @foreach (var e in _estados.OrderBy(x => x.Orden))
                    {
                        <div class="pk-cfg-row">
                            <input type="color" class="pk-cfg-color" value="@(e.Color ?? "#6D4FE3")" @onchange="(ev) => CambiarColor(e, ev)" />
                            <input class="pk-cfg-name" value="@e.Nombre" @onchange="(ev) => RenombrarEstado(e, ev)" />
                            @if (e.SemanticaLegal is not null) { <span class="pk-cfg-badge" title="Columna legal - maneja plazos">legal</span> }
                            <div class="pk-cfg-ord">
                                <button class="pk-icon-btn" @onclick='() => ReordenarEstado(e.Id, "arriba")'>&#8593;</button>
                                <button class="pk-icon-btn" @onclick='() => ReordenarEstado(e.Id, "abajo")'>&#8595;</button>
                            </div>
                            <button class="pk-cfg-del" @onclick="() => EliminarEstado(e.Id)">Eliminar</button>
                        </div>
                    }
                    <div class="pk-cfg-add">
                        <input class="pk-cfg-name" placeholder="Nombre de nueva columna..." @bind="_nuevaColNombre" />
                        <input type="color" class="pk-cfg-color" @bind="_nuevaColColor" />
                        <button class="pk-comp-ok" @onclick="AgregarColumna" disabled="@string.IsNullOrWhiteSpace(_nuevaColNombre)">Agregar columna</button>
                    </div>
                  }

                  @if (_cfgTab == "motivos")
                  {
                    @* Motivos de cierre configurables (se piden al cerrar una PQRSD). *@
                    <div class="pk-cfg-sec-hint">Al cerrar una PQRSD se elige uno de estos motivos; cada uno trae su clasificacion.</div>
                    @foreach (var m in _motivos.OrderBy(x => x.Orden))
                    {
                        var mm = m;
                        <div class="pk-cfg-row">
                            <input class="pk-cfg-name" value="@m.Nombre" @onchange="(ev) => RenombrarMotivo(mm, ev)" />
                            <select class="pk-cfg-clasif" @onchange="(ev) => CambiarClasifMotivo(mm, ev)">
                                <option value="1" selected="@(m.Clasificacion == ClasificacionCierre.CierreCorrecto)">Cierre correcto</option>
                                <option value="2" selected="@(m.Clasificacion == ClasificacionCierre.ViaInternaAgotada)">Via interna agotada</option>
                                <option value="3" selected="@(m.Clasificacion == ClasificacionCierre.Perdida)">Perdida</option>
                            </select>
                            <button class="pk-cfg-del" @onclick="() => EliminarMotivo(mm.Id)">@(m.EsBase ? "Desactivar" : "Eliminar")</button>
                        </div>
                    }
                    <div class="pk-cfg-add">
                        <input class="pk-cfg-name" placeholder="Nuevo motivo de cierre..." @bind="_nuevoMotivoNombre" />
                        <select class="pk-cfg-clasif" @bind="_nuevoMotivoClasif">
                            <option value="1">Cierre correcto</option>
                            <option value="2">Via interna agotada</option>
                            <option value="3">Perdida</option>
                        </select>
                        <button class="pk-comp-ok" @onclick="AgregarMotivo" disabled="@string.IsNullOrWhiteSpace(_nuevoMotivoNombre)">Agregar motivo</button>
                    </div>
                  }

                  @if (_cfgTab == "tipos")
                  {
                    @* Tipos de PQR configurables (catalogo por copropiedad). Antes se creaban dentro del modal de radicar. *@
                    <div class="pk-cfg-sec-hint">Cada tipo define su plazo (dias habiles) y hereda una conducta legal (Ley 1755).</div>
                    @foreach (var t in _tipos.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                    {
                        var tt = t;
                        <div class="pk-cfg-row">
                            <input class="pk-cfg-name" value="@t.Nombre" @onchange="(ev) => RenombrarTipo(tt, ev)" />
                            <input class="pk-cfg-dias" type="number" min="1" max="90" value="@t.DiasHabiles" title="Dias habiles de plazo" @onchange="(ev) => CambiarDiasTipo(tt, ev)" />
                            <select class="pk-cfg-clasif" @onchange="(ev) => CambiarLegalTipo(tt, ev)" disabled="@t.EsBase" title="@(t.EsBase ? "Los tipos base conservan su conducta legal" : "Conducta legal que hereda")">
                                @foreach (var lg in Enum.GetValues<TipoPqrsd>()) { <option value="@lg" selected="@(t.Legal == lg)">como @TipoLabel(lg)</option> }
                            </select>
                            @if (t.EsBase) { <span class="pk-cfg-badge" title="Tipo base del sistema">base</span> }
                            <button class="pk-cfg-del" @onclick="() => EliminarTipo(tt.Id)">@(t.EsBase ? "Desactivar" : "Eliminar")</button>
                        </div>
                    }
                    <div class="pk-cfg-add">
                        <input class="pk-cfg-name" placeholder="Nombre del nuevo tipo..." @bind="_nuevoTipoNombre" />
                        <input class="pk-cfg-dias" type="number" min="1" max="90" @bind="_nuevoTipoDias" title="Dias habiles" />
                        <select class="pk-cfg-clasif" @bind="_nuevoTipoLegal">
                            @foreach (var lg in Enum.GetValues<TipoPqrsd>()) { <option value="@lg">como @TipoLabel(lg)</option> }
                        </select>
                        <button class="pk-comp-ok" @onclick="AgregarTipo" disabled="@string.IsNullOrWhiteSpace(_nuevoTipoNombre)">Agregar tipo</button>
                    </div>
                  }

                  @if (_cfgTab == "categorias")
                  {
                    @* Categorias configurables. *@
                    <div class="pk-cfg-sec-hint">Para clasificar las PQR (Administracion, Convivencia, ...).</div>
                    @foreach (var c in _categorias.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                    {
                        var cc = c;
                        <div class="pk-cfg-row">
                            <input class="pk-cfg-name" value="@c.Nombre" @onchange="(ev) => RenombrarCategoria(cc, ev)" />
                            @if (c.EsPredeterminada) { <span class="pk-cfg-badge" title="Categoria predeterminada">predet.</span> }
                            <label class="pk-cfg-chk"><input type="checkbox" checked="@c.Activa" @onchange="(ev) => ActivarCategoria(cc, ev)" />Activa</label>
                            <button class="pk-cfg-del" @onclick="() => EliminarCategoria(cc.Id)">Eliminar</button>
                        </div>
                    }
                    <div class="pk-cfg-add">
                        <input class="pk-cfg-name" placeholder="Nueva categoria..." @bind="_nuevaCatNombre" />
                        <button class="pk-comp-ok" @onclick="AgregarCategoria" disabled="@string.IsNullOrWhiteSpace(_nuevaCatNombre)">Agregar categoria</button>
                    </div>
                  }

                  @if (_cfgTab == "campos")
                  {
                    <div class="pk-cfg-sec-hint">Campos personalizados que aparecen en cada PQRSD (y se pueden pedir al radicar).</div>
                    @foreach (var c in _campos.OrderBy(x => x.Orden))
                    {
                        var cc = c;
                        <div class="pk-cfg-row">
                            <input class="pk-cfg-name" value="@c.Label" @onchange="(ev) => RenombrarCampoCfg(cc, ev)" />
                            <span class="pk-cfg-badge" title="Tipo del campo">@c.Tipo</span>
                            <label class="pk-cfg-chk"><input type="checkbox" checked="@c.Requerido" @onchange="(ev) => ToggleReqCampoCfg(cc, ev)" />Requerido</label>
                            <label class="pk-cfg-chk" title="Pedir tambien en el formulario publico"><input type="checkbox" checked="@c.MostrarEnPublico" @onchange="(ev) => ToggleCampoPublicoCfg(cc, ev)" />Publico</label>
                            <div class="pk-cfg-ord">
                                <button class="pk-icon-btn" @onclick='() => ReordenarCampoCfg(cc.Id, "arriba")'>&#8593;</button>
                                <button class="pk-icon-btn" @onclick='() => ReordenarCampoCfg(cc.Id, "abajo")'>&#8595;</button>
                            </div>
                            <button class="pk-cfg-del" @onclick="() => EliminarCampoCfg(cc.Id)">Eliminar</button>
                        </div>
                    }
                    @if (_campos.Count == 0) { <div class="pk-cfg-sec-hint">Aun no hay campos. Crea el primero abajo.</div> }
                    <div class="pk-cfg-add">
                        <input class="pk-cfg-name" placeholder="Nombre del campo..." @bind="_nuevoCampoLabel" />
                        <select class="pk-cfg-clasif" @bind="_nuevoCampoTipo">
                            @foreach (var t in Enum.GetValues<TipoCampoTablero>()) { <option value="@t">@t</option> }
                        </select>
                        <button class="pk-comp-ok" @onclick="AgregarCampoCfg" disabled="@string.IsNullOrWhiteSpace(_nuevoCampoLabel)">Agregar campo</button>
                    </div>
                    @if (_nuevoCampoTipo == TipoCampoTablero.Seleccion)
                    {
                        <textarea class="pk-cfg-name" style="width:100%;min-height:56px;margin-top:6px;" placeholder="Opciones para el tipo Seleccion (una por linea)" @bind="_nuevoCampoOpciones"></textarea>
                    }
                  }

                  @if (_cfgTab == "formulario")
                  {
                    <div class="pk-cfg-sec-hint">Personaliza el formulario publico de radicacion (enlace /pqr).</div>

                    <label class="pk-cfg-formlbl">Encabezado (instrucciones que ve el solicitante arriba del formulario)</label>
                    <textarea class="pk-cfg-name" style="width:100%;min-height:52px;" placeholder="Ej. Radica aqui tu PQRSD. La administracion respondera dentro del plazo de ley." @bind="_formEncabezado" @bind:after="GuardarFormCfg"></textarea>
                    <label class="pk-cfg-formlbl" style="margin-top:10px;">Pie de pagina (texto al final del formulario)</label>
                    <textarea class="pk-cfg-name" style="width:100%;min-height:44px;" placeholder="Ej. Tratamiento de datos conforme a la politica de privacidad de la copropiedad." @bind="_formPie" @bind:after="GuardarFormCfg"></textarea>

                    <div class="pk-cfg-sec-t" style="margin-top:14px;">Campos opcionales</div>
                    <label class="pk-cfg-chk pk-cfg-chk--row"><input type="checkbox" @bind="_formTorre" @bind:after="GuardarFormCfg" />Mostrar campo "Torre / Bloque"</label>
                    <label class="pk-cfg-chk pk-cfg-chk--row"><input type="checkbox" @bind="_formCorreo" @bind:after="GuardarFormCfg" />Mostrar campo "Correo electronico"</label>
                    <label class="pk-cfg-chk pk-cfg-chk--row"><input type="checkbox" @bind="_formTelefono" @bind:after="GuardarFormCfg" />Mostrar campo "Telefono"</label>

                    <div class="pk-cfg-sec-t" style="margin-top:16px;">Orden de los campos</div>
                    <div class="pk-cfg-sec-hint">Reordena como aparecen los campos fijos en el formulario publico. Los campos propios (marcados "Publico") van despues.</div>
                    <div class="pk-fld-order">
                        @for (var i = 0; i < _formOrden.Count; i++)
                        {
                            var k = _formOrden[i];
                            var idx = i;
                            <div class="pk-fld-row">
                                <span class="pk-fld-idx">@(idx + 1)</span>
                                <span class="pk-fld-name">@LabelCampoFijo(k)@if (CampoFijoOpcional(k)) { <span class="pk-fld-opt">opcional</span> }</span>
                                <div class="pk-fld-arrows">
                                    <button type="button" class="pk-fld-arrow" disabled="@(idx == 0)" title="Subir" @onclick="() => MoverCampoFijo(k, -1)"><i class="fi fi-rr-angle-small-up"></i></button>
                                    <button type="button" class="pk-fld-arrow" disabled="@(idx == _formOrden.Count - 1)" title="Bajar" @onclick="() => MoverCampoFijo(k, 1)"><i class="fi fi-rr-angle-small-down"></i></button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="pk-cfg-sec-hint" style="margin-top:10px;">Tipo, Categoria, Unidad, Documento, Nombres y Descripcion siempre se piden. Para agregar campos propios, marca "Publico" en la pestana Campos dinamicos.</div>
                    @if (_formGuardado) { <div class="pk-cfg-msg">Cambios guardados.</div> }
                  }
                  @if (_cfgTab == "tareas")
                  {
                    <div class="pk-cfg-sec-hint">Elige el tablero del modulo Tareas donde caen las tareas creadas desde un PQR.</div>
                    <label class="pk-cfg-formlbl">Tablero destino</label>
                    <select class="pk-cfg-name" style="width:100%;" value="@(_cfgTableroTareas?.ToString() ?? "")" @onchange="GuardarTableroTareasCfg">
                        <option value="">Tablero "PQRSD" (por defecto)</option>
                        @foreach (var tb in _cfgTableros) { <option value="@tb.Id">@tb.Nombre</option> }
                    </select>
                    <div class="pk-cfg-sec-hint" style="margin-top:10px;">Las tareas ya creadas no se mueven; el cambio aplica a las nuevas.</div>
                    @if (_cfgTareasGuardado) { <div class="pk-cfg-msg">Cambios guardados.</div> }
                  }

                    @if (!string.IsNullOrEmpty(_cfgMsg)) { <div class="pk-cfg-msg">@_cfgMsg</div> }
                </div>
            </div>
        </div>
    }
</div>

<ModalHost />

