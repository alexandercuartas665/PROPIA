@using Propia.Application.Catalogos
@using Propia.Application.Integraciones
@using Propia.Domain.Entities
@using Propia.Web.Components.Shared
@implements IDisposable
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

@* Buzones de correo de la copropiedad (uno o varios). Cada buzon es una tarjeta con su estado, su actividad y una cinta
   con los asuntos de los ultimos correos que el Coordinador proceso (se refresca sola). Clic en la tarjeta = editar.
   Dos modos (modulo Buzones, 2026-11-22):
   - Modo "cuentas" (pagina /buzones, Embebido): crear, editar la cuenta (correo, contrasena, servidor), probar y eliminar.
   - Modo "lectura" (opciones de Gestion de correos): que buzones lee el Coordinador y como (temas, radicar PQRSD,
     respuesta de radicado). No crea ni borra buzones: eso vive en el modulo Buzones de correo.
   "Temas" abre el editor de la lista por copropiedad "correo.tema". Estilos cor-bz-* en css/modules/correos.css. *@

<div class="@(Embebido ? "cor-bz-page" : "cor-ov")" @onclick="ClicFondoAsync">
    <div class="cor-dlg cor-bz-dlg @(Embebido ? "cor-bz-dlg--page" : "")" @onclick:stopPropagation="true" role="@(Embebido ? "region" : "dialog")" aria-modal="@(Embebido ? "false" : "true")" aria-label="Buzones de correo">
        @* En la pagina (Embebido) la lista no repite el titulo: ya lo tiene la pagina. *@
        <div class="cor-dlg-head" hidden="@(Embebido && _edit is null)">
            @if (_edit is not null)
            {
                <button type="button" class="cor-bz-back" title="Volver a los buzones" @onclick="CancelarEdicion">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
                </button>
            }
            <span class="cor-bz-hico"><i class="fi fi-rr-envelopes"></i></span>
            <div class="cor-dlg-tit">
                <h3>@(_edit is null ? (EsLectura ? "Buzones que lee Gestión de correos" : "Buzones de correo") : (_edit.Id is null ? "Nuevo buzón" : _edit.Nombre))</h3>
                <div class="cor-dlg-meta">
                    @if (_edit is null)
                    {
                        @if (EsLectura)
                        {
                            <span>Elige qué buzones lee el Coordinador y cómo clasifica sus correos. Los lee en solo lectura (no marca leídos ni borra nada). Las cuentas se crean en <a href="/buzones">Buzones de correo</a>.</span>
                        }
                        else
                        {
                            <span>Las cuentas de correo de la copropiedad (una por área). Gestión de correos y PQRSD eligen en sus opciones cuáles usan.</span>
                        }
                    }
                    else
                    {
                        <span>Buzones › @(_edit.Id is null ? "Nuevo" : "Editar") · @(EsLectura ? "Lectura y clasificación de sus correos." : "Cuenta de Gmail (u otro servidor IMAP) con contraseña de aplicación.")</span>
                    }
                </div>
            </div>
            @if (_edit is null && EsLectura)
            {
                <button type="button" class="propia-btn-ghost cor-bz-temasbtn" @onclick="() => _gestTemas = true" title="Temas que puede asignar el Coordinador">
                    <i class="fi fi-rr-tags"></i> <span class="cor-bz-temasbtn-t">Temas</span>
                </button>
            }
            @if (!Embebido)
            {
                <button type="button" class="cor-x" title="Cerrar" @onclick="CerrarAsync">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            }
        </div>

        <div class="cor-dlg-body">
            @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small mb-0">@_msg</div> }

            @if (_buzones is null)
            {
                <div class="text-center py-4"><div class="spinner-border" style="color: var(--propia-brand);"></div></div>
            }
            else if (_edit is null)
            {
                <div class="cor-bz-grid">
                    @foreach (var b in _buzones)
                    {
                        var bz = b;
                        var st = EsLectura ? Estado(bz) : EstadoCuenta(bz);
                        <div class="cor-bz-card @st.Css" role="button" tabindex="0" @onclick="() => Editar(bz)"
                             @onkeydown="e => TeclaCard(e, bz)">
                            <div class="cor-bz-top">
                                <span class="cor-bz-ic">
                                    <i class="fi fi-rr-envelope"></i>
                                    @if (st.Css == "is-on") { <span class="cor-bz-live"></span> }
                                </span>
                                <div class="cor-bz-id">
                                    <div class="cor-bz-nom">@bz.Nombre</div>
                                    <div class="cor-bz-mail">@bz.Cuenta</div>
                                </div>
                                <span class="cor-bz-st">@st.Label</span>
                            </div>

                            <div class="cor-bz-kpis">
                                <div><b>@bz.Hoy</b><span>hoy</span></div>
                                <div><b>@bz.Total</b><span>en total</span></div>
                                <div class="@(bz.Pendientes > 0 ? "is-pend" : "")"><b>@bz.Pendientes</b><span>pendientes</span></div>
                            </div>

                            <div class="cor-bz-meta">
                                @if (bz.UltimaRevision is not null) { <span>Revisado @Hace(bz.UltimaRevision.Value)</span> }
                                else if (bz.Activo) { <span>Aún sin revisar</span> }
                                @if (bz.Activo && bz.LecturaDesde is not null) { <span>· lee desde @Fecha(bz.LecturaDesde)</span> }
                            </div>

                            @if (!EsLectura)
                            {
                                <div class="cor-bz-temas">
                                    <span class="cor-bz-uso-l">Lo usan:</span>
                                    @if (bz.Activo) { <span class="cor-bz-uso">Gestión de correos</span> }
                                    @if (bz.RespondePqrsd) { <span class="cor-bz-uso">PQRSD@(bz.PqrsdPredeterminado ? " (predeterminado)" : "")</span> }
                                    @if (!bz.Activo && !bz.RespondePqrsd) { <span class="cor-bz-todos">Ningún módulo todavía</span> }
                                </div>
                            }
                            else
                            {
                            <div class="cor-bz-temas">
                                @if (bz.Temas is null || bz.Temas.Count == 0)
                                {
                                    <span class="cor-bz-todos">Todos los temas</span>
                                }
                                else
                                {
                                    @foreach (var k in bz.Temas)
                                    {
                                        <span class="cor-chip cor-chip-t" style="@TemaStyle(k)">@TemaLabel(k)</span>
                                    }
                                }
                            </div>
                            }

                            @if (bz.Activo && !string.IsNullOrWhiteSpace(bz.UltimoError))
                            {
                                <div class="cor-bz-err" title="@bz.UltimoError">@bz.UltimoError</div>
                            }

                            <div class="cor-bz-tk" @onclick:stopPropagation="true">
                                @if (bz.Recientes.Count == 0)
                                {
                                    <span class="cor-bz-tk-vacio">
                                        @(bz.Activo ? "Esperando el primer correo" : "Sin correos procesados")
                                        @if (bz.Activo) { <span class="cor-bz-dots"><i></i><i></i><i></i></span> }
                                    </span>
                                }
                                else
                                {
                                    <div class="cor-bz-track" style="--dur:@(Math.Max(18, bz.Recientes.Count * 6))s">
                                        @for (var vuelta = 0; vuelta < 2; vuelta++)
                                        {
                                            var oculto = vuelta == 1;
                                            @foreach (var r in bz.Recientes)
                                            {
                                                <span class="cor-bz-it" aria-hidden="@(oculto ? "true" : "false")">
                                                    @if (r.Estado == EstadoCorreoRecibido.Nuevo)
                                                    {
                                                        <span class="cor-bz-dot is-wait" title="Clasificando"></span>
                                                    }
                                                    else if (r.Estado == EstadoCorreoRecibido.Error)
                                                    {
                                                        <span class="cor-bz-dot is-err" title="Error al clasificar"></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="cor-chip cor-chip-t cor-chip-xs" style="@TemaStyle(r.TemaClave)">@TemaLabel(r.TemaClave)</span>
                                                    }
                                                    <span class="cor-bz-asunto">@(string.IsNullOrWhiteSpace(r.Asunto) ? "(sin asunto)" : r.Asunto)</span>
                                                </span>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (EsLectura)
                    {
                        <a class="cor-bz-card cor-bz-add" href="/buzones">
                            <span class="cor-bz-add-ic"><i class="fi fi-rr-envelopes"></i></span>
                            <span class="cor-bz-add-t">@(_buzones.Count == 0 ? "Crear el primer buzón" : "Administrar buzones")</span>
                            <span class="cor-bz-add-s">Las cuentas se crean y editan en Configuración › Buzones de correo.</span>
                        </a>
                    }
                    else
                    {
                        <button type="button" class="cor-bz-card cor-bz-add" @onclick="Nuevo">
                            <span class="cor-bz-add-ic"><i class="fi fi-rr-plus"></i></span>
                            <span class="cor-bz-add-t">@(_buzones.Count == 0 ? "Agregar el primer buzón" : "Agregar otro buzón")</span>
                            <span class="cor-bz-add-s">Administración, contabilidad, portería... cada uno con su propia cuenta.</span>
                        </button>
                    }
                </div>

                @if (EsLectura)
                {
                <div class="cor-bz-temasbar">
                    <span class="cor-bz-temasbar-l">Temas del Coordinador</span>
                    @foreach (var t in _temas.Where(t => t.Activo))
                    {
                        <span class="cor-chip cor-chip-t" style="@TemaStyle(t.Clave)">@t.Label</span>
                    }
                    <button type="button" class="cor-bz-link" @onclick="() => _gestTemas = true">Editar temas</button>
                </div>
                }
            }
            else
            {
                <div class="cor-form cor-bz-form">
                    @if (!EsLectura)
                    {
                    @* Manual paso a paso (abierto al agregar una cuenta; plegado al editar). *@
                    <div class="cor-bz-guia @(_verGuia ? "is-open" : "")">
                        <button type="button" class="cor-bz-guia-head" aria-expanded="@(_verGuia ? "true" : "false")" @onclick="() => _verGuia = !_verGuia">
                            <span class="cor-bz-guia-ic"><i class="fi fi-rr-book-open-reader"></i></span>
                            <span class="cor-bz-guia-tit">¿Cómo obtengo la contraseña de aplicación de Gmail?</span>
                            <svg class="cor-bz-guia-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                        </button>
                        @if (_verGuia)
                        {
                            <div class="cor-bz-guia-body">
                                <p class="cor-bz-guia-intro">
                                    Es una clave de 16 letras que Google genera solo para PROPIA. No es la contraseña normal de la cuenta
                                    y se puede revocar en cualquier momento sin afectar el correo.
                                </p>
                                <ol class="cor-bz-pasos">
                                    <li>
                                        <b>Activa la verificación en dos pasos.</b>
                                        En <a href="https://myaccount.google.com/security" target="_blank" rel="noopener">myaccount.google.com › Seguridad</a>,
                                        sección "Cómo inicias sesión en Google". Sin esto no aparece la opción del paso 2.
                                    </li>
                                    <li>
                                        <b>Crea la contraseña de aplicación.</b>
                                        Entra a <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener">myaccount.google.com/apppasswords</a>,
                                        ponle un nombre (por ejemplo "PROPIA lector") y pulsa Crear.
                                    </li>
                                    <li>
                                        <b>Cópiala de inmediato.</b>
                                        Google muestra las 16 letras una sola vez (así: <code>abcd efgh ijkl mnop</code>). Con o sin espacios funciona igual.
                                    </li>
                                    <li>
                                        <b>Revisa que IMAP esté permitido.</b>
                                        En Gmail: Configuración › Ver toda la configuración › Reenvío y correo POP/IMAP › Habilitar IMAP
                                        (en cuentas nuevas ya viene activo).
                                    </li>
                                    <li>
                                        <b>Pégala aquí abajo</b>, deja el servidor <code>imap.gmail.com</code> y el puerto <code>993</code>,
                                        pulsa <b>Probar conexión</b> y luego <b>Guardar</b>.
                                    </li>
                                </ol>
                                <div class="cor-bz-guia-nota">
                                    <b>¿No aparece "Contraseñas de aplicación"?</b> Falta la verificación en dos pasos, la cuenta es de
                                    Google Workspace (dominio propio) y el administrador las bloqueó, o tiene activa la Protección avanzada.
                                </div>
                                <div class="cor-bz-guia-nota">
                                    <b>¿Correo de Microsoft (Outlook, Hotmail, Live o Microsoft 365)?</b> Por ahora no se puede conectar:
                                    desde 2024 Microsoft no acepta contraseñas de aplicación para leer el correo desde otras aplicaciones
                                    y exige iniciar sesión con la cuenta de Microsoft.
                                </div>
                            </div>
                        }
                    </div>

                    <div class="cor-fld">
                        <label>Nombre del buzón</label>
                        <input class="cor-inp" placeholder="Administración" maxlength="120" @bind="_edit.Nombre" @bind:event="oninput" />
                    </div>
                    <div class="cor-fld">
                        <label>Correo de la cuenta</label>
                        <input class="cor-inp" type="email" placeholder="copropiedad@gmail.com" autocomplete="off" @bind="_edit.Cuenta" @bind:event="oninput" />
                    </div>
                    <div class="cor-fld">
                        <label>Contraseña de aplicación</label>
                        <div class="cor-pass">
                            <input class="cor-inp" type="@(_verPass ? "text" : "password")" autocomplete="new-password" spellcheck="false"
                                   placeholder="@(_edit.TienePassword ? "Guardada (escribe otra para cambiarla)" : "16 letras que entrega Google")"
                                   @bind="_edit.Password" @bind:event="oninput" />
                            <button type="button" class="cor-pass-eye" title="@(_verPass ? "Ocultar contraseña" : "Ver contraseña")"
                                    aria-label="@(_verPass ? "Ocultar contraseña" : "Ver contraseña")" @onclick="() => _verPass = !_verPass">
                                @if (_verPass)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                }
                            </button>
                        </div>
                    </div>
                    <div class="cor-fld">
                        <label>Servidor IMAP</label>
                        <input class="cor-inp" placeholder="imap.gmail.com" @bind="_edit.Host" @bind:event="oninput" />
                    </div>
                    <div class="cor-fld">
                        <label>Puerto</label>
                        <input class="cor-inp" type="number" min="1" @bind="_edit.Port" @bind:event="oninput" />
                    </div>
                    @if (EsMicrosoft(_edit.Cuenta))
                    {
                        <div class="cor-bz-ms" role="alert">
                            <i class="fi fi-rr-exclamation"></i>
                            <span>
                                Esta es una cuenta de Microsoft. Microsoft no permite leer el correo con contraseña de aplicación
                                (exige iniciar sesión con Microsoft), así que la conexión va a fallar. Por ahora usa una cuenta de Gmail.
                            </span>
                        </div>
                    }
                    <div class="cor-help">
                        La misma contraseña de aplicación sirve para leer (Gestión de correos) y para enviar (respuestas de PQRSD).
                        Qué módulo usa cada buzón se elige en las opciones de ese módulo.
                    </div>
                    }
                    else
                    {
                    <div class="cor-bz-cuenta">
                        <i class="fi fi-rr-envelope"></i> <b>@_edit.Cuenta</b>
                        @if (!_edit.TienePassword) { <span class="cor-bz-cuenta-w">Falta la contraseña: complétala en <a href="/buzones">Buzones de correo</a>.</span> }
                    </div>
                    <div class="cor-fld cor-bz-switchfld">
                        <label>Lectura</label>
                        <label class="cor-switch" title="Leer este buzón cada 10 minutos">
                            <input type="checkbox" checked="@_edit.Activo" @onchange="e => _edit!.Activo = (bool)(e.Value ?? false)" />
                            <span class="cor-switch-track"></span>
                            @(_edit.Activo ? "Leer buzón" : "Pausado")
                        </label>
                    </div>

                    <div class="cor-fld cor-bz-temasfld">
                        <label>Temas que atiende</label>
                        <div class="cor-bz-ck">
                            <label class="cor-bz-ckit @(_edit.Todos ? "on" : "")">
                                <input type="checkbox" checked="@_edit.Todos" @onchange="e => _edit!.Todos = (bool)(e.Value ?? false)" />
                                Todos
                            </label>
                            @foreach (var t in TemasSeleccionables)
                            {
                                var tema = t;
                                var on = !_edit.Todos && _edit.Temas.Contains(tema.Clave);
                                <label class="cor-bz-ckit @(on ? "on" : "") @(_edit.Todos ? "is-dis" : "")" style="@TemaStyle(tema.Clave)">
                                    <input type="checkbox" checked="@on" disabled="@_edit.Todos" @onchange="e => MarcarTema(tema.Clave, (bool)(e.Value ?? false))" />
                                    @tema.Label
                                </label>
                            }
                        </div>
                        <span class="cor-help">Otro e Irrelevante aplican siempre. El Coordinador solo escoge entre los temas marcados.</span>
                    </div>

                    @if (_edit.Todos || _edit.Temas.Contains(TemasCorreoBase.Pqrsd))
                    {
                        <div class="cor-fld">
                            <label>Radicar PQRSD solo</label>
                            <select class="cor-inp" @bind="_edit.Umbral">
                                <option value="0">Nunca: siempre confirma una persona</option>
                                <option value="0.95">Con confianza de 95% o más</option>
                                <option value="0.90">Con confianza de 90% o más</option>
                                <option value="0.80">Con confianza de 80% o más</option>
                                <option value="0.70">Con confianza de 70% o más</option>
                            </select>
                        </div>
                        <div class="cor-help cor-bz-pqhelp">
                            Si el Coordinador y el Radicador de PQRSD están así de seguros, la PQRSD se radica sola (medio Correo, plazo desde la
                            fecha del correo). Si no, queda en la bandeja con el formulario listo para confirmar.
                        </div>
                        <div class="cor-fld">
                            <label>Responder con el número de radicado</label>
                            <select class="cor-inp" @bind="_edit.Respuesta">
                                <option value="">Sí, con la plantilla "@RadicadorPqrsdCorreoAgente.NombrePlantillaAcuse"</option>
                                @foreach (var pl in _plantillasPqrsd)
                                {
                                    <option value="@pl.Id">Sí, con la plantilla "@pl.Nombre"</option>
                                }
                                <option value="no">No responder desde este buzón</option>
                            </select>
                        </div>
                        <div class="cor-help cor-bz-pqhelp">
                            Al radicar, se le responde a quien escribió desde esta misma cuenta y en el mismo hilo. La plantilla se edita en
                            Configuración &gt; Plantillas de documentos (categoría PQRSD). Si la respuesta no sale, se envía la confirmación de la plataforma.
                        </div>
                    }

                    <div class="cor-help">
                        Al activar la lectura solo se toman los correos que lleguen desde ese momento, no el histórico.
                    </div>
                    }
                </div>
            }
        </div>

        @if (_edit is not null)
        {
            <div class="cor-dlg-foot">
                @if (!EsLectura && _edit.Id is Guid idEdit)
                {
                    <button type="button" class="propia-btn-ghost cor-bz-del" disabled="@_busy" @onclick="() => EliminarAsync(idEdit)">
                        @(_confirmarEliminar ? "¿Eliminar? Clic de nuevo" : "Eliminar")
                    </button>
                }
                <span class="cor-bz-spacer"></span>
                @if (!EsLectura)
                {
                    <button type="button" class="propia-btn-ghost" disabled="@(_busy || _probando)" @onclick="ProbarAsync">
                        @if (_probando) { <span class="spinner-border spinner-border-sm"></span> } Probar conexión
                    </button>
                }
                <button type="button" class="propia-btn-ghost" disabled="@_busy" @onclick="CancelarEdicion">Cancelar</button>
                <button type="button" class="propia-btn-brand" disabled="@_busy" @onclick="GuardarAsync">
                    @if (_busy) { <span class="spinner-border spinner-border-sm"></span> } Guardar
                </button>
            </div>
        }
    </div>
</div>

@if (_gestTemas)
{
    <GestionarOpcionesListaModal Lista="@TemasCorreoBase.Lista" Titulo="Temas del Coordinador de correo" Jwt="@Jwt"
                                 Guardado="CargarTemasAsync" Cerrado="CerrarTemasAsync" />
}

@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public EventCallback Cerrado { get; set; }
    /// <summary>Se invoca al cerrar si hubo cambios (buzones o temas), para que la bandeja recargue.</summary>
    [Parameter] public EventCallback Cambio { get; set; }
    /// <summary>"cuentas" (modulo Buzones de correo) o "lectura" (opciones de Gestion de correos).</summary>
    [Parameter] public string Modo { get; set; } = "lectura";
    /// <summary>Se pinta dentro de la pagina (sin velo ni boton cerrar).</summary>
    [Parameter] public bool Embebido { get; set; }
    private bool EsLectura => Modo != "cuentas";

    private List<BuzonCorreoDto>? _buzones;
    private List<OpcionEfectivaDto> _temas = new();
    // Plantillas de PQRSD que puede usar la respuesta de radicado (sin la predeterminada, que va como primera opcion).
    private List<Propia.Application.Plantillas.PlantillaDocumentoDto> _plantillasPqrsd = new();
    private EdicionBuzon? _edit;
    private bool _busy, _probando, _gestTemas, _confirmarEliminar, _huboCambios;
    private bool _verGuia, _verPass;

    // Dominios personales de Microsoft: no admiten IMAP con contrasena de aplicacion (exigen OAuth desde 2024).
    // Los de Microsoft 365 con dominio propio no se pueden detectar por el dominio: lo explica el manual.
    private static readonly HashSet<string> DominiosMicrosoft = new(StringComparer.OrdinalIgnoreCase)
    {
        "outlook.com", "outlook.es", "hotmail.com", "hotmail.es", "hotmail.co", "live.com", "live.com.mx", "msn.com",
    };
    private static bool EsMicrosoft(string? cuenta)
    {
        var at = (cuenta ?? "").Trim().LastIndexOf('@');
        return at > 0 && DominiosMicrosoft.Contains(cuenta!.Trim()[(at + 1)..]);
    }
    private string? _msg;
    private string _msgClass = "alert-info";
    private System.Threading.Timer? _timer;
    private bool _refrescando;

    private sealed class EdicionBuzon
    {
        public Guid? Id;
        public string Nombre = "";
        public string Cuenta = "";
        public string? Password;
        public bool TienePassword;
        public string Host = "imap.gmail.com";
        public int Port = 993;
        public bool Activo = true;
        public bool Todos = true;
        public HashSet<string> Temas = new(StringComparer.OrdinalIgnoreCase);
        /// <summary>PQRSD por correo: confianza minima para radicar solo ("0" = nunca).</summary>
        public string Umbral = "0.90";
        /// <summary>Respuesta de radicado: "" = plantilla predeterminada, "no" = no responder, o el id de otra plantilla.</summary>
        public string Respuesta = "";
    }

    private IEnumerable<OpcionEfectivaDto> TemasSeleccionables => _temas.Where(t => t.Activo
        && !CoordinadorCorreoAgente.TemasSiempre.Contains(t.Clave, StringComparer.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarBuzonesAsync(), CargarTemasAsync(), CargarPlantillasAsync());
        // La cinta de asuntos y los contadores se refrescan solos mientras el modal esta abierto.
        _timer = new System.Threading.Timer(_ => _ = InvokeAsync(RefrescarAsync), null, 8000, 8000);
    }

    private async Task RefrescarAsync()
    {
        if (_edit is not null || _busy || _refrescando || _gestTemas) return;
        _refrescando = true;
        try { await CargarBuzonesAsync(); StateHasChanged(); }
        catch { /* el siguiente ciclo lo reintenta */ }
        finally { _refrescando = false; }
    }

    public void Dispose() => _timer?.Dispose();

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    /// <summary>Envia la peticion y, si el token vencio, lo renueva y reintenta una vez (patron SessionHelper).</summary>
    private async Task<HttpResponseMessage?> EnviarAsync(Func<HttpClient, Task<HttpResponseMessage>> enviar)
    {
        var resp = await enviar(Auth());
        if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            var nuevo = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
            if (string.IsNullOrEmpty(nuevo)) return null;
            Jwt = nuevo;
            resp = await enviar(Auth());
        }
        return resp;
    }

    private async Task CargarBuzonesAsync()
    {
        try
        {
            var r = await EnviarAsync(h => h.GetAsync("/api/correos-recibidos/buzones"));
            if (r is null || !r.IsSuccessStatusCode) return;
            // Siempre abre en la vista de buzones (tarjetas + "Agregar"): asi se entiende que pueden ser varios.
            _buzones = await r.Content.ReadFromJsonAsync<List<BuzonCorreoDto>>() ?? new();
        }
        catch (Exception ex) { Aviso("No se pudieron cargar los buzones: " + ex.Message, false); _buzones ??= new(); }
    }

    private async Task CargarTemasAsync()
    {
        try
        {
            var r = await EnviarAsync(h => h.GetAsync($"/api/campos/opciones?lista={Uri.EscapeDataString(TemasCorreoBase.Lista)}&incluirOcultas=true"));
            if (r is null || !r.IsSuccessStatusCode) return;
            _temas = await r.Content.ReadFromJsonAsync<List<OpcionEfectivaDto>>() ?? new();
        }
        catch { /* sin temas: las tarjetas muestran la clave */ }
    }

    private async Task CargarPlantillasAsync()
    {
        try
        {
            var r = await EnviarAsync(h => h.GetAsync($"/api/plantillas?categoria={Propia.Application.Plantillas.PlantillasCatalogo.Pqrsd}"));
            if (r is null || !r.IsSuccessStatusCode) return;
            _plantillasPqrsd = (await r.Content.ReadFromJsonAsync<List<Propia.Application.Plantillas.PlantillaDocumentoDto>>() ?? new())
                .Where(p => !string.Equals(p.Nombre, RadicadorPqrsdCorreoAgente.NombrePlantillaAcuse, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        catch { /* sin plantillas: queda la predeterminada */ }
    }

    private async Task CerrarTemasAsync()
    {
        _gestTemas = false;
        _huboCambios = true;
        await CargarTemasAsync();
    }

    private void Nuevo()
    {
        _msg = null;
        _confirmarEliminar = false;
        _verGuia = true;    // al agregar una cuenta el manual sale abierto
        _verPass = false;
        _edit = new EdicionBuzon { Nombre = (_buzones?.Count ?? 0) == 0 ? "Administración" : "" };
    }

    private void Editar(BuzonCorreoDto b)
    {
        _msg = null;
        _confirmarEliminar = false;
        _verGuia = false;   // al editar queda plegado (se abre con un clic)
        _verPass = false;
        _edit = new EdicionBuzon
        {
            Id = b.Id, Nombre = b.Nombre, Cuenta = b.Cuenta, TienePassword = b.TienePassword, Host = b.ImapHost,
            Port = b.ImapPort, Activo = b.Activo, Todos = b.Temas is null || b.Temas.Count == 0,
            Temas = new HashSet<string>(b.Temas ?? (IReadOnlyList<string>)Array.Empty<string>(), StringComparer.OrdinalIgnoreCase),
            Umbral = b.UmbralAutoPqrsd is decimal u ? u.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "0",
            // Una plantilla elegida que ya no esta en la lista (borrada o la predeterminada) se muestra como la predeterminada.
            Respuesta = !b.ResponderRadicado ? "no"
                : b.PlantillaAcuseId is Guid pl && _plantillasPqrsd.Any(x => x.Id == pl) ? pl.ToString() : "",
        };
    }

    private void TeclaCard(KeyboardEventArgs e, BuzonCorreoDto b)
    {
        if (e.Key is "Enter" or " ") Editar(b);
    }

    private void CancelarEdicion()
    {
        _msg = null;
        _confirmarEliminar = false;
        _edit = null;   // vuelve a la lista de buzones (no cierra el modal)
    }

    private void MarcarTema(string clave, bool on)
    {
        if (_edit is null) return;
        if (on) _edit.Temas.Add(clave); else _edit.Temas.Remove(clave);
    }

    private async Task GuardarAsync()
    {
        if (_edit is null) return;
        _busy = true; _msg = null;
        try
        {
            var todos = _edit.Todos || _edit.Temas.Count == 0;
            // PUT es MERGE: cada modo manda solo lo suyo (la cuenta en "cuentas"; la lectura en "lectura").
            var req = EsLectura
                ? new GuardarBuzonRequest(
                    Activo: _edit.Activo,
                    Temas: todos ? null : _edit.Temas.ToList(), TodosLosTemas: todos,
                    UmbralAutoPqrsd: decimal.TryParse(_edit.Umbral, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var um) ? um : 0m,
                    ResponderRadicado: _edit.Respuesta != "no",
                    PlantillaAcuseId: Guid.TryParse(_edit.Respuesta, out var pl) ? pl : Guid.Empty)
                : new GuardarBuzonRequest(
                    Nombre: _edit.Nombre, Cuenta: _edit.Cuenta ?? "",
                    Password: string.IsNullOrWhiteSpace(_edit.Password) ? null : _edit.Password,
                    ImapHost: _edit.Host, ImapPort: _edit.Port);
            var id = _edit.Id;
            var resp = await EnviarAsync(h => id is Guid g
                ? h.PutAsJsonAsync($"/api/correos-recibidos/buzones/{g}", req)
                : h.PostAsJsonAsync("/api/correos-recibidos/buzones", req));
            if (resp is null) return;
            if (!resp.IsSuccessStatusCode) { Aviso(await ErrorAsync(resp), false); return; }
            _huboCambios = true;
            _edit = null;
            await CargarBuzonesAsync();
            Aviso(id is null ? "Buzón agregado." : "Buzón guardado.", true);
        }
        catch (Exception ex) { Aviso("No se pudo guardar: " + ex.Message, false); }
        finally { _busy = false; }
    }

    private async Task ProbarAsync()
    {
        if (_edit is null) return;
        _probando = true; _msg = null;
        try
        {
            var req = new ProbarBuzonRequest(_edit.Id, _edit.Cuenta, string.IsNullOrWhiteSpace(_edit.Password) ? null : _edit.Password,
                _edit.Host, _edit.Port);
            var resp = await EnviarAsync(h => h.PostAsJsonAsync("/api/correos-recibidos/buzones/probar", req));
            if (resp is null) return;
            if (resp.IsSuccessStatusCode) Aviso("Conexión correcta: el Coordinador puede leer este buzón.", true);
            else Aviso(await ErrorAsync(resp), false);
        }
        catch (Exception ex) { Aviso("No se pudo probar: " + ex.Message, false); }
        finally { _probando = false; }
    }

    private async Task EliminarAsync(Guid id)
    {
        if (!_confirmarEliminar) { _confirmarEliminar = true; return; }
        _busy = true; _msg = null;
        try
        {
            var resp = await EnviarAsync(h => h.DeleteAsync($"/api/correos-recibidos/buzones/{id}"));
            if (resp is null) return;
            if (!resp.IsSuccessStatusCode) { Aviso(await ErrorAsync(resp), false); return; }
            _huboCambios = true;
            _edit = null;
            _confirmarEliminar = false;
            await CargarBuzonesAsync();
            Aviso("Buzón eliminado. Sus correos siguen en la bandeja.", true);
        }
        catch (Exception ex) { Aviso("No se pudo eliminar: " + ex.Message, false); }
        finally { _busy = false; }
    }

    // En la pagina (Embebido) no hay velo: un clic fuera de la tarjeta no cierra nada.
    private Task ClicFondoAsync() => Embebido ? Task.CompletedTask : CerrarAsync();

    private async Task CerrarAsync()
    {
        _timer?.Dispose();
        _timer = null;
        if (_huboCambios) await Cambio.InvokeAsync();
        await Cerrado.InvokeAsync();
    }

    private sealed record EstadoBuzon(string Label, string Css);

    // Modo cuentas: estado de la CUENTA (no de la lectura, que decide Gestion de correos).
    private static EstadoBuzon EstadoCuenta(BuzonCorreoDto b)
    {
        if (!b.TienePassword) return new("Falta contraseña", "is-warn");
        if (b.Activo && !string.IsNullOrWhiteSpace(b.UltimoError)) return new("Con error", "is-err");
        return b.Activo || b.RespondePqrsd ? new("En uso", "is-on") : new("Lista", "is-off");
    }

    private static EstadoBuzon Estado(BuzonCorreoDto b)
    {
        if (!b.TienePassword) return new("Falta contraseña", "is-warn");
        if (!b.Activo) return new("Pausado", "is-off");
        return string.IsNullOrWhiteSpace(b.UltimoError) ? new("Leyendo", "is-on") : new("Con error", "is-err");
    }

    private OpcionEfectivaDto? Tema(string? clave)
        => clave is null ? null : _temas.FirstOrDefault(t => string.Equals(t.Clave, clave, StringComparison.OrdinalIgnoreCase));

    private string TemaLabel(string? clave) => Tema(clave)?.Label ?? (string.IsNullOrWhiteSpace(clave) ? "Sin clasificar" : clave);

    // Color de la opcion (dato de la lista por copropiedad) como variable CSS; el chip lo mezcla con el fondo.
    private string TemaStyle(string? clave)
    {
        var c = Tema(clave)?.Color;
        return string.IsNullOrWhiteSpace(c) ? "" : $"--tc:{c}";
    }

    private static string Fecha(DateTimeOffset? d)
        => d is null ? "—" : d.Value.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm");

    private static string Hace(DateTimeOffset d)
    {
        var s = DateTimeOffset.UtcNow - d;
        if (s.TotalSeconds < 60) return "hace un momento";
        if (s.TotalMinutes < 60) return $"hace {(int)s.TotalMinutes} min";
        if (s.TotalHours < 24) return $"hace {(int)s.TotalHours} h";
        return "el " + Fecha(d);
    }

    private static async Task<string> ErrorAsync(HttpResponseMessage resp)
    {
        if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden) return "No tienes permiso para esta acción en Comunicaciones.";
        var cuerpo = await resp.Content.ReadAsStringAsync();
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(cuerpo);
            if (doc.RootElement.TryGetProperty("error", out var e) && e.GetString() is { Length: > 0 } m) return m;
        }
        catch { }
        return string.IsNullOrWhiteSpace(cuerpo) ? "La operación no se pudo completar." : cuerpo;
    }

    private void Aviso(string msg, bool ok) { _msg = msg; _msgClass = ok ? "alert-success" : "alert-danger"; }
}
