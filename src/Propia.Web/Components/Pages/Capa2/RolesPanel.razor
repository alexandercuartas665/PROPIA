@using Propia.Application.UsuariosAccesos
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

@* Bandeja de Roles y Permisos (spec 2.5 v2.0): el modal paso a MODULO/bandeja propio, separado de
   Usuarios (3 l.63/65; 11 l.311). Tabla con Rol/Categoria/Base/Usuarios; la matriz de permisos vive
   DENTRO de la Vista Ficha del rol (MP-01). Filas de modulo dinamicas (MP-03). La matriz por
   copropiedad usa el overlay rol_permisos_tenant ya cableado en RolesService (RP-04). MP-04/MP-06:
   la matriz muestra SOLO las acciones validas por modulo (ver AccionesPorModulo); el resto = "." . *@

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color:var(--propia-brand)"></div></div>
}
else if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="usr-wrap">
    <div class="mod-pagehead">
        <div>
            <h1 class="mod-pagetitle">Roles y Permisos</h1>
            <p class="mod-pagesub">Configura que puede ver y hacer cada rol. Roles base protegidos + personalizados. La matriz se edita en la ficha del rol.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="usr-btn-ghost" @onclick='() => Nav.NavigateTo("/usuarios")'>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Usuarios
            </button>
        </div>
    </div>

    @if (_msg is not null)
    {
        <div class="alert @_msgClass" @onclick="() => _msg = null" style="cursor:pointer">@_msg</div>
    }

    @if (_roles is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color:var(--propia-brand)"></div></div>
    }
    else if (_rolEditando is not null && _detalleEdit is not null)
    {
        @* ================= VISTA FICHA: matriz de permisos del rol ================= *@
        <div class="usr-modal-bg" @onclick="VolverALista">
            <div class="usr-modal usr-modal-roles" @onclick:stopPropagation="true">
                <div class="usr-modal-head">
                    <div class="usr-modal-ico">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
                    </div>
                    <div style="flex:1;min-width:0">
                        <div class="usr-modal-title">@_detalleEdit.Nombre</div>
                        <div class="usr-modal-subtitle">Rol y matriz de permisos</div>
                    </div>
                    <button class="usr-modal-x" @onclick="VolverALista" title="Cerrar">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                    </button>
                </div>
                <div class="usr-modal-body">
                    <div class="rol-ficha-chips">
                        <span class="rol-cat" style="background:@ColorCategoriaSoft(_detalleEdit.Categoria);color:@ColorCategoria(_detalleEdit.Categoria)">
                            <span class="rol-cat-dot" style="background:@ColorCategoria(_detalleEdit.Categoria)"></span>@LabelCategoria(_detalleEdit.Categoria)
                        </span>
                        @if (_detalleEdit.Tipo == TipoRol.Base) { <span class="rol-chip-info">Rol base . protegido, no se renombra</span> }
                        <span class="rol-chip-mut">@_detalleEdit.CantidadUsuariosActivos usuarios asignados</span>
                    </div>

            <div class="usr-rolcfg">
                <div class="usr-rolcfg-row">
                    <div style="flex:1;min-width:0">
                        <label class="usr-label">Nombre del rol</label>
                        <input class="usr-input" @bind="_edNombre" disabled="@(_detalleEdit.Tipo == TipoRol.Base)" />
                        @if (_detalleEdit.Tipo == TipoRol.Base) { <div class="usr-hint">Los roles base no se renombran (RN-03).</div> }
                    </div>
                    <div style="width:220px;flex-shrink:0">
                        <label class="usr-label">Categoria</label>
                        <select class="usr-select" @bind="_edCategoria" disabled="@(_detalleEdit.TenantId is null)">
                            @foreach (var c in Enum.GetValues<CategoriaRol>())
                            {
                                <option value="@c">@LabelCategoria(c)</option>
                            }
                        </select>
                        @if (_detalleEdit.TenantId is null) { <div class="usr-hint">Los roles base tienen categoria fija.</div> }
                    </div>
                    <button class="usr-rowbtn" style="align-self:flex-end" @onclick="GuardarConfigRol" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar")</button>
                </div>
                <div class="usr-rolcfg-seed">
                    <label class="usr-label">Semilla en la Distribucion . al asignar una persona a estas facetas se crea su usuario con este rol</label>
                    <div class="usr-facetas">
                        @foreach (var f in _facetasCat)
                        {
                            var fv = f.Val; var on = _edFacetas.Contains(fv);
                            <button type="button" class="usr-faceta @(on ? "on" : "")" @onclick="() => ToggleFaceta(fv)">@f.Label</button>
                        }
                    </div>
                    <label class="usr-seedchk">
                        <input type="checkbox" @bind="_edSoloDir" />
                        <span>Ocultar y permitir solo en Directorio <em>(no aparecen en la lista de Usuarios)</em></span>
                    </label>
                    <div class="usr-hint">Recuerda pulsar <b>Guardar</b> para aplicar la siembra.</div>
                </div>
            </div>

            <div class="usr-matrix">
                <div class="usr-matrix-head">
                    <div style="flex:1;font-size:11px;letter-spacing:.4px;font-weight:700;color:var(--propia-text-faint)">MODULO</div>
                    @foreach (var a in Enum.GetValues<AccionPermiso>())
                    {
                        <div class="usr-matrix-col">@a.ToString().ToUpper()</div>
                    }
                    <div style="width:140px;flex-shrink:0;text-align:center;font-size:11px;letter-spacing:.3px;font-weight:700;color:var(--propia-text-faint)">NIVEL DE DATO</div>
                </div>
                @* Filas de modulo DINAMICAS (MP-03): iteran los modulos activos; un modulo nuevo aparece solo. *@
                @foreach (var mod in ModulosActivos)
                {
                    var modCodigo = mod;
                    var nivelActual = _detalleEdit.Permisos.Where(p => p.ModuloCodigo == mod).Select(p => p.NivelDato).DefaultIfEmpty(NivelDato.SinAcceso).Max();
                    <div class="usr-matrix-row">
                        <div class="usr-matrix-mod">@LabelModulo(mod)</div>
                        @foreach (var accion in Enum.GetValues<AccionPermiso>())
                        {
                            @* MP-04/MP-06: solo las acciones validas del modulo son editables; el resto = "." (no aplica). *@
                            if (!AccionAplica(mod, accion))
                            {
                                <div class="usr-cell"><span class="usr-cell-na" title="No aplica en este modulo">&middot;</span></div>
                            }
                            else
                            {
                                var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == mod && p.Accion == accion);
                                var hab = celda?.Habilitado ?? false;
                                var modC = mod; var accC = accion;
                                <div class="usr-cell">
                                    <button class="usr-chk @(hab ? "on" : "")" @onclick="() => TogglePermiso(modC, accC, !hab)">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5 9-11"/></svg>
                                    </button>
                                </div>
                            }
                        }
                        <div style="width:140px;flex-shrink:0;display:flex;justify-content:center">
                            <select class="usr-select" style="font-size:12px;padding:5px 8px" @onchange="(e) => CambiarNivel(modCodigo, Enum.Parse<NivelDato>(e.Value!.ToString()!))">
                                <option value="@NivelDato.SinAcceso" selected="@(nivelActual == NivelDato.SinAcceso)">Sin acceso</option>
                                <option value="@NivelDato.Propio" selected="@(nivelActual == NivelDato.Propio)">Solo propio</option>
                                <option value="@NivelDato.Copropiedad" selected="@(nivelActual == NivelDato.Copropiedad)">Toda la PH</option>
                            </select>
                        </div>
                    </div>
                }
            </div>
                    <div class="usr-hint mt-3">Los cambios de la matriz se guardan al instante y aplican SOLO a esta copropiedad (RP-04). "Administrador conserva acceso a Usuarios y Accesos" se aplica automaticamente.</div>
                </div>
            </div>
        </div>
    }
    else
    {
        @* ================= BANDEJA (tabla) ================= *@
        @* Barra de herramientas (objetivo visual Maqueta1 roles.html): Filtros + Buscar ... Ordenar + Agrupar. *@
        <div class="rol-toolbar">
            <button class="rol-tb-btn @(_filtrosOpen || _filtroCat is not null ? "on" : "")" @onclick="() => _filtrosOpen = !_filtrosOpen" title="Filtrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
                Filtros
            </button>
            <div class="rol-tb-search">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input placeholder="Buscar rol..." @bind="_busca" @bind:event="oninput" />
            </div>
            <div class="rol-tb-spacer"></div>
            <button class="rol-tb-btn @(!_ordenAsc ? "on" : "")" @onclick="() => _ordenAsc = !_ordenAsc" title="Ordenar por nombre">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h12M3 12h8M3 18h5M17 7v12M17 19l3-3M17 19l-3-3"/></svg>
                Ordenar
            </button>
            <button class="rol-tb-btn @(_agruparCat ? "on" : "")" @onclick="() => _agruparCat = !_agruparCat" title="Agrupar por categoria">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                Agrupar
            </button>
        </div>
        @if (_filtrosOpen)
        {
            <div class="rol-toolbar" style="margin-top:-6px">
                <span style="font-size:12.5px;color:var(--propia-text-muted)">Categoria:</span>
                <button class="rol-tb-btn @(_filtroCat is null ? "on" : "")" @onclick="() => _filtroCat = null">Todas</button>
                @foreach (var c in Enum.GetValues<CategoriaRol>())
                {
                    var cc = c;
                    <button class="rol-tb-btn @(_filtroCat == cc ? "on" : "")" @onclick="() => _filtroCat = cc">@LabelCategoria(cc)</button>
                }
            </div>
        }
        @* Barra de acciones masivas: aparece al seleccionar filas con el checkbox. Activar/Desactivar aplica
           solo a roles extendidos; Eliminar solo a personalizados (los base quedan protegidos). *@
        @if (_sel.Count > 0)
        {
            <div class="rol-selbar">
                <span class="rol-selbar-n">@_sel.Count seleccionado@(_sel.Count == 1 ? "" : "s")</span>
                <div class="rol-tb-spacer"></div>
                <button class="rol-tb-btn" @onclick="() => BulkActivarAsync(true)" disabled="@_bulkBusy">Activar</button>
                <button class="rol-tb-btn" @onclick="() => BulkActivarAsync(false)" disabled="@_bulkBusy">Desactivar</button>
                <button class="usr-selbar-del" @onclick="() => _confirmBulkDel = true" disabled="@(_bulkBusy || SelEliminables == 0)">
                    Eliminar@(SelEliminables > 0 ? $" ({SelEliminables})" : "")
                </button>
                <button class="rol-tb-btn" @onclick="LimpiarSel" disabled="@_bulkBusy">Cancelar</button>
            </div>
        }
        <div class="rol-tablebox">
            <div class="rol-scroll">
            <table class="tbl">
                <colgroup>
                    <col style="width:38px" /><col style="width:34px" />
                    @foreach (var col in ColsRoles) { <col style="@AnchoCol(col.Clave)" /> }
                    <col style="width:52px" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="tbl-sel"><input type="checkbox" class="rol-chk-in" title="Seleccionar todo" checked="@TodosSel" @onchange="ToggleSelAll" /></th>
                        <th class="tbl-exp"></th>
                        @foreach (var col in ColsRoles)
                        {
                            var ck = col.Clave;
                            <th class="tbl-th--menu @(ck == "usuarios" ? "rol-th-num" : "")" data-clave="@ck" @onmousedown="e => IniciarReorder(e, ck)">
                                <span class="tbl-th-lbl">@col.Label</span><span class="tbl-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResize(e, ck)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResize(ck)" @ondblclick:stopPropagation="true"></span>
                            </th>
                        }
                        <th class="rol-th-acc"></th>
                    </tr>
                </thead>
                <tbody>
                    @{ CategoriaRol? _lastCat = null; }
                    @foreach (var r in RolesVista())
                    {
                        var rr = r;
                        if (_agruparCat && r.Categoria != _lastCat)
                        {
                            _lastCat = r.Categoria;
                            <tr class="rol-grouprow"><td colspan="7" class="rol-grouphdr">@LabelCategoria(r.Categoria)</td></tr>
                        }
                        <tr class="rol-tr @(rr.Activo ? "" : "rol-tr-off")" @onclick="() => EditarRol(rr.Id)" @oncontextmenu="e => AbrirCtxRol(e, rr)" @oncontextmenu:preventDefault="true">
                            <td class="tbl-sel">
                                <input type="checkbox" class="rol-chk-in" checked="@_sel.Contains(rr.Id)" disabled="@(!PuedeSeleccionar(rr))"
                                       @onclick:stopPropagation="true" @onchange="e => ToggleSel(rr.Id, (bool)(e.Value ?? false))" />
                            </td>
                            <td class="tbl-exp">
                                <span class="tbl-exp-btn" title="Abrir la ficha">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                </span>
                            </td>
                            @foreach (var col in ColsRoles)
                            {
                                switch (col.Clave)
                                {
                                    case "nombre":
                                        <td class="rol-td-nom">
                                            <div class="rol-nom">@r.Nombre</div>
                                            @if (!string.IsNullOrWhiteSpace(r.Descripcion)) { <div class="rol-desc">@r.Descripcion</div> }
                                        </td>
                                        break;
                                    case "categoria":
                                        <td>
                                            <span class="rol-cat">
                                                <span class="rol-cat-dot" style="background:@ColorCategoria(r.Categoria)"></span>@LabelCategoria(r.Categoria)
                                            </span>
                                        </td>
                                        break;
                                    case "base":
                                        <td>
                                            @if (r.Tipo == TipoRol.Base) { <span class="propia-badge propia-badge--neutral">Sistema</span> }
                                            else if (r.Tipo == TipoRol.Extendido) { <span class="rol-badge rol-badge-ext">Extendido@(r.Activo ? "" : " . inactivo")</span> }
                                            else { <span class="rol-badge">Personalizado</span> }
                                        </td>
                                        break;
                                    case "usuarios":
                                        <td class="rol-td-num">@r.CantidadUsuariosActivos</td>
                                        break;
                                }
                            }
                            @* Acciones en el MENU CONTEXTUAL de la fila (spec P4/RP-02: nunca como columna).
                               Se abre con el boton kebber o con clic derecho sobre la fila. *@
                            <td class="rol-td-acc" @onclick:stopPropagation="true">
                                <button class="rol-kebab" title="Acciones del rol" @onclick="e => AbrirCtxRol(e, rr)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (_creandoRol)
                    {
                        <tr class="rol-tr rol-newrow">
                            <td class="tbl-sel"></td>
                            <td class="tbl-exp"></td>
                            @foreach (var col in ColsRoles)
                            {
                                switch (col.Clave)
                                {
                                    case "nombre":
                                        <td class="rol-td-nom">
                                            <input class="rol-inp" placeholder="Nombre del nuevo rol..." @bind="_nuevoNombre" @bind:event="oninput" />
                                        </td>
                                        break;
                                    case "categoria":
                                        <td>
                                            <select class="rol-inp" @bind="_nuevoCategoria">
                                                @foreach (var c in Enum.GetValues<CategoriaRol>()) { <option value="@c">@LabelCategoria(c)</option> }
                                            </select>
                                        </td>
                                        break;
                                    case "base":
                                        <td>
                                            <select class="rol-inp" @bind="_copiarDe">
                                                <option value="">(Empezar vacio)</option>
                                                @foreach (var r in _roles.Where(r => r.Tipo != TipoRol.Sistema)) { <option value="@r.Id">Copiar de @r.Nombre</option> }
                                            </select>
                                        </td>
                                        break;
                                    case "usuarios":
                                        <td></td>
                                        break;
                                }
                            }
                            <td class="rol-td-acc">
                                <button class="rol-actbtn rol-actbtn-add" @onclick="CrearRol" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoNombre))">Crear</button>
                                <button class="rol-actbtn" @onclick="() => { _creandoRol = false; _nuevoNombre = string.Empty; _copiarDe = string.Empty; }">Cancelar</button>
                            </td>
                        </tr>
                    }
                    @if (!_creandoRol)
                    {
                        @* Boton de alta al canon (Unidades): fila CTA DENTRO de la tabla, con celdas vacias
                           tbl-sel + tbl-exp, para que el boton caiga indentado bajo la 1a columna de datos
                           (ROL), no pegado al margen. *@
                        <tr class="rol-tr rol-cta-row" id="rol-cta-row">
                            <td class="tbl-sel"></td>
                            <td class="tbl-exp"></td>
                            <td colspan="5">
                                <button type="button" class="row-add--sm" @onclick="() => { _creandoRol = true; _nuevoCategoria = CategoriaRol.Administrativo; }">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                                    Agregar registro
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @* FAB flotante (patron Unidades): aparece al desplazar cuando la fila/boton de alta no se ve. *@
            <button type="button" class="tbl-fab" hidden="@(_ctaVisible || _creandoRol)" @onclick="FabNuevoRol" title="Agregar rol">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                Agregar registro
            </button>
            <div class="tbl-foot"><strong>@_roles.Count(r => r.Tipo != TipoRol.Sistema)</strong>&nbsp;roles</div>
        </div>
    }

    <TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />

    @* RL-1: confirmacion de borrado de rol personalizado (reusa .usr-confirm global). *@
    @if (_confirmDelRol is { } rolDel)
    {
        <div class="usr-cfg-back" @onclick="() => { if (!_eliminandoRol) _confirmDelRol = null; }">
            <div class="usr-confirm" @onclick:stopPropagation="true">
                <div class="usr-confirm-t">Eliminar rol</div>
                <div class="usr-confirm-s">Se eliminara el rol "@rolDel.Nombre". Los usuarios con este rol quedaran sin el. Esta accion no se puede deshacer.</div>
                <div class="usr-confirm-acts">
                    <button type="button" class="usr-btn-ghost" @onclick="() => _confirmDelRol = null" disabled="@_eliminandoRol">Cancelar</button>
                    <button type="button" class="usr-selbar-del" @onclick="EliminarRolConfirmadoAsync" disabled="@_eliminandoRol">@(_eliminandoRol ? "Eliminando..." : "Si, eliminar")</button>
                </div>
            </div>
        </div>
    }

    @* Confirmacion de borrado MASIVO: solo elimina los personalizados de la seleccion. *@
    @if (_confirmBulkDel)
    {
        <div class="usr-cfg-back" @onclick="() => { if (!_bulkBusy) _confirmBulkDel = false; }">
            <div class="usr-confirm" @onclick:stopPropagation="true">
                <div class="usr-confirm-t">Eliminar @SelEliminables rol@(SelEliminables == 1 ? "" : "es") personalizado@(SelEliminables == 1 ? "" : "s")</div>
                <div class="usr-confirm-s">Solo se eliminan los roles personalizados de la seleccion (@SelEliminables de @_sel.Count). Los usuarios con esos roles quedaran sin el. Esta accion no se puede deshacer.</div>
                <div class="usr-confirm-acts">
                    <button type="button" class="usr-btn-ghost" @onclick="() => _confirmBulkDel = false" disabled="@_bulkBusy">Cancelar</button>
                    <button type="button" class="usr-selbar-del" @onclick="BulkEliminarAsync" disabled="@_bulkBusy">@(_bulkBusy ? "Eliminando..." : "Si, eliminar")</button>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    private bool _authChecked;
    private string? _jwt;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-success";

    private List<RolDto>? _roles;
    private Guid? _rolEditando;
    private RolDetalleDto? _detalleEdit;

    // Barra de herramientas de la bandeja (objetivo visual Maqueta1): Filtros/Buscar/Ordenar/Agrupar.
    private string _busca = "";
    private bool _ordenAsc = true;
    private bool _agruparCat;
    private bool _filtrosOpen;
    private CategoriaRol? _filtroCat;

    private IEnumerable<RolDto> RolesVista()
    {
        if (_roles is null) return Enumerable.Empty<RolDto>();
        var q = _roles.Where(r => r.Tipo != TipoRol.Sistema);
        if (_filtroCat is not null) q = q.Where(r => r.Categoria == _filtroCat);
        if (!string.IsNullOrWhiteSpace(_busca))
        {
            var t = _busca.Trim().ToLowerInvariant();
            q = q.Where(r => (r.Nombre ?? "").ToLowerInvariant().Contains(t)
                || (r.Descripcion ?? "").ToLowerInvariant().Contains(t)
                || LabelCategoria(r.Categoria).ToLowerInvariant().Contains(t));
        }
        // Los roles de sistema (base: no se pueden seleccionar ni borrar) van SIEMPRE primero; el orden
        // por nombre (o por categoria al agrupar) se aplica dentro de cada grupo. clave base-first:
        // !PuedeSeleccionar => 0 (arriba), seleccionables => 1.
        q = _agruparCat
            ? q.OrderBy(r => (int)r.Categoria).ThenBy(r => PuedeSeleccionar(r) ? 1 : 0).ThenBy(r => r.Nombre)
            : (_ordenAsc
                ? q.OrderBy(r => PuedeSeleccionar(r) ? 1 : 0).ThenBy(r => r.Nombre)
                : q.OrderBy(r => PuedeSeleccionar(r) ? 1 : 0).ThenByDescending(r => r.Nombre));
        return q;
    }

    // ===== Seleccion multiple + acciones masivas (checkbox de la bandeja) =====
    // Un rol es accionable en masa solo si se puede activar/desactivar (Extendido) o eliminar (personalizado);
    // los roles base no se pueden tocar, asi que su checkbox va deshabilitado.
    private readonly HashSet<Guid> _sel = new();
    private bool _bulkBusy;
    private bool _confirmBulkDel;
    private static bool PuedeSeleccionar(RolDto r) => r.Tipo == TipoRol.Extendido || r.EsEliminable;
    private bool TodosSel => RolesVista().Any(PuedeSeleccionar) && RolesVista().Where(PuedeSeleccionar).All(r => _sel.Contains(r.Id));
    private int SelEliminables => _roles?.Count(r => _sel.Contains(r.Id) && r.EsEliminable) ?? 0;
    private void ToggleSel(Guid id, bool on) { if (on) _sel.Add(id); else _sel.Remove(id); }
    private void ToggleSelAll(ChangeEventArgs e)
    {
        var on = (bool)(e.Value ?? false);
        _sel.Clear();
        if (on) foreach (var r in RolesVista().Where(PuedeSeleccionar)) _sel.Add(r.Id);
    }
    private void LimpiarSel() => _sel.Clear();

    // Activar/Desactivar en masa: /activar ALTERNA, asi que solo se llama sobre los Extendido seleccionados
    // que todavia no esten en el estado deseado (los base/personalizados no tienen ese toggle).
    private async Task BulkActivarAsync(bool activar)
    {
        if (_roles is null) return;
        _bulkBusy = true; _msg = null;
        try
        {
            var objetivo = _roles.Where(r => _sel.Contains(r.Id) && r.Tipo == TipoRol.Extendido && r.Activo != activar).ToList();
            foreach (var r in objetivo) await Auth().PutAsync($"/api/roles/{r.Id}/activar", null);
            if (objetivo.Count == 0) { _msg = "No habia roles aplicables en la seleccion (activar/desactivar aplica solo a roles extendidos)."; _msgClass = "alert-danger"; }
            else { _msg = $"{objetivo.Count} rol(es) {(activar ? "activados" : "desactivados")}."; _msgClass = "alert-success"; }
            _sel.Clear();
            await CargarRolesAsync();
        }
        finally { _bulkBusy = false; }
    }

    // Eliminar en masa: solo los personalizados (EsEliminable) de la seleccion; los base se omiten.
    private async Task BulkEliminarAsync()
    {
        if (_roles is null) return;
        _bulkBusy = true; _msg = null;
        try
        {
            var objetivo = _roles.Where(r => _sel.Contains(r.Id) && r.EsEliminable).ToList();
            var ok = 0;
            foreach (var r in objetivo) { var resp = await Auth().DeleteAsync($"/api/roles/{r.Id}"); if (resp.IsSuccessStatusCode) ok++; }
            _msg = $"{ok} rol(es) eliminados."; _msgClass = "alert-success";
            _sel.Clear(); _confirmBulkDel = false;
            await CargarRolesAsync();
        }
        finally { _bulkBusy = false; }
    }

