    // ===== FAB flotante + scroll infinito (patron Unidades) =====
    private bool _ctaVisible = true;
    private DotNetObjectReference<RolesPanel>? _self;
    private string? _fabSig;
    private bool _scrollCtaPend;
    [JSInvokable] public Task CargarMas() => Task.CompletedTask;
    [JSInvokable] public void SetCtaVisible(bool visible) { if (_ctaVisible != visible) { _ctaVisible = visible; StateHasChanged(); } }
    private void FabNuevoRol() { _creandoRol = true; _nuevoCategoria = CategoriaRol.Administrativo; _scrollCtaPend = true; }
    public void Dispose() { _self?.Dispose(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // FAB flotante + scroll infinito (patron Unidades): observa el scroll de la bandeja.
        if (_roles is not null && _rolEditando is null)
        {
            _self ??= DotNetObjectReference.Create(this);
            var sig = $"b{_roles.Count}";
            if (sig != _fabSig) { _fabSig = sig; try { await Js.InvokeVoidAsync("propiaUI.dstInfinite", _self, ".rol-scroll"); } catch { } }
        }
        else { _fabSig = null; }
        if (_scrollCtaPend) { _scrollCtaPend = false; try { await Js.InvokeVoidAsync("propiaUI.dstScrollToCta", ".rol-scroll"); } catch { } }

        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarRolesAsync();
                StateHasChanged();
            }
        }
        catch { /* prerender */ }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private async Task CargarRolesAsync()
    {
        try { _roles = await Auth().GetFromJsonAsync<List<RolDto>>("/api/roles") ?? new(); }
        catch { _roles = new(); }
        await RecargarConfigAsync();
        HidratarAnchos();
    }

    // ===== Columnas de la tabla: orden + ancho configurables por copropiedad (canon vista-tabla).
    // Reusa el endpoint/tabla compartidos unidades-config con entidad "rol"; el ancho va en el JSON
    // Formato clave "w", el orden en Orden. Reorder/resize via el interop compartido. =====
    private sealed record ColRol(string Clave, string Label);
    private static readonly ColRol[] ColsRolesBase =
    {
        new("nombre", "ROL"),
        new("categoria", "CATEGORIA"),
        new("base", "BASE"),
        new("usuarios", "USUARIOS ASIGNADOS"),
    };
    private IEnumerable<ColRol> ColsRoles =>
        ColsRolesBase.Select((c, i) => (c, ord: OrdenDe(c.Clave, i))).OrderBy(x => x.ord).Select(x => x.c);

    private Dictionary<string, UnidadCampoConfigDto> _camposConfig = new(StringComparer.Ordinal);
    private int OrdenDe(string clave, int fallback)
        => _camposConfig.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;

    private readonly Dictionary<string, int> _colW = new(StringComparer.Ordinal);
    // La tabla LLENA el contenedor (sin scroll horizontal): la columna ROL (nombre) queda FLEXIBLE
    // (sin ancho -> absorbe el espacio restante) salvo que el usuario la redimensione; las demas llevan
    // ancho px explicito (default o redimensionado) y son las que "mandan" el ancho.
    private string AnchoCol(string k)
    {
        if (_colW.TryGetValue(k, out var w)) return $"width:{w}px";
        if (k == "nombre") return string.Empty;   // flexible
        return $"width:{AnchoDefault(k)}px";
    }
    private static int AnchoDefault(string k) => k switch
    {
        "categoria" => 190,
        "base" => 150,
        "usuarios" => 160,
        _ => 240,
    };

    private GuardarUnidadCampoConfigRequest FilaConfig(string k)
    {
        _camposConfig.TryGetValue(k, out var c);
        return new GuardarUnidadCampoConfigRequest(k, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato,
            Oculto: c?.Oculto ?? false, Orden: c?.Orden, Entidad: "rol");
    }
    private async Task GuardarCfg(GuardarUnidadCampoConfigRequest req)
    { try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { } }

    private async Task IniciarReorder(MouseEventArgs e, string k)
    { _self ??= DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _self, k, e.ClientX, e.ClientY); } catch { } }
    [JSInvokable] public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        var keys = ColsRoles.Select(c => c.Clave).ToList();
        var from = keys.IndexOf(src); var to = keys.IndexOf(dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, src);
        for (int i = 0; i < keys.Count; i++) await GuardarCfg(FilaConfig(keys[i]) with { Orden = i });
        await RecargarConfigAsync(); StateHasChanged();
    }
    private async Task IniciarResize(MouseEventArgs e, string k)
    { _self ??= DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("propiaTablaResize.start", _self, k, e.ClientX); } catch { } }
    private Task ResetResize(string k) => OnColResize(k, 0);
    [JSInvokable] public async Task OnColResize(string clave, int width)
    {
        int? w = width <= 0 ? null : Math.Max(70, width);
        if (w is null) _colW.Remove(clave); else _colW[clave] = w.Value;
        var fila = FilaConfig(clave);
        await GuardarCfg(fila with { Formato = ConAncho(fila.Formato, w) });
        await RecargarConfigAsync(); HidratarAnchos(); StateHasChanged();
    }
    private void HidratarAnchos()
    {
        _colW.Clear();
        foreach (var kv in _camposConfig) { var w = AnchoDeFormato(kv.Value.Formato); if (w is > 0) _colW[kv.Key] = w.Value; }
    }
    private static int? AnchoDeFormato(string? json)
    { try { var o = System.Text.Json.Nodes.JsonNode.Parse(json ?? "") as System.Text.Json.Nodes.JsonObject; return o?["w"]?.GetValue<int>(); } catch { return null; } }
    private static string? ConAncho(string? json, int? w)
    {
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(json) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (w is null) o.Remove("w"); else o["w"] = w.Value;
        return o.Count == 0 ? null : o.ToJsonString();
    }
    private async Task RecargarConfigAsync()
    {
        try { _camposConfig = (await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config?entidad=rol") ?? new()).ToDictionary(x => x.CampoClave, StringComparer.Ordinal); }
        catch { }
    }

    private async Task EditarRol(Guid rolId)
    {
        _rolEditando = rolId;
        _detalleEdit = await Auth().GetFromJsonAsync<RolDetalleDto>($"/api/roles/{rolId}");
        _edNombre = _detalleEdit?.Nombre ?? "";
        _edCategoria = _detalleEdit?.Categoria ?? CategoriaRol.Administrativo;
        _edSoloDir = _detalleEdit?.SoloDirectorio ?? false;
        _edFacetas = (_detalleEdit?.FacetasSemilla ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var n) ? n : 0).Where(n => n > 0).ToHashSet();
    }

    private void VolverALista() { _rolEditando = null; _detalleEdit = null; }

    private void ToggleFaceta(int v) { if (!_edFacetas.Add(v)) _edFacetas.Remove(v); }

    private async Task GuardarConfigRol()
    {
        if (_rolEditando is null || _detalleEdit is null) return;
        _busy = true; _msg = null;
        try
        {
            var facetasCsv = _edFacetas.Count == 0 ? null : string.Join(",", _edFacetas.OrderBy(x => x));
            var req = new ActualizarRolRequest(_edNombre.Trim(), _detalleEdit.Descripcion, _edCategoria, _detalleEdit.Activo, facetasCsv, _edSoloDir);
            var resp = await Auth().PutAsJsonAsync($"/api/roles/{_rolEditando}", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Rol actualizado."; _msgClass = "alert-success";
            await CargarRolesAsync();
            await EditarRol(_rolEditando.Value);
        }
        finally { _busy = false; }
    }

    private async Task TogglePermiso(string modulo, AccionPermiso accion, bool habilitado)
    {
        if (_rolEditando is null || _detalleEdit is null) return;
        var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == modulo && p.Accion == accion);
        var nivel = celda?.NivelDato ?? NivelDato.Copropiedad;
        if (habilitado && nivel == NivelDato.SinAcceso) nivel = NivelDato.Copropiedad;
        var resp = await Auth().PutAsJsonAsync($"/api/roles/{_rolEditando}/permisos",
            new ActualizarPermisoRequest(modulo, accion, habilitado, nivel));
        if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        await EditarRol(_rolEditando.Value);
    }

    private async Task CambiarNivel(string modulo, NivelDato nivel)
    {
        if (_rolEditando is null || _detalleEdit is null) return;
        var http = Auth();
        foreach (var accion in Enum.GetValues<AccionPermiso>())
        {
            var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == modulo && p.Accion == accion);
            if (celda is null || !celda.Habilitado) continue;
            await http.PutAsJsonAsync($"/api/roles/{_rolEditando}/permisos",
                new ActualizarPermisoRequest(modulo, accion, true, nivel));
        }
        await EditarRol(_rolEditando.Value);
    }

    private async Task ToggleExtendido(Guid rolId)
    {
        await Auth().PutAsync($"/api/roles/{rolId}/activar", null);
        await CargarRolesAsync();
    }

    private async Task CrearRol()
    {
        if (string.IsNullOrWhiteSpace(_nuevoNombre)) return;
        _busy = true; _msg = null;
        try
        {
            Guid? copiar = Guid.TryParse(_copiarDe, out var g) ? g : null;
            var resp = await Auth().PostAsJsonAsync("/api/roles",
                new CrearRolRequest(_nuevoNombre.Trim(), null, _nuevoCategoria, copiar));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            var creado = await resp.Content.ReadFromJsonAsync<RolDto>();
            _msg = $"Rol '{_nuevoNombre}' creado."; _msgClass = "alert-success";
            _nuevoNombre = ""; _copiarDe = ""; _creandoRol = false;
            await CargarRolesAsync();
            if (creado is not null) await EditarRol(creado.Id); // abre su ficha
        }
        finally { _busy = false; }
    }

    // Duplicar: crea un personalizado copiando la matriz EFECTIVA del origen (RP-02) y abre su ficha.
    private async Task DuplicarRol(RolDto origen)
    {
        _busy = true; _msg = null;
        try
        {
            var nombre = $"Copia de {origen.Nombre}";
            var resp = await Auth().PostAsJsonAsync("/api/roles",
                new CrearRolRequest(nombre, origen.Descripcion, origen.Categoria, origen.Id));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            var creado = await resp.Content.ReadFromJsonAsync<RolDto>();
            _msg = $"Rol duplicado como '{nombre}'."; _msgClass = "alert-success";
            await CargarRolesAsync();
            if (creado is not null) await EditarRol(creado.Id);
        }
        finally { _busy = false; }
    }

    // RL-1: el borrado de un rol personalizado pasa por una confirmacion (antes borraba al instante).
    private RolDto? _confirmDelRol;
    private bool _eliminandoRol;
    private Task PedirEliminarRol(RolDto r) { _confirmDelRol = r; return Task.CompletedTask; }

    private async Task EliminarRolConfirmadoAsync()
    {
        if (_confirmDelRol is not { } rol) return;
        _eliminandoRol = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/roles/{rol.Id}");
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; _confirmDelRol = null; return; }
            _msg = "Rol eliminado."; _msgClass = "alert-success";
            _confirmDelRol = null;
            await CargarRolesAsync();
        }
        finally { _eliminandoRol = false; }
    }

