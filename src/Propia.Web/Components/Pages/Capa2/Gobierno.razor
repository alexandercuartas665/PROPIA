@page "/gobierno"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.MiCopropiedad
@using Propia.Web.Components.Shared.Modals
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject IModalService Modals

<PageTitle>Gobierno - PROPIA</PageTitle>

@* 2.5.1 Gobierno: pagina dedicada que reusa GestionarGobiernoModal. Muestra resumen y
   abre el modal para gestion completa de Consejo, Comites y Revisor Fiscal. *@

<div class="gob-page">
    <div class="gob-head">
        <div>
            <h1 class="gob-title">Gobierno</h1>
            <p class="gob-sub">Consejo de administracion, comites y revisor fiscal de la copropiedad.</p>
        </div>
        <button class="gob-btn-brand" type="button" @onclick="AbrirGestionarAsync">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Gestionar gobierno
        </button>
    </div>

    <div class="gob-grid">
        <div class="gob-card" @onclick="AbrirGestionarAsync">
            <div class="gob-card-icon gob-card-icon--consejo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="gob-card-body">
                <div class="gob-card-title">Consejo de administracion</div>
                <div class="gob-card-meta">@_consejoActivos miembros activos</div>
            </div>
        </div>
        <div class="gob-card" @onclick="AbrirGestionarAsync">
            <div class="gob-card-icon gob-card-icon--comite">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <div class="gob-card-body">
                <div class="gob-card-title">Comites</div>
                <div class="gob-card-meta">@_comitesActivos comites activos</div>
            </div>
        </div>
        <div class="gob-card" @onclick="AbrirGestionarAsync">
            <div class="gob-card-icon gob-card-icon--revisor">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
            </div>
            <div class="gob-card-body">
                <div class="gob-card-title">Revisor fiscal</div>
                <div class="gob-card-meta">@(_revisorActivo ? "Asignado" : "Sin asignar")</div>
            </div>
        </div>
    </div>
</div>

<ModalHost />

<style>
    .gob-page { padding: 22px 28px; font-family: var(--propia-font-base, 'Lexend', sans-serif); }
    .gob-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 22px; }
    .gob-title { font-size: 27px; font-weight: 800; letter-spacing: -0.6px; color: var(--propia-text-h1); margin: 0; }
    .gob-sub { font-size: 14px; color: var(--propia-text-muted); margin: 4px 0 0; }
    .gob-btn-brand { display: inline-flex; align-items: center; gap: 7px; margin-left: auto; padding: 9px 16px; border: 0; border-radius: 9px; background: var(--propia-brand, var(--propia-brand)); color: var(--propia-bg-card); font-size: 13px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(109,79,227,.25); }
    .gob-btn-brand:hover { background: var(--propia-brand-hover, var(--propia-brand-hover)); }

    .gob-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
    .gob-card { background: var(--propia-bg-card); border: 1px solid var(--propia-border-divider); border-radius: 14px; padding: 18px; display: flex; align-items: center; gap: 14px; cursor: pointer; transition: border-color .15s, transform .15s; }
    .gob-card:hover { border-color: var(--propia-brand, var(--propia-brand)); transform: translateY(-1px); }
    .gob-card-icon { width: 46px; height: 46px; border-radius: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .gob-card-icon--consejo { background: #E3F2FD; color: #1565C0; }
    .gob-card-icon--comite { background: var(--propia-bg-card)3E0; color: #EF6C00; }
    .gob-card-icon--revisor { background: #E8F5E9; color: #2E7D32; }
    .gob-card-title { font-size: 14px; font-weight: 800; color: var(--propia-text-h1); }
    .gob-card-meta { font-size: 12.5px; color: var(--propia-text-muted); margin-top: 2px; }
</style>

@code {
    private string? _jwt;
    private int _consejoActivos;
    private int _comitesActivos;
    private bool _revisorActivo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt"); } catch { }
        if (string.IsNullOrEmpty(_jwt)) return;
        await CargarAsync();
        StateHasChanged();
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("PropiaApi");
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
            var consejo = await http.GetFromJsonAsync<List<MiembroConsejoDto>>("/api/mi-copropiedad/consejo") ?? new();
            var comites = await http.GetFromJsonAsync<List<ComiteDto>>("/api/mi-copropiedad/comites") ?? new();
            var rev = await http.GetFromJsonAsync<RevisorFiscalDto>("/api/mi-copropiedad/revisor-fiscal");
            _consejoActivos = consejo.Count(c => c.Activo);
            _comitesActivos = comites.Count(c => c.Activo);
            _revisorActivo = rev is { Activo: true };
        }
        catch { /* ignorar; la UI muestra ceros */ }
    }

    private async Task AbrirGestionarAsync()
    {
        var parameters = new ModalParameters().Set("Jwt", _jwt);
        var options = new ModalOptions { Width = "920px" };
        var hubo = await Modals.OpenAsync<GestionarGobiernoModal, bool>(parameters, options);
        if (hubo == true) await CargarAsync();
    }
}
