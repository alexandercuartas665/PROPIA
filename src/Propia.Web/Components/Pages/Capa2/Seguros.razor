@page "/seguros"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Seguros
@using Propia.Application.Directorio
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using Propia.Web.Components.Shared
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Seguros - PROPIA</PageTitle>

@* Modulo Seguros (Ola 4): polizas dedicadas. Bandeja al estandar del sistema
   (Tarjetas/Tabla, buscar, agrupar, configurar columnas, expander) + modal con
   pestanas Poliza / Documentos / Reclamaciones y extraccion por OCR. *@

<div class="seg-page">
    <div class="mod-pagehead">
        <div>
            <h1 class="mod-pagetitle">Seguros</h1>
            <p class="mod-pagesub">Polizas de la copropiedad, su vigencia y reclamaciones.</p>
        </div>
        @if (_authChecked && _jwt is not null)
        {
            <div class="seg-head-actions">
                <div class="seg-toggle">
                    <button type="button" class="seg-vt @(_vista == "tarjetas" ? "on" : "")" @onclick='() => SetVista("tarjetas")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                        Tarjetas
                    </button>
                    <button type="button" class="seg-vt @(_vista == "tabla" ? "on" : "")" @onclick='() => SetVista("tabla")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                        Tabla
                    </button>
                </div>
                <button class="propia-btn-brand" @onclick="() => AbrirModal(null)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                    Nueva poliza
                </button>
            </div>
        }
    </div>

    @if (!_authChecked)
    {
        <div class="seg-loading"><div class="spinner-border" style="color: var(--propia-brand, #6D4FE3);"></div></div>
    }
    else if (string.IsNullOrEmpty(_jwt))
    {
        <AuthMessage />
    }
    else
    {
        @* Sin KPIs en vista tabla (canon regla 7): del titulo se pasa directo a la barra de filtros. *@

        <div class="mod-filtros">
            <div class="seg-filtro-wrap">
                <button type="button" class="seg-fsel @(HaySegReglasActivas ? "on" : "")" @onclick="ToggleFiltrosS" title="Filtrar polizas">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M3 5h18M6 12h12M10 19h4"/></svg><span>Filtros</span>
                    @if (CuentaReglasS > 0) { <span class="seg-fbadge">@CuentaReglasS</span> }
                </button>
                @if (_filtrosMenuS)
                {
                    <div class="seg-menu-bd" @onclick="() => _filtrosMenuS = false"></div>
                    <div class="seg-fpop" @onclick:stopPropagation="true">
                        @if (_reglasS.Count == 0)
                        {
                            <div class="seg-fpop-empty">Sin filtros aplicados.<br />Agrega una condicion para acotar las polizas.</div>
                        }
                        else
                        {
                            @for (int i = 0; i < _reglasS.Count; i++)
                            {
                                var idx = i; var r = _reglasS[idx];
                                <div class="seg-frule">
                                    @if (idx == 0)
                                    {
                                        <span class="seg-frule-lead">Donde</span>
                                    }
                                    else if (idx == 1)
                                    {
                                        <select class="seg-frule-lead seg-frule-logic" @onchange="SetLogicaS">
                                            <option value="and" selected="@(_logicaS == "and")">Y</option>
                                            <option value="or" selected="@(_logicaS == "or")">O</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="seg-frule-lead">@(_logicaS == "or" ? "O" : "Y")</span>
                                    }
                                    <select class="seg-frule-f" @onchange="(e) => SetReglaCampoS(idx, e)">
                                        @foreach (var opt in CamposFiltroS()) { <option value="@opt.Key" selected="@(r.Campo == opt.Key)">@opt.Label</option> }
                                    </select>
                                    <select class="seg-frule-op" @onchange="(e) => SetReglaOpS(idx, e)">
                                        @foreach (var op in OperadoresS(r.Campo)) { <option value="@op.Key" selected="@(r.Op == op.Key)">@op.Label</option> }
                                    </select>
                                    @if (r.Op is not "vacio" and not "no_vacio")
                                    {
                                        @RenderValorS(idx)
                                    }
                                    <button class="seg-frule-del" title="Quitar condicion" @onclick="() => QuitarReglaS(idx)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                    </button>
                                </div>
                            }
                        }
                        <div class="seg-fpop-foot">
                            <button class="seg-fadd" @onclick="AgregarReglaS">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"/></svg>Agregar filtro
                            </button>
                            @if (_reglasS.Count > 0) { <button class="seg-fclear2" @onclick="LimpiarReglasS">Limpiar todo</button> }
                        </div>
                    </div>
                }
            </div>
            <div class="seg-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input class="seg-search-inp" placeholder="Buscar por numero, aseguradora, corredor..." @oninput="OnBuscar" />
            </div>
            <div class="mod-filtros-spacer"></div>
            <div class="seg-menu-wrap">
                <button type="button" class="seg-fsel @(_agruparPor != "" ? "on" : "")" @onclick="() => _showAgruparMenu = !_showAgruparMenu" title="Agrupar polizas">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>Agrupar@(_agruparPor != "" ? ": " + AgruparLabel(_agruparPor) : "")
                </button>
                @if (_showAgruparMenu)
                {
                    <div class="seg-menu-bd" @onclick="() => _showAgruparMenu = false"></div>
                    <div class="seg-menu">
                        @foreach (var g in new[] { ("", "Sin agrupar"), ("aseguradora", "Aseguradora"), ("estado", "Vencimiento") })
                        {
                            var gk = g.Item1;
                            <button class="seg-menu-it @(_agruparPor == gk ? "on" : "")" @onclick="() => SetAgruparVal(gk)">@g.Item2</button>
                        }
                    </div>
                }
            </div>
            <div class="seg-menu-wrap">
                <button type="button" class="seg-fsel @(_showCampos ? "on" : "")" @onclick="() => _showCampos = !_showCampos" title="Campos: orden, visibilidad y campos personalizados">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>Campos
                </button>
                @if (_showCampos)
                {
                    <div class="seg-menu-bd" @onclick="() => _showCampos = false"></div>
                    <div class="seg-campospop" @onclick:stopPropagation="true">
                        <div class="seg-campospop-h">CAMPOS (orden y visibilidad)</div>
                        @if (_campos.Count == 0)
                        {
                            <div class="seg-cm-empty">Aun no hay campos personalizados. Crea el primero abajo (ej. "Deducible", "Renovada el").</div>
                        }
                        else
                        {
                            <div class="seg-cm-list">
                                @{ var ordenados = _campos.OrderBy(c => c.Orden).ToList(); }
                                @for (int i = 0; i < ordenados.Count; i++)
                                {
                                    var idx = i; var cm = ordenados[idx];
                                    <div class="seg-cm-row @(cm.Activo ? "" : "off")">
                                        <div class="seg-cm-ord">
                                            <button class="seg-cm-mv" disabled="@(idx == 0)" @onclick="() => MoverCampoAsync(ordenados, idx, -1)" title="Subir">&#9650;</button>
                                            <button class="seg-cm-mv" disabled="@(idx == ordenados.Count - 1)" @onclick="() => MoverCampoAsync(ordenados, idx, 1)" title="Bajar">&#9660;</button>
                                        </div>
                                        <input class="seg-cm-nom" value="@cm.Label" @onchange="e => RenombrarCampoAsync(cm, e)" />
                                        <span class="seg-cm-tipo">@TipoCampoLabel(cm.Tipo)</span>
                                        <label class="seg-cm-sw" title="Mostrar como columna">
                                            <input type="checkbox" checked="@cm.Activo" @onchange="() => ToggleCampoActivoAsync(cm)" />
                                            <span>@(cm.Activo ? "Visible" : "Oculto")</span>
                                        </label>
                                        <button class="seg-cm-del" @onclick="() => EliminarCampoAsync(cm.Id)" title="Eliminar campo"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></button>
                                    </div>
                                }
                            </div>
                        }
                        <div class="seg-cm-new">
                            <div class="seg-campospop-h" style="margin-top:6px;">NUEVO CAMPO</div>
                            <div class="seg-grid-form">
                                <div><label class="seg-lbl">Nombre del campo</label><input class="seg-input" placeholder="Ej. Deducible" @bind="_nuevoCampoLabel" @bind:event="oninput" /></div>
                                <div>
                                    <label class="seg-lbl">Tipo</label>
                                    <select class="seg-input" @bind="_nuevoCampoTipo">
                                        @foreach (var t in new[] { TipoCampoTablero.Texto, TipoCampoTablero.AreaTexto, TipoCampoTablero.Numero, TipoCampoTablero.Moneda, TipoCampoTablero.Fecha, TipoCampoTablero.Seleccion, TipoCampoTablero.Booleano, TipoCampoTablero.Telefono, TipoCampoTablero.Url, TipoCampoTablero.Email })
                                        {
                                            <option value="@t">@TipoCampoLabel(t)</option>
                                        }
                                    </select>
                                </div>
                                @if (_nuevoCampoTipo == TipoCampoTablero.Seleccion)
                                {
                                    <div class="seg-col-full"><label class="seg-lbl">Opciones (una por linea)</label><textarea class="seg-input" rows="3" @bind="_nuevoCampoOpciones" @bind:event="oninput"></textarea></div>
                                }
                            </div>
                            @if (_camposError is not null) { <div class="seg-banner err">@_camposError</div> }
                            <button class="seg-btn-brand" style="margin-top:10px;" @onclick="CrearCampoAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoCampoLabel))">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="vertical-align:-2px;margin-right:4px;"><path d="M12 5v14M5 12h14"/></svg>Agregar campo
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (_loadError is not null) { <div class="alert alert-danger">@_loadError</div> }

        @* Vacio-como-tabla (canon): el cartel seg-empty solo aplica a la vista Tarjetas; en vista
           Tabla se renderiza siempre la tabla (cabecera + fila de alta + footer "Mostrando 0 de 0"). *@
        @if (Filtradas.Count == 0 && _vista == "tarjetas")
        {
            <div class="seg-empty"><strong>Sin polizas.</strong><span>Usa "Nueva poliza" para registrar la primera.</span></div>
        }
        else if (_vista == "tabla")
        {
            <div class="seg-table">
                <div class="seg-scroll">
                    <div class="seg-head seg-grid" style="@GridStyle()">
                        <div></div><div>N POLIZA</div><div>ASEGURADORA</div><div>CORREDOR</div><div>INICIO</div><div>FINALIZACION</div><div>VENCIMIENTO</div><div>VALOR</div><div>RECLAM.</div>
                        @foreach (var cm in CamposActivos) { <div>@cm.Label.ToUpperInvariant()</div> }
                    </div>
                    @foreach (var item in FilasRender())
                    {
                        if (item.EsGrupo)
                        {
                            <div class="seg-group"><span class="seg-group-t">@item.Grupo</span><span class="seg-group-n">@item.Count</span></div>
                            continue;
                        }
                        var p = item.Poliza!;
                        var pp = p;
                        <div class="seg-row seg-grid @(_segRecienCreados.Contains(p.Id) ? "seg-row-nuevo" : "")" style="@GridStyle()">
                            <div class="seg-exp-col">
                                <button type="button" class="seg-exp" title="Abrir la ficha" @onclick="() => AbrirModal(pp.Id)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                </button>
                            </div>
                            <div class="seg-c seg-c--num">@(string.IsNullOrWhiteSpace(p.NumeroPoliza) ? "-" : p.NumeroPoliza)</div>
                            <div class="seg-c seg-c--aseg">@p.Aseguradora</div>
                            <div class="seg-c">@(string.IsNullOrWhiteSpace(p.Corredor) ? "-" : p.Corredor)</div>
                            <div class="seg-c">@(p.FechaInicio?.ToString("dd MMM yyyy") ?? "-")</div>
                            <div class="seg-c">@(p.FechaFin?.ToString("dd MMM yyyy") ?? "-")</div>
                            <div class="seg-c">@SemaforoBadge(p)</div>
                            <div class="seg-c">@(p.ValorPoliza is { } v ? "$" + v.ToString("N0") : "-")</div>
                            <div class="seg-c">@(p.ReclamacionesCount > 0 ? p.ReclamacionesCount.ToString() : "-")</div>
                            @foreach (var cm in CamposActivos) { <div class="seg-c" title="@cm.Label">@(ValorCampoTexto(p, cm) is { Length: > 0 } vv ? vv : "-")</div> }
                        </div>
                    }
                    @* Fila de alta inline: crear poliza desde la tabla (como Zonas Comunes). *@
                    <div class="seg-row seg-newrow seg-grid" style="@GridStyle()">
                        <div class="seg-exp-col">
                            <button type="button" class="seg-exp seg-exp-fijo" title="Crear la poliza" @onclick="CrearPolizaDesdeAltaAsync" disabled="@_creandoInline">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </div>
                        <div class="seg-c"><input class="seg-nf-inp" @bind="_npNumero" @bind:event="oninput" placeholder="N poliza" /></div>
                        <div class="seg-c"><input class="seg-nf-inp" @bind="_npAseguradora" @bind:event="oninput" placeholder="Aseguradora *" /></div>
                        <div class="seg-c"><input class="seg-nf-inp" @bind="_npCorredor" @bind:event="oninput" placeholder="Corredor" /></div>
                        <div class="seg-c"><input type="date" class="seg-nf-inp" value="@_npInicio" @oninput="e => _npInicio = e.Value?.ToString() ?? string.Empty" /></div>
                        <div class="seg-c"><input type="date" class="seg-nf-inp" value="@_npFin" @oninput="e => _npFin = e.Value?.ToString() ?? string.Empty" /></div>
                        <div class="seg-c seg-c--auto">(auto)</div>
                        <div class="seg-c"><input type="number" step="1000" class="seg-nf-inp" @bind="_npValor" @bind:event="oninput" placeholder="Valor" /></div>
                        <div class="seg-c"><button type="button" class="seg-row-add" @onclick="CrearPolizaDesdeAltaAsync" disabled="@_creandoInline">+ Agregar</button></div>
                        @foreach (var cm in CamposActivos) { <div class="seg-c seg-c--auto">-</div> }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_inlineMsg)) { <div class="seg-toast" @onclick="() => _inlineMsg = null">@_inlineMsg</div> }
                @* Footer canonico SIEMPRE salvo con agrupacion activa (canon regla 14): con 0 filas "Mostrando 0 de 0". *@
                @if (_agruparPor == "")
                {
                    <TablaPager Total="Filtradas.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="polizas"
                                PaginaChanged="p => _pagina = p"
                                PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
                }
            </div>
        }
        else
        {
            <div class="seg-cards">
                @foreach (var item in FilasRender())
                {
                    if (item.EsGrupo)
                    {
                        <div class="seg-group seg-group--card"><span class="seg-group-t">@item.Grupo</span><span class="seg-group-n">@item.Count</span></div>
                        continue;
                    }
                    var p = item.Poliza!;
                    var pp = p;
                    <button type="button" class="seg-card" @onclick="() => AbrirModal(pp.Id)">
                        <div class="seg-card-top">
                            <span class="seg-card-aseg">@p.Aseguradora</span>
                            @SemaforoBadge(p)
                        </div>
                        <div class="seg-card-num">@(string.IsNullOrWhiteSpace(p.NumeroPoliza) ? "Sin numero" : "N " + p.NumeroPoliza)</div>
                        <div class="seg-card-meta">
                            @(p.FechaFin is { } f ? "Vence " + f.ToString("dd MMM yyyy") : "Sin vigencia")
                            @(p.ValorPoliza is { } v ? " - $" + v.ToString("N0") : "")
                        </div>
                    </button>
                }
            </div>
        }
    }
</div>

@if (_modal)
{
    <div class="seg-ov" @onclick="() => _modal = false"></div>
    <div class="seg-modal">
        <div class="seg-modal-head">
            <div class="seg-modal-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg></div>
            <div style="flex:1;min-width:0;">
                <div class="seg-modal-title">@(_editId is null ? "Nueva poliza" : (string.IsNullOrWhiteSpace(_f.NumeroPoliza) ? "Poliza" : "Poliza " + _f.NumeroPoliza))</div>
                <div class="seg-modal-sub">@(_editId is null ? "Registra la poliza y su vigencia." : _f.Aseguradora)</div>
            </div>
            <button class="seg-x" @onclick="() => _modal = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        </div>

        @if (_editId is not null)
        {
            <div class="seg-tabs">
                <button class="@(_tab == "poliza" ? "on" : "")" @onclick='() => _tab = "poliza"'>Poliza</button>
                <button class="@(_tab == "docs" ? "on" : "")" @onclick='() => _tab = "docs"'>Documentos</button>
                <button class="@(_tab == "recl" ? "on" : "")" @onclick='AbrirReclamacionesTab'>Reclamaciones <span class="seg-tab-n">@_reclamaciones.Count</span></button>
            </div>
        }

        <div class="seg-modal-body">
            @if (_editId is null || _tab == "poliza")
            {
                @* Cargar PDF con OCR para prellenar (reusa el motor de Super Admin). *@
                <div class="seg-ocr">
                    <label class="seg-ocr-btn @(_ocrBusy ? "busy" : "")">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                        @(_ocrBusy ? "Leyendo poliza..." : "Cargar PDF y extraer con OCR")
                        <InputFile OnChange="OnOcrFile" accept=".pdf,image/*" hidden disabled="@_ocrBusy" />
                    </label>
                    @if (_ocrMsg is not null) { <span class="seg-ocr-msg">@_ocrMsg</span> }
                </div>

                <div class="seg-grid-form">
                    <div class="seg-col-full">
                        <label class="seg-lbl">Aseguradora * <span class="seg-hint">(busca en el Directorio o crea)</span></label>
                        <SelectorPersona Jwt="@_jwt" Seleccionada="_aseguradoraSel" SeleccionadaChanged="OnAseguradoraSel" PermiteEmpresa="true" Placeholder="Buscar aseguradora (empresa o persona)..." />
                        <input class="seg-input" style="margin-top:6px;" @bind="_f.Aseguradora" @bind:event="oninput" placeholder="Nombre de la aseguradora" />
                    </div>
                    <div class="seg-col-full">
                        <label class="seg-lbl">Corredor de seguro <span class="seg-hint">(opcional, del Directorio)</span></label>
                        <SelectorPersona Jwt="@_jwt" Seleccionada="_corredorSel" SeleccionadaChanged="OnCorredorSel" PermiteEmpresa="true" Placeholder="Buscar corredor..." />
                        <input class="seg-input" style="margin-top:6px;" @bind="_f.Corredor" @bind:event="oninput" placeholder="Nombre del corredor" />
                    </div>
                    <div><label class="seg-lbl">Numero de poliza</label><input class="seg-input" @bind="_f.NumeroPoliza" @bind:event="oninput" placeholder="Nro" /></div>
                    <div><label class="seg-lbl">Valor de poliza (COP)</label><input class="seg-input" type="number" step="any" @bind="_f.ValorPoliza" placeholder="0" /></div>
                    <div><label class="seg-lbl">Fecha de inicio</label><input class="seg-input" type="date" @bind="_f.Inicio" /></div>
                    <div><label class="seg-lbl">Fecha de finalizacion</label><input class="seg-input" type="date" @bind="_f.Fin" /></div>
                    <div><label class="seg-lbl">Forma de pago (cuotas)</label><input class="seg-input" type="number" min="1" @bind="_f.FormaPagoCuotas" placeholder="Cuotas" /></div>
                    <div><label class="seg-lbl">Pago mensual</label><label class="seg-check" style="margin-top:6px;"><input type="checkbox" @bind="_f.PagoMensual" /> Se paga mensualmente</label></div>
                    <div class="seg-col-full"><label class="seg-check"><input type="checkbox" @bind="_f.IncluyeZonasUnidades" /> Incluye zonas y unidades privadas</label></div>
                    <div class="seg-col-full"><label class="seg-lbl">Cobertura</label><textarea class="seg-input" rows="2" @bind="_f.Cobertura" placeholder="Condiciones de cobertura"></textarea></div>
                    <div class="seg-col-full"><label class="seg-lbl">Valores agregados</label><textarea class="seg-input" rows="2" @bind="_f.ValoresAgregados"></textarea></div>
                    <div class="seg-col-full"><label class="seg-lbl">Observaciones</label><textarea class="seg-input" rows="2" @bind="_f.Observaciones"></textarea></div>

                    @if (CamposActivos.Any())
                    {
                        <div class="seg-col-full"><div class="seg-doc-h" style="margin-top:4px;">Campos personalizados</div></div>
                        @foreach (var cm in CamposActivos)
                        {
                            var cid = cm.Id;
                            var full = cm.Tipo is TipoCampoTablero.AreaTexto or TipoCampoTablero.Seleccion;
                            <div class="@(full ? "seg-col-full" : "")">
                                <label class="seg-lbl">@cm.Label</label>
                                @switch (cm.Tipo)
                                {
                                    case TipoCampoTablero.AreaTexto:
                                        <textarea class="seg-input" rows="2" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())"></textarea>
                                        break;
                                    case TipoCampoTablero.Numero:
                                    case TipoCampoTablero.Moneda:
                                        <input class="seg-input" type="number" step="any" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Fecha:
                                        <input class="seg-input" type="date" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Booleano:
                                        <label class="seg-check" style="margin-top:6px;"><input type="checkbox" checked="@(Val(cid) == "true")" @onchange='e => SetVal(cid, ((bool)(e.Value ?? false)) ? "true" : "false")' /> Si</label>
                                        break;
                                    case TipoCampoTablero.Seleccion:
                                        <select class="seg-input" value="@Val(cid)" @onchange="e => SetVal(cid, e.Value?.ToString())">
                                            <option value="">- Selecciona -</option>
                                            @foreach (var op in (cm.Opciones ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <option value="@op">@op</option>
                                            }
                                        </select>
                                        break;
                                    default:
                                        <input class="seg-input" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())" />
                                        break;
                                }
                            </div>
                        }
                    }
                </div>
            }
            else if (_tab == "docs")
            {
                <div class="seg-doc-h">Expediente de la poliza (documentos)</div>
                <select class="seg-input" @bind="_f.ExpedienteId">
                    <option value="">- Sin expediente -</option>
                    @foreach (var e in _expedientes) { <option value="@e.Id">@e.Codigo - @e.Nombre</option> }
                </select>
                <p class="seg-doc-note">Conecta el expediente con la poliza, corredor y aseguradora. Los documentos se cargan en el modulo <a href="/documentos">Documentos</a>. Recuerda Guardar.</p>
            }
            else if (_tab == "recl")
            {
                <div class="seg-doc-h">Reclamaciones (@_reclamaciones.Count)</div>
                @if (_reclamaciones.Count > 0)
                {
                    <table class="seg-recl-tbl">
                        <thead><tr><th>Fecha</th><th>Que reclama</th><th>Reclamado</th><th>Estado</th><th>Reconocido</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in _reclamaciones)
                            {
                                var rr = r;
                                <tr>
                                    <td>@r.Fecha.ToString("dd MMM yyyy")</td>
                                    <td>@r.Descripcion</td>
                                    <td>$ @r.MontoReclamado.ToString("N0")</td>
                                    <td><span class="seg-recl-badge @(r.Estado == EstadoReclamacion.Vigente ? "vig" : "cer")">@(r.Estado == EstadoReclamacion.Vigente ? "Vigente" : "Cerrada")</span></td>
                                    <td>@(r.MontoReconocido is { } m ? "$" + m.ToString("N0") : "-")</td>
                                    <td>@if (r.Estado == EstadoReclamacion.Vigente) { <button class="seg-btn-ghost" @onclick="() => AbrirCerrar(rr)">Cerrar</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="seg-doc-note">Sin reclamaciones registradas.</p> }

                @if (_cerrarId is not null)
                {
                    <div class="seg-recl-form">
                        <span>Monto reconocido por la aseguradora:</span>
                        <input class="seg-input seg-mini" type="number" step="any" @bind="_montoReconocido" placeholder="0" />
                        <button class="seg-btn-brand" @onclick="ConfirmarCerrar" disabled="@_busy">Cerrar reclamacion</button>
                        <button class="seg-btn-ghost" @onclick="() => _cerrarId = null">Cancelar</button>
                    </div>
                }
                else
                {
                    <div class="seg-recl-nueva">
                        <div class="seg-doc-h" style="margin-top:14px;">Nueva reclamacion</div>
                        <div class="seg-grid-form">
                            <div><label class="seg-lbl">Fecha</label><input class="seg-input" type="date" @bind="_nrFecha" /></div>
                            <div><label class="seg-lbl">Monto a reclamar</label><input class="seg-input" type="number" step="any" @bind="_nrMonto" placeholder="0" /></div>
                            <div class="seg-col-full"><label class="seg-lbl">Que va a reclamar</label><input class="seg-input" @bind="_nrDesc" @bind:event="oninput" placeholder="Descripcion del siniestro" /></div>
                        </div>
                        <button class="seg-btn-brand" style="margin-top:8px;" @onclick="CrearReclamacion" disabled="@(_busy || string.IsNullOrWhiteSpace(_nrDesc))">Agregar reclamacion</button>
                    </div>
                }
            }

            @if (_modalError is not null) { <div class="seg-banner err">@_modalError</div> }
            @if (_editId is null || _tab == "poliza")
            {
                <div class="seg-modal-foot">
                    <button class="seg-btn-ghost" @onclick="() => _modal = false">Cancelar</button>
                    <button class="seg-btn-brand" @onclick="GuardarAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_f.Aseguradora))">@(_editId is null ? "Crear poliza" : "Guardar poliza")</button>
                </div>
            }
        </div>
    </div>
}

<style>
    .mod-pagehead { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
    .mod-pagetitle { font-size: 30px; font-weight: 800; color: var(--propia-text-h1); margin: 0 0 4px; letter-spacing: -.5px; }
    .mod-pagesub { font-size: 14px; color: var(--propia-text-muted); margin: 0; }
    .seg-loading { display: flex; justify-content: center; padding: 60px 0; }
    /* KPIs: se usan las clases globales .mod-stat* (tamano tb-bkpi de Tareas), sin override local. */
    .mod-filtros { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .mod-filtros-spacer { flex: 1 1 auto; min-width: 8px; }
    .seg-head-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .seg-search { display: flex; align-items: center; gap: 7px; border: 1px solid var(--propia-border-card); border-radius: 9px; padding: 0 11px; background: var(--propia-bg-card); }
    .seg-search svg { color: var(--propia-text-faint); }
    .seg-search-inp { border: 0; outline: none; padding: 8px 0; font-size: 12.5px; color: var(--propia-text-body); width: 260px; background: transparent; }
    .seg-fsel { display: inline-flex; align-items: center; border: 1px solid var(--propia-border-card); border-radius: 9px; padding: 8px 12px; font-size: 12.5px; font-weight: 600; color: var(--propia-text-secondary); background: var(--propia-bg-card); cursor: pointer; font-family: inherit; }
    .seg-fsel.on { border-color: var(--propia-brand, var(--propia-brand)); color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); font-weight: 700; }
    .seg-fsel:hover { border-color: var(--propia-brand, var(--propia-brand)); }
    .seg-menu-wrap { position: relative; }
    .seg-menu-bd { position: fixed; inset: 0; z-index: 40; }
    .seg-menu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 41; min-width: 190px; background: var(--propia-bg-card); border: 1px solid #E6ECF2; border-radius: 12px; box-shadow: 0 12px 30px rgba(30,40,60,.18); padding: 6px; }
    .seg-menu-it { display: block; width: 100%; text-align: left; border: 0; background: transparent; border-radius: 8px; padding: 8px 10px; font-size: 12.5px; font-weight: 600; color: var(--propia-text-body); cursor: pointer; font-family: inherit; }
    .seg-menu-it:hover { background: var(--propia-brand-soft-2); }
    .seg-menu-it.on { background: var(--propia-brand-soft-2); color: var(--propia-brand, var(--propia-brand)); }
    /* Boton "Filtros" + popover constructor de reglas (mismo diseno que Contratos/PQRS). */
    .seg-filtro-wrap { position: relative; }
    .seg-fbadge { background: var(--propia-brand, var(--propia-brand)); color: var(--propia-bg-card); font-size: 10.5px; font-weight: 800; border-radius: 20px; padding: 0 6px; min-width: 17px; height: 17px; margin-left: 5px; display: inline-flex; align-items: center; justify-content: center; }
    .seg-fpop { position: absolute; top: calc(100% + 6px); left: 0; z-index: 41; width: 540px; max-width: 88vw; background: var(--propia-bg-card); border: 1px solid #E6ECF2; border-radius: 13px; box-shadow: 0 18px 44px rgba(30,40,60,.22); padding: 12px; }
    .seg-fpop-empty { padding: 14px; text-align: center; color: #94A3B8; font-size: 12.5px; line-height: 1.5; }
    .seg-frule { display: flex; align-items: center; gap: 6px; margin-bottom: 7px; }
    .seg-frule-lead { font-size: 11.5px; font-weight: 700; color: #8593A5; min-width: 42px; }
    .seg-frule-logic { min-width: 52px; }
    .seg-frule select, .seg-frule input { border: 1px solid #DCE3EC; border-radius: 7px; padding: 5px 7px; font-size: 12px; color: #33414F; background: var(--propia-bg-card); font-family: inherit; }
    .seg-frule-f { flex: 1 1 120px; min-width: 90px; }
    .seg-frule-op { flex: 0 1 120px; }
    .seg-frule-v { flex: 1 1 120px; min-width: 90px; }
    .seg-frule-del { border: 0; background: #F3F6FA; color: #97A6B6; border-radius: 6px; width: 24px; height: 24px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
    .seg-frule-del:hover { background: var(--propia-danger-soft); color: #E14B4B; }
    .seg-fpop-foot { display: flex; align-items: center; gap: 10px; margin-top: 8px; padding-top: 9px; border-top: 1px dashed #E4EAF0; }
    .seg-fadd { display: inline-flex; align-items: center; gap: 5px; border: 0; background: #F4F1FE; color: var(--propia-brand-hover); font-weight: 700; font-size: 12px; border-radius: 8px; padding: 7px 12px; cursor: pointer; }
    .seg-fadd:hover { background: #E6DEFB; }
    .seg-fclear2 { border: 0; background: transparent; color: #8593A5; font-weight: 600; font-size: 12px; cursor: pointer; }
    .seg-fclear2:hover { color: #E14B4B; }
    /* Menu "Campos" (antes modal): popover anclado al boton, como Tareas. */
    .seg-campospop { position: absolute; top: calc(100% + 6px); right: 0; z-index: 41; width: 520px; max-width: 92vw; max-height: 72vh; overflow: auto; background: var(--propia-bg-card); border: 1px solid #E6ECF2; border-radius: 12px; box-shadow: 0 16px 40px rgba(30,40,60,.2); padding: 12px; }
    .seg-campospop-h { font-size: 10.5px; font-weight: 700; letter-spacing: .4px; color: var(--propia-text-faint); text-transform: uppercase; margin-bottom: 8px; }
    .mod-search-count { font-size: 12.5px; color: var(--propia-text-muted); }
    .seg-toggle { display: inline-flex; gap: 2px; background: var(--propia-border-divider); border-radius: 9px; padding: 3px; }
    .seg-vt { display: inline-flex; align-items: center; gap: 5px; border: 0; background: transparent; color: var(--propia-text-muted); font-size: 12.5px; font-weight: 600; padding: 5px 11px; border-radius: 7px; cursor: pointer; }
    .seg-vt.on { background: var(--propia-bg-card); color: var(--propia-brand, var(--propia-brand)); box-shadow: 0 1px 3px rgba(27,42,58,.12); }

    .seg-empty { background: var(--propia-bg-card); border: 1px dashed #DCE4EC; border-radius: 12px; padding: 34px; text-align: center; display: flex; flex-direction: column; gap: 5px; }
    .seg-empty strong { font-size: 14.5px; color: var(--propia-text-body); }
    .seg-empty span { font-size: 13px; color: var(--propia-text-muted); }

    .seg-table { background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 12px; overflow: hidden; }
    .seg-scroll { overflow: auto; max-height: calc(100vh - 300px); }
    .seg-grid { display: grid; grid-template-columns: 34px 1.1fr 1.6fr 1.3fr 1fr 1fr 1.1fr 1fr .7fr; align-items: center; gap: 8px; padding: 8px 16px; min-width: 1000px; }
    /* Header canonico (estandar Tareas): tokens homogeneos, sticky top OPACO. */
    .seg-head { background: var(--propia-bg-table-head); font-size: 10.5px; font-weight: 700; color: var(--propia-text-faint); letter-spacing: .4px; text-transform: uppercase; border-bottom: 1px solid var(--propia-border-divider); position: sticky; top: 0; z-index: 3; }
    .seg-row { border-bottom: 1px solid var(--propia-border-divider); font-size: 13px; color: var(--propia-text-body); }
    .seg-row:hover { background: var(--propia-brand-soft-2); }
    .seg-c { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .seg-c--num { font-weight: 700; color: var(--propia-text-h1); }
    .seg-c--aseg { font-weight: 600; color: var(--propia-brand, var(--propia-brand)); }
    .seg-exp-col { display: flex; align-items: center; justify-content: center; }
    .seg-exp { width: 26px; height: 26px; border: 0; border-radius: 7px; background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0; transition: opacity .12s; }
    .seg-row:hover .seg-exp { opacity: 1; }
    .seg-newrow .seg-exp-fijo { opacity: 1; }
    .seg-exp-fijo:disabled { opacity: .3; cursor: default; }
    /* Fila de alta inline: inputs con estilo canonico de Tareas (.tb-nf-inp), boton estilo Zonas. */
    .seg-nf-inp { width: 100%; box-sizing: border-box; border: 1px dashed var(--propia-border-input); border-radius: 7px; padding: 5px 7px; font-size: 12px; color: var(--propia-text-body); background: var(--propia-bg-card); outline: none; font-family: inherit; }
    .seg-nf-inp:focus { border-style: solid; border-color: var(--propia-brand); box-shadow: 0 0 0 2px rgba(109,79,227,.12); }
    .seg-c--auto { color: var(--propia-text-faint); font-size: 12px; }
    .seg-row-add { font-size: 11px; font-weight: 700; color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); border-radius: 7px; padding: 5px 8px; cursor: pointer; font-family: inherit; white-space: nowrap; }
    .seg-row-add:hover:not(:disabled) { background: var(--propia-brand-soft); }
    .seg-row-add:disabled { opacity: .5; cursor: default; }
    .seg-row-nuevo { background: var(--propia-ok-soft) !important; box-shadow: inset 3px 0 0 #34C759; }
    .seg-toast { position: sticky; bottom: 10px; margin: 10px auto 0; width: fit-content; background: #15703F; color: var(--propia-bg-card); font-size: 12.5px; font-weight: 600; padding: 8px 16px; border-radius: 9px; cursor: pointer; box-shadow: 0 6px 18px rgba(21,112,63,.28); }

    .seg-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
    .seg-card { text-align: left; border: 1px solid var(--propia-border-card); border-radius: 12px; padding: 14px; background: var(--propia-bg-card); cursor: pointer; display: flex; flex-direction: column; gap: 6px; }
    .seg-card:hover { border-color: var(--propia-brand, var(--propia-brand)); box-shadow: 0 2px 10px rgba(109,79,227,.10); }
    .seg-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .seg-card-aseg { font-weight: 700; color: var(--propia-text-h1); }
    .seg-card-num { font-size: 12.5px; color: var(--propia-text-secondary); }
    .seg-card-meta { font-size: 11.5px; color: var(--propia-text-muted); }

    .seg-group { display: flex; align-items: center; gap: 10px; padding: 10px 16px 6px; border-top: 1px solid var(--propia-border-divider); }
    .seg-group--card { grid-column: 1 / -1; border-top: 0; padding: 6px 2px; }
    .seg-group-t { font-size: 12px; font-weight: 700; color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); border-radius: 8px; padding: 3px 11px; }
    .seg-group-n { font-size: 11.5px; font-weight: 700; color: var(--propia-text-muted); background: var(--propia-bg-card-soft); border-radius: 10px; padding: 1px 9px; }

    .seg-badge { font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 6px; text-transform: uppercase; letter-spacing: .3px; }
    .seg-badge--verde { color: #1A8754; background: var(--propia-ok-soft); }
    .seg-badge--amarillo { color: #B45309; background: #FEF3DC; }
    .seg-badge--rojo { color: #C0383C; background: var(--propia-danger-soft); }
    .seg-badge--none { color: var(--propia-text-muted); background: var(--propia-border-divider); }

    /* Modal */
    .seg-ov { position: fixed; inset: 0; background: rgba(27,42,58,.5); z-index: 1080; }
    .seg-modal { position: fixed; z-index: 1081; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 720px; max-width: calc(100vw - 32px); max-height: calc(100vh - 48px); background: var(--propia-bg-card); border-radius: 16px; box-shadow: 0 24px 60px rgba(27,42,58,.32); display: flex; flex-direction: column; }
    .seg-modal-head { display: flex; align-items: center; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--propia-border-divider); }
    .seg-modal-ic { width: 42px; height: 42px; border-radius: 11px; background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; }
    .seg-modal-title { font-size: 17px; font-weight: 800; color: var(--propia-text-h1); }
    .seg-modal-sub { font-size: 12px; color: var(--propia-text-muted); }
    .seg-x { width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .seg-tabs { display: flex; gap: 4px; padding: 0 20px; border-bottom: 1px solid var(--propia-border-divider); }
    .seg-tabs button { border: 0; background: transparent; color: #7C8A9C; font-size: 13px; font-weight: 700; padding: 10px 14px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .seg-tabs button.on { color: var(--propia-brand, var(--propia-brand)); border-bottom-color: var(--propia-brand, var(--propia-brand)); }
    .seg-tab-n { font-size: 10px; background: var(--propia-border-divider); color: var(--propia-text-secondary); border-radius: 8px; padding: 1px 6px; margin-left: 4px; }
    .seg-modal-body { padding: 16px 20px; overflow-y: auto; }
    .seg-grid-form { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; }
    .seg-col-full { grid-column: 1 / -1; }
    .seg-lbl { display: block; font-size: 11.5px; font-weight: 700; color: var(--propia-text-muted); margin-bottom: 3px; }
    .seg-hint { font-weight: 400; color: var(--propia-text-faint); }
    .seg-input { width: 100%; box-sizing: border-box; border: 1px solid var(--propia-border-card); border-radius: 8px; padding: 8px 10px; font-size: 13px; color: var(--propia-text-body); outline: none; font-family: inherit; background: var(--propia-bg-card); }
    .seg-input:focus { border-color: var(--propia-brand, var(--propia-brand)); }
    .seg-check { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: var(--propia-text-body); cursor: pointer; }
    .seg-check input { accent-color: var(--propia-brand, var(--propia-brand)); }
    .seg-modal-foot { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
    .seg-btn-ghost { padding: 8px 14px; border-radius: 8px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); font-size: 13px; font-weight: 700; color: var(--propia-text-secondary); cursor: pointer; font-family: inherit; }
    .seg-btn-brand { padding: 8px 14px; border-radius: 8px; border: 0; background: var(--propia-brand, var(--propia-brand)); color: var(--propia-bg-card); font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .seg-btn-brand:disabled { opacity: .55; cursor: not-allowed; }
    .seg-banner { margin-top: 12px; padding: 10px 12px; border-radius: 9px; font-size: 12.5px; }
    .seg-banner.err { background: var(--propia-danger-soft); border: 1px solid #F5C2C2; color: #B4232A; }

    .seg-ocr { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; padding: 10px 12px; background: var(--propia-brand-soft-2); border: 1px dashed var(--propia-brand-border); border-radius: 10px; }
    .seg-ocr-btn { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 700; color: var(--propia-brand, var(--propia-brand)); cursor: pointer; }
    .seg-ocr-btn.busy { opacity: .6; pointer-events: none; }
    .seg-ocr-msg { font-size: 11.5px; color: var(--propia-text-secondary); }

    .seg-doc-h { font-size: 11.5px; text-transform: uppercase; letter-spacing: .4px; color: var(--propia-brand, var(--propia-brand)); font-weight: 800; margin-bottom: 8px; }
