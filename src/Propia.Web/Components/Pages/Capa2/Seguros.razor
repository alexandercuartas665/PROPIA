        var ops = OperadoresS(_reglasS[idx].Campo);
        if (!ops.Any(o => o.Key == _reglasS[idx].Op)) _reglasS[idx].Op = ops.First().Key;
        _reglasS[idx].Valor = "";
    }
    private void SetReglaOpS(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglasS.Count) _reglasS[idx].Op = e.Value?.ToString() ?? "es"; }
    private void SetReglaValorS(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglasS.Count) _reglasS[idx].Valor = e.Value?.ToString() ?? ""; }

    private IEnumerable<(string Key, string Label)> CamposFiltroS()
    {
        yield return ("numero", "N poliza");
        yield return ("aseguradora", "Aseguradora");
        yield return ("corredor", "Corredor");
        yield return ("estado", "Vencimiento");
        yield return ("inicio", "Inicio");
        yield return ("fin", "Finalizacion");
        yield return ("valor", "Valor");
        yield return ("reclam", "Reclamaciones");
        foreach (var c in CamposActivos) yield return (c.Id.ToString(), c.Label);
    }
    private PolizaCampoDto? CampoDinS(string campo) => Guid.TryParse(campo, out var g) ? CamposActivos.FirstOrDefault(c => c.Id == g) : null;
    private string FiltroKindS(string campo) => campo switch
    {
        "estado" => "sel-estado",
        "inicio" or "fin" => "fecha",
        "valor" or "reclam" => "num",
        "numero" or "aseguradora" or "corredor" => "texto",
        _ => CampoDinS(campo)?.Tipo switch
        {
            TipoCampoTablero.Numero or TipoCampoTablero.Moneda => "num",
            TipoCampoTablero.Fecha => "fecha",
            TipoCampoTablero.Seleccion => "sel-din",
            TipoCampoTablero.Booleano => "sel-bool",
            _ => "texto"
        }
    };
    private IEnumerable<(string Key, string Label)> OperadoresS(string campo)
    {
        switch (FiltroKindS(campo))
        {
            case "num":
                return new[] { ("=", "es igual a"), ("!=", "es distinto de"), (">", "mayor que"), (">=", "mayor o igual"),
                               ("<", "menor que"), ("<=", "menor o igual"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            case "fecha":
                return new[] { ("es", "es"), ("antes", "antes de"), ("despues", "despues de"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            case "sel-estado":
            case "sel-din":
            case "sel-bool":
                return new[] { ("es", "es"), ("no_es", "no es"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            default:
                return new[] { ("contiene", "contiene"), ("no_contiene", "no contiene"), ("es", "es"), ("no_es", "no es"),
                               ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
        }
    }
    private static string EstadoSemanticS(PolizaDto p) => p.Semaforo switch
    {
        SemaforoContrato.Rojo => "vencida",
        SemaforoContrato.Amarillo => "por-vencer",
        _ => "al-dia"
    };
    private string CampoValorRawS(PolizaDto p, string campo)
    {
        if (!Guid.TryParse(campo, out var g)) return "";
        var cm = CamposActivos.FirstOrDefault(c => c.Id == g);
        if (cm is null) return "";
        var raw = p.CamposValores?.FirstOrDefault(v => v.CampoId == g)?.Valor ?? "";
        if (cm.Tipo == TipoCampoTablero.Booleano) return raw == "true" ? "Si" : (raw == "false" ? "No" : "");
        return raw;
    }
    private string ValorTextoS(PolizaDto p, string campo) => campo switch
    {
        "numero" => p.NumeroPoliza ?? "",
        "aseguradora" => p.Aseguradora ?? "",
        "corredor" => p.Corredor ?? "",
        "estado" => EstadoSemanticS(p),
        "valor" => p.ValorPoliza?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
        "reclam" => p.ReclamacionesCount.ToString(),
        "inicio" => p.FechaInicio?.ToString("yyyy-MM-dd") ?? "",
        "fin" => p.FechaFin?.ToString("yyyy-MM-dd") ?? "",
        _ => CampoValorRawS(p, campo)
    };
    private decimal? ValorNumS(PolizaDto p, string campo)
    {
        if (campo == "valor") return p.ValorPoliza;
        if (campo == "reclam") return p.ReclamacionesCount;
        return decimal.TryParse(CampoValorRawS(p, campo), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    }
    private DateOnly? FechaS(PolizaDto p, string campo)
    {
        if (campo == "inicio") return p.FechaInicio;
        if (campo == "fin") return p.FechaFin;
        return DateOnly.TryParse(CampoValorRawS(p, campo), out var d) ? d : null;
    }
    private static IEnumerable<string> OpcionesDeS(PolizaCampoDto cm) =>
        (cm.Opciones ?? "").Split(new[] { '\n', ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private bool EvalReglaS(PolizaDto p, ReglaS r)
    {
        var kind = FiltroKindS(r.Campo);
        if (kind == "num")
        {
            var nv = ValorNumS(p, r.Campo);
            if (r.Op == "vacio") return nv is null;
            if (r.Op == "no_vacio") return nv is not null;
            if (!decimal.TryParse(r.Valor, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var rv)) return true;
            if (nv is null) return false;
            return r.Op switch { "=" => nv == rv, "!=" => nv != rv, ">" => nv > rv, ">=" => nv >= rv, "<" => nv < rv, "<=" => nv <= rv, _ => true };
        }
        if (kind == "fecha")
        {
            var dv = FechaS(p, r.Campo);
            if (r.Op == "vacio") return dv is null;
            if (r.Op == "no_vacio") return dv is not null;
            if (!DateOnly.TryParse(r.Valor, out var rd)) return true;
            if (dv is null) return false;
            return r.Op switch { "es" => dv == rd, "antes" => dv < rd, "despues" => dv > rd, _ => true };
        }
        var sv = ValorTextoS(p, r.Campo);
        if (r.Op == "vacio") return string.IsNullOrWhiteSpace(sv);
        if (r.Op == "no_vacio") return !string.IsNullOrWhiteSpace(sv);
        if (string.IsNullOrEmpty(r.Valor)) return true;
        return r.Op switch
        {
            "es" => string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_es" => !string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "contiene" => sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_contiene" => !sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }
    // Editor de valor de una regla (segun tipo). Se oculta para vacio/no_vacio.
    private RenderFragment RenderValorS(int idx) => builder =>
    {
        if (idx < 0 || idx >= _reglasS.Count) return;
        var r = _reglasS[idx];
        var kind = FiltroKindS(r.Campo);
        void Sel(IEnumerable<(string Val, string Txt)> opts, string ph)
        {
            builder.OpenElement(0, "select");
            builder.AddAttribute(1, "class", "seg-frule-v");
            builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValorS(idx, e)));
            builder.OpenElement(3, "option");
            builder.AddAttribute(4, "value", "");
            builder.AddAttribute(5, "selected", string.IsNullOrEmpty(r.Valor));
            builder.AddContent(6, ph);
            builder.CloseElement();
            var k = 7;
            foreach (var (val, txt) in opts)
            {
                builder.OpenElement(k++, "option");
                builder.AddAttribute(k++, "value", val);
                builder.AddAttribute(k++, "selected", r.Valor == val);
                builder.AddContent(k++, txt);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        void Inp(string type)
        {
            builder.OpenElement(20, "input");
            builder.AddAttribute(21, "class", "seg-frule-v");
            builder.AddAttribute(22, "type", type);
            builder.AddAttribute(23, "value", r.Valor);
            builder.AddAttribute(24, "placeholder", "Valor");
            builder.AddAttribute(25, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValorS(idx, e)));
            builder.CloseElement();
        }
        switch (kind)
        {
            case "sel-estado": Sel(new[] { ("al-dia", "Al dia"), ("por-vencer", "Por vencer"), ("vencida", "Vencida") }, "Elegir estado..."); break;
            case "sel-din": Sel(OpcionesDeS(CampoDinS(r.Campo)!).Select(o => (o, o)), "Elegir opcion..."); break;
            case "sel-bool": Sel(new[] { ("Si", "Si"), ("No", "No") }, "Elegir..."); break;
            case "num": Inp("number"); break;
            case "fecha": Inp("date"); break;
            default: Inp("text"); break;
        }
    };

    private List<PolizaDto> Filtradas
    {
        get
        {
            var q = _q.Trim();
            var activas = _reglasS.Where(ReglaActivaS).ToList();
            return _polizas.Where(p =>
            {
                if (q != ""
                    && !(p.NumeroPoliza ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                    && !p.Aseguradora.Contains(q, StringComparison.OrdinalIgnoreCase)
                    && !(p.Corredor ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
                    return false;
                if (activas.Count == 0) return true;
                return _logicaS == "or" ? activas.Any(r => EvalReglaS(p, r)) : activas.All(r => EvalReglaS(p, r));
            }).ToList();
        }
    }

    private readonly record struct Fila(bool EsGrupo, string? Grupo, int Count, PolizaDto? Poliza);
    private IEnumerable<Fila> FilasRender()
    {
        if (_agruparPor == "")
        {
            // Sin agrupar: en modo tabla se pagina; en tarjetas se muestran todas. (Con agrupacion
            // se muestran los grupos completos, sin paginar.)
            if (_vista == "tabla")
            {
                var total = Filtradas.Count;
                var totalPag = total == 0 ? 1 : (int)Math.Ceiling(total / (double)_porPagina);
                var pag = Math.Clamp(_pagina, 1, totalPag);
                foreach (var p in Filtradas.Skip((pag - 1) * _porPagina).Take(_porPagina))
                    yield return new Fila(false, null, 0, p);
            }
            else
            {
                foreach (var p in Filtradas) yield return new Fila(false, null, 0, p);
            }
            yield break;
        }
        var grupos = Filtradas
            .GroupBy(p => _agruparPor == "aseguradora"
                ? (string.IsNullOrWhiteSpace(p.Aseguradora) ? "Sin aseguradora" : p.Aseguradora)
                : SemaforoTexto(p.Semaforo))
            .OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase);
        foreach (var g in grupos)
        {
            yield return new Fila(true, g.Key, g.Count(), null);
            foreach (var p in g) yield return new Fila(false, null, 0, p);
        }
    }

    private static string SemaforoTexto(SemaforoContrato s) => s switch
    {
        SemaforoContrato.Verde => "Al dia",
        SemaforoContrato.Amarillo => "Por vencer",
        SemaforoContrato.Rojo => "Vencida",
        _ => "Sin vigencia"
    };

    private static RenderFragment SemaforoBadge(PolizaDto p) => builder =>
    {
        var cls = p.Semaforo switch
        {
            SemaforoContrato.Verde => "verde",
            SemaforoContrato.Amarillo => "amarillo",
            SemaforoContrato.Rojo => "rojo",
            _ => "none"
        };
        var txt = p.Semaforo switch
        {
            SemaforoContrato.Rojo => p.DiasParaVencer is { } d && d < 0 ? "Vencida" : "Critico",
            SemaforoContrato.Amarillo => p.DiasParaVencer is { } d ? $"{d} dias" : "Por vencer",
            SemaforoContrato.Verde => p.DiasParaVencer is { } d ? $"{d} dias" : "Al dia",
            _ => "Sin fin"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"seg-badge seg-badge--{cls}");
        builder.AddContent(2, txt);
        builder.CloseElement();
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                try { var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey); if (v is "tabla" or "tarjetas") _vista = v; } catch { }
                try { var a = await Js.InvokeAsync<string?>("localStorage.getItem", AgruparKey); if (a is "aseguradora" or "estado") _agruparPor = a; } catch { }
                await CargarAsync();
            }
            else { Nav.NavigateTo("/login?returnUrl=%2Fseguros", true); return; }
            StateHasChanged();
        }
        catch { }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    // ---- Alta inline (crear poliza desde la tabla) ----
    private string _npNumero = "", _npAseguradora = "", _npCorredor = "", _npValor = "", _npInicio = "", _npFin = "";
    private bool _creandoInline;
    private string? _inlineMsg;
    private readonly List<Guid> _segRecienCreados = new();

    private async Task CrearPolizaDesdeAltaAsync()
    {
        if (string.IsNullOrWhiteSpace(_npAseguradora)) { _inlineMsg = "Indica la aseguradora para crear la poliza."; return; }
        _creandoInline = true;
        try
        {
            DateOnly? ini = DateOnly.TryParse(_npInicio, out var di) ? di : (DateOnly?)null;
            DateOnly? fin = DateOnly.TryParse(_npFin, out var df) ? df : (DateOnly?)null;
            decimal? valor = decimal.TryParse(_npValor, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var vv) ? vv : null;
            var resp = await Auth().PostAsJsonAsync("/api/seguros/polizas", new CrearPolizaRequest(
                _npAseguradora.Trim(),
                NumeroPoliza: string.IsNullOrWhiteSpace(_npNumero) ? null : _npNumero.Trim(),
                Corredor: string.IsNullOrWhiteSpace(_npCorredor) ? null : _npCorredor.Trim(),
                FechaInicio: ini, FechaFin: fin, ValorPoliza: valor));
            if (resp.IsSuccessStatusCode)
            {
                try { var creada = await resp.Content.ReadFromJsonAsync<PolizaDto>(); if (creada is not null) _segRecienCreados.Add(creada.Id); } catch { }
                _npNumero = ""; _npAseguradora = ""; _npCorredor = ""; _npValor = ""; _npInicio = ""; _npFin = "";
                _inlineMsg = "Poliza creada.";
                await CargarAsync();
            }
            else { _inlineMsg = "No se pudo crear la poliza."; }
        }
        catch (Exception ex) { _inlineMsg = ex.Message; }
        finally { _creandoInline = false; }
    }

    private async Task CargarAsync()
    {
