@page "/seguros"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Seguros
@using Propia.Application.Directorio
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using Propia.Web.Components.Shared
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Seguros - PROPIA</PageTitle>

@* Modulo Seguros (Ola 4): polizas dedicadas. Bandeja al estandar del sistema
   (Tarjetas/Tabla, buscar, agrupar, configurar columnas, expander) + modal con
   pestanas Poliza / Documentos / Reclamaciones y extraccion por OCR. *@

<div class="seg-page">
    <div class="mod-pagehead">
        <div>
            <h1 class="mod-pagetitle">Seguros</h1>
            <p class="mod-pagesub">Polizas de la copropiedad, su vigencia y reclamaciones.</p>
        </div>
        @if (_authChecked && _jwt is not null)
        {
            <div class="seg-head-actions">
                <div class="seg-toggle">
                    <button type="button" class="seg-vt @(_vista == "tarjetas" ? "on" : "")" @onclick='() => SetVista("tarjetas")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                        Tarjetas
                    </button>
                    <button type="button" class="seg-vt @(_vista == "tabla" ? "on" : "")" @onclick='() => SetVista("tabla")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                        Tabla
                    </button>
                </div>
                <button class="propia-btn-brand" @onclick="() => AbrirModal(null)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                    Nueva poliza
                </button>
            </div>
        }
    </div>

    @if (!_authChecked)
    {
        <div class="seg-loading"><div class="spinner-border" style="color: var(--propia-brand, #6D4FE3);"></div></div>
    }
    else if (string.IsNullOrEmpty(_jwt))
    {
        <AuthMessage />
    }
    else
    {
        <div class="mod-stats">
            <div class="mod-stat"><div class="mod-stat-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg></div><div><div class="mod-stat-n">@_polizas.Count</div><div class="mod-stat-l">polizas</div></div></div>
            <div class="mod-stat"><div class="mod-stat-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l5 5 9-11"/></svg></div><div><div class="mod-stat-n">@_polizas.Count(p => p.Semaforo is SemaforoContrato.Verde or SemaforoContrato.Ninguno)</div><div class="mod-stat-l">al dia</div></div></div>
            <div class="mod-stat"><div class="mod-stat-icon" style="background:#FEF3DC;color:#B45309;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div><div><div class="mod-stat-n">@_polizas.Count(p => p.Semaforo == SemaforoContrato.Amarillo)</div><div class="mod-stat-l">por vencer</div></div></div>
            <div class="mod-stat"><div class="mod-stat-icon" style="background:#FDE7E7;color:#C0383C;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg></div><div><div class="mod-stat-n">@_polizas.Count(p => p.Semaforo == SemaforoContrato.Rojo)</div><div class="mod-stat-l">vencidas</div></div></div>
        </div>

        <div class="mod-filtros">
            <div class="seg-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input class="seg-search-inp" placeholder="Buscar por numero, aseguradora, corredor..." @oninput="OnBuscar" />
            </div>
            <div class="mod-filtros-spacer"></div>
            <div class="seg-menu-wrap">
                <button type="button" class="seg-fsel @(_agruparPor != "" ? "on" : "")" @onclick="() => _showAgruparMenu = !_showAgruparMenu" title="Agrupar polizas">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>Agrupar@(_agruparPor != "" ? ": " + AgruparLabel(_agruparPor) : "")
                </button>
                @if (_showAgruparMenu)
                {
                    <div class="seg-menu-bd" @onclick="() => _showAgruparMenu = false"></div>
                    <div class="seg-menu">
                        @foreach (var g in new[] { ("", "Sin agrupar"), ("aseguradora", "Aseguradora"), ("estado", "Vencimiento") })
                        {
                            var gk = g.Item1;
                            <button class="seg-menu-it @(_agruparPor == gk ? "on" : "")" @onclick="() => SetAgruparVal(gk)">@g.Item2</button>
                        }
                    </div>
                }
            </div>
            <button type="button" class="seg-fsel" @onclick="() => _showCampos = true" title="Gestionar campos personalizados">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>Campos
            </button>
        </div>

        @if (_loadError is not null) { <div class="alert alert-danger">@_loadError</div> }

        @if (Filtradas.Count == 0)
        {
            <div class="seg-empty"><strong>Sin polizas.</strong><span>Usa "Nueva poliza" para registrar la primera.</span></div>
        }
        else if (_vista == "tabla")
        {
            <div class="seg-table">
                <div class="seg-scroll">
                    <div class="seg-head seg-grid" style="@GridStyle()">
                        <div></div><div>N POLIZA</div><div>ASEGURADORA</div><div>CORREDOR</div><div>INICIO</div><div>FINALIZACION</div><div>VENCIMIENTO</div><div>VALOR</div><div>RECLAM.</div>
                        @foreach (var cm in CamposActivos) { <div>@cm.Label.ToUpperInvariant()</div> }
                    </div>
                    @foreach (var item in FilasRender())
                    {
                        if (item.EsGrupo)
                        {
                            <div class="seg-group"><span class="seg-group-t">@item.Grupo</span><span class="seg-group-n">@item.Count</span></div>
                            continue;
                        }
                        var p = item.Poliza!;
                        var pp = p;
                        <div class="seg-row seg-grid @(_segRecienCreados.Contains(p.Id) ? "seg-row-nuevo" : "")" style="@GridStyle()">
                            <div class="seg-exp-col">
                                <button type="button" class="seg-exp" title="Abrir la ficha" @onclick="() => AbrirModal(pp.Id)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                </button>
                            </div>
                            <div class="seg-c seg-c--num">@(string.IsNullOrWhiteSpace(p.NumeroPoliza) ? "-" : p.NumeroPoliza)</div>
                            <div class="seg-c seg-c--aseg">@p.Aseguradora</div>
                            <div class="seg-c">@(string.IsNullOrWhiteSpace(p.Corredor) ? "-" : p.Corredor)</div>
                            <div class="seg-c">@(p.FechaInicio?.ToString("dd MMM yyyy") ?? "-")</div>
                            <div class="seg-c">@(p.FechaFin?.ToString("dd MMM yyyy") ?? "-")</div>
                            <div class="seg-c">@SemaforoBadge(p)</div>
                            <div class="seg-c">@(p.ValorPoliza is { } v ? "$" + v.ToString("N0") : "-")</div>
                            <div class="seg-c">@(p.ReclamacionesCount > 0 ? p.ReclamacionesCount.ToString() : "-")</div>
                            @foreach (var cm in CamposActivos) { <div class="seg-c" title="@cm.Label">@(ValorCampoTexto(p, cm) is { Length: > 0 } vv ? vv : "-")</div> }
                        </div>
                    }
                    @* Fila de alta inline: crear poliza desde la tabla (como Zonas Comunes). *@
                    <div class="seg-row seg-newrow seg-grid" style="@GridStyle()">
                        <div class="seg-exp-col">
                            <button type="button" class="seg-exp seg-exp-fijo" title="Crear la poliza" @onclick="CrearPolizaDesdeAltaAsync" disabled="@_creandoInline">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </div>
                        <div class="seg-c"><input class="seg-nf-inp" @bind="_npNumero" @bind:event="oninput" placeholder="N poliza" /></div>
                        <div class="seg-c"><input class="seg-nf-inp" @bind="_npAseguradora" @bind:event="oninput" placeholder="Aseguradora *" /></div>
                        <div class="seg-c"><input class="seg-nf-inp" @bind="_npCorredor" @bind:event="oninput" placeholder="Corredor" /></div>
                        <div class="seg-c"><input type="date" class="seg-nf-inp" value="@_npInicio" @oninput="e => _npInicio = e.Value?.ToString() ?? string.Empty" /></div>
                        <div class="seg-c"><input type="date" class="seg-nf-inp" value="@_npFin" @oninput="e => _npFin = e.Value?.ToString() ?? string.Empty" /></div>
                        <div class="seg-c seg-c--auto">(auto)</div>
                        <div class="seg-c"><input type="number" step="1000" class="seg-nf-inp" @bind="_npValor" @bind:event="oninput" placeholder="Valor" /></div>
                        <div class="seg-c"><button type="button" class="seg-row-add" @onclick="CrearPolizaDesdeAltaAsync" disabled="@_creandoInline">+ Agregar</button></div>
                        @foreach (var cm in CamposActivos) { <div class="seg-c seg-c--auto">-</div> }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_inlineMsg)) { <div class="seg-toast" @onclick="() => _inlineMsg = null">@_inlineMsg</div> }
            </div>
        }
        else
        {
            <div class="seg-cards">
                @foreach (var item in FilasRender())
                {
                    if (item.EsGrupo)
                    {
                        <div class="seg-group seg-group--card"><span class="seg-group-t">@item.Grupo</span><span class="seg-group-n">@item.Count</span></div>
                        continue;
                    }
                    var p = item.Poliza!;
                    var pp = p;
                    <button type="button" class="seg-card" @onclick="() => AbrirModal(pp.Id)">
                        <div class="seg-card-top">
                            <span class="seg-card-aseg">@p.Aseguradora</span>
                            @SemaforoBadge(p)
                        </div>
                        <div class="seg-card-num">@(string.IsNullOrWhiteSpace(p.NumeroPoliza) ? "Sin numero" : "N " + p.NumeroPoliza)</div>
                        <div class="seg-card-meta">
                            @(p.FechaFin is { } f ? "Vence " + f.ToString("dd MMM yyyy") : "Sin vigencia")
                            @(p.ValorPoliza is { } v ? " - $" + v.ToString("N0") : "")
                        </div>
                    </button>
                }
            </div>
        }
    }
</div>

@if (_modal)
{
    <div class="seg-ov" @onclick="() => _modal = false"></div>
    <div class="seg-modal">
        <div class="seg-modal-head">
            <div class="seg-modal-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg></div>
            <div style="flex:1;min-width:0;">
                <div class="seg-modal-title">@(_editId is null ? "Nueva poliza" : (string.IsNullOrWhiteSpace(_f.NumeroPoliza) ? "Poliza" : "Poliza " + _f.NumeroPoliza))</div>
                <div class="seg-modal-sub">@(_editId is null ? "Registra la poliza y su vigencia." : _f.Aseguradora)</div>
            </div>
            <button class="seg-x" @onclick="() => _modal = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        </div>

        @if (_editId is not null)
        {
            <div class="seg-tabs">
                <button class="@(_tab == "poliza" ? "on" : "")" @onclick='() => _tab = "poliza"'>Poliza</button>
                <button class="@(_tab == "docs" ? "on" : "")" @onclick='() => _tab = "docs"'>Documentos</button>
                <button class="@(_tab == "recl" ? "on" : "")" @onclick='AbrirReclamacionesTab'>Reclamaciones <span class="seg-tab-n">@_reclamaciones.Count</span></button>
            </div>
        }

        <div class="seg-modal-body">
            @if (_editId is null || _tab == "poliza")
            {
                @* Cargar PDF con OCR para prellenar (reusa el motor de Super Admin). *@
                <div class="seg-ocr">
                    <label class="seg-ocr-btn @(_ocrBusy ? "busy" : "")">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                        @(_ocrBusy ? "Leyendo poliza..." : "Cargar PDF y extraer con OCR")
                        <InputFile OnChange="OnOcrFile" accept=".pdf,image/*" hidden disabled="@_ocrBusy" />
                    </label>
                    @if (_ocrMsg is not null) { <span class="seg-ocr-msg">@_ocrMsg</span> }
                </div>

                <div class="seg-grid-form">
                    <div class="seg-col-full">
                        <label class="seg-lbl">Aseguradora * <span class="seg-hint">(busca en el Directorio o crea)</span></label>
                        <SelectorPersona Jwt="@_jwt" Seleccionada="_aseguradoraSel" SeleccionadaChanged="OnAseguradoraSel" PermiteEmpresa="true" Placeholder="Buscar aseguradora (empresa o persona)..." />
                        <input class="seg-input" style="margin-top:6px;" @bind="_f.Aseguradora" @bind:event="oninput" placeholder="Nombre de la aseguradora" />
                    </div>
                    <div class="seg-col-full">
                        <label class="seg-lbl">Corredor de seguro <span class="seg-hint">(opcional, del Directorio)</span></label>
                        <SelectorPersona Jwt="@_jwt" Seleccionada="_corredorSel" SeleccionadaChanged="OnCorredorSel" PermiteEmpresa="true" Placeholder="Buscar corredor..." />
                        <input class="seg-input" style="margin-top:6px;" @bind="_f.Corredor" @bind:event="oninput" placeholder="Nombre del corredor" />
                    </div>
                    <div><label class="seg-lbl">Numero de poliza</label><input class="seg-input" @bind="_f.NumeroPoliza" @bind:event="oninput" placeholder="Nro" /></div>
                    <div><label class="seg-lbl">Valor de poliza (COP)</label><input class="seg-input" type="number" step="any" @bind="_f.ValorPoliza" placeholder="0" /></div>
                    <div><label class="seg-lbl">Fecha de inicio</label><input class="seg-input" type="date" @bind="_f.Inicio" /></div>
                    <div><label class="seg-lbl">Fecha de finalizacion</label><input class="seg-input" type="date" @bind="_f.Fin" /></div>
                    <div><label class="seg-lbl">Forma de pago (cuotas)</label><input class="seg-input" type="number" min="1" @bind="_f.FormaPagoCuotas" placeholder="Cuotas" /></div>
                    <div><label class="seg-lbl">Pago mensual</label><label class="seg-check" style="margin-top:6px;"><input type="checkbox" @bind="_f.PagoMensual" /> Se paga mensualmente</label></div>
                    <div class="seg-col-full"><label class="seg-check"><input type="checkbox" @bind="_f.IncluyeZonasUnidades" /> Incluye zonas y unidades privadas</label></div>
                    <div class="seg-col-full"><label class="seg-lbl">Cobertura</label><textarea class="seg-input" rows="2" @bind="_f.Cobertura" placeholder="Condiciones de cobertura"></textarea></div>
                    <div class="seg-col-full"><label class="seg-lbl">Valores agregados</label><textarea class="seg-input" rows="2" @bind="_f.ValoresAgregados"></textarea></div>
                    <div class="seg-col-full"><label class="seg-lbl">Observaciones</label><textarea class="seg-input" rows="2" @bind="_f.Observaciones"></textarea></div>

                    @if (CamposActivos.Any())
                    {
                        <div class="seg-col-full"><div class="seg-doc-h" style="margin-top:4px;">Campos personalizados</div></div>
                        @foreach (var cm in CamposActivos)
                        {
                            var cid = cm.Id;
                            var full = cm.Tipo is TipoCampoTablero.AreaTexto or TipoCampoTablero.Seleccion;
                            <div class="@(full ? "seg-col-full" : "")">
                                <label class="seg-lbl">@cm.Label</label>
                                @switch (cm.Tipo)
                                {
                                    case TipoCampoTablero.AreaTexto:
                                        <textarea class="seg-input" rows="2" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())"></textarea>
                                        break;
                                    case TipoCampoTablero.Numero:
                                    case TipoCampoTablero.Moneda:
                                        <input class="seg-input" type="number" step="any" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Fecha:
                                        <input class="seg-input" type="date" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Booleano:
                                        <label class="seg-check" style="margin-top:6px;"><input type="checkbox" checked="@(Val(cid) == "true")" @onchange='e => SetVal(cid, ((bool)(e.Value ?? false)) ? "true" : "false")' /> Si</label>
                                        break;
                                    case TipoCampoTablero.Seleccion:
                                        <select class="seg-input" value="@Val(cid)" @onchange="e => SetVal(cid, e.Value?.ToString())">
                                            <option value="">- Selecciona -</option>
                                            @foreach (var op in (cm.Opciones ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <option value="@op">@op</option>
                                            }
                                        </select>
                                        break;
                                    default:
                                        <input class="seg-input" value="@Val(cid)" @oninput="e => SetVal(cid, e.Value?.ToString())" />
                                        break;
                                }
                            </div>
                        }
                    }
                </div>
            }
            else if (_tab == "docs")
            {
                <div class="seg-doc-h">Expediente de la poliza (documentos)</div>
                <select class="seg-input" @bind="_f.ExpedienteId">
                    <option value="">- Sin expediente -</option>
                    @foreach (var e in _expedientes) { <option value="@e.Id">@e.Codigo - @e.Nombre</option> }
                </select>
                <p class="seg-doc-note">Conecta el expediente con la poliza, corredor y aseguradora. Los documentos se cargan en el modulo <a href="/documentos">Documentos</a>. Recuerda Guardar.</p>
            }
            else if (_tab == "recl")
            {
                <div class="seg-doc-h">Reclamaciones (@_reclamaciones.Count)</div>
                @if (_reclamaciones.Count > 0)
                {
                    <table class="seg-recl-tbl">
                        <thead><tr><th>Fecha</th><th>Que reclama</th><th>Reclamado</th><th>Estado</th><th>Reconocido</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in _reclamaciones)
                            {
                                var rr = r;
                                <tr>
                                    <td>@r.Fecha.ToString("dd MMM yyyy")</td>
                                    <td>@r.Descripcion</td>
                                    <td>$ @r.MontoReclamado.ToString("N0")</td>
                                    <td><span class="seg-recl-badge @(r.Estado == EstadoReclamacion.Vigente ? "vig" : "cer")">@(r.Estado == EstadoReclamacion.Vigente ? "Vigente" : "Cerrada")</span></td>
                                    <td>@(r.MontoReconocido is { } m ? "$" + m.ToString("N0") : "-")</td>
                                    <td>@if (r.Estado == EstadoReclamacion.Vigente) { <button class="seg-btn-ghost" @onclick="() => AbrirCerrar(rr)">Cerrar</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="seg-doc-note">Sin reclamaciones registradas.</p> }

                @if (_cerrarId is not null)
                {
                    <div class="seg-recl-form">
                        <span>Monto reconocido por la aseguradora:</span>
                        <input class="seg-input seg-mini" type="number" step="any" @bind="_montoReconocido" placeholder="0" />
                        <button class="seg-btn-brand" @onclick="ConfirmarCerrar" disabled="@_busy">Cerrar reclamacion</button>
                        <button class="seg-btn-ghost" @onclick="() => _cerrarId = null">Cancelar</button>
                    </div>
                }
                else
                {
                    <div class="seg-recl-nueva">
                        <div class="seg-doc-h" style="margin-top:14px;">Nueva reclamacion</div>
                        <div class="seg-grid-form">
                            <div><label class="seg-lbl">Fecha</label><input class="seg-input" type="date" @bind="_nrFecha" /></div>
                            <div><label class="seg-lbl">Monto a reclamar</label><input class="seg-input" type="number" step="any" @bind="_nrMonto" placeholder="0" /></div>
                            <div class="seg-col-full"><label class="seg-lbl">Que va a reclamar</label><input class="seg-input" @bind="_nrDesc" @bind:event="oninput" placeholder="Descripcion del siniestro" /></div>
                        </div>
                        <button class="seg-btn-brand" style="margin-top:8px;" @onclick="CrearReclamacion" disabled="@(_busy || string.IsNullOrWhiteSpace(_nrDesc))">Agregar reclamacion</button>
                    </div>
                }
            }

            @if (_modalError is not null) { <div class="seg-banner err">@_modalError</div> }
            @if (_editId is null || _tab == "poliza")
            {
                <div class="seg-modal-foot">
                    <button class="seg-btn-ghost" @onclick="() => _modal = false">Cancelar</button>
                    <button class="seg-btn-brand" @onclick="GuardarAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_f.Aseguradora))">@(_editId is null ? "Crear poliza" : "Guardar poliza")</button>
                </div>
            }
        </div>
    </div>
}

@if (_showCampos)
{
    <div class="seg-ov" @onclick="() => _showCampos = false"></div>
    <div class="seg-modal" style="width:560px;">
        <div class="seg-modal-head">
            <div class="seg-modal-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 6h18M3 12h18M3 18h18"/></svg></div>
            <div style="flex:1;min-width:0;">
                <div class="seg-modal-title">Campos personalizados</div>
                <div class="seg-modal-sub">Campos tipados que apareceran en la ficha y como columnas de la tabla.</div>
            </div>
            <button class="seg-x" @onclick="() => _showCampos = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        </div>
        <div class="seg-modal-body">
            @if (_campos.Count == 0)
            {
                <div class="seg-cm-empty">Aun no hay campos. Crea el primero abajo (ej. "Deducible", "Corredor de contacto", "Renovada el").</div>
            }
            else
            {
                <div class="seg-cm-list">
                    @{ var ordenados = _campos.OrderBy(c => c.Orden).ToList(); }
                    @for (int i = 0; i < ordenados.Count; i++)
                    {
                        var idx = i; var cm = ordenados[idx];
                        <div class="seg-cm-row @(cm.Activo ? "" : "off")">
                            <div class="seg-cm-ord">
                                <button class="seg-cm-mv" disabled="@(idx == 0)" @onclick="() => MoverCampoAsync(ordenados, idx, -1)" title="Subir">&#9650;</button>
                                <button class="seg-cm-mv" disabled="@(idx == ordenados.Count - 1)" @onclick="() => MoverCampoAsync(ordenados, idx, 1)" title="Bajar">&#9660;</button>
                            </div>
                            <input class="seg-cm-nom" value="@cm.Label" @onchange="e => RenombrarCampoAsync(cm, e)" />
                            <span class="seg-cm-tipo">@TipoCampoLabel(cm.Tipo)</span>
                            <label class="seg-cm-sw" title="Mostrar como columna">
                                <input type="checkbox" checked="@cm.Activo" @onchange="() => ToggleCampoActivoAsync(cm)" />
                                <span>@(cm.Activo ? "Visible" : "Oculto")</span>
                            </label>
                            <button class="seg-cm-del" @onclick="() => EliminarCampoAsync(cm.Id)" title="Eliminar campo"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></button>
                        </div>
                    }
                </div>
            }
            <div class="seg-cm-new">
                <div class="seg-doc-h" style="margin-top:14px;">Nuevo campo</div>
                <div class="seg-grid-form">
                    <div><label class="seg-lbl">Nombre del campo</label><input class="seg-input" placeholder="Ej. Deducible" @bind="_nuevoCampoLabel" @bind:event="oninput" /></div>
                    <div>
                        <label class="seg-lbl">Tipo</label>
                        <select class="seg-input" @bind="_nuevoCampoTipo">
                            @foreach (var t in new[] { TipoCampoTablero.Texto, TipoCampoTablero.AreaTexto, TipoCampoTablero.Numero, TipoCampoTablero.Moneda, TipoCampoTablero.Fecha, TipoCampoTablero.Seleccion, TipoCampoTablero.Booleano, TipoCampoTablero.Telefono, TipoCampoTablero.Url, TipoCampoTablero.Email })
                            {
                                <option value="@t">@TipoCampoLabel(t)</option>
                            }
                        </select>
                    </div>
                    @if (_nuevoCampoTipo == TipoCampoTablero.Seleccion)
                    {
                        <div class="seg-col-full"><label class="seg-lbl">Opciones (una por linea)</label><textarea class="seg-input" rows="3" @bind="_nuevoCampoOpciones" @bind:event="oninput"></textarea></div>
                    }
                </div>
                @if (_camposError is not null) { <div class="seg-banner err">@_camposError</div> }
                <button class="seg-btn-brand" style="margin-top:10px;" @onclick="CrearCampoAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoCampoLabel))">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="vertical-align:-2px;margin-right:4px;"><path d="M12 5v14M5 12h14"/></svg>Agregar campo
                </button>
            </div>
        </div>
    </div>
}

