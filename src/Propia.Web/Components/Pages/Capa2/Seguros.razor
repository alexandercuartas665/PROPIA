    private async Task AbrirModal(Guid? id)
    {
        _modalError = null; _ocrMsg = null; _tab = "poliza"; _reclamaciones = new(); _cerrarId = null; _campoValores.Clear();
        if (_expedientes.Count == 0)
        {
            try { _expedientes = await Auth().GetFromJsonAsync<List<ExpedienteLite>>("/api/expedientes") ?? new(); } catch { }
        }
        if (id is null)
        {
            _editId = null; ResetForm(); _aseguradoraSel = null; _corredorSel = null;
        }
        else
        {
            _editId = id;
            var p = _polizas.FirstOrDefault(x => x.Id == id);
            if (p is null) { try { p = await Auth().GetFromJsonAsync<PolizaDto>($"/api/seguros/polizas/{id}"); } catch { } }
            if (p is not null) CargarForm(p);
            try { _reclamaciones = await Auth().GetFromJsonAsync<List<ReclamacionDto>>($"/api/seguros/polizas/{id}/reclamaciones") ?? new(); } catch { }
        }
        _modal = true;
    }

    private void ResetForm()
    {
        _f.Aseguradora = ""; _f.NumeroPoliza = null; _f.AseguradoraPersonaId = _f.AseguradoraEmpresaId = _f.CorredorPersonaId = _f.CorredorEmpresaId = null;
        _f.Corredor = null; _f.Inicio = DateTime.Today; _f.Fin = null; _f.ValorPoliza = null; _f.FormaPagoCuotas = null;
        _f.PagoMensual = false; _f.Cobertura = null; _f.IncluyeZonasUnidades = false; _f.ValoresAgregados = null; _f.Observaciones = null; _f.ExpedienteId = null;
    }

    private void CargarForm(PolizaDto p)
    {
        _f.Aseguradora = p.Aseguradora; _f.NumeroPoliza = p.NumeroPoliza;
        _f.AseguradoraPersonaId = p.AseguradoraPersonaId; _f.AseguradoraEmpresaId = p.AseguradoraEmpresaId;
        _f.CorredorPersonaId = p.CorredorPersonaId; _f.CorredorEmpresaId = p.CorredorEmpresaId; _f.Corredor = p.Corredor;
        _f.Inicio = p.FechaInicio?.ToDateTime(TimeOnly.MinValue); _f.Fin = p.FechaFin?.ToDateTime(TimeOnly.MinValue);
        _f.ValorPoliza = p.ValorPoliza; _f.FormaPagoCuotas = p.FormaPagoCuotas; _f.PagoMensual = p.PagoMensual;
        _f.Cobertura = p.Cobertura; _f.IncluyeZonasUnidades = p.IncluyeZonasUnidades; _f.ValoresAgregados = p.ValoresAgregados;
        _f.Observaciones = p.Observaciones; _f.ExpedienteId = p.ExpedienteId?.ToString();
        _aseguradoraSel = p.AseguradoraEmpresaId is { } ae ? Cand(ae, p.Aseguradora, EntidadDirectorio.Empresa)
            : p.AseguradoraPersonaId is { } ap ? Cand(ap, p.Aseguradora, EntidadDirectorio.Persona) : null;
        _corredorSel = p.CorredorEmpresaId is { } ce ? Cand(ce, p.Corredor ?? "", EntidadDirectorio.Empresa)
            : p.CorredorPersonaId is { } cp ? Cand(cp, p.Corredor ?? "", EntidadDirectorio.Persona) : null;
        _campoValores.Clear();
        if (p.CamposValores is not null)
            foreach (var v in p.CamposValores) _campoValores[v.CampoId] = v.Valor;
    }

    private static PersonaCandidatoDto Cand(Guid id, string nombre, EntidadDirectorio tipo)
        => new(id, nombre, TipoDocumento.CC, "", true, Array.Empty<string>(), tipo);

    private void OnAseguradoraSel(PersonaCandidatoDto? s)
    {
        _aseguradoraSel = s;
        if (s is null) { _f.AseguradoraPersonaId = _f.AseguradoraEmpresaId = null; return; }
        if (s.EntidadTipo == EntidadDirectorio.Empresa) { _f.AseguradoraEmpresaId = s.PersonaId; _f.AseguradoraPersonaId = null; }
        else { _f.AseguradoraPersonaId = s.PersonaId; _f.AseguradoraEmpresaId = null; }
        _f.Aseguradora = s.NombreCompleto;
    }

    private void OnCorredorSel(PersonaCandidatoDto? s)
    {
        _corredorSel = s;
        if (s is null) { _f.CorredorPersonaId = _f.CorredorEmpresaId = null; return; }
        if (s.EntidadTipo == EntidadDirectorio.Empresa) { _f.CorredorEmpresaId = s.PersonaId; _f.CorredorPersonaId = null; }
        else { _f.CorredorPersonaId = s.PersonaId; _f.CorredorEmpresaId = null; }
        _f.Corredor = s.NombreCompleto;
    }

    private async Task GuardarAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_f.Aseguradora)) { _modalError = "La aseguradora es obligatoria."; return; }
        _busy = true;
        try
        {
            DateOnly? ini = _f.Inicio.HasValue ? DateOnly.FromDateTime(_f.Inicio.Value) : null;
            DateOnly? fin = _f.Fin.HasValue ? DateOnly.FromDateTime(_f.Fin.Value) : null;
            Guid? exp = Guid.TryParse(_f.ExpedienteId, out var g) ? g : null;
            HttpResponseMessage resp;
            if (_editId is null)
            {
                resp = await Auth().PostAsJsonAsync("/api/seguros/polizas", new CrearPolizaRequest(
                    _f.Aseguradora.Trim(), _f.NumeroPoliza, _f.AseguradoraPersonaId, _f.AseguradoraEmpresaId,
                    _f.Corredor, _f.CorredorPersonaId, _f.CorredorEmpresaId, ini, fin,
                    _f.ValorPoliza, _f.FormaPagoCuotas, _f.PagoMensual, _f.Cobertura, _f.IncluyeZonasUnidades,
                    _f.ValoresAgregados, _f.Observaciones, exp));
            }
            else
            {
                resp = await Auth().PutAsJsonAsync($"/api/seguros/polizas/{_editId}", new ActualizarPolizaRequest(
                    _f.Aseguradora.Trim(), _f.NumeroPoliza, _f.AseguradoraPersonaId, _f.AseguradoraEmpresaId,
                    _f.Corredor, _f.CorredorPersonaId, _f.CorredorEmpresaId, ini, fin,
                    _f.ValorPoliza, _f.FormaPagoCuotas, _f.PagoMensual, _f.Cobertura, _f.IncluyeZonasUnidades,
                    _f.ValoresAgregados, _f.Observaciones, exp, LimpiarExpediente: exp is null));
            }
            if (!resp.IsSuccessStatusCode) { _modalError = await resp.Content.ReadAsStringAsync(); return; }

            // Resolver el id de la poliza (creada o editada) para persistir los valores de campos.
            Guid? polizaId = _editId;
            if (polizaId is null)
            {
                try { polizaId = (await resp.Content.ReadFromJsonAsync<PolizaDto>())?.Id; } catch { }
            }
            if (polizaId is { } pid)
            {
                foreach (var cm in CamposActivos)
                {
                    var val = _campoValores.TryGetValue(cm.Id, out var vv) ? vv : null;
                    try { await Auth().PutAsJsonAsync($"/api/seguros/polizas/{pid}/campo-valor/{cm.Id}", new GuardarPolizaCampoValorRequest(val)); } catch { }
                }
            }

            _modal = false;
            await CargarAsync();
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _busy = false; }
    }

    // ---- OCR: extrae y prellena ----
    private async Task OnOcrFile(InputFileChangeEventArgs e)
    {
        _ocrBusy = true; _ocrMsg = null;
        try
        {
            var file = e.File;
            using var content = new MultipartFormDataContent();
            var fc = new StreamContent(file.OpenReadStream(15 * 1024 * 1024));
            fc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType);
            content.Add(fc, "file", file.Name);
            var resp = await Auth().PostAsync("/api/ocr/extraer", content);
            if (!resp.IsSuccessStatusCode) { _ocrMsg = "No se pudo leer el documento (" + (int)resp.StatusCode + ")."; return; }
            var r = await resp.Content.ReadFromJsonAsync<OcrResp>();
            if (r is null) { _ocrMsg = "Sin datos."; return; }
            // Prefill best-effort: fecha y valor sugeridos + numero de poliza desde campos/texto.
            if (r.ValorSugerido is { } v && _f.ValorPoliza is null) _f.ValorPoliza = v;
            if (!string.IsNullOrWhiteSpace(r.FechaSugerida) && DateTime.TryParse(r.FechaSugerida, out var fs) && _f.Inicio == DateTime.Today) _f.Inicio = fs;
            var num = r.Campos?.FirstOrDefault(c => c.Nombre.Contains("Policy", StringComparison.OrdinalIgnoreCase) || c.Nombre.Contains("Poliza", StringComparison.OrdinalIgnoreCase))?.Valor;
            if (!string.IsNullOrWhiteSpace(num) && string.IsNullOrWhiteSpace(_f.NumeroPoliza)) _f.NumeroPoliza = num;
            _ocrMsg = $"Documento leido ({r.Proveedor}). Revisa y completa los campos.";
        }
        catch (Exception ex) { _ocrMsg = "Error: " + ex.Message; }
        finally { _ocrBusy = false; }
    }
    private sealed record OcrCampo(string Nombre, string? Valor, double? Confianza);
    private sealed record OcrResp(bool Ok, string? Proveedor, string? Modelo, decimal? ValorSugerido, string? FechaSugerida, List<OcrCampo>? Campos, string? TextoCompleto);

