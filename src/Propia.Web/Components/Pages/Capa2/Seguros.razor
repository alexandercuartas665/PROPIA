    private async Task CrearReclamacion()
    {
        if (_editId is not { } id || string.IsNullOrWhiteSpace(_nrDesc)) return;
        _busy = true;
        try
        {
            var fecha = DateOnly.FromDateTime(_nrFecha ?? DateTime.Today);
            var resp = await Auth().PostAsJsonAsync($"/api/seguros/polizas/{id}/reclamaciones",
                new CrearReclamacionRequest(fecha, _nrMonto ?? 0, _nrDesc.Trim()));
            if (resp.IsSuccessStatusCode)
            {
                _nrDesc = ""; _nrMonto = null; _nrFecha = DateTime.Today;
                _reclamaciones = await Auth().GetFromJsonAsync<List<ReclamacionDto>>($"/api/seguros/polizas/{id}/reclamaciones") ?? _reclamaciones;
                await CargarAsync();
            }
        }
        finally { _busy = false; }
    }

    private void AbrirCerrar(ReclamacionDto r) { _cerrarId = r.Id; _montoReconocido = r.MontoReclamado; }

    private async Task ConfirmarCerrar()
    {
        if (_cerrarId is not { } rid || _editId is not { } id) return;
        _busy = true;
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/seguros/reclamaciones/{rid}/cerrar", new CerrarReclamacionRequest(_montoReconocido ?? 0));
            if (resp.IsSuccessStatusCode)
            {
                _cerrarId = null; _montoReconocido = null;
                _reclamaciones = await Auth().GetFromJsonAsync<List<ReclamacionDto>>($"/api/seguros/polizas/{id}/reclamaciones") ?? _reclamaciones;
            }
        }
        finally { _busy = false; }
    }

    // ---- Gestionar campos personalizados (EAV) ----
    private async Task RecargarCamposAsync()
    {
        try { _campos = await Auth().GetFromJsonAsync<List<PolizaCampoDto>>("/api/seguros/campos") ?? new(); } catch { }
    }

    private async Task CrearCampoAsync()
    {
        _camposError = null;
        if (string.IsNullOrWhiteSpace(_nuevoCampoLabel)) return;
        _busy = true;
        try
        {
            var opciones = _nuevoCampoTipo == TipoCampoTablero.Seleccion ? _nuevoCampoOpciones : null;
            var resp = await Auth().PostAsJsonAsync("/api/seguros/campos",
                new CrearPolizaCampoRequest(_nuevoCampoLabel.Trim(), _nuevoCampoTipo, opciones, null));
            if (!resp.IsSuccessStatusCode) { _camposError = await resp.Content.ReadAsStringAsync(); return; }
            _nuevoCampoLabel = ""; _nuevoCampoTipo = TipoCampoTablero.Texto; _nuevoCampoOpciones = null;
            await RecargarCamposAsync();
        }
        catch (Exception ex) { _camposError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleCampoActivoAsync(PolizaCampoDto cm)
    {
        await Auth().PutAsJsonAsync($"/api/seguros/campos/{cm.Id}",
            new ActualizarPolizaCampoRequest(cm.Label, cm.Tipo, cm.Opciones, cm.Descripcion, cm.Orden, !cm.Activo));
        await RecargarCamposAsync();
    }

    private async Task EliminarCampoAsync(Guid campoId)
    {
        await Auth().DeleteAsync($"/api/seguros/campos/{campoId}");
        await RecargarCamposAsync();
    }

    private async Task RenombrarCampoAsync(PolizaCampoDto cm, ChangeEventArgs e)
    {
        var nombre = e.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(nombre) || nombre == cm.Label) return;
        await Auth().PutAsJsonAsync($"/api/seguros/campos/{cm.Id}",
            new ActualizarPolizaCampoRequest(nombre, cm.Tipo, cm.Opciones, cm.Descripcion, cm.Orden, cm.Activo));
        await RecargarCamposAsync();
    }

    // Reordenar: intercambia el Orden de dos campos y persiste ambos.
    private async Task MoverCampoAsync(List<PolizaCampoDto> ordenados, int idx, int dir)
    {
        var j = idx + dir;
        if (j < 0 || j >= ordenados.Count) return;
        var a = ordenados[idx]; var b = ordenados[j];
        await Auth().PutAsJsonAsync($"/api/seguros/campos/{a.Id}",
            new ActualizarPolizaCampoRequest(a.Label, a.Tipo, a.Opciones, a.Descripcion, b.Orden, a.Activo));
        await Auth().PutAsJsonAsync($"/api/seguros/campos/{b.Id}",
            new ActualizarPolizaCampoRequest(b.Label, b.Tipo, b.Opciones, b.Descripcion, a.Orden, b.Activo));
        await RecargarCamposAsync();
    }
