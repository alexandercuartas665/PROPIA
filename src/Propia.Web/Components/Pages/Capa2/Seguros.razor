    private string _vista = "tabla";
    private const string VistaKey = "propia_view_seguros";
    private string _agruparPor = "";
    private bool _showAgruparMenu;
    private const string AgruparKey = "propia_agrupar_seguros";

    private bool _modal;
    private string _tab = "poliza";
    private Guid? _editId;
    private bool _busy;
    private string? _modalError;
    private readonly Form _f = new();
    private PersonaCandidatoDto? _aseguradoraSel;
    private PersonaCandidatoDto? _corredorSel;

    // OCR
    private bool _ocrBusy;
    private string? _ocrMsg;

    // Reclamaciones
    private List<ReclamacionDto> _reclamaciones = new();
    private DateTime? _nrFecha = DateTime.Today;
    private decimal? _nrMonto;
    private string _nrDesc = "";
    private Guid? _cerrarId;
    private decimal? _montoReconocido;

    // Campos personalizados (EAV)
    private List<PolizaCampoDto> _campos = new();
    private IReadOnlyList<PolizaCampoDto> CamposActivos => _campos.Where(c => c.Activo).OrderBy(c => c.Orden).ToList();
    private readonly Dictionary<Guid, string?> _campoValores = new();  // valores del form actual
    private bool _showCampos;
    private string _nuevoCampoLabel = "";
    private TipoCampoTablero _nuevoCampoTipo = TipoCampoTablero.Texto;
    private string? _nuevoCampoOpciones;
    private string? _camposError;

    private string? Val(Guid campoId) => _campoValores.TryGetValue(campoId, out var v) ? v : null;
    private void SetVal(Guid campoId, string? v) => _campoValores[campoId] = v;

    // Texto a mostrar en la columna de tabla para un campo de una poliza.
    private string ValorCampoTexto(PolizaDto p, PolizaCampoDto cm)
    {
        var raw = p.CamposValores?.FirstOrDefault(v => v.CampoId == cm.Id)?.Valor;
        if (string.IsNullOrWhiteSpace(raw)) return "";
        return cm.Tipo switch
        {
            TipoCampoTablero.Booleano => raw == "true" ? "Si" : "No",
            TipoCampoTablero.Moneda => decimal.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var m) ? "$" + m.ToString("N0") : raw,
            _ => raw
        };
    }

    // grid-template dinamico: base 9 columnas + 1fr por cada campo activo.
    private string GridStyle()
    {
        var extra = CamposActivos.Count;
        var cols = "34px 1.1fr 1.6fr 1.3fr 1fr 1fr 1.1fr 1fr .7fr" + string.Concat(Enumerable.Repeat(" 1fr", extra));
        var min = 1000 + extra * 140;
        return $"grid-template-columns:{cols};min-width:{min}px";
    }

    private static string TipoCampoLabel(TipoCampoTablero t) => t switch
    {
        TipoCampoTablero.Texto => "Texto",
        TipoCampoTablero.AreaTexto => "Texto largo",
        TipoCampoTablero.Numero => "Numero",
        TipoCampoTablero.Moneda => "Moneda",
        TipoCampoTablero.Fecha => "Fecha",
        TipoCampoTablero.Telefono => "Telefono",
        TipoCampoTablero.Seleccion => "Seleccion",
        TipoCampoTablero.Booleano => "Si / No",
        TipoCampoTablero.Url => "URL",
        TipoCampoTablero.Email => "Email",
        _ => t.ToString()
    };

    private sealed class Form
    {
        public string Aseguradora = "";
        public string? NumeroPoliza;
        public Guid? AseguradoraPersonaId, AseguradoraEmpresaId, CorredorPersonaId, CorredorEmpresaId;
        public string? Corredor;
        public DateTime? Inicio = DateTime.Today;
        public DateTime? Fin;
        public decimal? ValorPoliza;
        public int? FormaPagoCuotas;
        public bool PagoMensual;
