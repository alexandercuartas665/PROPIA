@page "/mi-copropiedad"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Web.Components.Shared.Modals
@using Mant = Propia.Application.Mantenimiento
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals

<PageTitle>Mi Copropiedad - PROPIA</PageTitle>

@* Modulo 2.3 Mi Copropiedad - ficha viva con secciones colapsables.
   En MVP el JWT se pega manualmente (la auth completa del cliente vendra en 2.5). *@

<div class="mc-pagehead">
    <div>
        <h1 class="mc-pagetitle">Mi Copropiedad</h1>
        <p class="mc-pagesub">Ficha viva de la PH - configurala aqui, los modulos consumen desde aqui.</p>
    </div>
    @if (_resumen?.CompletitudPct < 100)
    {
        <button class="mc-cta-guia" @onclick="() => _showWizardGuia = !_showWizardGuia">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l1.6 4.2L18 8.4l-3.4 3 1 4.4L12 13.6 8.4 15.8l1-4.4L6 8.4l4.4-1.2L12 3z"/></svg>
            @(_showWizardGuia ? "Cerrar guia" : "Guiame paso a paso")
        </button>
    }
</div>

@if (!_authChecked)
{
    @* Verificando sesion: spinner en vez del bloque de "Necesitas un JWT" para no dar apariencia de error. *@
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <div class="card border-warning p-4">
        <h5>@(_loadError is not null ? "Sesion expirada" : "Necesitas un JWT con tenant activo")</h5>
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <p class="text-danger small mb-3">@_loadError</p>
        }
        <p class="text-muted mb-3">Mi Copropiedad consume el API autenticado. En este MVP pegamos el JWT manualmente
            mientras se completa el login del cliente (modulo 2.5).</p>
        <div class="d-flex gap-2 mb-3">
            <a class="btn btn-dark" href="/onboarding">Crear cuenta nueva</a>
            <a class="btn btn-outline-dark" href="/login">Iniciar sesion</a>
        </div>
        <details>
            <summary class="text-muted small">Pegar JWT manualmente (modo demo)</summary>
            <p class="small text-muted mt-2">El JWT debe traer el claim <code>tenant_id</code>. Se obtiene del onboarding al final del wizard, o de /connect/token + /connect/switch-tenant.</p>
            <textarea class="form-control form-control-sm font-monospace" rows="3" @bind="_jwtInput" placeholder="eyJ..."></textarea>
            <button class="btn btn-sm btn-outline-dark mt-2" @onclick="SetJwt">Usar este JWT</button>
        </details>
    </div>
    return;
}

@if (_resumen is null)
{
    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert alert-danger">
            <strong>No se pudo cargar Mi Copropiedad:</strong> @_loadError
            <button class="btn btn-sm btn-outline-danger ms-3" @onclick="CargarAsync">Reintentar</button>
        </div>
    }
    else
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
}
else
{
    <div class="mc-layout">
    <div class="mc-main">
    @* Hero estilo prototipo PROPIA.dc.html L.423-462: banner + logo + identidad + 4 KPIs. *@
    <div class="mc-hero">
        <div class="mc-hero-banner" style="@HeroBackgroundStyle">
            @if (!HasFachada)
            {
                <svg viewBox="0 0 900 150" preserveAspectRatio="xMidYMax slice" class="mc-hero-skyline" aria-hidden="true">
                    <g fill="#0E1722">
                        <rect x="40" y="50" width="70" height="100"/>
                        <rect x="130" y="20" width="90" height="130"/>
                        <rect x="240" y="65" width="60" height="85"/>
                        <rect x="320" y="35" width="80" height="115"/>
                        <rect x="640" y="55" width="70" height="95"/>
                        <rect x="730" y="25" width="90" height="125"/>
                    </g>
                    <g fill="#fff" opacity=".35">
                        <rect x="150" y="40" width="9" height="9"/><rect x="170" y="40" width="9" height="9"/>
                        <rect x="190" y="40" width="9" height="9"/><rect x="150" y="60" width="9" height="9"/>
                        <rect x="190" y="60" width="9" height="9"/><rect x="340" y="55" width="9" height="9"/>
                        <rect x="360" y="55" width="9" height="9"/><rect x="340" y="75" width="9" height="9"/>
                        <rect x="750" y="45" width="9" height="9"/><rect x="772" y="45" width="9" height="9"/>
                        <rect x="750" y="65" width="9" height="9"/>
                    </g>
                </svg>
                <div class="mc-hero-sun"></div>
            }
            <div class="mc-hero-logo-wrap">
                @if (!string.IsNullOrEmpty(_resumen.Identidad.LogoUrl))
                {
                    <img src="@AbsoluteApiUrl(_resumen.Identidad.LogoUrl)" alt="logo" class="mc-hero-logo-img" />
                }
                else
                {
                    <div class="mc-hero-logo">@(_resumen.Identidad.Nombre is { Length: > 0 } n ? n[..1].ToUpper() : "P")</div>
                }
            </div>
        </div>
        <div class="mc-hero-body">
            <div class="mc-hero-row">
                <div class="mc-hero-info">
                    <div class="mc-hero-title-row">
                        <h2 class="mc-hero-title">@_resumen.Identidad.Nombre</h2>
                        @if (!string.IsNullOrEmpty(_resumen.Identidad.CodigoPropia))
                        {
                            <span class="mc-hero-code">@_resumen.Identidad.CodigoPropia</span>
                        }
                    </div>
                    <div class="mc-hero-addr">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        @(string.IsNullOrEmpty(_resumen.Identidad.Direccion) ? "Sin direccion" : _resumen.Identidad.Direccion)
                        @(string.IsNullOrEmpty(_resumen.Identidad.Ciudad) ? "" : $" - {_resumen.Identidad.Ciudad}")
                    </div>
                    <div class="mc-hero-chips">
                        @if (_resumen.Identidad.Tipo.HasValue) { <span class="mc-chip">@_resumen.Identidad.Tipo</span> }
                        @if (_resumen.Identidad.Estrato.HasValue) { <span class="mc-chip">Estrato @((int)_resumen.Identidad.Estrato.Value)</span> }
                        @if (!string.IsNullOrEmpty(_resumen.Identidad.Nit)) { <span class="mc-chip">NIT @_resumen.Identidad.Nit</span> }
                    </div>
                </div>
            </div>
            <div class="mc-kpis">
                <div class="mc-kpi"><div class="mc-kpi-val">@_resumen.CantidadUnidades</div><div class="mc-kpi-lbl">unidades</div></div>
                <div class="mc-kpi"><div class="mc-kpi-val">@_resumen.CantidadTorres</div><div class="mc-kpi-lbl">torres</div></div>
                <div class="mc-kpi"><div class="mc-kpi-val">@_resumen.CantidadZonasComunes</div><div class="mc-kpi-lbl">zonas comunes</div></div>
                <div class="mc-kpi mc-kpi--brand"><div class="mc-kpi-val">@_resumen.CompletitudPct<span class="mc-kpi-pct">%</span></div><div class="mc-kpi-lbl">completitud</div></div>
            </div>
        </div>
    </div>

    <div class="mc-hitos-head">
        <div class="mc-hitos-title">Hitos de configuracion</div>
        <div class="mc-hitos-sub">Haz clic en cada hito para configurarlo en su panel.</div>
    </div>

    @* Wizard guiado de configuracion - el CTA esta en el header (mc-cta-guia). *@

    @if (_showWizardGuia)
    {
        <ModuloWizard Titulo="Configuracion guiada de tu copropiedad"
                      Descripcion="Te mostramos las secciones clave en orden. Marca cada paso para abrir su seccion y completar lo que falte."
                      FinishLabel="Listo, cerrar guia"
                      OnFinish="@(() => { _showWizardGuia = false; return Task.CompletedTask; })"
                      OnCancel="@(() => { _showWizardGuia = false; return Task.CompletedTask; })">

            <WizardStep Titulo="Identidad"
                        Descripcion="Datos basicos de la PH: nombre, NIT, direccion, tipo, estrato y logo.">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Estado:
                        <span class="badge @(CompIdentidad ? "bg-success" : "bg-warning text-dark")">
                            @(CompIdentidad ? "Completa" : "Pendiente")
                        </span>
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            @onclick="() => IrASeccion(SecIdent)">Abrir seccion ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Nombre, NIT (>30 unidades obligatorio DIAN), direccion y ciudad.</li>
                    <li>Tipo (Residencial/Comercial/Mixto) y estrato.</li>
                    <li>Logo y foto de fachada (opcionales pero recomendados).</li>
                </ul>
            </WizardStep>

            <WizardStep Titulo="Distribucion"
                        Descripcion="Estructura fisica: torres/sectores, pisos y unidades. Define los coeficientes (deben sumar 100%).">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Estado:
                        <span class="badge @(CompDistribucion ? "bg-success" : "bg-warning text-dark")">
                            @(CompDistribucion ? "Completa" : "Pendiente")
                        </span>
                        @if (_resumen.CantidadUnidades > 0)
                        {
                            <span class="badge bg-light text-dark border ms-1">@_resumen.CantidadUnidades unidades</span>
                        }
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            @onclick="() => IrASeccion(SecDistrib)">Abrir seccion ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Crea torres/sectores y define unidades.</li>
                    <li>Generador inteligente para crear todo de un golpe.</li>
                    <li>Importacion via CSV si ya tienes la lista.</li>
                    <li>Coeficientes deben sumar exactamente 100%.</li>
                </ul>
            </WizardStep>

            <WizardStep Titulo="Equipo de trabajo"
                        Descripcion="Personal de la copropiedad: administrador, contador, mantenimiento, vigilancia, aseo.">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Estado:
                        <span class="badge @(CompEquipoTrabajo ? "bg-success" : "bg-warning text-dark")">
                            @(CompEquipoTrabajo ? "Completa" : "Pendiente")
                        </span>
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            @onclick="() => IrASeccion(SecEqTrab)">Abrir seccion ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Vincula al administrador delegado (minimo).</li>
                    <li>Otros roles segun necesidad: contador, todero, vigilancia.</li>
                </ul>
            </WizardStep>

            <WizardStep Titulo="Gobierno"
                        Descripcion="Consejo de Administracion, Comites y Revisor Fiscal segun Ley 675.">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Estado:
                        <span class="badge @(CompGobierno ? "bg-success" : "bg-warning text-dark")">
                            @(CompGobierno ? "Completa" : "Pendiente")
                        </span>
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            @onclick="() => IrASeccion(SecGob)">Abrir seccion ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Consejo de Administracion (residencial obligatorio).</li>
                    <li>Comite de Convivencia (Art. 40 Ley 675).</li>
                    <li>Revisor Fiscal (Art. 38 - obligatorio >30 unidades).</li>
                </ul>
            </WizardStep>

            <WizardStep Titulo="Servicios y activos"
                        Descripcion="Contratos vigentes, zonas comunes y equipos para mantenimiento.">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Servicios: <span class="badge @(CompServicios ? "bg-success" : "bg-warning text-dark")">@(CompServicios ? "OK" : "Pendiente")</span>
                        &nbsp;Zonas: <span class="badge @(CompZonasComunes ? "bg-success" : "bg-warning text-dark")">@(CompZonasComunes ? "OK" : "Pendiente")</span>
                        &nbsp;Equipos: <span class="badge @(CompEquipos ? "bg-success" : "bg-warning text-dark")">@(CompEquipos ? "OK" : "Pendiente")</span>
                    </span>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => IrASeccion(SecSrv)">Servicios ↓</button>
                    @* Zonas y Equipos ya no son secciones de esta pagina: son modulos propios,
                       asi que estos botones navegan en vez de hacer scroll. *@
                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick='() => Nav.NavigateTo("/zonas-comunes")'>Zonas comunes &rarr;</button>
                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick='() => Nav.NavigateTo("/equipos-activos")'>Equipos y activos &rarr;</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Vigilancia, aseo, mantenimiento, jardineria, internet.</li>
                    <li>Zonas comunes (salon, piscina, gimnasio, parqueaderos visitantes).</li>
                    <li>Equipos para programar mantenimientos preventivos en 2.10.</li>
                </ul>
            </WizardStep>

        </ModuloWizard>
    }

    @* Seccion 1 - Identidad *@
    <SeccionCard Titulo="Identidad" Subtitulo="Que es este edificio?" Completa="@CompIdentidad" SinAcordeon="true">
        @* Vista read-only en grid + boton Editar. El form vive en el modal global. *@
        <div class="mc-readgrid">
            <div class="mc-readcell"><div class="mc-readlbl">Nombre</div><div class="mc-readval">@_resumen.Identidad.Nombre</div></div>
            <div class="mc-readcell"><div class="mc-readlbl">Tipo</div><div class="mc-readval">@(_resumen.Identidad.Tipo?.ToString() ?? "-")</div></div>
            <div class="mc-readcell"><div class="mc-readlbl">Estrato</div><div class="mc-readval">@(_resumen.Identidad.Estrato.HasValue ? ((int)_resumen.Identidad.Estrato.Value).ToString() : "-")</div></div>
            <div class="mc-readcell"><div class="mc-readlbl">Ciudad</div><div class="mc-readval">@(_resumen.Identidad.Ciudad ?? "-")</div></div>
            <div class="mc-readcell"><div class="mc-readlbl">Departamento</div><div class="mc-readval">@(_resumen.Identidad.Departamento ?? "-")</div></div>
            <div class="mc-readcell"><div class="mc-readlbl">NIT</div><div class="mc-readval">@(string.IsNullOrEmpty(_resumen.Identidad.Nit) ? "-" : _resumen.Identidad.Nit)</div></div>
        </div>
        <div class="mc-actions">
            <button class="propia-btn-ghost" @onclick="AbrirEditarIdentidadAsync">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar datos
            </button>
            <button class="propia-btn-ghost" @onclick="AbrirBitacoraAsync" title="Bitacora de cambios">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                Bitacora
            </button>
        </div>
    </SeccionCard>

    @* Finanzas ya NO es un hito de Mi Copropiedad: se gestiona desde el grupo de menu Finanzas
       (Presupuesto, Cartera, Servicios, Numeracion). Por eso esta seccion se quito de aqui. *@

    @* Seccion 2 - Distribucion. *@
    @* Distribucion salio de aqui: ahora es su propio modulo (/distribucion), con el resumen,
       la tabla de unidades y el mismo GestionarUnidadesModal. Se quita de la ficha para no
       tener el dato en dos sitios. La completitud (CompDistribucion) se sigue calculando y
       contando: el wizard de arranque sigue guiando a configurar la distribucion. *@

    @* Secciones 3 Equipo, 4 Gobierno y 5 Servicios viven ahora como paginas
       independientes en el nav (2.5 Usuarios y roles, 2.5.1 Gobierno, 2.5.2 Servicios).
       Se mantienen los SeccionCard ocultos para no romper conteo de completitud. *@
    @if (false)
    {
    <SeccionCard Titulo="Equipo de trabajo" Subtitulo="Quienes lo manejan?" Completa="@CompEquipoTrabajo" SinAcordeon="true">
        @* Vista compacta estilo prototipo L.808-816. El detalle vive en GestionarEquipoModal. *@
        @if (_equipo.Count == 0)
        {
            <p class="text-muted small mb-3">Sin personal vinculado a la PH aun.</p>
        }
        else
        {
            <div class="mc-equipo-grid">
                @foreach (var m in _equipo.Where(x => x.Activo).Take(4))
                {
                    var ini = (m.PersonaNombre.Length > 0 ? m.PersonaNombre[0].ToString() : "?")
                            + (m.PersonaNombre.Contains(' ') ? m.PersonaNombre.Split(' ')[^1][0].ToString() : "");
                    <div class="mc-equipo-card">
                        <div class="mc-equipo-avatar">@ini.ToUpper()</div>
                        <div class="mc-equipo-text">
                            <div class="mc-equipo-name">@m.PersonaNombre</div>
                            <div class="mc-equipo-meta">@(m.Rol == RolEquipo.Otro ? (m.RolPersonalizado ?? "Otro") : m.Rol.ToString()) · @m.Tipo</div>
                        </div>
                        <span class="mc-equipo-badge">Activo</span>
                    </div>
                }
            </div>
            @if (_equipo.Count(x => x.Activo) > 4)
            {
                <p class="text-muted small mb-2 mt-2">y @(_equipo.Count(x => x.Activo) - 4) mas...</p>
            }
        }
        <div class="mc-actions">
            <button class="propia-btn-brand" @onclick="AbrirGestionarEquipoAsync">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                Gestionar equipo
            </button>
        </div>
    </SeccionCard>

    @* Seccion 4 - Gobierno (Consejo + Comites + Revisor Fiscal) *@
    <SeccionCard Titulo="Gobierno" Subtitulo="Consejo, comites y revisor fiscal" Completa="@CompGobierno" SinAcordeon="true">
        <div class="mc-gov-summary">
            <div class="mc-gov-stat">
                <div class="mc-gov-stat-val">@_consejo.Count(c => c.Activo)</div>
                <div class="mc-gov-stat-lbl">miembros del consejo</div>
            </div>
            <div class="mc-gov-stat">
                <div class="mc-gov-stat-val">@_comites.Count(c => c.Activo)</div>
                <div class="mc-gov-stat-lbl">comites activos</div>
            </div>
            <div class="mc-gov-stat @(_revisorFiscal is not null ? "mc-gov-stat--ok" : "")">
                <div class="mc-gov-stat-val">@(_revisorFiscal is not null ? "Si" : "No")</div>
                <div class="mc-gov-stat-lbl">revisor fiscal</div>
            </div>
        </div>
        @if (TipoPH == TipoCopropiedad.Residencial && _consejo.Count(c => c.Activo) == 0)
        {
            <div class="mc-gov-alert">
                Ley 675 de 2001: las copropiedades residenciales deben conformar Consejo de Administracion.
            </div>
        }
        @if (TipoPH == TipoCopropiedad.Residencial && !_comites.Any(c => c.Activo && c.Nombre.ToLower().Contains("convivencia")))
        {
            <div class="mc-gov-alert">
                Ley 675 Art. 40: el Comite de Convivencia es obligatorio en copropiedades residenciales.
            </div>
        }
        @if (_revisorFiscal is null && _resumen.CantidadUnidades > 30)
        {
            <div class="mc-gov-alert">
                Ley 675 Art. 38: copropiedades con mas de 30 unidades requieren Revisor Fiscal.
            </div>
        }
        <div class="mc-actions">
            <button class="propia-btn-brand" @onclick="AbrirGestionarGobiernoAsync">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                Gestionar gobierno
            </button>
        </div>
    </SeccionCard>

    @* Seccion 5 - Servicios *@
    <SeccionCard Titulo="Servicios" Subtitulo="Aseo, seguridad, mantenimiento..." Completa="@CompServicios" SinAcordeon="true">
        <div class="mc-srv-summary">
            <div class="mc-srv-stat">
                <div class="mc-srv-stat-val">@_contratos.Count(c => c.Estado == EstadoContrato.Vigente)</div>
                <div class="mc-srv-stat-lbl">vigentes</div>
            </div>
            <div class="mc-srv-stat">
                <div class="mc-srv-stat-val">@_contratos.Count(c => c.Estado == EstadoContrato.EnRenovacion)</div>
                <div class="mc-srv-stat-lbl">en renovacion</div>
            </div>
            <div class="mc-srv-stat @(_contratos.Any(c => c.AlertaVencimiento) ? "mc-srv-stat--warn" : "")">
                <div class="mc-srv-stat-val">@_contratos.Count(c => c.AlertaVencimiento)</div>
                <div class="mc-srv-stat-lbl">por vencer</div>
            </div>
        </div>
        @if (_contratos.Count > 0)
        {
            <div class="mc-srv-chips">
                @foreach (var grupo in _contratos.GroupBy(c => c.Tipo).OrderBy(g => g.Key))
                {
                    <span class="mc-srv-chip">@grupo.Key (@grupo.Count())</span>
                }
            </div>
        }
        <div class="mc-actions">
            <button class="propia-btn-brand" @onclick="AbrirGestionarServiciosAsync">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                Gestionar servicios
            </button>
        </div>
    </SeccionCard>
    }

    @* Seccion 6 - Zonas Comunes *@


    @* Seccion 2 - Finanzas (movida al puesto 2 desde el final). Placeholder vacio:
       el contenido real se renderiza justo despues de Identidad mas arriba. *@
    @if (false)
    {
    <SeccionCard Titulo="(reservado) Finanzas" Completa="@CompFinanzas" Abierta="@_secciones[SecFin]" OnToggle="() => ToggleSec(SecFin)">
        @if (_finanzas is null)
        {
            <p class="text-muted small mb-0">Cargando...</p>
        }
        else
        {
            var sim = _monedas.FirstOrDefault(m => m.Codigo == _finForm.Moneda)?.Simbolo ?? "$";

            @* Resumen financiero en tiempo real (se nutre de 2.6 Presupuesto y 2.7 Cartera) *@
            <div class="row g-2 mb-1">
                <div class="col-6 col-md-3">
                    <div class="fin-kpi"><div class="fin-kpi-label">Cuota administracion</div>
                        <div class="fin-kpi-val">@sim @_finanzas.Resumen.CuotaAdministracionVigente.ToString("N0")</div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fin-kpi"><div class="fin-kpi-label">Recaudo del mes</div>
                        <div class="fin-kpi-val">@_finanzas.Resumen.RecaudoMesPct.ToString("0.#")%</div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fin-kpi"><div class="fin-kpi-label">Presupuesto anual</div>
                        <div class="fin-kpi-val">@sim @_finanzas.Resumen.PresupuestoAnualAprobado.ToString("N0")</div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fin-kpi"><div class="fin-kpi-label">Cartera en mora</div>
                        <div class="fin-kpi-val text-danger">@sim @_finanzas.Resumen.CarteraEnMora.ToString("N0")</div></div>
                </div>
            </div>
            @if (!_finanzas.Resumen.HayPresupuestoVigente)
            {
                <p class="text-muted small mb-0">El resumen se completa cuando exista un presupuesto vigente en 2.6 Presupuesto.</p>
            }

            <hr />
            <h6 class="mb-2">Parametros de configuracion</h6>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small mb-1">Moneda</label>
                    <select class="form-select form-select-sm" @bind="_finForm.Moneda">
                        @foreach (var m in _monedas) { <option value="@m.Codigo">@m.Codigo - @m.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Dia de corte (1-28)</label>
                    <input type="number" min="1" max="28" class="form-control form-control-sm" @bind="_finForm.DiaCorte" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Periodo de gracia (dias)</label>
                    <input type="number" min="0" max="30" class="form-control form-control-sm" @bind="_finForm.PeriodoGraciaDias" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Tasa de interes por mora</label>
                    <select class="form-select form-select-sm" @bind="MoraModo">
                        <option value="legal">Tasa legal vigente (automatica)</option>
                        <option value="fija">Tasa fija</option>
                    </select>
                </div>
                @if (!_finForm.TasaMoraEsLegal)
                {
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Tasa fija mensual (%)</label>
                        <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="_finForm.TasaMoraValor" />
                        <div class="form-text small">Maximo legal: @_finanzas.Parametros.TasaMoraMaximaLegal.ToString("0.##")% mensual</div>
                    </div>
                }
            </div>

            @if (_finForm.DiaCorte != _diaCorteOriginal)
            {
                <div class="alert alert-warning py-2 mt-3 mb-0 small">Cambiar el dia de corte afecta la facturacion a partir del proximo periodo.</div>
            }
            @if (_finConfirmMoneda)
            {
                <div class="alert alert-warning py-2 mt-3 mb-0 small">
                    <strong>Advertencia:</strong> cambiar la moneda impacta todos los valores monetarios de la copropiedad. Confirma para continuar.
                </div>
            }

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-sm" style="background: var(--propia-primary); color:#fff;" @onclick="GuardarFinanzas">
                    @(_finConfirmMoneda ? "Confirmar cambio de moneda y guardar" : "Guardar parametros")
                </button>
                @if (_finConfirmMoneda)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => { _finForm.Moneda = _monedaOriginal!; _finConfirmMoneda = false; })">Cancelar</button>
                }
            </div>
        }
    </SeccionCard>
    }

    @* Bitacora de cambios (RN-06): ahora vive en BitacoraCambiosModal, accesible desde
       el boton "Bitacora" al lado de "Editar datos" en la seccion 1 (Identidad). *@

    @if (!string.IsNullOrEmpty(_actionMsg))
    {
        <div class="alert @_actionMsgClass mt-3">@_actionMsg</div>
    }
    </div>@* /mc-main *@

    @* Asistente Ask AI anclado a la derecha (right rail). Se puede ocultar/mostrar
       como el sidebar; el estado se persiste en localStorage. *@
    @if (_asistenteVisible)
    {
        <aside class="mc-rail">
            <button class="mc-rail-collapse" type="button" @onclick="ToggleAsistenteAsync" title="Ocultar asistente">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>
            <AskAi Jwt="@_jwt" Titulo="Asistente de Mi Copropiedad" Docked="true" />
        </aside>
    }
    </div>@* /mc-layout *@

    @if (!_asistenteVisible)
    {
        <button class="mc-rail-reopen" type="button" @onclick="ToggleAsistenteAsync" title="Mostrar asistente">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            <span>Asistente</span>
        </button>
    }
}

<style>
