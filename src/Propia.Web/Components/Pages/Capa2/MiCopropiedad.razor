    // ---------- Generador inteligente + Import CSV + navegacion a ficha ----------
    private bool _showGenerador;
    private bool _showImport;
    private string _csvInput = "";
    private List<ImportacionFilaError>? _csvErrores;
    private GeneradorState _gen = new();

    private string LabelAgrupacionSingular => string.IsNullOrWhiteSpace(_resumen?.Identidad.LabelAgrupacion) ? "Torre" : _resumen!.Identidad.LabelAgrupacion!;
    private string LabelAgrupacionPlural => LabelAgrupacionSingular + "s";
    private string LabelPisoSingular => string.IsNullOrWhiteSpace(_resumen?.Identidad.LabelPiso) ? "Piso" : _resumen!.Identidad.LabelPiso!;

    private string PreviewGenerador
    {
        get
        {
            var total = _gen.Torres.Sum(t => t.CantidadPisos * t.UnidadesPorPiso);
            if (total <= 0) return "Completa los datos para ver la vista previa.";
            var detalle = string.Join(" · ", _gen.Torres
                .Where(t => !string.IsNullOrWhiteSpace(t.Nombre) && t.CantidadPisos > 0 && t.UnidadesPorPiso > 0)
                .Select(t => $"{t.Nombre} {t.CantidadPisos * t.UnidadesPorPiso}u"));
            return $"{total} unidades a generar — {detalle}";
        }
    }

    private void AgregarTorreGen() => _gen.Torres.Add(new GeneradorTorreState());
    private void RemoverTorreGen(int idx) { if (idx >= 0 && idx < _gen.Torres.Count) _gen.Torres.RemoveAt(idx); if (_gen.Torres.Count == 0) AgregarTorreGen(); }

    private async Task EjecutarGenerador()
    {
        _busy = true;
        var http = Auth();
        var req = new GenerarUnidadesRequest(
            _gen.Torres.Where(t => !string.IsNullOrWhiteSpace(t.Nombre)).Select(t => new GeneradorTorreDto(t.Nombre.Trim(), t.CantidadPisos, t.UnidadesPorPiso)).ToList(),
            _gen.Patron, _gen.TipoUnidadDefault, _gen.CoeficientePorUnidad);
        var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/unidades/generar", req);
        if (resp.IsSuccessStatusCode)
        {
            var r = await resp.Content.ReadFromJsonAsync<GenerarUnidadesResponse>();
            Msg($"Generadas {r!.TorresCreadas} {LabelAgrupacionPlural.ToLower()} y {r.UnidadesCreadas} unidades.", true);
            _gen = new();
            _showGenerador = false;
            await CargarAsync();
        }
        else Msg(await resp.Content.ReadAsStringAsync(), false);
        _busy = false;
    }

    private async Task EjecutarImportCsv()
    {
        _busy = true;
        _csvErrores = null;
        var http = Auth();
        var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/unidades/importar-csv", new ImportarUnidadesRequest(_csvInput));
        var body = await resp.Content.ReadFromJsonAsync<ImportarUnidadesResponse>();
        if (body is null) { Msg("Respuesta vacia.", false); _busy = false; return; }
        if (body.Aceptado)
        {
            Msg($"Importadas {body.UnidadesCreadas} unidades (suma coef. {body.SumaCoeficientes:0.0000}%).", true);
            _csvInput = "";
            _showImport = false;
            await CargarAsync();
        }
        else
        {
            _csvErrores = body.Errores.ToList();
            Msg($"Importacion rechazada por {_csvErrores.Count} errores.", false);
        }
        _busy = false;
    }

