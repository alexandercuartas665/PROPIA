@code {
    private const string SecIdent = "ident";
    private const string SecDistrib = "distrib";
    private const string SecEqTrab = "eqtrab";
    private const string SecGob = "gob";
    private const string SecSrv = "srv";
    private const string SecZon = "zon";
    private const string SecEq = "eq";
    private const string SecFin = "fin";

    private string? _jwt;
    private string _jwtInput = "";
    private bool _busy;
    private string? _actionMsg;
    private string _actionMsgClass = "alert-info";
    private string? _loadError;

    private Dictionary<string, bool> _secciones = new()
    {
        // Spec 2.3: Identidad y Finanzas siempre expandidas por defecto.
        [SecIdent] = true, [SecDistrib] = true, [SecEqTrab] = false,
        [SecGob] = false, [SecSrv] = false, [SecZon] = false, [SecEq] = false,
        [SecFin] = true
    };

    private ResumenMiCopropiedadDto? _resumen;
    private IdentForm _identForm = new();
    private List<TorreDto> _torres = new();
    private List<UnidadDto> _unidades = new();
    private List<MiembroConsejoDto> _consejo = new();
    private List<ContratoServicioDto> _contratos = new();
    private List<ZonaComunDto> _zonas = new();
    private List<EquipoActivoDto> _equipos = new();

    // Sec 3 Equipo + Sec 4 ampliada
    private List<MiembroEquipoDto> _equipo = new();
    private List<ComiteDto> _comites = new();
    private RevisorFiscalDto? _revisorFiscal;
    private NuevoEquipoMiembro _nuevoEq = new();
    private NuevoConsejoMiembro _nuevoConsejo = new() { FechaInicio = DateTime.Today };
    private NuevoComite _nuevoComite = new() { FechaConformacion = DateTime.Today };
    private NuevoRevisorFiscal _nuevoRev = new() { FechaPosesion = DateTime.Today };

    // Bitacora de cambios (RN-06)
    private List<BitacoraEntradaDto> _bitacora = new();

    // Sec 8 Finanzas
    private FinanzasDto? _finanzas;
    private List<MonedaDto> _monedas = new();
    private FinForm _finForm = new();
    private string? _monedaOriginal;
    private int _diaCorteOriginal = 1;
    private bool _finConfirmMoneda;

    private NuevaTorre _nuevaTorre = new();
    private NuevaUnidad _nuevaUnidad = new();
    private NuevoContrato _nuevoContrato = new() { FechaInicio = DateTime.Today };
    private NuevaZona _nuevaZona = new();
    private NuevoEquipo _nuevoEquipo = new();

    private async Task ToggleSec(string s)
    {
        _secciones[s] = !_secciones[s];
        // Persistir estado por usuario (RN-24). No bloqueante.
        if (_jwt is null) return;
        var colapsadas = string.Join(",", _secciones.Where(kv => !kv.Value).Select(kv => kv.Key));
        try { await Auth().PutAsJsonAsync("/api/preferencias/mi-copropiedad-secciones", new { colapsadas }); } catch { }
    }

    private record SeccionesPref(string? Colapsadas);

    // Wizard guiado (frente E) - abre la seccion + intenta scrollear (best-effort).
    private bool _showWizardGuia;
    private async Task IrASeccion(string s)
    {
        _secciones[s] = true;
        try { await Js.InvokeVoidAsync("eval", $"document.querySelector('.propia-sec.sec-abierta')?.scrollIntoView({{behavior:'smooth', block:'start'}})"); }
        catch { /* prerender o JS no disponible */ }
    }

    private bool Comp(string key) => _resumen?.SeccionesCompletas?.GetValueOrDefault(key) ?? false;
    private bool CompIdentidad => Comp("Identidad");
    private bool CompDistribucion => Comp("Distribucion");
    private bool CompGobierno => Comp("Gobierno");
    private bool CompEquipoTrabajo => Comp("EquipoTrabajo");
    private bool CompServicios => Comp("Servicios");
    private bool CompZonasComunes => Comp("ZonasComunes");
    private bool CompEquipos => Comp("Equipos");
    private bool CompFinanzas => Comp("Finanzas");

    // Hero card foto fachada (spec A2/A3)
    private bool HasFachada => !string.IsNullOrEmpty(_resumen?.Identidad?.FotoFachadaUrl);
    private string HeroBackgroundStyle => HasFachada
        ? $"background-image: linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)), url('{AbsoluteApiUrl(_resumen!.Identidad.FotoFachadaUrl)}'); background-size: cover; background-position: center;"
        : "";
    private TipoCopropiedad? TipoPH => _resumen?.Identidad?.Tipo;

    private static string AbsoluteApiUrl(string? relUrl)
    {
        if (string.IsNullOrEmpty(relUrl)) return "";
        if (relUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return relUrl;
        // El API esta en https://localhost:7100 en dev. Las imagenes se sirven desde alli.
        return $"https://localhost:7100{(relUrl.StartsWith('/') ? "" : "/")}{relUrl}";
    }

    private async Task SetJwt()
    {
        if (string.IsNullOrWhiteSpace(_jwtInput)) return;
        _jwt = _jwtInput.Trim();
        await Js.InvokeVoidAsync("sessionStorage.setItem", "propia_jwt", _jwt);
        await CargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { /* primera render server-side - se reintenta cuando llega Blazor interactivo */ }
    }

    private async Task CargarAsync()
    {
        _busy = true;
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/resumen");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await InvalidarSesionAsync("Tu sesion expiro. Vuelve a iniciar sesion para continuar.");
                return;
            }
            resp.EnsureSuccessStatusCode();
            _resumen = await resp.Content.ReadFromJsonAsync<ResumenMiCopropiedadDto>();
            if (_resumen is null) return;
            _identForm = new IdentForm
            {
                Nombre = _resumen.Identidad.Nombre,
                Nit = _resumen.Identidad.Nit,
                DigitoVerificacion = _resumen.Identidad.DigitoVerificacion,
                Direccion = _resumen.Identidad.Direccion,
                Ciudad = _resumen.Identidad.Ciudad,
                Departamento = _resumen.Identidad.Departamento,
                Tipo = _resumen.Identidad.Tipo,
                Estrato = _resumen.Identidad.Estrato,
                LogoUrl = _resumen.Identidad.LogoUrl,
                FotoFachadaUrl = _resumen.Identidad.FotoFachadaUrl,
                Descripcion = _resumen.Identidad.Descripcion,
                NumeroReglamentoPh = _resumen.Identidad.NumeroReglamentoPh,
                NotariaRegistro = _resumen.Identidad.NotariaRegistro,
                MatriculaInmobiliaria = _resumen.Identidad.MatriculaInmobiliaria,
                LicenciaConstruccion = _resumen.Identidad.LicenciaConstruccion,
                FechaConstitucion = _resumen.Identidad.FechaConstitucion,
                LabelAgrupacion = _resumen.Identidad.LabelAgrupacion,
                LabelPiso = _resumen.Identidad.LabelPiso,
                TelefonoContacto = _resumen.Identidad.TelefonoContacto,
                EmailContacto = _resumen.Identidad.EmailContacto
            };
            _torres = await http.GetFromJsonAsync<List<TorreDto>>("/api/mi-copropiedad/torres") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            _consejo = await http.GetFromJsonAsync<List<MiembroConsejoDto>>("/api/mi-copropiedad/consejo") ?? new();
            _contratos = await http.GetFromJsonAsync<List<ContratoServicioDto>>("/api/mi-copropiedad/contratos") ?? new();
            _zonas = await http.GetFromJsonAsync<List<ZonaComunDto>>("/api/mi-copropiedad/zonas") ?? new();
            _equipos = await http.GetFromJsonAsync<List<EquipoActivoDto>>("/api/mi-copropiedad/equipos") ?? new();
            _equipo = await http.GetFromJsonAsync<List<MiembroEquipoDto>>("/api/mi-copropiedad/equipo") ?? new();
            _comites = await http.GetFromJsonAsync<List<ComiteDto>>("/api/mi-copropiedad/comites") ?? new();
            var revResp = await http.GetAsync("/api/mi-copropiedad/revisor-fiscal");
            _revisorFiscal = revResp.StatusCode == System.Net.HttpStatusCode.NoContent ? null
                : await revResp.Content.ReadFromJsonAsync<RevisorFiscalDto>();

            // Seccion 8 - Finanzas
            _monedas = await http.GetFromJsonAsync<List<MonedaDto>>("/api/mi-copropiedad/finanzas/monedas") ?? new();
            _finanzas = await http.GetFromJsonAsync<FinanzasDto>("/api/mi-copropiedad/finanzas");
            if (_finanzas is not null)
            {
                var p = _finanzas.Parametros;
                _finForm = new FinForm
                {
                    Moneda = p.Moneda, DiaCorte = p.DiaCorte, TasaMoraEsLegal = p.TasaMoraEsLegal,
                    TasaMoraValor = p.TasaMoraValor, PeriodoGraciaDias = p.PeriodoGraciaDias
                };
                _monedaOriginal = p.Moneda;
                _diaCorteOriginal = p.DiaCorte;
                _finConfirmMoneda = false;
            }

            // Bitacora de cambios (RN-06)
            _bitacora = await http.GetFromJsonAsync<List<BitacoraEntradaDto>>("/api/mi-copropiedad/bitacora?limit=30") ?? new();

            // Estado de secciones por usuario (RN-24): restaurar colapsadas guardadas
            try
            {
                var sec = await http.GetFromJsonAsync<SeccionesPref>("/api/preferencias/mi-copropiedad-secciones");
                if (!string.IsNullOrWhiteSpace(sec?.Colapsadas))
                {
                    var colapsadas = sec!.Colapsadas!.Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
                    foreach (var key in _secciones.Keys.ToList())
                        _secciones[key] = !colapsadas.Contains(key);
                }
            }
            catch { /* sin preferencia guardada: se mantienen los defaults */ }
        }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _busy = false; }
    }

    // ---------- Sec 8 Finanzas ----------
    private async Task GuardarFinanzas()
    {
        // RN-16: cambiar la moneda requiere confirmacion explicita.
        if (_finForm.Moneda != _monedaOriginal && !_finConfirmMoneda)
        {
            _finConfirmMoneda = true;
            return;
        }
        try
        {
            var http = Auth();
            var req = new
            {
                moneda = _finForm.Moneda,
                diaCorte = _finForm.DiaCorte,
                tasaMoraEsLegal = _finForm.TasaMoraEsLegal,
                tasaMoraValor = _finForm.TasaMoraEsLegal ? (decimal?)null : _finForm.TasaMoraValor,
                periodoGraciaDias = _finForm.PeriodoGraciaDias
            };
            var resp = await http.PutAsJsonAsync("/api/mi-copropiedad/finanzas", req);
            if (resp.IsSuccessStatusCode)
            {
                _finConfirmMoneda = false;
                await CargarAsync();  // refresca parametros + completitud + resumen
                Msg("Parametros financieros guardados.", true);
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<ApiError>();
                Msg(err?.Error ?? "No se pudo guardar.", false);
            }
        }
        catch (Exception ex) { Msg(ex.Message, false); }
    }

    private record ApiError(string? Error);

    // Bindeo string del modo de mora (evita el problema de bindear <select> a bool).
    private string MoraModo
    {
        get => _finForm.TasaMoraEsLegal ? "legal" : "fija";
        set => _finForm.TasaMoraEsLegal = value != "fija";
    }

    private class FinForm
    {
        public string Moneda { get; set; } = "COP";
        public int DiaCorte { get; set; } = 1;
        public bool TasaMoraEsLegal { get; set; } = true;
        public decimal? TasaMoraValor { get; set; }
        public int PeriodoGraciaDias { get; set; }
    }

    // ---------- Upload imagenes (A2/A3) ----------
    private Task SubirLogoAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e) => SubirImagenAsync(e, "logo");
    private Task SubirFachadaAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e) => SubirImagenAsync(e, "fachada");
    private async Task SubirImagenAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e, string tipo)
    {
        if (e.File is null) { Msg("Sin archivo.", false); return; }
        if (e.File.Size > 5_000_000) { Msg("Maximo 5 MB.", false); return; }
        try
        {
            using var content = new MultipartFormDataContent();
            await using var fs = e.File.OpenReadStream(5_000_000);
            using var sc = new StreamContent(fs);
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(e.File.ContentType);
            content.Add(sc, "file", e.File.Name);

            var http = Auth();
            var resp = await http.PostAsync($"/api/uploads/imagen/{tipo}", content);
            if (!resp.IsSuccessStatusCode)
            {
                Msg($"Subida fallo: {await resp.Content.ReadAsStringAsync()}", false);
                return;
            }
            var body = await resp.Content.ReadFromJsonAsync<UploadResponse>();
            if (body is null) return;
            if (tipo == "logo") _identForm.LogoUrl = body.Url;
            else if (tipo == "fachada") _identForm.FotoFachadaUrl = body.Url;
            Msg($"Imagen {tipo} subida. Guarda identidad para confirmar.", true);
        }
        catch (Exception ex) { Msg(ex.Message, false); }
    }
    private record UploadResponse(string Url);

    // ---------- Sec 3 Equipo ----------
    private async Task AgregarMiembroEquipo()
    {
        if (string.IsNullOrWhiteSpace(_nuevoEq.Documento) || string.IsNullOrWhiteSpace(_nuevoEq.Nombres) || string.IsNullOrWhiteSpace(_nuevoEq.Apellidos))
        {
            Msg("Documento, nombres y apellidos son obligatorios.", false);
            return;
        }
        var http = Auth();
        // 1) Vincular o crear Persona
        var vincResp = await http.PostAsJsonAsync("/api/mi-copropiedad/vincular-persona",
            new VincularPersonaPorDocumentoRequest(_nuevoEq.Documento, _nuevoEq.Nombres, _nuevoEq.Apellidos, _nuevoEq.Email, _nuevoEq.Telefono));
        if (!vincResp.IsSuccessStatusCode) { Msg(await vincResp.Content.ReadAsStringAsync(), false); return; }
        var vinc = await vincResp.Content.ReadFromJsonAsync<VincularResponse>();
        if (vinc is null) return;

        // 2) Agregar al equipo
        var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/equipo",
            new AgregarMiembroEquipoRequest(vinc.PersonaId, _nuevoEq.Rol,
                _nuevoEq.Rol == RolEquipo.Otro ? _nuevoEq.RolPersonalizado : null,
                _nuevoEq.Tipo, DateOnly.FromDateTime(DateTime.Today),
                _nuevoEq.Telefono, _nuevoEq.Email, null));
        if (resp.IsSuccessStatusCode) { _nuevoEq = new(); await CargarAsync(); Msg("Miembro vinculado.", true); }
        else Msg(await resp.Content.ReadAsStringAsync(), false);
    }
    private async Task DesactivarMiembroEquipo(Guid id) { await Auth().DeleteAsync($"/api/mi-copropiedad/equipo/{id}"); await CargarAsync(); }
    private record VincularResponse(Guid PersonaId);

    // ---------- Sec 4: Comites ----------
    private async Task CrearComite()
    {
        if (string.IsNullOrWhiteSpace(_nuevoComite.Nombre)) { Msg("Nombre del comite obligatorio.", false); return; }
        var http = Auth();
        var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/comites",
            new CrearComiteRequest(_nuevoComite.Nombre, _nuevoComite.Descripcion, DateOnly.FromDateTime(_nuevoComite.FechaConformacion)));
        if (resp.IsSuccessStatusCode) { _nuevoComite = new() { FechaConformacion = DateTime.Today }; await CargarAsync(); }
        else Msg(await resp.Content.ReadAsStringAsync(), false);
    }
    private async Task DesactivarComite(Guid id)
    {
        await Auth().PutAsync($"/api/mi-copropiedad/comites/{id}/desactivar", null);
        await CargarAsync();
    }

    // ---------- Sec 4: Consejo de Administracion ----------
    private async Task AgregarMiembroConsejo()
    {
        if (string.IsNullOrWhiteSpace(_nuevoConsejo.Documento) || string.IsNullOrWhiteSpace(_nuevoConsejo.Nombres) || string.IsNullOrWhiteSpace(_nuevoConsejo.Apellidos))
        {
            Msg("Documento, nombres y apellidos son obligatorios.", false);
            return;
        }
        var http = Auth();
        var vincResp = await http.PostAsJsonAsync("/api/mi-copropiedad/vincular-persona",
            new VincularPersonaPorDocumentoRequest(_nuevoConsejo.Documento, _nuevoConsejo.Nombres, _nuevoConsejo.Apellidos, null, null));
        if (!vincResp.IsSuccessStatusCode) { Msg(await vincResp.Content.ReadAsStringAsync(), false); return; }
        var vinc = await vincResp.Content.ReadFromJsonAsync<VincularResponse>();
        if (vinc is null) return;

        var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/consejo",
            new AgregarMiembroConsejoRequest(vinc.PersonaId, _nuevoConsejo.Cargo, DateOnly.FromDateTime(_nuevoConsejo.FechaInicio), null));
        if (resp.IsSuccessStatusCode)
        {
            // Tras el primer miembro, dejamos el cargo en Vocal para agregar el resto mas rapido.
            _nuevoConsejo = new() { FechaInicio = DateTime.Today, Cargo = CargoConsejo.Vocal };
            await CargarAsync();
            Msg("Miembro del consejo agregado.", true);
        }
        else Msg(await resp.Content.ReadAsStringAsync(), false);
    }

    // ---------- Sec 4: Revisor Fiscal ----------
    private async Task DesignarRevisorFiscal()
    {
        if (string.IsNullOrWhiteSpace(_nuevoRev.Documento) || string.IsNullOrWhiteSpace(_nuevoRev.Nombres) || string.IsNullOrWhiteSpace(_nuevoRev.Apellidos))
        {
            Msg("Documento, nombres y apellidos son obligatorios.", false);
            return;
        }
        var http = Auth();
        var vincResp = await http.PostAsJsonAsync("/api/mi-copropiedad/vincular-persona",
            new VincularPersonaPorDocumentoRequest(_nuevoRev.Documento, _nuevoRev.Nombres, _nuevoRev.Apellidos, null, null));
        if (!vincResp.IsSuccessStatusCode) { Msg(await vincResp.Content.ReadAsStringAsync(), false); return; }
        var vinc = await vincResp.Content.ReadFromJsonAsync<VincularResponse>();
        if (vinc is null) return;

        var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/revisor-fiscal",
            new DesignarRevisorFiscalRequest(vinc.PersonaId, _nuevoRev.TarjetaProfesional, DateOnly.FromDateTime(_nuevoRev.FechaPosesion)));
        if (resp.IsSuccessStatusCode) { _nuevoRev = new() { FechaPosesion = DateTime.Today }; await CargarAsync(); Msg("Revisor designado.", true); }
        else Msg(await resp.Content.ReadAsStringAsync(), false);
    }
    private async Task RetirarRevisorFiscal(Guid id)
    {
        await Auth().DeleteAsync($"/api/mi-copropiedad/revisor-fiscal/{id}");
        await CargarAsync();
