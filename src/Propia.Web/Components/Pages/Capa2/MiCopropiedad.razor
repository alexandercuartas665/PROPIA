    {
        var parameters = new ModalParameters()
            .Set("ActivoId", equipo.Id)
            .Set("ActivoNombre", equipo.Nombre);

        var draft = await Modals.OpenAsync<ProgramarMantenimientoModal, MantenimientoProgramado>(parameters);
        if (draft is null) return; // cancelado

        var (frec, dias) = MapearFrecuencia(draft.Frecuencia);
        var nombrePlan = $"Mantenimiento {equipo.Nombre} ({draft.Frecuencia ?? "Mensual"})";
        var descripcion = string.IsNullOrWhiteSpace(draft.Nota)
            ? $"Proveedor: {draft.Proveedor}"
            : $"Proveedor: {draft.Proveedor}. Nota: {draft.Nota}";

        var req = new Mant.CrearPlanRequest(
            ActivoTipo: TipoActivoMantenimiento.Equipo,
            ActivoId: equipo.Id,
            Nombre: nombrePlan,
            Descripcion: descripcion,
            Frecuencia: frec,
            FrecuenciaDias: dias,
            FechaInicio: DateOnly.FromDateTime(DateTime.UtcNow),
            ProveedorPreferidoId: null,
            Disparo: DisparoPlanMantenimiento.ConConfirmacion,
            DiasAlertaPrevio: 7,
            GeneraNotifResidentes: false);

        var resp = await Auth().PostAsJsonAsync("/api/mantenimiento/planes", req);
        if (resp.IsSuccessStatusCode)
        {
            Msg($"Mantenimiento programado para {equipo.Nombre}. Aparece en panel de Tareas (T.2).", true);
        }
        else
        {
            Msg("No se pudo programar el mantenimiento: " + await resp.Content.ReadAsStringAsync(), false);
        }
    }

    private static (FrecuenciaMantenimiento Frec, int? Dias) MapearFrecuencia(string? frecModal) => frecModal switch
    {
        "Semanal" => (FrecuenciaMantenimiento.Semanal, null),
        "Mensual" => (FrecuenciaMantenimiento.Mensual, null),
        "Trimestral" => (FrecuenciaMantenimiento.Trimestral, null),
        "Semestral" => (FrecuenciaMantenimiento.Semestral, null),
        "Anual" => (FrecuenciaMantenimiento.Anual, null),
        "Unica" => (FrecuenciaMantenimiento.Personalizada, 365), // V1: tratar como anual
        _ => (FrecuenciaMantenimiento.Mensual, null)
    };

    private async Task CambiarEstadoEquipo(Guid id, ChangeEventArgs ev)
    {
        if (!Enum.TryParse<EstadoEquipoActivo>(ev.Value?.ToString(), out var estado)) return;
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{id}/estado", new CambiarEstadoEquipoRequest(estado));
        if (resp.IsSuccessStatusCode) { await CargarAsync(); Msg("Estado del equipo actualizado.", true); }
        else Msg(await resp.Content.ReadAsStringAsync(), false);
    }
    private static string EstadoEquipoLabel(EstadoEquipoActivo s) => s switch
    {
        EstadoEquipoActivo.Operativo => "Operativo",
        EstadoEquipoActivo.EnMantenimiento => "En mantenimiento",
        EstadoEquipoActivo.FueraDeServicio => "Fuera de servicio",
        _ => s.ToString()
    };
    private static string EstadoEquipoClass(EstadoEquipoActivo s) => s switch
    {
        EstadoEquipoActivo.Operativo => "bg-success",
        EstadoEquipoActivo.EnMantenimiento => "bg-warning text-dark",
        EstadoEquipoActivo.FueraDeServicio => "bg-danger",
        _ => "bg-light text-dark"
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    // ---------- Zonas Comunes: vista (tarjetas/lista) + compositor progresivo + alta inline ----------
    private string _znView = "cards";
    private bool _znComposerOpen;
    private int _znReveal;
    private bool _znBusy;
    private readonly ZonaDraft _znDraft = new();
    private int _znNonce;                      // @key limpia la fila lista al crear
    private bool _znFocusPending;              // reenfocar el nombre tras recrear la fila lista
    private ElementReference _znNombreRef;

    private sealed class ZonaDraft
    {
        public string Nombre = "";
        public CategoriaZonaComun Categoria = CategoriaZonaComun.Social;
        public bool EsReservable;
        public int? Aforo;
        public void Reset() { Nombre = ""; Categoria = CategoriaZonaComun.Social; EsReservable = false; Aforo = null; }
    }

    private void AbrirZnComposer() { _znDraft.Reset(); _znReveal = 0; _znComposerOpen = true; }
    private void CancelarZnComposer() { _znComposerOpen = false; _znDraft.Reset(); _znReveal = 0; }
    private void RevealZn(int idx) { var t = idx + 1; if (t <= 3 && _znReveal < t) _znReveal = t; }

    private async Task ZnKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CrearZonaDesdeDraft();
        else if (e.Key == "Escape") CancelarZnComposer();
    }

    private async Task CrearZonaDesdeDraft()
    {
        if (string.IsNullOrWhiteSpace(_znDraft.Nombre)) return;
        _znBusy = true;
        try
        {
            var req = new CrearZonaComunRequest(_znDraft.Nombre.Trim(), _znDraft.Categoria, null,
                _znDraft.EsReservable, null, _znDraft.Aforo, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/zonas", req);
            if (resp.IsSuccessStatusCode)
            {
                _znDraft.Reset(); _znReveal = 0; _znComposerOpen = false; _znNonce++; _znFocusPending = true;
                await CargarAsync();
                Msg("Zona comun creada. Haz clic en ella para completar la ficha.", true);
            }
            else
            {
                string m;
                try { var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); m = err != null && err.TryGetValue("error", out var e) ? e : "No se pudo crear la zona."; }
                catch { m = "No se pudo crear la zona."; }
                Msg(m, false);
            }
        }
        catch (Exception ex) { Msg(ex.Message, false); }
        finally { _znBusy = false; }
    }

    // ---------- Equipos y Activos: vista (tarjetas/lista) + compositor progresivo + alta inline ----------
    private string _eqView = "cards";
    private bool _eqComposerOpen;
    private int _eqReveal;
    private bool _eqBusy;
    private readonly EquipoDraft _eqDraft = new();
    private int _eqNonce;
    private bool _eqFocusPending;
    private ElementReference _eqNombreRef;

    private sealed class EquipoDraft
    {
        public string Nombre = "";
        public CategoriaEquipo Categoria = CategoriaEquipo.Otros;
        public TipoElemento Tipo = TipoElemento.Equipo;
        public int Cantidad = 1;
        public bool EsReservable;
        public void Reset() { Nombre = ""; Categoria = CategoriaEquipo.Otros; Tipo = TipoElemento.Equipo; Cantidad = 1; EsReservable = false; }
    }

    private void AbrirEqComposer() { _eqDraft.Reset(); _eqReveal = 0; _eqComposerOpen = true; }
    private void CancelarEqComposer() { _eqComposerOpen = false; _eqDraft.Reset(); _eqReveal = 0; }
    private void RevealEq(int idx) { var t = idx + 1; if (t <= 3 && _eqReveal < t) _eqReveal = t; }

    private async Task EqKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CrearEquipoDesdeDraft();
        else if (e.Key == "Escape") CancelarEqComposer();
    }

    private async Task CrearEquipoDesdeDraft()
    {
        if (string.IsNullOrWhiteSpace(_eqDraft.Nombre)) return;
        _eqBusy = true;
        try
        {
            // Un "Equipo" es unitario (cantidad 1); solo un "Activo" agrupa varias unidades.
            var cant = _eqDraft.Tipo == TipoElemento.Equipo ? 1 : Math.Max(1, _eqDraft.Cantidad);
            var req = new CrearEquipoActivoRequest(_eqDraft.Nombre.Trim(), _eqDraft.Categoria, _eqDraft.Tipo, cant, _eqDraft.EsReservable);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/equipos", req);
            if (resp.IsSuccessStatusCode)
            {
                _eqDraft.Reset(); _eqReveal = 0; _eqComposerOpen = false; _eqNonce++; _eqFocusPending = true;
                await CargarAsync();
                Msg("Equipo/activo creado. Haz clic en el para completar la ficha.", true);
            }
            else
            {
                string m;
                try { var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); m = err != null && err.TryGetValue("error", out var e) ? e : "No se pudo crear el equipo."; }
                catch { m = "No se pudo crear el equipo."; }
                Msg(m, false);
            }
        }
        catch (Exception ex) { Msg(ex.Message, false); }
        finally { _eqBusy = false; }
    }

    private void Msg(string m, bool exito) { _actionMsg = m; _actionMsgClass = exito ? "alert-success" : "alert-danger"; }

