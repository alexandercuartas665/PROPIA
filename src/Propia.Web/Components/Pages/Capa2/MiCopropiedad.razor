@page "/mi-copropiedad"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Mi Copropiedad - PROPIA</PageTitle>

@* Modulo 2.3 Mi Copropiedad - ficha viva con secciones colapsables.
   En MVP el JWT se pega manualmente (la auth completa del cliente vendra en 2.5). *@

<div class="mb-4">
    <h1 class="h3 mb-1 fw-semibold">Mi Copropiedad</h1>
    <p class="text-muted mb-0">Ficha viva de la PH - configura aqui, los modulos consumen desde aqui</p>
</div>

@if (string.IsNullOrEmpty(_jwt))
{
    <div class="card border-warning p-4">
        <h5>@(_loadError is not null ? "Sesion expirada" : "Necesitas un JWT con tenant activo")</h5>
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <p class="text-danger small mb-3">@_loadError</p>
        }
        <p class="text-muted mb-3">Mi Copropiedad consume el API autenticado. En este MVP pegamos el JWT manualmente
            mientras se completa el login del cliente (modulo 2.5).</p>
        <div class="d-flex gap-2 mb-3">
            <a class="btn btn-dark" href="/onboarding">Crear cuenta nueva</a>
            <a class="btn btn-outline-dark" href="/login">Iniciar sesion</a>
        </div>
        <details>
            <summary class="text-muted small">Pegar JWT manualmente (modo demo)</summary>
            <p class="small text-muted mt-2">El JWT debe traer el claim <code>tenant_id</code>. Se obtiene del onboarding al final del wizard, o de /connect/token + /connect/switch-tenant.</p>
            <textarea class="form-control form-control-sm font-monospace" rows="3" @bind="_jwtInput" placeholder="eyJ..."></textarea>
            <button class="btn btn-sm btn-outline-dark mt-2" @onclick="SetJwt">Usar este JWT</button>
        </details>
    </div>
    return;
}

@if (_resumen is null)
{
    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert alert-danger">
            <strong>No se pudo cargar Mi Copropiedad:</strong> @_loadError
            <button class="btn btn-sm btn-outline-danger ms-3" @onclick="CargarAsync">Reintentar</button>
        </div>
    }
    else
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
}
else
{
    <div class="mc-layout">
    <div class="mc-main">
    @* Hero card con identidad - foto fachada como background si esta seteada *@
    <div class="card hero-card mb-3" style="@HeroBackgroundStyle">
        <div class="card-body @(HasFachada ? "hero-with-overlay" : "")">
            <div class="row align-items-center g-3">
                <div class="col-md-2 text-center">
                    @if (!string.IsNullOrEmpty(_resumen.Identidad.LogoUrl))
                    {
                        <img src="@AbsoluteApiUrl(_resumen.Identidad.LogoUrl)" alt="logo" class="img-fluid rounded" style="max-height: 100px; background: white; padding: 4px;" />
                    }
                    else
                    {
                        <div class="hero-logo-placeholder">@(_resumen.Identidad.Nombre is { Length: > 0 } n ? n[..1].ToUpper() : "P")</div>
                    }
                </div>
                <div class="col-md-7">
                    <h2 class="h3 mb-1">@_resumen.Identidad.Nombre</h2>
                    <p class="text-muted mb-1">
                        @(string.IsNullOrEmpty(_resumen.Identidad.Direccion) ? "Sin direccion" : _resumen.Identidad.Direccion)
                        @(string.IsNullOrEmpty(_resumen.Identidad.Ciudad) ? "" : $" · {_resumen.Identidad.Ciudad}")
                    </p>
                    <div class="d-flex flex-wrap gap-2 small">
                        @if (_resumen.Identidad.Tipo.HasValue) { <span class="badge bg-light text-dark border">@_resumen.Identidad.Tipo</span> }
                        @if (_resumen.Identidad.Estrato.HasValue) { <span class="badge bg-light text-dark border">Estrato @((int)_resumen.Identidad.Estrato.Value)</span> }
                        @if (!string.IsNullOrEmpty(_resumen.Identidad.Nit)) { <span class="badge bg-light text-dark border">NIT @_resumen.Identidad.Nit</span> }
                        @if (!string.IsNullOrEmpty(_resumen.Identidad.CodigoPropia)) { <span class="badge bg-light text-dark border">@_resumen.Identidad.CodigoPropia</span> }
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="hero-stats">
                        <div><strong>@_resumen.CantidadUnidades</strong><small class="text-muted d-block">unidades</small></div>
                        <div><strong>@_resumen.CantidadTorres</strong><small class="text-muted d-block">torres</small></div>
                        <div><strong>@_resumen.CantidadZonasComunes</strong><small class="text-muted d-block">zonas</small></div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="d-flex align-items-center gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Completitud general</span>
                        <strong>@_resumen.CompletitudPct%</strong>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar" style="width: @_resumen.CompletitudPct%; background: var(--propia-primary);"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Wizard guiado de configuracion - opt-in, util cuando completitud < 100% *@
    @if (_resumen.CompletitudPct < 100)
    {
        <div class="d-flex justify-content-end mb-2">
            <button class="btn btn-sm @(_showWizardGuia ? "btn-secondary" : "btn-outline-dark")"
                    @onclick="() => _showWizardGuia = !_showWizardGuia">
                @(_showWizardGuia ? "Cerrar guia" : "✨ Guiame paso a paso")
            </button>
        </div>
    }

    @if (_showWizardGuia)
    {
        <ModuloWizard Titulo="Configuracion guiada de tu copropiedad"
                      Descripcion="Te mostramos las secciones clave en orden. Marca cada paso para abrir su seccion y completar lo que falte."
                      FinishLabel="Listo, cerrar guia"
                      OnFinish="@(() => { _showWizardGuia = false; return Task.CompletedTask; })"
                      OnCancel="@(() => { _showWizardGuia = false; return Task.CompletedTask; })">

            <WizardStep Titulo="Identidad"
                        Descripcion="Datos basicos de la PH: nombre, NIT, direccion, tipo, estrato y logo.">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Estado:
                        <span class="badge @(CompIdentidad ? "bg-success" : "bg-warning text-dark")">
                            @(CompIdentidad ? "Completa" : "Pendiente")
                        </span>
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            @onclick="() => IrASeccion(SecIdent)">Abrir seccion ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Nombre, NIT (>30 unidades obligatorio DIAN), direccion y ciudad.</li>
                    <li>Tipo (Residencial/Comercial/Mixto) y estrato.</li>
                    <li>Logo y foto de fachada (opcionales pero recomendados).</li>
                </ul>
            </WizardStep>

            <WizardStep Titulo="Distribucion"
                        Descripcion="Estructura fisica: torres/sectores, pisos y unidades. Define los coeficientes (deben sumar 100%).">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Estado:
                        <span class="badge @(CompDistribucion ? "bg-success" : "bg-warning text-dark")">
                            @(CompDistribucion ? "Completa" : "Pendiente")
                        </span>
                        @if (_resumen.CantidadUnidades > 0)
                        {
                            <span class="badge bg-light text-dark border ms-1">@_resumen.CantidadUnidades unidades</span>
                        }
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            @onclick="() => IrASeccion(SecDistrib)">Abrir seccion ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Crea torres/sectores y define unidades.</li>
                    <li>Generador inteligente para crear todo de un golpe.</li>
                    <li>Importacion via CSV si ya tienes la lista.</li>
                    <li>Coeficientes deben sumar exactamente 100%.</li>
                </ul>
            </WizardStep>

            <WizardStep Titulo="Equipo de trabajo"
                        Descripcion="Personal de la copropiedad: administrador, contador, mantenimiento, vigilancia, aseo.">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Estado:
                        <span class="badge @(CompEquipoTrabajo ? "bg-success" : "bg-warning text-dark")">
                            @(CompEquipoTrabajo ? "Completa" : "Pendiente")
                        </span>
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            @onclick="() => IrASeccion(SecEqTrab)">Abrir seccion ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Vincula al administrador delegado (minimo).</li>
                    <li>Otros roles segun necesidad: contador, todero, vigilancia.</li>
                </ul>
            </WizardStep>

            <WizardStep Titulo="Gobierno"
                        Descripcion="Consejo de Administracion, Comites y Revisor Fiscal segun Ley 675.">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Estado:
                        <span class="badge @(CompGobierno ? "bg-success" : "bg-warning text-dark")">
                            @(CompGobierno ? "Completa" : "Pendiente")
                        </span>
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-dark"
                            @onclick="() => IrASeccion(SecGob)">Abrir seccion ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Consejo de Administracion (residencial obligatorio).</li>
                    <li>Comite de Convivencia (Art. 40 Ley 675).</li>
                    <li>Revisor Fiscal (Art. 38 - obligatorio >30 unidades).</li>
                </ul>
            </WizardStep>

            <WizardStep Titulo="Servicios y activos"
                        Descripcion="Contratos vigentes, zonas comunes y equipos para mantenimiento.">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        Servicios: <span class="badge @(CompServicios ? "bg-success" : "bg-warning text-dark")">@(CompServicios ? "OK" : "Pendiente")</span>
                        &nbsp;Zonas: <span class="badge @(CompZonasComunes ? "bg-success" : "bg-warning text-dark")">@(CompZonasComunes ? "OK" : "Pendiente")</span>
                        &nbsp;Equipos: <span class="badge @(CompEquipos ? "bg-success" : "bg-warning text-dark")">@(CompEquipos ? "OK" : "Pendiente")</span>
                    </span>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => IrASeccion(SecSrv)">Servicios ↓</button>
                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => IrASeccion(SecZon)">Zonas ↓</button>
                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => IrASeccion(SecEq)">Equipos ↓</button>
                </div>
                <ul class="small text-muted mt-3 mb-0">
                    <li>Vigilancia, aseo, mantenimiento, jardineria, internet.</li>
                    <li>Zonas comunes (salon, piscina, gimnasio, parqueaderos visitantes).</li>
                    <li>Equipos para programar mantenimientos preventivos en 2.10.</li>
                </ul>
            </WizardStep>

        </ModuloWizard>
    }

    @* Seccion 1 - Identidad *@
    <SeccionCard Titulo="1. Identidad" Completa="@CompIdentidad" Abierta="@_secciones[SecIdent]" OnToggle="() => ToggleSec(SecIdent)">
        <EditForm Model="@_identForm" OnValidSubmit="GuardarIdentidad" FormName="identidad">
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label">Nombre</label><InputText @bind-Value="_identForm.Nombre" class="form-control" /></div>
                <div class="col-md-3">
                    <label class="form-label">NIT</label>
                    <InputText @bind-Value="_identForm.Nit" class="form-control" />
                    @if (_resumen.CantidadUnidades > 30 && string.IsNullOrWhiteSpace(_identForm.Nit))
                    {
                        <small class="text-warning">Recomendado: copropiedades con mas de 30 unidades estan obligadas a tener NIT ante la DIAN.</small>
                    }
                </div>
                <div class="col-md-3"><label class="form-label">DV</label><InputText @bind-Value="_identForm.DigitoVerificacion" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Direccion</label><InputText @bind-Value="_identForm.Direccion" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label">Ciudad</label><InputText @bind-Value="_identForm.Ciudad" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label">Departamento</label><InputText @bind-Value="_identForm.Departamento" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label">Telefono de contacto</label><InputText @bind-Value="_identForm.TelefonoContacto" class="form-control" placeholder="(602) 555 1234" /></div>
                <div class="col-md-3"><label class="form-label">Email de contacto</label><InputText @bind-Value="_identForm.EmailContacto" class="form-control" placeholder="admin@copropiedad.co" /></div>
                <div class="col-md-4"><label class="form-label">Tipo</label>
                    <InputSelect @bind-Value="_identForm.Tipo" class="form-select">
                        <option value="">- Seleccionar -</option>
                        <option value="@TipoCopropiedad.Residencial">Residencial</option>
                        <option value="@TipoCopropiedad.Comercial">Comercial</option>
                        <option value="@TipoCopropiedad.Mixto">Mixto</option>
                        <option value="@TipoCopropiedad.Conjunto">Conjunto</option>
                    </InputSelect>
                </div>
                <div class="col-md-4"><label class="form-label">Estrato</label>
                    <InputSelect @bind-Value="_identForm.Estrato" class="form-select">
                        <option value="">- Seleccionar -</option>
                        <option value="@Estrato.Uno">1</option><option value="@Estrato.Dos">2</option>
                        <option value="@Estrato.Tres">3</option><option value="@Estrato.Cuatro">4</option>
                        <option value="@Estrato.Cinco">5</option><option value="@Estrato.Seis">6</option>
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Logo URL</label>
                    <InputText @bind-Value="_identForm.LogoUrl" class="form-control form-control-sm" placeholder="/uploads/..." />
                    <InputFile OnChange="SubirLogoAsync" class="form-control form-control-sm mt-1" accept="image/jpeg,image/png,image/webp" />
                    <small class="text-muted">o sube un archivo (max 5 MB)</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Foto de fachada</label>
                    <InputText @bind-Value="_identForm.FotoFachadaUrl" class="form-control form-control-sm" placeholder="/uploads/..." />
                    <InputFile OnChange="SubirFachadaAsync" class="form-control form-control-sm mt-1" accept="image/jpeg,image/png,image/webp" />
                    <small class="text-muted">se muestra como fondo del hero</small>
                </div>
                <div class="col-12"><label class="form-label">Descripcion</label><InputTextArea @bind-Value="_identForm.Descripcion" class="form-control" rows="2" /></div>
            </div>

            @* Identidad registral - colapsable, todos los campos opcionales *@
            <details class="mt-3">
                <summary class="text-muted small mb-2" style="cursor: pointer;">Identidad registral (Notaria, Reglamento PH, Matricula)</summary>
                <div class="row g-2 mt-2">
                    <div class="col-md-6">
                        <label class="form-label small">Numero de reglamento de PH</label>
                        <InputText @bind-Value="_identForm.NumeroReglamentoPh" class="form-control form-control-sm" placeholder="Numero de escritura registrado" />
                        <small class="text-muted">Solicitado en tramites notariales, UAECD y bancos.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">Notaria de registro</label>
                        <InputText @bind-Value="_identForm.NotariaRegistro" class="form-control form-control-sm" placeholder="Notaria X de Cali" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">Matricula inmobiliaria del terreno</label>
                        <InputText @bind-Value="_identForm.MatriculaInmobiliaria" class="form-control form-control-sm" placeholder="370-..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Licencia de construccion</label>
                        <InputText @bind-Value="_identForm.LicenciaConstruccion" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Fecha de constitucion</label>
                        <input type="date" class="form-control form-control-sm" @bind="_identForm.FechaConstitucion" />
                    </div>
                </div>
            </details>

            @* Labels personalizables (spec v1.0 - "Sector"/"Planta") *@
            <details class="mt-3">
                <summary class="text-muted small mb-2" style="cursor: pointer;">Renombrar estructura fisica (avanzado)</summary>
                <div class="row g-2 mt-2">
                    <div class="col-md-6">
                        <label class="form-label small">Etiqueta para agrupacion</label>
                        <InputText @bind-Value="_identForm.LabelAgrupacion" class="form-control form-control-sm" placeholder="Torre (default)" />
                        <small class="text-muted">Si tu PH usa otro termino: Sector, Bloque, Etapa.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">Etiqueta para piso</label>
                        <InputText @bind-Value="_identForm.LabelPiso" class="form-control form-control-sm" placeholder="Piso (default)" />
                        <small class="text-muted">Alternativas comunes: Planta, Nivel.</small>
                    </div>
                </div>
            </details>

            <button type="submit" class="btn btn-sm mt-3" style="background: var(--propia-primary); color: white;" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar identidad")</button>
        </EditForm>
    </SeccionCard>

    @* Seccion 2 - Distribucion *@
    <SeccionCard Titulo="@($"2. Distribucion ({LabelAgrupacionPlural} y Unidades)")" Completa="@CompDistribucion" Abierta="@_secciones[SecDistrib]" OnToggle="() => ToggleSec(SecDistrib)">
        @* Acciones rapidas - generador + CSV (spec v1.0 - tres vias de carga) *@
        <div class="d-flex gap-2 mb-3 flex-wrap">
            <button class="btn btn-sm btn-outline-dark" @onclick="() => _showGenerador = !_showGenerador">@(_showGenerador ? "Cerrar generador" : "Generar automaticamente")</button>
            <button class="btn btn-sm btn-outline-dark" @onclick="() => _showImport = !_showImport">@(_showImport ? "Cerrar importacion" : "Importar Excel/CSV")</button>
        </div>

        @* Generador inteligente - wizard inline *@
        @if (_showGenerador)
        {
            <div class="card border-primary mb-3">
                <div class="card-body bg-light">
                    <h6 class="mb-3">Generador inteligente de unidades</h6>
                    <p class="text-muted small mb-3">Define agrupaciones, pisos y unidades por piso. Genera todo en un solo paso.</p>
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <label class="form-label small">Patron numeracion</label>
                            <InputSelect @bind-Value="_gen.Patron" class="form-select form-select-sm">
                                <option value="@PatronNumeracion.PisoNumero">Piso + numero (101, 102, 201...)</option>
                                <option value="@PatronNumeracion.Corrido">Corrido (1, 2, 3...)</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Tipo default</label>
                            <InputSelect @bind-Value="_gen.TipoUnidadDefault" class="form-select form-select-sm">
                                @foreach (var t in Enum.GetValues<TipoUnidad>()) { <option value="@t">@t</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Coef. por unidad (%)</label>
                            <input type="number" step="0.0001" class="form-control form-control-sm" @bind="_gen.CoeficientePorUnidad" />
                        </div>
                    </div>
                    <h6 class="small mb-2">@LabelAgrupacionPlural a crear</h6>
                    @for (int i = 0; i < _gen.Torres.Count; i++)
                    {
                        var idx = i;
                        <div class="row g-2 mb-2 align-items-center">
                            <div class="col-md-4"><InputText @bind-Value="_gen.Torres[idx].Nombre" class="form-control form-control-sm" placeholder="@($"Nombre {LabelAgrupacionSingular}")" /></div>
                            <div class="col-md-3"><input type="number" class="form-control form-control-sm" @bind="_gen.Torres[idx].CantidadPisos" placeholder="@($"{LabelPisoSingular}s")" /></div>
                            <div class="col-md-3"><input type="number" class="form-control form-control-sm" @bind="_gen.Torres[idx].UnidadesPorPiso" placeholder="Unidades por piso" /></div>
                            <div class="col-md-2"><button class="btn btn-sm btn-outline-danger w-100" @onclick="() => RemoverTorreGen(idx)">Quitar</button></div>
                        </div>
                    }
                    <button class="btn btn-sm btn-link p-0 mb-2" @onclick="AgregarTorreGen">+ Agregar @LabelAgrupacionSingular</button>
                    <div class="alert alert-info py-2 small mb-2"><strong>Vista previa:</strong> @PreviewGenerador</div>
                    <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="EjecutarGenerador" disabled="@_busy">@(_busy ? "Generando..." : "Generar")</button>
                </div>
            </div>
        }

        @* Importacion CSV inline *@
        @if (_showImport)
        {
            <div class="card border-primary mb-3">
                <div class="card-body bg-light">
                    <h6 class="mb-2">Importar unidades desde CSV</h6>
                    <p class="text-muted small mb-2">
                        Columnas obligatorias: <code>identificador, tipo_unidad, coeficiente</code>.
                        Opcionales: <code>agrupacion, piso, area_m2</code>.
                        Primera linea = encabezados.
                    </p>
                    <textarea class="form-control form-control-sm font-monospace mb-2" rows="6" @bind="_csvInput"
                              placeholder="identificador,tipo_unidad,agrupacion,piso,coeficiente,area_m2&#10;101,Apartamento,Torre A,1,0.0125,60&#10;102,Apartamento,Torre A,1,0.0125,60"></textarea>
                    @if (_csvErrores is { Count: > 0 })
                    {
                        <div class="alert alert-danger py-2 small">
                            <strong>@_csvErrores.Count errores detectados — no se importo nada:</strong>
                            <ul class="mb-0">
                                @foreach (var e in _csvErrores.Take(10))
                                {
                                    <li>Fila @e.Fila · @e.Campo: @e.Mensaje</li>
                                }
                                @if (_csvErrores.Count > 10) { <li>... y @(_csvErrores.Count - 10) mas</li> }
                            </ul>
                        </div>
                    }
                    <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="EjecutarImportCsv" disabled="@_busy">@(_busy ? "Validando..." : "Importar")</button>
                </div>
            </div>
        }

        <h6 class="mb-2">@LabelAgrupacionPlural</h6>
        @if (_torres.Count == 0) { <p class="text-muted small mb-2">Sin @LabelAgrupacionPlural.ToLower() aun.</p> }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var t in _torres)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                        <span><strong>@t.Nombre</strong> @(t.CantidadPisos.HasValue ? $"· {t.CantidadPisos} {LabelPisoSingular.ToLower()}s" : "") · @t.CantidadUnidades unidades</span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarTorre(t.Id)">Quitar</button>
                    </li>
                }
            </ul>
        }
        <div class="row g-2 mb-3">
            <div class="col-md-5"><InputText @bind-Value="_nuevaTorre.Nombre" class="form-control form-control-sm" placeholder="@($"Nombre {LabelAgrupacionSingular} ({LabelAgrupacionSingular} A)")" /></div>
            <div class="col-md-3"><input type="number" class="form-control form-control-sm" @bind="_nuevaTorre.CantidadPisos" placeholder="@($"{LabelPisoSingular}s")" /></div>
            <div class="col-md-4"><button class="btn btn-sm btn-outline-dark w-100" @onclick="CrearTorre">+ Agregar @LabelAgrupacionSingular</button></div>
        </div>

        <hr />
        <h6 class="mb-2">Unidades privadas</h6>
        @if (_unidades.Count == 0) { <p class="text-muted small mb-2">Sin unidades aun.</p> }
        else
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle">
                    <thead class="small text-muted">
                        <tr><th>Numero</th><th>Tipo</th><th>@LabelAgrupacionSingular</th><th>@LabelPisoSingular</th><th class="text-end">Coef %</th><th></th></tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var u in _unidades)
                        {
                            <tr style="cursor: pointer;" @onclick="() => IrAUnidad(u.Id)">
                                <td><strong class="text-primary">@u.Numero</strong></td>
                                <td>@u.Tipo</td>
                                <td>@(u.TorreNombre ?? "-")</td>
                                <td>@u.Piso</td>
                                <td class="text-end">@u.CoeficientePropiedad.ToString("0.0000")</td>
                                <td><button class="btn btn-sm btn-outline-danger" @onclick:stopPropagation="true" @onclick="() => EliminarUnidad(u.Id)">X</button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="small">
                        <tr><td colspan="4" class="text-end fw-semibold">Suma:</td><td class="text-end fw-semibold @(Math.Abs(_resumen.CoeficientesTotalPct - 100m) > 1m ? "text-danger" : "text-success")">@_resumen.CoeficientesTotalPct.ToString("0.0000")%</td><td></td></tr>
                    </tfoot>
                </table>
            </div>
        }
        <div class="row g-2">
            <div class="col-md-2"><InputText @bind-Value="_nuevaUnidad.Numero" class="form-control form-control-sm" placeholder="101" /></div>
            <div class="col-md-2">
                <InputSelect @bind-Value="_nuevaUnidad.Tipo" class="form-select form-select-sm">
                    <option value="@TipoUnidad.Apartamento">Apartamento</option>
                    <option value="@TipoUnidad.Local">Local</option>
                    <option value="@TipoUnidad.Casa">Casa</option>
                    <option value="@TipoUnidad.Oficina">Oficina</option>
                    <option value="@TipoUnidad.Parqueadero">Parqueadero</option>
                </InputSelect>
            </div>
            <div class="col-md-2">
                <InputSelect @bind-Value="_nuevaUnidad.TorreId" class="form-select form-select-sm">
                    <option value="">- Torre -</option>
                    @foreach (var t in _torres) { <option value="@t.Id">@t.Nombre</option> }
                </InputSelect>
            </div>
            <div class="col-md-1"><input type="number" class="form-control form-control-sm" @bind="_nuevaUnidad.Piso" placeholder="Piso" /></div>
            <div class="col-md-2"><input type="number" step="0.0001" class="form-control form-control-sm" @bind="_nuevaUnidad.Coef" placeholder="Coef %" /></div>
            <div class="col-md-3"><button class="btn btn-sm btn-outline-dark w-100" @onclick="CrearUnidad">+ Unidad</button></div>
        </div>
    </SeccionCard>

    @* Seccion 3 - Equipo de trabajo *@
    <SeccionCard Titulo="3. Equipo de trabajo" Completa="@CompEquipoTrabajo" Abierta="@_secciones[SecEqTrab]" OnToggle="() => ToggleSec(SecEqTrab)">
        @if (_equipo.Count == 0) { <p class="text-muted small mb-2">Sin personal vinculado a la PH.</p> }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var m in _equipo)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                        <span>
                            <strong>@m.PersonaNombre</strong> ·
                            <span class="badge bg-light text-dark border">@(m.Rol == RolEquipo.Otro ? (m.RolPersonalizado ?? "Otro") : m.Rol.ToString())</span>
                            · @m.Tipo
                            @if (!string.IsNullOrEmpty(m.Telefono)) { <span class="text-muted"> · @m.Telefono</span> }
                            · @(m.Activo ? "Activo" : "Inactivo")
                        </span>
                        @if (m.Activo) { <button class="btn btn-sm btn-outline-danger" @onclick="() => DesactivarMiembroEquipo(m.Id)">Desactivar</button> }
                    </li>
                }
            </ul>
        }
        <h6 class="small mb-2">+ Vincular persona al equipo</h6>
        <div class="row g-2 mb-2">
            <div class="col-md-3"><InputText @bind-Value="_nuevoEq.Documento" class="form-control form-control-sm" placeholder="Cedula" /></div>
            <div class="col-md-3"><InputText @bind-Value="_nuevoEq.Nombres" class="form-control form-control-sm" placeholder="Nombres" /></div>
            <div class="col-md-3"><InputText @bind-Value="_nuevoEq.Apellidos" class="form-control form-control-sm" placeholder="Apellidos" /></div>
            <div class="col-md-3"><InputText @bind-Value="_nuevoEq.Telefono" class="form-control form-control-sm" placeholder="Telefono" /></div>
            <div class="col-md-3"><InputText @bind-Value="_nuevoEq.Email" class="form-control form-control-sm" placeholder="Email" /></div>
            <div class="col-md-3">
                <InputSelect @bind-Value="_nuevoEq.Rol" class="form-select form-select-sm">
                    @foreach (var r in Enum.GetValues<RolEquipo>()) { <option value="@r">@r</option> }
                </InputSelect>
            </div>
            <div class="col-md-3">
                <InputSelect @bind-Value="_nuevoEq.Tipo" class="form-select form-select-sm">
                    <option value="@TipoVinculacion.Interno">Interno</option>
                    <option value="@TipoVinculacion.Externo">Externo</option>
                </InputSelect>
            </div>
            <div class="col-md-3"><button class="btn btn-sm btn-outline-dark w-100" @onclick="AgregarMiembroEquipo">+ Vincular</button></div>
        </div>
    </SeccionCard>

    @* Seccion 4 - Gobierno (Consejo + Comites + Revisor Fiscal) *@
    <SeccionCard Titulo="4. Gobierno (Consejo, Comites, Revisor Fiscal)" Completa="@CompGobierno" Abierta="@_secciones[SecGob]" OnToggle="() => ToggleSec(SecGob)">
        <h6 class="mb-2">Consejo de Administracion</h6>
        @if (_consejo.Count == 0) { <p class="text-muted small mb-2">Sin miembros del consejo configurados.</p> }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var m in _consejo)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                        <span><strong>@m.PersonaNombre</strong> · <span class="badge bg-light text-dark border">@m.Cargo</span> · @(m.Activo ? "Activo" : "Inactivo")</span>
                        @if (m.Activo) { <button class="btn btn-sm btn-outline-danger" @onclick="() => DesactivarConsejo(m.Id)">Desactivar</button> }
                    </li>
                }
            </ul>
        }
        @if (TipoPH == TipoCopropiedad.Residencial && _consejo.Count(c => c.Activo) == 0)
        {
            <p class="alert alert-warning py-2 small mb-3">
                La Ley 675 de 2001 establece que las copropiedades residenciales deben tener Consejo de Administracion. Te recomendamos conformarlo.
            </p>
        }
        <div class="row g-2 mb-3">
            <div class="col-md-2"><InputText @bind-Value="_nuevoConsejo.Documento" class="form-control form-control-sm" placeholder="Cedula" /></div>
            <div class="col-md-2"><InputText @bind-Value="_nuevoConsejo.Nombres" class="form-control form-control-sm" placeholder="Nombres" /></div>
            <div class="col-md-2"><InputText @bind-Value="_nuevoConsejo.Apellidos" class="form-control form-control-sm" placeholder="Apellidos" /></div>
            <div class="col-md-2">
                <InputSelect @bind-Value="_nuevoConsejo.Cargo" class="form-select form-select-sm">
                    @foreach (var c in Enum.GetValues<CargoConsejo>()) { <option value="@c">@c</option> }
                </InputSelect>
            </div>
            <div class="col-md-2"><input type="date" class="form-control form-control-sm" @bind="_nuevoConsejo.FechaInicio" /></div>
            <div class="col-md-2"><button class="btn btn-sm btn-outline-dark w-100" @onclick="AgregarMiembroConsejo">+ Miembro</button></div>
        </div>

        <h6 class="mb-2 mt-3">Comites</h6>
        @if (_comites.Count == 0) { <p class="text-muted small mb-2">Sin comites configurados.</p> }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var c in _comites)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                        <span><strong>@c.Nombre</strong> @(string.IsNullOrEmpty(c.Descripcion) ? "" : $"· {c.Descripcion}") · @c.CantidadMiembros miembros · @(c.Activo ? "Activo" : "Inactivo")</span>
                        @if (c.Activo) { <button class="btn btn-sm btn-outline-danger" @onclick="() => DesactivarComite(c.Id)">Desactivar</button> }
                    </li>
                }
            </ul>
        }
        @if (TipoPH == TipoCopropiedad.Residencial && !_comites.Any(c => c.Activo && c.Nombre.ToLower().Contains("convivencia")))
        {
            <p class="alert alert-warning py-2 small mb-3">
                La Ley 675 de 2001 (Art. 40) establece el Comite de Convivencia como obligatorio en copropiedades residenciales.
            </p>
        }
        <div class="row g-2 mb-3">
            <div class="col-md-4"><InputText @bind-Value="_nuevoComite.Nombre" class="form-control form-control-sm" placeholder="Nombre del comite (Convivencia, Obras, ...)" /></div>
            <div class="col-md-4"><InputText @bind-Value="_nuevoComite.Descripcion" class="form-control form-control-sm" placeholder="Descripcion (opcional)" /></div>
            <div class="col-md-2"><input type="date" class="form-control form-control-sm" @bind="_nuevoComite.FechaConformacion" /></div>
            <div class="col-md-2"><button class="btn btn-sm btn-outline-dark w-100" @onclick="CrearComite">+ Comite</button></div>
        </div>

        <h6 class="mb-2 mt-3">Revisor Fiscal</h6>
        @if (_revisorFiscal is not null)
        {
            <p class="small mb-3">
                <strong>@_revisorFiscal.PersonaNombre</strong>
                @(string.IsNullOrEmpty(_revisorFiscal.NumeroTarjetaProfesional) ? "" : $" · TP {_revisorFiscal.NumeroTarjetaProfesional}")
                · desde @_revisorFiscal.FechaPosesion
                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => RetirarRevisorFiscal(_revisorFiscal!.Id)">Retirar</button>
            </p>
        }
        else if (_resumen.CantidadUnidades > 30)
        {
            <p class="alert alert-warning py-2 small mb-3">
                La Ley 675 (Art. 38) exige Revisor Fiscal en copropiedades con mas de 30 unidades.
            </p>
        }
        else
        {
            <p class="text-muted small mb-3">Sin revisor fiscal designado (opcional para PH menores a 30 unidades).</p>
        }
        <details>
            <summary class="text-muted small mb-2" style="cursor: pointer;">Designar Revisor Fiscal</summary>
            <div class="row g-2 mt-2">
                <div class="col-md-3"><InputText @bind-Value="_nuevoRev.Documento" class="form-control form-control-sm" placeholder="Cedula" /></div>
                <div class="col-md-3"><InputText @bind-Value="_nuevoRev.Nombres" class="form-control form-control-sm" placeholder="Nombres" /></div>
                <div class="col-md-3"><InputText @bind-Value="_nuevoRev.Apellidos" class="form-control form-control-sm" placeholder="Apellidos" /></div>
                <div class="col-md-3"><InputText @bind-Value="_nuevoRev.TarjetaProfesional" class="form-control form-control-sm" placeholder="Tarjeta Profesional" /></div>
                <div class="col-md-3"><input type="date" class="form-control form-control-sm" @bind="_nuevoRev.FechaPosesion" /></div>
                <div class="col-md-3"><button class="btn btn-sm btn-outline-dark w-100" @onclick="DesignarRevisorFiscal">Designar</button></div>
            </div>
        </details>

        <p class="text-muted small mt-3 mb-0"><em>Tip: el alta completa de personas via 2.4 Directorio (en construccion); aqui creamos por documento.</em></p>
    </SeccionCard>

    @* Seccion 5 - Servicios *@
    <SeccionCard Titulo="5. Servicios (Contratos)" Completa="@CompServicios" Abierta="@_secciones[SecSrv]" OnToggle="() => ToggleSec(SecSrv)">
        @if (_contratos.Count == 0) { <p class="text-muted small mb-2">Sin contratos vigentes.</p> }
        else
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm">
                    <thead class="small text-muted"><tr><th>Tipo</th><th>Proveedor</th><th>Inicio</th><th>Fin</th><th>Estado</th><th class="text-end">Valor</th><th></th></tr></thead>
                    <tbody class="small">
                        @foreach (var c in _contratos)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@c.Tipo</span></td>
                                <td>@c.Proveedor</td>
                                <td>@c.FechaInicio</td>
                                <td>@(c.FechaFin?.ToString() ?? "-")</td>
                                <td>
                                    <span class="badge @ContratoEstadoClass(c.Estado)">@ContratoEstadoLabel(c.Estado)</span>
                                    @if (c.AlertaVencimiento) { <span class="badge bg-warning text-dark ms-1" title="Alerta de vencimiento">Vence en @c.DiasParaVencer d</span> }
                                    @if (c.Estado != EstadoContrato.Vencido)
                                    {
                                        <select class="form-select form-select-sm d-inline-block ms-1" style="width:auto"
                                                @onchange="(e) => CambiarEstadoContrato(c, e)">
                                            <option value="Vigente" selected="@(c.Estado == EstadoContrato.Vigente)">Vigente</option>
                                            <option value="EnRenovacion" selected="@(c.Estado == EstadoContrato.EnRenovacion)">En renovacion</option>
                                        </select>
                                    }
                                </td>
                                <td class="text-end">@(c.ValorMensual?.ToString("N0") ?? "-")</td>
                                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarContrato(c.Id)">X</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="row g-2">
            <div class="col-md-2">
                <InputSelect @bind-Value="_nuevoContrato.Tipo" class="form-select form-select-sm">
                    @foreach (var t in Enum.GetValues<TipoServicio>()) { <option value="@t">@t</option> }
                </InputSelect>
            </div>
            <div class="col-md-3"><InputText @bind-Value="_nuevoContrato.Proveedor" class="form-control form-control-sm" placeholder="Proveedor" /></div>
            <div class="col-md-2"><input type="date" class="form-control form-control-sm" @bind="_nuevoContrato.FechaInicio" /></div>
            <div class="col-md-2"><input type="date" class="form-control form-control-sm" @bind="_nuevoContrato.FechaFin" /></div>
            <div class="col-md-2"><input type="number" class="form-control form-control-sm" @bind="_nuevoContrato.ValorMensual" placeholder="COP" /></div>
            <div class="col-md-1"><button class="btn btn-sm btn-outline-dark w-100" @onclick="CrearContrato">+</button></div>
        </div>
    </SeccionCard>

    @* Seccion 6 - Zonas Comunes *@
    <SeccionCard Titulo="6. Zonas Comunes" Completa="@CompZonasComunes" Abierta="@_secciones[SecZon]" OnToggle="() => ToggleSec(SecZon)">
        @if (_zonas.Count == 0) { <p class="text-muted small mb-2">Sin zonas configuradas.</p> }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var z in _zonas)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                        <span>
                            <strong>@z.Nombre</strong> · <span class="badge bg-light text-dark border">@z.Categoria</span>
                            @(z.EsReservable ? "· Reservable" : "")
                            <span class="badge @EstadoZonaClass(z.Estado) ms-1">@EstadoZonaLabel(z.Estado)</span>
                        </span>
                        <span class="d-flex align-items-center gap-2">
                            <select class="form-select form-select-sm" style="width:auto" @onchange="(e) => CambiarEstadoZona(z.Id, e)">
                                @foreach (var s in Enum.GetValues<EstadoZonaComunMantenimiento>())
                                { <option value="@s" selected="@(z.Estado == s)">@EstadoZonaLabel(s)</option> }
                            </select>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarZona(z.Id)">X</button>
                        </span>
                    </li>
                }
            </ul>
        }
        <div class="row g-2">
            <div class="col-md-4"><InputText @bind-Value="_nuevaZona.Nombre" class="form-control form-control-sm" placeholder="Nombre" /></div>
            <div class="col-md-3">
                <InputSelect @bind-Value="_nuevaZona.Categoria" class="form-select form-select-sm">
                    @foreach (var c in Enum.GetValues<CategoriaZonaComun>()) { <option value="@c">@c</option> }
                </InputSelect>
            </div>
            <div class="col-md-2 form-check ms-2 mt-1"><input type="checkbox" class="form-check-input" @bind="_nuevaZona.Reservable" id="zonaRes" /><label for="zonaRes" class="form-check-label small">Reservable</label></div>
            <div class="col-md-2"><input type="number" class="form-control form-control-sm" @bind="_nuevaZona.Capacidad" placeholder="Capacidad" /></div>
            <div class="col-md-1"><button class="btn btn-sm btn-outline-dark w-100" @onclick="CrearZona">+</button></div>
        </div>
    </SeccionCard>

    @* Seccion 7 - Equipos *@
    <SeccionCard Titulo="7. Equipos y Activos" Completa="@CompEquipos" Abierta="@_secciones[SecEq]" OnToggle="() => ToggleSec(SecEq)">
        @if (_equipos.Count == 0) { <p class="text-muted small mb-2">Sin equipos registrados.</p> }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var e in _equipos)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                        <span>
                            <strong>@e.Nombre</strong> · <span class="badge bg-light text-dark border">@e.Categoria</span>
                            @(string.IsNullOrEmpty(e.Marca) ? "" : $"· {e.Marca}")
                            <span class="badge @EstadoEquipoClass(e.Estado) ms-1">@EstadoEquipoLabel(e.Estado)</span>
                        </span>
                        <span class="d-flex align-items-center gap-2">
                            <select class="form-select form-select-sm" style="width:auto" @onchange="(ev) => CambiarEstadoEquipo(e.Id, ev)">
                                @foreach (var s in Enum.GetValues<EstadoEquipoActivo>())
                                { <option value="@s" selected="@(e.Estado == s)">@EstadoEquipoLabel(s)</option> }
                            </select>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarEquipo(e.Id)">X</button>
                        </span>
                    </li>
                }
            </ul>
        }
        <div class="row g-2">
            <div class="col-md-4"><InputText @bind-Value="_nuevoEquipo.Nombre" class="form-control form-control-sm" placeholder="Nombre" /></div>
            <div class="col-md-3">
                <InputSelect @bind-Value="_nuevoEquipo.Categoria" class="form-select form-select-sm">
                    @foreach (var c in Enum.GetValues<CategoriaEquipo>()) { <option value="@c">@c</option> }
                </InputSelect>
            </div>
            <div class="col-md-3"><InputText @bind-Value="_nuevoEquipo.Marca" class="form-control form-control-sm" placeholder="Marca" /></div>
            <div class="col-md-2"><button class="btn btn-sm btn-outline-dark w-100" @onclick="CrearEquipo">+</button></div>
        </div>
    </SeccionCard>

    @* Seccion 8 - Finanzas *@
    <SeccionCard Titulo="8. Finanzas" Completa="@CompFinanzas" Abierta="@_secciones[SecFin]" OnToggle="() => ToggleSec(SecFin)">
        @if (_finanzas is null)
        {
            <p class="text-muted small mb-0">Cargando...</p>
        }
        else
        {
            var sim = _monedas.FirstOrDefault(m => m.Codigo == _finForm.Moneda)?.Simbolo ?? "$";

            @* Resumen financiero en tiempo real (se nutre de 2.6 Presupuesto y 2.7 Cartera) *@
            <div class="row g-2 mb-1">
                <div class="col-6 col-md-3">
                    <div class="fin-kpi"><div class="fin-kpi-label">Cuota administracion</div>
                        <div class="fin-kpi-val">@sim @_finanzas.Resumen.CuotaAdministracionVigente.ToString("N0")</div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fin-kpi"><div class="fin-kpi-label">Recaudo del mes</div>
                        <div class="fin-kpi-val">@_finanzas.Resumen.RecaudoMesPct.ToString("0.#")%</div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fin-kpi"><div class="fin-kpi-label">Presupuesto anual</div>
                        <div class="fin-kpi-val">@sim @_finanzas.Resumen.PresupuestoAnualAprobado.ToString("N0")</div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fin-kpi"><div class="fin-kpi-label">Cartera en mora</div>
                        <div class="fin-kpi-val text-danger">@sim @_finanzas.Resumen.CarteraEnMora.ToString("N0")</div></div>
                </div>
            </div>
            @if (!_finanzas.Resumen.HayPresupuestoVigente)
            {
                <p class="text-muted small mb-0">El resumen se completa cuando exista un presupuesto vigente en 2.6 Presupuesto.</p>
            }

            <hr />
            <h6 class="mb-2">Parametros de configuracion</h6>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small mb-1">Moneda</label>
                    <select class="form-select form-select-sm" @bind="_finForm.Moneda">
                        @foreach (var m in _monedas) { <option value="@m.Codigo">@m.Codigo - @m.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Dia de corte (1-28)</label>
                    <input type="number" min="1" max="28" class="form-control form-control-sm" @bind="_finForm.DiaCorte" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Periodo de gracia (dias)</label>
                    <input type="number" min="0" max="30" class="form-control form-control-sm" @bind="_finForm.PeriodoGraciaDias" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Tasa de interes por mora</label>
                    <select class="form-select form-select-sm" @bind="MoraModo">
                        <option value="legal">Tasa legal vigente (automatica)</option>
                        <option value="fija">Tasa fija</option>
                    </select>
                </div>
                @if (!_finForm.TasaMoraEsLegal)
                {
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Tasa fija mensual (%)</label>
                        <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="_finForm.TasaMoraValor" />
                        <div class="form-text small">Maximo legal: @_finanzas.Parametros.TasaMoraMaximaLegal.ToString("0.##")% mensual</div>
                    </div>
                }
            </div>

            @if (_finForm.DiaCorte != _diaCorteOriginal)
            {
                <div class="alert alert-warning py-2 mt-3 mb-0 small">Cambiar el dia de corte afecta la facturacion a partir del proximo periodo.</div>
            }
            @if (_finConfirmMoneda)
            {
                <div class="alert alert-warning py-2 mt-3 mb-0 small">
                    <strong>Advertencia:</strong> cambiar la moneda impacta todos los valores monetarios de la copropiedad. Confirma para continuar.
                </div>
            }

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-sm" style="background: var(--propia-primary); color:#fff;" @onclick="GuardarFinanzas">
                    @(_finConfirmMoneda ? "Confirmar cambio de moneda y guardar" : "Guardar parametros")
                </button>
                @if (_finConfirmMoneda)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => { _finForm.Moneda = _monedaOriginal!; _finConfirmMoneda = false; })">Cancelar</button>
                }
            </div>
        }
    </SeccionCard>

    @* Bitacora de cambios (RN-06) - registro en lenguaje natural, solo lectura *@
    <div class="card mt-3">
        <div class="card-body">
            <h6 class="mb-3"><i class="fi fi-rr-time-past me-1"></i>Bitacora de cambios</h6>
            @if (_bitacora.Count == 0)
            {
                <p class="text-muted small mb-0">Aun no hay cambios registrados. Aqui quedaran los cambios de coeficientes, moneda, dia de corte y estados.</p>
            }
            else
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var b in _bitacora)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0">
                            <span><span class="badge bg-light text-dark border me-2">@b.Categoria</span>@b.Descripcion</span>
                            <span class="text-muted ms-3" style="white-space:nowrap;">@b.Fecha.ToLocalTime().ToString("dd MMM HH:mm")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_actionMsg))
    {
        <div class="alert @_actionMsgClass mt-3">@_actionMsg</div>
    }
    </div>@* /mc-main *@

    @* Asistente Ask AI anclado a la derecha (right rail), acompana el scroll *@
    <aside class="mc-rail">
        <AskAi Jwt="@_jwt" Titulo="Asistente de Mi Copropiedad" Docked="true" />
    </aside>
    </div>@* /mc-layout *@
}

