                _nuevoEq.Tipo, DateOnly.FromDateTime(DateTime.Today),
                _nuevoEq.Telefono, _nuevoEq.Email, null));
        if (resp.IsSuccessStatusCode) { _nuevoEq = new(); await CargarAsync(); Msg("Miembro vinculado.", true); }
