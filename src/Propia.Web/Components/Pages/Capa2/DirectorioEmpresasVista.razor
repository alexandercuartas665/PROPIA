@* Vista de empresas del Directorio: alterna Lista y Tabla (todas las columnas + alta inline).
   Extraida de Directorio.razor, que aporta las clases dir-* y dtab-*; aqui solo va .dve-grid. *@
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared

@* El toggle Lista/Tabla vive en la pagina (barra de filtros), no aqui: la vista llega por
   parametro para que la seleccion se comparta entre pestanas y se pueda persistir. *@
@if (Empresas is null)
{
    <div class="dir-loading"><div class="spinner-border" style="color: var(--propia-brand, #6D4FE3);"></div></div>
}
else if (Vista == "lista")
{
    @if (Empresas.Count == 0)
    {
        <div class="dir-empty"><strong>Sin empresas vinculadas a esta copropiedad aun.</strong><span>Usa la vista Tabla para agregar la primera.</span></div>
    }
    else
    {
        <div class="dir-list">
            @foreach (var item in FilasRender())
            {
                if (item.EsGrupo)
                {
                    var g = item.Grupo!;
                    <div class="dtab-group">
                        <span class="dir-tag dir-tag--et dtab-group-chip" style="@ChipStyle(g.Color)">@EtiquetaIconos.Svg(g.Icono)<span>@g.Titulo</span></span>
                        <span class="dtab-group-n">@g.Items.Count</span>
                    </div>
                    continue;
                }
                var e = item.Empresa!;
                var eid = e.Id;
                <button type="button" class="dir-row" @onclick="() => OnAbrir.InvokeAsync(eid)">
                    <div class="dir-avatar dir-avatar--empresa">@InicialesEmpresa(e.RazonSocial)</div>
                    <div class="dir-col-main">
                        <div class="dir-name">@e.RazonSocial</div>
                        <div class="dir-meta">NIT @e.Nit@(string.IsNullOrEmpty(e.DigitoVerificacion) ? "" : $"-{e.DigitoVerificacion}")</div>
                    </div>
                    <div class="dir-tags">
                        @if (e.Etiquetas is not null)
                        {
                            @foreach (var et in e.Etiquetas)
                            {
                                <span class="dir-tag dir-tag--et" style="@ChipStyle(et.Color)">@EtiquetaIconos.Svg(et.Icono)<span>@et.Nombre</span></span>
                            }
                        }
                        @if (!string.IsNullOrEmpty(e.NombreComercial)) { <span class="dir-tag dir-tag--mute">@e.NombreComercial</span> }
                    </div>
                    <div class="dir-unidad">@(e.Telefono ?? "")</div>
                    <div class="dir-estado">
                        <span class="dir-dot dir-dot--ok"></span>
                        <span class="dir-estado-txt dir-estado-txt--ok">@e.Estado</span>
                    </div>
                    <svg class="dir-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C3D0DD" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                </button>
            }
        </div>
    }
}
else
{
    <div class="dtab-table">
        <div class="dtab-scroll">
            <div class="dtab-head dve-grid" style="grid-template-columns:@GridCols">
                <div></div>
                @foreach (var c in ColsVisibles) { <div>@Etiqueta(c)</div> }
                <div></div>
            </div>
            @foreach (var item in FilasRender())
            {
                if (item.EsGrupo)
                {
                    var g = item.Grupo!;
                    <div class="dtab-group dtab-group--row">
                        <span class="dir-tag dir-tag--et dtab-group-chip" style="@ChipStyle(g.Color)">@EtiquetaIconos.Svg(g.Icono)<span>@g.Titulo</span></span>
                        <span class="dtab-group-n">@g.Items.Count</span>
                    </div>
                    continue;
                }
                var e = item.Empresa!;
                var eid = e.Id;
                <div class="dtab-row dve-grid" style="grid-template-columns:@GridCols">
                    <div class="dtab-exp-col">
                        <button type="button" class="dtab-exp" title="Abrir la ficha para editar" @onclick="() => OnAbrir.InvokeAsync(eid)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @foreach (var c in ColsVisibles)
                    {
                        switch (c.Key)
                        {
                            case "razon":
                                <input class="dtab-cell dtab-cell-nom" value="@e.RazonSocial" @onchange="@(ev => Editar(eid, "razon", ev))" />
                                break;
                            case "comercial":
                                <input class="dtab-cell" value="@(e.NombreComercial ?? "")" placeholder="-" @onchange="@(ev => Editar(eid, "comercial", ev))" />
                                break;
                            case "nit":
                                <div class="dtab-c dtab-ro" title="El NIT se edita en la ficha">@e.Nit@(string.IsNullOrEmpty(e.DigitoVerificacion) ? "" : $"-{e.DigitoVerificacion}")</div>
                                break;
                            case "email":
                                <input class="dtab-cell" value="@(e.Email ?? "")" placeholder="-" @onchange="@(ev => Editar(eid, "email", ev))" />
                                break;
                            case "telefono":
                                <input class="dtab-cell" value="@(e.Telefono ?? "")" placeholder="-" @onchange="@(ev => Editar(eid, "telefono", ev))" />
                                break;
                            case "estado":
                                <div class="dtab-c"><span class="dtab-badge dtab-badge--ok">@e.Estado</span></div>
                                break;
                        }
                    }
                    <div></div>
                </div>
            }
            @* @@key limpia la fila al crear; @@oninput SIN value= evita perder pulsaciones
               (value= se reafirma en cada re-render y pisa lo escrito en Blazor Server).
               Razon social y NIT son requeridos para el alta: no se pueden ocultar. *@
            <div class="dtab-newrow dve-grid" @key="_nonce" style="grid-template-columns:@GridCols">
                <div class="dtab-exp-col">
                    <button type="button" class="dtab-exp" tabindex="-1" title="Crear y abrir ficha" @onclick="CrearEmpresaAbrirInline" disabled="@(_busy || !DraftValido)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                </div>
                @foreach (var c in ColsVisibles)
                {
                    switch (c.Key)
                    {
                        case "razon":
                            <input class="dtab-inp" @ref="_firstRef" placeholder="Nueva empresa (razon social)..." @oninput="@(ev => _draft.RazonSocial = ev.Value?.ToString() ?? string.Empty)" @onkeydown="RowKeydown" />
                            break;
                        case "comercial":
                            <input class="dtab-inp" placeholder="Nombre comercial" @oninput="@(ev => _draft.NombreComercial = ev.Value?.ToString())" @onkeydown="RowKeydown" />
                            break;
                        case "nit":
                            <input class="dtab-inp" placeholder="NIT" @oninput="@(ev => _draft.Nit = ev.Value?.ToString() ?? string.Empty)" @onkeydown="RowKeydown" />
                            break;
                        case "email":
                            <input class="dtab-inp" placeholder="Email" @oninput="@(ev => _draft.Email = ev.Value?.ToString())" @onkeydown="RowKeydown" />
                            break;
                        case "telefono":
                            <input class="dtab-inp" placeholder="Telefono" @oninput="@(ev => _draft.Telefono = ev.Value?.ToString())" @onkeydown="RowKeydown" />
                            break;
                        case "estado":
                            <div class="dtab-nf-mut">Activo</div>
                            break;
                    }
                }
                <div class="dtab-act dtab-act-nf">
                    <button type="button" class="dtab-add" title="Agregar (Enter)" @onclick="CrearEmpresaInline" disabled="@(_busy || !DraftValido)">+ Agregar</button>
                </div>
            </div>
        </div>
        @* Footer canonico: visible SIEMPRE con la tabla (incluso 0 filas -> "Mostrando 0 de 0");
           solo se oculta con agrupacion activa (Grupos no null). *@
        @if (Grupos is null)
        {
            <TablaPager Total="Total" Pagina="Pagina" PorPagina="PorPagina" Entidad="empresas"
                        PaginaChanged="PaginaChanged" PorPaginaChanged="PorPaginaChanged" />
        }
    </div>
}

@code {
    [Parameter] public List<EmpresaResumenDto>? Empresas { get; set; }
    [Parameter] public EventCallback<Guid> OnAbrir { get; set; }
    [Parameter] public EventCallback<NuevaEmpresaDir> OnCrear { get; set; }
    /// <summary>Variante del alta: crear y ABRIR la ficha de una (expander de la fila).</summary>
    [Parameter] public EventCallback<NuevaEmpresaDir> OnCrearAbrir { get; set; }
    /// <summary>Edicion inline de una celda: la pagina persiste (tiene el DTO completo y Auth).</summary>
    [Parameter] public EventCallback<DirectorioPersonasVista.EdicionCampoDir> OnEditarCampo { get; set; }

    /// <summary>Agrupacion por etiqueta que arma la pagina; si es null, la tabla va plana.</summary>
    [Parameter] public List<Grupo>? Grupos { get; set; }

    /// <summary>Config de columnas por usuario (visibilidad + nombre) desde localStorage;
    /// clave = Key de la columna. Reutiliza el tipo ColPref del directorio de personas.</summary>
    [Parameter] public Dictionary<string, DirectorioPersonasVista.ColPref>? ColsConfig { get; set; }

    /// <summary>Orden de columnas (claves) elegido por el usuario; si es null, se usa el orden del catalogo.</summary>
    [Parameter] public List<string>? ColsOrder { get; set; }

    // Paginacion (footer canonico, dentro del contenedor .dtab-table). La pagina la controla el padre.
    [Parameter] public int Total { get; set; }
    [Parameter] public int Pagina { get; set; } = 1;
    [Parameter] public int PorPagina { get; set; } = 25;
    [Parameter] public EventCallback<int> PaginaChanged { get; set; }
    [Parameter] public EventCallback<int> PorPaginaChanged { get; set; }

    private sealed record ColDef(string Key, string DefLabel, string Width, bool Hideable);
    private static readonly ColDef[] Catalogo =
    {
        new("razon", "RAZON SOCIAL", "1.6fr", false),
        new("comercial", "NOMBRE COMERCIAL", "1.4fr", true),
        new("nit", "NIT", "1.1fr", false),
        new("email", "EMAIL", "1.6fr", true),
        new("telefono", "TELEFONO", "1.1fr", true),
        new("estado", "ESTADO", "92px", true),
    };

    /// <summary>Columnas del directorio de empresas para armar el panel Configurar en la pagina.</summary>
    public static IReadOnlyList<(string Key, string DefLabel, bool Hideable)> Columnas =>
        Catalogo.Select(c => (c.Key, c.DefLabel, c.Hideable)).ToList();

    private bool EsVisible(ColDef c) => !c.Hideable || ColsConfig is null || !ColsConfig.TryGetValue(c.Key, out var p) || p.Visible;
    private string Etiqueta(ColDef c) => (ColsConfig is not null && ColsConfig.TryGetValue(c.Key, out var p) && !string.IsNullOrWhiteSpace(p.Label)) ? p.Label! : c.DefLabel;
    private IEnumerable<ColDef> ColsVisibles
    {
        get
        {
            IEnumerable<ColDef> ordenado = Catalogo;
            if (ColsOrder is { Count: > 0 })
            {
                var byKey = Catalogo.ToDictionary(c => c.Key);
                ordenado = ColsOrder.Where(byKey.ContainsKey).Select(k => byKey[k])
                    .Concat(Catalogo.Where(c => !ColsOrder.Contains(c.Key)));
            }
            return ordenado.Where(EsVisible);
        }
    }
    private string GridCols => "34px " + string.Join(" ", ColsVisibles.Select(c => c.Width)) + " 44px";

    /// <summary>Un grupo de la vista agrupada: cabecera (etiqueta) + sus empresas.</summary>
    public sealed record Grupo(string Titulo, string? Color, string? Icono, List<EmpresaResumenDto> Items);

    private readonly record struct FilaRender(bool EsGrupo, Grupo? Grupo, EmpresaResumenDto? Empresa);

    private IEnumerable<FilaRender> FilasRender()
    {
        if (Grupos is null)
        {
            foreach (var e in Empresas!) yield return new FilaRender(false, null, e);
        }
        else
        {
            foreach (var g in Grupos)
            {
                yield return new FilaRender(true, g, null);
                foreach (var e in g.Items) yield return new FilaRender(false, null, e);
            }
        }
    }

    private Task Editar(Guid id, string campo, ChangeEventArgs e)
        => OnEditarCampo.InvokeAsync(new DirectorioPersonasVista.EdicionCampoDir(id, campo, e.Value?.ToString()));

    [Parameter] public string Vista { get; set; } = "lista";  // "lista" | "tabla" (la controla Directorio.razor)
    private bool _busy;
    private readonly EmpresaDraft _draft = new();
    private int _nonce;
    private bool _focusPending;
    private ElementReference _firstRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending) { _focusPending = false; try { await _firstRef.FocusAsync(); } catch { } }
    }

    private bool DraftValido =>
        !string.IsNullOrWhiteSpace(_draft.Nit) && !string.IsNullOrWhiteSpace(_draft.RazonSocial);

    private sealed class EmpresaDraft
    {
        public string Nit = "";
        public string? Dv;
        public string RazonSocial = "";
        public string? NombreComercial;
        public string? Email;
        public string? Telefono;
        public void Reset() { Nit = ""; Dv = null; RazonSocial = ""; NombreComercial = null; Email = null; Telefono = null; }
    }

    private async Task RowKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && DraftValido) await CrearEmpresaInline();
    }

    private async Task CrearEmpresaInline()
    {
        if (!DraftValido) return;
        _busy = true;
        try
        {
            await OnCrear.InvokeAsync(DraftDto());
            _draft.Reset(); _nonce++; _focusPending = true;
        }
        finally { _busy = false; }
    }

    // Expander: mismo alta pero la pagina abre la ficha de la empresa recien creada.
    private async Task CrearEmpresaAbrirInline()
    {
        if (!DraftValido) return;
        _busy = true;
        try
        {
            await OnCrearAbrir.InvokeAsync(DraftDto());
            _draft.Reset(); _nonce++;
        }
        finally { _busy = false; }
    }

    private NuevaEmpresaDir DraftDto() => new(
        _draft.Nit.Trim(),
        string.IsNullOrWhiteSpace(_draft.Dv) ? null : _draft.Dv.Trim(),
        _draft.RazonSocial.Trim(),
        string.IsNullOrWhiteSpace(_draft.NombreComercial) ? null : _draft.NombreComercial.Trim(),
        string.IsNullOrWhiteSpace(_draft.Email) ? null : _draft.Email.Trim(),
        string.IsNullOrWhiteSpace(_draft.Telefono) ? null : _draft.Telefono.Trim());

    private static string ChipStyle(string? color)
        => string.IsNullOrWhiteSpace(color) ? "" : $"background:{color}1A;color:{color};border-color:{color}55;";

    private static string InicialesEmpresa(string? razon)
    {
        var r = (razon ?? "").Trim();
        if (r.Length == 0) return "?";
        var partes = r.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var s = partes.Length >= 2 ? $"{partes[0][0]}{partes[1][0]}" : r[..Math.Min(2, r.Length)];
        return s.ToUpper();
    }
}

<style>
    /* Grid propio de empresas (misma familia dvp-*, columnas distintas) */
    /* Orden: Expandir, Razon social, Nombre comercial, NIT, Email, Telefono, Estado. */
    .dve-grid { display: grid; grid-template-columns: 34px 1.6fr 1.4fr 1.1fr 1.6fr 1.1fr 92px; align-items: center; gap: 8px; padding: 6px 14px; min-width: 960px; }
    .dtab-exp-col { display: flex; align-items: center; justify-content: center; }
    .dtab-exp { width: 26px; height: 26px; border: 0; border-radius: 7px; background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0; transition: opacity .12s, background .12s; }
    .dtab-row:hover .dtab-exp, .dtab-newrow:hover .dtab-exp, .dtab-newrow:focus-within .dtab-exp { opacity: 1; }
    .dtab-exp:hover { background: var(--propia-brand-soft); }
    .dtab-exp:disabled { opacity: 0; cursor: default; }
    .dtab-newrow:hover .dtab-exp:disabled, .dtab-newrow:focus-within .dtab-exp:disabled { opacity: .35; }
    .dtab-cell { width: 100%; box-sizing: border-box; border: 1px solid transparent; border-radius: 7px; padding: 5px 8px; font-size: 12.5px; color: var(--propia-text-secondary); background: transparent; outline: none; font-family: inherit; }
    .dtab-cell:hover { border-color: var(--propia-border-card); background: var(--propia-bg-card-soft); }
    .dtab-cell:focus { border-color: var(--propia-brand, var(--propia-brand)); background: var(--propia-bg-card); color: var(--propia-text-body); }
    .dtab-cell-nom { font-weight: 700; color: var(--propia-text-body); }
    .dtab-ro { color: var(--propia-text-muted); }
    .dtab-group { display: flex; align-items: center; gap: 10px; padding: 10px 14px 6px; }
    .dtab-group--row { border-top: 1px solid var(--propia-border-divider); margin-top: 4px; }
    .dtab-group-chip { font-size: 12px; }
    .dtab-group-n { font-size: 11.5px; font-weight: 700; color: var(--propia-text-muted); background: var(--propia-bg-card-soft); border-radius: 10px; padding: 1px 9px; }
</style>
