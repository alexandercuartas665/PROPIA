@* Vista de empresas del Directorio: alterna Lista y Tabla (todas las columnas + alta inline).
   Extraida de Directorio.razor, que aporta las clases dir-* y dtab-*; aqui solo va .dve-grid. *@
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime Js
@inject NavigationManager Nav
@implements IDisposable

@* El toggle Lista/Tabla vive en la pagina (barra de filtros), no aqui: la vista llega por
   parametro para que la seleccion se comparta entre pestanas y se pueda persistir. *@
@if (Empresas is null)
{
    <div class="dir-loading"><div class="spinner-border" style="color: var(--propia-brand, var(--propia-brand));"></div></div>
}
else if (Vista == "lista")
{
    @if (Empresas.Count == 0)
    {
        <div class="dir-empty"><strong>Sin empresas vinculadas a esta copropiedad aun.</strong><span>Usa la vista Tabla para agregar la primera.</span></div>
    }
    else
    {
        <div class="dir-list">
            @foreach (var item in FilasRender())
            {
                if (item.EsGrupo)
                {
                    var g = item.Grupo!;
                    <div class="dtab-group">
                        <span class="dir-tag dir-tag--et dtab-group-chip" style="@ChipStyle(g.Color)">@EtiquetaIconos.Svg(g.Icono)<span>@g.Titulo</span></span>
                        <span class="dtab-group-n">@g.Items.Count</span>
                    </div>
                    continue;
                }
                var e = item.Empresa!;
                var eid = e.Id;
                <button type="button" class="dir-row" @onclick="() => OnAbrir.InvokeAsync(eid)">
                    <div class="dir-avatar dir-avatar--empresa">@InicialesEmpresa(e.RazonSocial)</div>
                    <div class="dir-col-main">
                        <div class="dir-name">@e.RazonSocial</div>
                        <div class="dir-meta">NIT @e.Nit@(string.IsNullOrEmpty(e.DigitoVerificacion) ? "" : $"-{e.DigitoVerificacion}")</div>
                    </div>
                    <div class="dir-tags">
                        @if (e.Etiquetas is not null)
                        {
                            @foreach (var et in e.Etiquetas)
                            {
                                <span class="dir-tag dir-tag--et" style="@ChipStyle(et.Color)">@EtiquetaIconos.Svg(et.Icono)<span>@et.Nombre</span></span>
                            }
                        }
                        @if (!string.IsNullOrEmpty(e.NombreComercial)) { <span class="dir-tag dir-tag--mute">@e.NombreComercial</span> }
                    </div>
                    <div class="dir-unidad">@(e.Telefono ?? "")</div>
                    <div class="dir-estado">
                        <span class="dir-dot dir-dot--ok"></span>
                        <span class="dir-estado-txt dir-estado-txt--ok">@e.Estado</span>
                    </div>
                    <svg class="dir-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C3D0DD" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                </button>
            }
        </div>
    }
}
else
{
    @if (Seleccion is not null && Seleccion.Count > 0)
    {
        <div class="dtab-selbar">
            <span class="dtab-selbar-n">@Seleccion.Count seleccionado@(Seleccion.Count == 1 ? "" : "s")</span>
            <button type="button" class="dtab-selbar-del" @onclick="() => _confirmDel = true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                Quitar del directorio
            </button>
            <button type="button" class="dtab-selbar-x" @onclick="() => OnDeseleccionar.InvokeAsync()">Deseleccionar</button>
        </div>
    }
    @if (_confirmDel)
    {
        <div class="dtab-cfg-back" @onclick="() => { if (!_bulkBusy) _confirmDel = false; }">
            <div class="dtab-confirm" @onclick:stopPropagation="true">
                <div class="dtab-confirm-t">Quitar @(Seleccion?.Count ?? 0) registro@(Seleccion?.Count == 1 ? "" : "s") del directorio</div>
                <div class="dtab-confirm-s">Se inactiva su vinculo con esta copropiedad. La empresa sigue existiendo a nivel global y puede volver a vincularse luego.</div>
                <div class="dtab-confirm-acts">
                    <button type="button" class="dtab-cbtn" @onclick="() => _confirmDel = false" disabled="@_bulkBusy">Cancelar</button>
                    <button type="button" class="dtab-selbar-del" @onclick="QuitarSeleccionAsync" disabled="@_bulkBusy">@(_bulkBusy ? "Quitando..." : "Si, quitar")</button>
                </div>
            </div>
        </div>
    }
    <div class="dtab-table">
        <div class="dtab-scroll">
            <div class="dtab-head dve-grid" style="grid-template-columns:@GridCols">
                <div class="dtab-sel-cell"><label class="dtab-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodoSeleccionado" @onchange="ev => OnSeleccionarTodo.InvokeAsync((bool)(ev.Value ?? false))" /></label></div>
                <div></div>
                @foreach (var c in ColsVisibles)
                {
                    var clave = c.Key;
                    <div class="dtab-th dtab-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                         @onmousedown="ev => IniciarReorder(ev, clave)" @onclick="() => OnOrdenar.InvokeAsync(clave)">
                        <span class="dtab-th-lbl">@Etiqueta(c)</span>
                        @if (SortKey == clave) { <span class="dtab-th-arrow">@((MarkupString)(SortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                        @{ var lblFija = Etiqueta(c); }
                        <button type="button" class="dtab-th-gear" title="Opciones de columna"
                                @onclick:stopPropagation="true" @onmousedown:stopPropagation="true"
                                @onclick="mev => OnAbrirColMenu.InvokeAsync((clave, lblFija, false, mev.ClientX, mev.ClientY))">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                        </button>
                        <span class="dtab-col-rz" title="Arrastra para ajustar ancho | doble clic para autoajustar"
                              @onmousedown="ev => IniciarResize(ev, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true"
                              @onclick:stopPropagation="true" @ondblclick="() => ResetResize(clave)" @ondblclick:stopPropagation="true"></span>
                    </div>
                }
                @if (Defs is not null)
                {
                    @foreach (var d in Defs)
                    {
                        var def = d;
                        <div class="dtab-th dtab-th-dyn">
                            <span class="dtab-th-lbl">@d.Label.ToUpperInvariant()</span>
                            <button type="button" class="dtab-th-gear" title="Opciones de columna" @onclick='mev => OnAbrirColMenu.InvokeAsync(("cd:" + def.Id, def.Label, true, mev.ClientX, mev.ClientY))'>
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                            </button>
                        </div>
                    }
                }
                <div class="dtab-addcol-h"><button type="button" class="dtab-addcol-btn" title="Crear campo nuevo (columna)" @onclick="() => OnCrearCampo.InvokeAsync()"><i class="fi fi-rr-plus"></i></button></div>
                <div></div>
            </div>
            @foreach (var item in FilasRender())
            {
                if (item.EsGrupo)
                {
                    var g = item.Grupo!;
                    <div class="dtab-group dtab-group--row">
                        <span class="dir-tag dir-tag--et dtab-group-chip" style="@ChipStyle(g.Color)">@EtiquetaIconos.Svg(g.Icono)<span>@g.Titulo</span></span>
                        <span class="dtab-group-n">@g.Items.Count</span>
                    </div>
                    continue;
                }
                var e = item.Empresa!;
                var eid = e.Id;
                <div class="dtab-row dve-grid @(Seleccion is not null && Seleccion.Contains(eid) ? "dtab-row-sel" : "")" style="grid-template-columns:@GridCols" @oncontextmenu="ev => AbrirCtx(ev, e)" @oncontextmenu:preventDefault="true">
                    <div class="dtab-sel-cell"><label class="dtab-chk"><input type="checkbox" checked="@(Seleccion is not null && Seleccion.Contains(eid))" @onchange="ev => OnSeleccionar.InvokeAsync((eid, (bool)(ev.Value ?? false)))" @onclick:stopPropagation="true" /></label></div>
                    <div class="dtab-exp-col">
                        <button type="button" class="dtab-exp" title="Abrir la ficha para editar" @onclick="() => OnAbrir.InvokeAsync(eid)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @foreach (var c in ColsVisibles)
                    {
                        switch (c.Key)
                        {
                            case "razon":
                                <input class="dtab-cell dtab-cell-nom" value="@e.RazonSocial" @onchange="@(ev => Editar(eid, "razon", ev))" />
                                break;
                            case "comercial":
                                <input class="dtab-cell" value="@(e.NombreComercial ?? "")" placeholder="-" @onchange="@(ev => Editar(eid, "comercial", ev))" />
                                break;
                            case "nit":
                                <div class="dtab-c dtab-ro" title="El NIT se edita en la ficha">@e.Nit@(string.IsNullOrEmpty(e.DigitoVerificacion) ? "" : $"-{e.DigitoVerificacion}")</div>
                                break;
                            case "email":
                                <input class="dtab-cell" value="@(e.Email ?? "")" placeholder="-" @onchange="@(ev => Editar(eid, "email", ev))" />
                                break;
                            case "telefono":
                                <input class="dtab-cell" value="@(e.Telefono ?? "")" placeholder="-" @onchange="@(ev => Editar(eid, "telefono", ev))" />
                                break;
                            case "estado":
                                <div class="dtab-c"><span class="dtab-badge dtab-badge--ok">@e.Estado</span></div>
                                break;
                        }
                    }
                    @if (Defs is not null)
                    {
                        @foreach (var d in Defs)
                        {
                            var def = d;
                            if (e.RegistroCamposId is Guid reg)
                            {
                                var val = ValorDin(reg, def.Id);
                                switch (def.Tipo)
                                {
                                    case TipoCampoTablero.Seleccion:
                                        <select class="dtab-cell" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())">
                                            <option value="">-</option>
                                            @foreach (var op in def.OpcionesArray()) { <option value="@op" selected="@(op == val)">@op</option> }
                                        </select>
                                        break;
                                    case TipoCampoTablero.Numero:
                                    case TipoCampoTablero.Moneda:
                                    case TipoCampoTablero.Porcentaje:
                                        <input class="dtab-cell" type="number" step="any" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Fecha:
                                        <input class="dtab-cell" type="date" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())" />
                                        break;
                                    case TipoCampoTablero.Booleano:
                                        <select class="dtab-cell" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())">
                                            <option value="">-</option>
                                            <option value="Si" selected="@(val == "Si")">Si</option>
                                            <option value="No" selected="@(val == "No")">No</option>
                                        </select>
                                        break;
                                    case TipoCampoTablero.Formula:
                                        <div class="dtab-c dtab-ro" title="Se calcula automaticamente">@(string.IsNullOrWhiteSpace(val) ? "-" : val)</div>
                                        break;
                                    case TipoCampoTablero.Usuario:
                                    case TipoCampoTablero.Directorio:
                                        <div class="dtab-c dtab-ro" title="Se edita desde la ficha / Residentes">@(NombreRel(val) ?? "-")</div>
                                        break;
                                    default:
                                        <input class="dtab-cell" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())" />
                                        break;
                                }
                            }
                            else
                            {
                                <div class="dtab-c dtab-ro" title="Sin unidad vinculada: los campos propios se editan desde una unidad">-</div>
                            }
                        }
                    }
                    <div class="dtab-addcol-cell"></div>
                    <div></div>
                </div>
            }
            @* @@key limpia la fila al crear; @@oninput SIN value= evita perder pulsaciones
               (value= se reafirma en cada re-render y pisa lo escrito en Blazor Server).
               Razon social y NIT son requeridos para el alta: no se pueden ocultar. *@
            <div class="dtab-newrow dve-grid" @key="_nonce" style="grid-template-columns:@GridCols">
                <div class="dtab-sel-cell"></div>
                <div class="dtab-exp-col">
                    <button type="button" class="dtab-exp" tabindex="-1" title="Crear y abrir ficha" @onclick="CrearEmpresaAbrirInline" disabled="@(_busy || !DraftValido)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                </div>
                @foreach (var c in ColsVisibles)
                {
                    switch (c.Key)
                    {
                        case "razon":
                            <input class="dtab-inp" @ref="_firstRef" placeholder="Nueva empresa (razon social)..." @oninput="@(ev => _draft.RazonSocial = ev.Value?.ToString() ?? string.Empty)" @onkeydown="RowKeydown" />
                            break;
                        case "comercial":
                            <input class="dtab-inp" placeholder="Nombre comercial" @oninput="@(ev => _draft.NombreComercial = ev.Value?.ToString())" @onkeydown="RowKeydown" />
                            break;
                        case "nit":
                            <input class="dtab-inp" placeholder="NIT" @oninput="@(ev => _draft.Nit = ev.Value?.ToString() ?? string.Empty)" @onkeydown="RowKeydown" />
                            break;
                        case "email":
                            <input class="dtab-inp" placeholder="Email" @oninput="@(ev => _draft.Email = ev.Value?.ToString())" @onkeydown="RowKeydown" />
                            break;
                        case "telefono":
                            <input class="dtab-inp" placeholder="Telefono" @oninput="@(ev => _draft.Telefono = ev.Value?.ToString())" @onkeydown="RowKeydown" />
                            break;
                        case "estado":
                            <div class="dtab-nf-mut">Activo</div>
                            break;
                    }
                }
                @if (Defs is not null)
                {
                    @foreach (var d in Defs) { <div class="dtab-c dtab-ro" title="Los campos propios se completan tras vincular a una unidad">-</div> }
                }
                <div class="dtab-addcol-cell"></div>
                <div class="dtab-act dtab-act-nf">
                    <button type="button" class="dtab-add" title="Agregar (Enter)" @onclick="CrearEmpresaInline" disabled="@_busy">+ Agregar</button>
                </div>
            </div>
        </div>
        @* Footer canonico: visible SIEMPRE con la tabla (incluso 0 filas -> "Mostrando 0 de 0");
           solo se oculta con agrupacion activa (Grupos no null). *@
        @if (Grupos is null)
        {
            <TablaPager Total="Total" Pagina="Pagina" PorPagina="PorPagina" Entidad="empresas"
                        PaginaChanged="PaginaChanged" PorPaginaChanged="PorPaginaChanged" />
        }
    </div>
}

@* Menu contextual (clic derecho) y toast breve: la vista tabla vive arriba, estos van al raiz. *@
<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />
@if (_toast is not null) { <div class="dtab-toast">@_toast</div> }

@code {
    [Parameter] public List<EmpresaResumenDto>? Empresas { get; set; }
    [Parameter] public EventCallback<Guid> OnAbrir { get; set; }
    [Parameter] public EventCallback<NuevaEmpresaDir> OnCrear { get; set; }
    /// <summary>Variante del alta: crear y ABRIR la ficha de una (expander de la fila).</summary>
    [Parameter] public EventCallback<NuevaEmpresaDir> OnCrearAbrir { get; set; }
    /// <summary>Edicion inline de una celda: la pagina persiste (tiene el DTO completo y Auth).</summary>
    [Parameter] public EventCallback<DirectorioPersonasVista.EdicionCampoDir> OnEditarCampo { get; set; }

    /// <summary>Agrupacion por etiqueta que arma la pagina; si es null, la tabla va plana.</summary>
    [Parameter] public List<Grupo>? Grupos { get; set; }

    /// <summary>Config de columnas por usuario (visibilidad + nombre) desde localStorage;
    /// clave = Key de la columna. Reutiliza el tipo ColPref del directorio de personas.</summary>
    [Parameter] public Dictionary<string, DirectorioPersonasVista.ColPref>? ColsConfig { get; set; }

    /// <summary>Orden de columnas (claves) elegido por el usuario; si es null, se usa el orden del catalogo.</summary>
    [Parameter] public List<string>? ColsOrder { get; set; }

    /// <summary>Ancho manual por columna (px), desde localStorage; clave = Key de la columna.</summary>
    [Parameter] public Dictionary<string, int>? ColsWidth { get; set; }
    /// <summary>Columna activa de orden y su sentido (1 asc / -1 desc); para pintar la flecha del header.</summary>
    [Parameter] public string? SortKey { get; set; }
    [Parameter] public int SortDir { get; set; } = 1;
    /// <summary>Clic en un header: la pagina alterna el orden (se aplica ANTES de paginar).</summary>
    [Parameter] public EventCallback<string> OnOrdenar { get; set; }
    /// <summary>Arrastre de columna (origen, destino): la pagina reordena y persiste en localStorage.</summary>
    [Parameter] public EventCallback<(string Src, string Dest)> OnReordenar { get; set; }
    /// <summary>Ancho final de una columna (px; 0 = restablecer): la pagina persiste en localStorage.</summary>
    [Parameter] public EventCallback<(string Clave, int Width)> OnRedimensionar { get; set; }

    /// <summary>Ids (de fila) seleccionados; los mantiene la pagina. Null = sin seleccion.</summary>
    [Parameter] public HashSet<Guid>? Seleccion { get; set; }
    /// <summary>true cuando toda la lista filtrada esta seleccionada (para el check del header).</summary>
    [Parameter] public bool TodoSeleccionado { get; set; }
    /// <summary>Marcar/desmarcar una fila (Id de la fila, estado del check).</summary>
    [Parameter] public EventCallback<(Guid Id, bool On)> OnSeleccionar { get; set; }
    /// <summary>Marcar/desmarcar todo (select-all del header).</summary>
    [Parameter] public EventCallback<bool> OnSeleccionarTodo { get; set; }
    /// <summary>Limpiar la seleccion (Deseleccionar).</summary>
    [Parameter] public EventCallback OnDeseleccionar { get; set; }
    /// <summary>Quitar del directorio los seleccionados (la pagina inactiva sus vinculos y recarga).</summary>
    [Parameter] public EventCallback OnQuitarSeleccion { get; set; }
    /// <summary>Quitar del directorio una fila por su VinculoId (menu contextual).</summary>
    [Parameter] public EventCallback<Guid> OnQuitarVinculo { get; set; }

    // ---- Campos dinamicos (subsistema "personas", compartido: una empresa miembro de una unidad es una
    // UnidadPersona con EntidadTipo=Empresa). Valores sobre el vinculo unidad-empresa activo principal. ----
    /// <summary>Definiciones de campos propios (personas-campos), en orden.</summary>
    [Parameter] public List<CampoDinDef>? Defs { get; set; }
    /// <summary>Valores por registro (UnidadPersonaId) -> (defId -> valor).</summary>
    [Parameter] public Dictionary<Guid, Dictionary<Guid, string?>>? Valores { get; set; }
    /// <summary>Nombres para render de campos Usuario/Directorio (id -> nombre); solo lectura aqui.</summary>
    [Parameter] public Dictionary<Guid, string>? UsuarioNombre { get; set; }
    /// <summary>Guardar el valor de un campo propio (registro, definicion, valor).</summary>
    [Parameter] public EventCallback<(Guid Registro, Guid Def, string? Valor)> OnGuardarDinamico { get; set; }
    /// <summary>Abrir el modal de crear campo (boton "+").</summary>
    [Parameter] public EventCallback OnCrearCampo { get; set; }
    /// <summary>Abrir el modal de editar/eliminar un campo (engranaje de la columna).</summary>
    [Parameter] public EventCallback<CampoDinDef> OnEditarCampoDef { get; set; }
    /// <summary>Abrir el menu de columna (chevron del header): clave, etiqueta, si es dinamica y coordenadas del cursor.</summary>
    [Parameter] public EventCallback<(string Clave, string Label, bool Dyn, double X, double Y)> OnAbrirColMenu { get; set; }

    // Paginacion (footer canonico, dentro del contenedor .dtab-table). La pagina la controla el padre.
    [Parameter] public int Total { get; set; }
    [Parameter] public int Pagina { get; set; } = 1;
    [Parameter] public int PorPagina { get; set; } = 25;
    [Parameter] public EventCallback<int> PaginaChanged { get; set; }
    [Parameter] public EventCallback<int> PorPaginaChanged { get; set; }

    private sealed record ColDef(string Key, string DefLabel, string Width, bool Hideable);
    private static readonly ColDef[] Catalogo =
    {
        new("razon", "RAZON SOCIAL", "1.6fr", false),
        new("comercial", "NOMBRE COMERCIAL", "1.4fr", true),
        new("nit", "NIT", "1.1fr", false),
        new("email", "EMAIL", "1.6fr", true),
        new("telefono", "TELEFONO", "1.1fr", true),
        new("estado", "ESTADO", "92px", true),
    };

    /// <summary>Columnas del directorio de empresas para armar el panel Configurar en la pagina.</summary>
    public static IReadOnlyList<(string Key, string DefLabel, bool Hideable)> Columnas =>
        Catalogo.Select(c => (c.Key, c.DefLabel, c.Hideable)).ToList();

    private bool EsVisible(ColDef c) => !c.Hideable || ColsConfig is null || !ColsConfig.TryGetValue(c.Key, out var p) || p.Visible;
    private string Etiqueta(ColDef c) => (ColsConfig is not null && ColsConfig.TryGetValue(c.Key, out var p) && !string.IsNullOrWhiteSpace(p.Label)) ? p.Label! : c.DefLabel;
    private IEnumerable<ColDef> ColsVisibles
    {
        get
        {
            IEnumerable<ColDef> ordenado = Catalogo;
            if (ColsOrder is { Count: > 0 })
            {
                var byKey = Catalogo.ToDictionary(c => c.Key);
                ordenado = ColsOrder.Where(byKey.ContainsKey).Select(k => byKey[k])
                    .Concat(Catalogo.Where(c => !ColsOrder.Contains(c.Key)));
            }
            return ordenado.Where(EsVisible);
        }
    }
    private string GridCols => "34px 34px "
        + string.Join(" ", ColsVisibles.Select(AnchoCol))
        + (Defs is { Count: > 0 } ? " " + string.Join(" ", Defs.Select(_ => "minmax(140px,1fr)")) : "")
        + " 40px 44px";
    private string AnchoCol(ColDef c) => ColsWidth is not null && ColsWidth.TryGetValue(c.Key, out var w) && w > 0 ? w + "px" : c.Width;

    // Campos dinamicos: lectura/escritura del valor sobre el registro (UnidadPersona activo principal).
    private string? ValorDin(Guid reg, Guid defId) => Valores is not null && Valores.TryGetValue(reg, out var m) && m.TryGetValue(defId, out var v) ? v : null;
    private string? NombreRel(string? val) => !string.IsNullOrWhiteSpace(val) && Guid.TryParse(val, out var g) && UsuarioNombre is not null && UsuarioNombre.TryGetValue(g, out var n) ? n : val;
    private Task GuardarDin(Guid reg, Guid defId, string? val) => OnGuardarDinamico.InvokeAsync((reg, defId, val));

    /// <summary>Un grupo de la vista agrupada: cabecera (etiqueta) + sus empresas.</summary>
    public sealed record Grupo(string Titulo, string? Color, string? Icono, List<EmpresaResumenDto> Items);

    private readonly record struct FilaRender(bool EsGrupo, Grupo? Grupo, EmpresaResumenDto? Empresa);

    private IEnumerable<FilaRender> FilasRender()
    {
        if (Grupos is null)
        {
            foreach (var e in Empresas!) yield return new FilaRender(false, null, e);
        }
        else
        {
            foreach (var g in Grupos)
            {
                yield return new FilaRender(true, g, null);
                foreach (var e in g.Items) yield return new FilaRender(false, null, e);
            }
        }
    }

    private Task Editar(Guid id, string campo, ChangeEventArgs e)
        => OnEditarCampo.InvokeAsync(new DirectorioPersonasVista.EdicionCampoDir(id, campo, e.Value?.ToString()));

    [Parameter] public string Vista { get; set; } = "lista";  // "lista" | "tabla" (la controla Directorio.razor)
    private bool _busy;
    private readonly EmpresaDraft _draft = new();
    private int _nonce;
    private bool _focusPending;
    private ElementReference _firstRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending) { _focusPending = false; try { await _firstRef.FocusAsync(); } catch { } }
    }

    private bool DraftValido =>
        !string.IsNullOrWhiteSpace(_draft.Nit) && !string.IsNullOrWhiteSpace(_draft.RazonSocial);

    private sealed class EmpresaDraft
    {
        public string Nit = "";
        public string? Dv;
        public string RazonSocial = "";
        public string? NombreComercial;
        public string? Email;
        public string? Telefono;
        public void Reset() { Nit = ""; Dv = null; RazonSocial = ""; NombreComercial = null; Email = null; Telefono = null; }
    }

    private async Task RowKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && DraftValido) await CrearEmpresaInline();
    }

    // Canonico: el boton "+ Agregar" NO se deshabilita por borrador invalido; se valida al clic con toast.
    private async Task CrearEmpresaInline()
    {
        if (!DraftValido) { Toast("Completa razon social y NIT para agregar."); return; }
        _busy = true;
        try
        {
            await OnCrear.InvokeAsync(DraftDto());
            _draft.Reset(); _nonce++; _focusPending = true;
        }
        finally { _busy = false; }
    }

    // Expander: mismo alta pero la pagina abre la ficha de la empresa recien creada.
    private async Task CrearEmpresaAbrirInline()
    {
        if (!DraftValido) return;
        _busy = true;
        try
        {
            await OnCrearAbrir.InvokeAsync(DraftDto());
            _draft.Reset(); _nonce++;
        }
        finally { _busy = false; }
    }

    private NuevaEmpresaDir DraftDto() => new(
        _draft.Nit.Trim(),
        string.IsNullOrWhiteSpace(_draft.Dv) ? null : _draft.Dv.Trim(),
        _draft.RazonSocial.Trim(),
        string.IsNullOrWhiteSpace(_draft.NombreComercial) ? null : _draft.NombreComercial.Trim(),
        string.IsNullOrWhiteSpace(_draft.Email) ? null : _draft.Email.Trim(),
        string.IsNullOrWhiteSpace(_draft.Telefono) ? null : _draft.Telefono.Trim());

    // ===== Interacciones de tabla: el orden lo aplica la pagina (antes de paginar); aqui reordenar
    // por arrastre, redimensionar por puntero (JS compartido) y el menu contextual del clic derecho. =====
    private DotNetObjectReference<DirectorioEmpresasVista>? _self;
    private DotNetObjectReference<DirectorioEmpresasVista> Self => _self ??= DotNetObjectReference.Create(this);

    private async Task IniciarReorder(MouseEventArgs e, string clave)
    {
        try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", Self, clave, e.ClientX, e.ClientY); } catch { }
    }
    [JSInvokable]
    public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        await OnReordenar.InvokeAsync((src, dest));
    }
    private async Task IniciarResize(MouseEventArgs e, string clave)
    {
        try { await Js.InvokeVoidAsync("propiaTablaResize.start", Self, clave, e.ClientX); } catch { }
    }
    [JSInvokable]
    public async Task OnColResize(string clave, int width) => await OnRedimensionar.InvokeAsync((clave, width));
    private Task ResetResize(string clave) => OnRedimensionar.InvokeAsync((clave, 0));

    // Menu contextual (clic derecho sobre una fila). Insertar/Duplicar son stubs; no hay borrado real
    // (empresas es tabla global, sin endpoint de baja en el Directorio): "Quitar" remite a la ficha.
    private bool _ctxOpen;
    private double _ctxX, _ctxY;
    private List<TablaCtxMenu.Item> _ctxItems = new();
    private string? _toast;
    private System.Threading.CancellationTokenSource? _toastCts;

    // Barra de seleccion multiple (bulk): la confirmacion vive aqui; la accion real (inactivar los
    // vinculos + recargar) la ejecuta la pagina via OnQuitarSeleccion.
    private bool _confirmDel;
    private bool _bulkBusy;
    private async Task QuitarSeleccionAsync()
    {
        _bulkBusy = true;
        try { await OnQuitarSeleccion.InvokeAsync(); }
        finally { _bulkBusy = false; _confirmDel = false; }
    }

    private void AbrirCtx(MouseEventArgs ev, EmpresaResumenDto emp)
    {
        _ctxX = ev.ClientX; _ctxY = ev.ClientY;
        var eid = emp.Id;
        var vinc = emp.VinculoId;
        _ctxItems = new()
        {
            new("Abrir ficha", "fi-rr-expand", OnClick: () => OnAbrir.InvokeAsync(eid)),
            new("Copiar enlace del registro", "fi-rr-link-alt", OnClick: () => CopiarEnlace(eid)),
            new("Insertar registro arriba", "fi-rr-arrow-small-up", OnClick: StubCtx),
            new("Insertar registro abajo", "fi-rr-arrow-small-down", OnClick: StubCtx),
            new(Sep: true),
            new("Quitar del directorio", "fi-rr-trash", Danger: true, OnClick: () => QuitarUno(vinc)),
        };
        _ctxOpen = true;
    }
    private async Task CopiarEnlace(Guid id)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}directorio#empresa-{id}"); Toast("Enlace del registro copiado."); }
        catch { Toast("No se pudo copiar el enlace."); }
    }
    private Task StubCtx() { Toast("Accion aun no disponible en esta version."); return Task.CompletedTask; }
    // Quitar una empresa del directorio = inactivar su vinculo con la copropiedad (con confirmacion).
    // No borra la empresa global; puede volver a vincularse luego.
    private async Task QuitarUno(Guid vinculoId)
    {
        if (vinculoId == Guid.Empty) { Toast("Este registro no tiene un vinculo activo que quitar."); return; }
        var ok = await Js.InvokeAsync<bool>("confirm", "Quitar este registro del directorio? Se inactiva su vinculo con la copropiedad.");
        if (ok) await OnQuitarVinculo.InvokeAsync(vinculoId);
    }
    private void Toast(string m)
    {
        _toast = m;
        _toastCts?.Cancel();
        _toastCts = new System.Threading.CancellationTokenSource();
        var tok = _toastCts.Token;
        _ = InvokeAsync(async () =>
        {
            try { await Task.Delay(2600, tok); } catch { return; }
            if (!tok.IsCancellationRequested) { _toast = null; StateHasChanged(); }
        });
    }

    public void Dispose() { _self?.Dispose(); _toastCts?.Cancel(); }

    private static string ChipStyle(string? color)
        => string.IsNullOrWhiteSpace(color) ? "" : $"background:{color}1A;color:{color};border-color:{color}55;";

    private static string InicialesEmpresa(string? razon)
    {
        var r = (razon ?? "").Trim();
        if (r.Length == 0) return "?";
        var partes = r.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var s = partes.Length >= 2 ? $"{partes[0][0]}{partes[1][0]}" : r[..Math.Min(2, r.Length)];
        return s.ToUpper();
    }
}

