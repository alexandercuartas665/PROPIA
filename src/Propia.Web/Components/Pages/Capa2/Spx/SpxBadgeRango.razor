@* Badge del rango de un recibo (replica: badgeRango): En rango / Sobre el tope / Bajo el minimo / Sin topes / Sin recibos. *@
@using Propia.Application.ServiciosPublicos
@switch (Rango)
{
    case RangoRecibo.Ok: <span class="srv-badge ok">En rango</span> break;
    case RangoRecibo.Alto: <span class="srv-badge danger">Sobre el tope</span> break;
    case RangoRecibo.Bajo: <span class="srv-badge warn">Bajo el mínimo</span> break;
    case RangoRecibo.Sin: <span class="spx-muted">Sin topes</span> break;
    default: <span class="spx-muted">Sin recibos</span> break;
}

@code {
    [Parameter] public RangoRecibo Rango { get; set; }
}
