@* Tabla del desglose de un recibo (replica: desgloseHtml): conceptos + "Total a pagar". *@
@using Propia.Application.ServiciosPublicos
<table class="spx-desg"><tbody>
    @foreach (var d in Conceptos)
    {
        <tr><td>@d.Concepto</td><td>@ReglasServicioPublico.Plata(d.Valor)</td></tr>
    }
    <tr class="spx-desg-tot"><td>Total a pagar</td><td>@ReglasServicioPublico.Plata(Total)</td></tr>
</tbody></table>

@code {
    [Parameter] public IReadOnlyList<ConceptoReciboDto> Conceptos { get; set; } = Array.Empty<ConceptoReciboDto>();
    [Parameter] public decimal? Total { get; set; }
}
