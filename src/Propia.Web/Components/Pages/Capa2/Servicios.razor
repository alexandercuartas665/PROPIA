    .srv-kpi-val { font-size: 30px; font-weight: 800; letter-spacing: -1px; color: #1B2A3A; margin-top: 5px; }
    .srv-kpi-val.ok { color: #1A8754; }
    .srv-kpi-val.danger { color: #C0383C; }

    .srv-alert { background: #FFF5F5; border: 1px solid #FBD5D5; border-radius: 14px; padding: 16px 18px; margin-bottom: 18px; }
    .srv-alert-head { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: .4px; color: #C0383C; margin-bottom: 12px; }
