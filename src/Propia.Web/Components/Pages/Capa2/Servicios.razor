@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private string _srvTab = "servicios";   // "servicios" | "publicos" (2.17). Contratos vive en /contratos.

    // Modo por ruta: /contratos = modulo Contratos (su propia pagina + item de menu); /servicios =
    // modulo Servicios (pestanas Servicios + Servicios publicos). Misma componente, dos rutas.
    private bool EsContratos =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').Split('?')[0].Equals("contratos", StringComparison.OrdinalIgnoreCase);
    private List<ContratoServicioDto> _contratos = new();

    // ---- Filtros de la tabla de contratos: buscador + constructor de reglas (estilo Tareas) ----
    private string _cFiltroTexto = "";
    private string _cAgrupar = "etapa";   // default: agrupado por etapa, como la Lista de Tareas

    // Indicadores tipo tarjeta (KPIs con degradado, estilo Tareas)
    private record CtrKpi(string Label, string Valor, string Sub, string Acento, string Icon);
    private List<CtrKpi> ContratoKpis()
    {
        int total = _contratos.Count;
        int vencidos = _contratos.Count(c => c.Estado == EstadoContrato.Vencido);
        int porVencer = _contratos.Count(c => c.AlertaVencimiento && c.Estado != EstadoContrato.Vencido);
        int vigentes = _contratos.Count(c => c.Estado == EstadoContrato.Vigente && !c.AlertaVencimiento);
        decimal valorMes = _contratos.Where(c => c.Estado != EstadoContrato.Vencido).Sum(c => c.ValorMensual ?? 0);
        // Acento por estado (icono con fondo pastel; tarjeta blanca estandar del sistema).
        var vencAcc = vencidos > 0 ? "err" : "ok";
        return new()
        {
            new("Total de contratos", total.ToString(), $"${valorMes.ToString("N0")}/mes vigente",
                "brand",
                "M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-3M9 7h6M9 11h6M9 15h4"),
            new("Vigentes", vigentes.ToString(), "al dia",
                "ok",
                "M20 6 9 17l-5-5"),
            new("Por vencer", porVencer.ToString(), porVencer > 0 ? "requieren renovacion" : "ninguno cerca",
                "warn",
                "M12 8v4l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"),
            new("Vencidos", vencidos.ToString(), vencidos > 0 ? "requieren atencion" : "ninguno",
                vencAcc,
                "M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"),
        };
    }

    // -- Constructor de reglas de filtro (Donde / Y-O / campo + operador + valor) --
    private sealed class ReglaC { public string Campo = "estado"; public string Op = "es"; public string Valor = ""; }
    private readonly List<ReglaC> _reglasC = new();
    private string _logicaC = "and";
    private bool _filtrosMenuC;
    private bool ReglaActivaC(ReglaC r) => r.Op is "vacio" or "no_vacio" || !string.IsNullOrWhiteSpace(r.Valor);
    private int CuentaReglasC => _reglasC.Count(ReglaActivaC);
    private bool HayReglasActivas => _reglasC.Any(ReglaActivaC);
    private void ToggleFiltrosC() { _filtrosMenuC = !_filtrosMenuC; if (_filtrosMenuC && _reglasC.Count == 0) AgregarReglaC(); }
    private void AgregarReglaC() => _reglasC.Add(new ReglaC { Campo = "estado", Op = "es", Valor = "" });
    private void QuitarReglaC(int idx) { if (idx >= 0 && idx < _reglasC.Count) _reglasC.RemoveAt(idx); }
    private void LimpiarReglasC() { _reglasC.Clear(); _logicaC = "and"; }
    private void SetLogicaC(ChangeEventArgs e) => _logicaC = e.Value?.ToString() == "or" ? "or" : "and";
    private void SetReglaCampoC(int idx, ChangeEventArgs e)
    {
        if (idx < 0 || idx >= _reglasC.Count) return;
        _reglasC[idx].Campo = e.Value?.ToString() ?? "estado";
        var ops = OperadoresC(_reglasC[idx].Campo);
        if (!ops.Any(o => o.Key == _reglasC[idx].Op)) _reglasC[idx].Op = ops.First().Key;
        _reglasC[idx].Valor = "";
    }
    private void SetReglaOpC(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglasC.Count) _reglasC[idx].Op = e.Value?.ToString() ?? "es"; }
    private void SetReglaValorC(int idx, ChangeEventArgs e) { if (idx >= 0 && idx < _reglasC.Count) _reglasC[idx].Valor = e.Value?.ToString() ?? ""; }

    // Campos filtrables: fijos del contrato + campos personalizados activos
    private IEnumerable<(string Key, string Label)> CamposFiltroC()
    {
        yield return ("tercero", "Proveedor");
        yield return ("nit", "NIT");
        yield return ("tipo", "Tipo");
        yield return ("estado", "Estado");
        yield return ("inicio", "Inicio");
        yield return ("vence", "Vencimiento");
        yield return ("valor", "$/mes");
        foreach (var c in CamposActivos) yield return (c.Id.ToString(), c.Label);
    }
    private ContratoCampoDto? CampoDinC(string campo) => Guid.TryParse(campo, out var g) ? _cCampos.FirstOrDefault(c => c.Id == g) : null;
    private string FiltroKindC(string campo) => campo switch
    {
        "tipo" => "sel-tipo",
        "estado" => "sel-estado",
        "inicio" or "vence" => "fecha",
        "valor" => "num",
        "tercero" or "nit" => "texto",
        _ => CampoDinC(campo)?.Tipo switch
        {
            TipoCampoTablero.Numero or TipoCampoTablero.Moneda => "num",
            TipoCampoTablero.Fecha => "fecha",
            TipoCampoTablero.Seleccion => "sel-din",
            TipoCampoTablero.Booleano => "sel-bool",
            _ => "texto"
        }
    };
    private IEnumerable<(string Key, string Label)> OperadoresC(string campo)
    {
        switch (FiltroKindC(campo))
        {
            case "num":
                return new[] { ("=", "es igual a"), ("!=", "es distinto de"), (">", "mayor que"), (">=", "mayor o igual"),
                               ("<", "menor que"), ("<=", "menor o igual"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            case "fecha":
                return new[] { ("es", "es"), ("antes", "antes de"), ("despues", "despues de"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            case "sel-tipo":
            case "sel-estado":
            case "sel-din":
            case "sel-bool":
                return new[] { ("es", "es"), ("no_es", "no es"), ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
            default:
                return new[] { ("contiene", "contiene"), ("no_contiene", "no contiene"), ("es", "es"), ("no_es", "no es"),
                               ("vacio", "esta vacio"), ("no_vacio", "no esta vacio") };
        }
    }

    private static string EstadoSemantic(ContratoServicioDto c) =>
        c.Estado == EstadoContrato.Vencido ? "vencido"
        : c.AlertaVencimiento ? "por-vencer"
        : c.Estado == EstadoContrato.EnRenovacion ? "renovacion"
        : "vigente";

    private string ValorTextoC(ContratoServicioDto c, string campo) => campo switch
    {
        "tercero" => c.Proveedor ?? "",
        "nit" => c.NitProveedor ?? "",
        "tipo" => ((int)c.Tipo).ToString(),
        "estado" => EstadoSemantic(c),
        "valor" => c.ValorMensual?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
        "inicio" => c.FechaInicio.ToString("yyyy-MM-dd"),
        "vence" => c.FechaFin?.ToString("yyyy-MM-dd") ?? "",
        _ => ValorCampo(c, Guid.TryParse(campo, out var g) ? g : Guid.Empty) ?? ""
    };
    private decimal? ValorNumC(ContratoServicioDto c, string campo)
    {
        if (campo == "valor") return c.ValorMensual;
        return decimal.TryParse(ValorCampo(c, Guid.TryParse(campo, out var g) ? g : Guid.Empty), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    }
    private DateOnly? FechaC(ContratoServicioDto c, string campo)
    {
        if (campo == "inicio") return c.FechaInicio;
        if (campo == "vence") return c.FechaFin;
        return DateOnly.TryParse(ValorCampo(c, Guid.TryParse(campo, out var g) ? g : Guid.Empty), out var d) ? d : null;
    }
    private bool EvalReglaC(ContratoServicioDto c, ReglaC r)
    {
        var kind = FiltroKindC(r.Campo);
        if (kind == "num")
        {
            var nv = ValorNumC(c, r.Campo);
            if (r.Op == "vacio") return nv is null;
            if (r.Op == "no_vacio") return nv is not null;
            if (!decimal.TryParse(r.Valor, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var rv)) return true;
            if (nv is null) return false;
            return r.Op switch { "=" => nv == rv, "!=" => nv != rv, ">" => nv > rv, ">=" => nv >= rv, "<" => nv < rv, "<=" => nv <= rv, _ => true };
        }
        if (kind == "fecha")
        {
            var dv = FechaC(c, r.Campo);
            if (r.Op == "vacio") return dv is null;
            if (r.Op == "no_vacio") return dv is not null;
            if (!DateOnly.TryParse(r.Valor, out var rd)) return true;
            if (dv is null) return false;
            return r.Op switch { "es" => dv == rd, "antes" => dv < rd, "despues" => dv > rd, _ => true };
        }
        var sv = ValorTextoC(c, r.Campo);
        if (r.Op == "vacio") return string.IsNullOrWhiteSpace(sv);
        if (r.Op == "no_vacio") return !string.IsNullOrWhiteSpace(sv);
        if (string.IsNullOrEmpty(r.Valor)) return true;
        return r.Op switch
        {
            "es" => string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_es" => !string.Equals(sv, r.Valor, StringComparison.OrdinalIgnoreCase),
            "contiene" => sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            "no_contiene" => !sv.Contains(r.Valor, StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }
    // Editor de valor de una regla (segun tipo). Se oculta para vacio/no_vacio.
    private RenderFragment RenderValorC(int idx) => builder =>
    {
        if (idx < 0 || idx >= _reglasC.Count) return;
        var r = _reglasC[idx];
        var kind = FiltroKindC(r.Campo);
        void Sel(IEnumerable<(string Val, string Txt)> opts, string ph)
        {
            builder.OpenElement(0, "select");
            builder.AddAttribute(1, "class", "ctr-frule-v");
            builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValorC(idx, e)));
            builder.OpenElement(3, "option");
            builder.AddAttribute(4, "value", "");
            builder.AddAttribute(5, "selected", string.IsNullOrEmpty(r.Valor));
            builder.AddContent(6, ph);
            builder.CloseElement();
            var k = 7;
            foreach (var (val, txt) in opts)
            {
                builder.OpenElement(k++, "option");
                builder.AddAttribute(k++, "value", val);
                builder.AddAttribute(k++, "selected", r.Valor == val);
                builder.AddContent(k++, txt);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        void Inp(string type)
        {
            builder.OpenElement(20, "input");
            builder.AddAttribute(21, "class", "ctr-frule-v");
            builder.AddAttribute(22, "type", type);
            builder.AddAttribute(23, "value", r.Valor);
            builder.AddAttribute(24, "placeholder", "Valor");
            builder.AddAttribute(25, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetReglaValorC(idx, e)));
            builder.CloseElement();
        }
        switch (kind)
        {
            case "sel-tipo": Sel(Enum.GetValues<TipoServicio>().Select(t => (((int)t).ToString(), TipoLabel(t))), "Elegir tipo..."); break;
            case "sel-estado": Sel(new[] { ("vigente", "Vigente"), ("por-vencer", "Por vencer"), ("vencido", "Vencido"), ("renovacion", "En renovacion") }, "Elegir estado..."); break;
            case "sel-din": Sel(OpcionesDe(CampoDinC(r.Campo)!).Select(o => (o, o)), "Elegir opcion..."); break;
            case "sel-bool": Sel(new[] { ("Si", "Si"), ("No", "No") }, "Elegir..."); break;
            case "num": Inp("number"); break;
            case "fecha": Inp("date"); break;
            default: Inp("text"); break;
        }
    };

    private bool PasaFiltrosC(ContratoServicioDto c)
    {
        if (!string.IsNullOrWhiteSpace(_cFiltroTexto))
        {
            var t = _cFiltroTexto.Trim();
            var ok = (c.Proveedor ?? "").Contains(t, StringComparison.OrdinalIgnoreCase)
                  || (c.NitProveedor ?? "").Contains(t, StringComparison.OrdinalIgnoreCase)
                  || (c.Contacto ?? "").Contains(t, StringComparison.OrdinalIgnoreCase)
                  || TipoLabel(c.Tipo).Contains(t, StringComparison.OrdinalIgnoreCase);
            if (!ok) return false;
        }
        var activas = _reglasC.Where(ReglaActivaC).ToList();
        if (activas.Count == 0) return true;
        return _logicaC == "or" ? activas.Any(r => EvalReglaC(c, r)) : activas.All(r => EvalReglaC(c, r));
    }

    private IEnumerable<ContratoServicioDto> ContratosFiltrados()
        => _contratos.Where(PasaFiltrosC).OrderBy(c => c.Tipo).ThenBy(c => c.FechaFin);

    private IEnumerable<IGrouping<string, ContratoServicioDto>> AgruparContratos(IEnumerable<ContratoServicioDto> lst) =>
        _cAgrupar switch
        {
            "etapa"   => lst.GroupBy(c => EtapaNombreDe(c.EtapaId)).OrderBy(g => EtapaOrdenDe(g.Key)),
            "tipo"    => lst.GroupBy(c => TipoLabel(c.Tipo)).OrderBy(g => g.Key),
            "tercero" => lst.GroupBy(c => string.IsNullOrWhiteSpace(c.Proveedor) ? "(sin proveedor)" : c.Proveedor).OrderBy(g => g.Key),
            "estado"  => lst.GroupBy(c => EstadoTextoContrato(c)).OrderBy(g => g.Key),
            _ => lst.GroupBy(_ => "")
        };

    private string EtapaNombreDe(Guid? id) => _etapas.FirstOrDefault(e => e.Id == id)?.Nombre ?? "(sin etapa)";
    private int EtapaOrdenDe(string nombre) => _etapas.FirstOrDefault(e => e.Nombre == nombre)?.Orden ?? 999;

    private static string EstadoTextoContrato(ContratoServicioDto c) =>
        c.Estado == EstadoContrato.Vencido ? "Vencido"
        : c.AlertaVencimiento ? "Por vencer"
        : c.Estado == EstadoContrato.EnRenovacion ? "En renovacion"
