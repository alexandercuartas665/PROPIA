@page "/servicios"
@page "/contratos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.MiCopropiedad
@using Propia.Application.ServiciosPublicos
@using Propia.Application.Servicios
@using Propia.Application.Directorio
@using Propia.Application.Programaciones
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@using Propia.Web.Components.Shared.Modals
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject IModalService Modals
@implements IDisposable

<PageTitle>@(EsContratos ? "Contratos" : "Servicios") - PROPIA</PageTitle>

@* Modulo 2.5 (Finanzas) "Servicios y contratos". Estilo prototipo PROPIA.dc.html:
   3 KPIs + proximos a vencer + lista de contratos + modal crear/detalle. API /api/mi-copropiedad/contratos. *@

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="srv-wrap">
    <div class="srv-head">
        <div>
            <h1 class="srv-title">@(EsContratos ? "Contratos" : "Servicios")</h1>
            <p class="srv-sub">@(EsContratos ? "Contratos estrategicos con proveedores de la copropiedad." : "Servicios contratados y servicios publicos de la copropiedad.")</p>
        </div>
        @if (EsContratos)
        {
            <div class="srv-head-actions">
                <div class="ctr-vtoggle">
                    <button class="@(_vistaC == "tarjetas" ? "on" : "")" @onclick='() => CambiarVistaC("tarjetas")' title="Vista de tarjetas (Kanban)"><i class="fi fi-rr-apps"></i> Tarjetas</button>
                    <button class="@(_vistaC != "tarjetas" ? "on" : "")" @onclick='() => CambiarVistaC("tabla")' title="Vista de tabla"><i class="fi fi-rr-table-list"></i> Tabla</button>
                </div>
                <button class="ctr-cfg-btn" @onclick="() => _showConfigModal = true" title="Configurar estados y campos"><i class="fi fi-rr-settings"></i> Configurar</button>
                <button class="srv-btn-primary" @onclick="() => AbrirModal(null)"><i class="fi fi-rr-plus"></i> Nuevo contrato</button>
            </div>
        }
    </div>

    @* En /contratos no hay pestanas (es su propio modulo). En /servicios: Servicios + Servicios publicos.
       Contratos se separo a su propia pagina (/contratos) con su item de menu. *@
    @if (!EsContratos)
    {
    <div class="srv-tabs">
        <button class="srv-tab @(_srvTab == "servicios" ? "on" : "")" @onclick='() => _srvTab = "servicios"'>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h18"/></svg>Servicios
        </button>
        <button class="srv-tab @(_srvTab == "publicos" ? "on" : "")" @onclick="IrPublicos">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z"/></svg>Servicios publicos
        </button>
    </div>
    }

    @if (!EsContratos && _srvTab == "servicios")
    {
        var costoMes = _servicios.Sum(s => s.CostoMensual ?? 0);
        <div class="srv-kpis srv-kpis-4">
            <div class="srv-kpi"><div class="srv-kpi-lbl">Total de servicios</div><div class="srv-kpi-val">@_servicios.Count</div></div>
            <div class="srv-kpi"><div class="srv-kpi-lbl">Activos</div><div class="srv-kpi-val ok">@_servicios.Count(s => s.Estado == EstadoServicio.Activo)</div></div>
            <div class="srv-kpi"><div class="srv-kpi-lbl">Costo mensual</div><div class="srv-kpi-val">$@costoMes.ToString("N0")</div></div>
            <div class="srv-kpi"><div class="srv-kpi-lbl">Contratos vinculados</div><div class="srv-kpi-val">@_servicios.Sum(s => s.CantidadContratos)</div></div>
        </div>

        <div class="srv-card">
            <div class="srv-card-head">
                <span class="srv-card-title">Servicios contratados</span>
                <button class="srv-btn-primary" @onclick="() => AbrirServicioModal(null)"><i class="fi fi-rr-plus"></i> Nuevo servicio</button>
            </div>
            @if (_servicios.Count == 0)
            {
                <div class="srv-empty"><i class="fi fi-rr-briefcase"></i><div>Aun no hay servicios. Crea el primero con "Nuevo servicio".</div></div>
            }
            else
            {
                <div class="svc-table">
                    <div class="svc-thead">
                        <div class="svc-c-name">SERVICIO</div>
                        <div class="svc-c-tipo">TIPO</div>
                        <div class="svc-c-ejec">EJECUTA</div>
                        <div class="svc-c-cost">COSTO MES</div>
                        <div class="svc-c-cost">COSTO ANO</div>
                        <div class="svc-c-num">CONTRATOS</div>
                        <div class="svc-c-est">ESTADO</div>
                        <div class="svc-c-act"></div>
                    </div>
                    @foreach (var s in _servicios)
                    {
                        var ss = s;
                        <div class="svc-row" @onclick="() => AbrirServicioModal(ss)">
                            <div class="svc-c-name">
                                <div class="svc-row-ic">@TipoIcon(s.Tipo)</div>
                                <div style="min-width:0;"><div class="svc-name">@s.Nombre</div>@if (!string.IsNullOrEmpty(s.Descripcion)) { <div class="svc-desc">@s.Descripcion</div> }</div>
                            </div>
                            <div class="svc-c-tipo">@TipoLabel(s.Tipo)</div>
                            <div class="svc-c-ejec">@(string.IsNullOrEmpty(s.EjecutorNombre) ? "-" : s.EjecutorNombre)</div>
                            <div class="svc-c-cost">@(s.CostoMensual is { } cm ? "$" + cm.ToString("N0") : "-")</div>
                            <div class="svc-c-cost">@(s.CostoAnual is { } ca ? "$" + ca.ToString("N0") : "-")</div>
                            <div class="svc-c-num"><span class="svc-pill">@s.CantidadContratos</span></div>
                            <div class="svc-c-est">
                                @if (s.Estado == EstadoServicio.Activo) { <span class="srv-badge ok">Activo</span> }
                                else if (s.Estado == EstadoServicio.Suspendido) { <span class="srv-badge warn">Suspendido</span> }
                                else { <span class="srv-badge vencido">Inactivo</span> }
                            </div>
                            <div class="svc-c-act"><span class="srv-del" @onclick:stopPropagation="true" @onclick="() => EliminarServicioAsync(ss.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span></div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (EsContratos)
    {
    <div class="ctr-kpis">
        @foreach (var k in ContratoKpis())
        {
            @* Tarjeta blanca estandar del sistema (misma familia que las stats de Zonas/Reservas):
               icono con fondo pastel segun el acento, numero oscuro. *@
            <div class="ctr-kpi ctr-kpi--@k.Acento">
                <div class="ctr-kpi-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="@k.Icon" /></svg></div>
                <div class="ctr-kpi-body">
                    <div class="ctr-kpi-n">@k.Valor</div>
                    <div class="ctr-kpi-label">@k.Label</div>
                    <div class="ctr-kpi-sub">@k.Sub</div>
                </div>
            </div>
        }
    </div>

    @* ---- Barra de filtros (patron Tableros/PQRS): fluye a la izquierda, tabla en contenedor propio ---- *@
    <div class="ctr-filtros">
            <div class="ctr-filtros-l">
            <div class="ctr-filtro-wrap">
                <button class="ctr-fbtn @(HayReglasActivas ? "on" : "")" @onclick="ToggleFiltrosC" title="Filtrar contratos">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18M6 12h12M10 19h4" /></svg>
                    <span>Filtros</span>
                    @if (CuentaReglasC > 0) { <span class="ctr-fbadge">@CuentaReglasC</span> }
                </button>
                @if (_filtrosMenuC)
                {
                    <div class="ctr-fpop-bd" @onclick="() => _filtrosMenuC = false"></div>
                    <div class="ctr-fpop" @onclick:stopPropagation="true">
                        @if (_reglasC.Count == 0)
                        {
                            <div class="ctr-fpop-empty">Sin filtros aplicados.<br />Agrega una condicion para acotar los contratos.</div>
                        }
                        else
                        {
                            @for (int i = 0; i < _reglasC.Count; i++)
                            {
                                var idx = i; var r = _reglasC[idx];
                                <div class="ctr-frule">
                                    @if (idx == 0)
                                    {
                                        <span class="ctr-frule-lead">Donde</span>
                                    }
                                    else if (idx == 1)
                                    {
                                        <select class="ctr-frule-lead ctr-frule-logic" @onchange="SetLogicaC">
                                            <option value="and" selected="@(_logicaC == "and")">Y</option>
                                            <option value="or" selected="@(_logicaC == "or")">O</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="ctr-frule-lead">@(_logicaC == "or" ? "O" : "Y")</span>
                                    }
                                    <select class="ctr-frule-f" @onchange="(e) => SetReglaCampoC(idx, e)">
                                        @foreach (var opt in CamposFiltroC()) { <option value="@opt.Key" selected="@(r.Campo == opt.Key)">@opt.Label</option> }
                                    </select>
                                    <select class="ctr-frule-op" @onchange="(e) => SetReglaOpC(idx, e)">
                                        @foreach (var op in OperadoresC(r.Campo)) { <option value="@op.Key" selected="@(r.Op == op.Key)">@op.Label</option> }
                                    </select>
                                    @if (r.Op is not "vacio" and not "no_vacio")
                                    {
                                        @RenderValorC(idx)
                                    }
                                    <button class="ctr-frule-del" title="Quitar condicion" @onclick="() => QuitarReglaC(idx)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12" /></svg>
                                    </button>
                                </div>
                            }
                        }
                        <div class="ctr-fpop-foot">
                            <button class="ctr-fadd" @onclick="AgregarReglaC">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14" /></svg>Agregar filtro
                            </button>
                            @if (_reglasC.Count > 0) { <button class="ctr-fclear2" @onclick="LimpiarReglasC">Limpiar todo</button> }
                        </div>
                    </div>
                }
            </div>
            <div class="ctr-search"><i class="fi fi-rr-search"></i><input placeholder="Buscar proveedor, NIT, tipo..." value="@_cFiltroTexto" @oninput="e => { _cFiltroTexto = e.Value?.ToString() ?? string.Empty; _cPage = 0; }" /></div>
            </div>
            @if (_vistaC != "tarjetas")
            {
                <div class="ctr-filtros-r">
                    <select class="ctr-fsel" @bind="_cAgrupar">
                        <option value="etapa">Agrupar por etapa</option>
                        <option value="">Sin agrupar</option>
                        <option value="tipo">Agrupar por tipo</option>
                        <option value="tercero">Agrupar por tercero</option>
                        <option value="estado">Agrupar por estado</option>
                    </select>
                    <div class="ctr-cols-wrap">
                        <button class="ctr-fbtn @(_showColsMenu ? "on" : "")" @onclick="() => _showColsMenu = !_showColsMenu" title="Elegir y ordenar columnas">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                            <span>Columnas</span>
                        </button>
                        @if (_showColsMenu)
                        {
                            <div class="ctr-fpop-bd" @onclick="() => _showColsMenu = false"></div>
                            <div class="ctr-colspop" @onclick:stopPropagation="true">
                                <div class="ctr-cm-sec">Columnas de la lista</div>
                                @{ var ord = ColsOrdenadas(); }
                                @for (int i = 0; i < ord.Count; i++)
                                {
                                    var cidx = i; var ck = ord[cidx];
                                    <div class="ctr-colrow">
                                        <div class="ctr-et-ord">
                                            <button class="ctr-et-mv" disabled="@(cidx == 0)" @onclick="() => MoverColAsync(cidx, -1)" title="Subir">&#9650;</button>
                                            <button class="ctr-et-mv" disabled="@(cidx == ord.Count - 1)" @onclick="() => MoverColAsync(cidx, 1)" title="Bajar">&#9660;</button>
                                        </div>
                                        <label class="ctr-colchk">
                                            <input type="checkbox" checked="@ColVisible(ck)" disabled="@(ck == "tercero")" @onchange="() => ToggleColVisible(ck)" />
                                            <span>@ColLabel(ck)</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_contratos.Count == 0)
        {
            <div class="srv-empty"><i class="fi fi-rr-shield"></i><div>Aun no hay contratos. Crea el primero con "Nuevo contrato".</div></div>
        }
        else
        {
            var filtrados = ContratosFiltrados().ToList();
            if (_vistaC == "tarjetas")
            {
                <div class="ctr-kanban">
                    @foreach (var et in _etapas)
                    {
                        var etapa = et;
                        var enEtapa = filtrados.Where(c => c.EtapaId == etapa.Id).ToList();
                        <div class="ctr-kcol @(_dragOverEtapa == etapa.Id ? "over" : "")"
                             @ondragover:preventDefault="true" @ondragover="() => _dragOverEtapa = etapa.Id"
                             @ondrop="() => SoltarEnEtapa(etapa.Id)" @ondragleave="() => { if (_dragOverEtapa == etapa.Id) _dragOverEtapa = null; }">
                            <div class="ctr-kcol-h">
                                <span class="ctr-kdot" style="background:@(etapa.Color ?? "#94A3B8")"></span>
                                <span class="ctr-kcol-t">@etapa.Nombre</span>
                                <span class="ctr-kcol-n">@enEtapa.Count</span>
                            </div>
                            <div class="ctr-kcol-body">
                                @foreach (var c in enEtapa)
                                {
                                    var cc = c;
                                    <div class="ctr-kcard" draggable="true" @ondragstart="() => _dragContratoId = cc.Id" @onclick="() => AbrirModal(cc)">
                                        <div class="ctr-kcard-top">
                                            <span class="ctr-kcard-prov">@c.Proveedor</span>
                                            @if (c.Estado == EstadoContrato.Vencido) { <span class="srv-badge vencido">Vencido</span> }
                                            else if (c.AlertaVencimiento) { <span class="srv-badge danger">@c.DiasParaVencer d</span> }
                                            else if (c.Estado == EstadoContrato.EnRenovacion) { <span class="srv-badge warn">Renov.</span> }
                                            else { <span class="srv-badge ok">Vigente</span> }
                                        </div>
                                        <div class="ctr-kcard-meta">@TipoLabel(c.Tipo)@(c.FechaFin is { } ff ? " · vence " + ff.ToString("dd MMM yyyy") : "")</div>
                                        @if (c.ValorMensual is { } v) { <div class="ctr-kcard-val">$@v.ToString("N0") /mes</div> }
                                    </div>
                                }
                                @if (enEtapa.Count == 0) { <div class="ctr-kempty">Sin contratos</div> }
                            </div>
                        </div>
                    }
                </div>
            }
            else if (filtrados.Count == 0)
            {
                <div class="srv-empty"><i class="fi fi-rr-search"></i><div>Ningun contrato coincide con los filtros.</div></div>
            }
            else
            {
                var totalPag = Math.Max(1, (int)Math.Ceiling(filtrados.Count / (double)_cPageSize));
                var pag = Math.Min(Math.Max(0, _cPage), totalPag - 1);
                var pageItems = filtrados.Skip(pag * _cPageSize).Take(_cPageSize).ToList();
                <div class="ctr-count">@filtrados.Count de @_contratos.Count contratos@(totalPag > 1 ? $" · pagina {pag + 1} de {totalPag}" : "")</div>
                <div class="ctr-topscroll" id="ctrTopScroll"><div class="ctr-topscroll-in"></div></div>
                <div class="ctr-table-wrap ctr-scroll" id="ctrTableWrap">
                    <table class="ctr-table">
                        <thead>
                            <tr>
                                @foreach (var k in ColsVisibles()) { <th class="@ColThClass(k)" title="@ColDesc(k)">@ColLabel(k)</th> }
                                <th class="ctr-w2"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grupo in AgruparContratos(pageItems))
                            {
                                @* Fila-agrupador dentro de la misma tabla (estilo Lista de Tareas), con punto de color si agrupa por etapa *@
                                @if (_cAgrupar != "")
                                {
                                    var gcolor = _cAgrupar == "etapa" ? (_etapas.FirstOrDefault(e => e.Nombre == grupo.Key)?.Color ?? "#94A3B8") : null;
                                    <tr class="ctr-grow">
                                        <td colspan="@(ColsVisibles().Count() + 1)">
                                            @if (gcolor is not null) { <span class="ctr-kdot" style="background:@gcolor"></span> }
                                            <span class="ctr-grow-t">@grupo.Key</span> <span class="ctr-group-n">@grupo.Count()</span>
                                        </td>
                                    </tr>
                                }
                                @foreach (var c in grupo)
                                {
                                    var cc = c;
                                    <tr class="ctr-row">
                                        @foreach (var k in ColsVisibles())
                                        {
                                            var col = k;
                                            <td class="@ColTdClass(col)">
                                                @switch (col)
                                                {
                                                    case "tercero":
                                                        <div class="ctr-terc-line">
                                                            @if (CEnEd(c.Id, "prov"))
                                                            {
                                                                <input class="ctr-inp" @bind="_cEditVal" @bind:event="oninput" autofocus
                                                                       @onblur='() => GuardarCEd(cc, "prov")' @onkeydown='(e) => CEdKeydown(e, cc, "prov")' />
                                                            }
                                                            else
                                                            {
                                                                <div class="ctr-terc ctr-ed" @onclick='() => IniciarCEd(cc.Id, "prov", cc.Proveedor)' title="Editar proveedor">@c.Proveedor</div>
                                                            }
                                                            <span class="ctr-eye" @onclick="() => AbrirModal(cc)" title="Ver ficha completa">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                                            </span>
                                                        </div>
                                                        @if (CEnEd(c.Id, "nit"))
                                                        {
                                                            <input class="ctr-inp ctr-inp-sub" @bind="_cEditVal" @bind:event="oninput" autofocus placeholder="NIT"
                                                                   @onblur='() => GuardarCEd(cc, "nit")' @onkeydown='(e) => CEdKeydown(e, cc, "nit")' />
                                                        }
                                                        else
                                                        {
                                                            <div class="ctr-terc-sub ctr-ed" @onclick='() => IniciarCEd(cc.Id, "nit", cc.NitProveedor)' title="Editar NIT">@(string.IsNullOrWhiteSpace(c.NitProveedor) ? "+ NIT" : "NIT " + c.NitProveedor)</div>
                                                        }
                                                        break;
                                                    case "tipo":
                                                        @if (CEnEd(c.Id, "tipo"))
                                                        {
                                                            <select class="ctr-inp" value="@_cEditVal" @onchange='(e) => CSelChange(cc, "tipo", e)' @onblur="CancelarCEd">
                                                                @foreach (var t in Enum.GetValues<TipoServicio>()) { <option value="@((int)t)">@TipoLabel(t)</option> }
                                                            </select>
                                                        }
                                                        else { <span class="ctr-ed" @onclick='() => IniciarCEd(cc.Id, "tipo", ((int)cc.Tipo).ToString())'>@TipoLabel(c.Tipo)</span> }
                                                        break;
                                                    case "inicio":
                                                        @if (CEnEd(c.Id, "inicio"))
                                                        {
                                                            <input type="date" class="ctr-inp" value="@_cEditVal" @oninput='(e) => _cEditVal = e.Value?.ToString() ?? ""' autofocus
                                                                   @onblur='() => GuardarCEd(cc, "inicio")' @onkeydown='(e) => CEdKeydown(e, cc, "inicio")' />
                                                        }
                                                        else { <span class="ctr-ed" @onclick='() => IniciarCEd(cc.Id, "inicio", cc.FechaInicio.ToString("yyyy-MM-dd"))'>@c.FechaInicio.ToString("dd MMM yyyy")</span> }
                                                        break;
                                                    case "fin":
                                                        @if (CEnEd(c.Id, "fin"))
                                                        {
                                                            <input type="date" class="ctr-inp" value="@_cEditVal" @oninput='(e) => _cEditVal = e.Value?.ToString() ?? ""' autofocus
                                                                   @onblur='() => GuardarCEd(cc, "fin")' @onkeydown='(e) => CEdKeydown(e, cc, "fin")' />
                                                        }
                                                        else { <span class="ctr-ed" @onclick='() => IniciarCEd(cc.Id, "fin", cc.FechaFin?.ToString("yyyy-MM-dd"))'>@(c.FechaFin is { } ff ? ff.ToString("dd MMM yyyy") : "+ fecha")</span> }
                                                        break;
                                                    case "valor":
                                                        @if (CEnEd(c.Id, "valor"))
                                                        {
                                                            <input type="number" step="1000" class="ctr-inp ctr-inp-r" @bind="_cEditVal" @bind:event="oninput" autofocus
                                                                   @onblur='() => GuardarCEd(cc, "valor")' @onkeydown='(e) => CEdKeydown(e, cc, "valor")' />
                                                        }
                                                        else { <span class="ctr-ed" @onclick='() => IniciarCEd(cc.Id, "valor", cc.ValorMensual?.ToString("0", System.Globalization.CultureInfo.InvariantCulture))'>@(c.ValorMensual is { } v ? "$" + v.ToString("N0") : "+ valor")</span> }
                                                        break;
                                                    case "estado":
                                                        @if (CEnEd(c.Id, "estado"))
                                                        {
                                                            <select class="ctr-inp" value="@_cEditVal" @onchange='(e) => CSelChange(cc, "estado", e)' @onblur="CancelarCEd">
                                                                <option value="@((int)EstadoContrato.Vigente)">Vigente</option>
                                                                <option value="@((int)EstadoContrato.EnRenovacion)">En renovacion</option>
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <span class="ctr-ed" @onclick='() => IniciarCEd(cc.Id, "estado", ((int)(cc.Estado == EstadoContrato.Vencido ? EstadoContrato.Vigente : cc.Estado)).ToString())' title="Cambiar estado">
                                                                @if (c.Estado == EstadoContrato.Vencido) { <span class="srv-badge vencido">Vencido</span> }
                                                                else if (c.AlertaVencimiento) { <span class="srv-badge danger">Vence en @c.DiasParaVencer dias</span> }
                                                                else if (c.Estado == EstadoContrato.EnRenovacion) { <span class="srv-badge warn">En renovacion</span> }
                                                                else { <span class="srv-badge ok">Vigente</span> }
                                                            </span>
                                                        }
                                                        break;
                                                    case "etapa":
                                                        <select class="ctr-etsel" style="background:@(_etapas.FirstOrDefault(x => x.Id == c.EtapaId)?.Color ?? "#94A3B8")" @onchange="(e) => CEtapaSelChange(cc, e)">
                                                            @if (c.EtapaId is null) { <option value="" selected>-</option> }
                                                            @foreach (var et in _etapas) { <option value="@et.Id" selected="@(et.Id == c.EtapaId)">@et.Nombre</option> }
                                                        </select>
                                                        break;
                                                    case "contacto":
                                                        @if (CEnEd(c.Id, "contacto"))
                                                        {
                                                            <input class="ctr-inp" @bind="_cEditVal" @bind:event="oninput" autofocus @onblur='() => GuardarCEd(cc, "contacto")' @onkeydown='(e) => CEdKeydown(e, cc, "contacto")' />
                                                        }
                                                        else { <span class="ctr-ed ctr-cval" @onclick='() => IniciarCEd(cc.Id, "contacto", cc.Contacto)'>@(string.IsNullOrWhiteSpace(c.Contacto) ? "-" : c.Contacto)</span> }
                                                        break;
                                                    case "renov":
                                                        <span class="ctr-cval">@(c.RenovacionAutomatica ? "Si" : "No")</span>
                                                        break;
                                                    case "dias":
                                                        @if (CEnEd(c.Id, "dias"))
                                                        {
                                                            <input type="number" class="ctr-inp ctr-inp-r" @bind="_cEditVal" @bind:event="oninput" autofocus @onblur='() => GuardarCEd(cc, "dias")' @onkeydown='(e) => CEdKeydown(e, cc, "dias")' />
                                                        }
                                                        else { <span class="ctr-ed" @onclick='() => IniciarCEd(cc.Id, "dias", cc.DiasAnticipacionAlerta.ToString())'>@c.DiasAnticipacionAlerta</span> }
                                                        break;
                                                    case "obs":
                                                        <span class="ctr-obs" title="@c.Observaciones">@(string.IsNullOrWhiteSpace(c.Observaciones) ? "-" : c.Observaciones)</span>
                                                        break;
                                                    case "numero":
                                                        <span class="ctr-cval">@(string.IsNullOrWhiteSpace(c.NumeroContrato) ? "-" : c.NumeroContrato)</span>
                                                        break;
                                                    case "tipoContrato":
                                                        <span class="ctr-cval">@(c.TipoContrato is { } tc ? TipoContratoLabel(tc) : "-")</span>
                                                        break;
                                                    case "categoria":
                                                        <span class="ctr-cval">@(c.Categoria is { } ca ? CategoriaContratoLabel(ca) : "-")</span>
                                                        break;
                                                    case "asociado":
                                                        <span class="ctr-cval">@(string.IsNullOrWhiteSpace(c.AsociadoNombre) ? "-" : c.AsociadoNombre)</span>
                                                        break;
                                                    case "valorTotal":
                                                        <span class="ctr-cval">@(c.ValorTotal is { } vt ? "$" + vt.ToString("N0") : "-")</span>
                                                        break;
                                                    case "formaPago":
                                                        <span class="ctr-cval">@(c.FormaPagoCuotas is { } fp ? fp + " cuotas" : "-")</span>
                                                        break;
                                                    case "pagoMensual":
                                                        <span class="ctr-cval">@(c.PagoMensual ? "Si" : "No")</span>
                                                        break;
                                                    default:
                                                        @if (_cCampos.FirstOrDefault(x => x.Id.ToString() == col) is { } cpo)
                                                        {
                                                            if (CEnEd(c.Id, "campo:" + cpo.Id))
                                                            {
                                                                switch (cpo.Tipo)
                                                                {
                                                                    case TipoCampoTablero.Seleccion:
                                                                        <select class="ctr-inp" value="@_cEditVal" @onchange='(e) => CCampoSelChange(cc, cpo, e)' @onblur="CancelarCEd">
                                                                            <option value="">-</option>
                                                                            @foreach (var op in OpcionesDe(cpo)) { <option value="@op">@op</option> }
                                                                        </select>
                                                                        break;
                                                                    case TipoCampoTablero.Booleano:
                                                                        <select class="ctr-inp" value="@_cEditVal" @onchange='(e) => CCampoSelChange(cc, cpo, e)' @onblur="CancelarCEd">
                                                                            <option value="">-</option>
                                                                            <option value="Si">Si</option>
                                                                            <option value="No">No</option>
                                                                        </select>
                                                                        break;
                                                                    case TipoCampoTablero.Fecha:
                                                                        <input type="date" class="ctr-inp" value="@_cEditVal" @oninput='(e) => _cEditVal = e.Value?.ToString() ?? ""' autofocus
                                                                               @onblur='() => GuardarCVal(cc, cpo)' @onkeydown='(e) => CValKeydown(e, cc, cpo)' />
                                                                        break;
                                                                    case TipoCampoTablero.Numero:
                                                                    case TipoCampoTablero.Moneda:
                                                                        <input type="number" class="ctr-inp" @bind="_cEditVal" @bind:event="oninput" autofocus
                                                                               @onblur='() => GuardarCVal(cc, cpo)' @onkeydown='(e) => CValKeydown(e, cc, cpo)' />
                                                                        break;
                                                                    default:
                                                                        <input class="ctr-inp" @bind="_cEditVal" @bind:event="oninput" autofocus
                                                                               @onblur='() => GuardarCVal(cc, cpo)' @onkeydown='(e) => CValKeydown(e, cc, cpo)' />
                                                                        break;
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="ctr-ed ctr-cval" @onclick='() => IniciarCEd(cc.Id, "campo:" + cpo.Id, ValorCampo(cc, cpo.Id))' title="@cpo.Label">@(ValorCampo(c, cpo.Id) is { Length: > 0 } vv ? vv : "-")</span>
                                                            }
                                                        }
                                                        break;
                                                }
                                            </td>
                                        }
                                        <td class="ctr-w2">
                                            <span class="srv-del" @onclick="() => EliminarAsync(cc.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (totalPag > 1)
                {
                    <div class="ctr-pager">
                        <button disabled="@(pag == 0)" @onclick="() => _cPage = Math.Max(0, pag - 1)">&#8249; Anterior</button>
                        <span class="ctr-pager-info">Pagina @(pag + 1) de @totalPag</span>
                        <button disabled="@(pag >= totalPag - 1)" @onclick="() => _cPage = pag + 1">Siguiente &#8250;</button>
                    </div>
                }
            }
        }

    @* ---- Modal: Configurar (estados + campos en un solo modal, estilo "Configurar tablero" de Tareas) ---- *@
    @if (_showConfigModal)
    {
        <div class="ctr-cm-back" @onclick="() => _showConfigModal = false">
            <div class="ctr-cm" @onclick:stopPropagation="true">
                <div class="ctr-cm-head">
                    <div>
                        <div class="ctr-cm-title">Configurar contratos</div>
                        <div class="ctr-cm-sub">Estados del flujo y campos personalizados.</div>
                    </div>
                    <button class="ctr-cm-x" @onclick="() => _showConfigModal = false" title="Cerrar"><i class="fi fi-rr-cross-small"></i></button>
                </div>
                <div class="ctr-cm-body">
                    <div class="ctr-cm-sec">Estados (columnas)</div>
                    <div class="ctr-cm-list">
                        @for (int i = 0; i < _etapas.Count; i++)
                        {
                            var eidx = i; var et = _etapas[eidx];
                            <div class="ctr-et-row">
                                <div class="ctr-et-ord">
                                    <button class="ctr-et-mv" disabled="@(eidx == 0)" @onclick="() => MoverEtapaAsync(eidx, -1)" title="Subir">&#9650;</button>
                                    <button class="ctr-et-mv" disabled="@(eidx == _etapas.Count - 1)" @onclick="() => MoverEtapaAsync(eidx, 1)" title="Bajar">&#9660;</button>
                                </div>
                                <input type="color" class="ctr-et-color" value="@(et.Color ?? "#94A3B8")" @onchange="(e) => CambiarColorEtapaAsync(et, e)" title="Color" />
                                <input class="ctr-et-nom" value="@et.Nombre" @onchange="(e) => RenombrarEtapaAsync(et, e)" />
                                <span class="ctr-cm-count">@(_contratos.Count(x => x.EtapaId == et.Id)) contratos</span>
                                <button class="ctr-cm-del" @onclick="() => EliminarEtapaAsync(et.Id)" title="Eliminar estado" disabled="@(_etapas.Count <= 1)"><i class="fi fi-rr-trash"></i></button>
                            </div>
                        }
                    </div>
                    <div class="ctr-cm-newgrid">
                        <input class="srv-input" placeholder="Nuevo estado (ej. En revision)" @bind="_nuevaEtapaNombre" @bind:event="oninput" @onkeydown='(e) => { if (e.Key == "Enter") return CrearEtapaAsync(); return Task.CompletedTask; }' />
                        <button class="srv-btn-primary sm" @onclick="CrearEtapaAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaEtapaNombre))">Agregar</button>
                    </div>

                    <div class="ctr-cm-sec">Campos personalizados</div>
                    <div class="ctr-cm-help">Define campos tipados que apareceran como columnas de la lista, en los filtros y en las tarjetas.</div>
                    @if (_cCampos.Count == 0)
                    {
                        <div class="ctr-cm-empty">Aun no hay campos. Crea el primero abajo (ej. "Numero de poliza", "Responsable", "Renovado el").</div>
                    }
                    else
                    {
                        <div class="ctr-cm-list">
                            @{ var ordenados = _cCampos.OrderBy(c => c.Orden).ToList(); }
                            @for (int i = 0; i < ordenados.Count; i++)
                            {
                                var idx = i; var cm = ordenados[idx];
                                <div class="ctr-cm-row @(cm.Activo ? "" : "off")">
                                    <div class="ctr-et-ord">
                                        <button class="ctr-et-mv" disabled="@(idx == 0)" @onclick="() => MoverCampoAsync(ordenados, idx, -1)" title="Subir">&#9650;</button>
                                        <button class="ctr-et-mv" disabled="@(idx == ordenados.Count - 1)" @onclick="() => MoverCampoAsync(ordenados, idx, 1)" title="Bajar">&#9660;</button>
                                    </div>
                                    <input class="ctr-et-nom" value="@cm.Label" @onchange="(e) => RenombrarCampoAsync(cm, e)" />
                                    <span class="ctr-cm-tipo">@TipoCampoLabel(cm.Tipo)</span>
                                    <label class="ctr-cm-sw" title="Mostrar como columna">
                                        <input type="checkbox" checked="@cm.Activo" @onchange="() => ToggleCampoActivoAsync(cm)" />
                                        <span>@(cm.Activo ? "Visible" : "Oculto")</span>
                                    </label>
                                    <button class="ctr-cm-del" @onclick="() => EliminarCampoAsync(cm.Id)" title="Eliminar campo"><i class="fi fi-rr-trash"></i></button>
                                </div>
                            }
                        </div>
                    }
                    <div class="ctr-cm-new">
                        <div class="ctr-cm-new-t">Nuevo campo</div>
                        <div class="ctr-cm-new-grid">
                            <input class="srv-input" placeholder="Nombre del campo" @bind="_nuevoCampoLabel" @bind:event="oninput" @onkeydown='(e) => { if (e.Key == "Enter") return CrearCampoAsync(); return Task.CompletedTask; }' />
                            <select class="srv-input" @bind="_nuevoCampoTipo">
                                @foreach (var t in new[] { TipoCampoTablero.Texto, TipoCampoTablero.Numero, TipoCampoTablero.Moneda, TipoCampoTablero.Fecha, TipoCampoTablero.Seleccion, TipoCampoTablero.Booleano, TipoCampoTablero.Telefono, TipoCampoTablero.Url, TipoCampoTablero.Email })
                                {
                                    <option value="@t">@TipoCampoLabel(t)</option>
                                }
                            </select>
                        </div>
                        @if (_nuevoCampoTipo == TipoCampoTablero.Seleccion)
                        {
                            <textarea class="srv-input" rows="3" placeholder="Una opcion por linea" @bind="_nuevoCampoOpciones" @bind:event="oninput"></textarea>
                        }
                        <button class="srv-btn-primary sm" @onclick="CrearCampoAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoCampoLabel))"><i class="fi fi-rr-plus"></i> Agregar campo</button>
                    </div>
                </div>
            </div>
        </div>
    }

    }
    else
    {
        <div class="sp-kpis">
            <div class="sp-kpi"><div class="sp-kpi-l">Cuentas activas</div><div class="sp-kpi-v">@(_spResumen?.CuentasActivas ?? 0)</div></div>
            <div class="sp-kpi"><div class="sp-kpi-l">Gasto ultimo mes</div><div class="sp-kpi-v">$@((_spResumen?.GastoUltimoMes ?? 0).ToString("N0"))</div></div>
            <div class="sp-kpi @(_spResumen?.CuentasConAlerta > 0 ? "danger" : "")"><div class="sp-kpi-l @(_spResumen?.CuentasConAlerta > 0 ? "danger" : "")">Cuentas con alerta</div><div class="sp-kpi-v @(_spResumen?.CuentasConAlerta > 0 ? "danger" : "")">@(_spResumen?.CuentasConAlerta ?? 0)</div></div>
            <div class="sp-kpi"><div class="sp-kpi-l">Reclamaciones abiertas</div><div class="sp-kpi-v">@(_spResumen?.ReclamacionesAbiertas ?? 0)</div></div>
        </div>

        <div class="sp-grid">
            @* ---- Columna cuentas ---- *@
            <div class="sp-cuentas">
                <div class="sp-cuentas-h">CUENTAS DE SERVICIO</div>
                <div class="sp-cuentas-list">
                    @foreach (var c in _spCuentas)
                    {
                        var cid = c.Id;
                        <button class="sp-cuenta @(_spSel == c.Id ? "on" : "")" @onclick="() => SeleccionarCuentaAsync(cid)">
                            <div class="sp-cuenta-ic">@SpIcon(c.Tipo)</div>
                            <div class="sp-cuenta-b"><div class="sp-cuenta-a">@c.Alias</div><div class="sp-cuenta-p">@c.Prestador</div></div>
                            @if (c.TieneAlerta) { <span class="sp-dot"></span> }
                        </button>
                    }
                    <button class="sp-nueva" @onclick="AbrirNuevaCuenta"><i class="fi fi-rr-plus"></i> Nueva cuenta</button>
                </div>
            </div>

            @* ---- Detalle ---- *@
            <div class="sp-detalle">
                @if (_spDetalle is null)
                {
                    <div class="sp-empty">@(_spCuentas.Count == 0 ? "Aun no hay cuentas de servicio. Crea la primera con \"Nueva cuenta\"." : "Selecciona una cuenta para ver su consumo.")</div>
                }
                else
                {
                    var d = _spDetalle;
                    var barras = d.Registros.OrderBy(r => r.Anio * 100 + r.Mes).TakeLast(6).ToList();
                    var maxc = barras.Count > 0 ? barras.Max(b => b.Consumo) : 0;
                    <div class="sp-card">
                        <div class="sp-det-head">
                            <div class="sp-det-id">
                                <div class="sp-det-t">@d.Cuenta.Alias @if (d.Cuenta.TieneAlerta && d.Cuenta.VariacionPct is { } vp) { <span class="sp-desv">Desviacion +@vp.ToString("0.#")%</span> }</div>
                                <div class="sp-det-s">@d.Cuenta.Prestador @(string.IsNullOrEmpty(d.Cuenta.NumeroCuenta) ? "" : " - cuenta " + d.Cuenta.NumeroCuenta)@(string.IsNullOrEmpty(d.Cuenta.MetodoPago) ? "" : " - " + d.Cuenta.MetodoPago)</div>
                            </div>
                            <button class="srv-btn-primary" @onclick="AbrirCargarRecibo"><i class="fi fi-rr-upload"></i> Cargar recibo</button>
                        </div>
                        <div class="sp-chart">
                            @if (barras.Count == 0)
                            {
                                <div class="sp-empty sp-empty-sm">Sin registros de consumo aun.</div>
                            }
                            else
                            {
                                <div class="sp-bars">
                                    @foreach (var b in barras)
                                    {
                                        var h = maxc > 0 ? (int)Math.Round((double)(b.Consumo / maxc) * 100) : 0;
                                        <div class="sp-bar-col">
                                            <div class="sp-bar @(b.Alerta ? "alerta" : "")" style="height:@(Math.Max(h, 4))%" title="@b.Consumo"></div>
                                            <span class="sp-bar-lbl">@b.PeriodoLabel</span>
                                        </div>
                                    }
                                </div>
                                <div class="sp-prom">Promedio historico: <b>@(d.PromedioConsumo?.ToString("N1") ?? "-") @d.Cuenta.UnidadMedida</b> &middot; umbral de alerta @d.Cuenta.UmbralAlertaPct%</div>
                            }
                        </div>
                    </div>

                    <div class="sp-card">
                        <div class="sp-thead"><div class="sp-c-per">PERIODO</div><div class="sp-c-con">CONSUMO</div><div class="sp-c-val">VALOR</div><div class="sp-c-var">VAR.</div><div class="sp-c-est">ESTADO</div></div>
                        @if (d.Registros.Count == 0)
                        {
                            <div class="sp-empty sp-empty-sm">Sin registros.</div>
                        }
                        else
                        {
                            @foreach (var r in d.Registros)
                            {
                                <div class="sp-row">
                                    <div class="sp-c-per">@r.PeriodoLabel</div>
                                    <div class="sp-c-con">@r.Consumo.ToString("N0") @d.Cuenta.UnidadMedida</div>
                                    <div class="sp-c-val">$@r.Valor.ToString("N0")</div>
                                    <div class="sp-c-var">@if (r.VariacionPct is { } v) { <span class="@(r.Alerta ? "sp-var-up" : v < 0 ? "sp-var-down" : "sp-var-mid")">@(v > 0 ? "+" : "")@v.ToString("0.#")%</span> } else { <span class="sp-var-na">-</span> }</div>
                                    <div class="sp-c-est">@if (r.Estado == EstadoRegistroConsumo.Estimado) { <span class="srv-badge warn">Estimado</span> } else { <span class="srv-badge ok">Confirmado</span> }</div>
                                </div>
                            }
                        }
                        <div class="sp-recl-bar">
                            <button class="sp-recl-btn" @onclick="AbrirNuevaReclamacion"><i class="fi fi-rr-comment-alt"></i> Reclamaciones (@d.Reclamaciones.Count)</button>
                        </div>
                    </div>

                    @if (d.Reclamaciones.Count > 0)
                    {
                        <div class="sp-card">
                            <div class="sp-recl-h">RECLAMACIONES ANTE EL PRESTADOR</div>
                            <div class="sp-recl-list">
                                @foreach (var rc in d.Reclamaciones)
                                {
                                    <div class="sp-recl-item">
                                        <div class="sp-recl-top"><span class="sp-recl-motivo">@rc.Motivo</span><span class="srv-badge warn">@rc.Estado</span></div>
                                        <div class="sp-recl-meta">@(string.IsNullOrEmpty(rc.Radicado) ? "" : "Radicado " + rc.Radicado + " - ")@rc.Fecha.ToString("dd MMM yyyy")</div>
                                        @if (!string.IsNullOrEmpty(rc.Descripcion)) { <div class="sp-recl-desc">@rc.Descripcion</div> }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@* ===== Modal crear / detalle de contrato ===== *@
@if (_showModal)
{
    <div class="srv-ov" @onclick="() => _showModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-shield"></i></div>
            <div style="flex:1;min-width:0;">
                <div class="srv-modal-title">@(_editId is null ? "Nuevo contrato" : "Detalle del contrato")</div>
                <div class="srv-sub" style="margin:2px 0 0;">Datos del contrato y su vigencia.</div>
            </div>
            <button class="srv-x" @onclick="() => _showModal = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            @if (_editId is not null)
            {
                <div class="srv-modal-tabs">
                    <button class="@(_modalTab == "detalle" ? "on" : "")" @onclick='() => _modalTab = "detalle"'><i class="fi fi-rr-document"></i> Contrato</button>
                    <button class="@(_modalTab == "archivos" ? "on" : "")" @onclick='() => _modalTab = "archivos"'><i class="fi fi-rr-folder"></i> Documentos <span class="srv-tab-n">@(_contratoExpedientes.Count + _contratoAdjuntos.Count)</span></button>
                    <button class="@(_modalTab == "historial" ? "on" : "")" @onclick='AbrirHistorialTab'><i class="fi fi-rr-time-past"></i> Historial</button>
                </div>
            }
            @if (_editId is null || _modalTab == "detalle")
            {
            <div class="srv-grid">
                <div class="srv-col-full">
                    <label class="srv-lbl">Contratista * <span style="font-weight:400;color:#8fa0b3;">(busca en el Directorio o crea uno nuevo)</span></label>
                    <SelectorPersona Jwt="@_jwt" Seleccionada="_contratistaSel" SeleccionadaChanged="OnContratistaSel"
                                     PermiteEmpresa="true" Placeholder="Buscar persona o empresa por nombre/documento..." />
                    <input class="srv-input" style="margin-top:6px;" @bind="_f.Proveedor" @bind:event="oninput" placeholder="Nombre del contratista (se completa al elegirlo)" />
                </div>
                <div>
                    <label class="srv-lbl">Tipo de contrato</label>
                    <select class="srv-input" @bind="_f.TipoContrato">
                        <option value="">- Sin especificar -</option>
                        @foreach (var t in Enum.GetValues<TipoContrato>()) { <option value="@t">@TipoContratoLabel(t)</option> }
                    </select>
                </div>
                <div>
                    <label class="srv-lbl">Numero de contrato</label>
                    <input class="srv-input" @bind="_f.NumeroContrato" @bind:event="oninput" placeholder="Consecutivo (opcional)" />
                </div>
                <div>
                    <label class="srv-lbl">Categoria</label>
                    <select class="srv-input" @bind="_f.Categoria">
                        <option value="">- Sin especificar -</option>
                        @foreach (var c in Enum.GetValues<CategoriaContrato>()) { <option value="@c">@CategoriaContratoLabel(c)</option> }
                    </select>
                </div>
                <div>
                    <label class="srv-lbl">Identificacion / NIT</label>
                    <input class="srv-input" @bind="_f.Nit" @bind:event="oninput" placeholder="NIT o documento del contratista" />
                </div>
                <div>
                    <label class="srv-lbl">Contacto</label>
                    <input class="srv-input" @bind="_f.Contacto" @bind:event="oninput" placeholder="Telefono / email" />
                </div>
                <div>
                    <label class="srv-lbl">Valor del contrato (COP)</label>
                    <input class="srv-input" type="number" step="any" @bind="_f.ValorTotal" placeholder="0" />
                </div>
                <div>
                    <label class="srv-lbl">Valor mensual (COP)</label>
                    <input class="srv-input" type="number" step="any" @bind="_f.Valor" placeholder="0" />
                </div>
                <div>
                    <label class="srv-lbl">Forma de pago (cuotas)</label>
                    <input class="srv-input" type="number" min="1" @bind="_f.FormaPagoCuotas" placeholder="Cantidad de cuotas" />
                </div>
                <div>
                    <label class="srv-lbl">Pago mensual</label>
                    <label class="srv-check" style="margin-top:6px;"><input type="checkbox" @bind="_f.PagoMensual" /> Se paga mensualmente</label>
                </div>
                <div>
                    <label class="srv-lbl">Asociado a</label>
                    <select class="srv-input" @onchange="OnAsociadoTipoChange">
                        <option value="" selected="@(_f.AsociadoTipo is null)">- Nada -</option>
                        <option value="Equipo" selected="@(_f.AsociadoTipo == TipoActivoMantenimiento.Equipo)">Equipo</option>
                        <option value="ZonaComun" selected="@(_f.AsociadoTipo == TipoActivoMantenimiento.ZonaComun)">Zona comun</option>
                    </select>
                </div>
                @if (_f.AsociadoTipo == TipoActivoMantenimiento.Equipo)
                {
                    <div>
                        <label class="srv-lbl">Equipo</label>
                        <select class="srv-input" @bind="_f.AsociadoId">
                            <option value="">- Selecciona equipo -</option>
                            @foreach (var e in _equiposAsoc) { <option value="@e.Id">@e.Nombre</option> }
                        </select>
                    </div>
                }
                else if (_f.AsociadoTipo == TipoActivoMantenimiento.ZonaComun)
                {
                    <div>
                        <label class="srv-lbl">Zona comun</label>
                        <select class="srv-input" @bind="_f.AsociadoId">
                            <option value="">- Selecciona zona -</option>
                            @foreach (var z in _zonasAsoc) { <option value="@z.Id">@z.Nombre</option> }
                        </select>
                    </div>
                }
                <div>
                    <label class="srv-lbl">Fecha de inicio</label>
                    <input class="srv-input" type="date" @bind="_f.Inicio" />
                </div>
                <div>
                    <label class="srv-lbl">Fecha de finalizacion</label>
                    <input class="srv-input" type="date" @bind="_f.Fin" />
                </div>
                <div>
                    <label class="srv-lbl">Dias de alerta antes de vencer</label>
                    <input class="srv-input" type="number" @bind="_f.Dias" />
                </div>
                @if (_editId is not null)
                {
                    <div>
                        <label class="srv-lbl">Estado</label>
                        <select class="srv-input" @bind="_f.Estado">
                            <option value="@EstadoContrato.Vigente">Vigente</option>
                            <option value="@EstadoContrato.EnRenovacion">En renovacion</option>
                        </select>
                    </div>
                }
                <div>
                    <label class="srv-lbl">Servicio (al que pertenece)</label>
                    <select class="srv-input" @bind="_f.ServicioId">
                        <option value="">- Sin servicio -</option>
                        @foreach (var s in _servicios) { <option value="@s.Id">@s.Nombre</option> }
                    </select>
                </div>
                <div>
                    <label class="srv-lbl">Expediente (modulo 2.15)</label>
                    <select class="srv-input" @bind="_f.ExpedienteId">
                        <option value="">- Sin expediente -</option>
                        @foreach (var e in _expedientes) { <option value="@e.Id">@e.Codigo - @e.Nombre</option> }
                    </select>
                </div>
                <div>
                    <label class="srv-lbl">Proyecto (modulo 2.10)</label>
                    <select class="srv-input" @bind="_f.ProyectoId">
                        <option value="">- Sin proyecto -</option>
                        @foreach (var p in _proyectos) { <option value="@p.Id">@p.Titulo</option> }
                    </select>
                </div>
                <div class="srv-col-full">
                    <label class="srv-check"><input type="checkbox" @bind="_f.RenovacionAutomatica" /> Tiene clausula de renovacion automatica</label>
                </div>
                <div class="srv-col-full">
                    <label class="srv-lbl">Observaciones</label>
                    <textarea class="srv-input" rows="2" @bind="_f.Observaciones" @bind:event="oninput" placeholder="Ej. Renovacion automatica con 30 dias de aviso."></textarea>
                </div>
            </div>
            }

            @if (_editId is not null && _modalTab == "archivos")
            {
                @* Expedientes conectados (modulo 2.15). Se conectan uno o varios expedientes ya existentes. *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-folder"></i> Expedientes conectados (@_contratoExpedientes.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var ex in _contratoExpedientes)
                        {
                            var exx = ex;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-folder"></i>
                                <a href="/documentos" class="srv-attach-name" title="Abrir en Documentos">@ex.Codigo - @ex.Nombre</a>
                                <span class="srv-del" @onclick="() => DesconectarExpedienteAsync(exx.ExpedienteId)" title="Desconectar"><i class="fi fi-rr-cross-small"></i></span>
                            </div>
                        }
                        @if (_contratoExpedientes.Count == 0) { <div class="srv-prog-tx" style="padding:4px 2px;">Sin expedientes conectados.</div> }
                        <div class="srv-prog-row" style="margin-top:8px;">
                            <select class="srv-input" style="flex:1;min-width:0;" @bind="_expedienteAConectar">
                                <option value="">- Selecciona un expediente para conectar -</option>
                                @foreach (var e in _expedientes.Where(e => !_contratoExpedientes.Any(x => x.ExpedienteId == e.Id)))
                                {
                                    <option value="@e.Id">@e.Codigo - @e.Nombre</option>
                                }
                            </select>
                            <button class="srv-btn-ghost" @onclick="ConectarExpedienteAsync" disabled="@(string.IsNullOrEmpty(_expedienteAConectar) || _busy)"><i class="fi fi-rr-link"></i> Conectar</button>
                        </div>
                    </div>
                </div>

                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-clip"></i> Archivos del contrato (@_contratoAdjuntos.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var a in _contratoAdjuntos)
                        {
                            var aa = a;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-document"></i>
                                <a href="@a.Url" target="_blank" class="srv-attach-name">@a.NombreArchivo</a>
                                <span class="srv-attach-size">@FmtBytes(a.TamanoBytes)</span>
                                <span class="srv-del" @onclick="() => EliminarAdjuntoContratoAsync(aa.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span>
                            </div>
                        }
                        <label class="srv-attach-up">
                            <i class="fi fi-rr-upload"></i><span>@(_attachBusy ? "Subiendo..." : "Adjuntar (PDF, imagen, Word, Excel)")</span>
                            <InputFile OnChange="(e) => SubirAdjuntoContratoAsync(e)" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx" disabled="@_attachBusy" />
                        </label>
                    </div>
                </div>

                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-calendar-clock"></i> Programacion de vencimiento</div>
                    <div class="srv-prog-row">
                        <span class="srv-prog-tx">Crea una tarea (unica o recurrente) en un tablero para no olvidar la renovacion.</span>
                        <button class="srv-btn-ghost" @onclick="AbrirProgramadorContrato"><i class="fi fi-rr-calendar-plus"></i> Programar tarea</button>
                    </div>
                </div>
            }

            @if (_editId is not null && _modalTab == "historial")
            {
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-time-past"></i> Historial del contrato</div>
                    @if (_contratoBitacora.Count == 0)
                    {
                        <div class="srv-prog-tx" style="padding:4px 2px;">Sin eventos registrados todavia.</div>
                    }
                    else
                    {
                        <div class="srv-hist-list">
                            @foreach (var b in _contratoBitacora)
                            {
                                <div class="srv-hist-item">
                                    <span class="srv-hist-dot"></span>
                                    <div class="srv-hist-body">
                                        <div class="srv-hist-tx">@b.Descripcion</div>
                                        <div class="srv-hist-meta">@b.Fecha.ToLocalTime().ToString("dd MMM yyyy · HH:mm")@(string.IsNullOrWhiteSpace(b.Autor) ? "" : $" · {b.Autor}")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (_modalError is not null) { <div class="srv-banner err">@_modalError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="() => _showModal = false">Cancelar</button>
                <button class="srv-btn-primary" @onclick="GuardarAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_f.Proveedor))"><i class="fi fi-rr-check"></i> @(_editId is null ? "Crear contrato" : "Guardar contrato")</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: crear / editar servicio ===== *@
@if (_showSrvModal)
{
    <div class="srv-ov" @onclick="CerrarServicioModal"></div>
    <div class="srv-modal srv-modal-lg">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-briefcase"></i></div>
            <div style="flex:1;min-width:0;">
                <div class="srv-modal-title">@(_srvEditId is null ? "Nuevo servicio" : "Detalle del servicio")</div>
                <div class="srv-sub" style="margin:2px 0 0;">Servicio contratado, su ejecutor, contactos y contratos.</div>
            </div>
            <button class="srv-x" @onclick="CerrarServicioModal"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="srv-grid">
                <div class="srv-col-full"><label class="srv-lbl">Nombre del servicio *</label><input class="srv-input" @bind="_sf.Nombre" @bind:event="oninput" placeholder="Ej. Vigilancia y seguridad" /></div>
                <div><label class="srv-lbl">Tipo de servicio</label><select class="srv-input" @bind="_sf.Tipo">@foreach (var t in Enum.GetValues<TipoServicio>()) { <option value="@t">@TipoLabel(t)</option> }</select></div>
                <div><label class="srv-lbl">Estado</label><select class="srv-input" @bind="_sf.Estado"><option value="@EstadoServicio.Activo">Activo</option><option value="@EstadoServicio.Suspendido">Suspendido</option><option value="@EstadoServicio.Inactivo">Inactivo</option></select></div>
                <div><label class="srv-lbl">Costo mensual (COP)</label><input class="srv-input" type="number" step="any" @bind="_sf.CostoMensual" placeholder="0" /></div>
                <div><label class="srv-lbl">Costo anual (COP)</label><input class="srv-input" type="number" step="any" @bind="_sf.CostoAnual" placeholder="0" /></div>
                <div class="srv-col-full"><label class="srv-lbl">Descripcion</label><textarea class="srv-input" rows="2" @bind="_sf.Descripcion" @bind:event="oninput"></textarea></div>

                <div class="srv-col-full">
                    <label class="srv-lbl">Quien ejecuta el servicio (tercero del Directorio)</label>
                    @if (!string.IsNullOrEmpty(_sf.EjecutorNombre))
                    {
                        <div class="svc-pick-sel"><i class="fi fi-rr-user"></i> <span>@_sf.EjecutorNombre</span> <button class="svc-pick-clear" @onclick="LimpiarEjecutor">Cambiar</button></div>
                    }
                    else
                    {
                        <button class="srv-btn-ghost" @onclick='() => AbrirPicker("ejecutor")'><i class="fi fi-rr-search"></i> Seleccionar ejecutor</button>
                        @if (_tTarget == "ejecutor") { @PickerPanel() }
                    }
                </div>
            </div>

            @if (_srvEditId is not null && _srvDetalle is not null)
            {
                @* ---- Contactos ---- *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-users"></i> Contactos relacionados (@_srvDetalle.Contactos.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var c in _srvDetalle.Contactos)
                        {
                            var cc = c;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-user"></i>
                                <span class="srv-attach-name">@c.NombreSnapshot @(string.IsNullOrEmpty(c.Rol) ? "" : "- " + c.Rol)</span>
                                <span class="srv-attach-size">@(string.Join(" ", new[] { c.Telefono, c.Email }.Where(x => !string.IsNullOrEmpty(x))))</span>
                                <span class="srv-del" @onclick="() => EliminarContactoAsync(cc.Id)" title="Quitar"><i class="fi fi-rr-trash"></i></span>
                            </div>
                        }
                        <div class="svc-contacto-add">
                            @if (!string.IsNullOrEmpty(_co.Nombre))
                            {
                                <span class="svc-pick-sel sm"><i class="fi fi-rr-user"></i> @_co.Nombre <button class="svc-pick-clear" @onclick="LimpiarContactoTercero">x</button></span>
                            }
                            else
                            {
                                <button class="srv-btn-ghost sm" @onclick='() => AbrirPicker("contacto")'><i class="fi fi-rr-search"></i> Elegir tercero</button>
                            }
                            <input class="srv-input sm" @bind="_co.Rol" placeholder="Rol (Supervisor...)" />
                            <input class="srv-input sm" @bind="_co.Telefono" placeholder="Telefono" />
                            <input class="srv-input sm" @bind="_co.Email" placeholder="Email" />
                            <button class="srv-btn-primary sm" @onclick="AgregarContactoAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_co.Nombre))">Agregar</button>
                        </div>
                        @if (_tTarget == "contacto") { @PickerPanel() }
                    </div>
                </div>

                @* ---- Adjuntos del servicio ---- *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-clip"></i> Archivos del servicio (@_srvDetalle.Adjuntos.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var a in _srvDetalle.Adjuntos)
                        {
                            var aa = a;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-document"></i>
                                <a href="@a.Url" target="_blank" class="srv-attach-name">@a.NombreArchivo</a>
                                <span class="srv-attach-size">@FmtBytes(a.TamanoBytes)</span>
                                <span class="srv-del" @onclick="() => EliminarAdjuntoServicioAsync(aa.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span>
                            </div>
                        }
                        <label class="srv-attach-up">
                            <i class="fi fi-rr-upload"></i><span>@(_attachBusy ? "Subiendo..." : "Adjuntar (PDF, imagen, Word, Excel)")</span>
                            <InputFile OnChange="(e) => SubirAdjuntoServicioAsync(e)" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx" disabled="@_attachBusy" />
                        </label>
                    </div>
                </div>

                @* ---- Contratos asociados ---- *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-document-signed"></i> Contratos del servicio (@_srvDetalle.Contratos.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var ct in _srvDetalle.Contratos)
                        {
                            var cct = ct;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-shield"></i>
                                <span class="srv-attach-name">@ct.Proveedor <span class="svc-mini">@TipoLabel(ct.Tipo)@(ct.RenovacionAutomatica ? " - renov. auto" : "")</span></span>
                                <span class="srv-attach-size">@(ct.ValorMensual is { } v ? "$" + v.ToString("N0") + "/mes" : "")</span>
                                <span class="srv-del" @onclick="() => DesasociarContratoAsync(cct.Id)" title="Quitar del servicio"><i class="fi fi-rr-link-slash"></i></span>
                            </div>
                        }
                        <div class="svc-contacto-add">
                            <select class="srv-input sm" @bind="_asociarContratoId">
                                <option value="">- Asociar contrato existente -</option>
                                @foreach (var c in _contratos.Where(x => x.ServicioId is null)) { <option value="@c.Id">@c.Proveedor (@TipoLabel(c.Tipo))</option> }
                            </select>
                            <button class="srv-btn-primary sm" @onclick="AsociarContratoAsync" disabled="@(_busy || string.IsNullOrEmpty(_asociarContratoId))">Asociar</button>
                        </div>
                    </div>
                </div>

                @* ---- Alertas del servicio ---- *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-bell"></i> Alertas del servicio (@_srvDetalle.Alertas.Count(a => a.Activa) activas)</div>
                    <div class="srv-attach-list">
                        @foreach (var al in _srvDetalle.Alertas)
                        {
                            var aa = al;
                            <div class="srv-attach-item @(al.Activa ? "" : "srv-alert-done")">
                                <i class="fi fi-rr-triangle-warning"></i>
                                <span class="srv-attach-name">@al.Titulo@(string.IsNullOrEmpty(al.Descripcion) ? "" : "") <span class="svc-mini">@al.Descripcion</span></span>
                                @if (al.Activa)
                                {
                                    <span class="srv-badge @SevCls(al.Severidad)">@al.Severidad</span>
                                    <button class="srv-btn-ghost sm" @onclick="() => ResolverAlertaServicioAsync(aa.Id)" disabled="@_busy">Resolver</button>
                                }
                                else { <span class="srv-badge ok">Resuelta</span> }
                            </div>
                        }
                        <div class="svc-contacto-add">
                            <input class="srv-input sm" @bind="_alTitulo" placeholder="Titulo de la alerta" />
                            <input class="srv-input sm" @bind="_alDescripcion" placeholder="Descripcion (opcional)" />
                            <select class="srv-input sm" @bind="_alSeveridad">
                                <option value="@SeveridadAlerta.Info">Info</option>
                                <option value="@SeveridadAlerta.Advertencia">Advertencia</option>
                                <option value="@SeveridadAlerta.Critica">Critica</option>
                            </select>
                            <button class="srv-btn-primary sm" @onclick="AgregarAlertaServicioAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_alTitulo))">Agregar</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="srv-banner info">Guarda el servicio para agregar contactos, archivos, contratos y alertas.</div>
            }

            @if (_srvError is not null) { <div class="srv-banner err">@_srvError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="CerrarServicioModal">Cerrar</button>
                <button class="srv-btn-primary" @onclick="GuardarServicioAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_sf.Nombre))"><i class="fi fi-rr-check"></i> @(_srvEditId is null ? "Crear servicio" : "Guardar cambios")</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: nueva cuenta de servicio ===== *@
@if (_spCuentaModal)
{
    <div class="srv-ov" @onclick="() => _spCuentaModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-bolt"></i></div>
            <div style="flex:1;min-width:0;"><div class="srv-modal-title">Nueva cuenta de servicio</div><div class="srv-sub" style="margin:2px 0 0;">Medidor o numero de cuenta ante un prestador.</div></div>
            <button class="srv-x" @onclick="() => _spCuentaModal = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="srv-grid">
                <div><label class="srv-lbl">Tipo de servicio</label>
                    <select class="srv-input" @bind="_fc.Tipo">@foreach (var t in Enum.GetValues<TipoServicioPublico>()) { <option value="@t">@SpLabel(t)</option> }</select>
                </div>
                <div><label class="srv-lbl">Unidad de medida</label><input class="srv-input" @bind="_fc.Unidad" placeholder="kWh, m3, GB..." /></div>
                <div class="srv-col-full"><label class="srv-lbl">Identificador / alias *</label><input class="srv-input" @bind="_fc.Alias" placeholder="Ej. Energia - Torre B" /></div>
                <div><label class="srv-lbl">Prestador</label><input class="srv-input" @bind="_fc.Prestador" placeholder="Razon social" /></div>
                <div><label class="srv-lbl">Numero de cuenta</label><input class="srv-input" @bind="_fc.NumeroCuenta" /></div>
                <div><label class="srv-lbl">Metodo de pago</label><input class="srv-input" @bind="_fc.MetodoPago" placeholder="Debito automatico..." /></div>
                <div><label class="srv-lbl">Umbral de alerta %</label><input class="srv-input" type="number" @bind="_fc.Umbral" /></div>
            </div>
            @if (_spError is not null) { <div class="srv-banner err">@_spError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="() => _spCuentaModal = false">Cancelar</button>
                <button class="srv-btn-primary" @onclick="GuardarCuentaAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_fc.Alias))"><i class="fi fi-rr-check"></i> Crear cuenta</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: cargar recibo / registro de consumo ===== *@
@if (_spReciboModal && _spDetalle is not null)
{
    <div class="srv-ov" @onclick="() => _spReciboModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-upload"></i></div>
            <div style="flex:1;min-width:0;"><div class="srv-modal-title">Cargar recibo - @_spDetalle.Cuenta.Alias</div><div class="srv-sub" style="margin:2px 0 0;">Registra el consumo y valor del periodo.</div></div>
            <button class="srv-x" @onclick="() => _spReciboModal = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="sp-ocr">
                <label class="sp-ocr-up">
                    <i class="fi fi-rr-upload"></i>
                    <span>@(_ocrBusy ? "Leyendo recibo con IA..." : "Cargar recibo (PDF/imagen) y extraer datos")</span>
                    <InputFile OnChange="SubirReciboOcr" accept=".pdf,image/*" disabled="@_ocrBusy" />
                </label>
                @if (!string.IsNullOrEmpty(_ocrMsg)) { <div class="sp-ocr-msg @_ocrMsgCls">@_ocrMsg</div> }
                <label class="sp-ocr-up" style="margin-top:8px;border-style:dashed;">
                    <i class="fi fi-rr-brain"></i>
                    <span>@(_agenteBusy ? "Analizando con el Agente Documental..." : "Analizar con el Agente Documental (IA)")</span>
                    <InputFile OnChange="AnalizarReciboAgente" accept=".pdf,image/*" disabled="@_agenteBusy" />
                </label>
                @if (!string.IsNullOrEmpty(_agenteAnalisis))
                {
                    <div style="margin-top:10px;border:1px solid var(--border,#e3e6ee);border-radius:10px;padding:12px 14px;background:var(--surface-2,#f7f8fc);">
                        <div style="font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:6px;"><i class="fi fi-rr-brain"></i> Agente Documental</div>
                        <div style="white-space:pre-wrap;font-size:.9rem;line-height:1.45;">@_agenteAnalisis</div>
                        @if (_agenteConv is not null && !_agenteConfirmado)
                        {
                            <div style="margin-top:10px;display:flex;gap:8px;align-items:center;">
                                <button class="srv-btn-primary" @onclick="ConfirmarAgenteAsync" disabled="@_agenteBusy">
                                    <i class="fi fi-rr-check-circle"></i> @(_agenteBusy ? "Registrando..." : "Confirmar y registrar")
                                </button>
                                <span style="font-size:.78rem;opacity:.65;">El agente persistira lo propuesto (dry-run=false).</span>
                            </div>
                        }
                        else if (_agenteConfirmado)
                        {
                            <div style="font-size:.82rem;color:var(--success,#1a7f37);margin-top:8px;"><i class="fi fi-rr-check"></i> Registrado por el agente. Revisa el historial actualizado.</div>
                        }
                    </div>
                }
            </div>
            <div class="srv-grid">
                <div><label class="srv-lbl">Anio</label><input class="srv-input" type="number" @bind="_fr.Anio" /></div>
                <div><label class="srv-lbl">Mes</label>
                    <select class="srv-input" @bind="_fr.Mes">@for (int m = 1; m <= 12; m++) { <option value="@m">@MesNombre(m)</option> }</select>
                </div>
                <div><label class="srv-lbl">Consumo (@(_spDetalle.Cuenta.UnidadMedida))</label><input class="srv-input" type="number" step="any" @bind="_fr.Consumo" /></div>
                <div><label class="srv-lbl">Valor facturado (COP)</label><input class="srv-input" type="number" step="any" @bind="_fr.Valor" /></div>
                <div><label class="srv-lbl">Estado</label>
                    <select class="srv-input" @bind="_fr.Estado"><option value="@EstadoRegistroConsumo.Confirmado">Confirmado</option><option value="@EstadoRegistroConsumo.Estimado">Estimado</option></select>
                </div>
                <div class="srv-col-full"><label class="srv-lbl">Nota del administrador (opcional)</label><textarea class="srv-input" rows="2" @bind="_fr.Nota"></textarea></div>
            </div>
            @if (_spError is not null) { <div class="srv-banner err">@_spError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="() => _spReciboModal = false">Cancelar</button>
                <button class="srv-btn-primary" @onclick="GuardarReciboAsync" disabled="@_busy"><i class="fi fi-rr-check"></i> Confirmar registro</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: nueva reclamacion ===== *@
@if (_spReclModal && _spDetalle is not null)
{
    <div class="srv-ov" @onclick="() => _spReclModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-comment-alt"></i></div>
            <div style="flex:1;min-width:0;"><div class="srv-modal-title">Nueva reclamacion</div><div class="srv-sub" style="margin:2px 0 0;">@_spDetalle.Cuenta.Alias - @_spDetalle.Cuenta.Prestador</div></div>
            <button class="srv-x" @onclick="() => _spReclModal = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="srv-grid">
                <div class="srv-col-full"><label class="srv-lbl">Motivo *</label><input class="srv-input" @bind="_frc.Motivo" placeholder="Ej. Cobro excesivo" /></div>
                <div class="srv-col-full"><label class="srv-lbl">N. de radicado</label><input class="srv-input" @bind="_frc.Radicado" placeholder="Radicado ante el prestador" /></div>
                <div class="srv-col-full"><label class="srv-lbl">Descripcion</label><textarea class="srv-input" rows="3" @bind="_frc.Descripcion"></textarea></div>
            </div>
            @if (_spError is not null) { <div class="srv-banner err">@_spError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="() => _spReclModal = false">Cancelar</button>
                <button class="srv-btn-primary" @onclick="GuardarReclamacionAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_frc.Motivo))"><i class="fi fi-rr-check"></i> Radicar reclamacion</button>
            </div>
        </div>
    </div>
}
}

@* Host de modales globales (programador de tareas). Vive aqui por boundary de render mode. *@
<ModalHost />

