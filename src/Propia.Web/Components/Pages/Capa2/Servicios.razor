    .ctr-search input { border: 0; outline: none; font-size: 13px; width: 100%; background: transparent; color: #1f2430; }
    .ctr-fsel { border: 1px solid #D9DEE7; border-radius: 9px; padding: 7px 10px; font-size: 12.5px; color: #33414F; background: #fff; cursor: pointer; }
    .ctr-range { display: flex; align-items: center; gap: 6px; border: 1px solid #D9DEE7; border-radius: 9px; padding: 5px 9px; background: #fff; }
    .ctr-range-lbl { font-size: 12px; color: #8593A5; font-weight: 600; }
    .ctr-range-sep { font-size: 12px; color: #A6B7C8; }
    .ctr-range input { border: 0; outline: none; font-size: 12.5px; color: #33414F; background: transparent; }
    .ctr-clear { border: 0; background: #F1ECFD; color: #5838C9; font-weight: 700; font-size: 12px; border-radius: 8px; padding: 7px 12px; cursor: pointer; }
    .ctr-clear:hover { background: #E6DEFB; }
    .ctr-count { padding: 10px 20px 0; font-size: 12px; color: #8593A5; font-weight: 600; }
    /* KPIs tipo tarjeta con degradado (estilo Tareas) */
    .ctr-kpis { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
    /* Tarjeta blanca estandar del sistema: borde suave + icono cuadrado con fondo pastel. */
    /* Compacto, en fila (mismo tamano que las stats de Unidades/Zonas/Directorio). */
    .ctr-kpi { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #E1E8EE; border-radius: 12px; padding: 14px 18px; box-shadow: 0 1px 2px rgba(45,62,80,.05); min-width: 190px; }
    .ctr-kpi-ic { width: 36px; height: 36px; flex-shrink: 0; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
    .ctr-kpi--brand .ctr-kpi-ic { background: #F1ECFD; color: #6D4FE3; }
    .ctr-kpi--ok .ctr-kpi-ic { background: #E6F6EE; color: #0F8A4F; }
    .ctr-kpi--warn .ctr-kpi-ic { background: #FEF3C7; color: #B45309; }
    .ctr-kpi--err .ctr-kpi-ic { background: #FEE2E2; color: #B91C1C; }
    .ctr-kpi--err .ctr-kpi-n { color: #B91C1C; }
    .ctr-kpi--warn .ctr-kpi-n { color: #B45309; }
    .ctr-kpi-body { min-width: 0; }
    .ctr-kpi-n { font-size: 20px; font-weight: 800; letter-spacing: -0.3px; color: #1B2A3A; line-height: 1.1; }
    .ctr-kpi-label { font-size: 11.5px; font-weight: 700; color: #516F90; margin-top: 1px; }
    .ctr-kpi-sub { font-size: 10.5px; font-weight: 600; color: #A6B7C8; margin-top: 1px; }
    /* Ya no hace falta forzar columnas: flex-wrap acomoda las tarjetas compactas. */
    /* Boton "Filtros" + popover constructor de reglas */
    .ctr-filtro-wrap { position: relative; }
    .ctr-fbtn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #D9DEE7; background: #fff; color: #46586B; border-radius: 9px; padding: 8px 13px; font-size: 12.5px; font-weight: 700; cursor: pointer; }
    .ctr-fbtn:hover { border-color: #C9B8F6; color: #5838C9; }
    .ctr-fbtn.on { background: #F4F1FE; border-color: #C9B8F6; color: #5838C9; }
    .ctr-fbadge { background: #7C5CFA; color: #fff; font-size: 10.5px; font-weight: 800; border-radius: 20px; padding: 0 6px; min-width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; }
    .ctr-fpop-bd { position: fixed; inset: 0; z-index: 40; }
    .ctr-fpop { position: absolute; top: calc(100% + 6px); left: 0; z-index: 41; width: 540px; max-width: 88vw; background: #fff; border: 1px solid #E6ECF2; border-radius: 13px; box-shadow: 0 18px 44px rgba(30,40,60,.22); padding: 12px; }
    .ctr-fpop-empty { padding: 14px; text-align: center; color: #94A3B8; font-size: 12.5px; line-height: 1.5; }
    .ctr-frule { display: flex; align-items: center; gap: 6px; margin-bottom: 7px; }
    .ctr-frule-lead { font-size: 11.5px; font-weight: 700; color: #8593A5; min-width: 42px; }
    .ctr-frule-logic { min-width: 52px; }
    .ctr-frule select, .ctr-frule input { border: 1px solid #DCE3EC; border-radius: 7px; padding: 5px 7px; font-size: 12px; color: #33414F; background: #fff; font-family: inherit; }
    .ctr-frule-f { flex: 1 1 120px; min-width: 90px; }
    .ctr-frule-op { flex: 0 1 120px; }
    .ctr-frule-v { flex: 1 1 120px; min-width: 90px; }
    .ctr-frule-del { border: 0; background: #F3F6FA; color: #97A6B6; border-radius: 6px; width: 24px; height: 24px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
    .ctr-frule-del:hover { background: #FDECEC; color: #E14B4B; }
    .ctr-fpop-foot { display: flex; align-items: center; gap: 10px; margin-top: 8px; padding-top: 9px; border-top: 1px dashed #E4EAF0; }
    .ctr-fadd { display: inline-flex; align-items: center; gap: 5px; border: 0; background: #F4F1FE; color: #5838C9; font-weight: 700; font-size: 12px; border-radius: 8px; padding: 7px 12px; cursor: pointer; }
    .ctr-fadd:hover { background: #E6DEFB; }
    .ctr-fclear2 { border: 0; background: transparent; color: #8593A5; font-weight: 600; font-size: 12px; cursor: pointer; }
    .ctr-fclear2:hover { color: #E14B4B; }
    /* Toggle Tabla / Tarjetas */
    .ctr-vtoggle { display: inline-flex; background: #F1F4F8; border-radius: 9px; padding: 3px; gap: 2px; }
    .ctr-vtoggle button { display: inline-flex; align-items: center; gap: 5px; border: 0; background: transparent; color: #64748B; font-size: 12.5px; font-weight: 700; padding: 6px 11px; border-radius: 7px; cursor: pointer; }
    .ctr-vtoggle button.on { background: #fff; color: #5838C9; box-shadow: 0 1px 3px rgba(45,62,80,.14); }
    /* Kanban de contratos */
    .ctr-kanban { display: flex; gap: 13px; padding: 14px 16px 18px; overflow-x: auto; align-items: flex-start; }
    .ctr-kcol { flex: 0 0 268px; background: #F7F9FC; border: 1px solid #EDF1F6; border-radius: 13px; padding: 8px; transition: background .12s, border-color .12s; }
    .ctr-kcol.over { background: #F1ECFD; border-color: #C9B8F6; }
    .ctr-kcol-h { display: flex; align-items: center; gap: 7px; padding: 6px 8px 9px; }
    .ctr-kdot { width: 10px; height: 10px; border-radius: 50%; flex: 0 0 auto; }
    .ctr-kcol-t { font-size: 12.5px; font-weight: 800; color: #33414F; flex: 1; }
    .ctr-kcol-n { font-size: 11px; font-weight: 800; color: #7C8A9C; background: #E9EEF4; border-radius: 20px; padding: 1px 8px; }
    .ctr-kcol-body { display: flex; flex-direction: column; gap: 8px; min-height: 60px; }
    .ctr-kcard { background: #fff; border: 1px solid #E9EEF3; border-radius: 11px; padding: 11px 12px; cursor: pointer; box-shadow: 0 1px 2px rgba(45,62,80,.05); }
    .ctr-kcard:hover { border-color: #D6C7FA; box-shadow: 0 4px 12px rgba(88,56,201,.10); }
    .ctr-kcard-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 5px; }
    .ctr-kcard-prov { font-weight: 800; color: #1f2430; font-size: 13px; }
    .ctr-kcard-meta { font-size: 11.5px; color: #8593A5; }
    .ctr-kcard-val { font-size: 12px; font-weight: 700; color: #46586B; margin-top: 5px; }
    .ctr-kempty { text-align: center; color: #B6C1CF; font-size: 11.5px; padding: 14px 6px; border: 1px dashed #DCE4EC; border-radius: 9px; }
    /* Filas del modal de etapas */
    .ctr-et-row { display: grid; grid-template-columns: 26px 34px 1fr auto 34px; align-items: center; gap: 9px; padding: 8px 10px; border: 1px solid #EDF1F6; border-radius: 11px; }
    .ctr-et-ord { display: flex; flex-direction: column; gap: 1px; }
    .ctr-et-mv { border: 0; background: #F3F6FA; color: #7C8A9C; font-size: 9px; line-height: 1; border-radius: 4px; height: 15px; cursor: pointer; }
    .ctr-et-mv:hover:not(:disabled) { background: #E6DEFB; color: #5838C9; }
    .ctr-et-mv:disabled { opacity: .3; cursor: default; }
    .ctr-et-color { width: 30px; height: 30px; border: 1px solid #DCE3EC; border-radius: 8px; padding: 2px; cursor: pointer; background: #fff; }
    .ctr-et-nom { border: 1px solid #E3E9F0; border-radius: 8px; padding: 7px 9px; font-size: 13px; color: #1f2430; font-family: inherit; min-width: 0; }
    .ctr-et-nom:focus { outline: none; border-color: #7C5CFA; box-shadow: 0 0 0 3px rgba(124,92,250,.14); }
    /* Secciones del modal Configurar (estilo "Configurar tablero" de Tareas) */
    .ctr-cm-sec { font-size: 11px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; color: #7C8A9C; margin: 4px 0 10px; }
    .ctr-cm-sec:not(:first-child) { margin-top: 22px; }
    .ctr-cm-help { font-size: 12px; color: #94A3B8; margin-bottom: 10px; line-height: 1.45; }
    .ctr-cm-count { font-size: 11px; color: #A6B2C1; font-weight: 600; white-space: nowrap; }
    .ctr-cm-newgrid { display: flex; gap: 8px; }
    /* Proveedor + ojo en la misma linea (estilo titulo de Tareas) */
    .ctr-terc-line { display: flex; align-items: center; gap: 6px; }
    /* Select de etapa con el color de la etapa (estilo Lista de Tareas) */
    .ctr-etsel { border: 0; color: #fff; font-weight: 700; font-size: 11.5px; border-radius: 8px; padding: 5px 9px; cursor: pointer; max-width: 175px; font-family: inherit; }
    .ctr-etsel option { color: #33414F; background: #fff; font-weight: 600; }
    /* Fila-agrupador dentro de la tabla */
    .ctr-grow td { background: #F8FAFC; border-bottom: 1px solid #EEF3F8; padding: 9px 12px; white-space: nowrap; }
    .ctr-grow .ctr-kdot { display: inline-block; vertical-align: middle; }
    .ctr-grow-t { font-size: 12px; font-weight: 800; color: #33414F; margin: 0 6px 0 7px; vertical-align: middle; }
    .ctr-group-h { display: flex; align-items: center; gap: 8px; padding: 14px 20px 6px; font-size: 12px; font-weight: 800; letter-spacing: .3px; text-transform: uppercase; color: #5838C9; }
    .ctr-group-n { background: #F1ECFD; color: #5838C9; font-size: 11px; font-weight: 800; border-radius: 20px; padding: 1px 8px; }
    .ctr-table-wrap { overflow-x: auto; padding: 4px 12px 6px; border: 1px solid #E1E8EE; border-radius: 12px; background: #fff; }
    .ctr-table { width: 100%; border-collapse: collapse; }
    .ctr-table thead th { text-align: left; font-size: 10.5px; font-weight: 800; letter-spacing: .4px; text-transform: uppercase; color: #8593A5; padding: 8px 10px; border-bottom: 1px solid #EEF3F8; white-space: nowrap; }
    .ctr-table th.ctr-r, .ctr-table td.ctr-r { text-align: right; }
    .ctr-table th.ctr-w2, .ctr-table td.ctr-w2 { width: 74px; text-align: right; white-space: nowrap; }
    .ctr-row { border-bottom: 1px solid #F3F6FA; }
    .ctr-row:hover { background: #FCFBFF; }
    .ctr-table td { padding: 9px 10px; font-size: 13px; color: #33414F; vertical-align: middle; }
    .ctr-ct { min-width: 190px; }
    .ctr-terc { font-weight: 700; color: #1f2430; }
    .ctr-terc-sub { font-size: 11px; color: #9AA7B8; margin-top: 1px; }
    /* Celda editable inline (click) */
    .ctr-ed { cursor: pointer; display: inline-block; border-radius: 5px; padding: 2px 5px; margin: -2px -5px; transition: background .1s; }
    .ctr-ed:hover { background: #EFEAFC; box-shadow: inset 0 0 0 1px #DACFFA; }
    /* En la celda Tercero, proveedor y NIT van apilados (no lado a lado) */
    .ctr-ct .ctr-terc, .ctr-ct .ctr-terc-sub { display: block; width: fit-content; max-width: 100%; }
    .ctr-ct .ctr-terc-sub { margin-top: 3px; }
    .ctr-inp { width: 100%; box-sizing: border-box; border: 1px solid #7C5CFA; border-radius: 6px; padding: 5px 7px; font-size: 13px; font-family: inherit; color: #1f2430; background: #fff; outline: none; }
    .ctr-inp:focus { box-shadow: 0 0 0 3px rgba(124,92,250,.16); }
    .ctr-inp-sub { font-size: 11px; margin-top: 3px; }
    .ctr-inp-r { text-align: right; }
    .ctr-open { cursor: pointer; color: #B6C1CF; display: inline-flex; vertical-align: middle; padding: 3px; border-radius: 6px; }
    .ctr-open:hover { color: #7C5CFA; background: #F1ECFD; }
    .ctr-cval { color: #516F90; min-width: 40px; }
    /* Ojo en la 1a columna (abre la ficha) */
    .ctr-table th.ctr-w-eye, .ctr-table td.ctr-w-eye { width: 34px; text-align: center; }
    .ctr-eye { cursor: pointer; color: #B6C1CF; display: inline-flex; padding: 3px; border-radius: 6px; }
    .ctr-eye:hover { color: #7C5CFA; background: #F1ECFD; }
    /* Pill de etapa + observaciones truncadas */
    .ctr-etpill { display: inline-block; font-size: 11px; font-weight: 700; border-radius: 20px; padding: 2px 9px; white-space: nowrap; }
    .ctr-obs { display: inline-block; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #64748B; font-size: 12px; vertical-align: middle; }
    /* Header fijo + scroll vertical (solo sin agrupar) */
    .ctr-table thead th { position: sticky; top: 0; z-index: 3; background: #fff; }
    .ctr-scroll { max-height: 62vh; overflow: auto; }
    /* Paginador */
    .ctr-pager { display: flex; align-items: center; justify-content: center; gap: 14px; padding: 14px 20px 6px; }
    .ctr-pager button { border: 1px solid #D9DEE7; background: #fff; color: #46586B; font-size: 12.5px; font-weight: 700; border-radius: 8px; padding: 7px 14px; cursor: pointer; }
    .ctr-pager button:hover:not(:disabled) { border-color: #C9B8F6; color: #5838C9; }
    .ctr-pager button:disabled { opacity: .4; cursor: default; }
    .ctr-pager-info { font-size: 12.5px; color: #7C8A9C; font-weight: 600; }
    /* Boton "Campos" */
    .ctr-cfg-btn { display: inline-flex; align-items: center; gap: 6px; background: #F4F1FE; color: #5838C9; border: 1px solid #E1D9FA; border-radius: 9px; padding: 8px 13px; font-size: 12.5px; font-weight: 700; cursor: pointer; }
    .ctr-cfg-btn:hover { background: #EDE7FD; border-color: #C9B8F6; }
    /* Modal de campos */
    .ctr-cm-back { position: fixed; inset: 0; background: rgba(30,30,50,.42); display: flex; align-items: center; justify-content: center; z-index: 1200; padding: 20px; }
    .ctr-cm { background: #fff; width: 100%; max-width: 520px; max-height: 86vh; overflow: auto; border-radius: 16px; box-shadow: 0 24px 60px rgba(30,30,60,.28); }
    .ctr-cm-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 18px 20px 12px; border-bottom: 1px solid #EEF3F8; }
    .ctr-cm-title { font-size: 16px; font-weight: 800; color: #1f2430; }
    .ctr-cm-sub { font-size: 12px; color: #8593A5; margin-top: 2px; }
    .ctr-cm-x { background: #F3F6FA; border: 0; border-radius: 8px; width: 30px; height: 30px; cursor: pointer; color: #64748B; font-size: 16px; display: inline-flex; align-items: center; justify-content: center; }
    .ctr-cm-x:hover { background: #E9EEF4; }
    .ctr-cm-body { padding: 16px 20px 20px; }
    .ctr-cm-empty { padding: 16px; text-align: center; color: #94A3B8; font-size: 13px; background: #F8FAFC; border: 1px dashed #DCE4EC; border-radius: 12px; }
    .ctr-cm-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
    .ctr-cm-row { display: grid; grid-template-columns: 26px 1fr auto auto 34px; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid #EDF1F6; border-radius: 11px; }
    .ctr-cm-row.off { opacity: .55; }
    .ctr-cm-rn { font-weight: 700; color: #26303C; font-size: 13.5px; }
    .ctr-cm-tipo { font-size: 11px; font-weight: 700; color: #6D4FE3; background: #F4F1FE; border: 1px solid #E4DBFA; border-radius: 20px; padding: 2px 9px; }
    .ctr-cm-sw { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; color: #64748B; cursor: pointer; }
    .ctr-cm-del { background: none; border: 0; color: #C3CEDA; cursor: pointer; font-size: 14px; padding: 4px; border-radius: 6px; }
    .ctr-cm-del:hover { color: #E14B4B; background: #FDECEC; }
    .ctr-cm-new { border-top: 1px dashed #E4EAF0; padding-top: 14px; }
    .ctr-cm-new-t { font-size: 12px; font-weight: 800; color: #7C8A9C; text-transform: uppercase; letter-spacing: .3px; margin-bottom: 9px; }
    .ctr-cm-new-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 8px; margin-bottom: 8px; }
    .ctr-cm-new textarea { margin-bottom: 8px; }

    .srv-ov { position: fixed; inset: 0; background: rgba(27,42,58,.55); z-index: 1200; }
    .srv-modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%); z-index: 1210; background: #fff; border-radius: 16px; box-shadow: 0 30px 70px rgba(27,42,58,.4); width: min(720px, 96vw); max-height: 92vh; display: flex; flex-direction: column; }
    .srv-modal-head { display: flex; align-items: center; gap: 13px; padding: 18px 22px; border-bottom: 1px solid #EEF3F8; flex-shrink: 0; }
    .srv-modal-ic { width: 38px; height: 38px; border-radius: 10px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .srv-modal-title { font-size: 16px; font-weight: 800; letter-spacing: -.3px; color: #1B2A3A; }
    /* Tabs del modal de contrato (Detalle / Archivos), estilo Tareas */
    .srv-modal-tabs { display: flex; gap: 4px; border-bottom: 1px solid #EEF3F8; margin: -4px 0 16px; }
    .srv-modal-tabs button { display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; color: #7C8A9C; font-size: 13px; font-weight: 700; padding: 9px 14px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .srv-modal-tabs button:hover { color: #5838C9; }
    .srv-modal-tabs button.on { color: #5838C9; border-bottom-color: #7C5CFA; }
    /* Historial del contrato (bitacora) */
    .srv-hist-list { display: flex; flex-direction: column; gap: 0; margin-top: 6px; }
    .srv-hist-item { display: flex; gap: 10px; padding: 8px 0; border-bottom: 1px solid #F1F4F7; }
    .srv-hist-item:last-child { border-bottom: 0; }
    .srv-hist-dot { width: 8px; height: 8px; border-radius: 50%; background: #7C5CFA; margin-top: 5px; flex-shrink: 0; }
    .srv-hist-body { flex: 1; min-width: 0; }
    .srv-hist-tx { font-size: 12.5px; color: #33475B; }
    .srv-hist-meta { font-size: 10.5px; color: #A6B7C8; margin-top: 1px; }
    .srv-tab-n { font-size: 11px; font-weight: 800; background: #F1ECFD; color: #5838C9; border-radius: 20px; padding: 1px 7px; }
    .srv-modal-body { padding: 20px 22px; overflow-y: auto; }
    .srv-x { width: 34px; height: 34px; border-radius: 9px; border: 1px solid #E1E8EE; background: #fff; color: #7C98B6; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; font-size: 17px; }
    .srv-x:hover { background: #F5F8FA; color: #33475B; }
    .srv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .srv-col-full { grid-column: 1 / -1; }
    .srv-lbl { display: block; font-size: 11px; color: #7C98B6; font-weight: 700; margin-bottom: 5px; }
    .srv-input { width: 100%; border: 1px solid #E1E8EE; border-radius: 9px; padding: 10px 12px; font-size: 13.5px; color: #33475B; outline: 0; background: #fff; box-sizing: border-box; }
    .srv-input:focus { border-color: #6D4FE3; }
    .srv-banner { border-radius: 9px; padding: 9px 12px; font-size: 12.5px; font-weight: 600; margin-top: 12px; }
    .srv-banner.err { background: #FDE7E7; border: 1px solid #F5C2C2; color: #A1352E; }
    .srv-banner.info { background: #EEF3FF; border: 1px solid #D5E0FB; color: #2F4B7C; }

    /* KPIs de 4 columnas (pestana Servicios) */
    .srv-kpis-4 { grid-template-columns: repeat(4, 1fr); }
    @@media (max-width: 760px) { .srv-kpis-4 { grid-template-columns: 1fr 1fr; } }

    /* Tabla de servicios */
    .svc-table { width: 100%; }
    .svc-thead, .svc-row { display: grid; grid-template-columns: 2.4fr 1.2fr 1.4fr 1fr 1fr .8fr 1fr 40px; gap: 10px; align-items: center; }
    .svc-thead { padding: 11px 20px; background: #FAFBFC; border-bottom: 1px solid #EEF3F8; font-size: 10.5px; letter-spacing: .4px; font-weight: 700; color: #A6B7C8; }
    .svc-row { padding: 12px 20px; border-bottom: 1px solid #F4F7FA; font-size: 12.5px; color: #33475B; cursor: pointer; background: #fff; }
    .svc-row:hover { background: #FBFAFE; }
    .svc-c-name { display: flex; align-items: center; gap: 11px; min-width: 0; }
    .svc-row-ic { width: 32px; height: 32px; border-radius: 8px; background: #EEF3F8; color: #516F90; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .svc-name { font-size: 13px; font-weight: 700; color: #1B2A3A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .svc-desc { font-size: 11px; color: #A6B7C8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .svc-c-tipo, .svc-c-ejec, .svc-c-cost, .svc-c-num, .svc-c-est { min-width: 0; }
    .svc-c-ejec { color: #516F90; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .svc-pill { display: inline-block; min-width: 22px; text-align: center; font-size: 11.5px; font-weight: 700; color: #516F90; background: #EEF3F8; border-radius: 7px; padding: 3px 8px; }
    .svc-mini { font-size: 10.5px; color: #A6B7C8; font-weight: 600; }

    /* Selector de tercero */
    .svc-pick-sel { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #33475B; background: #F1ECFD; border: 1px solid #DCD2F8; border-radius: 9px; padding: 8px 12px; }
    .svc-pick-sel.sm { font-size: 12px; padding: 6px 10px; }
    .svc-pick-clear { font-size: 11px; font-weight: 700; color: #6D4FE3; background: none; border: 0; cursor: pointer; }
    .svc-picker { margin-top: 8px; border: 1px solid #E1E8EE; border-radius: 11px; padding: 10px; background: #FBFCFE; }
    .svc-picker-results { display: flex; flex-direction: column; gap: 4px; max-height: 200px; overflow-y: auto; margin: 8px 0; }
    .svc-picker-item { display: flex; align-items: center; gap: 8px; text-align: left; padding: 8px 10px; border-radius: 8px; border: 1px solid #E1E8EE; background: #fff; font-size: 12.5px; color: #33475B; cursor: pointer; }
    .svc-picker-item:hover { border-color: #6D4FE3; background: #F5F1FE; }
    .svc-picker-empty { font-size: 12px; color: #A6B7C8; padding: 10px; text-align: center; }
    .svc-picker-create { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #6D4FE3; background: none; border: 0; cursor: pointer; padding: 4px 2px; }
    .svc-picker-new { display: flex; flex-direction: column; gap: 8px; }
    .svc-kind { display: flex; gap: 16px; font-size: 12.5px; font-weight: 600; color: #33475B; }
