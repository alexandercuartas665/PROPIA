@page "/servicios"
@page "/contratos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.MiCopropiedad
@using Propia.Application.ServiciosPublicos
@using Propia.Application.Servicios
@using Propia.Application.Directorio
@using Propia.Application.Programaciones
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Modals
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject IModalService Modals
@implements IDisposable

<PageTitle>@(EsContratos ? "Contratos" : "Servicios") - PROPIA</PageTitle>

@* Modulo 2.5 (Finanzas) "Servicios y contratos". Estilo prototipo PROPIA.dc.html:
   3 KPIs + proximos a vencer + lista de contratos + modal crear/detalle. API /api/mi-copropiedad/contratos. *@

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="srv-wrap">
    <div class="srv-head">
        <div>
            <h1 class="srv-title">@(EsContratos ? "Contratos" : "Servicios")</h1>
            <p class="srv-sub">@(EsContratos ? "Contratos estrategicos con proveedores de la copropiedad." : "Servicios contratados y servicios publicos de la copropiedad.")</p>
        </div>
    </div>

    @* En /contratos no hay pestanas (es su propio modulo). En /servicios: Servicios + Servicios publicos.
       Contratos se separo a su propia pagina (/contratos) con su item de menu. *@
    @if (!EsContratos)
    {
    <div class="srv-tabs">
        <button class="srv-tab @(_srvTab == "servicios" ? "on" : "")" @onclick='() => _srvTab = "servicios"'>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h18"/></svg>Servicios
        </button>
        <button class="srv-tab @(_srvTab == "publicos" ? "on" : "")" @onclick="IrPublicos">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z"/></svg>Servicios publicos
        </button>
    </div>
    }

    @if (!EsContratos && _srvTab == "servicios")
    {
        var costoMes = _servicios.Sum(s => s.CostoMensual ?? 0);
        <div class="srv-kpis srv-kpis-4">
            <div class="srv-kpi"><div class="srv-kpi-lbl">Total de servicios</div><div class="srv-kpi-val">@_servicios.Count</div></div>
            <div class="srv-kpi"><div class="srv-kpi-lbl">Activos</div><div class="srv-kpi-val ok">@_servicios.Count(s => s.Estado == EstadoServicio.Activo)</div></div>
            <div class="srv-kpi"><div class="srv-kpi-lbl">Costo mensual</div><div class="srv-kpi-val">$@costoMes.ToString("N0")</div></div>
            <div class="srv-kpi"><div class="srv-kpi-lbl">Contratos vinculados</div><div class="srv-kpi-val">@_servicios.Sum(s => s.CantidadContratos)</div></div>
        </div>

        <div class="srv-card">
            <div class="srv-card-head">
                <span class="srv-card-title">Servicios contratados</span>
                <button class="srv-btn-primary" @onclick="() => AbrirServicioModal(null)"><i class="fi fi-rr-plus"></i> Nuevo servicio</button>
            </div>
            @if (_servicios.Count == 0)
            {
                <div class="srv-empty"><i class="fi fi-rr-briefcase"></i><div>Aun no hay servicios. Crea el primero con "Nuevo servicio".</div></div>
            }
            else
            {
                <div class="svc-table">
                    <div class="svc-thead">
                        <div class="svc-c-name">SERVICIO</div>
                        <div class="svc-c-tipo">TIPO</div>
                        <div class="svc-c-ejec">EJECUTA</div>
                        <div class="svc-c-cost">COSTO MES</div>
                        <div class="svc-c-cost">COSTO ANO</div>
                        <div class="svc-c-num">CONTRATOS</div>
                        <div class="svc-c-est">ESTADO</div>
                        <div class="svc-c-act"></div>
                    </div>
                    @foreach (var s in _servicios)
                    {
                        var ss = s;
                        <div class="svc-row" @onclick="() => AbrirServicioModal(ss)">
                            <div class="svc-c-name">
                                <div class="svc-row-ic">@TipoIcon(s.Tipo)</div>
                                <div style="min-width:0;"><div class="svc-name">@s.Nombre</div>@if (!string.IsNullOrEmpty(s.Descripcion)) { <div class="svc-desc">@s.Descripcion</div> }</div>
                            </div>
                            <div class="svc-c-tipo">@TipoLabel(s.Tipo)</div>
                            <div class="svc-c-ejec">@(string.IsNullOrEmpty(s.EjecutorNombre) ? "-" : s.EjecutorNombre)</div>
                            <div class="svc-c-cost">@(s.CostoMensual is { } cm ? "$" + cm.ToString("N0") : "-")</div>
                            <div class="svc-c-cost">@(s.CostoAnual is { } ca ? "$" + ca.ToString("N0") : "-")</div>
                            <div class="svc-c-num"><span class="svc-pill">@s.CantidadContratos</span></div>
                            <div class="svc-c-est">
                                @if (s.Estado == EstadoServicio.Activo) { <span class="srv-badge ok">Activo</span> }
                                else if (s.Estado == EstadoServicio.Suspendido) { <span class="srv-badge warn">Suspendido</span> }
                                else { <span class="srv-badge vencido">Inactivo</span> }
                            </div>
                            <div class="svc-c-act"><span class="srv-del" @onclick:stopPropagation="true" @onclick="() => EliminarServicioAsync(ss.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span></div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (EsContratos)
    {
        var porVencer = _contratos.Where(c => c.AlertaVencimiento).OrderBy(c => c.DiasParaVencer).ToList();

    <div class="srv-kpis">
        <div class="srv-kpi"><div class="srv-kpi-lbl">Total de contratos</div><div class="srv-kpi-val">@_contratos.Count</div></div>
        <div class="srv-kpi"><div class="srv-kpi-lbl">Vigentes</div><div class="srv-kpi-val ok">@_contratos.Count(c => c.Estado == EstadoContrato.Vigente)</div></div>
        <div class="srv-kpi danger"><div class="srv-kpi-lbl danger">Por vencer</div><div class="srv-kpi-val danger">@porVencer.Count</div></div>
    </div>

    @if (porVencer.Count > 0)
    {
        <div class="srv-alert">
            <div class="srv-alert-head"><i class="fi fi-rr-triangle-warning"></i> PROXIMOS A VENCER</div>
            <div class="srv-alert-list">
                @foreach (var c in porVencer)
                {
                    var cc = c;
                    <div class="srv-alert-row">
                        <div class="srv-row-ic danger">@TipoIcon(c.Tipo)</div>
                        <div class="srv-row-body"><div class="srv-row-name">@c.Proveedor</div><div class="srv-row-meta">@TipoLabel(c.Tipo)@(c.FechaFin is { } f ? " - vence " + f.ToString("dd MMM yyyy") : "")</div></div>
                        <span class="srv-dias">Vence en @c.DiasParaVencer dias</span>
                        @if (c.Estado != EstadoContrato.EnRenovacion) { <button class="srv-renovar" @onclick="() => RenovarAsync(cc)" disabled="@_busy">Renovar</button> }
                        else { <span class="srv-badge warn">En renovacion</span> }
                    </div>
                }
            </div>
        </div>
    }

    <div class="srv-card">
        <div class="srv-card-head">
            <span class="srv-card-title">Todos los contratos</span>
            <button class="srv-btn-primary" @onclick="() => AbrirModal(null)"><i class="fi fi-rr-plus"></i> Nuevo contrato</button>
        </div>

        @* ---- Barra de filtros + agrupar ---- *@
        <div class="ctr-filtros">
            <div class="ctr-search"><i class="fi fi-rr-search"></i><input placeholder="Buscar proveedor, NIT, tipo..." value="@_cFiltroTexto" @oninput="e => { _cFiltroTexto = e.Value?.ToString() ?? string.Empty; }" /></div>
            <select class="ctr-fsel" @bind="_cFiltroTercero">
                <option value="">Todos los terceros</option>
                @foreach (var p in TercerosDistintos()) { <option value="@p">@p</option> }
            </select>
            <select class="ctr-fsel" @bind="_cFiltroTipoStr">
                <option value="">Todos los tipos</option>
                @foreach (var t in TiposDistintos()) { <option value="@((int)t)">@TipoLabel(t)</option> }
            </select>
            <select class="ctr-fsel" @bind="_cFiltroEstado">
                <option value="">Todos los estados</option>
                <option value="vigente">Vigentes</option>
                <option value="por-vencer">Por vencer</option>
                <option value="vencido">Vencidos</option>
                <option value="renovacion">En renovacion</option>
            </select>
            <div class="ctr-range">
                <span class="ctr-range-lbl">Vence</span>
                <input type="date" @bind="_cVenceDesde" title="Desde" />
                <span class="ctr-range-sep">a</span>
                <input type="date" @bind="_cVenceHasta" title="Hasta" />
            </div>
            <select class="ctr-fsel" @bind="_cAgrupar">
                <option value="">Sin agrupar</option>
                <option value="tipo">Agrupar por tipo</option>
                <option value="tercero">Agrupar por tercero</option>
                <option value="estado">Agrupar por estado</option>
            </select>
            @if (HayFiltrosContrato()) { <button class="ctr-clear" @onclick="LimpiarFiltrosContrato">Limpiar</button> }
        </div>

        @if (_contratos.Count == 0)
        {
            <div class="srv-empty"><i class="fi fi-rr-shield"></i><div>Aun no hay contratos. Crea el primero con "Nuevo contrato".</div></div>
        }
        else
        {
            var filtrados = ContratosFiltrados().ToList();
            if (filtrados.Count == 0)
            {
                <div class="srv-empty"><i class="fi fi-rr-search"></i><div>Ningun contrato coincide con los filtros.</div></div>
            }
            else
            {
                <div class="ctr-count">@filtrados.Count de @_contratos.Count contratos</div>
                @foreach (var grupo in AgruparContratos(filtrados))
                {
                    @if (_cAgrupar != "")
                    {
                        <div class="ctr-group-h">@grupo.Key <span class="ctr-group-n">@grupo.Count()</span></div>
                    }
                    <div class="ctr-table-wrap">
                        <table class="ctr-table">
                            <thead>
                                <tr>
                                    <th>Tercero</th><th>Tipo</th><th>Inicio</th><th>Vencimiento</th>
                                    <th class="ctr-r">$/mes</th><th>Estado</th><th class="ctr-w"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in grupo)
                                {
                                    var cc = c;
                                    <tr class="ctr-row" @onclick="() => AbrirModal(cc)">
                                        <td>
                                            <div class="ctr-terc">@c.Proveedor</div>
                                            @if (!string.IsNullOrWhiteSpace(c.NitProveedor)) { <div class="ctr-terc-sub">NIT @c.NitProveedor</div> }
                                        </td>
                                        <td>@TipoLabel(c.Tipo)</td>
                                        <td>@c.FechaInicio.ToString("dd MMM yyyy")</td>
                                        <td>@(c.FechaFin is { } ff ? ff.ToString("dd MMM yyyy") : "-")</td>
                                        <td class="ctr-r">@(c.ValorMensual is { } v ? "$" + v.ToString("N0") : "-")</td>
                                        <td>
                                            @if (c.Estado == EstadoContrato.Vencido) { <span class="srv-badge vencido">Vencido</span> }
                                            else if (c.AlertaVencimiento) { <span class="srv-badge danger">Vence en @c.DiasParaVencer dias</span> }
                                            else if (c.Estado == EstadoContrato.EnRenovacion) { <span class="srv-badge warn">En renovacion</span> }
                                            else { <span class="srv-badge ok">Vigente</span> }
                                        </td>
                                        <td class="ctr-w"><span class="srv-del" @onclick:stopPropagation="true" @onclick="() => EliminarAsync(cc.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    </div>
    }
    else
    {
        <div class="sp-kpis">
            <div class="sp-kpi"><div class="sp-kpi-l">Cuentas activas</div><div class="sp-kpi-v">@(_spResumen?.CuentasActivas ?? 0)</div></div>
            <div class="sp-kpi"><div class="sp-kpi-l">Gasto ultimo mes</div><div class="sp-kpi-v">$@((_spResumen?.GastoUltimoMes ?? 0).ToString("N0"))</div></div>
            <div class="sp-kpi @(_spResumen?.CuentasConAlerta > 0 ? "danger" : "")"><div class="sp-kpi-l @(_spResumen?.CuentasConAlerta > 0 ? "danger" : "")">Cuentas con alerta</div><div class="sp-kpi-v @(_spResumen?.CuentasConAlerta > 0 ? "danger" : "")">@(_spResumen?.CuentasConAlerta ?? 0)</div></div>
            <div class="sp-kpi"><div class="sp-kpi-l">Reclamaciones abiertas</div><div class="sp-kpi-v">@(_spResumen?.ReclamacionesAbiertas ?? 0)</div></div>
        </div>

        <div class="sp-grid">
            @* ---- Columna cuentas ---- *@
            <div class="sp-cuentas">
                <div class="sp-cuentas-h">CUENTAS DE SERVICIO</div>
                <div class="sp-cuentas-list">
                    @foreach (var c in _spCuentas)
                    {
                        var cid = c.Id;
                        <button class="sp-cuenta @(_spSel == c.Id ? "on" : "")" @onclick="() => SeleccionarCuentaAsync(cid)">
                            <div class="sp-cuenta-ic">@SpIcon(c.Tipo)</div>
                            <div class="sp-cuenta-b"><div class="sp-cuenta-a">@c.Alias</div><div class="sp-cuenta-p">@c.Prestador</div></div>
                            @if (c.TieneAlerta) { <span class="sp-dot"></span> }
                        </button>
                    }
                    <button class="sp-nueva" @onclick="AbrirNuevaCuenta"><i class="fi fi-rr-plus"></i> Nueva cuenta</button>
                </div>
            </div>

            @* ---- Detalle ---- *@
            <div class="sp-detalle">
                @if (_spDetalle is null)
                {
                    <div class="sp-empty">@(_spCuentas.Count == 0 ? "Aun no hay cuentas de servicio. Crea la primera con \"Nueva cuenta\"." : "Selecciona una cuenta para ver su consumo.")</div>
                }
                else
                {
                    var d = _spDetalle;
                    var barras = d.Registros.OrderBy(r => r.Anio * 100 + r.Mes).TakeLast(6).ToList();
                    var maxc = barras.Count > 0 ? barras.Max(b => b.Consumo) : 0;
                    <div class="sp-card">
                        <div class="sp-det-head">
                            <div class="sp-det-id">
                                <div class="sp-det-t">@d.Cuenta.Alias @if (d.Cuenta.TieneAlerta && d.Cuenta.VariacionPct is { } vp) { <span class="sp-desv">Desviacion +@vp.ToString("0.#")%</span> }</div>
                                <div class="sp-det-s">@d.Cuenta.Prestador @(string.IsNullOrEmpty(d.Cuenta.NumeroCuenta) ? "" : " - cuenta " + d.Cuenta.NumeroCuenta)@(string.IsNullOrEmpty(d.Cuenta.MetodoPago) ? "" : " - " + d.Cuenta.MetodoPago)</div>
                            </div>
                            <button class="srv-btn-primary" @onclick="AbrirCargarRecibo"><i class="fi fi-rr-upload"></i> Cargar recibo</button>
                        </div>
                        <div class="sp-chart">
                            @if (barras.Count == 0)
                            {
                                <div class="sp-empty sp-empty-sm">Sin registros de consumo aun.</div>
                            }
                            else
                            {
                                <div class="sp-bars">
                                    @foreach (var b in barras)
                                    {
                                        var h = maxc > 0 ? (int)Math.Round((double)(b.Consumo / maxc) * 100) : 0;
                                        <div class="sp-bar-col">
                                            <div class="sp-bar @(b.Alerta ? "alerta" : "")" style="height:@(Math.Max(h, 4))%" title="@b.Consumo"></div>
                                            <span class="sp-bar-lbl">@b.PeriodoLabel</span>
                                        </div>
                                    }
                                </div>
                                <div class="sp-prom">Promedio historico: <b>@(d.PromedioConsumo?.ToString("N1") ?? "-") @d.Cuenta.UnidadMedida</b> &middot; umbral de alerta @d.Cuenta.UmbralAlertaPct%</div>
                            }
                        </div>
                    </div>

                    <div class="sp-card">
                        <div class="sp-thead"><div class="sp-c-per">PERIODO</div><div class="sp-c-con">CONSUMO</div><div class="sp-c-val">VALOR</div><div class="sp-c-var">VAR.</div><div class="sp-c-est">ESTADO</div></div>
                        @if (d.Registros.Count == 0)
                        {
                            <div class="sp-empty sp-empty-sm">Sin registros.</div>
                        }
                        else
                        {
                            @foreach (var r in d.Registros)
                            {
                                <div class="sp-row">
                                    <div class="sp-c-per">@r.PeriodoLabel</div>
                                    <div class="sp-c-con">@r.Consumo.ToString("N0") @d.Cuenta.UnidadMedida</div>
                                    <div class="sp-c-val">$@r.Valor.ToString("N0")</div>
                                    <div class="sp-c-var">@if (r.VariacionPct is { } v) { <span class="@(r.Alerta ? "sp-var-up" : v < 0 ? "sp-var-down" : "sp-var-mid")">@(v > 0 ? "+" : "")@v.ToString("0.#")%</span> } else { <span class="sp-var-na">-</span> }</div>
                                    <div class="sp-c-est">@if (r.Estado == EstadoRegistroConsumo.Estimado) { <span class="srv-badge warn">Estimado</span> } else { <span class="srv-badge ok">Confirmado</span> }</div>
                                </div>
                            }
                        }
                        <div class="sp-recl-bar">
                            <button class="sp-recl-btn" @onclick="AbrirNuevaReclamacion"><i class="fi fi-rr-comment-alt"></i> Reclamaciones (@d.Reclamaciones.Count)</button>
                        </div>
                    </div>

                    @if (d.Reclamaciones.Count > 0)
                    {
                        <div class="sp-card">
                            <div class="sp-recl-h">RECLAMACIONES ANTE EL PRESTADOR</div>
                            <div class="sp-recl-list">
                                @foreach (var rc in d.Reclamaciones)
                                {
                                    <div class="sp-recl-item">
                                        <div class="sp-recl-top"><span class="sp-recl-motivo">@rc.Motivo</span><span class="srv-badge warn">@rc.Estado</span></div>
                                        <div class="sp-recl-meta">@(string.IsNullOrEmpty(rc.Radicado) ? "" : "Radicado " + rc.Radicado + " - ")@rc.Fecha.ToString("dd MMM yyyy")</div>
                                        @if (!string.IsNullOrEmpty(rc.Descripcion)) { <div class="sp-recl-desc">@rc.Descripcion</div> }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@* ===== Modal crear / detalle de contrato ===== *@
@if (_showModal)
{
    <div class="srv-ov" @onclick="() => _showModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-shield"></i></div>
            <div style="flex:1;min-width:0;">
                <div class="srv-modal-title">@(_editId is null ? "Nuevo contrato" : "Detalle del contrato")</div>
                <div class="srv-sub" style="margin:2px 0 0;">Datos del contrato y su vigencia.</div>
            </div>
            <button class="srv-x" @onclick="() => _showModal = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="srv-grid">
                <div class="srv-col-full">
                    <label class="srv-lbl">Nombre del contrato / servicio *</label>
                    <input class="srv-input" @bind="_f.Proveedor" @bind:event="oninput" placeholder="Ej. Vigilancia Andina S.A." />
                </div>
                <div>
                    <label class="srv-lbl">Tipo de servicio</label>
                    <select class="srv-input" @bind="_f.Tipo">
                        @foreach (var t in Enum.GetValues<TipoServicio>()) { <option value="@t">@TipoLabel(t)</option> }
                    </select>
                </div>
                <div>
                    <label class="srv-lbl">Proveedor / NIT</label>
                    <input class="srv-input" @bind="_f.Nit" @bind:event="oninput" placeholder="NIT o razon social" />
                </div>
                <div>
                    <label class="srv-lbl">Contacto</label>
                    <input class="srv-input" @bind="_f.Contacto" @bind:event="oninput" placeholder="Telefono / email" />
                </div>
                <div>
                    <label class="srv-lbl">Valor mensual (COP)</label>
                    <input class="srv-input" type="number" step="any" @bind="_f.Valor" placeholder="0" />
                </div>
                <div>
                    <label class="srv-lbl">Fecha de inicio</label>
                    <input class="srv-input" type="date" @bind="_f.Inicio" />
                </div>
                <div>
                    <label class="srv-lbl">Fecha de finalizacion</label>
                    <input class="srv-input" type="date" @bind="_f.Fin" />
                </div>
                <div>
                    <label class="srv-lbl">Dias de alerta antes de vencer</label>
                    <input class="srv-input" type="number" @bind="_f.Dias" />
                </div>
                @if (_editId is not null)
                {
                    <div>
                        <label class="srv-lbl">Estado</label>
                        <select class="srv-input" @bind="_f.Estado">
                            <option value="@EstadoContrato.Vigente">Vigente</option>
                            <option value="@EstadoContrato.EnRenovacion">En renovacion</option>
                        </select>
                    </div>
                }
                <div>
                    <label class="srv-lbl">Servicio (al que pertenece)</label>
                    <select class="srv-input" @bind="_f.ServicioId">
                        <option value="">- Sin servicio -</option>
                        @foreach (var s in _servicios) { <option value="@s.Id">@s.Nombre</option> }
                    </select>
                </div>
                <div>
                    <label class="srv-lbl">Expediente (modulo 2.15)</label>
                    <select class="srv-input" @bind="_f.ExpedienteId">
                        <option value="">- Sin expediente -</option>
                        @foreach (var e in _expedientes) { <option value="@e.Id">@e.Codigo - @e.Nombre</option> }
                    </select>
                </div>
                <div>
                    <label class="srv-lbl">Proyecto (modulo 2.10)</label>
                    <select class="srv-input" @bind="_f.ProyectoId">
                        <option value="">- Sin proyecto -</option>
                        @foreach (var p in _proyectos) { <option value="@p.Id">@p.Titulo</option> }
                    </select>
                </div>
                <div class="srv-col-full">
                    <label class="srv-check"><input type="checkbox" @bind="_f.RenovacionAutomatica" /> Tiene clausula de renovacion automatica</label>
                </div>
                <div class="srv-col-full">
                    <label class="srv-lbl">Observaciones</label>
                    <textarea class="srv-input" rows="2" @bind="_f.Observaciones" @bind:event="oninput" placeholder="Ej. Renovacion automatica con 30 dias de aviso."></textarea>
                </div>
            </div>

            @if (_editId is not null)
            {
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-clip"></i> Archivos del contrato (@_contratoAdjuntos.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var a in _contratoAdjuntos)
                        {
                            var aa = a;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-document"></i>
                                <a href="@a.Url" target="_blank" class="srv-attach-name">@a.NombreArchivo</a>
                                <span class="srv-attach-size">@FmtBytes(a.TamanoBytes)</span>
                                <span class="srv-del" @onclick="() => EliminarAdjuntoContratoAsync(aa.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span>
                            </div>
                        }
                        <label class="srv-attach-up">
                            <i class="fi fi-rr-upload"></i><span>@(_attachBusy ? "Subiendo..." : "Adjuntar (PDF, imagen, Word, Excel)")</span>
                            <InputFile OnChange="(e) => SubirAdjuntoContratoAsync(e)" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx" disabled="@_attachBusy" />
                        </label>
                    </div>
                </div>

                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-calendar-clock"></i> Programacion de vencimiento</div>
                    <div class="srv-prog-row">
                        <span class="srv-prog-tx">Crea una tarea (unica o recurrente) en un tablero para no olvidar la renovacion.</span>
                        <button class="srv-btn-ghost" @onclick="AbrirProgramadorContrato"><i class="fi fi-rr-calendar-plus"></i> Programar tarea</button>
                    </div>
                </div>
            }

            @if (_modalError is not null) { <div class="srv-banner err">@_modalError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="() => _showModal = false">Cancelar</button>
                <button class="srv-btn-primary" @onclick="GuardarAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_f.Proveedor))"><i class="fi fi-rr-check"></i> @(_editId is null ? "Crear contrato" : "Guardar contrato")</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: crear / editar servicio ===== *@
@if (_showSrvModal)
{
    <div class="srv-ov" @onclick="CerrarServicioModal"></div>
    <div class="srv-modal srv-modal-lg">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-briefcase"></i></div>
            <div style="flex:1;min-width:0;">
                <div class="srv-modal-title">@(_srvEditId is null ? "Nuevo servicio" : "Detalle del servicio")</div>
                <div class="srv-sub" style="margin:2px 0 0;">Servicio contratado, su ejecutor, contactos y contratos.</div>
            </div>
            <button class="srv-x" @onclick="CerrarServicioModal"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="srv-grid">
                <div class="srv-col-full"><label class="srv-lbl">Nombre del servicio *</label><input class="srv-input" @bind="_sf.Nombre" @bind:event="oninput" placeholder="Ej. Vigilancia y seguridad" /></div>
                <div><label class="srv-lbl">Tipo de servicio</label><select class="srv-input" @bind="_sf.Tipo">@foreach (var t in Enum.GetValues<TipoServicio>()) { <option value="@t">@TipoLabel(t)</option> }</select></div>
                <div><label class="srv-lbl">Estado</label><select class="srv-input" @bind="_sf.Estado"><option value="@EstadoServicio.Activo">Activo</option><option value="@EstadoServicio.Suspendido">Suspendido</option><option value="@EstadoServicio.Inactivo">Inactivo</option></select></div>
                <div><label class="srv-lbl">Costo mensual (COP)</label><input class="srv-input" type="number" step="any" @bind="_sf.CostoMensual" placeholder="0" /></div>
                <div><label class="srv-lbl">Costo anual (COP)</label><input class="srv-input" type="number" step="any" @bind="_sf.CostoAnual" placeholder="0" /></div>
                <div class="srv-col-full"><label class="srv-lbl">Descripcion</label><textarea class="srv-input" rows="2" @bind="_sf.Descripcion" @bind:event="oninput"></textarea></div>

                <div class="srv-col-full">
                    <label class="srv-lbl">Quien ejecuta el servicio (tercero del Directorio)</label>
                    @if (!string.IsNullOrEmpty(_sf.EjecutorNombre))
                    {
                        <div class="svc-pick-sel"><i class="fi fi-rr-user"></i> <span>@_sf.EjecutorNombre</span> <button class="svc-pick-clear" @onclick="LimpiarEjecutor">Cambiar</button></div>
                    }
                    else
                    {
                        <button class="srv-btn-ghost" @onclick='() => AbrirPicker("ejecutor")'><i class="fi fi-rr-search"></i> Seleccionar ejecutor</button>
                        @if (_tTarget == "ejecutor") { @PickerPanel() }
                    }
                </div>
            </div>

            @if (_srvEditId is not null && _srvDetalle is not null)
            {
                @* ---- Contactos ---- *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-users"></i> Contactos relacionados (@_srvDetalle.Contactos.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var c in _srvDetalle.Contactos)
                        {
                            var cc = c;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-user"></i>
                                <span class="srv-attach-name">@c.NombreSnapshot @(string.IsNullOrEmpty(c.Rol) ? "" : "- " + c.Rol)</span>
                                <span class="srv-attach-size">@(string.Join(" ", new[] { c.Telefono, c.Email }.Where(x => !string.IsNullOrEmpty(x))))</span>
                                <span class="srv-del" @onclick="() => EliminarContactoAsync(cc.Id)" title="Quitar"><i class="fi fi-rr-trash"></i></span>
                            </div>
                        }
                        <div class="svc-contacto-add">
                            @if (!string.IsNullOrEmpty(_co.Nombre))
                            {
                                <span class="svc-pick-sel sm"><i class="fi fi-rr-user"></i> @_co.Nombre <button class="svc-pick-clear" @onclick="LimpiarContactoTercero">x</button></span>
                            }
                            else
                            {
                                <button class="srv-btn-ghost sm" @onclick='() => AbrirPicker("contacto")'><i class="fi fi-rr-search"></i> Elegir tercero</button>
                            }
                            <input class="srv-input sm" @bind="_co.Rol" placeholder="Rol (Supervisor...)" />
                            <input class="srv-input sm" @bind="_co.Telefono" placeholder="Telefono" />
                            <input class="srv-input sm" @bind="_co.Email" placeholder="Email" />
                            <button class="srv-btn-primary sm" @onclick="AgregarContactoAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_co.Nombre))">Agregar</button>
                        </div>
                        @if (_tTarget == "contacto") { @PickerPanel() }
                    </div>
                </div>

                @* ---- Adjuntos del servicio ---- *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-clip"></i> Archivos del servicio (@_srvDetalle.Adjuntos.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var a in _srvDetalle.Adjuntos)
                        {
                            var aa = a;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-document"></i>
                                <a href="@a.Url" target="_blank" class="srv-attach-name">@a.NombreArchivo</a>
                                <span class="srv-attach-size">@FmtBytes(a.TamanoBytes)</span>
                                <span class="srv-del" @onclick="() => EliminarAdjuntoServicioAsync(aa.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span>
                            </div>
                        }
                        <label class="srv-attach-up">
                            <i class="fi fi-rr-upload"></i><span>@(_attachBusy ? "Subiendo..." : "Adjuntar (PDF, imagen, Word, Excel)")</span>
                            <InputFile OnChange="(e) => SubirAdjuntoServicioAsync(e)" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx" disabled="@_attachBusy" />
                        </label>
                    </div>
                </div>

                @* ---- Contratos asociados ---- *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-document-signed"></i> Contratos del servicio (@_srvDetalle.Contratos.Count)</div>
                    <div class="srv-attach-list">
                        @foreach (var ct in _srvDetalle.Contratos)
                        {
                            var cct = ct;
                            <div class="srv-attach-item">
                                <i class="fi fi-rr-shield"></i>
                                <span class="srv-attach-name">@ct.Proveedor <span class="svc-mini">@TipoLabel(ct.Tipo)@(ct.RenovacionAutomatica ? " - renov. auto" : "")</span></span>
                                <span class="srv-attach-size">@(ct.ValorMensual is { } v ? "$" + v.ToString("N0") + "/mes" : "")</span>
                                <span class="srv-del" @onclick="() => DesasociarContratoAsync(cct.Id)" title="Quitar del servicio"><i class="fi fi-rr-link-slash"></i></span>
                            </div>
                        }
                        <div class="svc-contacto-add">
                            <select class="srv-input sm" @bind="_asociarContratoId">
                                <option value="">- Asociar contrato existente -</option>
                                @foreach (var c in _contratos.Where(x => x.ServicioId is null)) { <option value="@c.Id">@c.Proveedor (@TipoLabel(c.Tipo))</option> }
                            </select>
                            <button class="srv-btn-primary sm" @onclick="AsociarContratoAsync" disabled="@(_busy || string.IsNullOrEmpty(_asociarContratoId))">Asociar</button>
                        </div>
                    </div>
                </div>

                @* ---- Alertas del servicio ---- *@
                <div class="srv-attach">
                    <div class="srv-attach-h"><i class="fi fi-rr-bell"></i> Alertas del servicio (@_srvDetalle.Alertas.Count(a => a.Activa) activas)</div>
                    <div class="srv-attach-list">
                        @foreach (var al in _srvDetalle.Alertas)
                        {
                            var aa = al;
                            <div class="srv-attach-item @(al.Activa ? "" : "srv-alert-done")">
                                <i class="fi fi-rr-triangle-warning"></i>
                                <span class="srv-attach-name">@al.Titulo@(string.IsNullOrEmpty(al.Descripcion) ? "" : "") <span class="svc-mini">@al.Descripcion</span></span>
                                @if (al.Activa)
                                {
                                    <span class="srv-badge @SevCls(al.Severidad)">@al.Severidad</span>
                                    <button class="srv-btn-ghost sm" @onclick="() => ResolverAlertaServicioAsync(aa.Id)" disabled="@_busy">Resolver</button>
                                }
                                else { <span class="srv-badge ok">Resuelta</span> }
                            </div>
                        }
                        <div class="svc-contacto-add">
                            <input class="srv-input sm" @bind="_alTitulo" placeholder="Titulo de la alerta" />
                            <input class="srv-input sm" @bind="_alDescripcion" placeholder="Descripcion (opcional)" />
                            <select class="srv-input sm" @bind="_alSeveridad">
                                <option value="@SeveridadAlerta.Info">Info</option>
                                <option value="@SeveridadAlerta.Advertencia">Advertencia</option>
                                <option value="@SeveridadAlerta.Critica">Critica</option>
                            </select>
                            <button class="srv-btn-primary sm" @onclick="AgregarAlertaServicioAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_alTitulo))">Agregar</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="srv-banner info">Guarda el servicio para agregar contactos, archivos, contratos y alertas.</div>
            }

            @if (_srvError is not null) { <div class="srv-banner err">@_srvError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="CerrarServicioModal">Cerrar</button>
                <button class="srv-btn-primary" @onclick="GuardarServicioAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_sf.Nombre))"><i class="fi fi-rr-check"></i> @(_srvEditId is null ? "Crear servicio" : "Guardar cambios")</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: nueva cuenta de servicio ===== *@
@if (_spCuentaModal)
{
    <div class="srv-ov" @onclick="() => _spCuentaModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-bolt"></i></div>
            <div style="flex:1;min-width:0;"><div class="srv-modal-title">Nueva cuenta de servicio</div><div class="srv-sub" style="margin:2px 0 0;">Medidor o numero de cuenta ante un prestador.</div></div>
            <button class="srv-x" @onclick="() => _spCuentaModal = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="srv-grid">
                <div><label class="srv-lbl">Tipo de servicio</label>
                    <select class="srv-input" @bind="_fc.Tipo">@foreach (var t in Enum.GetValues<TipoServicioPublico>()) { <option value="@t">@SpLabel(t)</option> }</select>
                </div>
                <div><label class="srv-lbl">Unidad de medida</label><input class="srv-input" @bind="_fc.Unidad" placeholder="kWh, m3, GB..." /></div>
                <div class="srv-col-full"><label class="srv-lbl">Identificador / alias *</label><input class="srv-input" @bind="_fc.Alias" placeholder="Ej. Energia - Torre B" /></div>
                <div><label class="srv-lbl">Prestador</label><input class="srv-input" @bind="_fc.Prestador" placeholder="Razon social" /></div>
                <div><label class="srv-lbl">Numero de cuenta</label><input class="srv-input" @bind="_fc.NumeroCuenta" /></div>
                <div><label class="srv-lbl">Metodo de pago</label><input class="srv-input" @bind="_fc.MetodoPago" placeholder="Debito automatico..." /></div>
                <div><label class="srv-lbl">Umbral de alerta %</label><input class="srv-input" type="number" @bind="_fc.Umbral" /></div>
            </div>
            @if (_spError is not null) { <div class="srv-banner err">@_spError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="() => _spCuentaModal = false">Cancelar</button>
                <button class="srv-btn-primary" @onclick="GuardarCuentaAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_fc.Alias))"><i class="fi fi-rr-check"></i> Crear cuenta</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: cargar recibo / registro de consumo ===== *@
@if (_spReciboModal && _spDetalle is not null)
{
    <div class="srv-ov" @onclick="() => _spReciboModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-upload"></i></div>
            <div style="flex:1;min-width:0;"><div class="srv-modal-title">Cargar recibo - @_spDetalle.Cuenta.Alias</div><div class="srv-sub" style="margin:2px 0 0;">Registra el consumo y valor del periodo.</div></div>
            <button class="srv-x" @onclick="() => _spReciboModal = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="sp-ocr">
                <label class="sp-ocr-up">
                    <i class="fi fi-rr-upload"></i>
                    <span>@(_ocrBusy ? "Leyendo recibo con IA..." : "Cargar recibo (PDF/imagen) y extraer datos")</span>
                    <InputFile OnChange="SubirReciboOcr" accept=".pdf,image/*" disabled="@_ocrBusy" />
                </label>
                @if (!string.IsNullOrEmpty(_ocrMsg)) { <div class="sp-ocr-msg @_ocrMsgCls">@_ocrMsg</div> }
                <label class="sp-ocr-up" style="margin-top:8px;border-style:dashed;">
                    <i class="fi fi-rr-brain"></i>
                    <span>@(_agenteBusy ? "Analizando con el Agente Documental..." : "Analizar con el Agente Documental (IA)")</span>
                    <InputFile OnChange="AnalizarReciboAgente" accept=".pdf,image/*" disabled="@_agenteBusy" />
                </label>
                @if (!string.IsNullOrEmpty(_agenteAnalisis))
                {
                    <div style="margin-top:10px;border:1px solid var(--border,#e3e6ee);border-radius:10px;padding:12px 14px;background:var(--surface-2,#f7f8fc);">
                        <div style="font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:6px;"><i class="fi fi-rr-brain"></i> Agente Documental</div>
                        <div style="white-space:pre-wrap;font-size:.9rem;line-height:1.45;">@_agenteAnalisis</div>
                        @if (_agenteConv is not null && !_agenteConfirmado)
                        {
                            <div style="margin-top:10px;display:flex;gap:8px;align-items:center;">
                                <button class="srv-btn-primary" @onclick="ConfirmarAgenteAsync" disabled="@_agenteBusy">
                                    <i class="fi fi-rr-check-circle"></i> @(_agenteBusy ? "Registrando..." : "Confirmar y registrar")
                                </button>
                                <span style="font-size:.78rem;opacity:.65;">El agente persistira lo propuesto (dry-run=false).</span>
                            </div>
                        }
                        else if (_agenteConfirmado)
                        {
                            <div style="font-size:.82rem;color:var(--success,#1a7f37);margin-top:8px;"><i class="fi fi-rr-check"></i> Registrado por el agente. Revisa el historial actualizado.</div>
                        }
                    </div>
                }
            </div>
            <div class="srv-grid">
                <div><label class="srv-lbl">Anio</label><input class="srv-input" type="number" @bind="_fr.Anio" /></div>
                <div><label class="srv-lbl">Mes</label>
                    <select class="srv-input" @bind="_fr.Mes">@for (int m = 1; m <= 12; m++) { <option value="@m">@MesNombre(m)</option> }</select>
                </div>
                <div><label class="srv-lbl">Consumo (@(_spDetalle.Cuenta.UnidadMedida))</label><input class="srv-input" type="number" step="any" @bind="_fr.Consumo" /></div>
                <div><label class="srv-lbl">Valor facturado (COP)</label><input class="srv-input" type="number" step="any" @bind="_fr.Valor" /></div>
                <div><label class="srv-lbl">Estado</label>
                    <select class="srv-input" @bind="_fr.Estado"><option value="@EstadoRegistroConsumo.Confirmado">Confirmado</option><option value="@EstadoRegistroConsumo.Estimado">Estimado</option></select>
                </div>
                <div class="srv-col-full"><label class="srv-lbl">Nota del administrador (opcional)</label><textarea class="srv-input" rows="2" @bind="_fr.Nota"></textarea></div>
            </div>
            @if (_spError is not null) { <div class="srv-banner err">@_spError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="() => _spReciboModal = false">Cancelar</button>
                <button class="srv-btn-primary" @onclick="GuardarReciboAsync" disabled="@_busy"><i class="fi fi-rr-check"></i> Confirmar registro</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: nueva reclamacion ===== *@
@if (_spReclModal && _spDetalle is not null)
{
    <div class="srv-ov" @onclick="() => _spReclModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
