    protected override void OnInitialized()
    {
        // /servicios y /contratos son EL MISMO componente: al navegar entre ellos Blazor reusa la
        // instancia y OnAfterRender(firstRender) NO vuelve a correr, por lo que los datos no se
        // recargaban (a veces se quedaban los de la vista anterior). Recargamos en cada cambio de ruta.
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_jwt is null) return;
        var rel = Nav.ToBaseRelativePath(e.Location).TrimEnd('/').Split('?')[0].ToLowerInvariant();
        if (rel is "servicios" or "contratos")
        {
            _ = InvokeAsync(async () => { await CargarAsync(); StateHasChanged(); });
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored)) { _jwt = stored; await CargarAsync(); StateHasChanged(); }
        }
        catch { }
    }

    private async Task CargarAsync()
    {
        try { _contratos = await GetAuthAsync<List<ContratoServicioDto>>("/api/mi-copropiedad/contratos") ?? new(); }
        catch (SesionRedirigidaException) { return; }
        catch { _contratos = new(); }
        try { _servicios = await GetAuthAsync<List<ServicioDto>>("/api/servicios") ?? new(); }
        catch (SesionRedirigidaException) { return; }
        catch { _servicios = new(); }
    }

