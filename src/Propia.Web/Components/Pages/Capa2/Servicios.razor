    private async Task GuardarServicioAsync()
    {
        if (string.IsNullOrWhiteSpace(_sf.Nombre)) { _srvError = "El nombre del servicio es obligatorio."; return; }
        _busy = true; _srvError = null;
        try
        {
            if (_srvEditId is null)
            {
                var resp = await Auth().PostAsJsonAsync("/api/servicios",
                    new CrearServicioRequest(_sf.Tipo, _sf.Nombre.Trim(), Limpio(_sf.Descripcion),
                        _sf.EjecutorPersonaId, _sf.EjecutorEmpresaId, Limpio(_sf.EjecutorNombre), _sf.CostoMensual, _sf.CostoAnual));
                if (!resp.IsSuccessStatusCode) { _srvError = await ReadErr(resp); return; }
                var nuevo = await resp.Content.ReadFromJsonAsync<ServicioDto>();
                await CargarAsync();
                if (nuevo is not null) { _srvEditId = nuevo.Id; await CargarServicioDetalleAsync(nuevo.Id); }
            }
            else
            {
                var resp = await Auth().PutAsJsonAsync($"/api/servicios/{_srvEditId}",
                    new ActualizarServicioRequest(_sf.Tipo, _sf.Nombre.Trim(), Limpio(_sf.Descripcion),
                        _sf.EjecutorPersonaId, _sf.EjecutorEmpresaId, Limpio(_sf.EjecutorNombre), _sf.CostoMensual, _sf.CostoAnual, _sf.Estado));
                if (!resp.IsSuccessStatusCode) { _srvError = await ReadErr(resp); return; }
                await CargarAsync();
                await CargarServicioDetalleAsync(_srvEditId.Value);
            }
        }
        catch (Exception ex) { _srvError = ex.Message; }
        finally { _busy = false; }
    }

