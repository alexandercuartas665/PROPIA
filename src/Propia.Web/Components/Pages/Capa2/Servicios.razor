    .srv-empty i { display: block; font-size: 28px; color: #C3D0DD; margin-bottom: 10px; }

    .srv-ov { position: fixed; inset: 0; background: rgba(27,42,58,.55); z-index: 1200; }
    .srv-modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%); z-index: 1210; background: #fff; border-radius: 16px; box-shadow: 0 30px 70px rgba(27,42,58,.4); width: min(720px, 96vw); max-height: 92vh; display: flex; flex-direction: column; }
    .srv-modal-head { display: flex; align-items: center; gap: 13px; padding: 18px 22px; border-bottom: 1px solid #EEF3F8; flex-shrink: 0; }
    .srv-modal-ic { width: 38px; height: 38px; border-radius: 10px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .srv-modal-title { font-size: 16px; font-weight: 800; letter-spacing: -.3px; color: #1B2A3A; }
    .srv-modal-body { padding: 20px 22px; overflow-y: auto; }
    .srv-x { width: 34px; height: 34px; border-radius: 9px; border: 1px solid #E1E8EE; background: #fff; color: #7C98B6; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; font-size: 17px; }
    .srv-x:hover { background: #F5F8FA; color: #33475B; }
    .srv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .srv-col-full { grid-column: 1 / -1; }
    .srv-lbl { display: block; font-size: 11px; color: #7C98B6; font-weight: 700; margin-bottom: 5px; }
    .srv-input { width: 100%; border: 1px solid #E1E8EE; border-radius: 9px; padding: 10px 12px; font-size: 13.5px; color: #33475B; outline: 0; background: #fff; box-sizing: border-box; }
    .srv-input:focus { border-color: #6D4FE3; }
    .srv-banner { border-radius: 9px; padding: 9px 12px; font-size: 12.5px; font-weight: 600; margin-top: 12px; }
    .srv-banner.err { background: #FDE7E7; border: 1px solid #F5C2C2; color: #A1352E; }
</style>

@code {
    private string? _jwt;
    private bool _busy;
    private string _srvTab = "contratos";   // "contratos" | "publicos" (2.17)
    private List<ContratoServicioDto> _contratos = new();

    private bool _showModal;
    private Guid? _editId;
    private string? _modalError;
    private Form _f = new();

    private sealed class Form
    {
        public TipoServicio Tipo { get; set; } = TipoServicio.Seguridad;
        public string Proveedor { get; set; } = "";
        public string? Nit { get; set; }
        public string? Contacto { get; set; }
        public DateTime? Inicio { get; set; } = DateTime.Today;
        public DateTime? Fin { get; set; }
        public decimal? Valor { get; set; }
        public int Dias { get; set; } = 30;
        public string? Observaciones { get; set; }
        public EstadoContrato Estado { get; set; } = EstadoContrato.Vigente;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored)) { _jwt = stored; await CargarAsync(); StateHasChanged(); }
        }
        catch { }
    }

    private async Task CargarAsync()
    {
        try { _contratos = await Auth().GetFromJsonAsync<List<ContratoServicioDto>>("/api/mi-copropiedad/contratos") ?? new(); }
        catch { _contratos = new(); }
    }

    private void AbrirModal(ContratoServicioDto? c)
    {
        _modalError = null;
        if (c is null)
        {
            _editId = null;
            _f = new Form();
        }
        else
        {
            _editId = c.Id;
            _f = new Form
            {
                Tipo = c.Tipo, Proveedor = c.Proveedor, Nit = c.NitProveedor, Contacto = c.Contacto,
                Inicio = c.FechaInicio.ToDateTime(TimeOnly.MinValue),
                Fin = c.FechaFin?.ToDateTime(TimeOnly.MinValue),
                Valor = c.ValorMensual, Dias = c.DiasAnticipacionAlerta, Observaciones = c.Observaciones,
                Estado = c.Estado == EstadoContrato.Vencido ? EstadoContrato.Vigente : c.Estado
            };
        }
        _showModal = true;
    }

    private async Task GuardarAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_f.Proveedor)) { _modalError = "El nombre del contrato es obligatorio."; return; }
        _busy = true;
        try
        {
            var inicio = DateOnly.FromDateTime(_f.Inicio ?? DateTime.Today);
            DateOnly? fin = _f.Fin.HasValue ? DateOnly.FromDateTime(_f.Fin.Value) : null;
            HttpResponseMessage resp;
            if (_editId is null)
            {
                resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/contratos",
                    new CrearContratoServicioRequest(_f.Tipo, _f.Proveedor.Trim(), Limpio(_f.Nit), Limpio(_f.Contacto),
                        inicio, fin, _f.Valor, Limpio(_f.Observaciones), _f.Dias <= 0 ? 30 : _f.Dias));
            }
            else
            {
                resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/contratos/{_editId}",
                    new ActualizarContratoRequest(_f.Estado, _f.Dias <= 0 ? 30 : _f.Dias, _f.Tipo, _f.Proveedor.Trim(),
                        Limpio(_f.Nit) ?? "", Limpio(_f.Contacto) ?? "", inicio, fin, _f.Valor, Limpio(_f.Observaciones) ?? ""));
            }
            if (!resp.IsSuccessStatusCode) { _modalError = await resp.Content.ReadAsStringAsync(); return; }
            _showModal = false;
            await CargarAsync();
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RenovarAsync(ContratoServicioDto c)
    {
        _busy = true;
        try
        {
            await Auth().PutAsJsonAsync($"/api/mi-copropiedad/contratos/{c.Id}",
                new ActualizarContratoRequest(EstadoContrato.EnRenovacion, c.DiasAnticipacionAlerta));
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task EliminarAsync(Guid id)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Eliminar este contrato?")) return;
        _busy = true;
        try { await Auth().DeleteAsync($"/api/mi-copropiedad/contratos/{id}"); await CargarAsync(); }
        finally { _busy = false; }
    }

    private static string? Limpio(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static string TipoLabel(TipoServicio t) => t switch
    {
        TipoServicio.PiscinaMantenimiento => "Mantenimiento piscina",
        TipoServicio.InternetWifi => "Internet / WiFi",
        TipoServicio.SeguroPH => "Seguro PH",
