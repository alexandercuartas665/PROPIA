    .srv-btn-primary:disabled { opacity: .55; cursor: default; box-shadow: none; }
    .srv-btn-ghost { border: 1px solid #E1E8EE; background: #fff; color: #516F90; font-weight: 600; font-size: 13px; padding: 9px 15px; border-radius: 9px; cursor: pointer; }
    .srv-btn-ghost:hover { border-color: #C3D0DD; }
    .srv-list { padding: 16px 20px; display: flex; flex-direction: column; gap: 9px; }
    .srv-row { display: flex; align-items: center; gap: 13px; border: 1px solid #E1E8EE; border-radius: 10px; padding: 12px 15px; text-align: left; background: #fff; width: 100%; cursor: pointer; }
    .srv-row:hover { border-color: #6D4FE3; background: #FBFAFE; }
    .srv-row-ic { width: 34px; height: 34px; border-radius: 9px; background: #EEF3F8; color: #516F90; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .srv-row-ic.danger { background: #FDE7E7; color: #C0383C; }
    .srv-row-body { flex: 1; min-width: 0; }
    .srv-row-name { font-size: 13.5px; font-weight: 700; color: #33475B; }
    .srv-row-meta { font-size: 11.5px; color: #A6B7C8; margin-top: 1px; }
    .srv-badge { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 7px; white-space: nowrap; flex-shrink: 0; }
    .srv-badge.ok { color: #1A8754; background: #E6F6EE; }
    .srv-badge.warn { color: #92591A; background: #FEF3DC; }
    .srv-badge.danger { color: #C0383C; background: #FDE7E7; }
    .srv-badge.vencido { color: #92591A; background: #FEF3DC; }
    .srv-del { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; color: #C3D0DD; flex-shrink: 0; }
    .srv-del:hover { background: #FDE7E7; color: #D7263D; }
