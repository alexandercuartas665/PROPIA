    // Modo por ruta: /contratos = modulo Contratos (su propia pagina + item de menu); /servicios =
    // modulo Servicios (pestanas Servicios + Servicios publicos). Misma componente, dos rutas.
    private bool EsContratos =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').Split('?')[0].Equals("contratos", StringComparison.OrdinalIgnoreCase);
    private List<ContratoServicioDto> _contratos = new();

    // ---- Filtros / agrupar de la tabla de contratos (Fase A) ----
    private string _cFiltroTexto = "";
    private string _cFiltroTercero = "";
    private string _cFiltroTipoStr = "";
    private string _cFiltroEstado = "";
    private DateOnly? _cVenceDesde;
    private DateOnly? _cVenceHasta;
    private string _cAgrupar = "";

    private IEnumerable<string> TercerosDistintos() =>
        _contratos.Select(c => c.Proveedor).Where(p => !string.IsNullOrWhiteSpace(p)).Distinct().OrderBy(p => p);
    private IEnumerable<TipoServicio> TiposDistintos() =>
        _contratos.Select(c => c.Tipo).Distinct().OrderBy(t => TipoLabel(t));

    private bool HayFiltrosContrato() =>
        !string.IsNullOrWhiteSpace(_cFiltroTexto) || !string.IsNullOrEmpty(_cFiltroTercero)
        || !string.IsNullOrEmpty(_cFiltroTipoStr) || !string.IsNullOrEmpty(_cFiltroEstado)
        || _cVenceDesde is not null || _cVenceHasta is not null;

    private void LimpiarFiltrosContrato()
    {
        _cFiltroTexto = ""; _cFiltroTercero = ""; _cFiltroTipoStr = "";
        _cFiltroEstado = ""; _cVenceDesde = null; _cVenceHasta = null;
    }

    private IEnumerable<ContratoServicioDto> ContratosFiltrados()
    {
        var q = _contratos.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_cFiltroTexto))
        {
            var t = _cFiltroTexto.Trim().ToLowerInvariant();
            q = q.Where(c => (c.Proveedor ?? "").ToLowerInvariant().Contains(t)
                          || (c.Contacto ?? "").ToLowerInvariant().Contains(t)
                          || (c.NitProveedor ?? "").ToLowerInvariant().Contains(t)
                          || TipoLabel(c.Tipo).ToLowerInvariant().Contains(t));
        }
        if (!string.IsNullOrEmpty(_cFiltroTercero)) q = q.Where(c => c.Proveedor == _cFiltroTercero);
        if (int.TryParse(_cFiltroTipoStr, out var ti)) q = q.Where(c => (int)c.Tipo == ti);
        q = _cFiltroEstado switch
        {
            "vigente"    => q.Where(c => c.Estado == EstadoContrato.Vigente && !c.AlertaVencimiento),
            "por-vencer" => q.Where(c => c.AlertaVencimiento && c.Estado != EstadoContrato.Vencido),
            "vencido"    => q.Where(c => c.Estado == EstadoContrato.Vencido),
            "renovacion" => q.Where(c => c.Estado == EstadoContrato.EnRenovacion),
            _ => q
        };
        if (_cVenceDesde is { } d) q = q.Where(c => c.FechaFin is { } f && f >= d);
        if (_cVenceHasta is { } h) q = q.Where(c => c.FechaFin is { } f && f <= h);
        return q.OrderBy(c => c.Tipo).ThenBy(c => c.FechaFin);
    }

    private IEnumerable<IGrouping<string, ContratoServicioDto>> AgruparContratos(IEnumerable<ContratoServicioDto> lst) =>
        _cAgrupar switch
        {
            "tipo"    => lst.GroupBy(c => TipoLabel(c.Tipo)).OrderBy(g => g.Key),
            "tercero" => lst.GroupBy(c => string.IsNullOrWhiteSpace(c.Proveedor) ? "(sin proveedor)" : c.Proveedor).OrderBy(g => g.Key),
            "estado"  => lst.GroupBy(c => EstadoTextoContrato(c)).OrderBy(g => g.Key),
            _ => lst.GroupBy(_ => "")
        };

    private static string EstadoTextoContrato(ContratoServicioDto c) =>
        c.Estado == EstadoContrato.Vencido ? "Vencido"
        : c.AlertaVencimiento ? "Por vencer"
        : c.Estado == EstadoContrato.EnRenovacion ? "En renovacion"
        : "Vigente";

