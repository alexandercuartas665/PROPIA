    // ---- OCR: cargar recibo y prefilar valor/periodo con el proveedor configurado en SuperAdmin ----
    private bool _ocrBusy;
    private string? _ocrMsg; private string _ocrMsgCls = "ok";

    private async Task SubirReciboOcr(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _ocrBusy = true; _ocrMsg = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(15 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
            content.Add(fileContent, "file", file.Name);
            var resp = await Auth().PostAsync("/api/ocr/extraer", content);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadFromJsonAsync<OcrError>();
                _ocrMsg = "No se pudo leer el recibo: " + (err?.Error ?? resp.StatusCode.ToString()); _ocrMsgCls = "err";
                return;
            }
            var r = await resp.Content.ReadFromJsonAsync<OcrResp>();
            if (r is not null)
            {
                var algo = false;
                if (r.ValorSugerido is { } val && val > 0) { _fr.Valor = val; algo = true; }
                if (!string.IsNullOrEmpty(r.FechaSugerida) && DateTime.TryParse(r.FechaSugerida, out var d)) { _fr.Anio = d.Year; _fr.Mes = d.Month; algo = true; }
                _ocrMsg = algo
                    ? "Datos extraidos. Revisa y confirma el registro."
                    : "Recibo leido, pero el OCR no detecto valor/fecha. Usa 'Analizar con el Agente Documental' o ingresa los datos a mano.";
                _ocrMsgCls = algo ? "ok" : "err";
            }
        }
        catch (Exception ex) { _ocrMsg = "Error leyendo el recibo: " + ex.Message; _ocrMsgCls = "err"; }
        finally { _ocrBusy = false; }
    }

    // ---- Agente Documental: OCR + IA que clasifica y propone el registro via MCP ----
    private bool _agenteBusy;
    private string? _agenteAnalisis;
    private bool _agenteConfirmado;
    private List<TurnoDto>? _agenteConv;

    private async Task AnalizarReciboAgente(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _agenteBusy = true; _agenteAnalisis = null; _agenteConv = null; _agenteConfirmado = false;
        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(15 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
            content.Add(fileContent, "file", file.Name);
            var resp = await Auth().PostAsync("/api/ocr/analizar", content);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadFromJsonAsync<OcrError>();
                _agenteAnalisis = "No se pudo analizar: " + (err?.Error ?? resp.StatusCode.ToString());
                return;
            }
            var r = await resp.Content.ReadFromJsonAsync<AnalisisResp>();
            _agenteAnalisis = string.IsNullOrWhiteSpace(r?.Analisis) ? "(El agente no devolvio analisis.)" : r!.Analisis;
            _agenteConv = r?.Conversacion;
        }
        catch (Exception ex) { _agenteAnalisis = "Error analizando con el agente: " + ex.Message; }
        finally { _agenteBusy = false; }
    }

    /// <summary>Confirma la propuesta: el agente ejecuta las tools MCP con dryRun=false y se refresca la lista.</summary>
    private async Task ConfirmarAgenteAsync()
    {
        if (_agenteConv is null) return;
        _agenteBusy = true;
        try
        {
            var body = new { conversacion = _agenteConv, mensaje = (string?)null };
            var resp = await Auth().PostAsJsonAsync("/api/ocr/analizar/continuar", body);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadFromJsonAsync<OcrError>();
                _agenteAnalisis += "\n\n[Error al confirmar: " + (err?.Error ?? resp.StatusCode.ToString()) + "]";
                return;
            }
            var r = await resp.Content.ReadFromJsonAsync<AnalisisResp>();
            _agenteAnalisis = string.IsNullOrWhiteSpace(r?.Analisis) ? _agenteAnalisis : r!.Analisis;
            _agenteConfirmado = true;
            await IrPublicos(); // refrescar cuentas + detalle con lo recien registrado
        }
        catch (Exception ex) { _agenteAnalisis += "\n\n[Error al confirmar: " + ex.Message + "]"; }
        finally { _agenteBusy = false; }
    }

