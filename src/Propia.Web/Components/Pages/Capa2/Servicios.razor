    private async Task IrPublicos()
    {
        _srvTab = "publicos";
        if (_spLoaded) return;
        await CargarSpAsync();
    }

    private async Task CargarSpAsync()
    {
        try
        {
            _spResumen = await GetAuthAsync<ServiciosPublicosResumenDto>("/api/servicios-publicos/resumen");
            _spCuentas = await GetAuthAsync<List<CuentaServicioDto>>("/api/servicios-publicos/cuentas") ?? new();
            _spLoaded = true;
            if (_spCuentas.Count > 0 && _spSel is null) await SeleccionarCuentaAsync(_spCuentas[0].Id);
            else if (_spSel is { } id && _spCuentas.Any(c => c.Id == id)) await SeleccionarCuentaAsync(id);
            else { _spSel = null; _spDetalle = null; }
        }
        catch (SesionRedirigidaException) { /* sesion expirada: redirigiendo a /login */ }
        catch { _spCuentas = new(); }
    }

    private async Task SeleccionarCuentaAsync(Guid id)
    {
        _spSel = id;
        try { _spDetalle = await GetAuthAsync<CuentaServicioDetalleDto>($"/api/servicios-publicos/cuentas/{id}"); }
        catch (SesionRedirigidaException) { }
        catch { _spDetalle = null; }
    }

    private void AbrirNuevaCuenta() { _fc = new(); _spError = null; _spCuentaModal = true; }
    private async Task GuardarCuentaAsync()
    {
        _busy = true; _spError = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/servicios-publicos/cuentas",
                new CrearCuentaServicioRequest(_fc.Tipo, _fc.Alias, _fc.Prestador ?? "", _fc.NumeroCuenta, _fc.MetodoPago, _fc.Unidad, _fc.Umbral));
            if (!resp.IsSuccessStatusCode) { _spError = await resp.Content.ReadAsStringAsync(); return; }
            var nueva = await resp.Content.ReadFromJsonAsync<CuentaServicioDto>();
            _spCuentaModal = false;
            await CargarSpAsync();
            if (nueva is not null) await SeleccionarCuentaAsync(nueva.Id);
        }
        finally { _busy = false; }
    }

