    // ---- Edicion inline de la tabla de contratos (Fase B, estilo Directorio/Excel) ----
    // La celda muestra el valor; al hacer click se vuelve input/select y guarda en @onblur/Enter.
    private string? _cEditKey;      // "{id}:{campo}" de la celda en edicion
    private string _cEditVal = "";  // valor temporal
    private bool _cEditBusy;

    private bool CEnEd(Guid id, string campo) => _cEditKey == id + ":" + campo;
    private void IniciarCEd(Guid id, string campo, string? actual) { _cEditKey = id + ":" + campo; _cEditVal = actual ?? ""; }
    private void CancelarCEd() { _cEditKey = null; _cEditVal = ""; }

    // Un <select> guarda apenas cambia (no espera al blur).
    private Task CSelChange(ContratoServicioDto c, string campo, ChangeEventArgs e)
    {
        _cEditVal = e.Value?.ToString() ?? "";
        return GuardarCEd(c, campo);
    }

    private async Task CEdKeydown(KeyboardEventArgs e, ContratoServicioDto c, string campo)
    {
        if (e.Key == "Enter") await GuardarCEd(c, campo);
        else if (e.Key == "Escape") { CancelarCEd(); StateHasChanged(); }
    }

    // Construye el PUT preservando TODOS los valores actuales (MERGE) y cambiando solo 'campo'.
    // ActualizarVinculos queda false: la edicion inline nunca toca servicio/expediente/proyecto.
    private async Task GuardarCEd(ContratoServicioDto c, string campo)
    {
        if (_cEditKey != c.Id + ":" + campo || _cEditBusy) return;
        _cEditBusy = true;
        try
        {
            var tipo = c.Tipo;
            var prov = c.Proveedor;
            string? nit = c.NitProveedor;   // null => MERGE lo conserva
            var ini = c.FechaInicio;
            var fin = c.FechaFin;
            var valor = c.ValorMensual;
            var estado = c.Estado == EstadoContrato.Vencido ? EstadoContrato.Vigente : c.Estado;
            string? contacto = c.Contacto;   // null => MERGE lo conserva
            int dias = c.DiasAnticipacionAlerta;
            string? obs = null;              // null => MERGE conserva observaciones
            var val = _cEditVal.Trim();

            switch (campo)
            {
                case "prov":
                    if (string.IsNullOrWhiteSpace(val)) { CancelarCEd(); return; }
                    prov = val; break;
                case "nit":
                    nit = string.IsNullOrWhiteSpace(val) ? "" : val;   // "" limpia el NIT
                    break;
                case "tipo":
                    if (Enum.TryParse<TipoServicio>(val, out var tp)) tipo = tp; break;
                case "inicio":
                    if (DateOnly.TryParse(val, out var di)) ini = di; break;
                case "fin":
                    if (DateOnly.TryParse(val, out var dfn)) fin = dfn; break;   // vaciar no borra (limitacion MERGE)
                case "valor":
                    if (decimal.TryParse(val, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var dv)) valor = dv;
                    break;
                case "estado":
                    if (Enum.TryParse<EstadoContrato>(val, out var es)) estado = es; break;
                case "contacto":
                    contacto = string.IsNullOrWhiteSpace(val) ? "" : val; break;   // "" limpia
                case "dias":
                    if (int.TryParse(val, out var dd)) dias = dd < 0 ? 0 : dd; break;
                case "obs":
                    obs = string.IsNullOrWhiteSpace(val) ? "" : val; break;   // "" limpia
            }
            CancelarCEd();
            var req = new ActualizarContratoRequest(
                estado, dias <= 0 ? 30 : dias,
                Tipo: tipo, Proveedor: prov, NitProveedor: nit,
                Contacto: contacto, FechaInicio: ini, FechaFin: fin,
                ValorMensual: valor, Observaciones: obs);
            await Auth().PutAsJsonAsync($"/api/mi-copropiedad/contratos/{c.Id}", req);
            await CargarAsync();   // estado/alerta se derivan de FechaFin -> recargar
            StateHasChanged();
        }
        finally { _cEditBusy = false; }
    }

