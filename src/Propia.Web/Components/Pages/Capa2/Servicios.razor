    .sp-ocr-msg { margin-top: 8px; font-size: 12px; font-weight: 600; padding: 8px 11px; border-radius: 8px; }
    .sp-ocr-msg.ok { color: #15703F; background: #E7F6EE; }
    .sp-ocr-msg.err { color: #B3243C; background: #FDE7E7; }
    @@media (max-width: 1000px) { .sp-kpis { grid-template-columns: repeat(2,1fr); } .sp-grid { grid-template-columns: 1fr; } }
    .srv-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 18px; }
    @@media (max-width: 760px) { .srv-kpis { grid-template-columns: 1fr; } .srv-grid { grid-template-columns: 1fr !important; } }
    .srv-kpi { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; padding: 18px; box-shadow: 0 1px 2px rgba(45,62,80,.05); }
