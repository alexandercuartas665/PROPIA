@page "/servicios"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<PageTitle>Servicios y contratos - PROPIA</PageTitle>

@* Modulo 2.5 (Finanzas) "Servicios y contratos". Estilo prototipo PROPIA.dc.html:
   3 KPIs + proximos a vencer + lista de contratos + modal crear/detalle. API /api/mi-copropiedad/contratos. *@

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="srv-wrap">
    <div class="srv-head">
        <div>
            <h1 class="srv-title">Servicios y contratos</h1>
            <p class="srv-sub">Contratos estrategicos y servicios publicos de la copropiedad.</p>
        </div>
    </div>

    <div class="srv-tabs">
        <button class="srv-tab @(_srvTab == "contratos" ? "on" : "")" @onclick='() => _srvTab = "contratos"'>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z"/></svg>Contratos
        </button>
        <button class="srv-tab @(_srvTab == "publicos" ? "on" : "")" @onclick='() => _srvTab = "publicos"'>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z"/></svg>Servicios publicos
        </button>
    </div>

    @if (_srvTab == "contratos")
    {
        var porVencer = _contratos.Where(c => c.AlertaVencimiento).OrderBy(c => c.DiasParaVencer).ToList();

    <div class="srv-kpis">
        <div class="srv-kpi"><div class="srv-kpi-lbl">Total de contratos</div><div class="srv-kpi-val">@_contratos.Count</div></div>
        <div class="srv-kpi"><div class="srv-kpi-lbl">Vigentes</div><div class="srv-kpi-val ok">@_contratos.Count(c => c.Estado == EstadoContrato.Vigente)</div></div>
        <div class="srv-kpi danger"><div class="srv-kpi-lbl danger">Por vencer</div><div class="srv-kpi-val danger">@porVencer.Count</div></div>
    </div>

    @if (porVencer.Count > 0)
    {
        <div class="srv-alert">
            <div class="srv-alert-head"><i class="fi fi-rr-triangle-warning"></i> PROXIMOS A VENCER</div>
            <div class="srv-alert-list">
                @foreach (var c in porVencer)
                {
                    var cc = c;
                    <div class="srv-alert-row">
                        <div class="srv-row-ic danger">@TipoIcon(c.Tipo)</div>
                        <div class="srv-row-body"><div class="srv-row-name">@c.Proveedor</div><div class="srv-row-meta">@TipoLabel(c.Tipo)@(c.FechaFin is { } f ? " - vence " + f.ToString("dd MMM yyyy") : "")</div></div>
                        <span class="srv-dias">Vence en @c.DiasParaVencer dias</span>
                        @if (c.Estado != EstadoContrato.EnRenovacion) { <button class="srv-renovar" @onclick="() => RenovarAsync(cc)" disabled="@_busy">Renovar</button> }
                        else { <span class="srv-badge warn">En renovacion</span> }
                    </div>
                }
            </div>
        </div>
    }

    <div class="srv-card">
        <div class="srv-card-head">
            <span class="srv-card-title">Todos los contratos</span>
            <button class="srv-btn-primary" @onclick="() => AbrirModal(null)"><i class="fi fi-rr-plus"></i> Nuevo contrato</button>
        </div>
        <div class="srv-list">
            @if (_contratos.Count == 0)
            {
                <div class="srv-empty"><i class="fi fi-rr-shield"></i><div>Aun no hay contratos. Crea el primero con "Nuevo contrato".</div></div>
            }
            else
            {
                @foreach (var c in _contratos.OrderBy(x => x.Tipo).ThenBy(x => x.FechaFin))
                {
                    var cc = c;
                    <button class="srv-row" @onclick="() => AbrirModal(cc)">
                        <div class="srv-row-ic">@TipoIcon(c.Tipo)</div>
                        <div class="srv-row-body">
                            <div class="srv-row-name">@c.Proveedor</div>
                            <div class="srv-row-meta">@TipoLabel(c.Tipo)@(c.FechaInicio is var fi ? " - desde " + fi.ToString("dd MMM yyyy") : "")@(c.FechaFin is { } ff ? " - hasta " + ff.ToString("dd MMM yyyy") : "")@(c.ValorMensual is { } v ? " - $" + v.ToString("N0") + "/mes" : "")</div>
                        </div>
                        @if (c.Estado == EstadoContrato.Vencido) { <span class="srv-badge vencido">Vencido</span> }
                        else if (c.AlertaVencimiento) { <span class="srv-badge danger">Vence en @c.DiasParaVencer dias</span> }
                        else if (c.Estado == EstadoContrato.EnRenovacion) { <span class="srv-badge warn">En renovacion</span> }
                        else { <span class="srv-badge ok">Vigente</span> }
                        <span class="srv-del" @onclick:stopPropagation="true" @onclick="() => EliminarAsync(cc.Id)" title="Eliminar"><i class="fi fi-rr-trash"></i></span>
                    </button>
                }
            }
        </div>
    </div>
    }
    else
    {
        <div class="srv-pub-ph">
            <div class="srv-pub-ic"><i class="fi fi-rr-bolt"></i></div>
            <div class="srv-pub-t">Servicios publicos &middot; 2.17</div>
            <div class="srv-pub-s">Control de cuentas de servicio (energia, acueducto, gas, internet, aseo), seguimiento de consumo por periodo con alertas de desviacion, carga de recibos con IA y reclamaciones ante el prestador.</div>
            <div class="srv-pub-tag">Disponible proximamente</div>
        </div>
    }
</div>

@* ===== Modal crear / detalle de contrato ===== *@
@if (_showModal)
{
    <div class="srv-ov" @onclick="() => _showModal = false"></div>
    <div class="srv-modal">
        <div class="srv-modal-head">
            <div class="srv-modal-ic"><i class="fi fi-rr-shield"></i></div>
            <div style="flex:1;min-width:0;">
                <div class="srv-modal-title">@(_editId is null ? "Nuevo contrato" : "Detalle del contrato")</div>
                <div class="srv-sub" style="margin:2px 0 0;">Datos del contrato y su vigencia.</div>
            </div>
            <button class="srv-x" @onclick="() => _showModal = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="srv-modal-body">
            <div class="srv-grid">
                <div class="srv-col-full">
                    <label class="srv-lbl">Nombre del contrato / servicio *</label>
                    <input class="srv-input" @bind="_f.Proveedor" @bind:event="oninput" placeholder="Ej. Vigilancia Andina S.A." />
                </div>
                <div>
                    <label class="srv-lbl">Tipo de servicio</label>
                    <select class="srv-input" @bind="_f.Tipo">
                        @foreach (var t in Enum.GetValues<TipoServicio>()) { <option value="@t">@TipoLabel(t)</option> }
                    </select>
                </div>
                <div>
                    <label class="srv-lbl">Proveedor / NIT</label>
                    <input class="srv-input" @bind="_f.Nit" @bind:event="oninput" placeholder="NIT o razon social" />
                </div>
                <div>
                    <label class="srv-lbl">Contacto</label>
                    <input class="srv-input" @bind="_f.Contacto" @bind:event="oninput" placeholder="Telefono / email" />
                </div>
                <div>
                    <label class="srv-lbl">Valor mensual (COP)</label>
                    <input class="srv-input" type="number" step="any" @bind="_f.Valor" placeholder="0" />
                </div>
                <div>
                    <label class="srv-lbl">Fecha de inicio</label>
                    <input class="srv-input" type="date" @bind="_f.Inicio" />
                </div>
                <div>
                    <label class="srv-lbl">Fecha de finalizacion</label>
                    <input class="srv-input" type="date" @bind="_f.Fin" />
                </div>
                <div>
                    <label class="srv-lbl">Dias de alerta antes de vencer</label>
                    <input class="srv-input" type="number" @bind="_f.Dias" />
                </div>
                @if (_editId is not null)
                {
                    <div>
                        <label class="srv-lbl">Estado</label>
                        <select class="srv-input" @bind="_f.Estado">
                            <option value="@EstadoContrato.Vigente">Vigente</option>
                            <option value="@EstadoContrato.EnRenovacion">En renovacion</option>
                        </select>
                    </div>
                }
                <div class="srv-col-full">
                    <label class="srv-lbl">Observaciones</label>
                    <textarea class="srv-input" rows="2" @bind="_f.Observaciones" @bind:event="oninput" placeholder="Ej. Renovacion automatica con 30 dias de aviso."></textarea>
                </div>
            </div>
            @if (_modalError is not null) { <div class="srv-banner err">@_modalError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="srv-btn-ghost" @onclick="() => _showModal = false">Cancelar</button>
                <button class="srv-btn-primary" @onclick="GuardarAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_f.Proveedor))"><i class="fi fi-rr-check"></i> @(_editId is null ? "Crear contrato" : "Guardar contrato")</button>
            </div>
        </div>
    </div>
}
}

<style>
    .srv-wrap { width: 100%; max-width: 1900px; margin: 0 auto; padding: 6px 28px 60px; box-sizing: border-box; font-family: 'Lexend', sans-serif; }
    .srv-head { margin-bottom: 18px; }
    .srv-title { font-size: 27px; font-weight: 800; letter-spacing: -.6px; color: #1B2A3A; margin: 0; }
    .srv-sub { font-size: 14px; color: #7C98B6; margin: 4px 0 0; }

    /* Pestanas Contratos / Servicios publicos (prototipo v2) */
    .srv-tabs { display: flex; gap: 7px; margin-bottom: 20px; border-bottom: 1px solid #E1E8EE; }
    .srv-tab { display: flex; align-items: center; gap: 7px; padding: 10px 16px; font-size: 13px; font-weight: 700; color: #7C98B6; background: transparent; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer; font-family: inherit; }
    .srv-tab:hover { color: var(--propia-brand, #6D4FE3); }
    .srv-tab.on { color: var(--propia-brand, #6D4FE3); border-bottom-color: var(--propia-brand, #6D4FE3); }

    /* Placeholder Servicios publicos 2.17 */
    .srv-pub-ph { background: #fff; border: 1px dashed #D7E0EA; border-radius: 16px; padding: 48px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .srv-pub-ic { width: 56px; height: 56px; border-radius: 15px; background: #F1ECFD; color: var(--propia-brand, #6D4FE3); display: flex; align-items: center; justify-content: center; font-size: 26px; }
    .srv-pub-t { font-size: 17px; font-weight: 800; color: #1B2A3A; }
    .srv-pub-s { font-size: 13px; color: #7C98B6; max-width: 560px; line-height: 1.55; }
    .srv-pub-tag { font-size: 11.5px; font-weight: 700; color: var(--propia-brand, #6D4FE3); background: #F1ECFD; border: 1px solid #DCD2F8; padding: 5px 13px; border-radius: 20px; margin-top: 4px; }
    .srv-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 18px; }
    @@media (max-width: 760px) { .srv-kpis { grid-template-columns: 1fr; } .srv-grid { grid-template-columns: 1fr !important; } }
    .srv-kpi { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; padding: 18px; box-shadow: 0 1px 2px rgba(45,62,80,.05); }
    .srv-kpi.danger { background: #FFF5F5; border-color: #FBD5D5; }
    .srv-kpi-lbl { font-size: 12px; font-weight: 700; color: #7C98B6; }
    .srv-kpi-lbl.danger { color: #C0383C; }
    .srv-kpi-val { font-size: 30px; font-weight: 800; letter-spacing: -1px; color: #1B2A3A; margin-top: 5px; }
    .srv-kpi-val.ok { color: #1A8754; }
    .srv-kpi-val.danger { color: #C0383C; }

    .srv-alert { background: #FFF5F5; border: 1px solid #FBD5D5; border-radius: 14px; padding: 16px 18px; margin-bottom: 18px; }
    .srv-alert-head { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: .4px; color: #C0383C; margin-bottom: 12px; }
    .srv-alert-list { display: flex; flex-direction: column; gap: 8px; }
    .srv-alert-row { display: flex; align-items: center; gap: 13px; background: #fff; border: 1px solid #FBD5D5; border-radius: 10px; padding: 11px 14px; }
    .srv-dias { font-size: 11px; font-weight: 700; color: #C0383C; background: #FDE7E7; padding: 4px 10px; border-radius: 7px; white-space: nowrap; }
    .srv-renovar { font-size: 11px; font-weight: 700; color: #6D4FE3; background: #F1ECFD; border: 1px solid #DCD2F8; padding: 5px 11px; border-radius: 7px; white-space: nowrap; cursor: pointer; }
    .srv-renovar:hover:not(:disabled) { background: #E6DEFA; }

    .srv-card { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; box-shadow: 0 1px 2px rgba(45,62,80,.05); overflow: hidden; }
    .srv-card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid #EEF3F8; }
    .srv-card-title { font-size: 14px; font-weight: 700; color: #1B2A3A; }
    .srv-btn-primary { display: inline-flex; align-items: center; gap: 7px; border: 0; background: var(--propia-primary, #6D4FE3); color: #fff; font-weight: 700; font-size: 13px; padding: 9px 15px; border-radius: 9px; cursor: pointer; box-shadow: 0 4px 12px rgba(109,79,227,.28); }
