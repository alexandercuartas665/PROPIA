    // ----- Alertas del servicio -----
    private async Task AgregarAlertaServicioAsync()
    {
        if (_srvEditId is not { } sid) return;
        if (string.IsNullOrWhiteSpace(_alTitulo)) return;
        _busy = true; _srvError = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/servicios/{sid}/alertas",
                new AgregarAlertaServicioRequest(_alTitulo.Trim(), string.IsNullOrWhiteSpace(_alDescripcion) ? null : _alDescripcion.Trim(), _alSeveridad));
            if (!resp.IsSuccessStatusCode) { _srvError = await ReadErr(resp); return; }
            _alTitulo = ""; _alDescripcion = ""; _alSeveridad = SeveridadAlerta.Advertencia;
            await CargarServicioDetalleAsync(sid);
