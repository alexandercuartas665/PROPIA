        finally { _busy = false; }
    }

    private static string SevCls(SeveridadAlerta s) => s switch
    {
        SeveridadAlerta.Critica => "danger",
        SeveridadAlerta.Advertencia => "warn",
        _ => "ok"
    };

    // ----- Helpers -----
    private static Guid? ParseG(string? s) => Guid.TryParse(s, out var g) ? g : (Guid?)null;
    private static string FmtBytes(long b) => b < 1024 ? $"{b} B" : b < 1024 * 1024 ? $"{b / 1024.0:0.#} KB" : $"{b / 1024.0 / 1024.0:0.#} MB";

    private static async Task<string> ToBase64(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(20L * 1024 * 1024).CopyToAsync(ms);
        return Convert.ToBase64String(ms.ToArray());
    }

    private static async Task<string> ReadErr(HttpResponseMessage resp)
    {
        try { var e = await resp.Content.ReadFromJsonAsync<ErrResp>(); return e?.Error ?? resp.StatusCode.ToString(); }
        catch { return resp.StatusCode.ToString(); }
    }
    private sealed record ErrResp(string? Error);
    private sealed record CreatedId(Guid Id);

    // Panel de busqueda/alta de tercero (compartido por ejecutor y contacto).
    private RenderFragment PickerPanel() => @<div class="svc-picker">
        <input class="srv-input" placeholder="Buscar por nombre, documento o NIT..." value="@_tQuery" @oninput="OnPickerQuery" />
        @if (!_tCreating)
        {
            <div class="svc-picker-results">
                @foreach (var p in _tPersonas)
                {
                    var pp = p; var nombre = (p.Nombres + " " + p.Apellidos).Trim();
                    <button class="svc-picker-item" @onclick="() => PickTercero(pp.Id, null, nombre)"><i class="fi fi-rr-user"></i> @nombre <span class="svc-mini">@p.Documento</span></button>
                }
                @foreach (var em in _tEmpresas)
                {
                    var ee = em;
                    <button class="svc-picker-item" @onclick="() => PickTercero(null, ee.Id, ee.RazonSocial)"><i class="fi fi-rr-building"></i> @em.RazonSocial <span class="svc-mini">NIT @em.Nit</span></button>
                }
                @if (_tQuery.Trim().Length >= 2 && _tPersonas.Count == 0 && _tEmpresas.Count == 0)
                {
                    <div class="svc-picker-empty">Sin resultados. Crea un tercero nuevo.</div>
                }
            </div>
            <button class="svc-picker-create" @onclick="() => _tCreating = true"><i class="fi fi-rr-plus"></i> Crear nuevo tercero</button>
        }
        else
        {
            <div class="svc-picker-new">
                <div class="svc-kind">
                    <label><input type="radio" name="tkind" checked="@(_tNewKind == 0)" @onchange="() => _tNewKind = 0" /> Persona</label>
                    <label><input type="radio" name="tkind" checked="@(_tNewKind == 1)" @onchange="() => _tNewKind = 1" /> Empresa</label>
                </div>
                @if (_tNewKind == 0)
                {
                    <input class="srv-input sm" @bind="_tNewDoc" placeholder="Documento *" />
                    <input class="srv-input sm" @bind="_tNewNombres" placeholder="Nombres *" />
                    <input class="srv-input sm" @bind="_tNewApellidos" placeholder="Apellidos" />
                }
                else
                {
                    <input class="srv-input sm" @bind="_tNewNit" placeholder="NIT *" />
                    <input class="srv-input sm" @bind="_tNewRazon" placeholder="Razon social *" />
                }
                <div class="d-flex gap-2 mt-2">
                    <button class="srv-btn-ghost sm" @onclick="() => _tCreating = false">Volver</button>
                    <button class="srv-btn-primary sm" @onclick="CrearTerceroYSeleccionarAsync">Crear y seleccionar</button>
                </div>
            </div>
        }
    </div>;

    // ===================== Programador de tareas (vencimiento de contrato) =====================
    private bool _progDataLoaded;
    private List<TableroOpcion> _tablerosProg = new();
    private List<PersonaOpcion> _personasProg = new();

    private sealed record TableroLite(Guid Id, string Nombre);

    private async Task CargarProgramadorDataAsync()
    {
        if (_progDataLoaded) return;
        try
        {
            var tbs = await Auth().GetFromJsonAsync<List<TableroLite>>("/api/tareas/tableros") ?? new();
            _tablerosProg = tbs.Select(t => new TableroOpcion { Id = t.Id, Nombre = t.Nombre }).ToList();
        }
        catch { _tablerosProg = new(); }
        try
        {
            var ps = await Auth().GetFromJsonAsync<List<PersonaResumenDto>>("/api/directorio/personas") ?? new();
            _personasProg = ps.Select(p => new PersonaOpcion { Id = p.Id, Nombre = (p.Nombres + " " + p.Apellidos).Trim() })
                .Where(p => !string.IsNullOrWhiteSpace(p.Nombre)).ToList();
        }
        catch { _personasProg = new(); }
        _progDataLoaded = true;
    }

    private async Task AbrirProgramadorContrato()
    {
        if (_editId is not { } cid) return;
        await CargarProgramadorDataAsync();

        var dias = _f.Dias <= 0 ? 30 : _f.Dias;
        DateOnly fechaEjec;
        if (_f.Fin.HasValue) fechaEjec = DateOnly.FromDateTime(_f.Fin.Value).AddDays(-dias);
        else fechaEjec = DateOnly.FromDateTime(DateTime.Today);
        var prov = string.IsNullOrWhiteSpace(_f.Proveedor) ? "contrato" : _f.Proveedor.Trim();

        _showModal = false; // cerrar el modal de contrato para que el programador quede al frente

        var pars = new ModalParameters()
            .Set("Tableros", _tablerosProg)
            .Set("Personas", _personasProg)
            .Set("PrefillTitulo", $"Renovar contrato: {prov}")
            .Set("PrefillDescripcion", $"Vencimiento del contrato con {prov}. Revisar renovacion o nuevo proceso.")
            .Set("PrefillFecha", (DateOnly?)fechaEjec)
            .Set("PrefillPeriodicidad", PeriodicidadProgramacion.Unica)
            .Set("ModuloOrigenCodigo", "contrato")
            .Set("EntidadOrigenId", (Guid?)cid)
            .Set("OrigenReferencia", prov);

        var req = await Modals.OpenAsync<ProgramadorTareaModal, CrearProgramacionRequest>(pars, new ModalOptions { Width = "580px" });
        if (req is null) return;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/programaciones", req);
            if (resp.IsSuccessStatusCode)
                await Js.InvokeVoidAsync("alert", "Tarea programada para el vencimiento del contrato.");
            else
                await Js.InvokeVoidAsync("alert", "No se pudo programar la tarea: " + await ReadErr(resp));
        }
        catch (Exception ex) { await Js.InvokeVoidAsync("alert", "Error programando la tarea: " + ex.Message); }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    // GET con manejo centralizado de 401: si la sesion expiro, intenta refresh sliding (y reintenta)
    // o redirige a /login en vez de tragarse el error y mostrar el modulo vacio. Lanza
    // SesionRedirigidaException cuando ya se esta redirigiendo, para que el llamador no siga.
    private sealed class SesionRedirigidaException : Exception { }

    private async Task<T?> GetAuthAsync<T>(string url)
    {
        var resp = await Auth().GetAsync(url);
        if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            var nuevo = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
            if (string.IsNullOrEmpty(nuevo)) throw new SesionRedirigidaException(); // redirigiendo a /login
            _jwt = nuevo;
            resp = await Auth().GetAsync(url);
        }
        resp.EnsureSuccessStatusCode();
        return await resp.Content.ReadFromJsonAsync<T>();
    }
}
