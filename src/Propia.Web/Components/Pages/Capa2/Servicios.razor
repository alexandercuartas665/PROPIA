    private async Task GuardarAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_f.Proveedor)) { _modalError = "El contratista es obligatorio."; return; }
        _busy = true;
        try
        {
            var inicio = DateOnly.FromDateTime(_f.Inicio ?? DateTime.Today);
            DateOnly? fin = _f.Fin.HasValue ? DateOnly.FromDateTime(_f.Fin.Value) : null;
            // "Asociado a": solo se guarda el tipo si hay un elemento elegido.
            Guid? asocId = ParseG(_f.AsociadoId);
            TipoActivoMantenimiento? asocTipo = asocId.HasValue ? _f.AsociadoTipo : null;
            HttpResponseMessage resp;
            if (_editId is null)
            {
                resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/contratos",
                    new CrearContratoServicioRequest(_f.Tipo, _f.Proveedor.Trim(), Limpio(_f.Nit), Limpio(_f.Contacto),
                        inicio, fin, _f.Valor, Limpio(_f.Observaciones), _f.Dias <= 0 ? 30 : _f.Dias,
                        _f.RenovacionAutomatica, ParseG(_f.ServicioId), ParseG(_f.ExpedienteId), ParseG(_f.ProyectoId),
                        ProveedorPersonaId: _f.ProveedorPersonaId, ProveedorEmpresaId: _f.ProveedorEmpresaId,
                        NumeroContrato: Limpio(_f.NumeroContrato), TipoContrato: _f.TipoContrato, Categoria: _f.Categoria,
                        ValorTotal: _f.ValorTotal, FormaPagoCuotas: _f.FormaPagoCuotas, PagoMensual: _f.PagoMensual,
                        AsociadoTipo: asocTipo, AsociadoId: asocId));
            }
            else
            {
                resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/contratos/{_editId}",
                    new ActualizarContratoRequest(_f.Estado, _f.Dias <= 0 ? 30 : _f.Dias, _f.Tipo, _f.Proveedor.Trim(),
                        Limpio(_f.Nit) ?? "", Limpio(_f.Contacto) ?? "", inicio, fin, _f.Valor, Limpio(_f.Observaciones) ?? "",
                        true, _f.RenovacionAutomatica, ParseG(_f.ServicioId), ParseG(_f.ExpedienteId), ParseG(_f.ProyectoId),
                        NumeroContrato: Limpio(_f.NumeroContrato) ?? "", TipoContrato: _f.TipoContrato, Categoria: _f.Categoria,
                        ValorTotal: _f.ValorTotal, FormaPagoCuotas: _f.FormaPagoCuotas, PagoMensual: _f.PagoMensual,
                        AsociadoTipo: asocTipo, AsociadoId: asocId, LimpiarAsociado: asocId is null,
                        ProveedorPersonaId: _f.ProveedorPersonaId, ProveedorEmpresaId: _f.ProveedorEmpresaId));
            }
            if (!resp.IsSuccessStatusCode) { _modalError = await resp.Content.ReadAsStringAsync(); return; }
            _showModal = false;
            await CargarAsync();
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _busy = false; }
    }

