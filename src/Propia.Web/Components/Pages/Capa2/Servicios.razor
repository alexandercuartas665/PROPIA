        {
            var resp = await Auth().PostAsJsonAsync($"/api/servicios-publicos/cuentas/{cid}/reclamaciones",
                new CrearReclamacionRequest(_frc.Motivo, _frc.Radicado, _frc.Descripcion));
            if (!resp.IsSuccessStatusCode) { _spError = await resp.Content.ReadAsStringAsync(); return; }
            _spReclModal = false;
            await SeleccionarCuentaAsync(cid);
            _spResumen = await Auth().GetFromJsonAsync<ServiciosPublicosResumenDto>("/api/servicios-publicos/resumen");
        }
        finally { _busy = false; }
    }

