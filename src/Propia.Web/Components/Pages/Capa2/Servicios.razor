@* Host de modales globales (programador de tareas). Vive aqui por boundary de render mode. *@
<ModalHost />

<style>
    .srv-wrap { width: 100%; max-width: 1900px; margin: 0 auto; padding: 6px 28px 60px; box-sizing: border-box; font-family: 'Lexend', sans-serif; }
    .srv-head { margin-bottom: 18px; }
    .srv-title { font-size: 27px; font-weight: 800; letter-spacing: -.6px; color: #1B2A3A; margin: 0; }
    .srv-sub { font-size: 14px; color: #7C98B6; margin: 4px 0 0; }

    /* Pestanas Contratos / Servicios publicos (prototipo v2) */
    .srv-tabs { display: flex; gap: 7px; margin-bottom: 20px; border-bottom: 1px solid #E1E8EE; }
    .srv-tab { display: flex; align-items: center; gap: 7px; padding: 10px 16px; font-size: 13px; font-weight: 700; color: #7C98B6; background: transparent; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer; font-family: inherit; }
    .srv-tab:hover { color: var(--propia-brand, #6D4FE3); }
    .srv-tab.on { color: var(--propia-brand, #6D4FE3); border-bottom-color: var(--propia-brand, #6D4FE3); }

    /* Servicios publicos 2.17 */
    .sp-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
    .sp-kpi { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; padding: 16px 18px; box-shadow: 0 1px 2px rgba(45,62,80,.05); }
    .sp-kpi.danger { background: #FFF5F5; border-color: #FBD5D5; }
    .sp-kpi-l { font-size: 11.5px; font-weight: 700; color: #7C98B6; }
    .sp-kpi-l.danger { color: #C0383C; }
    .sp-kpi-v { font-size: 23px; font-weight: 800; color: #1B2A3A; letter-spacing: -.6px; margin-top: 5px; }
    .sp-kpi-v.danger { color: #C0383C; }

