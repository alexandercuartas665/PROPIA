    .sp-empty-sm { padding: 24px; border: 0; }
    .sp-ocr { margin-bottom: 14px; }
    .sp-ocr-up { display: flex; align-items: center; gap: 9px; padding: 12px 14px; border: 1.5px dashed #DCD2F8; border-radius: 11px; background: #FBFAFE; color: #6D4FE3; font-size: 12.5px; font-weight: 700; cursor: pointer; }
