    // ===================== Servicios: modal + CRUD =====================
    private async Task AbrirServicioModal(ServicioDto? s)
    {
        _srvError = null; _tTarget = ""; _co = new(); _asociarContratoId = "";
        if (s is null)
        {
            _srvEditId = null; _srvDetalle = null; _sf = new ServicioForm();
        }
        else
        {
            _srvEditId = s.Id;
            _sf = new ServicioForm
            {
                Tipo = s.Tipo, Nombre = s.Nombre, Descripcion = s.Descripcion,
                EjecutorPersonaId = s.EjecutorPersonaId, EjecutorEmpresaId = s.EjecutorEmpresaId, EjecutorNombre = s.EjecutorNombre,
                CostoMensual = s.CostoMensual, CostoAnual = s.CostoAnual, Estado = s.Estado
            };
            await CargarServicioDetalleAsync(s.Id);
        }
        _showSrvModal = true;
    }

    private void CerrarServicioModal() { _showSrvModal = false; _tTarget = ""; }

    private async Task CargarServicioDetalleAsync(Guid id)
    {
        try { _srvDetalle = await Auth().GetFromJsonAsync<ServicioDetalleDto>($"/api/servicios/{id}"); }
        catch { _srvDetalle = null; }
    }

    private async Task GuardarServicioAsync()
    {
        if (string.IsNullOrWhiteSpace(_sf.Nombre)) { _srvError = "El nombre del servicio es obligatorio."; return; }
        _busy = true; _srvError = null;
        try
        {
            if (_srvEditId is null)
            {
                var resp = await Auth().PostAsJsonAsync("/api/servicios",
                    new CrearServicioRequest(_sf.Tipo, _sf.Nombre.Trim(), Limpio(_sf.Descripcion),
                        _sf.EjecutorPersonaId, _sf.EjecutorEmpresaId, Limpio(_sf.EjecutorNombre), _sf.CostoMensual, _sf.CostoAnual));
                if (!resp.IsSuccessStatusCode) { _srvError = await ReadErr(resp); return; }
                var nuevo = await resp.Content.ReadFromJsonAsync<ServicioDto>();
                await CargarAsync();
                if (nuevo is not null) { _srvEditId = nuevo.Id; await CargarServicioDetalleAsync(nuevo.Id); }
            }
            else
            {
                var resp = await Auth().PutAsJsonAsync($"/api/servicios/{_srvEditId}",
                    new ActualizarServicioRequest(_sf.Tipo, _sf.Nombre.Trim(), Limpio(_sf.Descripcion),
                        _sf.EjecutorPersonaId, _sf.EjecutorEmpresaId, Limpio(_sf.EjecutorNombre), _sf.CostoMensual, _sf.CostoAnual, _sf.Estado));
                if (!resp.IsSuccessStatusCode) { _srvError = await ReadErr(resp); return; }
                await CargarAsync();
                await CargarServicioDetalleAsync(_srvEditId.Value);
            }
        }
        catch (Exception ex) { _srvError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarServicioAsync(Guid id)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Eliminar este servicio? Los contratos quedaran sin servicio asignado.")) return;
        _busy = true;
        try { await Auth().DeleteAsync($"/api/servicios/{id}"); await CargarAsync(); }
        finally { _busy = false; }
    }

    // ----- Picker de tercero (Directorio) -----
    private void AbrirPicker(string target)
    {
        _tTarget = target; _tQuery = ""; _tPersonas = new(); _tEmpresas = new();
        _tCreating = false; _tNewKind = 0; _tNewDoc = _tNewNombres = _tNewApellidos = _tNewNit = _tNewRazon = "";
    }

    private async Task OnPickerQuery(ChangeEventArgs e)
    {
        _tQuery = e.Value?.ToString() ?? "";
        await BuscarTerceros();
    }

    private async Task BuscarTerceros()
    {
        var q = _tQuery.Trim();
        if (q.Length < 2) { _tPersonas = new(); _tEmpresas = new(); return; }
        try { _tPersonas = await Auth().GetFromJsonAsync<List<PersonaResumenDto>>($"/api/directorio/personas?q={Uri.EscapeDataString(q)}") ?? new(); }
        catch { _tPersonas = new(); }
        try { _tEmpresas = await Auth().GetFromJsonAsync<List<EmpresaResumenDto>>($"/api/directorio/empresas?q={Uri.EscapeDataString(q)}") ?? new(); }
        catch { _tEmpresas = new(); }
    }

    private void PickTercero(Guid? personaId, Guid? empresaId, string nombre)
    {
        if (_tTarget == "ejecutor")
        {
            _sf.EjecutorPersonaId = personaId; _sf.EjecutorEmpresaId = empresaId; _sf.EjecutorNombre = nombre;
        }
        else if (_tTarget == "contacto")
        {
            _co.PersonaId = personaId; _co.EmpresaId = empresaId; _co.Nombre = nombre;
        }
        _tTarget = "";
    }

    private async Task CrearTerceroYSeleccionarAsync()
    {
        _srvError = null;
        try
        {
            if (_tNewKind == 0)
            {
                if (string.IsNullOrWhiteSpace(_tNewNombres) || string.IsNullOrWhiteSpace(_tNewDoc)) { _srvError = "Documento y nombres son obligatorios."; return; }
                var resp = await Auth().PostAsJsonAsync("/api/directorio/personas",
                    new CrearPersonaRequest(TipoDocumento.CC, _tNewDoc.Trim(), _tNewNombres.Trim(), _tNewApellidos.Trim(), null, null, null, null));
                if (!resp.IsSuccessStatusCode) { _srvError = await ReadErr(resp); return; }
                var p = await resp.Content.ReadFromJsonAsync<CreatedId>();
                if (p is not null) PickTercero(p.Id, null, $"{_tNewNombres} {_tNewApellidos}".Trim());
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_tNewRazon) || string.IsNullOrWhiteSpace(_tNewNit)) { _srvError = "NIT y razon social son obligatorios."; return; }
                var resp = await Auth().PostAsJsonAsync("/api/directorio/empresas",
                    new CrearEmpresaRequest(_tNewNit.Trim(), null, _tNewRazon.Trim(), null, null, null, null, null, null, null, null));
                if (!resp.IsSuccessStatusCode) { _srvError = await ReadErr(resp); return; }
                var em = await resp.Content.ReadFromJsonAsync<CreatedId>();
                if (em is not null) PickTercero(null, em.Id, _tNewRazon.Trim());
            }
        }
        catch (Exception ex) { _srvError = ex.Message; }
    }

