        try { _expedientes = await GetAuthAsync<List<ExpedienteLite>>("/api/expedientes") ?? new(); }
        catch (SesionRedirigidaException) { return; }
        catch { _expedientes = new(); }
        try
        {
            var ps = await GetAuthAsync<List<ProyectoLite>>("/api/tareas?soloRaiz=true") ?? new();
            _proyectos = ps.Where(p => p.EsProyecto).ToList();
        }
        catch (SesionRedirigidaException) { return; }
        catch { _proyectos = new(); }
        _dropdownsLoaded = true;
    }

