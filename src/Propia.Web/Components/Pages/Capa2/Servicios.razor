        if (_srvEditId is not { } sid) return;
        _attachBusy = true;
        try { await Auth().DeleteAsync($"/api/servicios/adjuntos/{id}"); await CargarServicioDetalleAsync(sid); }
        finally { _attachBusy = false; }
