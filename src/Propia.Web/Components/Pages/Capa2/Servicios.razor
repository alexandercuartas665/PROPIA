    // ---- Columnas de la lista: seleccionar (mostrar/ocultar) y ordenar (persistido en localStorage) ----
    private static readonly (string Key, string Label)[] _colsFijas = new[]
    {
        // Orden por defecto del pedido de Contratos (Ola 1). Las legacy quedan disponibles pero
        // ocultas por defecto (_colsOcultas) para no saturar; el usuario las reactiva en Configurar.
        ("tercero", "Contratista"), ("tipoContrato", "Tipo de contrato"), ("numero", "N contrato"),
        ("categoria", "Categoria"), ("asociado", "Asociado a"), ("inicio", "Inicio"),
        ("fin", "Finalizacion"), ("estado", "Vencimiento"), ("valorTotal", "Valor"),
        ("formaPago", "Forma de pago"), ("pagoMensual", "Pago mensual"), ("obs", "Observaciones"),
        // ---- Legacy (ocultas por defecto) ----
        ("tipo", "Tipo de servicio"), ("valor", "$/mes"), ("etapa", "Etapa"),
        ("contacto", "Contacto"), ("renov", "Renov."), ("dias", "Dias alerta")
    };
    // Por defecto se ocultan las columnas legacy que no estan en el pedido (si no hay config guardada).
    private HashSet<string> _colsOcultas = new() { "tipo", "valor", "etapa", "contacto", "renov", "dias" };
    private List<string> _colsOrden = new();
    private bool _showColsMenu;

    private IEnumerable<(string Key, string Label)> ColsCatalogo()
        => _colsFijas.Concat(CamposActivos.Select(c => (c.Id.ToString(), c.Label)));
    private List<string> ColsOrdenadas()
    {
        var todas = ColsCatalogo().Select(c => c.Key).ToList();
        var ord = _colsOrden.Where(todas.Contains).ToList();
        ord.AddRange(todas.Where(k => !ord.Contains(k)));
        return ord;
    }
    private bool ColVisible(string k) => k == "tercero" || !_colsOcultas.Contains(k);
    private IEnumerable<string> ColsVisibles() => ColsOrdenadas().Where(ColVisible);
    private string ColLabel(string k)
    {
        var f = _colsFijas.FirstOrDefault(c => c.Key == k);
        if (f.Key is not null) return f.Label;
        return _cCampos.FirstOrDefault(c => c.Id.ToString() == k)?.Label ?? k;
    }
    private string ColDesc(string k) => _cCampos.FirstOrDefault(c => c.Id.ToString() == k)?.Descripcion ?? "";
    private string ColThClass(string k) => (k == "valor" || k == "dias") ? "ctr-r" : "";
    private string ColTdClass(string k) => k == "tercero" ? "ctr-ct" : ((k == "valor" || k == "dias") ? "ctr-r" : "");

    private async Task ToggleColVisible(string k)
    {
        if (k == "tercero") return;   // la columna principal (con el ojo) no se oculta
        if (!_colsOcultas.Remove(k)) _colsOcultas.Add(k);
        await PersistColsAsync();
    }
    private async Task MoverColAsync(int idx, int dir)
    {
        var vis = ColsOrdenadas();
        var j = idx + dir;
        if (idx < 0 || idx >= vis.Count || j < 0 || j >= vis.Count) return;
        (vis[idx], vis[j]) = (vis[j], vis[idx]);
        _colsOrden = vis;
        await PersistColsAsync();
    }
    private async Task PersistColsAsync()
    {
        try
        {
            var payload = System.Text.Json.JsonSerializer.Serialize(new { orden = ColsOrdenadas(), ocultas = _colsOcultas.ToList() });
            await Js.InvokeVoidAsync("localStorage.setItem", "propia_contratos_cols", payload);
        }
        catch { }
    }
    private async Task CargarColsAsync()
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_contratos_cols");
            if (string.IsNullOrWhiteSpace(raw)) return;
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            if (doc.RootElement.TryGetProperty("orden", out var o) && o.ValueKind == System.Text.Json.JsonValueKind.Array)
                _colsOrden = o.EnumerateArray().Select(x => x.GetString()).Where(x => x is not null).Select(x => x!).ToList();
            if (doc.RootElement.TryGetProperty("ocultas", out var h) && h.ValueKind == System.Text.Json.JsonValueKind.Array)
                _colsOcultas = h.EnumerateArray().Select(x => x.GetString()).Where(x => x is not null).Select(x => x!).ToHashSet();
        }
        catch { }
    }

