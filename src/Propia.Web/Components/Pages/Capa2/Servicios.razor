    /* ---- Contratos: barra de filtros + tabla (Fase A) ---- */
    .ctr-filtros { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 9px; margin-bottom: 12px; }
    .ctr-filtros-l { display: flex; align-items: center; gap: 9px; flex: 0 1 auto; min-width: 0; }
    .ctr-filtros-r { display: flex; align-items: center; gap: 9px; }
    /* Ancho contenido (como el buscador de Tareas/PQRSD), no toda la fila. */
    .ctr-filtros-l .ctr-search { flex: 0 1 300px; }
    /* Popover de columnas (seleccionar + ordenar) */
    .ctr-cols-wrap { position: relative; }
    .ctr-colspop { position: absolute; top: calc(100% + 6px); right: 0; z-index: 41; width: 260px; max-height: 60vh; overflow: auto; background: #fff; border: 1px solid #E6ECF2; border-radius: 12px; box-shadow: 0 18px 44px rgba(30,40,60,.22); padding: 12px; }
    .ctr-colrow { display: grid; grid-template-columns: 26px 1fr; align-items: center; gap: 8px; padding: 5px 6px; border-radius: 8px; }
