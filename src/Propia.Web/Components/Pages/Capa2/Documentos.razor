@page "/documentos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Documentos
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<PageTitle>Documentos - PROPIA</PageTitle>

@* Modulo 2.15 Documentos. Estilo prototipo PROPIA.dc.html: 2 vistas (Expedientes TRD + Archivo central).
   Expedientes -> /api/expedientes ; Archivo central -> /api/documentos. *@

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="doc-wrap">
    <div class="doc-head">
        <div>
            <h1 class="doc-title">Documentos</h1>
            <p class="doc-sub">Archivo digital de la copropiedad &mdash; expedientes por serie documental y archivo central.</p>
        </div>
        @if (_view == "expedientes")
        {
            <div class="doc-head-actions">
                <button class="doc-btn-soft" @onclick="AbrirCfg"><i class="fi fi-rr-settings"></i> Configuracion documental</button>
                <button class="doc-btn-primary" @onclick="AbrirNuevoExp"><i class="fi fi-rr-folder-open"></i> Nuevo expediente</button>
            </div>
        }
        else
        {
            <button class="doc-btn-primary" @onclick="AbrirSubir"><i class="fi fi-rr-cloud-upload"></i> Subir documento</button>
        }
    </div>

    @* Toggle de vistas *@
    <div class="doc-tabs">
        <button class="doc-tab @(_view == "expedientes" ? "on" : "")" @onclick='() => SetView("expedientes")'><i class="fi fi-rr-folder"></i> Expedientes</button>
        <button class="doc-tab @(_view == "archivo" ? "on" : "")" @onclick='() => SetView("archivo")'><i class="fi fi-rr-box"></i> Archivo central</button>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="doc-banner @(_msgClass == "alert-danger" ? "err" : (_msgClass == "alert-success" ? "ok" : "info"))">@_msg</div>
    }

    @* ====================== VISTA EXPEDIENTES ====================== *@
    @if (_view == "expedientes")
    {
        @if (_expedientes is null)
        {
            <div class="doc-loading"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
        }
        else if (_expedientes.Count == 0)
        {
            <div class="doc-empty"><i class="fi fi-rr-folder-open"></i><div>Aun no hay expedientes. Crea el primero con "Nuevo expediente".</div></div>
        }
        else
        {
            <div class="exp-grid">
                @foreach (var e in _expedientes)
                {
                    var ee = e;
                    var (sFg, sBg) = SerieColor(e.Serie);
                    var pct = e.Total > 0 ? (int)Math.Round(e.Cargadas * 100.0 / e.Total) : 0;
                    <button class="exp-card" @onclick="() => AbrirExpediente(ee.Id)">
                        <div class="exp-card-top">
                            <span class="exp-serie" style="color:@sFg;background:@sBg">@e.Serie</span>
                            <span class="exp-codigo">@e.Codigo</span>
                        </div>
                        <div class="exp-nombre">@e.Nombre</div>
                        <div class="exp-subserie">@e.Subserie</div>
                        <div class="exp-progress">
                            <div class="exp-bar"><div class="exp-bar-fill" style="width:@pct%"></div></div>
                            <span class="exp-count">@e.Cargadas/@e.Total</span>
                        </div>
                        <div class="exp-badges">
                            @if (e.Cargadas == e.Total && e.Total > 0)
                            {
                                <span class="exp-badge ok"><i class="fi fi-rr-check"></i> Expediente completo</span>
                            }
                            else if (e.PendientesObligatorias > 0)
                            {
                                <span class="exp-badge pend"><i class="fi fi-rr-exclamation"></i> @e.PendientesObligatorias obligatoria(s) sin cargar</span>
                            }
                        </div>
                    </button>
                }
            </div>
        }
    }
    else
    {
        @* ====================== VISTA ARCHIVO CENTRAL ====================== *@
        @* Sin KPIs (canon regla 7): del titulo se pasa directo a la barra de busqueda/filtros. *@

        <div class="doc-toolbar">
            <div class="doc-search">
                <i class="fi fi-rr-search"></i>
                <input placeholder="Buscar por titulo o nombre de archivo..." @bind="_query" @bind:event="oninput" @onkeyup="CargarDocumentosAsync" />
                @if (_documentos is not null) { <span class="doc-search-count">@_documentos.Total resultado(s)</span> }
            </div>
            <select class="doc-select" @bind="_filtroEstado" @bind:after="CargarDocumentosAsync">
                <option value="">Todos los estados</option>
                @foreach (var e in Enum.GetValues<EstadoDocumento>()) { <option value="@e">@EstadoTexto(e)</option> }
            </select>
            <select class="doc-select" @bind="_filtroOrigen" @bind:after="CargarDocumentosAsync">
                <option value="">Cualquier origen</option>
                @foreach (var o in Enum.GetValues<OrigenDocumento>()) { <option value="@o">@o</option> }
            </select>
            <label class="doc-star-toggle @(_soloDestacados ? "on" : "")" title="Solo destacados">
                <input type="checkbox" @bind="_soloDestacados" @bind:after="CargarDocumentosAsync" />
                <i class="fi fi-rr-star"></i> Destacados
            </label>
        </div>

        @if (_categorias is not null)
        {
            <div class="doc-cats">
                <button class="doc-chip @(_filtroCategoriaId is null ? "on" : "")" @onclick="() => SeleccionarCategoria(null)">Todas</button>
                @foreach (var c in _categorias)
                {
                    var cid = c.Id;
                    <button class="doc-chip @(_filtroCategoriaId == cid ? "on" : "")" @onclick="() => SeleccionarCategoria(cid)">
                        @if (!string.IsNullOrEmpty(c.Color)) { <span class="doc-chip-dot" style="background:@c.Color"></span> }
                        @c.Nombre <span class="doc-chip-n">@c.NumeroDocumentos</span>
                    </button>
                }
            </div>
        }

        @if (_documentos is null)
        {
            <div class="doc-loading"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
        }
        else if (_documentos.Items.Count == 0)
        {
            <div class="doc-empty"><i class="fi fi-rr-folder-open"></i><div>Sin documentos con los filtros actuales.</div></div>
        }
        else
        {
            <div class="doc-listcard">
                @foreach (var d in _documentos.Items)
                {
                    var did = d.Id;
                    var (eBg, eFg) = EstadoColor(d.Estado);
                    <div class="doc-row">
                        <button class="doc-row-main" @onclick="() => AbrirFicha(did)">
                            <div class="doc-ficon"><i class="fi fi-rr-document"></i></div>
                            <div class="doc-row-body">
                                <div class="doc-row-name">
                                    @if (d.Destacado) { <i class="fi fi-rr-star doc-star copro" title="Destacado por la copropiedad"></i> }
                                    else if (d.DestacadoPersonal) { <i class="fi fi-rr-star doc-star pers" title="Destacado personal"></i> }
                                    @d.Titulo
                                </div>
                                <div class="doc-row-meta">@d.CategoriaNombre &middot; @FormatBytes(d.TamanoBytes) &middot; v@(d.NumeroVersiones) &middot; @((d.UpdatedAt ?? d.CreadoAt).LocalDateTime.ToString("dd MMM yyyy")) &middot; origen: @d.Origen</div>
                                @if (d.Etiquetas.Count > 0)
                                {
                                    <div class="doc-row-tags">
                                        @foreach (var et in d.Etiquetas.Take(4))
                                        {
                                            var col = string.IsNullOrEmpty(et.Color) ? "#6D4FE3" : et.Color;
                                            <span class="doc-tag" style="color:@col;border-color:@(col)55">@et.Nombre</span>
                                        }
                                    </div>
                                }
                            </div>
                        </button>
                        <span class="doc-estado" style="background:@eBg;color:@eFg">@EstadoTexto(d.Estado)</span>
                        <button class="doc-row-act" title="Descargar" @onclick="() => Descargar(did)"><i class="fi fi-rr-download"></i></button>
                    </div>
                }
                @if (_documentos.Total > _documentos.PageSize)
                {
                    <div class="doc-pager">
                        <span>@_documentos.Items.Count de @_documentos.Total</span>
                        <div class="doc-pager-btns">
                            <button class="doc-btn-ghost sm" disabled="@(_page <= 1)" @onclick="() => CambiarPagina(_page - 1)">Anterior</button>
                            <span class="doc-pager-page">Pagina @_page</span>
                            <button class="doc-btn-ghost sm" disabled="@(_page * _documentos.PageSize >= _documentos.Total)" @onclick="() => CambiarPagina(_page + 1)">Siguiente</button>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@* ===================== Modal: detalle de expediente (3 columnas) ===================== *@
@if (_expDetalle is not null)
{
    var ed = _expDetalle;
    var selTip = ed.Tipologias.FirstOrDefault(t => t.Id == _expSelTip && t.Cargado);
    var (edFg, edBg) = SerieColor(ed.Serie);
    <div class="doc-ov" @onclick="CerrarExpediente"></div>
    <div class="exp-modal">
        <div class="exp-modal-head">
            <div class="d-flex align-items-center gap-3" style="min-width:0;">
                <div class="exp-modal-icon" style="color:@edFg;background:@edBg"><i class="fi fi-rr-folder"></i></div>
                <div style="min-width:0;">
                    <div class="exp-modal-title">@ed.Nombre</div>
                    <div class="doc-sub" style="margin:2px 0 0;">@ed.Serie &rsaquo; @ed.Subserie &middot; @ed.Codigo &middot; @ed.Cargadas/@ed.Total documentos</div>
                </div>
            </div>
            <button class="doc-x" @onclick="CerrarExpediente"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="exp-cols">
            @* IZQUIERDA: metadatos + campos *@
            <div class="exp-col-left">
                @if (selTip is not null)
                {
                    <div class="exp-sec-title">Metadatos del documento</div>
                    <div class="exp-doc-name">@selTip.Nombre</div>
                    @if (selTip.Meta.Count > 0)
                    {
                        <div class="exp-meta-list">
                            @foreach (var mp in selTip.Meta)
                            {
                                <div class="exp-meta-row"><div class="exp-meta-k">@mp.Label</div><div class="exp-meta-v">@mp.Valor</div></div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="doc-sub" style="margin-bottom:16px;">Este documento no tiene metadatos diligenciados.</div>
                    }
                }
                <div class="exp-sec-title">Campos del expediente</div>
                <div class="doc-sub" style="margin-bottom:8px;">Se solicitan al cargar cada documento.</div>
                <div class="exp-chips">
                    @foreach (var cp in ed.Campos)
                    {
                        var cpId = cp.Id;
                        <span class="exp-chip">@cp.Label<button class="exp-chip-x" @onclick="() => EliminarCampoExp(cpId)"><i class="fi fi-rr-cross-small"></i></button></span>
                    }
                </div>
                <div class="exp-add">
                    <input class="doc-input" placeholder="Nuevo metadato..." @bind="_nuevoCampoExp" @bind:event="oninput" />
                    <button class="doc-btn-soft sm" @onclick="AgregarCampoExp" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoCampoExp))"><i class="fi fi-rr-plus"></i></button>
                </div>
            </div>

            @* CENTRO: visor *@
            <div class="exp-col-center">
                @if (selTip is not null)
                {
                    <div class="exp-viewer-bar">
                        <div class="doc-ficon sm"><i class="fi fi-rr-document"></i></div>
                        <div style="flex:1;min-width:0;">
                            <div class="doc-row-name">@(_visorNombre ?? selTip.ArchivoNombre)</div>
                            @if (_visorVersionId != Guid.Empty)
                            {
                                <div class="doc-sub" style="margin:0;">Version anterior · <button class="exp-ver-link" @onclick="() => CargarVisorActual(selTip.Id)">volver a la actual</button></div>
                            }
                            else if (selTip.NumeroVersiones > 1)
                            {
                                <div class="doc-sub" style="margin:0;">Version actual (v@(selTip.NumeroVersiones))</div>
                            }
                        </div>
                        <button class="doc-btn-soft sm" @onclick="() => AbrirCargar(ed.Id, selTip.Id)">Reemplazar</button>
                        <button class="doc-btn-primary sm" @onclick="() => DescargarTip(selTip.Id)"><i class="fi fi-rr-download"></i> Descargar</button>
                    </div>
                    <div class="exp-viewer-body">
                        @if (_visorCargando)
                        {
                            <div class="exp-viewer-empty"><i class="fi fi-rr-spinner"></i><div>Cargando documento...</div></div>
                        }
                        else if (_visorKind == "image" && !string.IsNullOrEmpty(_visorDataUri))
                        {
                            <img class="exp-viewer-img" src="@_visorDataUri" alt="@_visorNombre" />
                        }
                        else if (_visorKind == "pdf" && !string.IsNullOrEmpty(_visorDataUri))
                        {
                            <iframe class="exp-viewer-frame" src="@_visorDataUri" title="@_visorNombre"></iframe>
                        }
                        else if (_visorKind == "text")
                        {
                            <pre class="exp-viewer-text">@_visorTexto</pre>
                        }
                        else if (_visorKind == "html" && !string.IsNullOrEmpty(_visorHtml))
                        {
                            <div class="exp-viewer-html">@((MarkupString)_visorHtml)</div>
                        }
                        else
                        {
                            <div class="exp-viewer-empty">
                                <i class="fi fi-rr-file"></i>
                                <div>Vista previa no disponible para @(Ext(_visorNombre ?? selTip.ArchivoNombre)). Descarga el archivo para verlo.</div>
                                <button class="doc-btn-primary sm" @onclick="() => DescargarTip(selTip.Id)"><i class="fi fi-rr-download"></i> Descargar</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="exp-viewer-empty"><i class="fi fi-rr-eye"></i><div>Selecciona un documento cargado a la derecha para verlo aqui.</div></div>
                }
            </div>

            @* DERECHA: tipologias *@
            <div class="exp-col-right">
                <div class="exp-sec-title" style="padding:15px 16px 8px;">Tipologias documentales</div>
                <div class="exp-tips">
                    @foreach (var t in ed.Tipologias)
                    {
                        var tt = t;
                        <div class="exp-tip @(t.Id == _expSelTip ? "sel" : "") @(t.Cargado ? "cargado" : "vacio")">
                            <div class="exp-tip-top" @onclick="() => SelTip(tt)">
                                <div class="exp-tip-ic @(t.Cargado ? "ok" : "")"><i class="fi @(t.Cargado ? "fi-rr-check" : "fi-rr-document")"></i></div>
                                <div style="flex:1;min-width:0;">
                                    <div class="exp-tip-name">@t.Nombre @if (t.Obligatoria) { <span class="exp-oblig">OBLIG.</span> }</div>
                                    <div class="exp-tip-sub">@(t.Cargado ? t.ArchivoNombre : "Sin cargar")</div>
                                </div>
                                <button class="exp-tip-dup" title="Duplicar tipologia (agregar otro documento del mismo tipo)" @onclick:stopPropagation="true" @onclick="() => DuplicarTipologiaExp(tt.Id)"><i class="fi fi-rr-copy-alt"></i></button>
                                <button class="exp-tip-del" title="Eliminar tipologia" @onclick:stopPropagation="true" @onclick="() => EliminarTipologiaExp(tt.Id)"><i class="fi fi-rr-cross-small"></i></button>
                            </div>
                            <div class="exp-tip-acts">
                                @if (t.Cargado)
                                {
                                    <button class="doc-btn-soft sm" @onclick="() => AbrirCargar(ed.Id, tt.Id)">Reemplazar</button>
                                    <button class="doc-btn-soft sm @(_versionesTipId == t.Id ? "on" : "")" @onclick="() => ToggleVersiones(tt.Id)"><i class="fi fi-rr-time-past"></i> Versiones@(tt.NumeroVersiones > 0 ? $" ({tt.NumeroVersiones})" : "")</button>
                                    <button class="doc-btn-danger sm" @onclick="() => QuitarArchivoTip(tt.Id)">Quitar</button>
                                }
                                else
                                {
                                    <button class="doc-btn-primary sm full" @onclick="() => AbrirCargar(ed.Id, tt.Id)">Cargar documento</button>
                                }
                            </div>
                            @if (_versionesTipId == t.Id)
                            {
                                <div class="exp-tip-vers">
                                    @if (_versionesCargando) { <div class="doc-sub" style="margin:0;">Cargando versiones...</div> }
                                    else if (_versionesLista.Count == 0) { <div class="doc-sub" style="margin:0;">Sin versiones registradas.</div> }
                                    else
                                    {
                                        @foreach (var v in _versionesLista)
                                        {
                                            var vv = v;
                                            <div class="exp-ver-row @(_visorVersionId == v.Id ? "sel" : "")">
                                                <span class="exp-ver-badge">v@(v.Numero)</span>
                                                <div style="flex:1;min-width:0;">
                                                    <div class="exp-ver-name">@v.ArchivoNombre</div>
                                                    <div class="exp-ver-meta">@v.CreadoAt.ToCo().ToString("dd MMM yyyy, HH:mm")@(string.IsNullOrEmpty(v.NotasCambio) ? "" : " · " + v.NotasCambio)</div>
                                                </div>
                                                <button class="exp-ver-btn" title="Ver esta version" @onclick="() => VerVersion(tt.Id, vv.Id)"><i class="fi fi-rr-eye"></i></button>
                                                <button class="exp-ver-btn" title="Descargar" @onclick="() => DescargarVersionTip(tt.Id, vv.Id)"><i class="fi fi-rr-download"></i></button>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="exp-add" style="padding:12px 16px;border-top:1px solid #EEF3F8;">
                    <input class="doc-input" placeholder="Nueva tipologia..." @bind="_nuevaTipExp" @bind:event="oninput" />
                    <button class="doc-btn-primary sm" @onclick="AgregarTipologiaExp" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaTipExp))"><i class="fi fi-rr-plus"></i></button>
                </div>
            </div>
        </div>
    </div>
}

@* ===================== Modal: nuevo expediente ===================== *@
@if (_showNuevoExp)
{
    <div class="doc-ov" @onclick="() => _showNuevoExp = false"></div>
    <div class="doc-modal" style="width:min(560px,96vw);">
        <div class="doc-modal-head"><h5 class="mb-0">Nuevo expediente</h5><button class="doc-x" @onclick="() => _showNuevoExp = false"><i class="fi fi-rr-cross-small"></i></button></div>
        <div class="doc-modal-body">
            <label class="doc-lbl">Nombre del expediente *</label>
            <input class="doc-input mb-2" placeholder="Ej. Asamblea Ordinaria 2026" @bind="_neNombre" @bind:event="oninput" />
            <div class="doc-grid2">
                <div>
                    <label class="doc-lbl">Serie *</label>
                    <select class="doc-input" @bind="_neSerieId" @bind:after="OnNeSerieChange">
                        <option value="">Seleccionar...</option>
                        @if (_trd is not null) { @foreach (var s in _trd) { <option value="@s.Id">@s.Nombre</option> } }
                    </select>
                </div>
                <div>
                    <label class="doc-lbl">Subserie *</label>
                    <select class="doc-input" @bind="_neSubserieId">
                        <option value="">Seleccionar...</option>
                        @foreach (var ss in NeSubseries()) { <option value="@ss.Id">@ss.Nombre</option> }
                    </select>
                </div>
            </div>
            @{ var neSub = NeSubseries().FirstOrDefault(x => x.Id == _neSubserieId); }
            @if (neSub is not null && neSub.Tipologias.Count > 0)
            {
                <div class="exp-preview">
                    <div class="doc-lbl">Tipologias de la subserie</div>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var t in neSub.Tipologias) { <span class="exp-chip">@t.Nombre</span> }
                    </div>
                    <div class="doc-sub" style="margin-top:6px;">Podras agregar o quitar tipologias y metadatos despues.</div>
                </div>
            }
            @if (_neError is not null) { <div class="text-danger small mt-2">@_neError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="doc-btn-ghost" @onclick="() => _showNuevoExp = false">Cancelar</button>
                <button class="doc-btn-primary" @onclick="CrearExpediente" disabled="@(_busy || string.IsNullOrWhiteSpace(_neNombre) || _neSubserieId == Guid.Empty)">Crear expediente</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal: configuracion documental (TRD) ===================== *@
@if (_showCfg)
{
    <div class="doc-ov" @onclick="() => _showCfg = false"></div>
    <div class="doc-modal" style="width:min(1000px,96vw); max-height:90vh;">
        <div class="doc-modal-head">
            <div><h5 class="mb-0">Configuracion documental</h5><div class="doc-sub" style="margin:2px 0 0;">Tabla de retencion: series, subseries, tipologias y metadatos.</div></div>
            <button class="doc-x" @onclick="() => _showCfg = false"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="cfg-cols">
            @{ var cfgSerie = _trd?.FirstOrDefault(s => s.Id == _cfgSerieSel); var cfgSub = cfgSerie?.Subseries.FirstOrDefault(x => x.Id == _cfgSubSel); }
            <div class="cfg-col">
                <div class="cfg-col-title">Series</div>
                <div class="cfg-list">
                    @if (_trd is not null) { @foreach (var s in _trd)
                    {
                        var ss = s;
                        <div class="cfg-item @(s.Id == _cfgSerieSel ? "sel" : "")" @onclick="() => { _cfgSerieSel = ss.Id; _cfgSubSel = ss.Subseries.FirstOrDefault()?.Id ?? Guid.Empty; }">
                            <div style="flex:1;min-width:0;"><div class="cfg-item-name">@s.Nombre</div><div class="cfg-item-sub">@s.Subseries.Count subserie(s)</div></div>
                            <button class="exp-chip-x" @onclick:stopPropagation="true" @onclick="() => CfgDelSerie(ss.Id)"><i class="fi fi-rr-trash"></i></button>
                        </div>
                    } }
                </div>
                <div class="exp-add"><input class="doc-input" placeholder="Nueva serie..." @bind="_cfgNuevaSerie" @bind:event="oninput" /><button class="doc-btn-soft sm" @onclick="CfgAddSerie" disabled="@(_busy || string.IsNullOrWhiteSpace(_cfgNuevaSerie))"><i class="fi fi-rr-plus"></i></button></div>
            </div>
            <div class="cfg-col">
                <div class="cfg-col-title">Subseries @if (cfgSerie is not null) { <span class="doc-sub">&middot; @cfgSerie.Nombre</span> }</div>
                <div class="cfg-list">
                    @if (cfgSerie is not null) { @foreach (var s in cfgSerie.Subseries)
                    {
                        var sb = s;
                        <div class="cfg-item @(s.Id == _cfgSubSel ? "sel" : "")" @onclick="() => _cfgSubSel = sb.Id">
                            <div style="flex:1;min-width:0;"><div class="cfg-item-name">@s.Nombre</div><div class="cfg-item-sub">@s.Tipologias.Count tipologia(s) &middot; @s.Campos.Count metadato(s)</div></div>
                            <button class="exp-chip-x" @onclick:stopPropagation="true" @onclick="() => CfgDelSub(sb.Id)"><i class="fi fi-rr-trash"></i></button>
                        </div>
                    } }
                    @if (cfgSerie is null) { <div class="doc-sub" style="padding:10px;">Selecciona una serie.</div> }
                </div>
                @if (cfgSerie is not null) { <div class="exp-add"><input class="doc-input" placeholder="Nueva subserie..." @bind="_cfgNuevaSub" @bind:event="oninput" /><button class="doc-btn-soft sm" @onclick="CfgAddSub" disabled="@(_busy || string.IsNullOrWhiteSpace(_cfgNuevaSub))"><i class="fi fi-rr-plus"></i></button></div> }
            </div>
            <div class="cfg-col">
                <div class="cfg-col-title">Tipologias y metadatos @if (cfgSub is not null) { <span class="doc-sub">&middot; @cfgSub.Nombre</span> }</div>
                @if (cfgSub is not null)
                {
                    <div class="cfg-list" style="max-height:200px;">
                        @foreach (var t in cfgSub.Tipologias)
                        {
                            var tt = t;
                            <div class="cfg-item"><div style="flex:1;min-width:0;"><div class="cfg-item-name">@t.Nombre</div></div><button class="exp-chip-x" @onclick="() => CfgDelTip(tt.Id)"><i class="fi fi-rr-trash"></i></button></div>
                        }
                    </div>
                    <div class="exp-add"><input class="doc-input" placeholder="Nueva tipologia..." @bind="_cfgNuevaTip" @bind:event="oninput" /><button class="doc-btn-soft sm" @onclick="CfgAddTip" disabled="@(_busy || string.IsNullOrWhiteSpace(_cfgNuevaTip))"><i class="fi fi-rr-plus"></i></button></div>
                    <div class="cfg-col-title" style="margin-top:8px;">Metadatos</div>
                    <div class="exp-chips">
                        @foreach (var c in cfgSub.Campos)
                        {
                            var cc = c;
                            <span class="exp-chip">@c.Label<button class="exp-chip-x" @onclick="() => CfgDelCampo(cc.Id)"><i class="fi fi-rr-cross-small"></i></button></span>
                        }
                    </div>
                    <div class="exp-add"><input class="doc-input" placeholder="Nuevo metadato..." @bind="_cfgNuevoCampo" @bind:event="oninput" /><button class="doc-btn-soft sm" @onclick="CfgAddCampo" disabled="@(_busy || string.IsNullOrWhiteSpace(_cfgNuevoCampo))"><i class="fi fi-rr-plus"></i></button></div>
                }
                else { <div class="doc-sub" style="padding:10px;">Selecciona una subserie.</div> }
            </div>
        </div>
        <div class="doc-modal-foot"><span class="doc-sub">Los cambios se aplican al crear nuevos expedientes.</span><button class="doc-btn-primary" @onclick="() => _showCfg = false">Listo</button></div>
    </div>
}

@* ===================== Modal: cargar documento en tipologia ===================== *@
@if (_showCargar)
{
    <div class="doc-ov" @onclick="() => _showCargar = false"></div>
    <div class="doc-modal" style="width:min(520px,96vw); max-height:90vh;">
        <div class="doc-modal-head"><div><h5 class="mb-0">Cargar documento</h5><div class="doc-sub" style="margin:2px 0 0;">@_cargarTipNombre</div></div><button class="doc-x" @onclick="() => _showCargar = false"><i class="fi fi-rr-cross-small"></i></button></div>
        <div class="doc-modal-body">
            <label class="doc-dropzone">
                <i class="fi fi-rr-cloud-upload"></i>
                <span>@(string.IsNullOrEmpty(_cargarNombre) ? "Arrastra o selecciona el archivo" : _cargarNombre)</span>
                <small>@(string.IsNullOrEmpty(_cargarNombre) ? "PDF, imagen o documento (max 20MB)" : FormatBytes(_cargarTamano))</small>
                <InputFile OnChange="OnCargarArchivo" style="display:none" />
            </label>
            @if (_cargarCampos.Count > 0)
            {
                <label class="doc-lbl mt-2">Metadatos</label>
                @foreach (var cp in _cargarCampos)
                {
                    var clave = cp.Clave;
                    <div class="mb-2">
                        <label class="doc-lbl">@cp.Label</label>
                        <input class="doc-input" value="@(_cargarMeta.TryGetValue(clave, out var v) ? v : "")" @oninput="(e) => _cargarMeta[clave] = e.Value?.ToString() ?? string.Empty" />
                    </div>
                }
            }
            <div class="mb-2 mt-2">
                <label class="doc-lbl">Notas del cambio (opcional)</label>
                <input class="doc-input" placeholder="Ej. version firmada, correccion de anexo..." @bind="_cargarNotas" @bind:event="oninput" />
            </div>
            <div class="doc-sub" style="margin-top:4px;"><i class="fi fi-rr-info"></i> Si la tipologia ya tenia un archivo, el nuevo se guarda como una <strong>version nueva</strong> y la anterior queda consultable.</div>
            @if (_cargarError is not null) { <div class="text-danger small mt-1">@_cargarError</div> }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="doc-btn-ghost" @onclick="() => _showCargar = false">Cancelar</button>
                <button class="doc-btn-primary" @onclick="GuardarCargar" disabled="@(_busy || string.IsNullOrEmpty(_cargarB64))">Guardar en el expediente</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal: subir documento (Archivo central) ===================== *@
@if (_showSubir)
{
    <div class="doc-ov" @onclick="() => _showSubir = false"></div>
    <div class="doc-modal" style="width:min(620px,96vw); max-height:90vh;">
        <div class="doc-modal-head"><h5 class="mb-0">Subir documento</h5><button class="doc-x" @onclick="() => _showSubir = false"><i class="fi fi-rr-cross-small"></i></button></div>
        <div class="doc-modal-body">
            <label class="doc-lbl">Titulo *</label>
            <input class="doc-input mb-2" @bind="_subirTitulo" @bind:event="oninput" maxlength="200" />
            <label class="doc-lbl">Descripcion</label>
            <textarea class="doc-input mb-2" rows="2" @bind="_subirDescripcion" @bind:event="oninput"></textarea>
            <div class="doc-grid2">
                <div>
                    <label class="doc-lbl">Categoria *</label>
                    <select class="doc-input" @bind="_subirCategoriaId">
                        <option value="">Seleccionar...</option>
                        @if (_categorias is not null) { @foreach (var c in _categorias) { <option value="@c.Id">@c.Nombre</option> } }
                    </select>
                </div>
                <div>
                    <label class="doc-lbl">Visibilidad</label>
                    <select class="doc-input" @bind="_subirVisibilidad">
                        <option value="EQUIPO">Equipo (administracion)</option>
                        <option value="PUBLICO">Publico (residentes)</option>
                        <option value="PRIVADO">Privado (solo yo)</option>
                    </select>
                </div>
            </div>
            <label class="doc-lbl mt-2">Archivo *</label>
            <label class="doc-dropzone">
                <i class="fi fi-rr-cloud-upload"></i>
                <span>@(string.IsNullOrEmpty(_subirNombreArchivo) ? "Arrastra o selecciona el archivo" : _subirNombreArchivo)</span>
                <small>@(string.IsNullOrEmpty(_subirNombreArchivo) ? "PDF, imagen o documento (max 20MB)" : FormatBytes(_subirTamano))</small>
                <InputFile OnChange="OnArchivoSeleccionado" style="display:none" />
            </label>
            @if (_etiquetas is not null && _etiquetas.Count > 0)
            {
                <label class="doc-lbl mt-2">Etiquetas</label>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var e in _etiquetas)
                    {
                        var eid = e.Id;
                        var sel = _subirEtiquetaIds.Contains(eid);
                        var col = string.IsNullOrEmpty(e.Color) ? "#6D4FE3" : e.Color;
                        <button type="button" class="doc-tagbtn @(sel ? "on" : "")" style="@(sel ? $"background:{col};border-color:{col};color:#fff" : $"color:{col};border-color:{col}55")" @onclick="() => ToggleEtiqueta(eid)">@e.Nombre</button>
                    }
                </div>
            }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="doc-btn-ghost" @onclick="() => _showSubir = false">Cancelar</button>
                <button class="doc-btn-primary" @onclick="ConfirmarSubir" disabled="@(_busy || string.IsNullOrWhiteSpace(_subirTitulo) || _subirCategoriaId == Guid.Empty || string.IsNullOrEmpty(_subirContenidoB64))">@(_busy ? "Subiendo..." : "Subir documento")</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal: ficha (Archivo central) ===================== *@
@if (_ficha is not null)
{
    var d = _ficha;
    var (fBg, fFg) = EstadoColor(d.Estado);
    <div class="doc-ov" @onclick="() => _ficha = null"></div>
    <div class="doc-modal" style="width:min(820px,96vw); max-height:92vh;">
        <div class="doc-modal-head">
            <div class="d-flex align-items-center gap-3" style="min-width:0;">
                <div class="doc-ficon lg"><i class="fi fi-rr-document"></i></div>
                <div style="min-width:0;"><h5 class="mb-0 text-truncate">@d.Titulo</h5><div class="doc-sub" style="margin:2px 0 0;">@d.NombreArchivoOriginal &middot; @d.CategoriaNombre</div></div>
            </div>
            <button class="doc-x" @onclick="() => _ficha = null"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="doc-modal-body" style="overflow-y:auto;">
            @if (!string.IsNullOrEmpty(d.Descripcion)) { <p class="doc-sub" style="margin-bottom:14px;">@d.Descripcion</p> }
            <div class="doc-meta-grid">
                <div><div class="doc-meta-k">Estado</div><span class="doc-estado" style="background:@fBg;color:@fFg">@EstadoTexto(d.Estado)</span></div>
                <div><div class="doc-meta-k">Version actual</div><div class="doc-meta-v">v@(d.VersionActual.Numero)</div></div>
                <div><div class="doc-meta-k">Tamano</div><div class="doc-meta-v">@FormatBytes(d.VersionActual.TamanoBytes)</div></div>
                <div><div class="doc-meta-k">Visibilidad</div><div class="doc-meta-v">@d.Visibilidad</div></div>
                <div><div class="doc-meta-k">Origen</div><div class="doc-meta-v">@d.Origen</div></div>
                <div><div class="doc-meta-k">Creado</div><div class="doc-meta-v">@d.CreadoAt.LocalDateTime.ToString("dd MMM yyyy")</div></div>
            </div>
            @if (d.Etiquetas.Count > 0)
            {
                <div class="doc-row-tags" style="margin:0 0 14px;">
                    @foreach (var et in d.Etiquetas) { var col = string.IsNullOrEmpty(et.Color) ? "#6D4FE3" : et.Color; <span class="doc-tag" style="color:@col;border-color:@(col)55">@et.Nombre</span> }
                </div>
            }
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="doc-btn-primary sm" @onclick="() => DescargarVersion(d.Id, d.VersionActual.Id)"><i class="fi fi-rr-download"></i> Descargar actual</button>
                <button class="doc-btn-ghost sm" @onclick="AbrirNuevaVersion">Subir nueva version</button>
                <button class="doc-btn-ghost sm" @onclick="ToggleDestacadoPersonal">@(d.DestacadoPersonal ? "Quitar destacado" : "Destacar")</button>
                @if (d.Estado == EstadoDocumento.Vigente) { <button class="doc-btn-ghost sm" @onclick="() => CambiarEstado(EstadoDocumento.Archivado)">Archivar</button> }
                else if (d.Estado == EstadoDocumento.Archivado) { <button class="doc-btn-ghost sm" @onclick="() => CambiarEstado(EstadoDocumento.Vigente)">Reactivar</button> }
                <button class="doc-btn-danger sm ms-auto" @onclick="() => EliminarDocumento(d.Id)">Eliminar</button>
            </div>
            @if (_subirNuevaVersionVisible)
            {
                <div class="doc-newver">
                    <div class="doc-lbl mb-1">Nueva version</div>
                    <label class="doc-dropzone sm"><i class="fi fi-rr-cloud-upload"></i><span>@(string.IsNullOrEmpty(_nuevaVersionNombre) ? "Selecciona el archivo" : _nuevaVersionNombre)</span><InputFile OnChange="OnNuevaVersionArchivo" style="display:none" /></label>
                    <input class="doc-input my-2" placeholder="Notas del cambio (opcional)" @bind="_nuevaVersionNotas" @bind:event="oninput" />
                    <div class="d-flex gap-2"><button class="doc-btn-primary sm" @onclick="ConfirmarNuevaVersion" disabled="@(_busy || string.IsNullOrEmpty(_nuevaVersionContenidoB64))">@(_busy ? "Subiendo..." : "Guardar version")</button><button class="doc-btn-ghost sm" @onclick="() => _subirNuevaVersionVisible = false">Cancelar</button></div>
                </div>
            }
            @if (d.Historial.Count > 0)
            {
                <div class="doc-section-title">Historial de versiones</div>
                <div class="doc-listcard">
                    @foreach (var v in d.Historial)
                    {
                        var vId = v.Id;
                        <div class="doc-row">
                            <div class="doc-row-main" style="cursor:default;">
                                <div class="doc-ficon sm"><i class="fi fi-rr-time-past"></i></div>
                                <div class="doc-row-body"><div class="doc-row-name">v@(v.Numero) &middot; @v.NombreArchivo</div><div class="doc-row-meta">@FormatBytes(v.TamanoBytes) &middot; @v.CreadoAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</div></div>
                            </div>
                            <button class="doc-row-act" title="Descargar" @onclick="() => DescargarVersion(d.Id, vId)"><i class="fi fi-rr-download"></i></button>
                        </div>
                    }
                </div>
            }
            @if (_auditoria is not null && _auditoria.Count > 0)
            {
                <div class="doc-section-title">Auditoria</div>
                <div class="doc-audit">
                    @foreach (var a in _auditoria.Take(15)) { <div class="doc-audit-row"><span class="doc-audit-ev">@a.TipoEvento</span><span class="doc-audit-at">@a.OcurridoAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</span></div> }
                </div>
            }
        </div>
    </div>
}
}

<style>
