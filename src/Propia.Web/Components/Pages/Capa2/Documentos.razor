    private List<ExpedienteCampoDto> _cargarCampos = new();
    private readonly Dictionary<string, string> _cargarMeta = new();

    // Visor central inline (data URI / texto / html) + panel de versiones
    private string? _visorDataUri, _visorMime, _visorNombre;
    private string _visorKind = "none";       // image | pdf | text | html | none
    private string? _visorHtml, _visorTexto;
    private bool _visorCargando;
    private Guid _visorVersionId; // Guid.Empty = version actual
    private Guid _versionesTipId;
    private List<TipologiaVersionDto> _versionesLista = new();
    private bool _versionesCargando;

    // ---- Archivo central ----
    private List<CategoriaDto>? _categorias;
    private List<EtiquetaDto>? _etiquetas;
    private DocumentosPageDto? _documentos;
    private DocumentoDetalleDto? _ficha;
    private List<AuditoriaEventoDto>? _auditoria;
    private ResumenDocumentosDto? _resumen;
    private Guid? _filtroCategoriaId;
    private string _filtroEstado = "";
    private string _filtroOrigen = "";
    private string _query = "";
    private bool _soloDestacados;
    private int _page = 1;
    private bool _showSubir;
    private string? _subirTitulo, _subirDescripcion, _subirNombreArchivo, _subirMime, _subirContenidoB64;
    private Guid _subirCategoriaId = Guid.Empty;
    private string _subirVisibilidad = "EQUIPO";
    private long _subirTamano;
    private List<Guid> _subirEtiquetaIds = new();
    private bool _subirNuevaVersionVisible;
    private string? _nuevaVersionNombre, _nuevaVersionMime, _nuevaVersionContenidoB64, _nuevaVersionNotas;
    private long _nuevaVersionTamano;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored)) { _jwt = stored; await CargarExpedientesAsync(); StateHasChanged(); }
        }
        catch { }
    }

    private async Task SetView(string v)
    {
        _view = v;
        if (v == "expedientes" && _expedientes is null) await CargarExpedientesAsync();
        if (v == "archivo" && _documentos is null) await CargarArchivoAsync();
    }

    // ===================== Expedientes =====================
    private async Task CargarExpedientesAsync()
    {
        try { _expedientes = await Auth().GetFromJsonAsync<List<ExpedienteListaDto>>("/api/expedientes") ?? new(); }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task EnsureTrdAsync()
    {
        if (_trd is null) { try { _trd = await Auth().GetFromJsonAsync<List<TrdSerieDto>>("/api/expedientes/trd") ?? new(); } catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; } }
    }

    private async Task AbrirExpediente(Guid id)
    {
        _expDetalle = await Auth().GetFromJsonAsync<ExpedienteDetalleDto>($"/api/expedientes/{id}");
        _expSelTip = _expDetalle?.Tipologias.FirstOrDefault(t => t.Cargado)?.Id ?? Guid.Empty;
        _versionesTipId = Guid.Empty; _visorDataUri = null; _visorVersionId = Guid.Empty;
        if (_expSelTip != Guid.Empty) await CargarVisorActual(_expSelTip);
    }

    private void CerrarExpediente() { _expDetalle = null; _expSelTip = Guid.Empty; _visorDataUri = null; _versionesTipId = Guid.Empty; }

    private async Task SelTip(ExpedienteTipologiaDto t)
    {
        if (!t.Cargado) return;
        _expSelTip = t.Id;
        await CargarVisorActual(t.Id);
    }

    private async Task RecargarDetalleAsync()
    {
        if (_expDetalle is null) return;
        _expDetalle = await Auth().GetFromJsonAsync<ExpedienteDetalleDto>($"/api/expedientes/{_expDetalle.Id}");
        await CargarExpedientesAsync();
    }

    // ---- Visor central inline (renderiza el documento via data URI) ----
    private static bool EsImagenMime(string? mime) => !string.IsNullOrEmpty(mime) && mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    private static bool EsPdfMime(string? mime, string? nombre) =>
        (mime?.Contains("pdf", StringComparison.OrdinalIgnoreCase) ?? false) || (nombre?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ?? false);

    private Task CargarVisorActual(Guid tipId)
    {
        _visorVersionId = Guid.Empty;
        return CargarVisorDesde($"/api/expedientes/tipologias/{tipId}/preview");
    }

    private async Task VerVersion(Guid tipId, Guid versionId)
    {
        _expSelTip = tipId;
        _visorVersionId = versionId;
        await CargarVisorDesde($"/api/expedientes/tipologias/{tipId}/versiones/{versionId}/preview");
    }

    private async Task CargarVisorDesde(string url)
    {
        _visorCargando = true; _visorDataUri = null; _visorNombre = null; _visorMime = null;
        _visorKind = "none"; _visorHtml = null; _visorTexto = null;
        StateHasChanged();
        try
        {
            var dto = await Auth().GetFromJsonAsync<TipologiaPreviewDto>(url);
            if (dto is not null)
            {
                _visorNombre = dto.Nombre;
                _visorMime = dto.Mime;
                _visorKind = dto.Kind;
                _visorDataUri = dto.DataUri;
                _visorHtml = dto.Html;
                _visorTexto = dto.Texto;
            }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _visorCargando = false; }
    }

    // ---- Panel de versiones de una tipologia ----
    private async Task ToggleVersiones(Guid tipId)
    {
        if (_versionesTipId == tipId) { _versionesTipId = Guid.Empty; return; }
        _versionesTipId = tipId;
        _versionesCargando = true; _versionesLista = new();
        StateHasChanged();
        try { _versionesLista = await Auth().GetFromJsonAsync<List<TipologiaVersionDto>>($"/api/expedientes/tipologias/{tipId}/versiones") ?? new(); }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _versionesCargando = false; }
    }

    private async Task DescargarVersionTip(Guid tipId, Guid versionId)
    {
        try
        {
            var dto = await Auth().GetFromJsonAsync<DescargaDocumentoDto>($"/api/expedientes/tipologias/{tipId}/versiones/{versionId}/descargar");
            if (dto is not null) await Js.InvokeVoidAsync("propiaUI.downloadBase64", dto.NombreArchivo, dto.TipoMime, dto.ContenidoBase64);
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

