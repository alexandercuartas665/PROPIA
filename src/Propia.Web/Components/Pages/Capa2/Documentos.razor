@page "/documentos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Documentos
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Folders
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject IModalService Modals

<PageTitle>Documentos - PROPIA</PageTitle>

@* Modulo 2.15 Documentos (v2 "Folders", maqueta expedientes-v2). 2 vistas:
     Folders  -> /api/folders  (tarjetas de los folders raiz; "Configurar folders" y "Nuevo folder")
     Archivo central -> /api/documentos (sin cambios).
   CSS del modulo en css/modules/folders.css, acotado bajo el wrapper .xpd (igual que la maqueta). *@

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="xpd">
<div class="doc-wrap">
    <div class="doc-head">
        <div>
            <h1 class="doc-title">Documentos</h1>
            <p class="doc-sub">Archivo digital de la copropiedad &mdash; folders de documentos y archivo central.</p>
        </div>
        @if (_view == "folders")
        {
            <div class="doc-head-actions">
                <button type="button" class="doc-btn-soft" @onclick="() => _showCfg = true"><i class="fi fi-rr-settings"></i> Configurar folders</button>
                <button type="button" class="doc-btn-primary" @onclick="AbrirNuevoFolder"><i class="fi fi-rr-folder-open"></i> Nuevo folder</button>
            </div>
        }
        else
        {
            <button type="button" class="doc-btn-primary" @onclick="AbrirSubir"><i class="fi fi-rr-cloud-upload"></i> Subir documento</button>
        }
    </div>

    @* Toggle de vistas *@
    <div class="doc-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="@((_view == "folders").ToString().ToLowerInvariant())" class="doc-tab @(_view == "folders" ? "on" : "")" @onclick='() => SetView("folders")'><i class="fi fi-rr-folder"></i> Folders</button>
        <button type="button" role="tab" aria-selected="@((_view == "archivo").ToString().ToLowerInvariant())" class="doc-tab @(_view == "archivo" ? "on" : "")" @onclick='() => SetView("archivo")'><i class="fi fi-rr-box"></i> Archivo central</button>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="doc-banner @(_msgClass == "alert-danger" ? "err" : (_msgClass == "alert-success" ? "ok" : "info"))" role="status">@_msg</div>
    }

    @* ====================== VISTA FOLDERS ====================== *@
    @if (_view == "folders")
    {
        @if (_tarjetas is null)
        {
            <div class="doc-loading"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
        }
        else if (_tarjetas.Count == 0)
        {
            <div class="doc-empty"><i class="fi fi-rr-folder-open"></i><div>Aún no hay folders. Crea el primero con "Nuevo folder" o configura la estructura.</div></div>
        }
        else
        {
            <div class="exp-grid">
                @foreach (var t in _tarjetas)
                {
                    var tt = t;
                    var pct = t.Total > 0 ? (int)Math.Round(t.Cargados * 100.0 / t.Total) : 0;
                    <button type="button" class="exp-card" @onclick="() => AbrirFolder(tt)" title="Abrir el folder @t.Nombre">
                        <div class="exp-card-top">
                            <span class="exp-serie xpd-brand-pill"><i class="fi fi-rr-folder" style="margin-right:4px"></i>@(t.Subfolders == 1 ? "1 subfolder" : $"{t.Subfolders} subfolders")</span>
                            @if (!string.IsNullOrEmpty(t.Codigo)) { <span class="exp-codigo">@t.Codigo</span> }
                        </div>
                        <div class="exp-nombre">@t.Nombre</div>
                        <div class="exp-subserie">@(t.Total == 1 ? "1 documento" : $"{t.Total} documentos")@(t.UltimaCarga is { } uc ? $" · última carga {uc.LocalDateTime:dd MMM yyyy}" : "")</div>
                        <div class="exp-progress">
                            <div class="exp-bar" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"><div class="exp-bar-fill" style="width:@pct%"></div></div>
                            <span class="exp-count">@t.Cargados/@t.Total</span>
                        </div>
                        <div class="exp-badges">
                            @if (t.Cargados == t.Total && t.Total > 0)
                            {
                                <span class="exp-badge ok"><i class="fi fi-rr-check"></i> Folder completo</span>
                            }
                            else if (t.PendientesObligatorios > 0)
                            {
                                <span class="exp-badge pend"><i class="fi fi-rr-exclamation"></i> @(t.PendientesObligatorios == 1 ? "1 obligatorio sin cargar" : $"{t.PendientesObligatorios} obligatorios sin cargar")</span>
                            }
                        </div>
                    </button>
                }
            </div>
        }
    }
    else
    {
        @* ====================== VISTA ARCHIVO CENTRAL ====================== *@
        @* Sin KPIs (canon regla 7): del titulo se pasa directo a la barra de busqueda/filtros. *@

        <div class="doc-toolbar">
            <div class="doc-search">
                <i class="fi fi-rr-search"></i>
                <input placeholder="Buscar por título o nombre de archivo..." @bind="_query" @bind:event="oninput" @onkeyup="CargarDocumentosAsync" />
                @if (_documentos is not null) { <span class="doc-search-count">@_documentos.Total resultado(s)</span> }
            </div>
            <select class="doc-select" @bind="_filtroEstado" @bind:after="CargarDocumentosAsync">
                <option value="">Todos los estados</option>
                @foreach (var e in Enum.GetValues<EstadoDocumento>()) { <option value="@e">@EstadoTexto(e)</option> }
            </select>
            <select class="doc-select" @bind="_filtroOrigen" @bind:after="CargarDocumentosAsync">
                <option value="">Cualquier origen</option>
                @foreach (var o in Enum.GetValues<OrigenDocumento>()) { <option value="@o">@o</option> }
            </select>
            <label class="doc-star-toggle @(_soloDestacados ? "on" : "")" title="Solo destacados">
                <input type="checkbox" @bind="_soloDestacados" @bind:after="CargarDocumentosAsync" />
                <i class="fi fi-rr-star"></i> Destacados
            </label>
        </div>

        @if (_categorias is not null)
        {
            <div class="doc-cats">
                <button class="doc-chip @(_filtroCategoriaId is null ? "on" : "")" @onclick="() => SeleccionarCategoria(null)">Todas</button>
                @foreach (var c in _categorias)
                {
                    var cid = c.Id;
                    <button class="doc-chip @(_filtroCategoriaId == cid ? "on" : "")" @onclick="() => SeleccionarCategoria(cid)">
                        @if (!string.IsNullOrEmpty(c.Color)) { <span class="doc-chip-dot" style="background:@c.Color"></span> }
                        @c.Nombre <span class="doc-chip-n">@c.NumeroDocumentos</span>
                    </button>
                }
            </div>
        }

        @if (_documentos is null)
        {
            <div class="doc-loading"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
        }
        else if (_documentos.Items.Count == 0)
        {
            <div class="doc-empty"><i class="fi fi-rr-folder-open"></i><div>Sin documentos con los filtros actuales.</div></div>
        }
        else
        {
            <div class="doc-listcard">
                @foreach (var d in _documentos.Items)
                {
                    var did = d.Id;
                    var (eBg, eFg) = EstadoColor(d.Estado);
                    <div class="doc-row">
                        <button class="doc-row-main" @onclick="() => AbrirFicha(did)">
                            <div class="doc-ficon"><i class="fi fi-rr-document"></i></div>
                            <div class="doc-row-body">
                                <div class="doc-row-name">
                                    @if (d.Destacado) { <i class="fi fi-rr-star doc-star copro" title="Destacado por la copropiedad"></i> }
                                    else if (d.DestacadoPersonal) { <i class="fi fi-rr-star doc-star pers" title="Destacado personal"></i> }
                                    @d.Titulo
                                </div>
                                <div class="doc-row-meta">@d.CategoriaNombre &middot; @FormatBytes(d.TamanoBytes) &middot; v@(d.NumeroVersiones) &middot; @((d.UpdatedAt ?? d.CreadoAt).LocalDateTime.ToString("dd MMM yyyy")) &middot; origen: @d.Origen</div>
                                @if (d.Etiquetas.Count > 0)
                                {
                                    <div class="doc-row-tags">
                                        @foreach (var et in d.Etiquetas.Take(4))
                                        {
                                            var col = string.IsNullOrEmpty(et.Color) ? "#6D4FE3" : et.Color;
                                            <span class="doc-tag" style="color:@col;border-color:@(col)55">@et.Nombre</span>
                                        }
                                    </div>
                                }
                            </div>
                        </button>
                        <span class="doc-estado" style="background:@eBg;color:@eFg">@EstadoTexto(d.Estado)</span>
                        <button class="doc-row-act" title="Descargar" @onclick="() => Descargar(did)"><i class="fi fi-rr-download"></i></button>
                    </div>
                }
                @if (_documentos.Total > _documentos.PageSize)
                {
                    <div class="doc-pager">
                        <span>@_documentos.Items.Count de @_documentos.Total</span>
                        <div class="doc-pager-btns">
                            <button class="doc-btn-ghost sm" disabled="@(_page <= 1)" @onclick="() => CambiarPagina(_page - 1)">Anterior</button>
                            <span class="doc-pager-page">Página @_page</span>
                            <button class="doc-btn-ghost sm" disabled="@(_page * _documentos.PageSize >= _documentos.Total)" @onclick="() => CambiarPagina(_page + 1)">Siguiente</button>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@* ===================== Modal: nuevo folder ===================== *@
@if (_showNuevo)
{
    <NuevoFolderModal Jwt="@_jwt" Arbol="@(_arbol ?? new())" Creado="OnFolderCreado" Cerrado="() => _showNuevo = false" />
}

@* ===================== Modal: configurar folders (3 columnas) ===================== *@
@if (_showCfg)
{
    <ConfigurarFoldersModal Jwt="@_jwt" Cambio="CargarFoldersAsync" Cerrado="() => _showCfg = false" />
}

@* ===================== Modal: explorador de folders (5 columnas) ===================== *@
@if (_explorarId is { } xid)
{
    <ExploradorFoldersModal Jwt="@_jwt" FolderInicial="xid" @bind-ChatOculto="_chatOculto" Cambio="CargarFoldersAsync" Cerrado="() => _explorarId = null" />
}

@* ===================== Modal: subir documento (Archivo central) ===================== *@
@if (_showSubir)
{
    <div class="doc-ov" @onclick="() => _showSubir = false"></div>
    <div class="doc-modal" style="width:min(620px,96vw); max-height:90vh;">
        <div class="doc-modal-head"><h5 class="mb-0">Subir documento</h5><button class="doc-x" @onclick="() => _showSubir = false"><i class="fi fi-rr-cross-small"></i></button></div>
        <div class="doc-modal-body">
            <label class="doc-lbl">Título *</label>
            <input class="doc-input mb-2" @bind="_subirTitulo" @bind:event="oninput" maxlength="200" />
            <label class="doc-lbl">Descripción</label>
            <textarea class="doc-input mb-2" rows="2" @bind="_subirDescripcion" @bind:event="oninput"></textarea>
            <div class="doc-grid2">
                <div>
                    <label class="doc-lbl">Categoría *</label>
                    <select class="doc-input" @bind="_subirCategoriaId">
                        <option value="">Seleccionar...</option>
                        @if (_categorias is not null) { @foreach (var c in _categorias) { <option value="@c.Id">@c.Nombre</option> } }
                    </select>
                </div>
                <div>
                    <label class="doc-lbl">Visibilidad</label>
                    <select class="doc-input" @bind="_subirVisibilidad">
                        <option value="EQUIPO">Equipo (administración)</option>
                        <option value="PUBLICO">Público (residentes)</option>
                        <option value="PRIVADO">Privado (solo yo)</option>
                    </select>
                </div>
            </div>
            <label class="doc-lbl mt-2">Archivo *</label>
            <label class="doc-dropzone">
                <i class="fi fi-rr-cloud-upload"></i>
                <span>@(string.IsNullOrEmpty(_subirNombreArchivo) ? "Arrastra o selecciona el archivo" : _subirNombreArchivo)</span>
                <small>@(string.IsNullOrEmpty(_subirNombreArchivo) ? "PDF, imagen o documento (max 20MB)" : FormatBytes(_subirTamano))</small>
                <InputFile OnChange="OnArchivoSeleccionado" style="display:none" />
            </label>
            @if (_etiquetas is not null && _etiquetas.Count > 0)
            {
                <label class="doc-lbl mt-2">Etiquetas</label>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var e in _etiquetas)
                    {
                        var eid = e.Id;
                        var sel = _subirEtiquetaIds.Contains(eid);
                        var col = string.IsNullOrEmpty(e.Color) ? "#6D4FE3" : e.Color;
                        <button type="button" class="doc-tagbtn @(sel ? "on" : "")" style="@(sel ? $"background:{col};border-color:{col};color:#fff" : $"color:{col};border-color:{col}55")" @onclick="() => ToggleEtiqueta(eid)">@e.Nombre</button>
                    }
                </div>
            }
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="doc-btn-ghost" @onclick="() => _showSubir = false">Cancelar</button>
                <button class="doc-btn-primary" @onclick="ConfirmarSubir" disabled="@(_busy || string.IsNullOrWhiteSpace(_subirTitulo) || _subirCategoriaId == Guid.Empty || string.IsNullOrEmpty(_subirContenidoB64))">@(_busy ? "Subiendo..." : "Subir documento")</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal: ficha (Archivo central) ===================== *@
@if (_ficha is not null)
{
    var d = _ficha;
    var (fBg, fFg) = EstadoColor(d.Estado);
    <div class="doc-ov" @onclick="() => _ficha = null"></div>
    <div class="doc-modal" style="width:min(820px,96vw); max-height:92vh;">
        <div class="doc-modal-head">
            <div class="d-flex align-items-center gap-3" style="min-width:0;">
                <div class="doc-ficon lg"><i class="fi fi-rr-document"></i></div>
                <div style="min-width:0;"><h5 class="mb-0 text-truncate">@d.Titulo</h5><div class="doc-sub" style="margin:2px 0 0;">@d.NombreArchivoOriginal &middot; @d.CategoriaNombre</div></div>
            </div>
            <button class="doc-x" @onclick="() => _ficha = null"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="doc-modal-body" style="overflow-y:auto;">
            @if (!string.IsNullOrEmpty(d.Descripcion)) { <p class="doc-sub" style="margin-bottom:14px;">@d.Descripcion</p> }
            <div class="doc-meta-grid">
                <div><div class="doc-meta-k">Estado</div><span class="doc-estado" style="background:@fBg;color:@fFg">@EstadoTexto(d.Estado)</span></div>
                <div><div class="doc-meta-k">Versión actual</div><div class="doc-meta-v">v@(d.VersionActual.Numero)</div></div>
                <div><div class="doc-meta-k">Tamaño</div><div class="doc-meta-v">@FormatBytes(d.VersionActual.TamanoBytes)</div></div>
                <div><div class="doc-meta-k">Visibilidad</div><div class="doc-meta-v">@d.Visibilidad</div></div>
                <div><div class="doc-meta-k">Origen</div><div class="doc-meta-v">@d.Origen</div></div>
                <div><div class="doc-meta-k">Creado</div><div class="doc-meta-v">@d.CreadoAt.LocalDateTime.ToString("dd MMM yyyy")</div></div>
            </div>
            @if (d.Etiquetas.Count > 0)
            {
                <div class="doc-row-tags" style="margin:0 0 14px;">
                    @foreach (var et in d.Etiquetas) { var col = string.IsNullOrEmpty(et.Color) ? "#6D4FE3" : et.Color; <span class="doc-tag" style="color:@col;border-color:@(col)55">@et.Nombre</span> }
                </div>
            }
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="doc-btn-primary sm" @onclick="() => DescargarVersion(d.Id, d.VersionActual.Id)"><i class="fi fi-rr-download"></i> Descargar actual</button>
                <button class="doc-btn-ghost sm" @onclick="AbrirNuevaVersion">Subir nueva versión</button>
                <button class="doc-btn-ghost sm" @onclick="ToggleDestacadoPersonal">@(d.DestacadoPersonal ? "Quitar destacado" : "Destacar")</button>
                @if (d.Estado == EstadoDocumento.Vigente) { <button class="doc-btn-ghost sm" @onclick="() => CambiarEstado(EstadoDocumento.Archivado)">Archivar</button> }
                else if (d.Estado == EstadoDocumento.Archivado) { <button class="doc-btn-ghost sm" @onclick="() => CambiarEstado(EstadoDocumento.Vigente)">Reactivar</button> }
                <button class="doc-btn-danger sm ms-auto" @onclick="() => EliminarDocumento(d.Id)">Eliminar</button>
            </div>
            @if (_subirNuevaVersionVisible)
            {
                <div class="doc-newver">
                    <div class="doc-lbl mb-1">Nueva versión</div>
                    <label class="doc-dropzone sm"><i class="fi fi-rr-cloud-upload"></i><span>@(string.IsNullOrEmpty(_nuevaVersionNombre) ? "Selecciona el archivo" : _nuevaVersionNombre)</span><InputFile OnChange="OnNuevaVersionArchivo" style="display:none" /></label>
                    <input class="doc-input my-2" placeholder="Notas del cambio (opcional)" @bind="_nuevaVersionNotas" @bind:event="oninput" />
                    <div class="d-flex gap-2"><button class="doc-btn-primary sm" @onclick="ConfirmarNuevaVersion" disabled="@(_busy || string.IsNullOrEmpty(_nuevaVersionContenidoB64))">@(_busy ? "Subiendo..." : "Guardar versión")</button><button class="doc-btn-ghost sm" @onclick="() => _subirNuevaVersionVisible = false">Cancelar</button></div>
                </div>
            }
            @if (d.Historial.Count > 0)
            {
                <div class="doc-section-title">Historial de versiones</div>
                <div class="doc-listcard">
                    @foreach (var v in d.Historial)
                    {
                        var vId = v.Id;
                        <div class="doc-row">
                            <div class="doc-row-main" style="cursor:default;">
                                <div class="doc-ficon sm"><i class="fi fi-rr-time-past"></i></div>
                                <div class="doc-row-body"><div class="doc-row-name">v@(v.Numero) &middot; @v.NombreArchivo</div><div class="doc-row-meta">@FormatBytes(v.TamanoBytes) &middot; @v.CreadoAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</div></div>
                            </div>
                            <button class="doc-row-act" title="Descargar" @onclick="() => DescargarVersion(d.Id, vId)"><i class="fi fi-rr-download"></i></button>
                        </div>
                    }
                </div>
            }
            @if (_auditoria is not null && _auditoria.Count > 0)
            {
                <div class="doc-section-title">Auditoría</div>
                <div class="doc-audit">
                    @foreach (var a in _auditoria.Take(15)) { <div class="doc-audit-row"><span class="doc-audit-ev">@a.TipoEvento</span><span class="doc-audit-at">@a.OcurridoAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</span></div> }
                </div>
            }
        </div>
    </div>
}
</div>
}

<ModalHost />

@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";
    private string _view = "folders";

    // ---- Folders (v2) ----
    private List<FolderTarjetaDto>? _tarjetas;
    private List<FolderNodoDto>? _arbol;
    private bool _showNuevo;
    private bool _showCfg;
    private Guid? _explorarId;
    // El chat del explorador persiste en el API (por copropiedad + folder raiz + usuario); aqui solo la preferencia de ocultarlo.
    private bool _chatOculto;

    // ---- Archivo central ----
    private List<CategoriaDto>? _categorias;
    private List<EtiquetaDto>? _etiquetas;
    private DocumentosPageDto? _documentos;
    private DocumentoDetalleDto? _ficha;
    private List<AuditoriaEventoDto>? _auditoria;
    private ResumenDocumentosDto? _resumen;
    private Guid? _filtroCategoriaId;
    private string _filtroEstado = "";
    private string _filtroOrigen = "";
    private string _query = "";
    private bool _soloDestacados;
    private int _page = 1;
    private bool _showSubir;
    private string? _subirTitulo, _subirDescripcion, _subirNombreArchivo, _subirMime, _subirContenidoB64;
    private Guid _subirCategoriaId = Guid.Empty;
    private string _subirVisibilidad = "EQUIPO";
    private long _subirTamano;
    private List<Guid> _subirEtiquetaIds = new();
    private bool _subirNuevaVersionVisible;
    private string? _nuevaVersionNombre, _nuevaVersionMime, _nuevaVersionContenidoB64, _nuevaVersionNotas;
    private long _nuevaVersionTamano;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored)) { _jwt = stored; await CargarFoldersAsync(); StateHasChanged(); }
        }
        catch { }
    }

    private async Task SetView(string v)
    {
        _view = v; _msg = null;
        if (v == "folders" && _tarjetas is null) await CargarFoldersAsync();
        if (v == "archivo" && _documentos is null) await CargarArchivoAsync();
    }

    // ===================== Folders =====================
    private async Task CargarFoldersAsync()
    {
        try
        {
            var http = Auth();
            _tarjetas = await http.GetFromJsonAsync<List<FolderTarjetaDto>>("/api/folders/tarjetas") ?? new();
            _arbol = await http.GetFromJsonAsync<List<FolderNodoDto>>("/api/folders/arbol") ?? new();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task AbrirNuevoFolder()
    {
        if (_arbol is null) await CargarFoldersAsync();
        _showNuevo = true;
    }

    private async Task OnFolderCreado(FolderNodoDto f)
    {
        _showNuevo = false;
        _msg = $"Folder “{f.Nombre}” creado."; _msgClass = "alert-success";
        await CargarFoldersAsync();
    }

    private void AbrirFolder(FolderTarjetaDto t) { _msg = null; _explorarId = t.Id; }

    // ===================== Archivo central =====================
    private async Task CargarArchivoAsync()
    {
        try
        {
            var http = Auth();
            _resumen = await http.GetFromJsonAsync<ResumenDocumentosDto>("/api/documentos/resumen");
            _categorias = await http.GetFromJsonAsync<List<CategoriaDto>>("/api/documentos/categorias");
            _etiquetas = await http.GetFromJsonAsync<List<EtiquetaDto>>("/api/documentos/etiquetas");
            await CargarDocumentosAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task CargarDocumentosAsync()
    {
        try
        {
            var qp = new List<string>();
            if (_filtroCategoriaId is { } c) qp.Add($"categoriaId={c}");
            if (!string.IsNullOrEmpty(_filtroEstado)) qp.Add($"estado={_filtroEstado}");
            if (!string.IsNullOrEmpty(_filtroOrigen)) qp.Add($"origen={_filtroOrigen}");
            if (!string.IsNullOrEmpty(_query)) qp.Add($"q={Uri.EscapeDataString(_query)}");
            if (_soloDestacados) qp.Add("destacados=true");
            qp.Add($"page={_page}");
            _documentos = await Auth().GetFromJsonAsync<DocumentosPageDto>("/api/documentos?" + string.Join("&", qp));
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task SeleccionarCategoria(Guid? id) { _filtroCategoriaId = id; _page = 1; await CargarDocumentosAsync(); }
    private async Task CambiarPagina(int p) { _page = p; await CargarDocumentosAsync(); }

    private void AbrirSubir()
    {
        _showSubir = true;
        _subirTitulo = _subirDescripcion = null; _subirCategoriaId = Guid.Empty; _subirVisibilidad = "EQUIPO";
        _subirNombreArchivo = _subirMime = _subirContenidoB64 = null; _subirTamano = 0; _subirEtiquetaIds.Clear();
    }

    private async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (f.Size > 20_000_000) { _msg = "El archivo excede 20MB"; _msgClass = "alert-danger"; return; }
        _subirNombreArchivo = f.Name;
        _subirMime = string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType;
        _subirTamano = f.Size;
        using var ms = new MemoryStream();
        await f.OpenReadStream(20_000_000).CopyToAsync(ms);
        _subirContenidoB64 = Convert.ToBase64String(ms.ToArray());
    }

    private void ToggleEtiqueta(Guid id) { if (!_subirEtiquetaIds.Remove(id)) _subirEtiquetaIds.Add(id); }

    private async Task ConfirmarSubir()
    {
        _busy = true; _msg = null;
        try
        {
            var req = new SubirDocumentoRequest(_subirCategoriaId, null, _subirTitulo!, _subirDescripcion,
                _subirNombreArchivo!, _subirMime!, _subirTamano, _subirContenidoB64!, _subirVisibilidad,
                _subirEtiquetaIds.Count > 0 ? _subirEtiquetaIds : null, OrigenDocumento.Manual, null);
            var resp = await Auth().PostAsJsonAsync("/api/documentos", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Documento subido."; _msgClass = "alert-success"; _showSubir = false;
            await CargarArchivoAsync();
        }
        finally { _busy = false; }
    }

    private async Task AbrirFicha(Guid id)
    {
        try
        {
            _ficha = await Auth().GetFromJsonAsync<DocumentoDetalleDto>($"/api/documentos/{id}");
            _auditoria = await Auth().GetFromJsonAsync<List<AuditoriaEventoDto>>($"/api/documentos/{id}/auditoria");
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task Descargar(Guid id) => await DescargarVersion(id, null);

    private async Task DescargarVersion(Guid id, Guid? versionId)
    {
        try
        {
            var url = $"/api/documentos/{id}/descargar" + (versionId is { } v ? $"?versionId={v}" : "");
            var dto = await Auth().GetFromJsonAsync<DescargaDocumentoDto>(url);
            if (dto is not null) await Js.InvokeVoidAsync("propiaUI.downloadBase64", dto.NombreArchivo, dto.TipoMime, dto.ContenidoBase64);
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private void AbrirNuevaVersion()
    {
        _subirNuevaVersionVisible = true;
        _nuevaVersionNombre = _nuevaVersionMime = _nuevaVersionContenidoB64 = _nuevaVersionNotas = null; _nuevaVersionTamano = 0;
    }

    private async Task OnNuevaVersionArchivo(InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (f.Size > 20_000_000) { _msg = "El archivo excede 20MB"; _msgClass = "alert-danger"; return; }
        _nuevaVersionNombre = f.Name;
        _nuevaVersionMime = string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType;
        _nuevaVersionTamano = f.Size;
        using var ms = new MemoryStream();
        await f.OpenReadStream(20_000_000).CopyToAsync(ms);
        _nuevaVersionContenidoB64 = Convert.ToBase64String(ms.ToArray());
    }

    private async Task ConfirmarNuevaVersion()
    {
        if (_ficha is null) return;
        _busy = true;
        try
        {
            var req = new NuevaVersionRequest(_nuevaVersionNombre!, _nuevaVersionMime!, _nuevaVersionTamano, _nuevaVersionContenidoB64!, _nuevaVersionNotas);
            var resp = await Auth().PostAsJsonAsync($"/api/documentos/{_ficha.Id}/versiones", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _subirNuevaVersionVisible = false;
            await AbrirFicha(_ficha.Id);
            await CargarDocumentosAsync();
        }
        finally { _busy = false; }
    }

    private async Task ToggleDestacadoPersonal()
    {
        if (_ficha is null) return;
        var url = $"/api/documentos/{_ficha.Id}/destacado-personal";
        var resp = _ficha.DestacadoPersonal ? await Auth().DeleteAsync(url) : await Auth().PostAsync(url, null);
        if (resp.IsSuccessStatusCode) { await AbrirFicha(_ficha.Id); await CargarDocumentosAsync(); }
    }

    private async Task CambiarEstado(EstadoDocumento nuevo)
    {
        if (_ficha is null) return;
        var resp = await Auth().PutAsJsonAsync($"/api/documentos/{_ficha.Id}/estado", new CambiarEstadoRequest(nuevo));
        if (resp.IsSuccessStatusCode) { await AbrirFicha(_ficha.Id); await CargarDocumentosAsync(); }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    private async Task EliminarDocumento(Guid id)
    {
        if (!await Modals.ConfirmAsync("¿Eliminar este documento? Quedará archivado (no se borra físicamente).", "Eliminar documento")) return;
        var resp = await Auth().DeleteAsync($"/api/documentos/{id}");
        if (resp.IsSuccessStatusCode) { _ficha = null; await CargarArchivoAsync(); }
    }

    // ===================== Helpers =====================
    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "-";
        string[] units = { "B", "KB", "MB", "GB" };
        var i = 0; double size = bytes;
        while (size >= 1024 && i < units.Length - 1) { size /= 1024; i++; }
        return $"{size:0.#} {units[i]}";
    }

    private static string EstadoTexto(EstadoDocumento e) => e switch
    {
        EstadoDocumento.Borrador => "Borrador",
        EstadoDocumento.Vigente => "Vigente",
        EstadoDocumento.EnFirma => "En firma",
        EstadoDocumento.Firmado => "Firmado",
        EstadoDocumento.Archivado => "Archivado",
        _ => e.ToString()
    };

    private static (string bg, string fg) EstadoColor(EstadoDocumento e) => e switch
    {
        EstadoDocumento.Borrador => ("#EEF3F8", "#516F90"),
        EstadoDocumento.Vigente => ("#E6F6EE", "#1A8754"),
        EstadoDocumento.EnFirma => ("#FEF3DC", "#B45309"),
        EstadoDocumento.Firmado => ("#F1ECFD", "#6D4FE3"),
        EstadoDocumento.Archivado => ("#F4F7FA", "#A6B7C8"),
        _ => ("#EEF3F8", "#516F90")
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}
