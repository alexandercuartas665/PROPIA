    private async Task CrearExpediente()
    {
        _neError = null;
        if (string.IsNullOrWhiteSpace(_neNombre) || _neSubserieId == Guid.Empty) { _neError = "Indica nombre, serie y subserie."; return; }
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/expedientes", new CrearExpedienteRequest(_neSubserieId, _neNombre!));
            if (!resp.IsSuccessStatusCode) { _neError = await resp.Content.ReadAsStringAsync(); return; }
            var dto = await resp.Content.ReadFromJsonAsync<ExpedienteDetalleDto>();
            _showNuevoExp = false;
            await CargarExpedientesAsync();
            if (dto is not null) { _expDetalle = dto; _expSelTip = Guid.Empty; }
        }
        catch (Exception ex) { _neError = ex.Message; }
        finally { _busy = false; }
    }

