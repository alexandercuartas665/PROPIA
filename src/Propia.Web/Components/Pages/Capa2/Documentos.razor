    .exp-chips { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
    .exp-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 600; color: #516F90; background: #fff; border: 1px solid #E1E8EE; padding: 5px 9px; border-radius: 8px; }
