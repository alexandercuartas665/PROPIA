    .doc-btn-soft:hover:not(:disabled) { background: #E6DEFA; }
    .doc-btn-soft.sm { padding: 6px 11px; font-size: 12px; }
    .doc-btn-soft:disabled { opacity: .5; cursor: default; }
    .doc-btn-ghost { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #E1E8EE; background: #fff; color: #516F90; font-weight: 600; font-size: 13px; padding: 8px 14px; border-radius: 10px; cursor: pointer; }
    .doc-btn-ghost:hover:not(:disabled) { border-color: #6D4FE3; color: #6D4FE3; }
    .doc-btn-ghost.sm { padding: 6px 12px; font-size: 12.5px; }
    .doc-btn-ghost:disabled { opacity: .5; cursor: default; }
