@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";
    private string _view = "expedientes";

    // ---- Expedientes (TRD) ----
    private List<ExpedienteListaDto>? _expedientes;
    private List<TrdSerieDto>? _trd;
    private ExpedienteDetalleDto? _expDetalle;
    private Guid _expSelTip;
