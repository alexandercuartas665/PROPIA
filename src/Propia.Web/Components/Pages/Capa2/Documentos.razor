    .doc-dropzone small { font-size: 10.5px; color: #9A86E8; }
    .doc-tagbtn { font-size: 11px; font-weight: 700; padding: 4px 11px; border-radius: 999px; border: 1px solid; background: #fff; cursor: pointer; }
