    // ===================== Helpers =====================
    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "-";
        string[] units = { "B", "KB", "MB", "GB" };
        var i = 0; double size = bytes;
        while (size >= 1024 && i < units.Length - 1) { size /= 1024; i++; }
        return $"{size:0.#} {units[i]}";
    }

    private static string Ext(string? nombre) => string.IsNullOrEmpty(nombre) ? "" : (nombre.Contains('.') ? nombre[(nombre.LastIndexOf('.') + 1)..].ToUpperInvariant() : "");

    private static (string, string) SerieColor(string serie)
    {
        if (serie.StartsWith("Actas", StringComparison.OrdinalIgnoreCase)) return ("#6D4FE3", "#F1ECFD");
        if (serie.StartsWith("Contratos", StringComparison.OrdinalIgnoreCase)) return ("#2563EB", "#E6F2FB");
        if (serie.StartsWith("Financ", StringComparison.OrdinalIgnoreCase)) return ("#1A8754", "#E6F6EE");
        if (serie.StartsWith("Legal", StringComparison.OrdinalIgnoreCase)) return ("#B45309", "#FEF3DC");
        return ("#516F90", "#EEF3F8");
    }

    private static string EstadoTexto(EstadoDocumento e) => e switch
    {
        EstadoDocumento.Borrador => "Borrador",
        EstadoDocumento.Vigente => "Vigente",
        EstadoDocumento.EnFirma => "En firma",
        EstadoDocumento.Firmado => "Firmado",
        EstadoDocumento.Archivado => "Archivado",
        _ => e.ToString()
    };

    private static (string bg, string fg) EstadoColor(EstadoDocumento e) => e switch
    {
        EstadoDocumento.Borrador => ("#EEF3F8", "#516F90"),
        EstadoDocumento.Vigente => ("#E6F6EE", "#1A8754"),
        EstadoDocumento.EnFirma => ("#FEF3DC", "#B45309"),
        EstadoDocumento.Firmado => ("#F1ECFD", "#6D4FE3"),
        EstadoDocumento.Archivado => ("#F4F7FA", "#A6B7C8"),
        _ => ("#EEF3F8", "#516F90")
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
