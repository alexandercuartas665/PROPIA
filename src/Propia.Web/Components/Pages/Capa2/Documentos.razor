    private Guid _cfgSubSel;
    private string? _cfgNuevaSerie, _cfgNuevaSub, _cfgNuevaTip, _cfgNuevoCampo;

    // Cargar tipologia
    private bool _showCargar;
    private Guid _cargarTipId;
    private string? _cargarTipNombre;
    private string? _cargarNombre, _cargarMime, _cargarB64, _cargarError, _cargarNotas;
