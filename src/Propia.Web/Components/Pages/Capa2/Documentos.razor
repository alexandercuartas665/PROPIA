    .doc-btn-danger.sm { padding: 6px 11px; }

    .doc-tabs { display: flex; gap: 8px; margin-bottom: 16px; }
    .doc-tab { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 700; padding: 9px 16px; border-radius: 10px; border: 1px solid #E1E8EE; color: #516F90; background: #fff; cursor: pointer; }
    .doc-tab:hover { border-color: #6D4FE3; }
    .doc-tab.on { background: #6D4FE3; color: #fff; border-color: #6D4FE3; }

    .doc-banner { border-radius: 11px; padding: 10px 14px; font-size: 12.5px; font-weight: 600; margin-bottom: 12px; }
    .doc-banner.ok { background: #E6F6EE; border: 1px solid #B6E2C9; color: #15703F; }
    .doc-banner.err { background: #FDE7E7; border: 1px solid #F5C2C2; color: #A1352E; }
    .doc-banner.info { background: #EAF1FB; border: 1px solid #C9DCF5; color: #2E5AA1; }
    .doc-loading { text-align: center; padding: 50px 0; }
    .doc-empty { background: #fff; border: 1px dashed #D6DEE6; border-radius: 14px; padding: 40px 20px; text-align: center; color: #A6B7C8; font-size: 13.5px; }
    .doc-empty i { display: block; font-size: 30px; margin-bottom: 10px; color: #C3D0DD; }

    /* Expedientes grid */
    .exp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
    .exp-card { text-align: left; background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; padding: 18px; box-shadow: 0 1px 2px rgba(45,62,80,.05); cursor: pointer; }
