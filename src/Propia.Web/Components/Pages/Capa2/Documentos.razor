    private void AbrirCargar(Guid expId, Guid tipId)
    {
        var tip = _expDetalle?.Tipologias.FirstOrDefault(t => t.Id == tipId);
        _cargarTipId = tipId;
        _cargarTipNombre = (_expDetalle?.Nombre ?? "") + " - " + (tip?.Nombre ?? "");
        _cargarNombre = _cargarMime = _cargarB64 = _cargarError = _cargarNotas = null;
        _cargarTamano = 0;
        _cargarCampos = _expDetalle?.Campos.ToList() ?? new();
        _cargarMeta.Clear();
        if (tip is not null) foreach (var mp in tip.Meta) _cargarMeta[mp.Clave] = mp.Valor;
        _showCargar = true;
    }

    private async Task OnCargarArchivo(InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (f.Size > 20_000_000) { _cargarError = "El archivo excede 20MB"; return; }
        _cargarNombre = f.Name;
        _cargarMime = string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType;
        _cargarTamano = f.Size;
        using var ms = new MemoryStream();
        await f.OpenReadStream(20_000_000).CopyToAsync(ms);
        _cargarB64 = Convert.ToBase64String(ms.ToArray());
    }

    private async Task GuardarCargar()
    {
        if (string.IsNullOrEmpty(_cargarB64)) return;
        _busy = true; _cargarError = null;
        try
        {
            var meta = _cargarMeta.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).Select(kv => new ExpedienteMetaValorDto(kv.Key, kv.Value)).ToList();
            var req = new CargarTipologiaRequest(_cargarNombre!, _cargarMime!, _cargarTamano, _cargarB64!, meta, _cargarNotas);
            var resp = await Auth().PostAsJsonAsync($"/api/expedientes/tipologias/{_cargarTipId}/cargar", req);
            if (!resp.IsSuccessStatusCode) { _cargarError = await resp.Content.ReadAsStringAsync(); return; }
            _showCargar = false;
            var tipId = _cargarTipId;
            await RecargarDetalleAsync();
            _expSelTip = tipId;
            // si el panel de versiones estaba abierto para esta tipologia, refrescalo
            if (_versionesTipId == tipId) { _versionesTipId = Guid.Empty; await ToggleVersiones(tipId); }
            await CargarVisorActual(tipId);
        }
        catch (Exception ex) { _cargarError = ex.Message; }
        finally { _busy = false; }
    }

