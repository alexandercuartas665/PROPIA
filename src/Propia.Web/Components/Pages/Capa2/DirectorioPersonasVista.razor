@* Vista de personas del Directorio: alterna Lista (filas) y Tabla (todas las columnas
   con alta inline, estilo tablero). Extraida de Directorio.razor para no engrosar la pagina,
   que aporta las clases dir-* y dtab-*; aqui solo va .dvp-grid. *@
@using Propia.Application.Directorio
@using Propia.Domain.Enums

@* El toggle Lista/Tabla vive en la pagina (barra de filtros), no aqui: la vista llega por
   parametro para que la seleccion se comparta entre pestanas y se pueda persistir. *@
@if (Personas is null)
{
    <div class="dir-loading"><div class="spinner-border" style="color: var(--propia-brand, #6D4FE3);"></div></div>
}
else if (Vista == "lista")
{
    @if (Personas.Count == 0)
    {
        <div class="dir-empty">
            <strong>Sin personas vinculadas a esta copropiedad aun.</strong>
            <span>Usa la vista Tabla para agregar la primera, o el boton Agregar de arriba.</span>
        </div>
    }
    else
    {
        <div class="dir-list">
            @foreach (var p in Personas)
            {
                var pid = p.Id;
                <button type="button" class="dir-row" @onclick="() => OnAbrir.InvokeAsync(pid)">
                    <div class="dir-avatar dir-avatar--persona">@Iniciales(p.Nombres, p.Apellidos)</div>
                    <div class="dir-col-main">
                        <div class="dir-name">@p.Nombres @p.Apellidos</div>
                        <div class="dir-meta">@p.TipoDocumento @p.Documento</div>
                    </div>
                    <div class="dir-tags">
                        @if (p.Etiquetas is not null)
                        {
                            @foreach (var et in p.Etiquetas)
                            {
                                <span class="dir-tag dir-tag--et" style="@ChipStyle(et.Color)">@(string.IsNullOrEmpty(et.Icono) ? "" : et.Icono + " ")@et.Nombre</span>
                            }
                        }
                        @if (p.PerfilIncompleto) { <span class="dir-tag dir-tag--warn">Incompleto</span> }
                    </div>
                    <div class="dir-unidad">@(p.Telefono ?? "")</div>
                    <div class="dir-estado">
                        @if (p.Estado == EstadoDirectorio.Activo)
                        {
                            <span class="dir-dot dir-dot--ok"></span>
                            <span class="dir-estado-txt dir-estado-txt--ok">Activo</span>
                        }
                        else
                        {
                            <span class="dir-dot dir-dot--off"></span>
                            <span class="dir-estado-txt dir-estado-txt--off">@p.Estado</span>
                        }
                    </div>
                    <svg class="dir-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C3D0DD" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                </button>
            }
        </div>
    }
}
else
{
    @* Tabla: todas las columnas + fila de alta inline (estilo tablero) *@
    <div class="dtab-table">
        <div class="dtab-scroll">
            <div class="dtab-head dvp-grid">
                <div>TIPO</div><div>DOCUMENTO</div><div>NOMBRES</div><div>APELLIDOS</div><div>EMAIL</div><div>TELEFONO</div><div>ESTADO</div><div></div>
            </div>
            @foreach (var p in Personas)
            {
                var pid = p.Id;
                <div class="dtab-row dvp-grid">
                    <div class="dtab-c">@p.TipoDocumento</div>
                    <div class="dtab-c">@p.Documento</div>
                    <button type="button" class="dtab-link" @onclick="() => OnAbrir.InvokeAsync(pid)" title="Abrir ficha">@p.Nombres</button>
                    <div class="dtab-c">@p.Apellidos</div>
                    <div class="dtab-c">@(p.Email ?? "-")</div>
                    <div class="dtab-c">@(p.Telefono ?? "-")</div>
                    <div class="dtab-c">
                        @if (p.Estado == EstadoDirectorio.Activo) { <span class="dtab-badge dtab-badge--ok">Activo</span> }
                        else { <span class="dtab-badge">@p.Estado</span> }
                    </div>
                    <div class="dtab-act">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C3D0DD" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                    </div>
                </div>
            }
            @* Fila nueva: alta inline con todos los campos.
               @@key limpia la fila al crear (recrea los inputs); los inputs usan @@oninput SIN
               value= para no perder pulsaciones en Blazor Server (value= se reafirma en cada
               re-render y pisa lo escrito mientras el round-trip esta en vuelo). *@
            <div class="dtab-newrow dvp-grid" @key="_nonce">
                <div class="dtab-nf-first">
                    <span class="dtab-nf-plus">+</span>
                    <select class="dtab-inp" @bind="_draft.TipoDocumento">
                        <option value="@TipoDocumento.CC">CC</option>
                        <option value="@TipoDocumento.CE">CE</option>
                        <option value="@TipoDocumento.PA">Pasaporte</option>
                        <option value="@TipoDocumento.TI">T. Identidad</option>
                    </select>
                </div>
                <input class="dtab-inp" @ref="_firstRef" placeholder="Documento" @oninput="@(e => _draft.Documento = e.Value?.ToString() ?? string.Empty)" @onkeydown="RowKeydown" />
                <input class="dtab-inp" placeholder="Nueva persona..." @oninput="@(e => _draft.Nombres = e.Value?.ToString() ?? string.Empty)" @onkeydown="RowKeydown" />
                <input class="dtab-inp" placeholder="Apellidos" @oninput="@(e => _draft.Apellidos = e.Value?.ToString() ?? string.Empty)" @onkeydown="RowKeydown" />
                <input class="dtab-inp" placeholder="Email" @oninput="@(e => _draft.Email = e.Value?.ToString())" @onkeydown="RowKeydown" />
                <input class="dtab-inp" placeholder="Telefono" @oninput="@(e => _draft.Telefono = e.Value?.ToString())" @onkeydown="RowKeydown" />
                <div class="dtab-nf-mut">Activo</div>
                <div class="dtab-act">
                    <button type="button" class="dtab-add" title="Agregar (Enter)" @onclick="CrearPersonaInline" disabled="@(_busy || !DraftValido)">+</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<PersonaResumenDto>? Personas { get; set; }
    [Parameter] public EventCallback<Guid> OnAbrir { get; set; }
    [Parameter] public EventCallback<NuevaPersonaDir> OnCrear { get; set; }

    [Parameter] public string Vista { get; set; } = "lista";  // "lista" | "tabla" (la controla Directorio.razor)
    private bool _busy;
    private readonly PersonaDraft _draft = new();
    private int _nonce;                 // cambia al crear: @key recrea la fila y la limpia
    private bool _focusPending;         // devolver el foco al primer campo tras recrear la fila
    private ElementReference _firstRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending) { _focusPending = false; try { await _firstRef.FocusAsync(); } catch { } }
    }

    private bool DraftValido =>
        !string.IsNullOrWhiteSpace(_draft.Documento) &&
        !string.IsNullOrWhiteSpace(_draft.Nombres) &&
        !string.IsNullOrWhiteSpace(_draft.Apellidos);

    private sealed class PersonaDraft
    {
        public TipoDocumento TipoDocumento = TipoDocumento.CC;
        public string Documento = "";
        public string Nombres = "";
        public string Apellidos = "";
        public string? Email;
        public string? Telefono;
        public void Reset() { TipoDocumento = TipoDocumento.CC; Documento = ""; Nombres = ""; Apellidos = ""; Email = null; Telefono = null; }
    }

    private async Task RowKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && DraftValido) await CrearPersonaInline();
    }

    // El componente solo emite los datos; la pagina Directorio hace el POST con su propio Auth().
    private async Task CrearPersonaInline()
    {
        if (!DraftValido) return;
        _busy = true;
        try
        {
            await OnCrear.InvokeAsync(new NuevaPersonaDir(
                _draft.TipoDocumento, _draft.Documento.Trim(),
                _draft.Nombres.Trim(), _draft.Apellidos.Trim(),
                string.IsNullOrWhiteSpace(_draft.Email) ? null : _draft.Email.Trim(),
                string.IsNullOrWhiteSpace(_draft.Telefono) ? null : _draft.Telefono.Trim()));
            _draft.Reset(); _nonce++; _focusPending = true;
        }
        finally { _busy = false; }
    }

    private static string ChipStyle(string? color)
        => string.IsNullOrWhiteSpace(color) ? "" : $"background:{color}1A;color:{color};border-color:{color}55;";

    private static string Iniciales(string? nombres, string? apellidos)
    {
        var n = (nombres ?? "").Trim();
        var a = (apellidos ?? "").Trim();
        var i1 = n.Length > 0 ? n[0].ToString() : "";
        var i2 = a.Length > 0 ? a[0].ToString() : "";
        var r = (i1 + i2).ToUpper();
        return string.IsNullOrEmpty(r) ? "?" : r;
    }
}

<style>
    /* Solo el grid propio de personas; el resto de la tabla (dtab-*) lo define Directorio.razor. */
    /* La primera columna aloja el "+" de la fila de alta junto al select de tipo. */
    .dvp-grid { display: grid; grid-template-columns: 116px 1.1fr 1.2fr 1.2fr 1.6fr 1.1fr 92px 44px; align-items: center; gap: 8px; padding: 8px 14px; min-width: 900px; }
    .dir-tag--et { display: inline-flex; align-items: center; gap: 3px; border: 1px solid #E1D9FA; background: #F5F2FE; color: #6D4FE3; font-weight: 700; }
</style>
