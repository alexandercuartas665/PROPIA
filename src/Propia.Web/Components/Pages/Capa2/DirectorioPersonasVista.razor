@* Vista de personas del Directorio: alterna Lista (filas) y Tabla (todas las columnas
   con alta inline, estilo tablero). Extraida de Directorio.razor para no engrosar la pagina.
   Reusa las clases globales dir-* del <style> de Directorio.razor. *@
@using Propia.Application.Directorio
@using Propia.Domain.Enums

<div class="dvp-bar">
    <div class="dvp-toggle">
        <button type="button" class="dvp-vt @(_view == "lista" ? "on" : "")" @onclick='() => _view = "lista"'>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            Lista
        </button>
        <button type="button" class="dvp-vt @(_view == "tabla" ? "on" : "")" @onclick='() => _view = "tabla"'>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
            Tabla
        </button>
    </div>
</div>

@if (Personas is null)
{
    <div class="dir-loading"><div class="spinner-border" style="color: var(--propia-brand, #6D4FE3);"></div></div>
}
else if (_view == "lista")
{
    @if (Personas.Count == 0)
    {
        <div class="dir-empty">
            <strong>Sin personas vinculadas a esta copropiedad aun.</strong>
            <span>Usa la vista Tabla para agregar la primera, o el boton Agregar de arriba.</span>
        </div>
    }
    else
    {
        <div class="dir-list">
            @foreach (var p in Personas)
            {
                var pid = p.Id;
                <button type="button" class="dir-row" @onclick="() => OnAbrir.InvokeAsync(pid)">
                    <div class="dir-avatar dir-avatar--persona">@Iniciales(p.Nombres, p.Apellidos)</div>
                    <div class="dir-col-main">
                        <div class="dir-name">@p.Nombres @p.Apellidos</div>
                        <div class="dir-meta">@p.TipoDocumento @p.Documento</div>
                    </div>
                    <div class="dir-tags">
                        @if (p.PerfilIncompleto) { <span class="dir-tag dir-tag--warn">Incompleto</span> }
                        @if (!string.IsNullOrEmpty(p.Email)) { <span class="dir-tag dir-tag--mute">@p.Email</span> }
                    </div>
                    <div class="dir-unidad">@(p.Telefono ?? "")</div>
                    <div class="dir-estado">
                        @if (p.Estado == EstadoDirectorio.Activo)
                        {
                            <span class="dir-dot dir-dot--ok"></span>
                            <span class="dir-estado-txt dir-estado-txt--ok">Activo</span>
                        }
                        else
                        {
                            <span class="dir-dot dir-dot--off"></span>
                            <span class="dir-estado-txt dir-estado-txt--off">@p.Estado</span>
                        }
                    </div>
                    <svg class="dir-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C3D0DD" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                </button>
            }
        </div>
    }
}
else
{
    @* Tabla: todas las columnas + fila de alta inline (estilo tablero) *@
    <div class="dvp-table">
        <div class="dvp-scroll">
            <div class="dvp-head dvp-grid">
                <div>TIPO</div><div>DOCUMENTO</div><div>NOMBRES</div><div>APELLIDOS</div><div>EMAIL</div><div>TELEFONO</div><div>ESTADO</div><div></div>
            </div>
            @foreach (var p in Personas)
            {
                var pid = p.Id;
                <div class="dvp-row dvp-grid">
                    <div class="dvp-c">@p.TipoDocumento</div>
                    <div class="dvp-c">@p.Documento</div>
                    <button type="button" class="dvp-link" @onclick="() => OnAbrir.InvokeAsync(pid)" title="Abrir ficha">@p.Nombres</button>
                    <div class="dvp-c">@p.Apellidos</div>
                    <div class="dvp-c">@(p.Email ?? "-")</div>
                    <div class="dvp-c">@(p.Telefono ?? "-")</div>
                    <div class="dvp-c">
                        @if (p.Estado == EstadoDirectorio.Activo) { <span class="dvp-badge dvp-badge--ok">Activo</span> }
                        else { <span class="dvp-badge">@p.Estado</span> }
                    </div>
                    <div class="dvp-act">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C3D0DD" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                    </div>
                </div>
            }
            @* Fila nueva: alta inline con todos los campos *@
            <div class="dvp-newrow dvp-grid">
                <select class="dvp-inp" @bind="_draft.TipoDocumento">
                    <option value="@TipoDocumento.CC">CC</option>
                    <option value="@TipoDocumento.CE">CE</option>
                    <option value="@TipoDocumento.PA">Pasaporte</option>
                    <option value="@TipoDocumento.TI">T. Identidad</option>
                </select>
                <input class="dvp-inp" placeholder="Documento" @bind="_draft.Documento" @bind:event="oninput" @onkeydown="RowKeydown" />
                <input class="dvp-inp" placeholder="Nombres" @bind="_draft.Nombres" @bind:event="oninput" @onkeydown="RowKeydown" />
                <input class="dvp-inp" placeholder="Apellidos" @bind="_draft.Apellidos" @bind:event="oninput" @onkeydown="RowKeydown" />
                <input class="dvp-inp" placeholder="Email" @bind="_draft.Email" @bind:event="oninput" @onkeydown="RowKeydown" />
                <input class="dvp-inp" placeholder="Telefono" @bind="_draft.Telefono" @bind:event="oninput" @onkeydown="RowKeydown" />
                <div class="dvp-c">Activo</div>
                <div class="dvp-act">
                    <button type="button" class="dvp-add" @onclick="CrearPersonaInline" disabled="@(_busy || !DraftValido)">+ Agregar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<PersonaResumenDto>? Personas { get; set; }
    [Parameter] public EventCallback<Guid> OnAbrir { get; set; }
    [Parameter] public EventCallback<NuevaPersonaDir> OnCrear { get; set; }

    private string _view = "lista";
    private bool _busy;
    private readonly PersonaDraft _draft = new();

    private bool DraftValido =>
        !string.IsNullOrWhiteSpace(_draft.Documento) &&
        !string.IsNullOrWhiteSpace(_draft.Nombres) &&
        !string.IsNullOrWhiteSpace(_draft.Apellidos);

    private sealed class PersonaDraft
    {
        public TipoDocumento TipoDocumento = TipoDocumento.CC;
        public string Documento = "";
        public string Nombres = "";
        public string Apellidos = "";
        public string? Email;
        public string? Telefono;
        public void Reset() { TipoDocumento = TipoDocumento.CC; Documento = ""; Nombres = ""; Apellidos = ""; Email = null; Telefono = null; }
    }

    private async Task RowKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && DraftValido) await CrearPersonaInline();
    }

    // El componente solo emite los datos; la pagina Directorio hace el POST con su propio Auth().
    private async Task CrearPersonaInline()
    {
        if (!DraftValido) return;
        _busy = true;
        try
        {
            await OnCrear.InvokeAsync(new NuevaPersonaDir(
                _draft.TipoDocumento, _draft.Documento.Trim(),
                _draft.Nombres.Trim(), _draft.Apellidos.Trim(),
                string.IsNullOrWhiteSpace(_draft.Email) ? null : _draft.Email.Trim(),
                string.IsNullOrWhiteSpace(_draft.Telefono) ? null : _draft.Telefono.Trim()));
            _draft.Reset();
        }
        finally { _busy = false; }
    }

    private static string Iniciales(string? nombres, string? apellidos)
    {
        var n = (nombres ?? "").Trim();
        var a = (apellidos ?? "").Trim();
        var i1 = n.Length > 0 ? n[0].ToString() : "";
        var i2 = a.Length > 0 ? a[0].ToString() : "";
        var r = (i1 + i2).ToUpper();
        return string.IsNullOrEmpty(r) ? "?" : r;
    }
}

<style>
    .dvp-bar { display: flex; justify-content: flex-end; margin-bottom: 10px; }
    .dvp-toggle { display: inline-flex; gap: 2px; background: #EEF2F6; border-radius: 9px; padding: 3px; }
    .dvp-vt { display: inline-flex; align-items: center; gap: 5px; border: 0; background: transparent; color: #6B7C8F; font-size: 12.5px; font-weight: 600; padding: 5px 11px; border-radius: 7px; cursor: pointer; font-family: inherit; }
    .dvp-vt.on { background: #fff; color: var(--propia-brand, #6D4FE3); box-shadow: 0 1px 3px rgba(27,42,58,.12); }

    .dvp-table { border: 1px solid #E1E8EE; border-radius: 11px; overflow: hidden; }
    .dvp-scroll { overflow-x: auto; }
    .dvp-grid { display: grid; grid-template-columns: 96px 1.1fr 1.2fr 1.2fr 1.6fr 1.1fr 92px 44px; align-items: center; gap: 8px; padding: 8px 14px; min-width: 900px; }
    .dvp-head { background: #F7F9FB; font-size: 10.5px; font-weight: 700; color: #90A4B7; letter-spacing: .4px; border-bottom: 1px solid #E1E8EE; }
    .dvp-row { border-bottom: 1px solid #EEF2F6; font-size: 13px; color: #33475B; }
    .dvp-row:hover { background: #FBFCFD; }
    .dvp-c { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dvp-link { border: 0; background: transparent; text-align: left; padding: 0; font-size: 13px; font-weight: 600; color: var(--propia-brand, #6D4FE3); cursor: pointer; font-family: inherit; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dvp-link:hover { text-decoration: underline; }
    .dvp-badge { font-size: 11px; font-weight: 600; color: #516F90; background: #EEF2F6; padding: 2px 8px; border-radius: 6px; }
    .dvp-badge--ok { color: #0F8A4F; background: #E6F6EE; }
    .dvp-act { display: flex; justify-content: flex-end; }
    /* Fila de alta inline: separada y evidente (mismo tratamiento que la de Usuarios). */
    .dvp-newrow { background: #FBFAFE; border-top: 1.5px dashed #DCD2F8; }
    .dvp-inp { width: 100%; border: 1px solid #E1E8EE; border-radius: 7px; padding: 6px 9px; font-size: 12.5px; color: #33475B; outline: none; font-family: inherit; box-sizing: border-box; background: #fff; }
    .dvp-inp:focus { border-color: var(--propia-brand, #6D4FE3); }
    .dvp-add { border: 1px solid var(--propia-brand, #6D4FE3); background: var(--propia-brand, #6D4FE3); color: #fff; font-size: 12px; font-weight: 600; padding: 6px 10px; border-radius: 7px; cursor: pointer; white-space: nowrap; font-family: inherit; }
    .dvp-add:disabled { opacity: .5; cursor: default; }
    .dvp-msg { font-size: 12px; color: #B91C1C; padding: 8px 14px; }
</style>
