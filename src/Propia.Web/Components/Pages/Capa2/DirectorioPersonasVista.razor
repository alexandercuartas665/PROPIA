    .dtab-confirm-s { font-size: 12.5px; color: var(--propia-text-muted); margin: 6px 0 14px; }
    .dtab-confirm-acts { display: flex; justify-content: flex-end; gap: 10px; }
    .dtab-cbtn { border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); border-radius: 8px; padding: 6px 12px; font-size: 12.5px; font-weight: 600; color: var(--propia-text-secondary); cursor: pointer; font-family: inherit; }
    .dtab-cbtn:disabled { opacity: .6; cursor: default; }
    /* Columnas dinamicas: cabecera con engranaje (editar/eliminar) + "+" para crear (espejo de Zonas). */
