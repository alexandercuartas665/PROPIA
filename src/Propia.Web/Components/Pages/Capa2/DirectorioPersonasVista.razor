    .dtab-group-chip { font-size: 12px; }
    .dtab-group-n { font-size: 11.5px; font-weight: 700; color: var(--propia-text-muted); background: var(--propia-bg-card-soft); border-radius: 10px; padding: 1px 9px; }
    /* Header: ordenar (clic) + reordenar (arrastre) + redimensionar (handle). Espejo de Zonas .zc-th-*. */
    .dtab-th-sortable { cursor: pointer; user-select: none; position: relative; display: flex; align-items: center; gap: 6px; min-width: 0; }
    .dtab-th-lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dtab-th-sortable:hover .dtab-th-lbl { color: var(--propia-brand); }
    .dtab-th-arrow { flex: 0 0 auto; font-size: 8px; color: var(--propia-brand); line-height: 1; }
    .dtab-col-rz { position: absolute; top: 0; right: -4px; width: 8px; height: 100%; cursor: col-resize; z-index: 3; }
    .dtab-col-rz::after { content: ""; position: absolute; top: 4px; bottom: 4px; left: 3px; width: 2px; border-radius: 2px; background: transparent; transition: background .12s; }
    .dtab-col-rz:hover::after { background: var(--propia-brand); }
    /* Toast breve para acciones del menu contextual (copiar enlace, stubs). */
    .dtab-toast { position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 4300; background: var(--propia-brand); color: var(--propia-text-inverse); font-size: 12.5px; font-weight: 600; padding: 9px 16px; border-radius: 9px; box-shadow: 0 8px 24px rgba(20,30,50,.28); }
    /* Seleccion multiple + barra bulk + confirmacion (espejo de Zonas .zc-sel*/.zc-selbar/.zc-confirm). */
    .dtab-sel-cell { display: flex; align-items: center; justify-content: center; }
    .dtab-chk { display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
    .dtab-chk input { width: 16px; height: 16px; accent-color: var(--propia-brand); cursor: pointer; margin: 0; }
