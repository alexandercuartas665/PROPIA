@page "/asambleas/nueva"
@rendermode InteractiveServer
@using Propia.Application.Asambleas
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Nueva sesion - PROPIA</PageTitle>

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

<div class="mb-3"><a href="/asambleas" class="text-decoration-none text-muted small">&larr; Asambleas</a></div>

@if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

<ModuloWizard Titulo="Convocar nueva sesion"
              Descripcion="Ley 675/2001 - completa la informacion paso a paso. La sesion queda en estado Borrador."
              FinishLabel="Crear sesion (Borrador)"
              OnFinish="CrearAsync"
              OnCancel="CancelarAsync">

    @* ---------- Paso 1: tipo y modalidad ---------- *@
    <WizardStep Titulo="Tipo y modalidad"
                Descripcion="Define el caracter de la sesion. Esto afecta el quorum minimo y los tipos de mayoria validos por punto."
                CanAdvance="@(() => true)">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small">Tipo de sesion *</label>
                <select class="form-select form-select-sm" @bind="_tipo">
                    @foreach (var t in Enum.GetValues<TipoSesion>())
                    {
                        <option value="@t">@RenderTipoTitulo(t)</option>
                    }
                </select>
                <small class="text-muted d-block mt-1">@TipoAyuda(_tipo)</small>
            </div>
            <div class="col-md-6">
                <label class="form-label small">Modalidad *</label>
                <select class="form-select form-select-sm" @bind="_modalidad">
                    @foreach (var m in Enum.GetValues<ModalidadSesion>())
                    {
                        <option value="@m">@m</option>
                    }
                </select>
                <small class="text-muted d-block mt-1">@ModalidadAyuda(_modalidad)</small>
            </div>
        </div>
    </WizardStep>

    @* ---------- Paso 2: identificacion ---------- *@
    <WizardStep Titulo="Identificacion"
                Descripcion="Nombra la sesion y agenda fecha/hora. Si es Presencial/Mixta indica el lugar; si es Virtual/Mixta indica el enlace."
                CanAdvance="@(() => !string.IsNullOrWhiteSpace(_titulo) && _fecha > DateTime.UtcNow.AddMinutes(-1))"
                MensajeError="Falta titulo o la fecha esta en el pasado.">
        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label small">Titulo *</label>
                <input class="form-control form-control-sm" @bind="_titulo" @bind:event="oninput"
                       placeholder="Ej: Asamblea Ordinaria 2026 - Aprobacion presupuesto" />
            </div>
            <div class="col-md-6">
                <label class="form-label small">Fecha y hora *</label>
                <input type="datetime-local" class="form-control form-control-sm" @bind="_fecha" />
            </div>
            <div class="col-md-6">
                <label class="form-label small">Lugar fisico (Presencial/Mixta)</label>
                <input class="form-control form-control-sm" @bind="_lugar" @bind:event="oninput"
                       placeholder="Salon comunal" />
            </div>
            <div class="col-md-12">
                <label class="form-label small">Enlace videoconferencia (Virtual/Mixta)</label>
                <input class="form-control form-control-sm" @bind="_enlace" @bind:event="oninput"
                       placeholder="https://meet.google.com/..." />
            </div>
        </div>
    </WizardStep>

    @* ---------- Paso 3: orden del dia ---------- *@
    <WizardStep Titulo="Orden del dia"
                Descripcion="Minimo un punto. Marca los puntos que requieren votacion e indica tipo de mayoria."
                CanAdvance="@(() => _puntos.Count > 0 && _puntos.All(p => !string.IsNullOrWhiteSpace(p.Titulo)))"
                MensajeError="Cada punto debe tener un titulo.">
        @foreach (var p in _puntos)
        {
            <div class="card mb-2"><div class="card-body py-2">
                <div class="row g-2">
                    <div class="col-md-1"><label class="form-label small">#</label>
                        <input type="number" class="form-control form-control-sm" @bind="p.Numero" min="1" /></div>
                    <div class="col-md-9"><label class="form-label small">Titulo *</label>
                        <input class="form-control form-control-sm" @bind="p.Titulo" @bind:event="oninput" /></div>
                    <div class="col-md-2"><label class="form-label small">Tipo mayoria</label>
                        <select class="form-select form-select-sm" @bind="p.TipoMayoria" @bind:after="() => SyncMayoriaPct(p)">
                            @foreach (var tm in Enum.GetValues<TipoMayoria>()) { <option value="@tm">@tm</option> }
                        </select></div>
                    <div class="col-md-12"><label class="form-label small">Descripcion (opcional)</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="p.Descripcion" @bind:event="oninput"></textarea></div>
                    <div class="col-md-4">
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="p.RequiereVotacion" id="rv@(p.Numero)">
                            <label class="form-check-label small" for="rv@(p.Numero)">Requiere votacion</label></div>
                    </div>
                    <div class="col-md-4"><label class="form-label small">% Mayoria</label>
                        <input type="number" class="form-control form-control-sm" @bind="p.MayoriaPct" min="50" max="100" step="1" /></div>
                    <div class="col-md-3"><label class="form-label small">Modalidad voto</label>
                        <select class="form-select form-select-sm" @bind="p.ModalidadVoto">
                            @foreach (var mv in Enum.GetValues<ModalidadVoto>()) { <option value="@mv">@mv</option> }
                        </select></div>
                    <div class="col-md-1 d-flex align-items-end">
                        @if (_puntos.Count > 1)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _puntos.Remove(p)">&times;</button>
                        }
                    </div>
                </div>
            </div></div>
        }
        <button type="button" class="btn btn-sm btn-outline-dark" @onclick="AgregarPunto">+ Agregar punto</button>
    </WizardStep>

    @* ---------- Paso 4: revisar y crear ---------- *@
    <WizardStep Titulo="Revisar"
                Descripcion="Revisa antes de crear el borrador. Despues podras adjuntar convocatoria, enviar invitaciones y administrar el quorum.">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card border-0 bg-light"><div class="card-body py-2 small">
                    <div class="text-muted">Tipo</div><strong>@RenderTipoTitulo(_tipo)</strong>
                </div></div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 bg-light"><div class="card-body py-2 small">
                    <div class="text-muted">Modalidad</div><strong>@_modalidad</strong>
                </div></div>
            </div>
            <div class="col-md-12">
                <div class="card border-0 bg-light"><div class="card-body py-2 small">
                    <div class="text-muted">Titulo</div><strong>@_titulo</strong>
                    <div class="text-muted mt-2">Fecha</div><strong>@_fecha.ToString("yyyy-MM-dd HH:mm")</strong>
                    @if (!string.IsNullOrWhiteSpace(_lugar))
                    {
                        <div class="text-muted mt-2">Lugar</div><strong>@_lugar</strong>
                    }
                    @if (!string.IsNullOrWhiteSpace(_enlace))
                    {
                        <div class="text-muted mt-2">Enlace</div><strong>@_enlace</strong>
                    }
                </div></div>
            </div>
            <div class="col-md-12">
                <div class="card border-0 bg-light"><div class="card-body py-2 small">
                    <div class="text-muted mb-1">Orden del dia (@_puntos.Count puntos)</div>
                    <ol class="mb-0 ps-3">
                        @foreach (var p in _puntos.OrderBy(x => x.Numero))
                        {
                            <li>
                                <strong>@p.Titulo</strong>
                                @if (p.RequiereVotacion)
                                {
                                    <span class="badge bg-warning text-dark ms-2">Vota @p.TipoMayoria @p.MayoriaPct%</span>
                                }
                            </li>
                        }
                    </ol>
                </div></div>
            </div>
        </div>
    </WizardStep>

</ModuloWizard>

@code {
    private string? _jwt;
    private bool _busy;
    private string? _msg; private string _msgClass = "alert-info";

    private TipoSesion _tipo = TipoSesion.AsambleaOrdinaria;
    private ModalidadSesion _modalidad = ModalidadSesion.Virtual;
    private string? _titulo;
    private DateTime _fecha = DateTime.UtcNow.AddDays(10);
    private string? _lugar;
    private string? _enlace;

    private List<PuntoForm> _puntos = new()
    {
        new PuntoForm { Numero = 1, Titulo = "Verificacion de quorum", RequiereVotacion = false },
        new PuntoForm { Numero = 2, Titulo = "Aprobacion del presupuesto anual", RequiereVotacion = true }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored)) { _jwt = stored; StateHasChanged(); }
        }
        catch { }
    }

    private void AgregarPunto() => _puntos.Add(new PuntoForm
    {
        Numero = _puntos.Count + 1,
        Titulo = "",
        RequiereVotacion = true,
        MayoriaPct = 50m
    });

    private void SyncMayoriaPct(PuntoForm p)
    {
        if (p.TipoMayoria == TipoMayoria.Calificada && p.MayoriaPct < 70m)
            p.MayoriaPct = 70m;
    }

    private async Task CrearAsync()
    {
        if (_busy) return;
        _busy = true; _msg = null;
        try
        {
            var req = new CrearSesionRequest(
                _tipo, _modalidad, _titulo!.Trim(),
                new DateTimeOffset(_fecha, TimeSpan.Zero),
                _lugar, _enlace,
                _puntos.Select(p => new CrearPuntoRequest(
                    p.Numero, p.Titulo.Trim(), p.Descripcion,
                    p.RequiereVotacion, p.TipoMayoria, p.MayoriaPct,
                    p.ModalidadVoto, null)).ToList());
            var resp = await Auth().PostAsJsonAsync("/api/asambleas", req);
            if (!resp.IsSuccessStatusCode)
            {
                _msg = await resp.Content.ReadAsStringAsync();
                _msgClass = "alert-danger";
                return;
            }
            var dto = await resp.Content.ReadFromJsonAsync<SesionDetalleDto>();
            Nav.NavigateTo($"/asambleas/{dto!.Id}");
        }
        finally { _busy = false; }
    }

    private Task CancelarAsync()
    {
        Nav.NavigateTo("/asambleas");
        return Task.CompletedTask;
    }

    private static string RenderTipoTitulo(TipoSesion t) => t switch
    {
        TipoSesion.AsambleaOrdinaria => "Asamblea Ordinaria (Art. 39 Ley 675)",
        TipoSesion.AsambleaExtraordinaria => "Asamblea Extraordinaria",
        TipoSesion.Consejo => "Sesion del Consejo de Administracion",
        TipoSesion.Comite => "Sesion del Comite de Convivencia",
        _ => t.ToString()
    };

    private static string TipoAyuda(TipoSesion t) => t switch
    {
        TipoSesion.AsambleaOrdinaria => "Convocada por el administrador en los 3 primeros meses del ano (Art. 39 Ley 675).",
        TipoSesion.AsambleaExtraordinaria => "Convocada por administrador, consejo o un grupo de propietarios que represente >= 20%.",
        TipoSesion.Consejo => "Organo permanente; convocatoria minima por estatutos.",
        TipoSesion.Comite => "Comite de convivencia - conciliacion previa a sanciones.",
        _ => string.Empty
    };

    private static string ModalidadAyuda(ModalidadSesion m) => m switch
    {
        ModalidadSesion.Presencial => "Asistencia fisica en lugar definido.",
        ModalidadSesion.Virtual => "100% en linea (Decreto 1074 art. 2.2.4.4.2.1).",
        ModalidadSesion.Mixta => "Combina asistencia presencial y remota.",
        _ => string.Empty
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private class PuntoForm
    {
        public int Numero { get; set; }
        public string Titulo { get; set; } = "";
        public string? Descripcion { get; set; }
        public bool RequiereVotacion { get; set; } = true;
        public TipoMayoria TipoMayoria { get; set; } = TipoMayoria.Simple;
        public decimal MayoriaPct { get; set; } = 50m;
        public ModalidadVoto ModalidadVoto { get; set; } = ModalidadVoto.Publico;
    }
}
