@page "/buzones"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Web.Components.Shared
@inject IJSRuntime Js

<PageTitle>Buzones de correo - PROPIA</PageTitle>

@* Modulo Buzones de correo (2026-11-22, pedido de Alex): las cuentas de correo de la copropiedad viven aqui, aparte.
   Gestion de correos (que buzones lee) y PQRSD (desde cual responde) los eligen en sus propias opciones.
   Reusa CorreosBuzonesModal en modo "cuentas", embebido en la pagina. Backend: api/correos-recibidos/buzones. *@

<div class="dst-pagehead">
    <div>
        <h1 class="dst-pagetitle">Buzones de correo</h1>
        <p class="dst-pagesub">Las cuentas de correo de la copropiedad. Gestión de correos las lee y PQRSD responde desde ellas: cada módulo elige en sus opciones cuáles usa.</p>
    </div>
</div>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-brand);"></div></div>
}
else if (string.IsNullOrEmpty(_jwt))
{
    <div class="alert alert-warning">Inicia sesión para ver los buzones.</div>
}
else
{
    <CorreosBuzonesModal Jwt="@_jwt" Modo="cuentas" Embebido="true" />
}

@code {
    private string? _jwt;
    private bool _authChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt"); } catch { }
        _authChecked = true;
        StateHasChanged();
    }
}
