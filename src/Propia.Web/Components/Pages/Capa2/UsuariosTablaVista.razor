@* Vista Tabla de Usuarios: todas las columnas + fila de alta inline (invitar en caliente),
   equivalente a la Tabla del Directorio. Extraida de Usuarios.razor, que aporta las clases
   usr-* y utb-*; aqui no va estilo propio (los estilos de un componente solo estan en el
   DOM mientras se renderiza, y la otra vista los necesitaria igual). *@
@using Propia.Application.UsuariosAccesos
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<div class="usr-table">
    <div class="utb-scroll">
        @* Cabecera: seleccion (todo) + columnas configurables (orden/visibilidad/ancho por config,
           entidad 'usuario'). Cada th ordena al clic, se reordena por arrastre y se redimensiona por
           el handle. El grid-template-columns lo fija el padre (GridStyle) segun columnas visibles. *@
        <div class="utb-head utb-grid" style="@GridStyle">
            <div class="utb-sel-cell"><label class="utb-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodasSel" @onchange="@(e => OnToggleSelAll.InvokeAsync((bool)(e.Value ?? false)))" /></label></div>
            <div></div>
            @foreach (var k in Columnas)
            {
                var clave = k;
                <div class="utb-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                     @onmousedown="e => IniciarReorderU(e, clave)" @onclick="() => OnOrdenar.InvokeAsync(clave)">
                    <span class="utb-th-lbl">@LabelUp(clave)</span>
                    @if (SortKey == clave) { <span class="utb-th-arrow">@((MarkupString)(SortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                    @{ var lblFija = ColLabels.TryGetValue(clave, out var lv) ? lv : clave; }
                    <button type="button" class="utb-th-gear" title="Opciones de columna"
                            @onclick:stopPropagation="true" @onmousedown:stopPropagation="true"
                            @onclick="mev => OnAbrirColMenu.InvokeAsync((clave, lblFija, false, mev.ClientX, mev.ClientY))">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                    </button>
                    <span class="utb-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar"
                          @onmousedown="e => IniciarResizeU(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true"
                          @onclick:stopPropagation="true" @ondblclick="() => ResetResizeU(clave)" @ondblclick:stopPropagation="true"></span>
                </div>
            }
            @* Columnas dinamicas (campos propios de usuarios): cabecera con engranaje (editar/eliminar). *@
            @if (Defs is not null)
            {
                @foreach (var d in Defs)
                {
                    var def = d;
                    <div class="utb-th-dyn">
                        <span class="utb-th-lbl">@d.Label.ToUpperInvariant()</span>
                        <button type="button" class="utb-th-gear" title="Opciones de columna" @onclick='mev => OnAbrirColMenu.InvokeAsync(("cd:" + def.Id, def.Label, true, mev.ClientX, mev.ClientY))'>
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                        </button>
                    </div>
                }
            }
            @* "+" para crear un campo nuevo (columna). Siempre presente para casar el grid. *@
            <div class="utb-addcol-h"><button type="button" class="utb-addcol-btn" title="Crear campo nuevo (columna)" @onclick="() => OnCrearCampo.InvokeAsync()"><i class="fi fi-rr-plus"></i></button></div>
            <div></div>
        </div>
        @* Filas: con agrupacion activa las pinta el render compartido (TablaGruposRender + arbol de
           TablaAgrupador, N niveles, con encabezado y contador por (sub)grupo); sin agrupacion, la
           lista que llega del padre (ya paginada). La fila hoja es FilaTpl (identica en ambos modos). *@
        @if (Agrupado)
        {
            <TablaGruposRender T="UsuarioListaDto" Nodos="TablaAgrupador.Agrupar<UsuarioListaDto>(Usuarios, Grupos!, ValorGrupoU)" FilaTemplate="FilaTpl" />
        }
        else
        {
            @foreach (var u in Usuarios) { @FilaTpl(u) }
        }
        @* Fila de alta: crea/encuentra la persona en el Directorio y le envia la invitacion.
           El "+" del inicio y el placeholder "Nuevo usuario..." son los que la anuncian.
           Se pinta por las mismas columnas visibles para no desalinearse al reordenar/ocultar. *@
        @* @@key limpia la fila al invitar; @@oninput SIN value= evita perder pulsaciones
           (value= se reafirma en cada re-render y pisa lo escrito en Blazor Server). *@
        @* Ola C (canon Unidades): por defecto CTA colapsada; al pulsarla o el FAB se abre la fila de edicion. *@
        @if (_altaAbierta)
        {
        <div class="utb-newrow utb-newrow--edit utb-grid" style="@GridStyle" @key="_nonce">
            <div class="utb-sel-cell"></div>
            <div class="utb-exp-col">
                @* Canon Unidades: el expander de la fila de alta confirma el registro (aqui: crear y enviar invitacion). *@
                <button type="button" class="utb-exp" tabindex="-1" title="Crear y enviar invitacion" @onclick="Invitar" disabled="@(_busy || !Valido)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                </button>
            </div>
            @foreach (var k in Columnas)
            {
                switch (k)
                {
                    case "tipo":
                        <select class="utb-inp" @bind="_d.TipoDocumento">
                            <option value="@TipoDocumento.CC">CC</option>
                            <option value="@TipoDocumento.CE">CE</option>
                            <option value="@TipoDocumento.PA">PA</option>
                            <option value="@TipoDocumento.TI">TI</option>
                        </select>
                        break;
                    case "documento":
                        <input class="utb-inp" @ref="_firstRef" placeholder="Documento" @oninput="@(e => _d.Documento = e.Value?.ToString() ?? string.Empty)" @onkeydown="Key" />
                        break;
                    case "usuario":
                        @* Un solo campo "Nombre completo" (igual que la columna USUARIO de la tabla): se
                           divide en nombres/apellidos al guardar. *@
                        <input class="utb-inp" placeholder="Nombre completo" @oninput="@(e => _d.NombreCompleto = e.Value?.ToString() ?? string.Empty)" @onkeydown="Key" />
                        break;
                    case "rol":
                        @* 2.5 v2.0: Rol MULTI-SELECT inline. Chips de los roles elegidos (cada uno con "x") +
                           boton "+" que abre un MENU toggle con todos los roles; se pueden marcar varios y el
                           menu NO se cierra al elegir. Default al guardar: si queda vacio -> Portal Residente. *@
                        <div class="usr-multi">
                            @foreach (var rid in _d.RolIds)
                            {
                                var rr = rid; var rn = Roles.FirstOrDefault(r => r.Id == rr)?.Nombre ?? "Rol";
                                <span class="usr-mchip usr-mchip--rol">@rn<button type="button" class="usr-mchip-x" title="Quitar" @onclick="() => QuitarRol(rr)">&times;</button></span>
                            }
                            @if (_d.RolIds.Count == 0) { <span class="usr-mph">Agregar rol</span> }
                            <button type="button" class="usr-madd usr-madd--rol" title="Agregar rol" @onclick="() => { _rolMenuOpen = !_rolMenuOpen; _cargoMenuOpen = false; }">+</button>
                            @if (_rolMenuOpen)
                            {
                                <div class="usr-mback" @onclick="() => _rolMenuOpen = false"></div>
                                <div class="usr-mmenu">
                                    @foreach (var r in Roles.Where(r => r.Activo))
                                    {
                                        var rid2 = r.Id; var on = _d.RolIds.Contains(rid2);
                                        <button type="button" class="usr-mopt @(on ? "on" : "")" @onclick="() => ToggleRol(rid2)">
                                            <span class="usr-mcheck">@(on ? (MarkupString)"&#10003;" : (MarkupString)"")</span>@r.Nombre
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        break;
                    case "email":
                        @* Correo editable: si se escribe, la invitacion se envia a el y queda en la persona
                           del Directorio. Opcional: vacio = se completa al aceptar (comportamiento anterior). *@
                        <input class="utb-inp" type="email" placeholder="Correo (opcional)"
                               @oninput="@(e => _d.Email = e.Value?.ToString() ?? string.Empty)" @onkeydown="Key" />
                        break;
                    case "telefono":
                        @* Telefono editable (opcional): queda en la persona del Directorio al crearla. *@
                        <input class="utb-inp" type="tel" placeholder="Telefono (opcional)"
                               @oninput="@(e => _d.Telefono = e.Value?.ToString() ?? string.Empty)" @onkeydown="Key" />
                        break;
                    case "cargo":
                        @* 2.5 v2.0: Cargo MULTI-SELECT (mismo control que Rol; descriptivo, no da permisos). *@
                        <div class="usr-multi">
                            @foreach (var cg in _d.Cargos)
                            {
                                var c0 = cg;
                                <span class="usr-mchip usr-mchip--cargo">@c0<button type="button" class="usr-mchip-x" title="Quitar" @onclick="() => QuitarCargo(c0)">&times;</button></span>
                            }
                            @if (_d.Cargos.Count == 0) { <span class="usr-mph">Agregar cargo</span> }
                            <button type="button" class="usr-madd usr-madd--cargo" title="Agregar cargo" @onclick="() => { _cargoMenuOpen = !_cargoMenuOpen; _rolMenuOpen = false; }">+</button>
                            @if (_cargoMenuOpen)
                            {
                                <div class="usr-mback" @onclick="() => _cargoMenuOpen = false"></div>
                                <div class="usr-mmenu">
                                    @foreach (var op in CargoOpciones)
                                    {
                                        var o0 = op; var on = _d.Cargos.Contains(o0, StringComparer.OrdinalIgnoreCase);
                                        <button type="button" class="usr-mopt @(on ? "on" : "")" @onclick="() => ToggleCargo(o0)">
                                            <span class="usr-mcheck">@(on ? (MarkupString)"&#10003;" : (MarkupString)"")</span>@o0
                                        </button>
                                    }
                                    @if (CargoOpciones.Count == 0) { <div class="usr-mph" style="padding:8px">Sin cargos configurados</div> }
                                </div>
                            }
                        </div>
                        break;
                    case "estado":
                        <div class="utb-nf-mut">Pendiente</div>
                        break;
                    default:
                        <div class="utb-nf-mut">&mdash;</div>
                        break;
                }
            }
            @* Campos propios en el alta: se completan tras crear el usuario (celdas vacias). *@
            @if (Defs is not null)
            {
                @foreach (var d in Defs) { <div class="utb-nf-mut">&mdash;</div> }
            }
            <div class="utb-addcol-cell"></div>
            <div class="utb-act utb-act-nf">
                <button type="button" class="utb-nf-ok" title="Agregar (Enter)" @onclick="Invitar" disabled="@_busy">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
                </button>
                <button type="button" class="utb-nf-cancel" title="Cancelar (Esc)" @onclick="CerrarAlta" disabled="@_busy">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>
        </div>
        }
        else
        {
            <div class="utb-cta-row utb-grid" style="@GridStyle">
                <div class="utb-sel-cell"></div>
                <div class="utb-exp-col"></div>
                <div class="utb-cta-btncell">
                    <button type="button" class="row-add--sm" @onclick="AbrirAlta">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                        Agregar registro
                    </button>
                </div>
            </div>
        }
    </div>
    @* FAB flotante (patron Unidades/Roles): aparece al desplazar cuando la fila de alta no se ve.
       Footer canonico con el conteo total. Con agrupacion NO se pagina, asi que no van ni FAB ni footer. *@
    @if (!Agrupado)
    {
        <button type="button" class="tbl-fab" hidden="@_ctaVisible" @onclick="FabNuevo" title="Agregar usuario">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
            Agregar registro
        </button>
        <div class="tbl-foot">@Total registros &middot; mostrando @Usuarios.Count</div>
    }
</div>

@* Menu contextual (clic derecho sobre una fila). *@
<TablaCtxMenu Abierto="_ctxOpenU" X="_ctxXU" Y="_ctxYU" Items="_ctxItemsU" Cerrado="() => _ctxOpenU = false" />

@code {
    [Parameter] public List<UsuarioListaDto> Usuarios { get; set; } = new();
    [Parameter] public List<RolDto> Roles { get; set; } = new();
    // E1b: crear un rol basico inline desde el alta. La pagina hace el POST y devuelve el id del rol creado.
    [Parameter] public Func<string, Task<Guid?>>? CrearRolInline { get; set; }
    [Parameter] public EventCallback<UsuarioListaDto> OnEditar { get; set; }
    [Parameter] public EventCallback<Guid> OnReactivar { get; set; }
    [Parameter] public EventCallback<NuevoUsuarioInvitar> OnInvitar { get; set; }
    // Revocar acceso desde el menu contextual (accion destructiva real de Usuarios).
    [Parameter] public EventCallback<Guid> OnRevocar { get; set; }
    // Mensaje breve al padre (p.ej. "Enlace copiado"), se muestra en su barra de alertas.
    [Parameter] public EventCallback<string> OnMensaje { get; set; }

    // Orden por columna: el padre ordena ANTES de paginar; aqui solo se pinta la flecha y se avisa.
    [Parameter] public string? SortKey { get; set; }
    [Parameter] public int SortDir { get; set; } = 1;
    [Parameter] public EventCallback<string> OnOrdenar { get; set; }

    // Columnas configurables: el padre pasa las visibles (en orden), sus etiquetas y el grid-template.
    [Parameter] public List<string> Columnas { get; set; } = new();
    [Parameter] public Dictionary<string, string> ColLabels { get; set; } = new();
    [Parameter] public string GridStyle { get; set; } = "";

    // Seleccion multiple (revocar masivo): el HashSet vive en el padre; aqui solo se pintan checkboxes.
    [Parameter] public HashSet<Guid> Seleccion { get; set; } = new();
    [Parameter] public bool TodasSel { get; set; }
    [Parameter] public EventCallback<(Guid id, bool on)> OnToggleSel { get; set; }
    [Parameter] public EventCallback<bool> OnToggleSelAll { get; set; }

    // Reordenar / redimensionar columnas: el JS compartido devuelve aqui (OnColReorder/OnColResize)
    // y se reenvia al padre, que posee la config y persiste.
    [Parameter] public EventCallback<(string src, string dest)> OnReordenarCol { get; set; }
    [Parameter] public EventCallback<(string clave, int width)> OnRedimensionarCol { get; set; }

    // ---- Campos dinamicos (subsistema "usuarios"): columnas propias tras las fijas. El registro de un
    // valor es el UsuarioTenantId de la fila; la definicion vive en usuarios-campos. Config la maneja el padre. ----
    /// <summary>Definiciones de campos propios (usuarios-campos), en orden.</summary>
    [Parameter] public List<CampoDinDef>? Defs { get; set; }
    /// <summary>Valores por registro (UsuarioTenantId) -> (defId -> valor).</summary>
    [Parameter] public Dictionary<Guid, Dictionary<Guid, string?>>? Valores { get; set; }
    /// <summary>Guardar el valor de un campo propio (registro, definicion, valor).</summary>
    [Parameter] public EventCallback<(Guid Registro, Guid Def, string? Valor)> OnGuardarDinamico { get; set; }
    /// <summary>Abrir el modal de crear campo (boton "+").</summary>
    [Parameter] public EventCallback OnCrearCampo { get; set; }
    /// <summary>Abrir el modal de editar/eliminar un campo (engranaje de la columna).</summary>
    [Parameter] public EventCallback<CampoDinDef> OnEditarCampoDef { get; set; }
    /// <summary>Abrir el menu de columna (chevron del header): clave, etiqueta, si es dinamica y coordenadas del cursor.</summary>
    [Parameter] public EventCallback<(string Clave, string Label, bool Dyn, double X, double Y)> OnAbrirColMenu { get; set; }

    // Campos dinamicos: lectura/escritura del valor sobre el registro (UsuarioTenantId de la fila).
    private string? ValorDin(Guid reg, Guid defId) => Valores is not null && Valores.TryGetValue(reg, out var m) && m.TryGetValue(defId, out var v) ? v : null;
    private Task GuardarDin(Guid reg, Guid defId, string? val) => OnGuardarDinamico.InvokeAsync((reg, defId, val));

    // ===== Agrupacion (fuente unica compartida: el padre pinta TablaAgruparMenu y mantiene los niveles;
    // aqui el motor TablaAgrupador arma el arbol y el render TablaGruposRender lo pinta con FilaTpl como
    // fila hoja). Con agrupacion NO se pagina: el padre envia la lista completa y aqui se oculta el pager. =====
    /// <summary>Niveles de agrupacion (claves de columna, en orden de jerarquia). Vacio/nulo = sin agrupar.</summary>
    [Parameter] public List<string>? Grupos { get; set; }
    private bool Agrupado => Grupos is { Count: > 0 };

    // Fila hoja de la tabla (misma para el modo agrupado y el no agrupado): la pinta TablaGruposRender
    // (agrupado) o el foreach de la lista (no agrupado). El parametro es 'uu' (como la fila original);
    // 'u' es un alias para conservar verbatim las expresiones de lectura de columnas.
    private RenderFragment<UsuarioListaDto> FilaTpl => uu =>
    @<div class="utb-row utb-grid @(Seleccion.Contains(uu.UsuarioTenantId) ? "utb-row-sel" : "")" style="@GridStyle" @oncontextmenu="e => AbrirCtxU(e, uu)" @oncontextmenu:preventDefault="true">
        @{ var u = uu; }
        <div class="utb-sel-cell"><label class="utb-chk"><input type="checkbox" checked="@Seleccion.Contains(uu.UsuarioTenantId)" disabled="@(uu.Estado != EstadoUsuarioTenant.Activo)" @onclick:stopPropagation="true" @onchange="@(e => OnToggleSel.InvokeAsync((uu.UsuarioTenantId, (bool)(e.Value ?? false))))" /></label></div>
        <div class="utb-exp-col">
            <button type="button" class="utb-exp" title="Abrir la ficha del usuario" @onclick="() => OnEditar.InvokeAsync(uu)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </button>
        </div>
        @foreach (var k in Columnas)
        {
            switch (k)
            {
                case "tipo":
                    <div class="utb-c">@u.TipoDocumento</div>
                    break;
                case "documento":
                    <div class="utb-c"><span class="cod-key">@(string.IsNullOrWhiteSpace(u.Documento) ? "-" : u.Documento)</span></div>
                    break;
                case "usuario":
                    <button type="button" class="utb-link" title="Abrir usuario" @onclick="() => OnEditar.InvokeAsync(uu)">@u.NombreCompleto</button>
                    break;
                case "email":
                    <div class="utb-c">@(u.Email ?? "-")</div>
                    break;
                case "telefono":
                    <div class="utb-c">@(u.Telefono ?? "-")</div>
                    break;
                case "rol":
                    @* 2.5 v2.0: Rol como CHIPS (varios por celda), tono brand suave. *@
                    <div class="utb-c utb-c-chips">
                        @if (u.Roles.Count > 0)
                        {
                            @foreach (var rc in u.Roles) { <span class="usr-rolchip">@rc.Nombre</span> }
                        }
                        else { <span class="usr-rolchip">@u.RolNombre</span> }
                    </div>
                    break;
                case "cargo":
                    @* 2.5 v2.0: Cargo(s) como chips neutros (descriptivos, no dan permisos). *@
                    <div class="utb-c utb-c-chips">
                        @if (u.Cargos.Count > 0) { @foreach (var cg in u.Cargos) { <span class="usr-cargochip">@cg</span> } }
                        else { <span class="utb-c" style="color:var(--propia-text-faint)">-</span> }
                    </div>
                    break;
                case "ultimoacceso":
                    <div class="utb-c">@(u.UltimoAcceso?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "Sin registro")</div>
                    break;
                case "fechavinculacion":
                    <div class="utb-c">@(u.FechaVinculacion?.LocalDateTime.ToString("yyyy-MM-dd") ?? "-")</div>
                    break;
                case "estado":
                    @* 2.5 v2.0: badge con 4 valores (ok/warn/info/danger). *@
                    <div class="utb-c"><span class="@(EstadoChip(u.Estado).Cls)">@(EstadoChip(u.Estado).Label)</span></div>
                    break;
            }
        }
        @* Celdas de los campos propios: el registro es el UsuarioTenantId de la fila. *@
        @if (Defs is not null)
        {
            @foreach (var d in Defs)
            {
                var def = d;
                var reg = uu.UsuarioTenantId;
                var val = ValorDin(reg, def.Id);
                switch (def.Tipo)
                {
                    case TipoCampoTablero.Seleccion:
                        <select class="utb-cell" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())">
                            <option value="">-</option>
                            @foreach (var op in def.OpcionesArray()) { <option value="@op" selected="@(op == val)">@op</option> }
                        </select>
                        break;
                    case TipoCampoTablero.Numero:
                    case TipoCampoTablero.Moneda:
                    case TipoCampoTablero.Porcentaje:
                        <input class="utb-cell" type="number" step="any" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())" />
                        break;
                    case TipoCampoTablero.Fecha:
                        <input class="utb-cell" type="date" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())" />
                        break;
                    case TipoCampoTablero.Booleano:
                        <select class="utb-cell" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())">
                            <option value="">-</option>
                            <option value="Si" selected="@(val == "Si")">Si</option>
                            <option value="No" selected="@(val == "No")">No</option>
                        </select>
                        break;
                    case TipoCampoTablero.Formula:
                        <div class="utb-c utb-ro" title="Se calcula automaticamente">@(string.IsNullOrWhiteSpace(val) ? "-" : val)</div>
                        break;
                    case TipoCampoTablero.Usuario:
                    case TipoCampoTablero.Directorio:
                        <div class="utb-c utb-ro" title="Se edita desde la ficha">@(string.IsNullOrWhiteSpace(val) ? "-" : val)</div>
                        break;
                    default:
                        <input class="utb-cell" value="@val" @onchange="ev => GuardarDin(reg, def.Id, ev.Value?.ToString())" />
                        break;
                }
            }
        }
        <div class="utb-addcol-cell"></div>
        <div class="utb-act">
            @if (u.Estado == EstadoUsuarioTenant.Activo)
            {
                <button class="utb-icon" title="Editar" @onclick="() => OnEditar.InvokeAsync(uu)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </button>
            }
            else
            {
                <button class="utb-icon" title="Reactivar" @onclick="() => OnReactivar.InvokeAsync(uu.UsuarioTenantId)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                </button>
            }
        </div>
    </div>;

    // Valor de una dimension de agrupacion para un usuario (uno por nivel; sin valor => "(Sin dato)").
    // rol -> nombre del rol; estado -> enum; "cd:{id}" -> valor del campo propio (mismo resolver que las celdas).
    private IEnumerable<ValorGrupo> ValorGrupoU(UsuarioListaDto u, string clave)
    {
        switch (clave)
        {
            case "rol": { var t = string.IsNullOrWhiteSpace(u.RolNombre) ? "(Sin dato)" : u.RolNombre!; yield return new(t, t); yield break; }
            case "estado": { var t = u.Estado.ToString(); yield return new(t, t); yield break; }
        }
        if (clave.StartsWith("cd:", StringComparison.Ordinal) && Guid.TryParse(clave.AsSpan(3), out var defId))
        {
            var v = ValorDin(u.UsuarioTenantId, defId);
            var t = string.IsNullOrWhiteSpace(v) ? "(Sin dato)" : v!;
            yield return new(t, t);
        }
        // Clave no reconocida: no se emite valor (el motor la coloca en "(Sin dato)").
    }

    // Etiqueta de cabecera (en mayuscula) para una clave visible.
    private string LabelUp(string clave) => (ColLabels.TryGetValue(clave, out var l) ? l : clave).ToUpperInvariant();

    // 2.5 v2.0: badge de Estado con 4 valores (ok/warn/info/danger) y la etiqueta de la UI.
    private static (string Cls, string Label) EstadoChip(EstadoUsuarioTenant e) => e switch
    {
        EstadoUsuarioTenant.Activo => ("usr-est usr-est--ok", "Activo"),
        EstadoUsuarioTenant.Pendiente => ("usr-est usr-est--warn", "Invitación pendiente"),
        EstadoUsuarioTenant.PendienteContacto => ("usr-est usr-est--info", "Pendiente de contacto"),
        EstadoUsuarioTenant.Inactivo => ("usr-est usr-est--danger", "Inactivo"),
        _ => ("usr-est", e.ToString())
    };

    // ===== Reordenar / redimensionar por arrastre (JS compartido; este componente posee las celdas) =====
    private DotNetObjectReference<UsuariosTablaVista>? _self;
    private async Task IniciarReorderU(MouseEventArgs e, string clave)
    {
        _self ??= DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _self, clave, e.ClientX, e.ClientY); } catch { }
    }
    private async Task IniciarResizeU(MouseEventArgs e, string clave)
    {
        _self ??= DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("propiaTablaResize.start", _self, clave, e.ClientX); } catch { }
    }
    private Task ResetResizeU(string clave) => OnColResize(clave, 0);
    [JSInvokable] public async Task OnColReorder(string src, string dest) => await OnReordenarCol.InvokeAsync((src, dest));
    [JSInvokable] public async Task OnColResize(string clave, int width) => await OnRedimensionarCol.InvokeAsync((clave, width));
    public void Dispose() => _self?.Dispose();

    // Conteo total para el footer canonico (dentro del contenedor .usr-table). El padre envia la lista
    // COMPLETA (render-all); no hay paginacion de servidor: el scroll infinito solo alterna el FAB.
    [Parameter] public int Total { get; set; }

    // ===== FAB flotante + scroll infinito (canon Unidades/Roles) =====
    // _ctaVisible=true => la fila de alta esta a la vista -> FAB oculto. dstInfinite (propia-ui.js) observa
    // el scroll de .utb-scroll: cerca del fondo muestra la fila de alta y oculta el FAB (SetCtaVisible).
    private bool _ctaVisible = true;
    private bool _scrollCtaPend;
    private string? _fabSig;
    [JSInvokable] public Task CargarMas() => Task.CompletedTask;   // render-all: no hay lotes que pedir
    [JSInvokable] public void SetCtaVisible(bool visible) { if (_ctaVisible != visible) { _ctaVisible = visible; StateHasChanged(); } }
    // Clic del FAB: baja a la fila de alta y enfoca el primer campo (documento).
    // Ola C (canon Unidades): la fila de alta nace colapsada (CTA) y se abre al pulsar la CTA o el FAB.
    private bool _altaAbierta;
    private void AbrirAlta() { _altaAbierta = true; _focusPending = true; }
    private void CerrarAlta() { _altaAbierta = false; _d.Reset(); _nonce++; }
    // El FAB abre la fila (no solo baja el scroll) y luego baja al fondo + enfoca.
    private void FabNuevo() { _altaAbierta = true; _scrollCtaPend = true; _focusPending = true; }

    // ===== Menu contextual (clic derecho) =====
    private bool _ctxOpenU;
    private double _ctxXU, _ctxYU;
    private List<TablaCtxMenu.Item> _ctxItemsU = new();
    private void AbrirCtxU(MouseEventArgs e, UsuarioListaDto u)
    {
        _ctxXU = e.ClientX; _ctxYU = e.ClientY;
        _ctxItemsU = new()
        {
            new("Abrir ficha", "fi-rr-expand", OnClick: () => OnEditar.InvokeAsync(u)),
            new("Copiar enlace del registro", "fi-rr-link-alt", OnClick: () => CopiarEnlaceU(u)),
            new(Sep: true),
            u.Estado == EstadoUsuarioTenant.Activo
                ? new("Revocar acceso", "fi-rr-lock", Danger: true, OnClick: () => OnRevocar.InvokeAsync(u.UsuarioTenantId))
                : new("Reactivar acceso", "fi-rr-refresh", OnClick: () => OnReactivar.InvokeAsync(u.UsuarioTenantId)),
        };
        _ctxOpenU = true;
    }
    private async Task CopiarEnlaceU(UsuarioListaDto u)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}usuarios#usuario-{u.UsuarioTenantId}");
            await OnMensaje.InvokeAsync("Enlace del registro copiado.");
        }
        catch { await OnMensaje.InvokeAsync("No se pudo copiar el enlace."); }
    }

    private bool _busy;
    private readonly Draft _d = new();
    private int _nonce;
    private bool _focusPending;
    private ElementReference _firstRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending) { _focusPending = false; try { await _firstRef.FocusAsync(); } catch { } }
        // FAB: observar el scroll de la tabla solo sin agrupacion (con grupos no hay footer/alta a la vista).
        if (!Agrupado)
        {
            _self ??= DotNetObjectReference.Create(this);
            var sig = Usuarios.Count.ToString();
            if (sig != _fabSig) { _fabSig = sig; try { await Js.InvokeVoidAsync("propiaUI.dstInfinite", _self, ".utb-scroll"); } catch { } }
        }
        else { _fabSig = null; }
        if (_scrollCtaPend) { _scrollCtaPend = false; try { await Js.InvokeVoidAsync("propiaUI.dstScrollToCta", ".utb-scroll"); } catch { } }
        // Anclar los menus flotantes (fixed) a su boton "+", para que no los recorte el scroll de la tabla.
        // Solo uno abre a la vez (se excluyen), asi que .usr-mmenu es unico.
        if (_rolMenuOpen && !_rolMenuAnclado) { _rolMenuAnclado = true; try { await Js.InvokeVoidAsync("propiaUI.anchorFloatMenu", ".utb-newrow .usr-madd--rol", ".utb-newrow .usr-mmenu"); } catch { } }
        if (!_rolMenuOpen) _rolMenuAnclado = false;
        if (_cargoMenuOpen && !_cargoMenuAnclado) { _cargoMenuAnclado = true; try { await Js.InvokeVoidAsync("propiaUI.anchorFloatMenu", ".utb-newrow .usr-madd--cargo", ".utb-newrow .usr-mmenu"); } catch { } }
        if (!_cargoMenuOpen) _cargoMenuAnclado = false;
    }

    // Valido (spec 2.5 v2.0): documento + nombre completo (>=2 palabras) + canal de invitacion (Correo O
    // Celular). El Rol NO es obligatorio: si queda vacio se guarda "Portal Residente" por defecto.
    private bool Valido =>
        !string.IsNullOrWhiteSpace(_d.Documento) &&
        _d.NombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length >= 2 &&
        (!string.IsNullOrWhiteSpace(_d.Email) || !string.IsNullOrWhiteSpace(_d.Telefono));

    // Divide "Nombre completo" en nombres (primera palabra) y apellidos (el resto).
    private static (string Nombres, string Apellidos) PartirNombre(string completo)
    {
        var p = completo.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length <= 1) return (p.Length == 1 ? p[0] : "", "");
        return (p[0], string.Join(" ", p[1..]));
    }

    private sealed class Draft
    {
        public TipoDocumento TipoDocumento = TipoDocumento.CC;
        public string Documento = "";
        public string NombreCompleto = "";
        public List<Guid> RolIds = new();
        public List<string> Cargos = new();
        public string Email = "";
        public string Telefono = "";
        public void Reset() { TipoDocumento = TipoDocumento.CC; Documento = ""; NombreCompleto = ""; RolIds = new(); Cargos = new(); Email = ""; Telefono = ""; }
    }

    private async Task Key(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Invitar();
        else if (e.Key == "Escape") CerrarAlta();
    }

    // E1b: crear rol basico inline (reusa el servicio de Roles via la pagina; devuelve el id y lo selecciona).
    private bool _creandoRol;
    private bool _rolBusy;
    private string _nuevoRolNombre = "";
    private void AbrirNuevoRol() { _creandoRol = true; _nuevoRolNombre = ""; }
    private async Task RolKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmarNuevoRol();
        else if (e.Key == "Escape") _creandoRol = false;
    }
    private async Task ConfirmarNuevoRol()
    {
        var nombre = _nuevoRolNombre.Trim();
        if (nombre.Length == 0 || CrearRolInline is null) { _creandoRol = false; return; }
        _rolBusy = true;
        try
        {
            var id = await CrearRolInline(nombre);
            if (id is Guid g && g != Guid.Empty && !_d.RolIds.Contains(g)) _d.RolIds.Add(g);
            _creandoRol = false;
        }
        finally { _rolBusy = false; }
    }

    // UI "tonta": recolecta y emite; la pagina hace los POST con su propio Auth().
    // Canonico: el boton NO se deshabilita por borrador invalido; se valida al clic con toast.
    private async Task Invitar()
    {
        if (!Valido)
        {
            await OnMensaje.InvokeAsync("Completa documento, nombre completo (nombres y apellidos) y un correo o celular.");
            return;
        }
        _busy = true;
        try
        {
            var (nombres, apellidos) = PartirNombre(_d.NombreCompleto);
            // Rol principal: el primero elegido; si no eligieron ninguno, "Portal Residente" por defecto (spec).
            var primarioId = _d.RolIds.Count > 0
                ? _d.RolIds[0]
                : (Roles.FirstOrDefault(r => r.Nombre == "Portal Residente")?.Id ?? _d.RolIds.FirstOrDefault());
            await OnInvitar.InvokeAsync(new NuevoUsuarioInvitar(
                _d.TipoDocumento, _d.Documento.Trim(), nombres, apellidos, primarioId,
                string.IsNullOrWhiteSpace(_d.Email) ? null : _d.Email.Trim(),
                string.IsNullOrWhiteSpace(_d.Telefono) ? null : _d.Telefono.Trim(),
                _d.RolIds.Count > 0 ? _d.RolIds.ToList() : null,
                _d.Cargos.Count > 0 ? _d.Cargos.ToList() : null));
            // Ola C: tras crear, la fila se colapsa de nuevo a la CTA (canon Unidades).
            _d.Reset(); _nonce++; _altaAbierta = false; _rolMenuOpen = false; _cargoMenuOpen = false;
        }
        finally { _busy = false; }
    }

    // ===== Controles multi-select de Rol y Cargo (chips + menu toggle) =====
    [Parameter] public IReadOnlyList<string> CargoOpciones { get; set; } = Array.Empty<string>();
    private bool _rolMenuOpen;
    private bool _rolMenuAnclado;
    private bool _cargoMenuOpen;
    private bool _cargoMenuAnclado;
    private void ToggleRol(Guid id) { if (!_d.RolIds.Remove(id)) _d.RolIds.Add(id); }   // toggle; el menu queda abierto
    private void QuitarRol(Guid id) => _d.RolIds.Remove(id);
    private void ToggleCargo(string c)
    {
        var i = _d.Cargos.FindIndex(x => string.Equals(x, c, StringComparison.OrdinalIgnoreCase));
        if (i >= 0) _d.Cargos.RemoveAt(i); else _d.Cargos.Add(c);
    }
    private void QuitarCargo(string c) => _d.Cargos.RemoveAll(x => string.Equals(x, c, StringComparison.OrdinalIgnoreCase));
}

@* Estilos EXCLUSIVOS de la vista Tabla (columnas dinamicas): celda editable inline, cabecera con
   engranaje y "+" para crear columna. Espejo de los .dtab-* de la tabla del Directorio, con clases
   utb-* y tokens --propia-*. Solo se necesitan cuando esta vista esta en el DOM. *@
<style>
    /* Celda editable inline de un campo propio: se lee como texto y se marca al hover/foco. */
    .utb-cell { width: 100%; box-sizing: border-box; border: 1px solid transparent; border-radius: 7px; padding: 5px 8px; font-size: 12.5px; color: var(--propia-text-secondary); background: transparent; outline: none; font-family: inherit; }
    .utb-cell:hover { border-color: var(--propia-border-card); background: var(--propia-bg-card-soft); }
    .utb-cell:focus { border-color: var(--propia-brand); background: var(--propia-bg-card); color: var(--propia-text-body); }
    .utb-ro { color: var(--propia-text-muted); }
    /* Cabecera dinamica con engranaje (editar/eliminar) + "+" para crear (espejo de las columnas del Directorio). */
    .utb-th-dyn { display: flex; align-items: center; gap: 6px; min-width: 0; }
    /* Chevron de menu de columna: SIEMPRE visible y a la derecha de la celda (canon Unidades .tbl-th-edit). */
    .utb-th-gear { opacity: 1; flex: 0 0 auto; margin-left: auto; margin-right: 12px; width: 20px; height: 20px; border: 0; background: transparent; color: var(--propia-text-muted); border-radius: 5px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; transition: color .12s, background .12s; }
    .utb-th-gear:hover { color: var(--propia-brand); background: var(--propia-brand-soft); }
    .utb-addcol-h { display: flex; align-items: center; justify-content: center; }
    .utb-addcol-btn { width: 26px; height: 26px; border-radius: 7px; border: 1px dashed var(--propia-border-input); background: transparent; color: var(--propia-text-muted); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; }
    .utb-addcol-btn:hover { border-color: var(--propia-brand); color: var(--propia-brand); border-style: solid; }
    .utb-addcol-cell { }
    /* Columna expander (2a, ancho 34px del GridStyle): flecha diagonal que abre la ficha; se revela al hover
       de la fila (espejo de .dtab-exp del Directorio / .tbl-exp de Unidades). */
    .utb-exp-col { display: flex; align-items: center; justify-content: center; }
    .utb-exp { width: 26px; height: 26px; border: 0; border-radius: 7px; background: var(--propia-brand-soft); color: var(--propia-brand); display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0; transition: opacity .12s, background .12s; }
    .utb-row:hover .utb-exp, .utb-newrow:hover .utb-exp, .utb-newrow:focus-within .utb-exp { opacity: 1; }
    .utb-exp:hover { background: var(--propia-brand-soft); }
    .utb-exp:disabled { opacity: 0; cursor: default; }
    .utb-newrow:hover .utb-exp:disabled, .utb-newrow:focus-within .utb-exp:disabled { opacity: .35; }
    /* Rol elegido en la fila de alta como PILDORA (chip violeta con "x" para cambiarlo). Un rol por usuario. */
    .utb-rol-pill { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; padding: 4px 6px 4px 11px; border-radius: 999px; background: var(--propia-brand-soft); color: var(--propia-brand-text-2, var(--propia-brand)); border: 1px solid var(--propia-brand-border); font-size: 12.5px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .utb-rol-pill-x { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 18px; height: 18px; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; opacity: .7; }
    .utb-rol-pill-x:hover { opacity: 1; background: var(--propia-brand-soft-2, rgba(109,79,227,.14)); }
    /* 2.5 v2.0: control multi-select inline (Rol/Cargo) = chips + "+" con menu toggle. */
    .usr-multi { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 5px; padding: 3px 2px; min-width: 0; }
    .usr-mchip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 4px 3px 10px; border-radius: 999px; font-size: 12.5px; font-weight: 700; white-space: nowrap; }
    .usr-mchip--rol { background: var(--propia-brand-soft); color: var(--propia-brand-text-2, var(--propia-brand)); }
    .usr-mchip--cargo { background: var(--propia-border-divider); color: var(--propia-text-body); }
    .usr-mchip-x { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; opacity: .55; font-size: 13px; line-height: 1; }
    .usr-mchip-x:hover { opacity: 1; background: rgba(0,0,0,.08); }
    .usr-mph { font-size: 12.5px; color: var(--propia-text-faint); }
    .usr-madd { flex: 0 0 auto; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; border: 1px dashed var(--propia-border-input); background: transparent; color: var(--propia-text-muted); border-radius: 6px; font-size: 15px; line-height: 1; cursor: pointer; font-family: inherit; }
    .usr-madd:hover { border-style: solid; border-color: var(--propia-brand); color: var(--propia-brand); }
    .usr-mback { position: fixed; inset: 0; z-index: 40; background: transparent; }
    .usr-mmenu { position: fixed; z-index: 4000; min-width: 200px; max-height: 280px; overflow: auto; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 10px; box-shadow: var(--propia-shadow-modal, 0 10px 30px rgba(27,42,58,.18)); padding: 5px; }
    .usr-mopt { display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; padding: 7px 9px; border: 0; background: transparent; border-radius: 7px; font-size: 13px; color: var(--propia-text-body); cursor: pointer; font-family: inherit; }
    .usr-mopt:hover { background: var(--propia-bg-card-soft); }
    .usr-mopt.on { color: var(--propia-brand); font-weight: 700; }
    .usr-mcheck { flex: 0 0 auto; width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid var(--propia-border-input); border-radius: 4px; font-size: 11px; color: var(--propia-brand); }
    .usr-mopt.on .usr-mcheck { border-color: var(--propia-brand); background: var(--propia-brand-soft); }
    .cod-key { font-weight: 700; color: var(--propia-brand-text); text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }
</style>
