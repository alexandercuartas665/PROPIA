        {
            var req = new CrearBloqueoRequest(_blqZona, TipoBloqueoZona.DiaCompleto,
                DateOnly.FromDateTime(_blqFechaIni), DateOnly.FromDateTime(_blqFechaFin),
                null, null, _blqEtiqueta, string.IsNullOrWhiteSpace(_blqMotivo) ? null : _blqMotivo,
