    private void CambiarSemana(int d) => _rsWeek += d;

    // ---------- Nueva reserva ----------
    private void AbrirReservar(Guid? zonaId, DateOnly? fecha)
    {
        var zonas = ZonasReservables;
        _resZona = zonaId ?? (zonas.FirstOrDefault()?.ZonaComunId ?? Guid.Empty);
        _resUnidad = Guid.Empty; _resPersona = Guid.Empty; _responsables = null; _resError = null;

        // Hora por defecto: si la fecha elegida es HOY, arranca en la proxima hora valida
        // (>= ahora + anticipacion minima) para no chocar con RN-07 al confirmar el default.
        // Si ya no cabe una franja util hoy, pasa a manana 10:00. "Hoy" se calcula en hora de
        // Colombia (no la del servidor, que en prod es UTC).
        var ahora = AhoraColombia();
        var hoy = DateOnly.FromDateTime(ahora.Date);
        var fechaSel = fecha ?? hoy.AddDays(1);
        // Clic en un dia pasado de la agenda (se puede navegar a semanas anteriores):
        // no abrir el formulario con una fecha vencida, que dispara RN-07 al guardar.
        if (fechaSel < hoy) fechaSel = hoy;
        int hIni = 10, hFin = 12;
        if (fechaSel == hoy)
        {
            var minStart = ahora.AddHours(1).AddMinutes(15);
            var h = (minStart.Minute > 0 || minStart.Second > 0) ? minStart.Hour + 1 : minStart.Hour;
            if (h < 8) h = 8;
            if (h > 21) { fechaSel = hoy.AddDays(1); hIni = 10; hFin = 12; }
            else { hIni = h; hFin = Math.Min(h + 2, 22); }
        }

        _resFecha = fechaSel.ToDateTime(TimeOnly.MinValue);
        _resHoraIni = DateTime.Today.Date.AddHours(hIni);
        _resHoraFin = DateTime.Today.Date.AddHours(hFin);
        _resReglamento = true;
        _showReservar = true;
    }

    /// <summary>Ahora en hora de Colombia (America/Bogota). En prod el servidor corre en UTC,
    /// asi que DateTime.Now/Today no sirven para decidir "hoy" ni la hora minima de reserva.</summary>
    private static DateTime AhoraColombia()
    {
        try { return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota")); }
        catch { return DateTime.UtcNow.AddHours(-5); }
    }

    private void CerrarReservar() => _showReservar = false;

    /// <summary>Al elegir la unidad (cascada Torre->Unidad), carga como responsables solo los
    /// terceros vinculados a esa unidad (propietarios/residentes/familiares/...). Excluye por
    /// diseno a servicios generales / empleadas de servicio (entidad aparte) y a empresas.</summary>
    private async Task OnUnidadReservaChanged(Guid? unidadId)
    {
        _resUnidad = unidadId ?? Guid.Empty;
        _resPersona = Guid.Empty;
        _responsables = null;
        if (_resUnidad == Guid.Empty) return;
        try
        {
            var lista = await Auth().GetFromJsonAsync<List<UnidadPersonaDto>>($"/api/mi-copropiedad/unidades/{_resUnidad}/personas") ?? new();
            _responsables = lista
                .Where(p => p.EntidadTipo == EntidadDirectorio.Persona && p.PersonaId != Guid.Empty)
                .GroupBy(p => p.PersonaId).Select(g => g.First())
                .ToList();
        }
        catch { _responsables = new(); }
    }

    private static string RolTexto(RolUnidadPersona rol) => rol switch
    {
        RolUnidadPersona.Propietario => "Propietario",
        RolUnidadPersona.Residente => "Residente",
        RolUnidadPersona.Familiar => "Familiar",
        RolUnidadPersona.Arrendatario => "Arrendatario",
        RolUnidadPersona.Apoderado => "Apoderado",
        _ => rol.ToString()
    };

    private async Task ConfirmarReservar()
    {
        _resError = null;
        if (_resZona == Guid.Empty) { _resError = "Selecciona una zona."; return; }
        _busy = true;
        try
        {
            var req = new CrearReservaRequest(_resZona, _resPersona, _resUnidad,
                DateOnly.FromDateTime(_resFecha),
                TimeOnly.FromDateTime(_resHoraIni), TimeOnly.FromDateTime(_resHoraFin),
                _resReglamento);
            var resp = await Auth().PostAsJsonAsync("/api/reservas", req);
            if (!resp.IsSuccessStatusCode) { _resError = ExtraerError(await resp.Content.ReadAsStringAsync()); return; }
            _msg = "Reserva creada."; _msgClass = "alert-success";
            _showReservar = false;
            _rsWeek = SemanaOffset(DateOnly.FromDateTime(_resFecha)); // saltar la agenda a la semana de la reserva recien creada
            await RecargarReservasAsync();
        }
        catch (Exception ex) { _resError = ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>La API devuelve los errores de negocio como {"error":"..."}. Extrae ese texto para
    /// mostrarlo limpio dentro del modal; si no es ese formato, devuelve el texto tal cual.</summary>
    private static string ExtraerError(string? body)
    {
        if (string.IsNullOrWhiteSpace(body)) return "No se pudo crear la reserva.";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object
                && doc.RootElement.TryGetProperty("error", out var e)
                && e.ValueKind == System.Text.Json.JsonValueKind.String)
                return e.GetString() ?? body;
        }
        catch { /* no era JSON */ }
        return body.Length > 300 ? body[..300] : body;
    }

    private async Task AprobarReserva(Guid id)
    {
        var resp = await Auth().PostAsJsonAsync($"/api/reservas/{id}/aprobar", new { });
        if (resp.IsSuccessStatusCode) { _msg = "Reserva aprobada."; _msgClass = "alert-success"; await RecargarReservasAsync(); }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    private async Task CancelarReserva(Guid id)
    {
        if (!await Modals.ConfirmAsync("Cancelar esta reserva?", "Cancelar reserva")) return;
        var resp = await Auth().PostAsJsonAsync($"/api/reservas/{id}/cancelar-admin", new CancelarReservaRequest("Cancelado por administracion"));
        if (resp.IsSuccessStatusCode) await RecargarReservasAsync();
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    // ---------- Configuracion ----------
    private async Task AbrirConfig(Guid zonaId)
    {
        _configZonaNombre = ZonasReservables.FirstOrDefault(z => z.ZonaComunId == zonaId)?.Nombre ?? "";
        ZonaConfigDto? existing = null;
        try { existing = await Auth().GetFromJsonAsync<ZonaConfigDto>($"/api/reservas/configs/{zonaId}"); } catch { }
        _configEdit = new ConfigEdit
        {
            ZonaComunId = zonaId,
            RequiereAprobacion = existing?.RequiereAprobacion ?? false,
            AnticipacionMinimaHoras = existing?.AnticipacionMinimaHoras ?? 1,
            AnticipacionMaximaDias = existing?.AnticipacionMaximaDias ?? 30,
            DuracionMinimaMinutos = existing?.DuracionMinimaMinutos ?? 60,
            DuracionMaximaMinutos = existing?.DuracionMaximaMinutos ?? 240,
            TieneTarifa = existing?.TieneTarifa ?? false,
            ValorTarifa = existing?.ValorTarifa ?? 0,
            ModalidadCobro = existing?.ModalidadCobro ?? ModalidadCobroReserva.PorHora,
            Franjas = existing?.Franjas.Select(f => new FranjaEdit { DiaSemana = f.DiaSemana, HoraApertura = f.HoraApertura, HoraCierre = f.HoraCierre }).ToList() ?? new()
        };
        _showConfig = true;
    }

    private void ToggleFranja(DiaSemanaReserva dia, bool activar)
    {
        if (_configEdit is null) return;
        if (activar)
        {
            if (!_configEdit.Franjas.Any(f => f.DiaSemana == dia))
                _configEdit.Franjas.Add(new FranjaEdit { DiaSemana = dia, HoraApertura = new TimeOnly(8, 0), HoraCierre = new TimeOnly(22, 0) });
        }
        else _configEdit.Franjas.RemoveAll(f => f.DiaSemana == dia);
    }

    private void SetFranjaHora(int idx, bool esApertura, string value)
    {
        if (_configEdit is null || idx >= _configEdit.Franjas.Count) return;
        if (TimeOnly.TryParse(value, out var t))
        {
            if (esApertura) _configEdit.Franjas[idx].HoraApertura = t;
            else _configEdit.Franjas[idx].HoraCierre = t;
        }
    }

    private async Task GuardarConfig()
    {
        if (_configEdit is null) return;
        _busy = true;
        try
        {
            var req = new GuardarConfigRequest(
                _configEdit.ZonaComunId,
                _configEdit.RequiereAprobacion, null, true,
                _configEdit.AnticipacionMinimaHoras, _configEdit.AnticipacionMaximaDias,
                _configEdit.DuracionMinimaMinutos, _configEdit.DuracionMaximaMinutos, 60,
                _configEdit.TieneTarifa, _configEdit.ModalidadCobro, _configEdit.ValorTarifa,
                PoliticaReembolso.SinReembolso, 0,
                24, true, ComportamientoCancelacionTardia.ConPenalidad,
                null, false, true,
                _configEdit.Franjas.Select(f => new FranjaInput(f.DiaSemana, f.HoraApertura, f.HoraCierre, true)).ToList());
            var resp = await Auth().PutAsJsonAsync("/api/reservas/configs", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Configuracion guardada."; _msgClass = "alert-success";
            _showConfig = false;
        }
        finally { _busy = false; }
    }

