    private static string IconoZona(string nombre)
    {
        var n = (nombre ?? "").ToLowerInvariant();
        if (n.Contains("bbq") || n.Contains("parrilla") || n.Contains("terraza")) return "M6 3v4M10 3v4M14 3v4M4 11h16l-1 9H5z";
        if (n.Contains("cancha") || n.Contains("tenis") || n.Contains("futbol") || n.Contains("deport")) return "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20M2 12h20M12 2v20";
        if (n.Contains("gim") || n.Contains("gym")) return "M6 7v10M18 7v10M4 9v6M20 9v6M6 12h12";
        if (n.Contains("piscina") || n.Contains("pool")) return "M2 16c2 0 2 1.5 4 1.5S10 16 12 16s2 1.5 4 1.5 2-1.5 4-1.5M2 12c2 0 2 1.5 4 1.5S10 12 12 12";
        return "M3 21h18M5 21V8h14v13M9 12h.01M15 12h.01"; // salon / default
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
