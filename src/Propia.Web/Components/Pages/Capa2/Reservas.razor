@page "/reservas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Propia.Application.Reservas
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject IModalService Modals

<PageTitle>Reservas - PROPIA</PageTitle>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="rs-wrap">

    @* ---------- Encabezado ---------- *@
    <div class="rs-head">
        <div>
            <h1 class="rs-title">Reservas de zonas comunes</h1>
            <p class="rs-sub">Agenda de reservas y zonas reservables de la copropiedad.</p>
        </div>
        <div class="rs-actions">
            <button class="rs-btn rs-btn-ghost" @onclick="AbrirBloqueo"><i class="fi fi-rr-ban"></i>Bloqueo</button>
            <button class="rs-btn rs-btn-primary" @onclick="() => AbrirReservar(null, null)">
                <i class="fi fi-rr-plus"></i>Nueva reserva
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

    @if (_galeria is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color:var(--propia-brand)"></div></div>
    }
    else if (ZonasReservables.Count == 0)
    {
        <div class="rs-empty">
            No hay zonas marcadas como <b>reservables</b>. Marca una zona como reservable en <a href="/espacios">Equipos y Zonas Comunes</a> para que aparezca aquí.
        </div>
    }
    else
    {
        @* ---------- Barra canonica (= modulos vista tabla): Filtros, Buscar, Ordenar/Agrupar/Columnas (solo
           Tabla) y selector de vista Calendario | Tabla. Las tarjetas de zonas se retiraron (no escalan con
           muchas zonas): configurar una zona = clic en su nombre en la agenda. ---------- *@
        <div class="mod-filtros rs-toolbar">
            <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="OnFiltroChanged" />
            <div class="mod-search" style="flex:1 1 180px; max-width:255px; min-width:160px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                @* Sin value= (convencion del equipo): asi el re-render por tecla no "come" letras. *@
                <input class="mod-search-inp" placeholder="Buscar zona, unidad o reserva..." @oninput="OnBuscar" />
            </div>
            <div style="flex:1;"></div>
            @if (_vista == "tabla")
            {
                <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sorts" SortsChanged="OnSortsChanged" />
                <TablaAgruparMenu Columnas="ColsAgrupables()" Grupos="_grupos" GruposChanged="OnGruposChanged" />
                <TablaColumnasMenu Columnas="ColsVisibilidad()" OnMover="MoverColMenu" OnToggleVisible="ToggleVisibleCol"
                                   OnOcultarTodas="OcultarTodasCol" OnMostrarTodas="MostrarTodasCol" OnRestablecer="RestablecerCol" />
            }
            <TablaVistaToggle Opciones="@(new[] { TablaVistaToggle.Calendario("calendario"), TablaVistaToggle.Tabla("tabla") })" Valor="@_vista" OnCambiar="SetVista" />
        </div>

        @if (_vista == "calendario")
        {
        var filtr = ReservasFiltradas().Where(r => EsActiva(r.Estado)).ToList();
        var zonasAgenda = ZonasAgenda(filtr);
        @* ---------- Agenda semanal de ocupacion ---------- *@
        <div class="rs-card">
            <div class="rs-card-head">
                <div class="rs-card-title">Agenda semanal de ocupacion</div>
                <div class="rs-week-nav">
                    <button class="rs-week-btn" title="Semana anterior" @onclick="() => CambiarSemana(-1)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 6l-6 6 6 6"></path></svg>
                    </button>
                    <span class="rs-week-label">@SemanaLabel</span>
                    <button class="rs-week-btn" title="Semana siguiente" @onclick="() => CambiarSemana(1)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
                <div class="rs-legend">
                    <span class="rs-lg rs-lg-conf"><span class="rs-dot"></span>Confirmada</span>
                    <span class="rs-lg rs-lg-pend"><span class="rs-dot"></span>Pendiente</span>
                </div>
            </div>
            <div class="rs-grid">
                @* fila de cabecera: esquina + 7 dias *@
                <div class="rs-grid-corner"></div>
                @foreach (var d in DiasSemana)
                {
                    var hoy = d == DateOnly.FromDateTime(AhoraColombia().Date);
                    <div class="rs-day-h @(hoy ? "is-today" : "")">
                        <div class="rs-day-name">@Cap(d.ToString("ddd", Es))</div>
                        <div class="rs-day-num">@d.Day</div>
                    </div>
                }
                @* filas por zona *@
                @foreach (var z in zonasAgenda)
                {
                    var zcfg = z.ZonaComunId;
                    @* Clic en el nombre = configurar la zona (antes era la tarjeta de la zona). *@
                    <button type="button" class="rs-row-label rs-row-label-btn" title="Configurar zona" @onclick="() => AbrirConfig(zcfg)">
                        <span class="rs-row-zona">
                            @* Miniatura de la zona: su foto o, si no tiene, las iniciales (como la tarjeta de identidad). *@
                            @if (!string.IsNullOrWhiteSpace(z.FotoUrl))
                            {
                                <span class="rs-row-thumb" style="background-image:url('@z.FotoUrl')"></span>
                            }
                            else
                            {
                                <span class="rs-row-thumb rs-row-thumb--ini">@FichaIdentidad.InicialesDe(z.Nombre)</span>
                            }
                            <span class="rs-row-zona-nm">@z.Nombre</span>
                        </span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
                    </button>
                    @foreach (var d in DiasSemana)
                    {
                        var hoy = d == DateOnly.FromDateTime(AhoraColombia().Date);
                        var celdas = filtr.Where(r => r.ZonaComunId == z.ZonaComunId && r.Fecha == d).OrderBy(r => r.HoraInicio).ToList();
                        var zid = z.ZonaComunId;
                        var dd = d;
                        <div class="rs-cell @(hoy ? "is-today" : "")">
                            @if (celdas.Count > 0)
                            {
                                var r = celdas[0];
                                var conf = r.Estado == EstadoReserva.Confirmada;
                                <div class="rs-ev rs-ev-click @(conf ? "rs-ev-conf" : "rs-ev-pend")" role="button"
                                     title="@TipReserva(r, celdas.Count - 1)" @onclick="() => AbrirEditar(r)">
                                    <div class="rs-ev-hora">@ShortHora(r.HoraInicio)-@ShortHora(r.HoraFin)</div>
                                    <div class="rs-ev-resp">@r.UnidadNumero</div>
                                    @if (celdas.Count > 1)
                                    {
                                        <div class="rs-ev-extra">+@(celdas.Count - 1) mas</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <button class="rs-cell-add" title="Reservar este día" @onclick="() => AbrirReservar(zid, dd)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"></path></svg>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
            @if (zonasAgenda.Count == 0) { <div class="rs-list-empty">Sin zonas ni reservas que coincidan con el filtro o la búsqueda.</div> }
        </div>

        @* ---------- Proximas reservas (respetan filtros y busqueda) ---------- *@
        var proximas = Proximas(filtr);
        <div class="rs-card">
            <div class="rs-card-title rs-card-title-pad">Próximas reservas</div>
            @if (proximas.Count == 0)
            {
                <div class="rs-list-empty">Sin reservas próximas.</div>
            }
            else
            {
                @foreach (var r in proximas)
                {
                    var rid = r.Id; var rr = r;
                    <div class="rs-resv rs-resv-click" @onclick="() => AbrirEditar(rr)" title="Editar o cancelar reserva">
                        <div class="rs-resv-fecha">@FechaCorta(r.Fecha)</div>
                        <div class="rs-resv-main">
                            <div class="rs-resv-zona">@r.ZonaNombre</div>
                            <div class="rs-resv-sub">@ShortHora(r.HoraInicio) - @ShortHora(r.HoraFin) &middot; <span class="u-cod">@r.UnidadNumero</span> @(string.IsNullOrWhiteSpace(r.PersonaNombre) ? "" : "- " + r.PersonaNombre)</div>
                        </div>
                        <span class="rs-badge" style="color:@EstadoFg(r.Estado);background:@EstadoBg(r.Estado)">@EstadoTexto(r.Estado)</span>
                        @if (r.Estado == EstadoReserva.PendienteAprobacion)
                        {
                            <button class="rs-aprobar" @onclick:stopPropagation="true" @onclick="() => AprobarReserva(rid)">Aprobar</button>
                        }
                        @if (r.Estado == EstadoReserva.Confirmada || r.Estado == EstadoReserva.PendienteAprobacion || r.Estado == EstadoReserva.PendientePago)
                        {
                            <button class="rs-editar" title="Editar reserva" @onclick:stopPropagation="true" @onclick="() => AbrirEditar(rr)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="rs-cancel" title="Cancelar reserva" @onclick:stopPropagation="true" @onclick="() => CancelarReserva(rid)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                            </button>
                        }
                    </div>
                }
            }
        </div>

        @* ---------- Bloqueos activos ---------- *@
        @if (_bloqueos is { Count: > 0 })
        {
            <div class="rs-card">
                <div class="rs-card-title rs-card-title-pad">Bloqueos activos</div>
                @foreach (var b in _bloqueos)
                {
                    var bid = b.Id;
                    <div class="rs-resv">
                        <div class="rs-resv-main">
                            <div class="rs-resv-zona">@b.ZonaNombre</div>
                            <div class="rs-resv-sub">
                                @b.FechaInicio.ToString("yyyy-MM-dd")@(b.FechaInicio == b.FechaFin ? "" : " a " + b.FechaFin.ToString("yyyy-MM-dd"))
                                @(string.IsNullOrWhiteSpace(b.MotivoPersonalizado) ? "" : "- " + b.MotivoPersonalizado)
                            </div>
                        </div>
                        <span class="rs-badge" style="color:#B45309;background:#FEF3DC">@LblBloq(b.Etiqueta)</span>
                        <span class="rs-badge" style="color:var(--propia-text-muted);background:var(--propia-border-divider)">@(b.Origen == OrigenBloqueoZona.AutomaticoSistema ? "Auto" : "Manual")</span>
                        @if (b.Origen != OrigenBloqueoZona.AutomaticoSistema)
                        {
                            <button class="rs-cancel" title="Eliminar bloqueo" @onclick="() => EliminarBloqueo(bid)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                            </button>
                        }
                    </div>
                }
            </div>
        }
        }
        else
        {
            @* ---------- Vista Tabla: una reserva por fila (frame canonico .tbl). Expansor y clic derecho abren
               las acciones; encabezado = ordenar al clic + flecha con el menu de columna. ---------- *@
            var niveles = Niveles;
            var total = ReservasFiltradas().Count();
            <div class="tblwrap rs-tblwrap">
                <div class="tblscroll">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th class="tbl-exp"></th>
                                @foreach (var c in ColsVis)
                                {
                                    var ck = c.Key;
                                    <th class="tbl-th--menu" @onclick="() => OrdenarPorClic(ck)">
                                        <span class="tbl-th-lbl">@c.Label</span>@SortInd(ck)@ChevCol(ck, c.Label)
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (niveles.Count == 0)
                            {
                                @foreach (var r in PaginaActual()) { @FilaTpl(r) }
                            }
                            else
                            {
                                <TablaGruposRenderTr T="ReservaDto" Nodos="@ArbolGrupos(niveles)" FilaTemplate="FilaTpl" />
                            }
                        </tbody>
                    </table>
                    @if (total == 0) { <div class="rs-list-empty">Sin reservas que coincidan con el filtro o la búsqueda.</div> }
                </div>
                @if (niveles.Count == 0)
                {
                    <TablaPager Total="total" Pagina="_pagina" PorPagina="_porPagina" Entidad="reservas"
                                PaginaChanged="v => _pagina = v" PorPaginaChanged="v => { _porPagina = v; _pagina = 1; }" />
                }
                else
                {
                    <div class="tbl-foot"><span>Mostrando <strong>@total</strong> reservas</span></div>
                }
            </div>
        }
    }
</div>

<TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" />
<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />

@* ===================== Modal Nueva reserva ===================== *@
@if (_showReservar)
{
    <div class="rs-modal-bd" @onclick="CerrarReservar">
        <div class="rs-modal rs-modal-zimg" @onclick:stopPropagation="true">
            <div class="rs-modal-head">
                <div class="rs-modal-ic">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
                </div>
                <div class="rs-modal-tt">
                    <div class="rs-modal-h">Nueva reserva</div>
                    <div class="rs-modal-s">Zonas comunes de la copropiedad</div>
                </div>
                <ModalHeaderActions EnEdicion="true" MostrarEditar="false" MostrarEliminar="false"
                                    MostrarCancelar="true" Guardando="_busy"
                                    PuedeGuardar="@(_resUnidad != Guid.Empty && _resPersona != Guid.Empty)"
                                    TituloGuardar="Crear reserva" OnGuardar="ConfirmarReservar"
                                    OnCancelarEdicion="CerrarReservar" OnCerrar="CerrarReservar" />
            </div>
            <div class="rs-split">
            @ZonaImagen(_resZona)
            <div class="rs-modal-body">
                <div class="rs-fld">
                    <label>Zona común</label>
                    <select @bind="_resZona">
                        @foreach (var z in ZonasReservables) { <option value="@z.ZonaComunId">@z.Nombre</option> }
                    </select>
                </div>
                <div class="rs-fld">
                    <label>Fecha *</label>
                    <input type="date" @bind="_resFecha" min="@DateOnly.FromDateTime(AhoraColombia()).ToString("yyyy-MM-dd")" />
                </div>
                <div class="rs-grid2">
                    <div class="rs-fld">
                        <label>Hora inicio *</label>
                        <input type="time" @bind="_resHoraIni" />
                    </div>
                    <div class="rs-fld">
                        <label>Hora fin *</label>
                        <input type="time" @bind="_resHoraFin" />
                    </div>
                </div>
                <div class="rs-fld">
                    <label>Unidad *</label>
                    <SelectorUnidadCodigo Unidades="_unidades"
                                          UnidadId="@(_resUnidad == Guid.Empty ? (Guid?)null : _resUnidad)"
                                          UnidadIdChanged="OnUnidadReservaChanged"
                                          Placeholder="Código de unidad (ej. 101, A-203)..." />
                </div>
                <div class="rs-fld">
                    <label>Responsable *</label>
                    <select @bind="_resPersona" disabled="@(_resUnidad == Guid.Empty)">
                        <option value="">@(_resUnidad == Guid.Empty ? "Elige una unidad primero" : "Seleccionar...")</option>
                        @if (_responsables is not null)
                        {
                            @foreach (var p in _responsables) { <option value="@p.PersonaId">@p.PersonaNombre - @RolTexto(p.Rol)</option> }
                        }
                    </select>
                    @if (_resUnidad != Guid.Empty && _responsables is not null && _responsables.Count == 0)
                    {
                        <span style="font-size:11.5px;color:#EF4444;font-weight:600;">Sin personas asociadas a esta unidad. Vinculalas en Unidades privadas.</span>
                    }
                </div>
                <label class="rs-check">
                    <input type="checkbox" @bind="_resReglamento" />
                    <span>El residente acepta el reglamento de uso de la zona.</span>
                </label>
                <div class="rs-note">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16h.01"></path></svg>
                    <span>Si la zona requiere aprobación, la reserva queda <b>Pendiente</b> hasta que el administrador la apruebe.</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_resError))
                {
                    <div class="rs-modal-err">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16h.01"></path></svg>
                        <span>@_resError</span>
                    </div>
                }
            </div>
            </div>
        </div>
    </div>
}

@* ===================== Modal Editar / reprogramar reserva ===================== *@
@if (_editOpen)
{
    <div class="rs-modal-bd" @onclick="() => _editOpen = false">
        <div class="rs-modal rs-modal-zimg" @onclick:stopPropagation="true">
            <div class="rs-modal-head">
                <div class="rs-modal-ic">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
                </div>
                <div class="rs-modal-tt">
                    <div class="rs-modal-h">Editar reserva</div>
                    <div class="rs-modal-s">@_editZonaNombre</div>
                </div>
                <ModalHeaderActions EnEdicion="true" MostrarEditar="false" MostrarCancelar="false"
                                    MostrarEliminar="true" TituloEliminar="Cancelar reserva"
                                    Guardando="_editBusy" TituloGuardar="Guardar cambios"
                                    OnGuardar="GuardarEdit" OnEliminar="CancelarDesdeEdit"
                                    OnCerrar="@(() => _editOpen = false)" />
            </div>
            <div class="rs-split">
            @ZonaImagen(_editZonaId)
            <div class="rs-modal-body">
                @if (!string.IsNullOrEmpty(_editMsg)) { <div class="alert alert-danger py-2 small">@_editMsg</div> }
                <div class="rs-fld">
                    <label>Fecha *</label>
                    <input type="date" @bind="_editFecha" />
                </div>
                <div class="rs-grid2">
                    <div class="rs-fld">
                        <label>Hora inicio *</label>
                        <input type="time" @bind="_editHoraIni" />
                    </div>
                    <div class="rs-fld">
                        <label>Hora fin *</label>
                        <input type="time" @bind="_editHoraFin" />
                    </div>
                </div>

                <div class="rs-traza">
                    <div class="rs-traza-lbl">Trazabilidad del préstamo</div>
                    <TrazabilidadEntrega Jwt="@(_jwt ?? "")" BasePath="/api/reservas" Id="@_editId"
                                         EntregadoAt="@_editEntregadaAt" DevueltoAt="@_editDevueltaAt"
                                         EntregaObs="@_editEntregaObs" DevolucionObs="@_editDevolucionObs"
                                         OnCambio="RecargarEditAsync" />
                </div>
            </div>
            </div>
        </div>
    </div>
}

@* Lightbox de la imagen de la zona (clic en la imagen de los modales de reserva): original completa. *@
@if (!string.IsNullOrWhiteSpace(_verImagenZona))
{
    <div class="rs-lb" @onclick="() => _verImagenZona = null">
        <button class="rs-lb-x" type="button" title="Cerrar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        <img src="@_verImagenZona" alt="Imagen de la zona" />
    </div>
}

@* ===================== Modal Configurar zona ===================== *@
@if (_showConfig && _configEdit is not null)
{
    <div class="rs-modal-bd" @onclick="() => _showConfig = false">
        <div class="rs-modal rs-modal-lg" @onclick:stopPropagation="true">
            <div class="rs-modal-head">
                <div class="rs-modal-ic">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                </div>
                <div class="rs-modal-tt">
                    <div class="rs-modal-h">Configurar zona reservable</div>
                    <div class="rs-modal-s">@(_configZonaNombre)</div>
                </div>
                <button class="rs-modal-x" @onclick="() => _showConfig = false">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="rs-modal-body">
                <div class="rs-grid2">
                    <div class="rs-fld"><label>Anticipacion minima (horas)</label><input type="number" min="0" @bind="_configEdit.AnticipacionMinimaHoras" /></div>
                    <div class="rs-fld"><label>Anticipacion maxima (días)</label><input type="number" min="1" @bind="_configEdit.AnticipacionMaximaDias" /></div>
                    <div class="rs-fld"><label>Duracion minima (min)</label><input type="number" min="15" @bind="_configEdit.DuracionMinimaMinutos" /></div>
                    <div class="rs-fld"><label>Duracion maxima (min)</label><input type="number" min="15" @bind="_configEdit.DuracionMaximaMinutos" /></div>
                </div>
                <label class="rs-check">
                    <input type="checkbox" @bind="_configEdit.RequiereAprobacion" />
                    <span>Requiere aprobación del administrador antes de confirmar.</span>
                </label>
                <div class="rs-grid3">
                    <label class="rs-check rs-check-inline"><input type="checkbox" @bind="_configEdit.TieneTarifa" /><span>Tiene tarifa</span></label>
                    <div class="rs-fld"><label>Valor (COP)</label><input type="number" @bind="_configEdit.ValorTarifa" disabled="@(!_configEdit.TieneTarifa)" /></div>
                    <div class="rs-fld"><label>Modalidad</label>
                        <select @bind="_configEdit.ModalidadCobro" disabled="@(!_configEdit.TieneTarifa)">
                            @foreach (var m in Enum.GetValues<ModalidadCobroReserva>()) { <option value="@m">@m</option> }
                        </select>
                    </div>
                </div>
                <div class="rs-franjas">
                    <div class="rs-fld-lbl">Días disponibles y horario</div>
                    @foreach (var dia in Enum.GetValues<DiaSemanaReserva>())
                    {
                        var d = dia;
                        var franja = _configEdit.Franjas.FirstOrDefault(f => f.DiaSemana == d);
                        <div class="rs-franja-row">
                            <label class="rs-check rs-check-inline">
                                <input type="checkbox" checked="@(franja != null)" @onchange="(e) => ToggleFranja(d, (bool)e.Value!)" />
                                <span>@d</span>
                            </label>
                            @if (franja is not null)
                            {
                                var idx = _configEdit.Franjas.IndexOf(franja);
                                <input type="time" value="@franja.HoraApertura.ToString("HH\\:mm")" @onchange="(e) => SetFranjaHora(idx, true, e.Value?.ToString() ?? string.Empty)" />
                                <span class="rs-franja-sep">a</span>
                                <input type="time" value="@franja.HoraCierre.ToString("HH\\:mm")" @onchange="(e) => SetFranjaHora(idx, false, e.Value?.ToString() ?? string.Empty)" />
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="rs-modal-foot">
                <button class="rs-btn rs-btn-ghost" @onclick="() => _showConfig = false">Cancelar</button>
                <button class="rs-btn rs-btn-primary" @onclick="GuardarConfig" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar configuracion")</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal Crear bloqueo ===================== *@
@if (_showCrearBloqueo)
{
    <div class="rs-modal-bd" @onclick="() => _showCrearBloqueo = false">
        <div class="rs-modal" @onclick:stopPropagation="true">
            <div class="rs-modal-head">
                <div class="rs-modal-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M5 5l14 14"></path></svg></div>
                <div class="rs-modal-tt"><div class="rs-modal-h">Nuevo bloqueo</div><div class="rs-modal-s">Cierra una zona en una fecha o periodo</div></div>
                <ModalHeaderActions EnEdicion="true" MostrarEditar="false" MostrarEliminar="false"
                                    MostrarCancelar="true" Guardando="_busy"
                                    PuedeGuardar="@(_blqZona != Guid.Empty)"
                                    TituloGuardar="Crear bloqueo" OnGuardar="CrearBloqueo"
                                    OnCancelarEdicion="@(() => _showCrearBloqueo = false)" OnCerrar="@(() => _showCrearBloqueo = false)" />
            </div>
            <div class="rs-modal-body">
                <div class="rs-fld">
                    <label>Zona *</label>
                    <select @bind="_blqZona">
                        <option value="">Seleccionar...</option>
                        @foreach (var z in ZonasReservables) { <option value="@z.ZonaComunId">@z.Nombre</option> }
                    </select>
                </div>
                <div class="rs-grid2">
                    <div class="rs-fld"><label>Fecha inicio *</label><input type="date" @bind="_blqFechaIni" /></div>
                    <div class="rs-fld"><label>Fecha fin *</label><input type="date" @bind="_blqFechaFin" /></div>
                </div>
                <div class="rs-grid2">
                    <div class="rs-fld"><label>Etiqueta <button type="button" title="Gestionar opciones de la lista" @onclick="() => _gestEtqBloq = true" style="background:none;border:none;cursor:pointer;color:var(--propia-text-muted);padding:0 2px;font-size:12px;vertical-align:middle;"><i class="fi fi-rr-settings-sliders"></i></button></label>
                        <select @bind="_blqEtiqueta">@foreach (var e in Enum.GetValues<EtiquetaBloqueo>().Where(x => RowBloq(x)?.Activo != false)) { <option value="@e">@LblBloq(e)</option> }</select>
                    </div>
                    <label class="rs-check rs-check-inline" style="align-self:flex-end;padding-bottom:8px">
                        <input type="checkbox" @bind="_blqVisible" /><span>Visible al residente</span>
                    </label>
                </div>
                <div class="rs-fld"><label>Motivo (opcional)</label><textarea rows="2" @bind="_blqMotivo"></textarea></div>
            </div>
        </div>
    </div>
}
}

@if (_gestEtqBloq)
{
    <GestionarOpcionesListaModal Lista="reserva.etiquetabloqueo" Titulo="Reservas · Etiqueta de bloqueo"
                                 Jwt="@_jwt" PermiteAgregar="false"
                                 Guardado="RecargarEtqBloqAsync" Cerrado="() => _gestEtqBloq = false" />
}

<style>
    /* Canon margen lateral (= Unidades): el gutter lo da solo .app-wrapper; el wrapper de pagina no
       agrega padding horizontal propio ni max-width/centrado (asi usa todo el ancho del area de trabajo). */
    .rs-wrap { width: 100%; max-width: none; margin: 0; padding: 6px 0 60px; font-family: 'Lexend', sans-serif; box-sizing: border-box; }
    .rs-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
    .rs-title { font-size: 27px; font-weight: 800; letter-spacing: -.6px; color: var(--propia-text-h1); margin: 0; }
    .rs-sub { font-size: 14px; color: var(--propia-text-muted); margin: 4px 0 0; }
    .rs-actions { display: flex; gap: 9px; flex-shrink: 0; }
    .rs-btn { display: inline-flex; align-items: center; gap: 7px; padding: 10px 16px; border-radius: 10px; font-size: 13px; font-weight: 700; border: 0; cursor: pointer; }
    .rs-btn-primary { background: var(--propia-brand); color: var(--propia-text-inverse); box-shadow: 0 6px 16px rgba(109,79,227,.3); }
    .rs-btn-primary:hover { background: var(--propia-brand-hover); color: var(--propia-text-inverse); }
    .rs-btn-primary:disabled { opacity: .6; cursor: default; }
    .rs-btn-ghost { background: var(--propia-bg-card); color: var(--propia-text-secondary); border: 1px solid var(--propia-border-card); }
    .rs-btn-ghost:hover { border-color: var(--propia-brand); color: var(--propia-brand); }

    .rs-empty { background: var(--propia-bg-card); border: 1px dashed var(--propia-text-faint); border-radius: 14px; padding: 28px; text-align: center; color: var(--propia-text-muted); font-size: 13.5px; }

    /* Barra canonica (= modulos vista tabla) y vista Tabla sobre el frame compartido .tbl (tabla-base.css). */
    .rs-toolbar { margin-bottom: 14px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .rs-tblwrap { margin-bottom: 16px; }
    .rs-tblwrap .rs-list-empty { padding: 18px 20px; }
    /* Nombre de la zona en la agenda = boton "Configurar zona" (reemplaza la tarjeta de la zona). */
    .rs-row-label-btn { width: 100%; gap: 6px; justify-content: space-between; background: transparent; border: 0; border-bottom: 1px solid var(--propia-border-divider); text-align: left; cursor: pointer; font-family: inherit; }
    .rs-row-label-btn svg { flex-shrink: 0; color: var(--propia-text-faint); opacity: 0; transition: opacity .12s; }
    .rs-row-label-btn:hover { background: var(--propia-brand-soft-2); color: var(--propia-brand); }
    .rs-row-label-btn:hover svg { opacity: 1; color: var(--propia-brand); }
    /* Miniatura de la zona en la primera columna de la agenda. */
    .rs-row-zona { display: flex; align-items: center; gap: 9px; min-width: 0; }
    .rs-row-zona-nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .rs-row-thumb { width: 34px; height: 34px; flex: 0 0 34px; border-radius: 9px; background-size: cover; background-position: center; background-color: var(--propia-border-divider); box-shadow: 0 0 0 1px var(--propia-border-card); }
    .rs-row-thumb--ini { display: inline-flex; align-items: center; justify-content: center; background: var(--propia-brand-soft); color: var(--propia-brand); font-size: 11.5px; font-weight: 800; box-shadow: none; }
    .rs-resv-click { cursor: pointer; }
    .rs-resv-click:hover { background: var(--propia-brand-soft-2); }
    .rs-editar { width: 28px; height: 28px; flex-shrink: 0; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-brand); border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .rs-editar:hover { background: var(--propia-brand-soft); border-color: #B9AEF3; }
    .rs-modal-foot-split { justify-content: space-between !important; }
    .rs-foot-right { display: flex; gap: 9px; }
    .rs-btn-danger { background: var(--propia-bg-card); color: #D7263D; border: 1px solid #F2CFC9; }
    .rs-btn-danger:hover { background: var(--propia-danger-soft); }
    [data-bs-theme="dark"] .rs-editar { background: var(--propia-bg-card); border-color: var(--propia-border-card); }

    .rs-card { background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 14px; box-shadow: 0 1px 2px rgba(45,62,80,.05); overflow: hidden; margin-bottom: 16px; }
    .rs-card-head { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--propia-border-divider); flex-wrap: wrap; }
    .rs-card-title { flex: 1; font-size: 14px; font-weight: 700; color: var(--propia-text-h1); }
    .rs-card-title-pad { padding: 16px 20px; border-bottom: 1px solid var(--propia-border-divider); }
    .rs-week-nav { display: flex; align-items: center; gap: 8px; }
    .rs-week-btn { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-secondary); cursor: pointer; }
    .rs-week-btn:hover { border-color: var(--propia-brand); color: var(--propia-brand); }
    .rs-week-label { font-size: 12.5px; font-weight: 700; color: var(--propia-text-secondary); min-width: 160px; text-align: center; }
    .rs-legend { display: flex; align-items: center; gap: 10px; }
    .rs-lg { display: flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700; }
    .rs-lg .rs-dot { width: 9px; height: 9px; border-radius: 3px; }
    .rs-lg-conf { color: var(--propia-brand-hover); } .rs-lg-conf .rs-dot { background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); }
    .rs-lg-pend { color: #B45309; } .rs-lg-pend .rs-dot { background: var(--propia-warn-soft); border: 1px solid #F8E3B5; }

    .rs-grid { display: grid; grid-template-columns: 130px repeat(7, 1fr); }
    .rs-grid-corner { border-bottom: 1px solid var(--propia-border-divider); }
    .rs-day-h { text-align: center; padding: 9px 4px; border-bottom: 1px solid var(--propia-border-divider); border-left: 1px solid var(--propia-border-divider); }
    .rs-day-h.is-today { background: var(--propia-brand-soft); }
    .rs-day-name { font-size: 10px; font-weight: 700; color: var(--propia-text-secondary); letter-spacing: .4px; }
    .rs-day-num { font-size: 14px; font-weight: 800; color: var(--propia-text-secondary); }
    .rs-day-h.is-today .rs-day-name, .rs-day-h.is-today .rs-day-num { color: var(--propia-brand-hover); }
    .rs-row-label { display: flex; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--propia-border-divider); font-size: 12px; font-weight: 700; color: var(--propia-text-body); line-height: 1.25; }
    .rs-cell { border-left: 1px solid var(--propia-border-divider); border-bottom: 1px solid var(--propia-border-divider); padding: 5px; min-height: 58px; background: var(--propia-bg-card); }
    .rs-cell.is-today { background: var(--propia-brand-soft-2); }
    .rs-ev { height: 100%; border-radius: 8px; padding: 6px 7px; display: flex; flex-direction: column; gap: 1px; overflow: hidden; }
    .rs-ev-click { cursor: pointer; transition: filter .12s ease, box-shadow .12s ease; }
    .rs-ev-click:hover { filter: brightness(.97); box-shadow: 0 2px 6px rgba(41, 41, 75, .12); }
    .rs-ev-conf { background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); color: var(--propia-brand-hover); }
    .rs-ev-pend { background: var(--propia-warn-soft); border: 1px solid #F8E3B5; color: #B45309; }
    .rs-ev-hora { font-size: 9.5px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rs-ev-resp { font-size: 9.5px; font-weight: 700; color: var(--propia-brand-text); opacity: .85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }
    .rs-ev-extra { font-size: 9px; font-weight: 800; }
    .rs-cell-add { width: 100%; height: 100%; min-height: 46px; border: 0; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: transparent; background: transparent; cursor: pointer; }
    .rs-cell-add:hover { background: var(--propia-brand-soft-2); color: var(--propia-brand); }

    .rs-list-empty { padding: 22px; text-align: center; color: var(--propia-text-faint); font-size: 13px; }
    .rs-resv { display: flex; align-items: center; gap: 13px; padding: 13px 20px; border-bottom: 1px solid var(--propia-border-divider); }
    .rs-resv:last-child { border-bottom: 0; }
    .rs-resv-fecha { width: 76px; flex-shrink: 0; font-size: 11.5px; font-weight: 700; color: var(--propia-brand); }
    .rs-resv-main { flex: 1; min-width: 0; }
    .rs-resv-zona { font-size: 13.5px; font-weight: 700; color: var(--propia-text-body); }
    .rs-resv-sub { font-size: 11px; color: var(--propia-text-faint); }
    .u-cod { color: var(--propia-brand-text); font-weight: 700; text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }
    .rs-badge { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 7px; white-space: nowrap; }
    .rs-aprobar { font-size: 10.5px; font-weight: 700; color: var(--propia-brand); background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); padding: 5px 10px; border-radius: 7px; flex-shrink: 0; cursor: pointer; }
    .rs-aprobar:hover { background: #E6DEFA; }
    .rs-cancel { width: 28px; height: 28px; flex-shrink: 0; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-faint); border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .rs-cancel:hover { border-color: #C0383C; color: #C0383C; }

    /* modales */
    .rs-modal-bd { position: fixed; inset: 0; z-index: 1090; background: rgba(27,42,58,.55); display: flex; align-items: flex-start; justify-content: center; padding: 40px 20px; overflow-y: auto; }
    .rs-modal { width: 480px; max-width: 100%; background: var(--propia-bg-card); border-radius: 18px; box-shadow: 0 30px 70px rgba(27,42,58,.4); margin: auto; overflow: hidden; }
    .rs-modal-lg { width: 600px; }
    /* Modales de reserva con la imagen de la zona a la IZQUIERDA, misma ubicacion y medidas que la ficha
       de zona (FichaZonaModal .fz-left 4/12 + .fz-img 170px). Solo lectura: la imagen se carga en la ficha
       de la zona (Equipos y Zonas Comunes). */
    .rs-modal-zimg { width: 760px; }
    .rs-split { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
    .rs-zimg-col { padding: 18px 20px; border-right: 1px solid var(--propia-border-divider); background: var(--propia-bg-card-soft); display: flex; flex-direction: column; gap: 6px; }
    .rs-zimg { width: 100%; height: 170px; border-radius: 12px; background-size: cover; background-position: center; background-repeat: no-repeat; background-color: var(--propia-border-divider); cursor: zoom-in; margin-bottom: 6px; }
    .rs-zimg-empty { height: 150px; border-radius: 12px; border: 1.5px dashed var(--propia-text-faint); background: var(--propia-bg-card); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 0 14px; text-align: center; color: var(--propia-text-faint); font-size: 12.5px; font-weight: 700; margin-bottom: 6px; }
    .rs-zimg-empty small { font-size: 11px; font-weight: 500; line-height: 1.35; }
    .rs-zimg-nom { font-size: 13.5px; font-weight: 800; color: var(--propia-text-h1); }
    .rs-zimg-meta { font-size: 12px; color: var(--propia-text-muted); }
    .rs-lb { position: fixed; inset: 0; z-index: 5000; background: rgba(12,20,32,.82); display: flex; align-items: center; justify-content: center; padding: 32px; cursor: zoom-out; }
    .rs-lb img { max-width: 92vw; max-height: 92vh; object-fit: contain; border-radius: 10px; box-shadow: 0 12px 48px rgba(0,0,0,.5); }
    .rs-lb-x { position: absolute; top: 18px; right: 22px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255,255,255,.16); color: var(--propia-text-inverse); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .rs-lb-x:hover { background: rgba(255,255,255,.28); }
    .rs-modal-head { display: flex; align-items: center; gap: 13px; padding: 20px 24px; border-bottom: 1px solid var(--propia-border-divider); }
    .rs-modal-ic { width: 38px; height: 38px; border-radius: 10px; background: var(--propia-brand-soft); color: var(--propia-brand); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .rs-modal-tt { flex: 1; }
    .rs-modal-h { font-size: 16px; font-weight: 800; letter-spacing: -.3px; color: var(--propia-text-h1); }
    .rs-modal-s { font-size: 12.5px; color: var(--propia-text-muted); }
    .rs-modal-x { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: var(--propia-text-muted); border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); cursor: pointer; }
    .rs-modal-x:hover { background: var(--propia-bg-app); color: var(--propia-text-body); }
    .rs-modal-body { padding: 22px 24px; display: flex; flex-direction: column; gap: 13px; }
    .rs-traza { border-top: 1px solid #EDF1F6; padding-top: 14px; margin-top: 2px; }
    .rs-traza-lbl { font-size: 10.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--propia-text-muted); margin-bottom: 9px; }
    [data-bs-theme="dark"] .rs-traza { border-color: var(--propia-border-card); }
    .rs-modal-foot { display: flex; justify-content: flex-end; gap: 9px; padding: 16px 24px; border-top: 1px solid var(--propia-border-divider); }
    .rs-fld { display: flex; flex-direction: column; }
    .rs-fld-lbl, .rs-fld label { font-size: 11px; color: var(--propia-text-muted); font-weight: 700; display: block; margin-bottom: 5px; }
    .rs-fld input, .rs-fld select, .rs-fld textarea { width: 100%; border: 1px solid var(--propia-border-card); border-radius: 9px; padding: 10px 12px; font-size: 13.5px; color: var(--propia-text-body); outline: none; background: var(--propia-bg-card); }
    .rs-fld input:focus, .rs-fld select:focus, .rs-fld textarea:focus { border-color: var(--propia-brand); }
    .rs-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .rs-grid3 { display: grid; grid-template-columns: auto 1fr 1fr; gap: 12px; align-items: end; }
    .rs-check { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: var(--propia-text-secondary); cursor: pointer; }
    .rs-check input { width: 16px; height: 16px; accent-color: var(--propia-brand); }
    .rs-check-inline { white-space: nowrap; }
    .rs-note { display: flex; align-items: center; gap: 9px; padding: 11px 13px; background: var(--propia-brand-soft-2); border: 1px dashed var(--propia-brand-border); border-radius: 10px; font-size: 12px; color: #7C5CE8; }
    .rs-modal-err { display: flex; align-items: center; gap: 9px; margin-top: 10px; padding: 11px 13px; background: #FEF2F2; border: 1px solid #FCA5A5; border-radius: 10px; font-size: 12.5px; font-weight: 600; color: #B91C1C; }
    .rs-modal-err svg { flex-shrink: 0; }
    .rs-franjas { border-top: 1px solid var(--propia-border-divider); padding-top: 12px; }
    .rs-franja-row { display: flex; align-items: center; gap: 10px; margin-bottom: 7px; }
    .rs-franja-row .rs-check { min-width: 120px; }
    .rs-franja-row input[type=time] { width: 110px; border: 1px solid var(--propia-border-card); border-radius: 8px; padding: 7px 10px; font-size: 13px; color: var(--propia-text-body); }
    .rs-franja-sep { color: var(--propia-text-faint); font-size: 12px; }
    /* === Movil (hasta 760px): la agenda semanal scrollea horizontal en vez de recortarse === */
    @@media (max-width: 760px) {
        .rs-card { overflow-x: auto; }
        .rs-grid { min-width: 720px; }
    }
    /* === Movil: modales a pantalla completa y formularios a una columna === */
    @@media (max-width: 640px) {
        .rs-modal-bd { padding: 0; }
        .rs-modal { width: 100%; min-height: 100dvh; border-radius: 0; }
        .rs-grid2, .rs-grid3 { grid-template-columns: 1fr; }
        .rs-split { grid-template-columns: 1fr; }
        .rs-zimg-col { border-right: 0; border-bottom: 1px solid var(--propia-border-divider); padding: 16px 14px; }
    }
</style>

<ModalHost />

@code {
    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");

    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";

    private List<ZonaGaleriaDto>? _galeria;
    private List<ReservaDto> _reservas = new();
    private List<BloqueoDto>? _bloqueos;
    private List<UnidadDto>? _unidades;
    private List<UnidadPersonaDto>? _responsables;   // terceros de la unidad elegida (no servicios generales)
    private int _rsWeek;

    // Nueva reserva
    private bool _showReservar;
    private Guid _resZona;
    private Guid _resUnidad = Guid.Empty;
    private Guid _resPersona = Guid.Empty;
    private DateTime _resFecha = DateTime.Today.AddDays(1);
    private DateTime _resHoraIni = DateTime.Today.Date.AddHours(10);
    private DateTime _resHoraFin = DateTime.Today.Date.AddHours(12);
    private bool _resReglamento = true;
    private string? _resError;   // error de negocio mostrado DENTRO del modal (no en el banner de la pagina)

    // Config
    private bool _showConfig;
    private string _configZonaNombre = "";
    private ConfigEdit? _configEdit;

    // Bloqueo
    private bool _showCrearBloqueo;
    private Guid _blqZona = Guid.Empty;
    private DateTime _blqFechaIni = DateTime.Today;
    private DateTime _blqFechaFin = DateTime.Today;
    private EtiquetaBloqueo _blqEtiqueta = EtiquetaBloqueo.Mantenimiento;
    private bool _blqVisible = true;
    private string _blqMotivo = "";

    // Ola 4b-2: la etiqueta de bloqueo (enum-universo) lee su label/color/ocultar de la copia POR TENANT
    // (lista_opciones, lista reserva.etiquetabloqueo); el bloqueo sigue guardando el enum.
    private List<Propia.Application.Catalogos.OpcionEfectivaDto> _listaEtqBloq = new();
    private bool _gestEtqBloq;   // modal "Gestionar opciones" de la lista etiqueta de bloqueo (per-tenant)
    private Propia.Application.Catalogos.OpcionEfectivaDto? RowBloq(EtiquetaBloqueo e)
        => _listaEtqBloq.FirstOrDefault(r => r.Clave == "e:" + e);
    // Recarga la copia por-tenant tras editar en el modal (renombrar/color/ocultar/restablecer).
    private async Task RecargarEtqBloqAsync()
    {
        try { _listaEtqBloq = await Auth().GetFromJsonAsync<List<Propia.Application.Catalogos.OpcionEfectivaDto>>("/api/campos/opciones?lista=reserva.etiquetabloqueo&incluirOcultas=true") ?? _listaEtqBloq; }
        catch { }
        StateHasChanged();
    }
    private string LblBloq(EtiquetaBloqueo e)
    {
        var l = RowBloq(e)?.Label;
        return string.IsNullOrWhiteSpace(l) ? e.ToString() : l;
    }

    private List<ZonaGaleriaDto> ZonasReservables =>
        _galeria?.Where(z => z.Reservable).ToList() ?? new();

    // ===== Barra canonica: vista, busqueda, filtros, orden, agrupar, columnas (canon = Mantenimiento) =====
    private string _vista = "calendario";   // calendario | tabla (persistida por navegador)
    private const string VistaKey = "propia_reservas_vista", GruposKey = "propia_reservas_grupos", ColsKey = "propia_reservas_cols";
    private string _q = "";
    private FiltroDinamico? _fd;
    private List<TablaOrdenarMenu.Sort> _sorts = new();
    private List<string> _grupos = new();
    private int _pagina = 1, _porPagina = 25;

    private void OnBuscar(ChangeEventArgs e) { _q = e.Value?.ToString() ?? ""; _pagina = 1; }
    private void OnFiltroChanged() { _pagina = 1; StateHasChanged(); }
    private async Task SetVista(string v) { _vista = v == "tabla" ? "tabla" : "calendario"; await GuardarLocalAsync(VistaKey, _vista); }

    // Reservas que pasan Filtros + Buscar (las usan la agenda, Proximas y la tabla).
    private IEnumerable<ReservaDto> ReservasFiltradas()
    {
        var q = _q.Trim();
        return _reservas.Where(r =>
            (q.Length == 0 || $"{r.Codigo} {r.ZonaNombre} {r.UnidadNumero} {r.PersonaNombre}".Contains(q, StringComparison.OrdinalIgnoreCase))
            && (_fd?.Pasa(campo => ValorCampo(r, campo)) ?? true));
    }
    // Zonas de la agenda: todas sin filtro; con filtro/busqueda, las que coinciden por nombre o tienen reservas.
    private List<ZonaGaleriaDto> ZonasAgenda(List<ReservaDto> filtradas)
    {
        var q = _q.Trim();
        if (q.Length == 0 && !(_fd?.Hay ?? false)) return ZonasReservables;
        var conReserva = filtradas.Select(r => r.ZonaComunId).ToHashSet();
        return ZonasReservables.Where(z => conReserva.Contains(z.ZonaComunId)
            || (q.Length > 0 && !(_fd?.Hay ?? false) && z.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))).ToList();
    }

    // Columnas de la tabla: clave, etiqueta, visible por defecto. "fecha" es la fija (primera, no se oculta).
    private static readonly (string Key, string Label, bool Vis)[] ColsDef =
    {
        ("fecha", "Fecha", true), ("horario", "Horario", true), ("zona", "Zona", true), ("unidad", "Unidad", true),
        ("persona", "Responsable", true), ("estado", "Estado", true), ("codigo", "Código", true), ("pago", "Pago", true),
        ("creada", "Creada", false), ("entrega", "Entrega", false)
    };
    private const string ColFija = "fecha";
    private sealed class ColPref { public string Key { get; set; } = ""; public bool Visible { get; set; } }
    private List<ColPref> _cols = ColsDef.Select(c => new ColPref { Key = c.Key, Visible = c.Vis }).ToList();
    private static string LabelCol(string k) => ColsDef.FirstOrDefault(c => c.Key == k).Label ?? k;
    private List<(string Key, string Label)> ColsVis => _cols.Where(c => c.Visible).Select(c => (c.Key, LabelCol(c.Key))).ToList();

    private List<FiltroDinamico.CampoDef> CamposFiltro => new()
    {
        new() { Key = "zona", Label = "Zona", Kind = "sel", Opciones = ZonasReservables.Select(z => (z.Nombre, z.Nombre)).ToList() },
        new() { Key = "estado", Label = "Estado", Kind = "sel", Opciones = Enum.GetValues<EstadoReserva>().Select(e => (e.ToString(), EstadoTexto(e))).ToList() },
        new() { Key = "fecha", Label = "Fecha", Kind = "fecha" },
        new() { Key = "unidad", Label = "Unidad", Kind = "texto" },
        new() { Key = "persona", Label = "Responsable", Kind = "texto" },
        new() { Key = "codigo", Label = "Código", Kind = "texto" },
    };
    private static string? ValorCampo(ReservaDto r, string campo) => campo switch
    {
        "zona" => r.ZonaNombre,
        "estado" => r.Estado.ToString(),
        "fecha" => r.Fecha.ToString("yyyy-MM-dd"),
        "unidad" => r.UnidadNumero,
        "persona" => r.PersonaNombre,
        "codigo" => r.Codigo,
        _ => ""
    };

    // ---- Ordenar (menu compartido + clic en el encabezado) ----
    private List<TablaOrdenarMenu.Col> ColsOrdenables() => ColsVis.Select(c => new TablaOrdenarMenu.Col(c.Key, c.Label)).ToList();
    private void OnSortsChanged() { _pagina = 1; StateHasChanged(); }
    private void OrdenarPorClic(string k)
    {
        var dir = _sorts.Count == 1 && _sorts[0].Key == k ? -_sorts[0].Dir : 1;
        _sorts = new() { new TablaOrdenarMenu.Sort { Key = k, Dir = dir } };
        _pagina = 1;
    }
    private static IComparable ValorOrden(ReservaDto r, string k) => k switch
    {
        "fecha" => r.Fecha.ToDateTime(r.HoraInicio),
        "horario" => r.HoraInicio,
        "zona" => r.ZonaNombre ?? "",
        "unidad" => r.UnidadNumero ?? "",
        "persona" => r.PersonaNombre ?? "",
        "estado" => (int)r.Estado,
        "codigo" => r.Codigo ?? "",
        "pago" => r.MontoPago ?? 0m,
        "creada" => r.CreadoAt,
        "entrega" => r.EntregadaAt ?? DateTimeOffset.MinValue,
        _ => ""
    };
    private IEnumerable<ReservaDto> ReservasOrdenadas()
    {
        var src = ReservasFiltradas();
        if (_sorts.Count == 0) return src;   // por defecto: orden del API (fecha mas reciente primero)
        IOrderedEnumerable<ReservaDto>? o = null;
        foreach (var s in _sorts)
        {
            Func<ReservaDto, IComparable> sel = r => ValorOrden(r, s.Key);
            o = o is null ? (s.Dir >= 0 ? src.OrderBy(sel) : src.OrderByDescending(sel))
                          : (s.Dir >= 0 ? o.ThenBy(sel) : o.ThenByDescending(sel));
        }
        return o!;
    }
    private RenderFragment SortInd(string k)
    {
        var s = _sorts.FirstOrDefault(x => x.Key == k);
        return s is null ? (__b => { }) : (@<span class="tbl-th-arrow">@((MarkupString)(s.Dir >= 0 ? "&#9650;" : "&#9660;"))</span>);
    }

    // ---- Agrupar (multi-nivel: TablaAgruparMenu + motor TablaAgrupador + render <tr> compartido) ----
    private List<TablaAgruparMenu.Col> ColsAgrupables() => ColsVis.Select(c => new TablaAgruparMenu.Col(c.Key, c.Label)).ToList();
    private List<string> Niveles => _grupos.Where(k => ColsVis.Any(c => c.Key == k)).ToList();
    private async Task OnGruposChanged() { await GuardarLocalAsync(GruposKey, System.Text.Json.JsonSerializer.Serialize(_grupos)); StateHasChanged(); }
    private IReadOnlyList<NodoGrupo<ReservaDto>> ArbolGrupos(List<string> niveles)
        => TablaAgrupador.Agrupar(ReservasOrdenadas(), niveles, ValorGrupoDe, "(vacio)");
    private IEnumerable<ValorGrupo> ValorGrupoDe(ReservaDto r, string k)
    {
        // Etiquetas legibles (las mismas de la tabla); Orden mantiene fechas/estados en su orden natural.
        yield return k switch
        {
            "fecha" => new ValorGrupo(r.Fecha.ToString("yyyy-MM-dd"), FechaLarga(r.Fecha), Orden: r.Fecha.DayNumber),
            "estado" => new ValorGrupo(r.Estado.ToString(), EstadoTexto(r.Estado), Orden: (int)r.Estado),
            "horario" => new ValorGrupo(HorarioTexto(r), HorarioTexto(r)),
            "pago" => new ValorGrupo(PagoTexto(r), PagoTexto(r)),
            "creada" => new ValorGrupo(r.CreadoAt.ToString("yyyy-MM-dd"), FechaLarga(DateOnly.FromDateTime(r.CreadoAt.Date))),
            "entrega" => new ValorGrupo(EntregaTexto(r), EntregaTexto(r)),
            _ => ValorCampo(r, k) is { Length: > 0 } v ? new ValorGrupo(v, v) : new ValorGrupo("", "(vacio)")
        };
    }

    // ---- Paginacion (sin agrupar) ----
    private IEnumerable<ReservaDto> PaginaActual()
    {
        var filt = ReservasOrdenadas().ToList();
        var totalPag = Math.Max(1, (int)Math.Ceiling(filt.Count / (double)_porPagina));
        _pagina = Math.Clamp(_pagina, 1, totalPag);
        return filt.Skip((_pagina - 1) * _porPagina).Take(_porPagina);
    }

    // ---- Columnas (TablaColumnasMenu; preferencia por navegador, Reservas no tiene campos propios) ----
    private List<TablaColumnasMenu.Col> ColsVisibilidad()
        => _cols.Select(c => new TablaColumnasMenu.Col(c.Key, LabelCol(c.Key), false, c.Visible,
               Movible: c.Key != ColFija, Ocultable: c.Key != ColFija)).ToList();
    private async Task MoverColMenu((string Key, int Dir) a)
    {
        var i = _cols.FindIndex(c => c.Key == a.Key); var j = i + a.Dir;
        if (i <= 0 || j <= 0 || j >= _cols.Count) return;   // la 1a columna (fecha) queda fija
        (_cols[i], _cols[j]) = (_cols[j], _cols[i]);
        await GuardarColsAsync();
    }
    private async Task ToggleVisibleCol(string k)
    {
        if (k == ColFija) return;
        var c = _cols.FirstOrDefault(x => x.Key == k); if (c is null) return;
        c.Visible = !c.Visible;
        await GuardarColsAsync();
    }
    private async Task OcultarTodasCol() { foreach (var c in _cols) c.Visible = c.Key == ColFija; await GuardarColsAsync(); }
    private async Task MostrarTodasCol() { foreach (var c in _cols) c.Visible = true; await GuardarColsAsync(); }
    private async Task RestablecerCol() { _cols = ColsDef.Select(c => new ColPref { Key = c.Key, Visible = c.Vis }).ToList(); await GuardarColsAsync(); }
    private Task GuardarColsAsync() => GuardarLocalAsync(ColsKey, System.Text.Json.JsonSerializer.Serialize(_cols));

    // ---- Menu de columna (flecha del encabezado) ----
    private TablaColMenu? _colMenu;
    private RenderFragment ChevCol(string clave, string label) =>@<button type="button" class="tbl-th-edit" title="Opciones de columna" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="(e) => _colMenu?.Abrir(new TablaColMenu.Ctx(clave, label, false), e.ClientX, e.ClientY)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg></button>;
    private async Task OnColAccion((TablaColMenu.Accion Accion, TablaColMenu.Ctx Col) a)
    {
        var (accion, col) = a;
        switch (accion)
        {
            case TablaColMenu.Accion.OrdenarAsc: _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = 1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.OrdenarDesc: _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = -1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.Filtrar:
                if (_fd is not null && CamposFiltro.Any(c => c.Key == col.Key)) await _fd.AgregarReglaCampo(col.Key);
                else Aviso("Filtrar por este campo no está disponible; usa el botón Filtros.");
                break;
            case TablaColMenu.Accion.Agrupar: _grupos = new() { col.Key }; await OnGruposChanged(); break;
            case TablaColMenu.Accion.Ocultar:
                if (col.Key == ColFija) Aviso("Esta columna es fija y no se puede ocultar.");
                else { await ToggleVisibleCol(col.Key); Aviso("Columna oculta. Usa Columnas para restaurarla."); }
                break;
            default:
                Aviso("Reservas no tiene campos propios: esta opción no aplica aquí.");
                break;
        }
        StateHasChanged();
    }
    private void Aviso(string m) { _msg = m; _msgClass = "alert-info"; }

    // ---- Clic derecho en una fila: acciones de la reserva ----
    private bool _ctxOpen;
    private double _ctxX, _ctxY;
    private List<TablaCtxMenu.Item> _ctxItems = new();
    private void AbrirCtx(MouseEventArgs e, ReservaDto r)
    {
        var items = new List<TablaCtxMenu.Item> { new("Abrir / reprogramar", "fi-rr-edit", OnClick: () => { AbrirEditar(r); return Task.CompletedTask; }) };
        // El menu invoca un Func<Task> (no EventCallback): esta pagina no se repinta sola tras la accion.
        if (r.Estado == EstadoReserva.PendienteAprobacion) items.Add(new("Aprobar", "fi-rr-check", OnClick: async () => { await AprobarReserva(r.Id); StateHasChanged(); }));
        if (EsActiva(r.Estado))
        {
            items.Add(new(Sep: true));
            items.Add(new("Cancelar reserva", "fi-rr-cross-circle", Danger: true, OnClick: async () => { await CancelarReserva(r.Id); StateHasChanged(); }));
        }
        _ctxItems = items; _ctxX = e.ClientX; _ctxY = e.ClientY; _ctxOpen = true;
    }

    // ---- Fila y celdas de la tabla ----
    private RenderFragment<ReservaDto> FilaTpl => r => @<tr @oncontextmenu="e => AbrirCtx(e, r)" @oncontextmenu:preventDefault="true">
        <td class="tbl-exp">
            <button type="button" class="tbl-exp-btn" title="Abrir la reserva" @onclick="() => AbrirEditar(r)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </button>
        </td>
        @foreach (var c in ColsVis) { @Celda(r, c.Key) }
    </tr>;
    private RenderFragment Celda(ReservaDto r, string k) => k switch
    {
        "fecha" => @<td class="nom">@FechaLarga(r.Fecha)</td>,
        "horario" => @<td>@HorarioTexto(r)</td>,
        "zona" => @<td>@r.ZonaNombre</td>,
        "unidad" => @<td><span class="u-cod">@r.UnidadNumero</span></td>,
        "persona" => @<td>@(string.IsNullOrWhiteSpace(r.PersonaNombre) ? "-" : r.PersonaNombre)</td>,
        "estado" => @<td><span class="rs-badge" style="color:@EstadoFg(r.Estado);background:@EstadoBg(r.Estado)">@EstadoTexto(r.Estado)</span></td>,
        "codigo" => @<td class="mut">@r.Codigo</td>,
        "pago" => @<td>@PagoTexto(r)</td>,
        "creada" => @<td class="mut">@r.CreadoAt.ToOffset(TimeSpan.FromHours(-5)).ToString("yyyy-MM-dd HH:mm")</td>,
        "entrega" => @<td class="mut">@EntregaTexto(r)</td>,
        _ => @<td></td>
    };
    private static string FechaLarga(DateOnly d) => Cap(d.ToString("ddd d MMM yyyy", Es));
    private static string HorarioTexto(ReservaDto r) => $"{ShortHora(r.HoraInicio)} - {ShortHora(r.HoraFin)}";
    private static string PagoTexto(ReservaDto r) => r.MontoPago is > 0 ? "$ " + r.MontoPago.Value.ToString("N0", Es) + (r.EstadoPago is { } ep ? $" ({ep})" : "") : "Gratis";
    private static string EntregaTexto(ReservaDto r) => r.DevueltaAt is not null ? "Devuelta" : r.EntregadaAt is not null ? "Entregada" : "-";

    // ---- Persistencia por navegador (vista, grupos, columnas). Tolerante: sin storage queda el default. ----
    private async Task GuardarLocalAsync(string k, string v) { try { await Js.InvokeVoidAsync("localStorage.setItem", k, v); } catch { } }
    private async Task CargarPreferenciasAsync()
    {
        try
        {
            var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey);
            if (v is "tabla" or "calendario") _vista = v;
            var g = await Js.InvokeAsync<string?>("localStorage.getItem", GruposKey);
            if (!string.IsNullOrWhiteSpace(g)) _grupos = System.Text.Json.JsonSerializer.Deserialize<List<string>>(g) ?? new();
            var c = await Js.InvokeAsync<string?>("localStorage.getItem", ColsKey);
            if (!string.IsNullOrWhiteSpace(c) && System.Text.Json.JsonSerializer.Deserialize<List<ColPref>>(c) is { Count: > 0 } guard)
            {
                // Conserva orden/visibilidad guardados; columnas nuevas del catalogo se agregan al final; fecha siempre 1a y visible.
                var conocidas = guard.Where(x => ColsDef.Any(d => d.Key == x.Key)).ToList();
                conocidas.AddRange(ColsDef.Where(d => conocidas.All(x => x.Key != d.Key)).Select(d => new ColPref { Key = d.Key, Visible = d.Vis }));
                var fija = conocidas.First(x => x.Key == ColFija); fija.Visible = true;
                conocidas.Remove(fija); conocidas.Insert(0, fija);
                _cols = conocidas;
            }
        }
        catch { }
    }

    // Editar / reprogramar una reserva (abre tarjeta -> cambiar fecha/hora o cancelar)
    private bool _editOpen;
    private Guid _editId;
    private string _editZonaNombre = "";
    private Guid _editZonaId;
    private DateTime _editFecha = DateTime.Today;
    private DateTime _editHoraIni = DateTime.Today.Date.AddHours(10);
    private DateTime _editHoraFin = DateTime.Today.Date.AddHours(12);
    private bool _editBusy;
    private string? _editMsg;
    private DateTimeOffset? _editEntregadaAt, _editDevueltaAt;
    private string? _editEntregaObs, _editDevolucionObs;
    private sealed record ErrResp(string error);

    /// <summary>Texto del tooltip de una tarjeta de la agenda: quien reservo + unidad + horario + estado.</summary>
    private string TipReserva(ReservaDto r, int extra)
    {
        var quien = string.IsNullOrWhiteSpace(r.PersonaNombre) ? "Sin responsable" : r.PersonaNombre;
        var t = $"{quien} - Unidad {r.UnidadNumero} - {ShortHora(r.HoraInicio)}-{ShortHora(r.HoraFin)} - {EstadoTexto(r.Estado)}";
        return extra > 0 ? $"{t} (+{extra} mas ese dia)" : t;
    }

    private void AbrirEditar(ReservaDto r)
    {
        _editId = r.Id;
        _editZonaNombre = r.ZonaNombre;
        _editZonaId = r.ZonaComunId;
        _editFecha = r.Fecha.ToDateTime(TimeOnly.MinValue);
        _editHoraIni = DateTime.Today.Add(r.HoraInicio.ToTimeSpan());
        _editHoraFin = DateTime.Today.Add(r.HoraFin.ToTimeSpan());
        _editEntregadaAt = r.EntregadaAt;
        _editDevueltaAt = r.DevueltaAt;
        _editEntregaObs = r.EntregaObservacion;
        _editDevolucionObs = r.DevolucionObservacion;
        _editMsg = null;
        _editOpen = true;
    }
    private async Task RecargarEditAsync()
    {
        await RecargarReservasAsync();
        var r = _reservas.FirstOrDefault(x => x.Id == _editId);
        if (r is not null)
        {
            _editEntregadaAt = r.EntregadaAt;
            _editDevueltaAt = r.DevueltaAt;
            _editEntregaObs = r.EntregaObservacion;
            _editDevolucionObs = r.DevolucionObservacion;
        }
    }
    private async Task GuardarEdit()
    {
        _editBusy = true; _editMsg = null;
        var req = new ReprogramarReservaRequest(
            DateOnly.FromDateTime(_editFecha),
            TimeOnly.FromDateTime(_editHoraIni),
            TimeOnly.FromDateTime(_editHoraFin));
        var resp = await Auth().PostAsJsonAsync($"/api/reservas/{_editId}/reprogramar", req);
        if (resp.IsSuccessStatusCode) { _editOpen = false; _msg = "Reserva reprogramada."; _msgClass = "alert-success"; _rsWeek = SemanaOffset(DateOnly.FromDateTime(_editFecha)); await RecargarReservasAsync(); }
        else { try { var e = await resp.Content.ReadFromJsonAsync<ErrResp>(); _editMsg = e?.error ?? "No se pudo reprogramar."; } catch { _editMsg = "No se pudo reprogramar."; } }
        _editBusy = false;
    }
    private async Task CancelarDesdeEdit() { _editOpen = false; await CancelarReserva(_editId); }

    private DateOnly WeekStart
    {
        get
        {
            var today = DateOnly.FromDateTime(AhoraColombia().Date);
            int diff = ((int)today.DayOfWeek + 6) % 7; // lunes = 0
            return today.AddDays(-diff + _rsWeek * 7);
        }
    }

    private List<DateOnly> DiasSemana => Enumerable.Range(0, 7).Select(i => WeekStart.AddDays(i)).ToList();

    // Cuantas semanas enteras separan una fecha de la semana actual, para que la agenda salte a la
    // semana de la reserva recien creada/reprogramada y esta se vea en la grilla (no solo en "Proximas").
    private int SemanaOffset(DateOnly fecha)
    {
        var hoy = DateOnly.FromDateTime(AhoraColombia().Date);
        var lunesHoy = hoy.AddDays(-(((int)hoy.DayOfWeek + 6) % 7));
        var lunesFecha = fecha.AddDays(-(((int)fecha.DayOfWeek + 6) % 7));
        return (lunesFecha.DayNumber - lunesHoy.DayNumber) / 7;
    }

    private string SemanaLabel
    {
        get
        {
            var a = WeekStart; var b = WeekStart.AddDays(6);
            return $"{a.Day} - {b.Day} {Cap(b.ToString("MMM", Es))} {b.Year}";
        }
    }

    private static List<ReservaDto> Proximas(IEnumerable<ReservaDto> fuente) =>
        fuente.Where(r => EsActiva(r.Estado) && r.Fecha >= DateOnly.FromDateTime(AhoraColombia().Date))
              .OrderBy(r => r.Fecha).ThenBy(r => r.HoraInicio).Take(8).ToList();

