@page "/reservas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Propia.Application.Reservas
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<PageTitle>Reservas - PROPIA</PageTitle>

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
}
else
{
<div class="rs-wrap">

    @* ---------- Encabezado ---------- *@
    <div class="rs-head">
        <div>
            <h1 class="rs-title">Reservas de zonas comunes</h1>
            <p class="rs-sub">Agenda de reservas y zonas reservables de la copropiedad.</p>
        </div>
        <div class="rs-actions">
            <button class="rs-btn rs-btn-ghost" @onclick="AbrirBloqueo"><i class="fi fi-rr-ban"></i>Bloqueo</button>
            <button class="rs-btn rs-btn-primary" @onclick="() => AbrirReservar(null, null)">
                <i class="fi fi-rr-plus"></i>Nueva reserva
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

    @if (_galeria is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color:#6D4FE3"></div></div>
    }
    else if (ZonasReservables.Count == 0)
    {
        <div class="rs-empty">
            No hay zonas marcadas como <b>reservables</b> en Mi Copropiedad (2.3). Marca una zona como reservable para que aparezca aqui.
        </div>
    }
    else
    {
        @* ---------- Tarjetas de zonas reservables ---------- *@
        <div class="rs-zonas">
            @foreach (var z in ZonasReservables)
            {
                var zid = z.ZonaComunId;
                <div class="rs-zona-card" @onclick="() => AbrirConfig(zid)" title="Configurar zona">
                    <div class="rs-zona-ic">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="@IconoZona(z.Nombre)"></path></svg>
                    </div>
                    <div class="rs-zona-nom">@z.Nombre</div>
                    <div class="rs-zona-meta">Aforo @(z.Aforo?.ToString() ?? "-") &middot; @TarifaTexto(z)</div>
                </div>
            }
        </div>

        @* ---------- Agenda semanal de ocupacion ---------- *@
        <div class="rs-card">
            <div class="rs-card-head">
                <div class="rs-card-title">Agenda semanal de ocupacion</div>
                <div class="rs-week-nav">
                    <button class="rs-week-btn" title="Semana anterior" @onclick="() => CambiarSemana(-1)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 6l-6 6 6 6"></path></svg>
                    </button>
                    <span class="rs-week-label">@SemanaLabel</span>
                    <button class="rs-week-btn" title="Semana siguiente" @onclick="() => CambiarSemana(1)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
                <div class="rs-legend">
                    <span class="rs-lg rs-lg-conf"><span class="rs-dot"></span>Confirmada</span>
                    <span class="rs-lg rs-lg-pend"><span class="rs-dot"></span>Pendiente</span>
                </div>
            </div>
            <div class="rs-grid">
                @* fila de cabecera: esquina + 7 dias *@
                <div class="rs-grid-corner"></div>
                @foreach (var d in DiasSemana)
                {
                    var hoy = d == DateOnly.FromDateTime(DateTime.Today);
                    <div class="rs-day-h @(hoy ? "is-today" : "")">
                        <div class="rs-day-name">@Cap(d.ToString("ddd", Es))</div>
                        <div class="rs-day-num">@d.Day</div>
                    </div>
                }
                @* filas por zona *@
                @foreach (var z in ZonasReservables)
                {
                    <div class="rs-row-label">@z.Nombre</div>
                    @foreach (var d in DiasSemana)
                    {
                        var hoy = d == DateOnly.FromDateTime(DateTime.Today);
                        var celdas = ReservasDe(z.ZonaComunId, d);
                        var zid = z.ZonaComunId;
                        var dd = d;
                        <div class="rs-cell @(hoy ? "is-today" : "")">
                            @if (celdas.Count > 0)
                            {
                                var r = celdas[0];
                                var conf = r.Estado == EstadoReserva.Confirmada;
                                <div class="rs-ev @(conf ? "rs-ev-conf" : "rs-ev-pend")" title="@r.Estado">
                                    <div class="rs-ev-hora">@ShortHora(r.HoraInicio)-@ShortHora(r.HoraFin)</div>
                                    <div class="rs-ev-resp">@r.UnidadNumero</div>
                                    @if (celdas.Count > 1)
                                    {
                                        <div class="rs-ev-extra">+@(celdas.Count - 1) mas</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <button class="rs-cell-add" title="Reservar este dia" @onclick="() => AbrirReservar(zid, dd)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"></path></svg>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* ---------- Proximas reservas ---------- *@
        <div class="rs-card">
            <div class="rs-card-title rs-card-title-pad">Proximas reservas</div>
            @if (Proximas.Count == 0)
            {
                <div class="rs-list-empty">Sin reservas proximas.</div>
            }
            else
            {
                @foreach (var r in Proximas)
                {
                    var rid = r.Id;
                    <div class="rs-resv">
                        <div class="rs-resv-fecha">@FechaCorta(r.Fecha)</div>
                        <div class="rs-resv-main">
                            <div class="rs-resv-zona">@r.ZonaNombre</div>
                            <div class="rs-resv-sub">@ShortHora(r.HoraInicio) - @ShortHora(r.HoraFin) &middot; @r.UnidadNumero @(string.IsNullOrWhiteSpace(r.PersonaNombre) ? "" : "- " + r.PersonaNombre)</div>
                        </div>
                        <span class="rs-badge" style="color:@EstadoFg(r.Estado);background:@EstadoBg(r.Estado)">@EstadoTexto(r.Estado)</span>
                        @if (r.Estado == EstadoReserva.PendienteAprobacion)
                        {
                            <button class="rs-aprobar" @onclick="() => AprobarReserva(rid)">Aprobar</button>
                        }
                        @if (r.Estado == EstadoReserva.Confirmada || r.Estado == EstadoReserva.PendienteAprobacion || r.Estado == EstadoReserva.PendientePago)
                        {
                            <button class="rs-cancel" title="Cancelar reserva" @onclick="() => CancelarReserva(rid)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                            </button>
                        }
                    </div>
                }
            }
        </div>

        @* ---------- Bloqueos activos ---------- *@
        @if (_bloqueos is { Count: > 0 })
        {
            <div class="rs-card">
                <div class="rs-card-title rs-card-title-pad">Bloqueos activos</div>
                @foreach (var b in _bloqueos)
                {
                    var bid = b.Id;
                    <div class="rs-resv">
                        <div class="rs-resv-main">
                            <div class="rs-resv-zona">@b.ZonaNombre</div>
                            <div class="rs-resv-sub">
                                @b.FechaInicio.ToString("yyyy-MM-dd")@(b.FechaInicio == b.FechaFin ? "" : " a " + b.FechaFin.ToString("yyyy-MM-dd"))
                                @(string.IsNullOrWhiteSpace(b.MotivoPersonalizado) ? "" : "- " + b.MotivoPersonalizado)
                            </div>
                        </div>
                        <span class="rs-badge" style="color:#B45309;background:#FEF3DC">@b.Etiqueta</span>
                        <span class="rs-badge" style="color:#7C98B6;background:#EEF3F8">@(b.Origen == OrigenBloqueoZona.AutomaticoSistema ? "Auto" : "Manual")</span>
                        @if (b.Origen != OrigenBloqueoZona.AutomaticoSistema)
                        {
                            <button class="rs-cancel" title="Eliminar bloqueo" @onclick="() => EliminarBloqueo(bid)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                            </button>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@* ===================== Modal Nueva reserva ===================== *@
@if (_showReservar)
{
    <div class="rs-modal-bd" @onclick="CerrarReservar">
        <div class="rs-modal" @onclick:stopPropagation="true">
            <div class="rs-modal-head">
                <div class="rs-modal-ic">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
                </div>
                <div class="rs-modal-tt">
                    <div class="rs-modal-h">Nueva reserva</div>
                    <div class="rs-modal-s">Zonas comunes de la copropiedad</div>
                </div>
                <button class="rs-modal-x" @onclick="CerrarReservar">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="rs-modal-body">
                <div class="rs-fld">
                    <label>Zona comun</label>
                    <select @bind="_resZona">
                        @foreach (var z in ZonasReservables) { <option value="@z.ZonaComunId">@z.Nombre</option> }
                    </select>
                </div>
                <div class="rs-fld">
                    <label>Fecha *</label>
                    <input type="date" @bind="_resFecha" />
                </div>
                <div class="rs-grid2">
                    <div class="rs-fld">
                        <label>Hora inicio *</label>
                        <input type="time" @bind="_resHoraIni" />
                    </div>
                    <div class="rs-fld">
                        <label>Hora fin *</label>
                        <input type="time" @bind="_resHoraFin" />
                    </div>
                </div>
                <div class="rs-grid2">
                    <div class="rs-fld">
                        <label>Unidad *</label>
                        <select @bind="_resUnidad">
                            <option value="">Seleccionar...</option>
                            @if (_unidades is not null)
                            {
                                @foreach (var u in _unidades) { <option value="@u.Id">@u.Numero</option> }
                            }
                        </select>
                    </div>
                    <div class="rs-fld">
                        <label>Responsable *</label>
                        <select @bind="_resPersona">
                            <option value="">Seleccionar...</option>
                            @if (_personas is not null)
                            {
                                @foreach (var p in _personas) { <option value="@p.Id">@p.Nombres @p.Apellidos</option> }
                            }
                        </select>
                    </div>
                </div>
                <label class="rs-check">
                    <input type="checkbox" @bind="_resReglamento" />
                    <span>El residente acepta el reglamento de uso de la zona.</span>
                </label>
                <div class="rs-note">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16h.01"></path></svg>
                    Si la zona requiere aprobacion, la reserva queda <b>Pendiente</b> hasta que el administrador la apruebe.
                </div>
            </div>
            <div class="rs-modal-foot">
                <button class="rs-btn rs-btn-ghost" @onclick="CerrarReservar">Cancelar</button>
                <button class="rs-btn rs-btn-primary" @onclick="ConfirmarReservar"
                        disabled="@(_busy || _resUnidad == Guid.Empty || _resPersona == Guid.Empty)">
                    <i class="fi fi-rr-check"></i>@(_busy ? "Creando..." : "Crear reserva")
                </button>
            </div>
        </div>
    </div>
}

@* ===================== Modal Configurar zona ===================== *@
@if (_showConfig && _configEdit is not null)
{
    <div class="rs-modal-bd" @onclick="() => _showConfig = false">
        <div class="rs-modal rs-modal-lg" @onclick:stopPropagation="true">
            <div class="rs-modal-head">
                <div class="rs-modal-ic">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                </div>
                <div class="rs-modal-tt">
                    <div class="rs-modal-h">Configurar zona reservable</div>
                    <div class="rs-modal-s">@(_configZonaNombre)</div>
                </div>
                <button class="rs-modal-x" @onclick="() => _showConfig = false">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="rs-modal-body">
                <div class="rs-grid2">
                    <div class="rs-fld"><label>Anticipacion minima (horas)</label><input type="number" min="0" @bind="_configEdit.AnticipacionMinimaHoras" /></div>
                    <div class="rs-fld"><label>Anticipacion maxima (dias)</label><input type="number" min="1" @bind="_configEdit.AnticipacionMaximaDias" /></div>
                    <div class="rs-fld"><label>Duracion minima (min)</label><input type="number" min="15" @bind="_configEdit.DuracionMinimaMinutos" /></div>
                    <div class="rs-fld"><label>Duracion maxima (min)</label><input type="number" min="15" @bind="_configEdit.DuracionMaximaMinutos" /></div>
                </div>
                <label class="rs-check">
                    <input type="checkbox" @bind="_configEdit.RequiereAprobacion" />
                    <span>Requiere aprobacion del administrador antes de confirmar.</span>
                </label>
                <div class="rs-grid3">
                    <label class="rs-check rs-check-inline"><input type="checkbox" @bind="_configEdit.TieneTarifa" /><span>Tiene tarifa</span></label>
                    <div class="rs-fld"><label>Valor (COP)</label><input type="number" @bind="_configEdit.ValorTarifa" disabled="@(!_configEdit.TieneTarifa)" /></div>
                    <div class="rs-fld"><label>Modalidad</label>
                        <select @bind="_configEdit.ModalidadCobro" disabled="@(!_configEdit.TieneTarifa)">
                            @foreach (var m in Enum.GetValues<ModalidadCobroReserva>()) { <option value="@m">@m</option> }
                        </select>
                    </div>
                </div>
                <div class="rs-franjas">
                    <div class="rs-fld-lbl">Dias disponibles y horario</div>
                    @foreach (var dia in Enum.GetValues<DiaSemanaReserva>())
                    {
                        var d = dia;
                        var franja = _configEdit.Franjas.FirstOrDefault(f => f.DiaSemana == d);
                        <div class="rs-franja-row">
                            <label class="rs-check rs-check-inline">
                                <input type="checkbox" checked="@(franja != null)" @onchange="(e) => ToggleFranja(d, (bool)e.Value!)" />
                                <span>@d</span>
                            </label>
                            @if (franja is not null)
                            {
                                var idx = _configEdit.Franjas.IndexOf(franja);
                                <input type="time" value="@franja.HoraApertura.ToString("HH\\:mm")" @onchange="(e) => SetFranjaHora(idx, true, e.Value?.ToString() ?? string.Empty)" />
                                <span class="rs-franja-sep">a</span>
                                <input type="time" value="@franja.HoraCierre.ToString("HH\\:mm")" @onchange="(e) => SetFranjaHora(idx, false, e.Value?.ToString() ?? string.Empty)" />
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="rs-modal-foot">
                <button class="rs-btn rs-btn-ghost" @onclick="() => _showConfig = false">Cancelar</button>
                <button class="rs-btn rs-btn-primary" @onclick="GuardarConfig" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar configuracion")</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal Crear bloqueo ===================== *@
@if (_showCrearBloqueo)
{
    <div class="rs-modal-bd" @onclick="() => _showCrearBloqueo = false">
        <div class="rs-modal" @onclick:stopPropagation="true">
            <div class="rs-modal-head">
                <div class="rs-modal-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M5 5l14 14"></path></svg></div>
                <div class="rs-modal-tt"><div class="rs-modal-h">Nuevo bloqueo</div><div class="rs-modal-s">Cierra una zona en una fecha o periodo</div></div>
                <button class="rs-modal-x" @onclick="() => _showCrearBloqueo = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
            </div>
            <div class="rs-modal-body">
                <div class="rs-fld">
                    <label>Zona *</label>
                    <select @bind="_blqZona">
                        <option value="">Seleccionar...</option>
                        @foreach (var z in ZonasReservables) { <option value="@z.ZonaComunId">@z.Nombre</option> }
                    </select>
                </div>
                <div class="rs-grid2">
                    <div class="rs-fld"><label>Fecha inicio *</label><input type="date" @bind="_blqFechaIni" /></div>
                    <div class="rs-fld"><label>Fecha fin *</label><input type="date" @bind="_blqFechaFin" /></div>
                </div>
                <div class="rs-grid2">
                    <div class="rs-fld"><label>Etiqueta</label>
                        <select @bind="_blqEtiqueta">@foreach (var e in Enum.GetValues<EtiquetaBloqueo>()) { <option value="@e">@e</option> }</select>
                    </div>
                    <label class="rs-check rs-check-inline" style="align-self:flex-end;padding-bottom:8px">
                        <input type="checkbox" @bind="_blqVisible" /><span>Visible al residente</span>
                    </label>
                </div>
                <div class="rs-fld"><label>Motivo (opcional)</label><textarea rows="2" @bind="_blqMotivo"></textarea></div>
            </div>
            <div class="rs-modal-foot">
                <button class="rs-btn rs-btn-ghost" @onclick="() => _showCrearBloqueo = false">Cancelar</button>
                <button class="rs-btn rs-btn-primary" @onclick="CrearBloqueo" disabled="@(_busy || _blqZona == Guid.Empty)">@(_busy ? "Creando..." : "Crear bloqueo")</button>
            </div>
        </div>
    </div>
}
}

<style>
    .rs-wrap { width: 100%; max-width: 1900px; margin: 0 auto; padding: 6px 28px 60px; font-family: 'Lexend', sans-serif; box-sizing: border-box; }
    .rs-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
    .rs-title { font-size: 27px; font-weight: 800; letter-spacing: -.6px; color: #1B2A3A; margin: 0; }
    .rs-sub { font-size: 14px; color: #7C98B6; margin: 4px 0 0; }
    .rs-actions { display: flex; gap: 9px; flex-shrink: 0; }
    .rs-btn { display: inline-flex; align-items: center; gap: 7px; padding: 10px 16px; border-radius: 10px; font-size: 13px; font-weight: 700; border: 0; cursor: pointer; }
    .rs-btn-primary { background: #6D4FE3; color: #fff; box-shadow: 0 6px 16px rgba(109,79,227,.3); }
    .rs-btn-primary:hover { background: #5838C9; color: #fff; }
    .rs-btn-primary:disabled { opacity: .6; cursor: default; }
    .rs-btn-ghost { background: #fff; color: #516F90; border: 1px solid #E1E8EE; }
    .rs-btn-ghost:hover { border-color: #6D4FE3; color: #6D4FE3; }

    .rs-empty { background: #fff; border: 1px dashed #C3D0DD; border-radius: 14px; padding: 28px; text-align: center; color: #7C98B6; font-size: 13.5px; }

    .rs-zonas { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .rs-zona-card { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; padding: 16px; box-shadow: 0 1px 2px rgba(45,62,80,.05); cursor: pointer; transition: border-color .12s, box-shadow .12s; }
    .rs-zona-card:hover { border-color: #6D4FE3; box-shadow: 0 8px 20px rgba(109,79,227,.1); }
    .rs-zona-ic { width: 38px; height: 38px; border-radius: 10px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; margin-bottom: 11px; }
    .rs-zona-nom { font-size: 13.5px; font-weight: 700; color: #33475B; }
    .rs-zona-meta { font-size: 11.5px; color: #A6B7C8; margin-top: 2px; }

    .rs-card { background: #fff; border: 1px solid #E1E8EE; border-radius: 14px; box-shadow: 0 1px 2px rgba(45,62,80,.05); overflow: hidden; margin-bottom: 16px; }
    .rs-card-head { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid #EEF3F8; flex-wrap: wrap; }
    .rs-card-title { flex: 1; font-size: 14px; font-weight: 700; color: #1B2A3A; }
    .rs-card-title-pad { padding: 16px 20px; border-bottom: 1px solid #EEF3F8; }
    .rs-week-nav { display: flex; align-items: center; gap: 8px; }
    .rs-week-btn { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 1px solid #E1E8EE; background: #fff; color: #516F90; cursor: pointer; }
    .rs-week-btn:hover { border-color: #6D4FE3; color: #6D4FE3; }
    .rs-week-label { font-size: 12.5px; font-weight: 700; color: #516F90; min-width: 160px; text-align: center; }
    .rs-legend { display: flex; align-items: center; gap: 10px; }
    .rs-lg { display: flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700; }
    .rs-lg .rs-dot { width: 9px; height: 9px; border-radius: 3px; }
    .rs-lg-conf { color: #5838C9; } .rs-lg-conf .rs-dot { background: #F1ECFD; border: 1px solid #DCD2F8; }
    .rs-lg-pend { color: #B45309; } .rs-lg-pend .rs-dot { background: #FEF3DC; border: 1px solid #F8E3B5; }

    .rs-grid { display: grid; grid-template-columns: 130px repeat(7, 1fr); }
    .rs-grid-corner { border-bottom: 1px solid #EEF3F8; }
    .rs-day-h { text-align: center; padding: 9px 4px; border-bottom: 1px solid #EEF3F8; border-left: 1px solid #F4F7FA; }
    .rs-day-h.is-today { background: #F1ECFD; }
    .rs-day-name { font-size: 10px; font-weight: 700; color: #516F90; letter-spacing: .4px; }
    .rs-day-num { font-size: 14px; font-weight: 800; color: #516F90; }
    .rs-day-h.is-today .rs-day-name, .rs-day-h.is-today .rs-day-num { color: #5838C9; }
    .rs-row-label { display: flex; align-items: center; padding: 8px 12px; border-bottom: 1px solid #F4F7FA; font-size: 12px; font-weight: 700; color: #33475B; line-height: 1.25; }
    .rs-cell { border-left: 1px solid #F4F7FA; border-bottom: 1px solid #F4F7FA; padding: 5px; min-height: 58px; background: #fff; }
    .rs-cell.is-today { background: #FBFAFE; }
    .rs-ev { height: 100%; border-radius: 8px; padding: 6px 7px; display: flex; flex-direction: column; gap: 1px; overflow: hidden; }
    .rs-ev-conf { background: #F1ECFD; border: 1px solid #DCD2F8; color: #5838C9; }
    .rs-ev-pend { background: #FEF3DC; border: 1px solid #F8E3B5; color: #B45309; }
    .rs-ev-hora { font-size: 9.5px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rs-ev-resp { font-size: 9.5px; font-weight: 600; opacity: .85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rs-ev-extra { font-size: 9px; font-weight: 800; }
    .rs-cell-add { width: 100%; height: 100%; min-height: 46px; border: 0; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: transparent; background: transparent; cursor: pointer; }
    .rs-cell-add:hover { background: #F5F1FE; color: #6D4FE3; }

    .rs-list-empty { padding: 22px; text-align: center; color: #A6B7C8; font-size: 13px; }
    .rs-resv { display: flex; align-items: center; gap: 13px; padding: 13px 20px; border-bottom: 1px solid #F4F7FA; }
    .rs-resv:last-child { border-bottom: 0; }
    .rs-resv-fecha { width: 76px; flex-shrink: 0; font-size: 11.5px; font-weight: 700; color: #6D4FE3; }
    .rs-resv-main { flex: 1; min-width: 0; }
    .rs-resv-zona { font-size: 13.5px; font-weight: 700; color: #33475B; }
    .rs-resv-sub { font-size: 11px; color: #A6B7C8; }
    .rs-badge { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 7px; white-space: nowrap; }
    .rs-aprobar { font-size: 10.5px; font-weight: 700; color: #6D4FE3; background: #F1ECFD; border: 1px solid #DCD2F8; padding: 5px 10px; border-radius: 7px; flex-shrink: 0; cursor: pointer; }
    .rs-aprobar:hover { background: #E6DEFA; }
    .rs-cancel { width: 28px; height: 28px; flex-shrink: 0; border: 1px solid #E1E8EE; background: #fff; color: #A6B7C8; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .rs-cancel:hover { border-color: #C0383C; color: #C0383C; }

    /* modales */
    .rs-modal-bd { position: fixed; inset: 0; z-index: 1090; background: rgba(27,42,58,.55); display: flex; align-items: flex-start; justify-content: center; padding: 40px 20px; overflow-y: auto; }
    .rs-modal { width: 480px; max-width: 100%; background: #fff; border-radius: 18px; box-shadow: 0 30px 70px rgba(27,42,58,.4); margin: auto; overflow: hidden; }
    .rs-modal-lg { width: 600px; }
    .rs-modal-head { display: flex; align-items: center; gap: 13px; padding: 20px 24px; border-bottom: 1px solid #EEF3F8; }
    .rs-modal-ic { width: 38px; height: 38px; border-radius: 10px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .rs-modal-tt { flex: 1; }
    .rs-modal-h { font-size: 16px; font-weight: 800; letter-spacing: -.3px; color: #1B2A3A; }
    .rs-modal-s { font-size: 12.5px; color: #7C98B6; }
    .rs-modal-x { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: #7C98B6; border: 1px solid #E1E8EE; background: #fff; cursor: pointer; }
    .rs-modal-x:hover { background: #F5F8FA; color: #33475B; }
    .rs-modal-body { padding: 22px 24px; display: flex; flex-direction: column; gap: 13px; }
    .rs-modal-foot { display: flex; justify-content: flex-end; gap: 9px; padding: 16px 24px; border-top: 1px solid #EEF3F8; }
    .rs-fld { display: flex; flex-direction: column; }
    .rs-fld-lbl, .rs-fld label { font-size: 11px; color: #7C98B6; font-weight: 700; display: block; margin-bottom: 5px; }
    .rs-fld input, .rs-fld select, .rs-fld textarea { width: 100%; border: 1px solid #E1E8EE; border-radius: 9px; padding: 10px 12px; font-size: 13.5px; color: #33475B; outline: none; background: #fff; }
    .rs-fld input:focus, .rs-fld select:focus, .rs-fld textarea:focus { border-color: #6D4FE3; }
    .rs-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .rs-grid3 { display: grid; grid-template-columns: auto 1fr 1fr; gap: 12px; align-items: end; }
    .rs-check { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: #516F90; cursor: pointer; }
    .rs-check input { width: 16px; height: 16px; accent-color: #6D4FE3; }
    .rs-check-inline { white-space: nowrap; }
    .rs-note { display: flex; align-items: center; gap: 9px; padding: 11px 13px; background: #FBFAFE; border: 1px dashed #DCD2F8; border-radius: 10px; font-size: 12px; color: #7C5CE8; }
    .rs-franjas { border-top: 1px solid #EEF3F8; padding-top: 12px; }
    .rs-franja-row { display: flex; align-items: center; gap: 10px; margin-bottom: 7px; }
    .rs-franja-row .rs-check { min-width: 120px; }
    .rs-franja-row input[type=time] { width: 110px; border: 1px solid #E1E8EE; border-radius: 8px; padding: 7px 10px; font-size: 13px; color: #33475B; }
    .rs-franja-sep { color: #A6B7C8; font-size: 12px; }
</style>

@code {
    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");

    private string? _jwt;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";

    private List<ZonaGaleriaDto>? _galeria;
    private List<ReservaDto> _reservas = new();
    private List<BloqueoDto>? _bloqueos;
    private List<UnidadMini>? _unidades;
    private List<PersonaMini>? _personas;
    private int _rsWeek;

    // Nueva reserva
    private bool _showReservar;
    private Guid _resZona;
    private Guid _resUnidad = Guid.Empty;
    private Guid _resPersona = Guid.Empty;
    private DateTime _resFecha = DateTime.Today.AddDays(1);
    private DateTime _resHoraIni = DateTime.Today.Date.AddHours(10);
    private DateTime _resHoraFin = DateTime.Today.Date.AddHours(12);
    private bool _resReglamento = true;

    // Config
    private bool _showConfig;
    private string _configZonaNombre = "";
    private ConfigEdit? _configEdit;

    // Bloqueo
    private bool _showCrearBloqueo;
    private Guid _blqZona = Guid.Empty;
    private DateTime _blqFechaIni = DateTime.Today;
    private DateTime _blqFechaFin = DateTime.Today;
    private EtiquetaBloqueo _blqEtiqueta = EtiquetaBloqueo.Mantenimiento;
    private bool _blqVisible = true;
    private string _blqMotivo = "";

    private List<ZonaGaleriaDto> ZonasReservables =>
        _galeria?.Where(z => z.Reservable).ToList() ?? new();

    private DateOnly WeekStart
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            int diff = ((int)today.DayOfWeek + 6) % 7; // lunes = 0
            return today.AddDays(-diff + _rsWeek * 7);
        }
    }

    private List<DateOnly> DiasSemana => Enumerable.Range(0, 7).Select(i => WeekStart.AddDays(i)).ToList();

    private string SemanaLabel
    {
        get
        {
            var a = WeekStart; var b = WeekStart.AddDays(6);
            return $"{a.Day} - {b.Day} {Cap(b.ToString("MMM", Es))} {b.Year}";
        }
    }

    private List<ReservaDto> Proximas =>
        _reservas.Where(r => EsActiva(r.Estado) && r.Fecha >= DateOnly.FromDateTime(DateTime.Today))
                 .OrderBy(r => r.Fecha).ThenBy(r => r.HoraInicio).Take(8).ToList();

    private class ConfigEdit
    {
        public Guid ZonaComunId { get; set; }
        public bool RequiereAprobacion { get; set; }
        public int AnticipacionMinimaHoras { get; set; } = 1;
        public int AnticipacionMaximaDias { get; set; } = 30;
        public int DuracionMinimaMinutos { get; set; } = 60;
        public int DuracionMaximaMinutos { get; set; } = 240;
        public bool TieneTarifa { get; set; }
        public decimal ValorTarifa { get; set; }
        public ModalidadCobroReserva ModalidadCobro { get; set; } = ModalidadCobroReserva.PorHora;
        public List<FranjaEdit> Franjas { get; set; } = new();
    }

    private class FranjaEdit
    {
        public DiaSemanaReserva DiaSemana { get; set; }
        public TimeOnly HoraApertura { get; set; }
        public TimeOnly HoraCierre { get; set; }
    }

    private record UnidadMini(Guid Id, string Numero);
    private record PersonaMini(Guid Id, string Nombres, string Apellidos);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarTodoAsync();
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task CargarTodoAsync()
    {
        try
        {
            var http = Auth();
            _galeria = await http.GetFromJsonAsync<List<ZonaGaleriaDto>>("/api/reservas/galeria") ?? new();
            _reservas = await http.GetFromJsonAsync<List<ReservaDto>>("/api/reservas") ?? new();
            _bloqueos = await http.GetFromJsonAsync<List<BloqueoDto>>("/api/reservas/bloqueos") ?? new();
            try { _unidades = await http.GetFromJsonAsync<List<UnidadMini>>("/api/mi-copropiedad/unidades") ?? new(); } catch { _unidades = new(); }
            try { _personas = await http.GetFromJsonAsync<List<PersonaMini>>("/api/directorio/personas") ?? new(); } catch { _personas = new(); }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task RecargarReservasAsync()
    {
        _reservas = await Auth().GetFromJsonAsync<List<ReservaDto>>("/api/reservas") ?? new();
    }

    private List<ReservaDto> ReservasDe(Guid zonaId, DateOnly fecha) =>
        _reservas.Where(r => r.ZonaComunId == zonaId && r.Fecha == fecha && EsActiva(r.Estado))
                 .OrderBy(r => r.HoraInicio).ToList();

    private void CambiarSemana(int d) => _rsWeek += d;

    // ---------- Nueva reserva ----------
    private void AbrirReservar(Guid? zonaId, DateOnly? fecha)
    {
        var zonas = ZonasReservables;
        _resZona = zonaId ?? (zonas.FirstOrDefault()?.ZonaComunId ?? Guid.Empty);
        _resUnidad = Guid.Empty; _resPersona = Guid.Empty;
        _resFecha = fecha?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today.AddDays(1);
        _resHoraIni = DateTime.Today.Date.AddHours(10);
        _resHoraFin = DateTime.Today.Date.AddHours(12);
        _resReglamento = true;
        _showReservar = true;
    }

    private void CerrarReservar() => _showReservar = false;

    private async Task ConfirmarReservar()
    {
        if (_resZona == Guid.Empty) { _msg = "Selecciona una zona."; _msgClass = "alert-warning"; return; }
        _busy = true; _msg = null;
        try
        {
            var req = new CrearReservaRequest(_resZona, _resPersona, _resUnidad,
                DateOnly.FromDateTime(_resFecha),
                TimeOnly.FromDateTime(_resHoraIni), TimeOnly.FromDateTime(_resHoraFin),
                _resReglamento);
            var resp = await Auth().PostAsJsonAsync("/api/reservas", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Reserva creada."; _msgClass = "alert-success";
            _showReservar = false;
            await RecargarReservasAsync();
        }
        finally { _busy = false; }
    }

    private async Task AprobarReserva(Guid id)
    {
        var resp = await Auth().PostAsJsonAsync($"/api/reservas/{id}/aprobar", new { });
        if (resp.IsSuccessStatusCode) { _msg = "Reserva aprobada."; _msgClass = "alert-success"; await RecargarReservasAsync(); }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    private async Task CancelarReserva(Guid id)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Cancelar esta reserva?")) return;
        var resp = await Auth().PostAsJsonAsync($"/api/reservas/{id}/cancelar-admin", new CancelarReservaRequest("Cancelado por administracion"));
        if (resp.IsSuccessStatusCode) await RecargarReservasAsync();
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    // ---------- Configuracion ----------
    private async Task AbrirConfig(Guid zonaId)
    {
        _configZonaNombre = ZonasReservables.FirstOrDefault(z => z.ZonaComunId == zonaId)?.Nombre ?? "";
        ZonaConfigDto? existing = null;
        try { existing = await Auth().GetFromJsonAsync<ZonaConfigDto>($"/api/reservas/configs/{zonaId}"); } catch { }
        _configEdit = new ConfigEdit
        {
            ZonaComunId = zonaId,
            RequiereAprobacion = existing?.RequiereAprobacion ?? false,
            AnticipacionMinimaHoras = existing?.AnticipacionMinimaHoras ?? 1,
            AnticipacionMaximaDias = existing?.AnticipacionMaximaDias ?? 30,
            DuracionMinimaMinutos = existing?.DuracionMinimaMinutos ?? 60,
            DuracionMaximaMinutos = existing?.DuracionMaximaMinutos ?? 240,
            TieneTarifa = existing?.TieneTarifa ?? false,
            ValorTarifa = existing?.ValorTarifa ?? 0,
            ModalidadCobro = existing?.ModalidadCobro ?? ModalidadCobroReserva.PorHora,
            Franjas = existing?.Franjas.Select(f => new FranjaEdit { DiaSemana = f.DiaSemana, HoraApertura = f.HoraApertura, HoraCierre = f.HoraCierre }).ToList() ?? new()
        };
        _showConfig = true;
    }

    private void ToggleFranja(DiaSemanaReserva dia, bool activar)
    {
        if (_configEdit is null) return;
        if (activar)
        {
            if (!_configEdit.Franjas.Any(f => f.DiaSemana == dia))
                _configEdit.Franjas.Add(new FranjaEdit { DiaSemana = dia, HoraApertura = new TimeOnly(8, 0), HoraCierre = new TimeOnly(22, 0) });
        }
        else _configEdit.Franjas.RemoveAll(f => f.DiaSemana == dia);
    }

    private void SetFranjaHora(int idx, bool esApertura, string value)
    {
        if (_configEdit is null || idx >= _configEdit.Franjas.Count) return;
        if (TimeOnly.TryParse(value, out var t))
        {
            if (esApertura) _configEdit.Franjas[idx].HoraApertura = t;
            else _configEdit.Franjas[idx].HoraCierre = t;
        }
    }

    private async Task GuardarConfig()
    {
        if (_configEdit is null) return;
        _busy = true;
        try
        {
            var req = new GuardarConfigRequest(
                _configEdit.ZonaComunId,
                _configEdit.RequiereAprobacion, null, true,
                _configEdit.AnticipacionMinimaHoras, _configEdit.AnticipacionMaximaDias,
                _configEdit.DuracionMinimaMinutos, _configEdit.DuracionMaximaMinutos, 60,
                _configEdit.TieneTarifa, _configEdit.ModalidadCobro, _configEdit.ValorTarifa,
                PoliticaReembolso.SinReembolso, 0,
                24, true, ComportamientoCancelacionTardia.ConPenalidad,
                null, false, true,
                _configEdit.Franjas.Select(f => new FranjaInput(f.DiaSemana, f.HoraApertura, f.HoraCierre, true)).ToList());
            var resp = await Auth().PutAsJsonAsync("/api/reservas/configs", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Configuracion guardada."; _msgClass = "alert-success";
            _showConfig = false;
        }
        finally { _busy = false; }
    }

    // ---------- Bloqueos ----------
    private void AbrirBloqueo()
    {
        _blqZona = ZonasReservables.FirstOrDefault()?.ZonaComunId ?? Guid.Empty;
        _blqFechaIni = DateTime.Today; _blqFechaFin = DateTime.Today;
        _blqEtiqueta = EtiquetaBloqueo.Mantenimiento; _blqVisible = true; _blqMotivo = "";
        _showCrearBloqueo = true;
    }

    private async Task CrearBloqueo()
    {
        _busy = true;
        try
        {
            var req = new CrearBloqueoRequest(_blqZona, TipoBloqueoZona.DiaCompleto,
                DateOnly.FromDateTime(_blqFechaIni), DateOnly.FromDateTime(_blqFechaFin),
                null, null, _blqEtiqueta, string.IsNullOrWhiteSpace(_blqMotivo) ? null : _blqMotivo,
                _blqVisible);
            var resp = await Auth().PostAsJsonAsync("/api/reservas/bloqueos", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _showCrearBloqueo = false;
            _bloqueos = await Auth().GetFromJsonAsync<List<BloqueoDto>>("/api/reservas/bloqueos") ?? new();
        }
        finally { _busy = false; }
    }

    private async Task EliminarBloqueo(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/reservas/bloqueos/{id}");
        if (resp.IsSuccessStatusCode) _bloqueos = await Auth().GetFromJsonAsync<List<BloqueoDto>>("/api/reservas/bloqueos") ?? new();
    }

    // ---------- Helpers ----------
    private static bool EsActiva(EstadoReserva e) =>
        e is EstadoReserva.Confirmada or EstadoReserva.PendienteAprobacion or EstadoReserva.PendientePago;

    private static string ShortHora(TimeOnly t)
    {
        int h = t.Hour; string ap = h < 12 ? "am" : "pm";
        int h12 = h % 12; if (h12 == 0) h12 = 12;
        return t.Minute == 0 ? $"{h12}{ap}" : $"{h12}:{t.Minute:00}{ap}";
    }

    private static string Cap(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s.Substring(1);

    private static string FechaCorta(DateOnly d) => Cap(d.ToString("ddd d", Es)) + " " + d.ToString("MMM", Es);

    private static string TarifaTexto(ZonaGaleriaDto z) =>
        z.TieneTarifa && z.ValorTarifa is > 0 ? "$ " + z.ValorTarifa.Value.ToString("N0", Es) : "Gratis";

    private static string EstadoTexto(EstadoReserva e) => e switch
    {
        EstadoReserva.Confirmada => "Confirmada",
        EstadoReserva.PendienteAprobacion => "Pendiente",
        EstadoReserva.PendientePago => "Pendiente pago",
        EstadoReserva.Completada => "Completada",
        EstadoReserva.Expirada => "Expirada",
        _ => "Cancelada"
    };

    private static string EstadoFg(EstadoReserva e) => e switch
    {
        EstadoReserva.Confirmada => "#5838C9",
        EstadoReserva.PendienteAprobacion => "#B45309",
        EstadoReserva.PendientePago => "#B45309",
        EstadoReserva.Completada => "#516F90",
        _ => "#C0383C"
    };

    private static string EstadoBg(EstadoReserva e) => e switch
    {
        EstadoReserva.Confirmada => "#F1ECFD",
        EstadoReserva.PendienteAprobacion => "#FEF3DC",
        EstadoReserva.PendientePago => "#FEF3DC",
        EstadoReserva.Completada => "#EEF3F8",
        _ => "#FDE7E7"
    };

    private static string IconoZona(string nombre)
    {
        var n = (nombre ?? "").ToLowerInvariant();
        if (n.Contains("bbq") || n.Contains("parrilla") || n.Contains("terraza")) return "M6 3v4M10 3v4M14 3v4M4 11h16l-1 9H5z";
        if (n.Contains("cancha") || n.Contains("tenis") || n.Contains("futbol") || n.Contains("deport")) return "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20M2 12h20M12 2v20";
        if (n.Contains("gim") || n.Contains("gym")) return "M6 7v10M18 7v10M4 9v6M20 9v6M6 12h12";
        if (n.Contains("piscina") || n.Contains("pool")) return "M2 16c2 0 2 1.5 4 1.5S10 16 12 16s2 1.5 4 1.5 2-1.5 4-1.5M2 12c2 0 2 1.5 4 1.5S10 12 12 12";
        return "M3 21h18M5 21V8h14v13M9 12h.01M15 12h.01"; // salon / default
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}
