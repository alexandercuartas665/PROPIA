    // ---------- Helpers ----------
    private static bool EsActiva(EstadoReserva e) =>
        e is EstadoReserva.Confirmada or EstadoReserva.PendienteAprobacion or EstadoReserva.PendientePago;

    private static string ShortHora(TimeOnly t)
    {
        int h = t.Hour; string ap = h < 12 ? "am" : "pm";
        int h12 = h % 12; if (h12 == 0) h12 = 12;
        return t.Minute == 0 ? $"{h12}{ap}" : $"{h12}:{t.Minute:00}{ap}";
    }

    private static string Cap(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s.Substring(1);

    private static string FechaCorta(DateOnly d) => Cap(d.ToString("ddd d", Es)) + " " + d.ToString("MMM", Es);

    // Imagen de la zona (solo lectura) en la columna izquierda de los modales de reserva, misma ubicacion
    // que en la ficha de zona. La URL ya viene en la galeria (/api/reservas/galeria -> FotoUrl).
    private string? _verImagenZona;
    private RenderFragment ZonaImagen(Guid zonaId)
    {
        var z = _galeria?.FirstOrDefault(x => x.ZonaComunId == zonaId);
        var url = z?.FotoUrl;
        return @<div class="rs-zimg-col">
            @if (!string.IsNullOrWhiteSpace(url))
            {
                <div class="rs-zimg" style="background-image:url('@url')" role="button" title="Ver imagen completa" @onclick="() => _verImagenZona = url"></div>
            }
            else
            {
                <div class="rs-zimg-empty">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 17l-5-5-9 7"/></svg>
                    <span>Sin imagen</span>
                    <small>Se carga en la ficha de la zona (Equipos y Zonas Comunes)</small>
                </div>
            }
            @if (z is not null)
            {
                <div class="rs-zimg-nom">@z.Nombre</div>
                @if (z.Aforo is > 0) { <div class="rs-zimg-meta">Aforo: @z.Aforo personas</div> }
                <div class="rs-zimg-meta">Tarifa: @TarifaTexto(z)</div>
            }
        </div>;
    }

    private static string TarifaTexto(ZonaGaleriaDto z) =>
        z.TieneTarifa && z.ValorTarifa is > 0 ? "$ " + z.ValorTarifa.Value.ToString("N0", Es) : "Gratis";

