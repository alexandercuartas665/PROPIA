    private async Task ConfirmarRegistrarEjec()
    {
        if (_ejecFecha is null) return;
        _busy = true; _ejecMsg = null;
        try
        {
            var req = new RegistrarEjecucionRequest(
                _ejecActivoTipo, _ejecActivoId, TipoIntervencionMantenimiento.Preventivo,
                _ejecTitulo ?? "Mantenimiento", _ejecDetalle, _ejecFecha.Value, null);
            var r = await Auth().PostAsJsonAsync("/api/mantenimiento/intervenciones/registrar-ejecucion", req);
            if (!r.IsSuccessStatusCode) { _ejecMsg = await r.Content.ReadAsStringAsync(); _ejecMsgClass = "alert-danger"; return; }
            _showRegistrarEjec = false;
