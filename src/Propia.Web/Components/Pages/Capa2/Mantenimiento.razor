    private async Task GuardarCfgProgAsync(Propia.Application.MiCopropiedad.GuardarUnidadCampoConfigRequest req)
    {
        try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { }
    }
    private async Task ToggleVisibleColProg(string clave)
    {
        if (EsFijaProg(clave)) return;
        var visible = VisibleColProg(clave);
        await GuardarCfgProgAsync(FilaConfigProg(clave) with { Oculto = visible });
        await CargarConfigProgAsync(); StateHasChanged();
    }
    private async Task MoverColumnaProg(string clave, int dir)
    {
        var keys = ClavesOrdenadasProg().ToList();
        var i = keys.IndexOf(clave); var j = i + dir;
        if (i < 0 || j < 0 || j >= keys.Count) return;
        (keys[i], keys[j]) = (keys[j], keys[i]);
        for (int k = 0; k < keys.Count; k++) await GuardarCfgProgAsync(FilaConfigProg(keys[k]) with { Orden = k });
        await CargarConfigProgAsync(); StateHasChanged();
    }
    private async Task OcultarTodasColProg()
    {
        foreach (var k in ClavesOrdenadasProg()) { if (EsFijaProg(k)) continue; await GuardarCfgProgAsync(FilaConfigProg(k) with { Oculto = true }); }
        await CargarConfigProgAsync(); StateHasChanged();
    }
    private async Task MostrarTodasColProg()
    {
        foreach (var k in ClavesOrdenadasProg()) await GuardarCfgProgAsync(FilaConfigProg(k) with { Oculto = false });
        await CargarConfigProgAsync(); StateHasChanged();
    }
    private async Task RestablecerColProg()
    {
        foreach (var k in ClavesOrdenadasProg()) await GuardarCfgProgAsync(FilaConfigProg(k) with { Oculto = !VisibleColDefaultProg(k), Orden = null });
        await CargarConfigProgAsync(); StateHasChanged();
    }
    private async Task EliminarCampoDinProg()
    {
        if (_campoAEliminarProg is null) return;
        _colBusyProg = true;
        try
        {
            var r = await Auth().DeleteAsync($"/api/mi-copropiedad/programacion-campos/{_campoAEliminarProg.Id}");
            _msg = r.IsSuccessStatusCode ? $"Campo \"{_campoAEliminarProg.Label}\" eliminado." : "No se pudo eliminar el campo.";
            _msgClass = r.IsSuccessStatusCode ? "alert-success" : "alert-danger";
            if (r.IsSuccessStatusCode) await RecargarCamposYConfigProgAsync();
        }
        catch (Exception ex) { _msg = "Error al eliminar el campo: " + ex.Message; _msgClass = "alert-danger"; }
        _campoAEliminarProg = null; _colBusyProg = false; StateHasChanged();
    }

