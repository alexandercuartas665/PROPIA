    // Edicion inline de la frecuencia de un plan existente (PUT MERGE: conserva el resto de campos).
    private async Task CambiarFrecuenciaPlanAsync(PlanDto plan, string? valor)
    {
        if (_planBusy is not null) return;
        if (!Enum.TryParse<FrecuenciaMantenimiento>(valor, out var freq) || freq == plan.Frecuencia) return;
        _planBusy = plan.Id;
        try
        {
            var dias = freq == FrecuenciaMantenimiento.Personalizada ? (plan.FrecuenciaDias ?? 30) : (int?)null;
            var req = new ActualizarPlanRequest(plan.Nombre, plan.Descripcion, freq, dias,
                plan.ProveedorPreferidoId, plan.Disparo, plan.DiasAlertaPrevio, plan.GeneraNotifResidentes);
            var r = await Auth().PutAsJsonAsync($"/api/mantenimiento/planes/{plan.Id}", req);
            if (r.IsSuccessStatusCode) { _msg = "Frecuencia del plan actualizada."; _msgClass = "alert-success"; await CargarAsync(); }
            else { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _planBusy = null; }
    }

    // Alta inline de un plan preventivo (sin modal). Valida minimos al clic y resalta la fila creada.
    private async Task AltaPlanInlineAsync()
    {
        if (!Guid.TryParse(_planActivoId, out var activoId)) { _msg = "Elige un activo para el plan."; _msgClass = "alert-danger"; return; }
        if (string.IsNullOrWhiteSpace(_planNombre)) { _msg = "El plan necesita un nombre."; _msgClass = "alert-danger"; return; }
        if (_planFechaInicio is null) { _msg = "Indica la fecha de inicio del plan."; _msgClass = "alert-danger"; return; }
        _busy = true; _msg = null;
        try
        {
            var dias = _planFrecuencia == FrecuenciaMantenimiento.Personalizada ? (_planFrecuenciaDias ?? 30) : (int?)null;
            var req = new CrearPlanRequest(
                Enum.Parse<TipoActivoMantenimiento>(_planActivoTipo), activoId,
                _planNombre!, null, _planFrecuencia, dias, _planFechaInicio.Value, null,
                Enum.Parse<DisparoPlanMantenimiento>(_planDisparo), _planDiasAlerta, _planNotificarResidentes);
            var resp = await Auth().PostAsJsonAsync("/api/mantenimiento/planes", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            try { var creado = await resp.Content.ReadFromJsonAsync<PlanDto>(); _planRecienCreado = creado?.Id; } catch { }
            _msg = "Plan preventivo creado."; _msgClass = "alert-success";
            // Limpiar la fila de alta (deja el tipo/disparo/dias como venian para altas seguidas).
            _planNombre = null; _planActivoId = ""; _planFechaInicio = null;
            _planFrecuencia = FrecuenciaMantenimiento.Mensual; _planFrecuenciaDias = null; _planNotificarResidentes = false;
            await CargarAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _busy = false; }
    }

