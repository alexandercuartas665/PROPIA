@page "/mantenimiento"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Mantenimiento
@using Propia.Application.Programaciones
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Modals
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals

<PageTitle>Mantenimiento y Activos - PROPIA</PageTitle>

<div class="mt-head">
    <div>
        <h1 class="mt-title">Mantenimiento y activos</h1>
        <p class="mt-sub">Planes preventivos, intervenciones correctivas y bitacora de equipos.</p>
    </div>
    <div class="mt-head-actions">
        <button class="mt-btn-ghost" type="button" @onclick="() => _showCrearPlan = true">+ Plan preventivo</button>
        <button class="mt-btn-brand" type="button" @onclick="() => _showCrearIntervencion = true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
            Nueva intervencion
        </button>
    </div>
</div>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <div class="mt-empty">Sesion expirada. <a href="/login?returnUrl=%2Fmantenimiento">Iniciar sesion</a>.</div>
    return;
}

@* Sin KPIs (canon regla 7): del titulo se pasa directo a las pestanas y la barra de filtros. *@

@* Tabs estilo prototipo (pills brand) *@
<div class="mt-tabs">
    <button class="mt-tab @(_tab == "prog" ? "mt-tab--on" : "")" type="button" @onclick='() => SwitchTab("prog")'>Programacion</button>
    <button class="mt-tab @(_tab == "intervenciones" ? "mt-tab--on" : "")" type="button" @onclick='() => SwitchTab("intervenciones")'>Intervenciones</button>
    <button class="mt-tab @(_tab == "planes" ? "mt-tab--on" : "")" type="button" @onclick='() => SwitchTab("planes")'>Planes preventivos</button>
    <button class="mt-tab @(_tab == "calendario" ? "mt-tab--on" : "")" type="button" @onclick='() => SwitchTab("calendario")'>Calendario</button>
</div>

@if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

@if (_tab == "prog")
{
    @* Configuracion de mantenimientos en TABLA (patron vista-tabla): una fila por programacion,
       expansor en la 1a columna -> modal completo; Filtros / Agrupar / Campos; alta inline por activo. *@
    <div class="mod-filtros" style="margin-bottom:14px; display:flex; align-items:center; gap:10px;">
        <FiltroDinamico @ref="_fdProg" Campos="CamposFiltroProg" OnChanged="StateHasChanged" />
        <div class="mod-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="mod-search-inp" placeholder="Buscar programacion..." @bind="_progQuery" @bind:event="oninput" />
        </div>
        <div style="flex:1;"></div>
        <div class="mtp-menuwrap">
            <button type="button" class="mtp-fbtn @(_progAgrupar != "" ? "on" : "")" @onclick='() => _progMenu = _progMenu == "agr" ? "" : "agr"'>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                <span>Agrupar@(_progAgrupar != "" ? ": " + ProgAgruparLabel(_progAgrupar) : "")</span>
            </button>
            @if (_progMenu == "agr")
            {
                <div class="mtp-menu-bd" @onclick='() => _progMenu = ""'></div>
                <div class="mtp-menu">
                    @foreach (var g in new[] { ("", "Sin agrupar"), ("activo", "Activo"), ("tablero", "Tablero"), ("periodicidad", "Periodicidad"), ("prioridad", "Prioridad") })
                    {
                        var gk = g.Item1;
                        <button class="mtp-menu-it @(_progAgrupar == gk ? "on" : "")" @onclick='() => { _progAgrupar = gk; _progMenu = ""; }'>@g.Item2</button>
                    }
                </div>
            }
        </div>
        <div class="mtp-menuwrap">
            <button type="button" class="mtp-fbtn @(_progMenu == "cols" ? "on" : "")" @onclick='() => _progMenu = _progMenu == "cols" ? "" : "cols"'>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                <span>Campos</span>
            </button>
            @if (_progMenu == "cols")
            {
                <div class="mtp-menu-bd" @onclick='() => _progMenu = ""'></div>
                <div class="mtp-menu">
                    @foreach (var c in _progColsAll)
                    {
                        var ck = c.Key;
                        <label class="mtp-menu-chk"><input type="checkbox" checked="@(!_progColsOcultas.Contains(ck))" @onchange="@(e => ToggleColProg(ck, (bool)(e.Value ?? false)))" /> @c.Label</label>
                    }
                </div>
            }
        </div>
    </div>

    @if (_progs is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else
    {
        <div class="mtp-table">
            <div class="mtp-head" style="@ProgGrid">
                <div></div>
                @foreach (var c in ProgColsVis) { <div>@c.Label</div> }
                <div></div>
            </div>
            @foreach (var grupo in ProgAgrupadas())
            {
                @if (_progAgrupar != "")
                {
                    <div class="mtp-group"><span>@grupo.Key</span><span class="mtp-group-n">@grupo.Count()</span></div>
                }
                @foreach (var p in grupo)
                {
                    var pp = p;
                    <div class="mtp-row" style="@ProgGrid">
                        <div class="mtp-exp-col">
                            <button type="button" class="mtp-exp" title="Abrir la programacion completa" @onclick="() => AbrirEditarProgAsync(pp)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </div>
                        @foreach (var c in ProgColsVis)
                        {
                            switch (c.Key)
                            {
                                case "activo":
                                    <div class="mtp-nom" title="@(p.ModuloOrigenCodigo == "zona" ? "Zona comun" : "Equipo")">@(string.IsNullOrWhiteSpace(p.OrigenReferencia) ? "-" : p.OrigenReferencia)</div>
                                    break;
                                case "titulo": <div>@p.Titulo</div> break;
                                case "tablero": <div>@(string.IsNullOrWhiteSpace(p.TableroNombre) ? "General" : p.TableroNombre)</div> break;
                                case "prioridad": <div>@p.Prioridad</div> break;
                                case "periodicidad": <div>@(p.Tipo == TipoProgramacion.Cron ? $"Cron: {p.CronExpresion}" : PeriodicidadProgLabel(p.Periodicidad))</div> break;
                                case "proxima": <div>@p.FechaProximaEjecucion.ToString("yyyy-MM-dd")</div> break;
                                case "responsables": <div title="@string.Join(", ", p.Responsables.Select(r => r.Nombre))">@(p.Responsables.Count == 0 ? "-" : $"{p.Responsables.Count} resp.")</div> break;
                                case "activa":
                                    <div><button type="button" class="mtp-toggle @(p.Activa ? "on" : "")" title="@(p.Activa ? "Activa" : "Pausada")" @onclick="() => ToggleActivaProgAsync(pp)"><span class="mtp-toggle-knob"></span></button></div>
                                    break;
                            }
                        }
                        <div class="mtp-act">
                            <button type="button" class="mtp-del" title="Eliminar" @onclick="() => EliminarProgAsync(pp)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                            </button>
                        </div>
                    </div>
                }
            }
            @* Alta inline: elegir activo + "+ Programar" abre el modal completo con ese activo. *@
            <div class="mtp-newrow" style="@ProgGrid">
                <div class="mtp-exp-col">
                    <button type="button" class="mtp-exp mtp-exp-fijo" title="Programar mantenimiento del activo elegido" @onclick="AltaProgAsync" disabled="@(string.IsNullOrEmpty(_altaActivoKey))">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                </div>
                <div style="grid-column: 2 / -2;">
                    <select class="mtp-nf-inp" @bind="_altaActivoKey">
                        <option value="">Selecciona un activo o zona para programar...</option>
                        @foreach (var a in (_activos ?? new()))
                        {
                            <option value="@($"{a.ActivoTipo}:{a.ActivoId}")">@a.Nombre (@ActivoTipoLabel(a.ActivoTipo))</option>
                        }
                    </select>
                </div>
                <div class="mtp-act">
                    <button type="button" class="mtp-add" @onclick="AltaProgAsync" disabled="@(string.IsNullOrEmpty(_altaActivoKey))">+ Programar</button>
                </div>
            </div>
            <div class="mtp-footer">Mostrando @ProgFiltradas().Count() de @(_progs.Count) programaciones</div>
        </div>
    }
}

@if (_tab == "intervenciones")
{
    @if (_intervenciones is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else if (_intervenciones.Count == 0)
    {
        <div class="card p-4 text-center text-muted">Sin intervenciones registradas.</div>
    }
    else
    {
        <div class="card table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light small text-muted">
                    <tr>
                        <th>Codigo</th><th>Activo</th><th>Tipo</th><th>Titulo</th>
                        <th>Estado</th><th>Prioridad</th><th>Proveedor</th><th>Programada</th><th>Tarea</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var i in _intervenciones)
                    {
                        var iid = i.Id;
                        <tr style="cursor:pointer;" @onclick="() => MostrarFicha(iid)">
                            <td class="text-muted">@i.Codigo</td>
                            <td><strong>@i.ActivoNombre</strong></td>
                            <td>@RenderTipoBadge(i.Tipo)</td>
                            <td>@i.Titulo</td>
                            <td>@RenderEstadoBadge(i.Estado)</td>
                            <td>@RenderPrioridadBadge(i.Prioridad)</td>
                            <td>@(i.ProveedorNombre ?? "-")</td>
                            <td>
                                @if (i.FechaProgramada.HasValue)
                                {
                                    <span class="@(i.Vencida ? "text-danger fw-bold" : "")">@i.FechaProgramada.Value.ToString("yyyy-MM-dd")</span>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td>
                                @if (i.TareaId.HasValue)
                                {
                                    <a class="small" href="@($"/tareas/{i.TareaId}")">@i.TareaNumero</a>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (_tab == "planes")
{
    @if (_planes is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else
    {
        @* Planes preventivos en TABLA (patron vista-tabla): alta INLINE (sin modal) + edicion inline de la
           Frecuencia sobre filas existentes. El modal "+ Plan preventivo" del header queda como via alterna. *@
        <div class="mtp-table">
            <div class="mtp-head" style="@PlanGrid">
                <div>Activo</div><div>Plan</div><div>Frecuencia</div><div>Proxima ejecucion</div>
                <div>Disparo</div><div>Proveedor</div><div>Estado</div><div></div>
            </div>
            @foreach (var p in _planes)
            {
                var pp = p;
                <div class="mtp-row @(p.Id == _planRecienCreado ? "mtp-row--nuevo" : "")" style="@PlanGrid">
                    <div class="mtp-nom" title="@p.ActivoNombre">@p.ActivoNombre <span class="mtp-tag">@ActivoTipoLabel(p.ActivoTipo)</span></div>
                    <div title="@p.Nombre">@p.Nombre</div>
                    <div>
                        <select class="mtp-cell-inp @(_planBusy == p.Id ? "is-busy" : "")" disabled="@(_planBusy == p.Id || !p.Activo)"
                                @onchange="(e) => CambiarFrecuenciaPlanAsync(pp, e.Value?.ToString())">
                            @foreach (var f in Enum.GetValues<FrecuenciaMantenimiento>())
                            {
                                <option value="@f" selected="@(p.Frecuencia == f)">@f@(f == FrecuenciaMantenimiento.Personalizada && p.Frecuencia == f ? $" ({p.FrecuenciaDias}d)" : "")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <span class="mtp-dot mt-sem-@p.Semaforo.ToString().ToLower()"></span>
                        <span>@p.ProximaEjecucion.ToString("yyyy-MM-dd")</span>
                        @if (p.DiasParaVencer.HasValue && p.Activo)
                        {
                            <span class="@(p.DiasParaVencer < 0 ? "mt-acard-venc" : p.DiasParaVencer < 7 ? "mt-acard-prox" : "mtp-muted")"> (@(p.DiasParaVencer < 0 ? $"-{-p.DiasParaVencer}d" : $"+{p.DiasParaVencer}d"))</span>
                        }
                    </div>
                    <div>@p.Disparo</div>
                    <div>@(p.ProveedorPreferidoNombre ?? "-")</div>
                    <div>
                        @if (p.Activo)
                        {
                            <button type="button" class="mtp-estado-btn" @onclick="() => DesactivarPlan(p.Id)">Desactivar</button>
                        }
                        else
                        {
                            <button type="button" class="mtp-estado-btn on" @onclick="() => ReactivarPlan(p.Id)">Reactivar</button>
                        }
                    </div>
                    <div></div>
                </div>
            }
            @* Fila de alta inline: captura todos los campos del plan; "+ Agregar" lo crea sin modal. *@
            <div class="mtp-newrow" style="@PlanGrid">
                <div style="display:flex; flex-direction:column; gap:4px;">
                    <select class="mtp-nf-inp" @bind="_planActivoTipo">
                        <option value="Equipo">Equipo</option>
                        <option value="ZonaComun">Zona comun</option>
                    </select>
                    <select class="mtp-nf-inp" @bind="_planActivoId">
                        <option value="">Activo...</option>
                        @if (_activos is not null)
                        {
                            @foreach (var a in _activos.Where(x => x.ActivoTipo.ToString() == _planActivoTipo))
                            {
                                <option value="@a.ActivoId">@a.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div><input class="mtp-nf-inp" placeholder="Nombre del plan" @bind="_planNombre" @bind:event="oninput" /></div>
                <div style="display:flex; flex-direction:column; gap:4px;">
                    <select class="mtp-nf-inp" @bind="_planFrecuencia">
                        @foreach (var f in Enum.GetValues<FrecuenciaMantenimiento>()) { <option value="@f">@f</option> }
                    </select>
                    @if (_planFrecuencia == FrecuenciaMantenimiento.Personalizada)
                    {
                        <input type="number" min="1" max="365" class="mtp-nf-inp" placeholder="dias" @bind="_planFrecuenciaDias" />
                    }
                </div>
                <div><input type="date" class="mtp-nf-inp" value="@(_planFechaInicio?.ToString("yyyy-MM-dd"))" @onchange="(e) => _planFechaInicio = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" /></div>
                <div>
                    <select class="mtp-nf-inp" @bind="_planDisparo">
                        <option value="ConConfirmacion">Con confirmacion</option>
                        <option value="Automatico">Automatico</option>
                    </select>
                </div>
                <div><input type="number" min="0" max="90" class="mtp-nf-inp" placeholder="Dias alerta" @bind="_planDiasAlerta" /></div>
                <div>
                    <label class="mtp-nf-chk" title="Notificar residentes al ejecutar">
                        <input type="checkbox" @bind="_planNotificarResidentes" /> Notif.
                    </label>
                </div>
                <div class="mtp-act">
                    <button type="button" class="mtp-add" @onclick="AltaPlanInlineAsync" disabled="@_busy">+ Agregar</button>
                </div>
            </div>
            <div class="mtp-footer">Mostrando @_planes.Count de @_planes.Count planes</div>
        </div>
    }
}
else if (_tab == "calendario")
{
    @* Calendario mensual de programaciones (estilo Reservas/PQRSD): intervenciones por fecha
       programada y planes preventivos por su proxima ejecucion. *@
    <div class="mt-cal">
        <div class="mt-cal-bar">
            <button class="mt-cal-nav" type="button" @onclick="() => MtCalMover(-1)">&#8249;</button>
            <span class="mt-cal-title">@MtCalTitulo</span>
            <button class="mt-cal-nav" type="button" @onclick="() => MtCalMover(1)">&#8250;</button>
            <button class="mt-cal-hoy" type="button" @onclick="MtCalHoy">Hoy</button>
            <span class="mt-cal-hint">Intervenciones por fecha programada &middot; planes preventivos por proxima ejecucion.</span>
        </div>
        <div class="mt-cal-head">
            @foreach (var dw in new[] { "LUN", "MAR", "MIE", "JUE", "VIE", "SAB", "DOM" }) { <div class="mt-cal-dow">@dw</div> }
        </div>
        <div class="mt-cal-grid">
            @foreach (var celda in MtCalCeldas())
            {
                <div class="mt-cal-cell @(celda.EsHoy ? "mt-cal-cell--hoy" : "") @(celda.EsMes ? "" : "mt-cal-cell--off")">
                    <div class="mt-cal-daynum">@celda.Dia</div>
                    @foreach (var ev in celda.Items.Take(3))
                    {
                        var evLocal = ev;
                        <div class="mt-cal-ev @ev.Clase" title="@ev.Titulo"
                             @onclick="async () => { if (evLocal.IntervencionId is Guid iid) await MostrarFicha(iid); }">
                            @ev.Texto
                        </div>
                    }
                    @if (celda.Items.Count > 3) { <div class="mt-cal-more">+@(celda.Items.Count - 3) mas</div> }
                </div>
            }
        </div>
    </div>
}

@* ===== Modal Crear Intervencion ===== *@
@if (_showCrearIntervencion)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva intervencion</h5>
                    <button type="button" class="btn-close" @onclick="CerrarCrearIntervencion"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small">Tipo *</label>
                            <select class="form-select form-select-sm" @bind="_crearTipo">
                                <option value="Correctivo">Correctivo</option>
                                <option value="Preventivo">Preventivo</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Tipo activo *</label>
                            <select class="form-select form-select-sm" @bind="_crearActivoTipo">
                                <option value="Equipo">Equipo</option>
                                <option value="ZonaComun">Zona comun</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Activo</label>
                            <select class="form-select form-select-sm" @bind="_crearActivoId">
                                <option value="">Seleccione...</option>
                                @if (_activos is not null)
                                {
                                    @foreach (var a in _activos.Where(x => x.ActivoTipo.ToString() == _crearActivoTipo))
                                    {
                                        <option value="@a.ActivoId">@a.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small">Titulo *</label>
                            <input class="form-control form-control-sm" @bind="_crearTitulo" @bind:event="oninput" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small">Descripcion</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="_crearDescripcion" @bind:event="oninput"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Prioridad</label>
                            <select class="form-select form-select-sm" @bind="_crearPrioridad">
                                @foreach (var p in Enum.GetValues<PrioridadIntervencion>()) { <option value="@p">@p</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Fecha programada</label>
                            <input type="date" class="form-control form-control-sm" value="@(_crearFecha?.ToString("yyyy-MM-dd"))"
                                   @onchange="(e) => _crearFecha = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">&nbsp;</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_crearNotificarResidentes" id="notifIntChk" />
                                <label class="form-check-label small" for="notifIntChk">Notificar residentes</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-dark" @onclick="CerrarCrearIntervencion">Cancelar</button>
                    <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="ConfirmarCrearIntervencion" disabled="@(_busy || string.IsNullOrWhiteSpace(_crearTitulo) || string.IsNullOrEmpty(_crearActivoId))">
                        @(_busy ? "Creando..." : "Crear intervencion")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal Crear Plan ===== *@
@if (_showCrearPlan)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo plan preventivo</h5>
                    <button type="button" class="btn-close" @onclick="CerrarCrearPlan"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small">Tipo de activo *</label>
                            <select class="form-select form-select-sm" @bind="_planActivoTipo">
                                <option value="Equipo">Equipo</option>
                                <option value="ZonaComun">Zona comun</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small">Activo *</label>
                            <select class="form-select form-select-sm" @bind="_planActivoId">
                                <option value="">Seleccione...</option>
                                @if (_activos is not null)
                                {
                                    @foreach (var a in _activos.Where(x => x.ActivoTipo.ToString() == _planActivoTipo))
                                    {
                                        <option value="@a.ActivoId">@a.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small">Nombre del plan *</label>
                            <input class="form-control form-control-sm" @bind="_planNombre" @bind:event="oninput" placeholder="Ej: Revision anual ascensor Torre A" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Frecuencia *</label>
                            <select class="form-select form-select-sm" @bind="_planFrecuencia">
                                @foreach (var f in Enum.GetValues<FrecuenciaMantenimiento>()) { <option value="@f">@f</option> }
                            </select>
                        </div>
                        @if (_planFrecuencia == FrecuenciaMantenimiento.Personalizada)
                        {
                            <div class="col-md-4">
                                <label class="form-label small">Dias *</label>
                                <input type="number" min="1" max="365" class="form-control form-control-sm" @bind="_planFrecuenciaDias" />
                            </div>
                        }
                        <div class="col-md-4">
                            <label class="form-label small">Fecha inicio *</label>
                            <input type="date" class="form-control form-control-sm" value="@(_planFechaInicio?.ToString("yyyy-MM-dd"))"
                                   @onchange="(e) => _planFechaInicio = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Disparo</label>
                            <select class="form-select form-select-sm" @bind="_planDisparo">
                                <option value="ConConfirmacion">Con confirmacion</option>
                                <option value="Automatico">Automatico</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Dias alerta previa</label>
                            <input type="number" min="0" max="90" class="form-control form-control-sm" @bind="_planDiasAlerta" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">&nbsp;</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_planNotificarResidentes" id="notifPlanChk" />
                                <label class="form-check-label small" for="notifPlanChk">Notificar residentes al ejecutar</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-dark" @onclick="CerrarCrearPlan">Cancelar</button>
                    <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="ConfirmarCrearPlan"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_planNombre) || string.IsNullOrEmpty(_planActivoId) || _planFechaInicio is null)">
                        @(_busy ? "Creando..." : "Crear plan")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal Ficha Intervencion ===== *@
@if (_fichaIntervencion is not null)
{
    var i = _fichaIntervencion;
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@i.Codigo &middot; @i.Titulo</h5>
                        <small class="text-muted">@RenderTipoBadge(i.Tipo) &middot; @i.ActivoNombre &middot; Origen: @i.Origen</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _fichaIntervencion = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-3"><small class="text-muted">Estado</small><br>@RenderEstadoBadge(i.Estado)</div>
                        <div class="col-md-3"><small class="text-muted">Prioridad</small><br>@RenderPrioridadBadge(i.Prioridad)</div>
                        <div class="col-md-3"><small class="text-muted">Proveedor</small><br>@(i.ProveedorNombre ?? "-")</div>
                        <div class="col-md-3"><small class="text-muted">Programada</small><br>@(i.FechaProgramada?.ToString("yyyy-MM-dd") ?? "-")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(i.Descripcion))
                    {
                        <p class="small mb-3"><strong>Descripcion:</strong> @i.Descripcion</p>
                    }
                    @if (i.TareaId.HasValue)
                    {
                        <p class="small mb-3"><a href="@($"/tareas/{i.TareaId}")">Ver tarea vinculada: @i.TareaNumero</a></p>
                    }
                    @if (i.Estado != EstadoIntervencion.Completada && i.Estado != EstadoIntervencion.Cancelada)
                    {
                        <div class="d-flex gap-2 mb-3 flex-wrap">
                            @if (i.Estado == EstadoIntervencion.Programada)
                            {
                                <button class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(i.Id, EstadoIntervencion.EnEjecucion)">Iniciar ejecucion</button>
                            }
                            @if (i.Estado == EstadoIntervencion.EnEjecucion)
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => CambiarEstado(i.Id, EstadoIntervencion.EnRevision)">Pasar a revision</button>
                            }
                            <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="() => _mostrarCerrar = true">Cerrar intervencion</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _mostrarCancelar = true">Cancelar</button>
                        </div>
                    }

                    <h6 class="mt-4 mb-2">Bitacora</h6>
                    @if (i.Bitacora.Count == 0)
                    {
                        <p class="text-muted small">Sin entradas.</p>
                    }
                    else
                    {
                        @foreach (var b in i.Bitacora.OrderByDescending(x => x.CreadoAt))
                        {
                            <div class="border-start ps-3 mb-3" style="border-left-width:3px !important; border-color: var(--propia-primary) !important;">
                                <small class="text-muted">
                                    @b.CreadoAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm") &middot; @b.TipoAutor &middot; @b.AutorNombre
                                </small>
                                <p class="mb-0 small">@b.Contenido</p>
                            </div>
                        }
                    }

                    @if (i.Estado != EstadoIntervencion.Completada && i.Estado != EstadoIntervencion.Cancelada)
                    {
                        <div class="card bg-light mt-3">
                            <div class="card-body py-3">
                                <label class="form-label small fw-semibold">Agregar entrada</label>
                                <textarea class="form-control form-control-sm mb-2" rows="2" @bind="_nuevaEntrada" @bind:event="oninput"></textarea>
                                <div class="d-flex gap-2 align-items-center">
                                    <select class="form-select form-select-sm w-auto" @bind="_nuevaEntradaTipo">
                                        @foreach (var t in Enum.GetValues<TipoAutorBitacoraMantenimiento>()) { <option value="@t">@t</option> }
                                    </select>
                                    <button class="btn btn-sm btn-dark" @onclick="AgregarEntrada" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaEntrada))">
                                        Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_mostrarCerrar)
                    {
                        <div class="card border-success mt-3">
                            <div class="card-body">
                                <h6 class="mb-3">Cerrar intervencion</h6>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label small">Fecha cierre *</label>
                                        <input type="date" class="form-control form-control-sm"
                                               value="@(_cerrarFecha?.ToString("yyyy-MM-dd"))"
                                               @onchange="(e) => _cerrarFecha = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label small">Nota de cierre *</label>
                                        <textarea class="form-control form-control-sm" rows="2" @bind="_cerrarNota" @bind:event="oninput"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="_cerrarCambiaEstado" id="cerrarCambioChk" />
                                            <label class="form-check-label small" for="cerrarCambioChk">Cambiar estado del activo al cerrar</label>
                                        </div>
                                    </div>
                                    @if (_cerrarCambiaEstado)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label small">Nuevo estado *</label>
                                            <select class="form-select form-select-sm" @bind="_cerrarEstadoNuevo">
                                                <option value="">Seleccione...</option>
                                                @if (i.ActivoTipo == TipoActivoMantenimiento.Equipo)
                                                {
                                                    @foreach (var s in Enum.GetValues<EstadoEquipoActivo>()) { <option value="@s">@s</option> }
                                                }
                                                else
                                                {
                                                    @foreach (var s in Enum.GetValues<EstadoZonaComunMantenimiento>()) { <option value="@s">@s</option> }
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _mostrarCerrar = false">Volver</button>
                                    <button class="btn btn-sm btn-success" @onclick="() => ConfirmarCerrar(i.Id)"
                                            disabled="@(_busy || string.IsNullOrWhiteSpace(_cerrarNota) || _cerrarFecha is null)">
                                        Confirmar cierre
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_mostrarCancelar)
                    {
                        <div class="card border-danger mt-3">
                            <div class="card-body">
                                <h6 class="mb-3 text-danger">Cancelar intervencion</h6>
                                <label class="form-label small">Motivo *</label>
                                <textarea class="form-control form-control-sm mb-2" rows="2" @bind="_cancelarMotivo" @bind:event="oninput"></textarea>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _mostrarCancelar = false">Volver</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarCancelar(i.Id)"
                                            disabled="@(_busy || string.IsNullOrWhiteSpace(_cancelarMotivo))">
                                        Confirmar cancelacion
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ModalHost DEBE vivir en la pagina (no en MainLayout): comparte instancia Scoped del IModalService. *@
<ModalHost />

<style>
    /* === Estilos base prototipo PROPIA.dc.html === */
    .mt-head, .mt-kpis, .mt-tabs, .mt-empty { font-family: var(--propia-font-base, 'Lexend', sans-serif); }
    .mt-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
    .mt-title { font-size: 27px; font-weight: 800; letter-spacing: -0.6px; color: var(--propia-text-h1); margin: 0; }
    .mt-sub { font-size: 14px; color: var(--propia-text-muted); margin: 4px 0 0; }
    .mt-head-actions { display: flex; align-items: center; gap: 9px; }
    .mt-btn-ghost { padding: 10px 16px; border-radius: 9px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); font-size: 13px; font-weight: 600; color: var(--propia-text-secondary); cursor: pointer; font-family: inherit; }
    .mt-btn-ghost:hover { border-color: var(--propia-brand, var(--propia-brand)); color: var(--propia-brand, var(--propia-brand)); }
    .mt-btn-brand {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 11px 17px; border-radius: 10px; border: 0;
        background: var(--propia-brand, var(--propia-brand)); color: var(--propia-text-inverse);
        font-size: 13.5px; font-weight: 700; cursor: pointer; font-family: inherit;
        box-shadow: 0 6px 16px rgba(109,79,227,.32);
    }
    .mt-btn-brand:hover { background: var(--propia-brand-hover, var(--propia-brand-hover)); }

    .mt-empty { background: var(--propia-bg-app); border: 1px dashed var(--propia-border-input); border-radius: 12px; padding: 30px; text-align: center; color: var(--propia-text-faint); }

    .mt-kpis { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; margin-bottom: 16px; }
    .mt-kpi { background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 11px; padding: 11px 13px; }
    .mt-kpi-val { font-size: 22px; font-weight: 800; color: var(--propia-text-h1); letter-spacing: -0.3px; }
    .mt-kpi-lbl { font-size: 10.5px; color: var(--propia-text-faint); font-weight: 600; margin-top: 1px; }
    .mt-kpi--verde .mt-kpi-val { color: #15703F; }
    .mt-kpi--amarillo .mt-kpi-val { color: #B45309; }
    .mt-kpi--rojo .mt-kpi-val { color: #DC2626; }
    .mt-kpi--rojo { background: #FEF2F2; border-color: #FECACA; }

    .mt-tabs { display: flex; gap: 6px; margin-bottom: 16px; border-bottom: 1px solid var(--propia-border-divider); padding-bottom: 0; }
    .mt-tab {
        padding: 9px 16px; border: 0; border-bottom: 2px solid transparent;
        background: transparent; font-size: 13.5px; font-weight: 700; color: var(--propia-text-muted);
        cursor: pointer; font-family: inherit; transition: color .15s, border-color .15s;
    }
    .mt-tab:hover { color: var(--propia-text-h1); }
    .mt-tab--on { color: var(--propia-brand, var(--propia-brand)); border-bottom-color: var(--propia-brand, var(--propia-brand)); }

    [data-bs-theme="dark"] .mt-title { color: var(--propia-text-body); }
    [data-bs-theme="dark"] .mt-kpi { background: var(--propia-bg-card-soft); border-color: var(--propia-border-card); }
    [data-bs-theme="dark"] .mt-kpi-val { color: var(--propia-text-body); }

    .kpi-mini { border-radius: 12px; border: 1px solid #e6e6ee; }
    .semaforo-verde { border-left: 4px solid #22c55e; }
    .semaforo-amarillo { border-left: 4px solid #f59e0b; }
    .semaforo-rojo { border-left: 4px solid #ef4444; }
    .semaforo-negro { border-left: 4px solid #6b7280; }
    /* === Tarjetas de activos al estilo Zonas Comunes (icono con color del semaforo) === */
    .mt-acards { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 10px; }
    .mt-acard { display: flex; align-items: center; gap: 11px; padding: 12px 14px; border: 1px solid var(--propia-border-card); border-radius: 12px; background: var(--propia-bg-card); }
    .mt-acard-ic { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .mt-sem-verde { background: var(--propia-ok-soft); color: #15703F; }
    .mt-sem-amarillo { background: #FEF3C7; color: #B45309; }
    .mt-sem-rojo { background: #FEE2E2; color: #B91C1C; }
    .mt-sem-negro { background: var(--propia-border-divider); color: var(--propia-text-secondary); }
    .mt-acard-id { flex: 1; min-width: 0; }
    .mt-acard-nom { font-size: 13.5px; font-weight: 700; color: var(--propia-text-h1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mt-acard-meta { font-size: 11px; color: var(--propia-text-faint); }
    .mt-acard-plan { font-size: 11.5px; color: var(--propia-text-secondary); margin-top: 3px; }
    .mt-acard-plan--off { color: var(--propia-text-faint); font-style: italic; }
    .mt-acard-venc { color: #B91C1C; font-weight: 700; }
    .mt-acard-prox { color: #B45309; font-weight: 700; }
    .mt-acard-chip { flex: 0 0 auto; font-size: 10.5px; font-weight: 700; color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft); border-radius: 7px; padding: 4px 9px; white-space: nowrap; }
    @@media (max-width: 640px) { .mt-acards { grid-template-columns: 1fr; } }

    /* === Calendario de programaciones (mismo patron visual del calendario de PQRSD) === */
    .mt-cal { border: 1px solid var(--propia-border-card); border-radius: 14px; overflow: hidden; background: var(--propia-bg-card); margin-bottom: 30px; }
    .mt-cal-bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--propia-border-divider); }
    .mt-cal-nav { font-size: 18px; border: 1px solid var(--propia-border-card); border-radius: 8px; width: 30px; height: 30px; background: var(--propia-bg-card); color: var(--propia-text-secondary); cursor: pointer; }
    .mt-cal-title { font-size: 15px; font-weight: 800; color: var(--propia-text-h1); min-width: 150px; text-align: center; }
    .mt-cal-hoy { padding: 6px 12px; border: 1px solid var(--propia-border-card); border-radius: 8px; background: var(--propia-bg-card); color: var(--propia-text-secondary); font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .mt-cal-hint { margin-left: auto; font-size: 11.5px; color: var(--propia-text-faint); }
    .mt-cal-head { display: grid; grid-template-columns: repeat(7, 1fr); background: var(--propia-bg-table-head); border-bottom: 1px solid var(--propia-border-divider); }
    .mt-cal-dow { padding: 8px 10px; font-size: 10px; font-weight: 800; letter-spacing: .4px; color: var(--propia-text-faint); }
    .mt-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: var(--propia-border-divider); }
    .mt-cal-cell { background: var(--propia-bg-card); min-height: 92px; padding: 6px 7px; display: flex; flex-direction: column; gap: 3px; }
    .mt-cal-cell--off { background: #FBFCFE; }
    .mt-cal-cell--off .mt-cal-daynum { color: var(--propia-text-faint); }
    .mt-cal-cell--hoy { background: #F6F3FE; }
    .mt-cal-daynum { font-size: 11.5px; font-weight: 700; color: var(--propia-text-secondary); }
    .mt-cal-cell--hoy .mt-cal-daynum { color: var(--propia-brand, var(--propia-brand)); }
    .mt-cal-ev { font-size: 10.5px; font-weight: 700; color: #1D4ED8; background: #EFF6FF; border-radius: 5px; padding: 2px 6px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mt-cal-ev:hover { filter: brightness(.96); }
    .mt-cal-ev--ok { color: #15703F; background: var(--propia-ok-soft); }
    .mt-cal-ev--err { color: #B91C1C; background: #FEE2E2; }
    .mt-cal-ev--plan { color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft); }
    .mt-cal-more { font-size: 10px; font-weight: 700; color: var(--propia-text-muted); padding: 1px 4px; }
    /* === Celdas propias de la tabla de Planes preventivos (reusa .mtp-* de la tabla de Programacion) === */
    .mtp-tag { font-size: 10px; font-weight: 700; color: var(--propia-text-faint); background: var(--propia-bg-app); border-radius: 6px; padding: 1px 6px; margin-left: 4px; }
    .mtp-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; background: var(--propia-text-faint); margin-right: 5px; vertical-align: middle; }
    .mtp-dot.mt-sem-verde { background: var(--propia-ok); }
    .mtp-dot.mt-sem-amarillo { background: var(--propia-warn); }
    .mtp-dot.mt-sem-rojo { background: var(--propia-danger); }
    .mtp-dot.mt-sem-negro { background: var(--propia-text-faint); }
    .mtp-muted { color: var(--propia-text-faint); }
    /* Edicion inline de celda existente (violeta = edicion activa; canon regla 9-B). */
    .mtp-cell-inp { width: 100%; box-sizing: border-box; border: 1px solid var(--propia-border-input); border-radius: 6px; padding: 4px 7px; font-size: 12.5px; color: var(--propia-text-body); background: var(--propia-bg-card); outline: none; font-family: inherit; }
    .mtp-cell-inp:focus { border-color: var(--propia-brand); box-shadow: 0 0 0 2px rgba(109,79,227,.12); }
    .mtp-cell-inp:disabled { opacity: .55; }
    .mtp-cell-inp.is-busy { opacity: .5; }
    .mtp-estado-btn { border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-secondary); border-radius: 7px; font-size: 11.5px; font-weight: 700; padding: 5px 10px; cursor: pointer; font-family: inherit; }
    .mtp-estado-btn:hover { border-color: var(--propia-brand); color: var(--propia-brand); }
    .mtp-estado-btn.on { border-color: var(--propia-ok); color: var(--propia-ok); }
    .mtp-nf-chk { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--propia-text-secondary); cursor: pointer; }
    /* Fila recien creada (canon regla 10-E): verde + marca en la 1a celda hasta el proximo refresco. */
    .mtp-row--nuevo { background: var(--propia-ok-soft); box-shadow: inset 3px 0 0 var(--propia-ok); }

    /* === Tabla de PROGRAMACIONES (patron vista-tabla; canon Tareas/Zonas) === */
    /* Botones de la barra (Agrupar / Campos): mismo aspecto que el resto de modulos. */
    .mtp-menuwrap { position: relative; }
    .mtp-fbtn { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 8px 12px; border-radius: 9px; border: 1px solid var(--propia-border-input); background: var(--propia-bg-card); font-size: 13px; font-weight: 600; color: var(--propia-text-secondary); cursor: pointer; font-family: inherit; }
    .mtp-fbtn:hover { border-color: var(--propia-brand); color: var(--propia-brand); }
    .mtp-fbtn.on { background: var(--propia-brand-soft); color: var(--propia-brand); border-color: var(--propia-brand-soft); }
    .mtp-menu-bd { position: fixed; inset: 0; z-index: 40; }
