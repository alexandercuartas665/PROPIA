    private IEnumerable<ProgramacionTareaDto> ProgFiltradas()
    {
        var q = (_progs ?? new()).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_progQuery))
        {
            var t = _progQuery.Trim();
            q = q.Where(p => (p.Titulo ?? "").Contains(t, StringComparison.OrdinalIgnoreCase)
                          || (p.OrigenReferencia ?? "").Contains(t, StringComparison.OrdinalIgnoreCase));
        }
        var res = q.Where(p => _fdProg?.Pasa(campo => campo switch
        {
            "activo" => p.OrigenReferencia ?? "",
            "titulo" => p.Titulo ?? "",
            "tablero" => p.TableroNombre ?? "",
            "prioridad" => p.Prioridad.ToString(),
            "periodicidad" => p.Periodicidad.ToString(),
            "activa" => p.Activa.ToString().ToLower(),
            _ when CampoCustomProg(campo) is { } cd => ValorCampoProg(p.Id, cd.Id) ?? "",
            _ => ""
        }) ?? true);
        return OrdenarProg(res);
    }

    // ===== Ordenar (boton "Ordenar" canon = Unidades/Equipos; TablaOrdenarMenu, multi-criterio) =====
    private List<TablaOrdenarMenu.Sort> _sortsProg = new();
    private void OnSortsProgChanged() { _progPagina = 1; StateHasChanged(); }
    private List<TablaOrdenarMenu.Col> ColsOrdenablesProg()
        => ProgColsVis.Select(c => new TablaOrdenarMenu.Col(c.Key, c.Label)).ToList();
    private IComparable ValorOrdenProg(ProgramacionTareaDto p, string key) => key switch
    {
        "tipo" => p.ModuloOrigenCodigo ?? "",
        "activo" => p.OrigenReferencia ?? "",
        "titulo" => p.Titulo ?? "",
        "tercero" => p.ProveedorNombre ?? NombreTercero(p.ProveedorId),
        "contrato" => NombreContrato(p.ContratoId),
        "costo" => p.CostoEstimado ?? 0m,
        "tablero" => p.TableroNombre ?? "",
        "prioridad" => (int)p.Prioridad,
        "periodicidad" => (int)p.Periodicidad,
        "proxima" => p.FechaProximaEjecucion,
        "responsables" => p.Responsables.Count,
        "activa" => p.Activa ? 1 : 0,
        _ when CampoCustomProg(key) is { } cd => ValorCampoProg(p.Id, cd.Id) ?? "",
        _ => ""
    };
    private IEnumerable<ProgramacionTareaDto> OrdenarProg(IEnumerable<ProgramacionTareaDto> src)
    {
        if (_sortsProg.Count == 0) return src;
        IOrderedEnumerable<ProgramacionTareaDto>? o = null;
        foreach (var s in _sortsProg)
        {
            Func<ProgramacionTareaDto, IComparable> sel = p => ValorOrdenProg(p, s.Key);
            o = o is null ? (s.Dir >= 0 ? src.OrderBy(sel) : src.OrderByDescending(sel))
                          : (s.Dir >= 0 ? o.ThenBy(sel) : o.ThenByDescending(sel));
        }
        return o!;
    }

    private IEnumerable<IGrouping<string, ProgramacionTareaDto>> ProgAgrupadas()
    {
        Func<ProgramacionTareaDto, string> key;
        if (CampoCustomProg(_progAgrupar) is { } cdAgr)
            key = p => { var v = ValorCampoProg(p.Id, cdAgr.Id); return string.IsNullOrWhiteSpace(v) ? "(vacio)" : v!; };
        else key = _progAgrupar switch
        {
            "activo" => p => string.IsNullOrWhiteSpace(p.OrigenReferencia) ? "(sin activo)" : p.OrigenReferencia!,
            "tablero" => p => string.IsNullOrWhiteSpace(p.TableroNombre) ? "General" : p.TableroNombre!,
            "periodicidad" => p => p.Tipo == TipoProgramacion.Cron ? "Cron" : PeriodicidadProgLabel(p.Periodicidad),
            "prioridad" => p => p.Prioridad.ToString(),
            _ => _ => ""
        };
        return ProgFiltradas().GroupBy(key);
    }

