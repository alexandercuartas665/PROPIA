    private const string PlanGrid = "grid-template-columns: 38px minmax(190px,1.6fr) minmax(150px,1.4fr) 150px minmax(150px,1.2fr) 130px minmax(110px,1fr) 116px 96px; gap: 10px; align-items: center;";
