        font-size: 13.5px; font-weight: 700; cursor: pointer; font-family: inherit;
        box-shadow: 0 6px 16px rgba(109,79,227,.32);
    }
    .mt-btn-brand:hover { background: var(--propia-brand-hover, #5838C9); }

    .mt-empty { background: #F8FAFC; border: 1px dashed #D7E0EA; border-radius: 12px; padding: 30px; text-align: center; color: #A6B7C8; }

    .mt-kpis { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; margin-bottom: 16px; }
    .mt-kpi { background: #fff; border: 1px solid #E1E8EE; border-radius: 11px; padding: 11px 13px; }
    .mt-kpi-val { font-size: 22px; font-weight: 800; color: #1B2A3A; letter-spacing: -0.3px; }
    .mt-kpi-lbl { font-size: 10.5px; color: #A6B7C8; font-weight: 600; margin-top: 1px; }
    .mt-kpi--verde .mt-kpi-val { color: #15703F; }
    .mt-kpi--amarillo .mt-kpi-val { color: #B45309; }
    .mt-kpi--rojo .mt-kpi-val { color: #DC2626; }
    .mt-kpi--rojo { background: #FEF2F2; border-color: #FECACA; }

    .mt-tabs { display: flex; gap: 6px; margin-bottom: 16px; border-bottom: 1px solid #EEF3F8; padding-bottom: 0; }
    .mt-tab {
        padding: 9px 16px; border: 0; border-bottom: 2px solid transparent;
        background: transparent; font-size: 13.5px; font-weight: 700; color: #7C98B6;
        cursor: pointer; font-family: inherit; transition: color .15s, border-color .15s;
    }
    .mt-tab:hover { color: #1B2A3A; }
    .mt-tab--on { color: var(--propia-brand, #6D4FE3); border-bottom-color: var(--propia-brand, #6D4FE3); }

    [data-bs-theme="dark"] .mt-title { color: #E5E7EB; }
    [data-bs-theme="dark"] .mt-kpi { background: #232B40; border-color: #2D3650; }
    [data-bs-theme="dark"] .mt-kpi-val { color: #E5E7EB; }

    .kpi-mini { border-radius: 12px; border: 1px solid #e6e6ee; }
    .semaforo-verde { border-left: 4px solid #22c55e; }
    .semaforo-amarillo { border-left: 4px solid #f59e0b; }
    .semaforo-rojo { border-left: 4px solid #ef4444; }
    .semaforo-negro { border-left: 4px solid #6b7280; }
    /* === Tarjetas de activos al estilo Zonas Comunes (icono con color del semaforo) === */
    .mt-acards { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 10px; }
    .mt-acard { display: flex; align-items: center; gap: 11px; padding: 12px 14px; border: 1px solid #E1E8EE; border-radius: 12px; background: #fff; }
    .mt-acard-ic { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .mt-sem-verde { background: #E6F6EE; color: #15703F; }
    .mt-sem-amarillo { background: #FEF3C7; color: #B45309; }
    .mt-sem-rojo { background: #FEE2E2; color: #B91C1C; }
    .mt-sem-negro { background: #EEF3F8; color: #516F90; }
    .mt-acard-id { flex: 1; min-width: 0; }
    .mt-acard-nom { font-size: 13.5px; font-weight: 700; color: #1B2A3A; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mt-acard-meta { font-size: 11px; color: #A6B7C8; }
    .mt-acard-plan { font-size: 11.5px; color: #516F90; margin-top: 3px; }
    .mt-acard-plan--off { color: #A6B7C8; font-style: italic; }
    .mt-acard-venc { color: #B91C1C; font-weight: 700; }
    .mt-acard-prox { color: #B45309; font-weight: 700; }
    .mt-acard-chip { flex: 0 0 auto; font-size: 10.5px; font-weight: 700; color: var(--propia-brand, #6D4FE3); background: #F1ECFD; border-radius: 7px; padding: 4px 9px; white-space: nowrap; }
    @@media (max-width: 640px) { .mt-acards { grid-template-columns: 1fr; } }

    /* === Calendario de programaciones (mismo patron visual del calendario de PQRSD) === */
    .mt-cal { border: 1px solid #E1E8EE; border-radius: 14px; overflow: hidden; background: #fff; margin-bottom: 30px; }
    .mt-cal-bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid #EEF3F8; }
    .mt-cal-nav { font-size: 18px; border: 1px solid #E1E8EE; border-radius: 8px; width: 30px; height: 30px; background: #fff; color: #516F90; cursor: pointer; }
    .mt-cal-title { font-size: 15px; font-weight: 800; color: #1B2A3A; min-width: 150px; text-align: center; }
    .mt-cal-hoy { padding: 6px 12px; border: 1px solid #E1E8EE; border-radius: 8px; background: #fff; color: #516F90; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .mt-cal-hint { margin-left: auto; font-size: 11.5px; color: #A6B7C8; }
    .mt-cal-head { display: grid; grid-template-columns: repeat(7, 1fr); background: #FAFBFC; border-bottom: 1px solid #EEF3F8; }
    .mt-cal-dow { padding: 8px 10px; font-size: 10px; font-weight: 800; letter-spacing: .4px; color: #A6B7C8; }
    .mt-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: #EEF3F8; }
    .mt-cal-cell { background: #fff; min-height: 92px; padding: 6px 7px; display: flex; flex-direction: column; gap: 3px; }
    .mt-cal-cell--off { background: #FBFCFE; }
    .mt-cal-cell--off .mt-cal-daynum { color: #C3D0DD; }
    .mt-cal-cell--hoy { background: #F6F3FE; }
    .mt-cal-daynum { font-size: 11.5px; font-weight: 700; color: #516F90; }
    .mt-cal-cell--hoy .mt-cal-daynum { color: var(--propia-brand, #6D4FE3); }
    .mt-cal-ev { font-size: 10.5px; font-weight: 700; color: #1D4ED8; background: #EFF6FF; border-radius: 5px; padding: 2px 6px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mt-cal-ev:hover { filter: brightness(.96); }
    .mt-cal-ev--ok { color: #15703F; background: #E6F6EE; }
    .mt-cal-ev--err { color: #B91C1C; background: #FEE2E2; }
    .mt-cal-ev--plan { color: var(--propia-brand, #6D4FE3); background: #F1ECFD; }
    .mt-cal-more { font-size: 10px; font-weight: 700; color: #7C98B6; padding: 1px 4px; }
    /* === Movil (hasta 640px): colapsar la fila de 8 KPIs === */
    @@media (max-width: 640px) {
        .mt-kpis { grid-template-columns: repeat(2, 1fr); }
    }
</style>

@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";
    private string _tab = "activos";

    private List<ActivoPanelDto>? _activos;
    private List<IntervencionListaDto>? _intervenciones;
    private List<PlanDto>? _planes;
    private ResumenMantenimientoDto? _resumen;
    private IntervencionDetalleDto? _fichaIntervencion;

    private string _query = "";
    // Filtro dinamico unico del tab Activos (componente compartido, patron Tareas).
    private FiltroDinamico? _fdAct;

    private List<FiltroDinamico.CampoDef> CamposFiltroActivos => new()
    {
        new() { Key = "nombre", Label = "Nombre", Kind = "texto" },
        new() { Key = "tipo", Label = "Tipo", Kind = "sel",
                Opciones = new() { ("Equipo", "Equipo"), ("ZonaComun", "Zona comun") } },
        new() { Key = "semaforo", Label = "Semaforo", Kind = "sel",
                Opciones = new() { ("Verde", "Verde - al dia"), ("Amarillo", "Amarillo - proximo"), ("Rojo", "Rojo - vencido"), ("Negro", "Negro - sin plan") } },
        new() { Key = "categoria", Label = "Categoria", Kind = "texto" },
        new() { Key = "abiertas", Label = "Interv. abiertas", Kind = "num" },
    };

    private IEnumerable<ActivoPanelDto> ActivosFiltrados() =>
        (_activos ?? new()).Where(a => _fdAct?.Pasa(campo => campo switch
        {
            "nombre" => a.Nombre,
            "tipo" => a.ActivoTipo.ToString(),
            "semaforo" => a.Semaforo.ToString(),
            "categoria" => a.Categoria ?? "",
            "abiertas" => a.IntervencionesAbiertas.ToString(),
            _ => ""
        }) ?? true);

    private bool _showCrearIntervencion;
    private string _crearTipo = "Correctivo";
    private string _crearActivoTipo = "Equipo";
    private string _crearActivoId = "";
    private string? _crearTitulo;
    private string? _crearDescripcion;
    private PrioridadIntervencion _crearPrioridad = PrioridadIntervencion.Normal;
    private DateOnly? _crearFecha;
    private bool _crearNotificarResidentes;

    private bool _showCrearPlan;
    private string _planActivoTipo = "Equipo";
    private string _planActivoId = "";
    private string? _planNombre;
    private FrecuenciaMantenimiento _planFrecuencia = FrecuenciaMantenimiento.Mensual;
    private int? _planFrecuenciaDias;
    private DateOnly? _planFechaInicio;
    private string _planDisparo = "ConConfirmacion";
    private int _planDiasAlerta = 7;
    private bool _planNotificarResidentes;

    private bool _mostrarCerrar;
    private bool _mostrarCancelar;
    private DateOnly? _cerrarFecha = DateOnly.FromDateTime(DateTime.UtcNow);
    private string? _cerrarNota;
    private bool _cerrarCambiaEstado;
    private string _cerrarEstadoNuevo = "";
    private string? _cancelarMotivo;
    private string? _nuevaEntrada;
    private TipoAutorBitacoraMantenimiento _nuevaEntradaTipo = TipoAutorBitacoraMantenimiento.Administrador;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task SwitchTab(string tab)
    {
        _tab = tab;
        await CargarAsync();
    }

    // ---------- Calendario de programaciones (estilo Reservas/PQRSD) ----------
    private int _mtCalYear; private int _mtCalMonth; private bool _mtCalInit;
    private void MtCalEnsure() { if (!_mtCalInit) { var t = DateTime.Today; _mtCalYear = t.Year; _mtCalMonth = t.Month; _mtCalInit = true; } }
    private string MtCalTitulo { get { MtCalEnsure(); var s = new DateTime(_mtCalYear, _mtCalMonth, 1).ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-CO")); return char.ToUpper(s[0]) + s.Substring(1); } }
    private void MtCalMover(int d) { MtCalEnsure(); var nf = new DateTime(_mtCalYear, _mtCalMonth, 1).AddMonths(d); _mtCalYear = nf.Year; _mtCalMonth = nf.Month; }
    private void MtCalHoy() { var t = DateTime.Today; _mtCalYear = t.Year; _mtCalMonth = t.Month; _mtCalInit = true; }

    private sealed record MtCalItem(Guid? IntervencionId, string Texto, string Clase, string Titulo);
    private sealed record MtCalCelda(int Dia, bool EsMes, bool EsHoy, List<MtCalItem> Items);

    private List<MtCalCelda> MtCalCeldas()
    {
        MtCalEnsure();
        var primero = new DateTime(_mtCalYear, _mtCalMonth, 1);
        int offset = ((int)primero.DayOfWeek + 6) % 7; // la semana inicia el lunes
        var inicio = primero.AddDays(-offset);
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        // Intervenciones con fecha programada (excluye canceladas) + planes activos por proxima ejecucion.
        var porDia = new Dictionary<DateOnly, List<MtCalItem>>();
        void Add(DateOnly f, MtCalItem it) { if (!porDia.TryGetValue(f, out var l)) porDia[f] = l = new(); l.Add(it); }

        foreach (var it in (_intervenciones ?? new()).Where(x => x.FechaProgramada is not null && x.Estado != EstadoIntervencion.Cancelada))
        {
            var clase = it.Estado == EstadoIntervencion.Completada ? "mt-cal-ev--ok"
                      : it.Vencida ? "mt-cal-ev--err" : "";
            Add(it.FechaProgramada!.Value, new MtCalItem(it.Id, $"{it.Codigo} {it.ActivoNombre}", clase,
                $"{it.Codigo} - {it.Titulo} ({it.ActivoNombre}) - {it.Estado}"));
        }
        foreach (var p in (_planes ?? new()).Where(x => x.Activo))
        {
            var clase = p.ProximaEjecucion < hoy ? "mt-cal-ev--err" : "mt-cal-ev--plan";
            Add(p.ProximaEjecucion, new MtCalItem(null, $"Plan: {p.Nombre}", clase,
                $"Plan preventivo - {p.Nombre} ({p.ActivoNombre}) - {p.Frecuencia}"));
        }

        var res = new List<MtCalCelda>(42);
        for (int i = 0; i < 42; i++)
        {
            var f = inicio.AddDays(i);
            var fd = DateOnly.FromDateTime(f);
            res.Add(new MtCalCelda(f.Day, f.Month == _mtCalMonth, fd == hoy,
                porDia.GetValueOrDefault(fd, new List<MtCalItem>())));
        }
        return res;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _resumen = await http.GetFromJsonAsync<ResumenMantenimientoDto>("/api/mantenimiento/resumen");

            // Tipo/semaforo se filtran client-side (FiltroDinamico); al server solo va la busqueda.
            var activosUrl = "/api/mantenimiento/activos";
            if (!string.IsNullOrEmpty(_query)) activosUrl += $"?q={Uri.EscapeDataString(_query)}";
            _activos = await http.GetFromJsonAsync<List<ActivoPanelDto>>(activosUrl) ?? new();

            // El calendario combina intervenciones (fecha programada) y planes (proxima ejecucion).
            if (_tab is "intervenciones" or "calendario")
                _intervenciones = await http.GetFromJsonAsync<List<IntervencionListaDto>>("/api/mantenimiento/intervenciones") ?? new();
            if (_tab is "planes" or "calendario")
                _planes = await http.GetFromJsonAsync<List<PlanDto>>("/api/mantenimiento/planes") ?? new();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task MostrarFicha(Guid id)
    {
        try
        {
            _fichaIntervencion = await Auth().GetFromJsonAsync<IntervencionDetalleDto>($"/api/mantenimiento/intervenciones/{id}");
            _mostrarCerrar = _mostrarCancelar = false;
            _cerrarFecha = DateOnly.FromDateTime(DateTime.UtcNow);
            _cerrarNota = _cancelarMotivo = _nuevaEntrada = null;
            _cerrarCambiaEstado = false;
            _cerrarEstadoNuevo = "";
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private void CerrarCrearIntervencion()
    {
        _showCrearIntervencion = false;
        _crearTitulo = _crearDescripcion = null;
        _crearActivoId = "";
        _crearFecha = null;
        _crearPrioridad = PrioridadIntervencion.Normal;
        _crearNotificarResidentes = false;
    }

    private async Task ConfirmarCrearIntervencion()
    {
        _busy = true; _msg = null;
        try
        {
            if (!Guid.TryParse(_crearActivoId, out var activoId)) return;
            var req = new CrearIntervencionRequest(
                Enum.Parse<TipoIntervencionMantenimiento>(_crearTipo),
                Enum.Parse<TipoActivoMantenimiento>(_crearActivoTipo),
                activoId, null,
                OrigenIntervencion.Manual, null,
                _crearTitulo!, _crearDescripcion,
                _crearPrioridad, null, null,
                _crearFecha, _crearNotificarResidentes);
            var resp = await Auth().PostAsJsonAsync("/api/mantenimiento/intervenciones", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Intervencion creada con tarea vinculada."; _msgClass = "alert-success";
            CerrarCrearIntervencion();
            _tab = "intervenciones";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private void CerrarCrearPlan()
    {
        _showCrearPlan = false;
        _planNombre = null;
        _planActivoId = "";
        _planFechaInicio = null;
        _planFrecuencia = FrecuenciaMantenimiento.Mensual;
        _planFrecuenciaDias = null;
        _planDisparo = "ConConfirmacion";
        _planDiasAlerta = 7;
        _planNotificarResidentes = false;
    }

    private async Task ConfirmarCrearPlan()
    {
        _busy = true; _msg = null;
        try
        {
            if (!Guid.TryParse(_planActivoId, out var activoId)) return;
            if (_planFechaInicio is null) return;
            var req = new CrearPlanRequest(
                Enum.Parse<TipoActivoMantenimiento>(_planActivoTipo),
                activoId,
                _planNombre!, null,
                _planFrecuencia, _planFrecuenciaDias,
                _planFechaInicio.Value, null,
                Enum.Parse<DisparoPlanMantenimiento>(_planDisparo),
                _planDiasAlerta, _planNotificarResidentes);
            var resp = await Auth().PostAsJsonAsync("/api/mantenimiento/planes", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Plan preventivo creado."; _msgClass = "alert-success";
            CerrarCrearPlan();
            _tab = "planes";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task DesactivarPlan(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mantenimiento/planes/{id}");
        if (resp.IsSuccessStatusCode) { _msg = "Plan desactivado."; _msgClass = "alert-success"; await CargarAsync(); }
    }

    private async Task ReactivarPlan(Guid id)
    {
        var resp = await Auth().PostAsync($"/api/mantenimiento/planes/{id}/reactivar", null);
        if (resp.IsSuccessStatusCode) { _msg = "Plan reactivado."; _msgClass = "alert-success"; await CargarAsync(); }
    }

    private async Task CambiarEstado(Guid id, EstadoIntervencion nuevo)
    {
        var req = new CambiarEstadoIntervencionRequest(nuevo, null, null);
        var resp = await Auth().PostAsJsonAsync($"/api/mantenimiento/intervenciones/{id}/estado", req);
        if (resp.IsSuccessStatusCode) { await MostrarFicha(id); await CargarAsync(); }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    private async Task ConfirmarCerrar(Guid id)
    {
        _busy = true;
        try
        {
            var req = new CerrarIntervencionRequest(
                _cerrarFecha!.Value, _cerrarNota!,
                _cerrarCambiaEstado, _cerrarCambiaEstado ? _cerrarEstadoNuevo : null,
                false, null);
            var resp = await Auth().PostAsJsonAsync($"/api/mantenimiento/intervenciones/{id}/cerrar", req);
            if (resp.IsSuccessStatusCode) { _mostrarCerrar = false; await MostrarFicha(id); await CargarAsync(); }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _busy = false; }
    }

    private async Task ConfirmarCancelar(Guid id)
    {
        _busy = true;
        try
        {
            var req = new CancelarIntervencionRequest(_cancelarMotivo!);
            var resp = await Auth().PostAsJsonAsync($"/api/mantenimiento/intervenciones/{id}/cancelar", req);
            if (resp.IsSuccessStatusCode) { _mostrarCancelar = false; await MostrarFicha(id); await CargarAsync(); }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _busy = false; }
    }

    private async Task AgregarEntrada()
    {
        if (_fichaIntervencion is null || string.IsNullOrWhiteSpace(_nuevaEntrada)) return;
        _busy = true;
        try
        {
            var req = new AgregarBitacoraRequest(_nuevaEntrada!, _nuevaEntradaTipo);
            var resp = await Auth().PostAsJsonAsync($"/api/mantenimiento/intervenciones/{_fichaIntervencion.Id}/bitacora", req);
            if (resp.IsSuccessStatusCode)
            {
                _nuevaEntrada = null;
                await MostrarFicha(_fichaIntervencion.Id);
            }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _busy = false; }
    }

