    // Alta inline directa (sin modal): crea la programacion con lo capturado por columna.
    private async Task AltaProgInlineAsync()
    {
        if (string.IsNullOrEmpty(_altaActivoId) || !Guid.TryParse(_altaActivoId, out var activoId)) { _msg = "Elige un activo o zona."; _msgClass = "alert-danger"; return; }
        if (string.IsNullOrWhiteSpace(_altaTitulo)) { _msg = "La programacion necesita un titulo."; _msgClass = "alert-danger"; return; }
        if (_altaFecha is null) { _msg = "Indica la fecha de la proxima ejecucion."; _msgClass = "alert-danger"; return; }
        var tipo = Enum.Parse<TipoActivoMantenimiento>(_altaTipo);
        var modulo = tipo == TipoActivoMantenimiento.ZonaComun ? "zona" : "equipo";
        var referencia = _activos?.FirstOrDefault(a => a.ActivoTipo == tipo && a.ActivoId == activoId)?.Nombre;
        Guid? tableroId = Guid.TryParse(_altaTableroKey, out var tid) ? tid : null;
        Guid? contratoId = Guid.TryParse(_altaContratoKey, out var ct) ? ct : null;
        _busy = true; _msg = null;
        try
        {
            var req = new CrearProgramacionRequest(
                _altaTitulo!, null, _altaPrioridad, tableroId, _altaPeriodicidad,
                _altaFecha.Value, null, null, modulo, activoId, referencia,
                ProveedorId: _altaProveedorId, ContratoId: contratoId, ProveedorNombre: _altaProveedorNombre,
                CostoEstimado: _altaCosto);
            var r = await Auth().PostAsJsonAsync("/api/programaciones", req);
            if (!r.IsSuccessStatusCode) { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            // Campos propios (EAV) de la fila de alta: se guardan sobre la programacion recien creada.
            if (_nuCamposProg.Any(x => !string.IsNullOrWhiteSpace(x.Value)))
            {
                try
                {
                    var creada = await r.Content.ReadFromJsonAsync<ProgramacionTareaDto>();
                    if (creada is not null)
                        foreach (var kv in _nuCamposProg.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                        {
                            var cd = _camposDefProg.FirstOrDefault(d => d.Id == kv.Key);
                            if (cd is not null) await GuardarCampoValorProg(creada.Id, cd, kv.Value);
                        }
                }
                catch { }
            }
            _nuCamposProg.Clear();
            _msg = "Programacion creada."; _msgClass = "alert-success";
            // Limpiar activo/titulo/tercero/contrato/costo; se conservan tipo/prioridad/periodicidad/fecha para altas seguidas.
            _altaTitulo = ""; _altaActivoId = ""; _altaTableroKey = ""; _altaContratoKey = ""; _altaCosto = null;
            _altaProveedorSel = null; _altaProveedorId = null; _altaProveedorNombre = null;
            _altaProgAbierta = false;   // canon: la fila se cierra al guardar (vuelve al CTA "Agregar programacion").
            await CargarAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _busy = false; }
    }

