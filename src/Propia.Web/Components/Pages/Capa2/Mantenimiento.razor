    // ---------- Calendario de programaciones (vista Mes / Semana) ----------
    private string _calVista = "mes";                 // "mes" | "semana"
    private DateTime _calAnchor = AnclaLocalMt();      // fecha de referencia de la vista

    private string MtCalTitulo
    {
        get
        {
            var cul = new System.Globalization.CultureInfo("es-CO");
            if (_calVista == "semana")
            {
                var (ini, fin) = SemanaRango(_calAnchor);
                return $"{ini:dd MMM} - {fin:dd MMM yyyy}".ToLower(cul);
            }
            var s = new DateTime(_calAnchor.Year, _calAnchor.Month, 1).ToString("MMMM yyyy", cul);
            return char.ToUpper(s[0]) + s.Substring(1);
        }
    }

    private void MtCalMover(int d) => _calAnchor = _calVista == "semana" ? _calAnchor.AddDays(7 * d) : _calAnchor.AddMonths(d);
    private void MtCalHoy() => _calAnchor = AnclaLocalMt();

    // El lunes de la semana que contiene 'd', y el domingo.
    private static (DateTime ini, DateTime fin) SemanaRango(DateTime d)
    {
        int off = ((int)d.DayOfWeek + 6) % 7; // lunes = inicio
        var ini = d.Date.AddDays(-off);
        return (ini, ini.AddDays(6));
    }

    private sealed record MtCalItem(Guid ProgId, string Texto, string Clase, string Titulo, DateOnly Fecha);
    private sealed record MtCalCelda(int Dia, bool EsMes, bool EsHoy, List<MtCalItem> Items);

    // Avanza una fecha un paso segun la periodicidad (para proyectar recurrencias en la vista).
    private static DateOnly PasoPeriodicidad(DateOnly f, PeriodicidadProgramacion p) => p switch
    {
        PeriodicidadProgramacion.Diaria => f.AddDays(1),
        PeriodicidadProgramacion.Semanal => f.AddDays(7),
        PeriodicidadProgramacion.Quincenal => f.AddDays(15),
        PeriodicidadProgramacion.Mensual => f.AddMonths(1),
        PeriodicidadProgramacion.Bimestral => f.AddMonths(2),
        PeriodicidadProgramacion.Trimestral => f.AddMonths(3),
        PeriodicidadProgramacion.Semestral => f.AddMonths(6),
        PeriodicidadProgramacion.Anual => f.AddYears(1),
        _ => DateOnly.MaxValue   // Unica: sin recurrencia
    };

    private List<MtCalCelda> MtCalCeldas()
    {
        // Ventana visible: 6 semanas (mes) o 1 semana (semana), empezando en lunes.
        DateTime inicio; int celdas;
        if (_calVista == "semana") { inicio = SemanaRango(_calAnchor).ini; celdas = 7; }
        else
        {
            var primero = new DateTime(_calAnchor.Year, _calAnchor.Month, 1);
            inicio = primero.AddDays(-(((int)primero.DayOfWeek + 6) % 7));
            celdas = 42;
        }
        var winIni = DateOnly.FromDateTime(inicio);
        var winFin = DateOnly.FromDateTime(inicio.AddDays(celdas - 1));
        var hoy = HoyLocalMt();

        var porDia = new Dictionary<DateOnly, List<MtCalItem>>();
        void Add(DateOnly f, MtCalItem it) { if (!porDia.TryGetValue(f, out var l)) porDia[f] = l = new(); l.Add(it); }

        foreach (var p in (_progs ?? new()).Where(x => x.Activa))
        {
            var clase = !p.Activa ? "" : (p.FechaProximaEjecucion < hoy ? "mt-cal-ev--err" : "mt-cal-ev--plan");
            var texto = string.IsNullOrWhiteSpace(p.OrigenReferencia) ? p.Titulo : $"{p.OrigenReferencia}: {p.Titulo}";
            var titulo = $"{p.Titulo} ({p.OrigenReferencia}) - {PeriodicidadProgLabel(p.Periodicidad)}";
            // Proyecta ocurrencias desde la proxima ejecucion hasta el fin de la ventana (o FechaFin).
            var f = p.FechaProximaEjecucion;
            int guard = 0;
            while (f <= winFin && guard++ < 400)
            {
                if (p.FechaFin is { } ff && f > ff) break;
                if (f >= winIni) Add(f, new MtCalItem(p.Id, texto, clase, titulo, f));
                var next = PasoPeriodicidad(f, p.Periodicidad);
                if (next == DateOnly.MaxValue || next <= f) break; // Unica o sin avance
                f = next;
            }
        }

        var res = new List<MtCalCelda>(celdas);
        for (int i = 0; i < celdas; i++)
        {
            var f = inicio.AddDays(i);
            var fd = DateOnly.FromDateTime(f);
            var esMes = _calVista == "semana" || f.Month == _calAnchor.Month;
            res.Add(new MtCalCelda(f.Day, esMes, fd == hoy, porDia.GetValueOrDefault(fd, new List<MtCalItem>())));
        }
        return res;
    }

