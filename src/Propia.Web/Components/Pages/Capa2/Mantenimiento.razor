    // Nota: el borrado por fila (cesto .mtp-del + EliminarProgAsync) se retiro del canon de Programaciones;
    // el unico camino de borrado es la barra de seleccion multiple (EliminarProgSeleccionadasAsync).

    // ===== Seleccion multiple + accion masiva de Programaciones (canon): Eliminar =====
    private readonly HashSet<Guid> _selProg = new();
    private bool _selProgBusy;
    private void ToggleSelProg(Guid id, bool on) { if (on) _selProg.Add(id); else _selProg.Remove(id); }
    private bool TodasProgSel
    {
        get { var ids = ProgFiltradas().Select(p => p.Id).ToList(); return ids.Count > 0 && ids.All(_selProg.Contains); }
    }
    private void ToggleSelAllProg(ChangeEventArgs e)
    {
        _selProg.Clear();
        if ((bool)(e.Value ?? false)) foreach (var p in ProgFiltradas()) _selProg.Add(p.Id);
    }
    private async Task EliminarProgSeleccionadasAsync()
    {
        if (_selProg.Count == 0) return;
        var n = _selProg.Count;
        var ok = await Modals.ConfirmAsync(
            $"Eliminar {n} programacion(es) seleccionada(s)? Las tareas ya generadas se conservan. Esta accion no se puede deshacer.",
            "Eliminar programaciones");
        if (!ok) return;
        _selProgBusy = true;
        int done = 0, fail = 0;
        foreach (var id in _selProg.ToList())
        {
            try { var r = await Auth().DeleteAsync($"/api/programaciones/{id}"); if (r.IsSuccessStatusCode) done++; else fail++; }
            catch { fail++; }
        }
        _selProg.Clear(); _selProgBusy = false;
        _msg = fail == 0 ? $"{done} programacion(es) eliminada(s)." : $"{done} eliminada(s), {fail} con error.";
        _msgClass = fail == 0 ? "alert-success" : "alert-danger";
        await CargarAsync();
        StateHasChanged();
    }

