@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private string? _msg;
    private string _msgClass = "alert-info";
    private string _tab = "prog";

    // ===== Programaciones en tabla (patron vista-tabla; una fila por PROGRAMACION) =====
    private List<ProgramacionTareaDto>? _progs;
    private List<TableroOpcion> _tableros = new();
    private List<PersonaOpcion> _personas = new();
    private bool _progOpcionesCargadas;
    private FiltroDinamico? _fdProg;
    private string _progQuery = "";
    private string _progAgrupar = "";
    private string _progMenu = "";
    private string _altaActivoKey = "";
    private readonly HashSet<string> _progColsOcultas = new();

    private sealed record ProgCol(string Key, string Label);
    private static readonly List<ProgCol> _progColsAll = new()
    {
        new("activo", "Activo"), new("titulo", "Titulo"), new("tablero", "Tablero"),
        new("prioridad", "Prioridad"), new("periodicidad", "Periodicidad"),
        new("proxima", "Proxima ejecucion"), new("responsables", "Responsables"), new("activa", "Activa"),
    };
    private IEnumerable<ProgCol> ProgColsVis => _progColsAll.Where(c => !_progColsOcultas.Contains(c.Key));

    private string ProgGrid
    {
        get
        {
            var cols = new List<string> { "34px" };
            foreach (var c in ProgColsVis)
            {
                cols.Add(c.Key switch
                {
                    "activo" => "minmax(150px,1.4fr)",
                    "titulo" => "minmax(180px,1.6fr)",
                    "tablero" => "minmax(110px,1fr)",
                    "prioridad" => "minmax(90px,.8fr)",
                    "periodicidad" => "minmax(120px,1.1fr)",
                    "proxima" => "minmax(120px,1fr)",
                    "responsables" => "minmax(90px,.8fr)",
                    "activa" => "70px",
                    _ => "1fr"
                });
            }
            cols.Add("60px");
            return $"grid-template-columns: {string.Join(' ', cols)}; gap: 10px; align-items: center;";
        }
    }

    private List<FiltroDinamico.CampoDef> CamposFiltroProg => new()
    {
        new() { Key = "activo", Label = "Activo", Kind = "texto" },
        new() { Key = "titulo", Label = "Titulo", Kind = "texto" },
        new() { Key = "tablero", Label = "Tablero", Kind = "texto" },
        new() { Key = "prioridad", Label = "Prioridad", Kind = "sel",
                Opciones = Enum.GetValues<PrioridadTarea>().Select(p => (p.ToString(), p.ToString())).ToList() },
        new() { Key = "periodicidad", Label = "Periodicidad", Kind = "sel",
                Opciones = Enum.GetValues<PeriodicidadProgramacion>().Select(p => (p.ToString(), p.ToString())).ToList() },
        new() { Key = "activa", Label = "Activa", Kind = "sel",
                Opciones = new() { ("true", "Activa"), ("false", "Pausada") } },
    };

    private IEnumerable<ProgramacionTareaDto> ProgFiltradas()
    {
        var q = (_progs ?? new()).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_progQuery))
        {
            var t = _progQuery.Trim();
            q = q.Where(p => (p.Titulo ?? "").Contains(t, StringComparison.OrdinalIgnoreCase)
                          || (p.OrigenReferencia ?? "").Contains(t, StringComparison.OrdinalIgnoreCase));
        }
        return q.Where(p => _fdProg?.Pasa(campo => campo switch
        {
            "activo" => p.OrigenReferencia ?? "",
            "titulo" => p.Titulo ?? "",
            "tablero" => p.TableroNombre ?? "",
            "prioridad" => p.Prioridad.ToString(),
            "periodicidad" => p.Periodicidad.ToString(),
            "activa" => p.Activa.ToString().ToLower(),
            _ => ""
        }) ?? true);
    }

    private IEnumerable<IGrouping<string, ProgramacionTareaDto>> ProgAgrupadas()
    {
        Func<ProgramacionTareaDto, string> key = _progAgrupar switch
        {
            "activo" => p => string.IsNullOrWhiteSpace(p.OrigenReferencia) ? "(sin activo)" : p.OrigenReferencia!,
            "tablero" => p => string.IsNullOrWhiteSpace(p.TableroNombre) ? "General" : p.TableroNombre!,
            "periodicidad" => p => p.Tipo == TipoProgramacion.Cron ? "Cron" : PeriodicidadProgLabel(p.Periodicidad),
            "prioridad" => p => p.Prioridad.ToString(),
            _ => _ => ""
        };
        return ProgFiltradas().GroupBy(key);
    }

    private static string ProgAgruparLabel(string k) => k switch
    {
        "activo" => "Activo", "tablero" => "Tablero",
        "periodicidad" => "Periodicidad", "prioridad" => "Prioridad", _ => ""
    };
    private static string PeriodicidadProgLabel(PeriodicidadProgramacion p) => p.ToString();

    private void ToggleColProg(string key, bool visible)
    {
        if (visible) _progColsOcultas.Remove(key);
        else _progColsOcultas.Add(key);
    }

    // Tableros/personas solo se piden una vez y al abrir el primer modal (igual que ProgramacionesPanel).
    private async Task CargarOpcionesProgAsync()
    {
        if (_progOpcionesCargadas) return;
        try
        {
            var tabs = await Auth().GetFromJsonAsync<List<TableroApiMt>>("/api/tareas/tableros") ?? new();
            _tableros = tabs.Select(t => new TableroOpcion { Id = t.Id, Nombre = t.Nombre }).ToList();
        }
        catch { _tableros = new(); }
        try
        {
            var personas = await Auth().GetFromJsonAsync<List<PersonaApiMt>>("/api/directorio/personas") ?? new();
            _personas = personas
                .Select(p => new PersonaOpcion { Id = p.Id, Nombre = $"{p.Nombres} {p.Apellidos}".Trim() })
                .Where(p => !string.IsNullOrWhiteSpace(p.Nombre)).ToList();
        }
        catch { _personas = new(); }
        _progOpcionesCargadas = true;
    }

    // Alta inline: abre el modal completo "Programar tarea" ya apuntando al activo elegido.
    private async Task AltaProgAsync()
    {
        if (string.IsNullOrEmpty(_altaActivoKey)) return;
        var parts = _altaActivoKey.Split(':');
        if (parts.Length != 2 || !Guid.TryParse(parts[1], out var activoId)) return;
        var tipo = Enum.Parse<TipoActivoMantenimiento>(parts[0]);
        var modulo = tipo == TipoActivoMantenimiento.ZonaComun ? "zona" : "equipo";
        var referencia = _activos?.FirstOrDefault(a => a.ActivoTipo == tipo && a.ActivoId == activoId)?.Nombre;

        await CargarOpcionesProgAsync();
        var pars = new ModalParameters()
            .Set("Tableros", _tableros)
            .Set("Personas", _personas)
            .Set("PrefillTitulo", string.IsNullOrWhiteSpace(referencia) ? "Mantenimiento" : $"Mantenimiento {referencia}")
            .Set("ModuloOrigenCodigo", modulo)
            .Set("EntidadOrigenId", (Guid?)activoId)
            .Set("OrigenReferencia", referencia);
        var req = await Modals.OpenAsync<ProgramadorTareaModal, CrearProgramacionRequest>(pars, new ModalOptions { Width = "580px" });
        if (req is null) return;
        try
        {
            var r = await Auth().PostAsJsonAsync("/api/programaciones", req);
            if (r.IsSuccessStatusCode) { _msg = "Programacion creada."; _msgClass = "alert-success"; _altaActivoKey = ""; await CargarAsync(); }
            else { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    // Expansor de fila: abre la programacion existente en el mismo modal y guarda con PUT.
    private async Task AbrirEditarProgAsync(ProgramacionTareaDto p)
    {
        await CargarOpcionesProgAsync();
        var pars = new ModalParameters()
            .Set("Tableros", _tableros)
            .Set("Personas", _personas)
            .Set("ModuloOrigenCodigo", p.ModuloOrigenCodigo ?? "equipo")
            .Set("EntidadOrigenId", p.EntidadOrigenId)
            .Set("OrigenReferencia", p.OrigenReferencia)
            .Set("Existente", p);
        var req = await Modals.OpenAsync<ProgramadorTareaModal, CrearProgramacionRequest>(pars, new ModalOptions { Width = "580px" });
        if (req is null) return;
        var upd = new ActualizarProgramacionRequest(
            req.Titulo, req.Descripcion, req.Prioridad, req.TableroId, req.Periodicidad,
            req.FechaProximaEjecucion, req.FechaFin, p.Activa, req.Responsables,
            req.Tipo, req.CronExpresion, req.ZonaHoraria, req.NotificarPorCorreo, req.HorizonteDias);
        try
        {
            var r = await Auth().PutAsJsonAsync($"/api/programaciones/{p.Id}", upd);
            if (r.IsSuccessStatusCode) { _msg = "Programacion actualizada."; _msgClass = "alert-success"; await CargarAsync(); }
            else { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task ToggleActivaProgAsync(ProgramacionTareaDto p)
    {
        try
        {
            var r = await Auth().PutAsync($"/api/programaciones/{p.Id}/activa?activa={(!p.Activa).ToString().ToLower()}", null);
            if (r.IsSuccessStatusCode) await CargarAsync();
            else { _msg = "No se pudo cambiar el estado de la programacion."; _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task EliminarProgAsync(ProgramacionTareaDto p)
    {
        var ok = await Js.InvokeAsync<bool>("confirm",
            $"Eliminar la programacion \"{p.Titulo}\"? Las tareas ya generadas se conservan.");
        if (!ok) return;
        try
        {
            var r = await Auth().DeleteAsync($"/api/programaciones/{p.Id}");
            if (r.IsSuccessStatusCode) { _msg = "Programacion eliminada."; _msgClass = "alert-success"; await CargarAsync(); }
            else { _msg = "No se pudo eliminar la programacion."; _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private sealed record TableroApiMt(Guid Id, string Nombre);
