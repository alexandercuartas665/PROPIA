@page "/mantenimiento"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Mantenimiento
@using Propia.Application.Programaciones
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Modals
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals
@implements IDisposable

<PageTitle>Mantenimiento y Activos - PROPIA</PageTitle>

<div class="mt-head">
    <div>
        <h1 class="mt-title">Mantenimiento y activos</h1>
        <p class="mt-sub">Programación de mantenimientos de equipos y zonas comunes.</p>
    </div>
</div>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <div class="mt-empty">Sesión expirada. <a href="/login?returnUrl=%2Fmantenimiento">Iniciar sesión</a>.</div>
    return;
}

@* Sin KPIs (canon regla 7): del titulo se pasa directo a las pestanas y la barra de filtros. *@

@* Tabs estilo prototipo (pills brand) *@
<div class="mt-tabs">
    <button class="mt-tab @(_tab == "prog" ? "mt-tab--on" : "")" type="button" @onclick='() => SwitchTab("prog")'>Programación</button>
    <button class="mt-tab @(_tab == "intervenciones" ? "mt-tab--on" : "")" type="button" @onclick='() => SwitchTab("intervenciones")'>Intervenciones</button>
    <button class="mt-tab @(_tab == "calendario" ? "mt-tab--on" : "")" type="button" @onclick='() => SwitchTab("calendario")'>Calendario</button>
</div>

@if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgClass py-2 small">@_msg</div> }

@if (_tab == "prog")
{
    @* Configuracion de mantenimientos en TABLA (patron vista-tabla): una fila por programacion,
       expansor en la 1a columna -> modal completo; Filtros / Agrupar / Campos; alta inline por activo. *@
    <div class="mod-filtros" style="margin-bottom:14px; display:flex; align-items:center; gap:10px;">
        <FiltroDinamico @ref="_fdProg" Campos="CamposFiltroProg" OnChanged="StateHasChanged" />
        <div class="mod-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="mod-search-inp" placeholder="Buscar programación..." @bind="_progQuery" @bind:event="oninput" />
        </div>
        <div style="flex:1;"></div>
        @* Ordenar (canon = Unidades/Equipos): multi-criterio apilable, componente compartido. *@
        <TablaOrdenarMenu Columnas="ColsOrdenablesProg()" Sorts="_sortsProg" SortsChanged="OnSortsProgChanged" />
        <div class="mtp-menuwrap">
            <button type="button" class="mtp-fbtn @(_progAgrupar != "" ? "on" : "")" @onclick='() => _progMenu = _progMenu == "agr" ? "" : "agr"'>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                <span>Agrupar@(_progAgrupar != "" ? ": " + ProgAgruparLabel(_progAgrupar) : "")</span>
            </button>
            @if (_progMenu == "agr")
            {
                <div class="mtp-menu-bd" @onclick='() => _progMenu = ""'></div>
                <div class="mtp-menu">
                    @foreach (var g in ProgAgruparOpciones())
                    {
                        var gk = g.Item1;
                        <button class="mtp-menu-it @(_progAgrupar == gk ? "on" : "")" @onclick='() => { _progAgrupar = gk; _progMenu = ""; }'>@g.Item2</button>
                    }
                </div>
            }
        </div>
        @* Columnas (inline, canon = Unidades/Equipos): orden, visibilidad y borrar campo propio. Crear/alias = "Campos". *@
        <div class="mtp-menuwrap">
            <button type="button" class="mtp-fbtn @(_showColMenuProg ? "on" : "")" @onclick="() => _showColMenuProg = !_showColMenuProg" title="Columnas: orden y visibilidad">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                <span>Columnas</span>
            </button>
            @if (_showColMenuProg)
            {
                <div class="mtp-menu-bd" @onclick="() => _showColMenuProg = false"></div>
                <div class="mtp-menu mtp-colmenu">
                    <div class="mtp-col-search">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                        <input placeholder="Buscar campo..." value="@_colQProg" @oninput="@(e => _colQProg = e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="mtp-col-list">
                        @{ var _colsP = ClavesOrdenadasProg().ToList(); }
                        @for (int _ci = 0; _ci < _colsP.Count; _ci++)
                        {
                            var k = _colsP[_ci];
                            var idx = _ci;
                            var label = LabelColProg(k);
                            if (!string.IsNullOrWhiteSpace(_colQProg) && !label.Contains(_colQProg, StringComparison.OrdinalIgnoreCase)) { continue; }
                            var fija = EsFijaProg(k);
                            var visible = VisibleColProg(k);
                            var custom = CampoCustomProg(k);
                            <div class="mtp-col-it">
                                <button class="mtp-col-mv" disabled="@(idx == 0)" @onclick="() => MoverColumnaProg(k, -1)">&#9650;</button>
                                <button class="mtp-col-mv" disabled="@(idx == _colsP.Count - 1)" @onclick="() => MoverColumnaProg(k, 1)">&#9660;</button>
                                <span class="mtp-col-name">@label @if (custom is not null) { <span class="mtp-col-dyn" title="Campo personalizado">din</span> }</span>
                                @if (fija) { <span class="mtp-col-fija">fija</span> }
                                else
                                {
                                    <button class="mtp-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => ToggleVisibleColProg(k)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                }
                                @if (custom is not null) { <button class="mtp-col-del" title="Eliminar campo (definicion y valores)" @onclick="() => _campoAEliminarProg = custom"><i class="fi fi-rr-trash"></i></button> }
                            </div>
                        }
                    </div>
                    <div class="mtp-col-massacts">
                        <button type="button" class="mtp-col-mass" @onclick="OcultarTodasColProg"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                        <button type="button" class="mtp-col-mass" @onclick="MostrarTodasColProg"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                        <button type="button" class="mtp-col-reset" @onclick="RestablecerColProg">Restablecer</button>
                    </div>
                </div>
            }
        </div>
        <div class="mtp-menuwrap">
            @* Campos: abre el Selector de Campos compartido (crear campo propio, alias, config de sistema). *@
            <button type="button" class="mtp-fbtn @(_selProgAbierto ? "on" : "")" @onclick="() => _selProgAbierto = true" title="Campos de la programación: crear campo propio, alias y configuración">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                <span>Campos</span>
            </button>
        </div>
    </div>
    @if (_campoAEliminarProg is not null)
    {
        <div class="mtp-selcfg-back" @onclick="() => _campoAEliminarProg = null">
            <div class="mtp-selcfg-modal" style="width:440px" @onclick:stopPropagation="true">
                <div class="mtp-selcfg-head">
                    <div><div class="mtp-selcfg-title">Eliminar campo</div>
                        <div class="mtp-selcfg-sub">Se borran la definición y todos sus valores. No se puede deshacer.</div></div>
                    <button class="mtp-selcfg-x" @onclick="() => _campoAEliminarProg = null">&times;</button>
                </div>
                <div class="mtp-selcfg-body">
                    ¿Eliminar el campo "<strong>@_campoAEliminarProg.Label</strong>"?
                    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
                        <button type="button" class="mtp-fbtn" @onclick="() => _campoAEliminarProg = null" disabled="@_colBusyProg">Cancelar</button>
                        <button type="button" class="mtp-selbar-del" style="margin-left:0;" @onclick="EliminarCampoDinProg" disabled="@_colBusyProg">@(_colBusyProg ? "Eliminando..." : "Eliminar")</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_progs is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else
    {
        @* Barra de accion masiva (canon): aparece al seleccionar filas. Programaciones = Eliminar. *@
        @if (_selProg.Count > 0)
        {
            <div class="mtp-selbar">
                <span class="mtp-selbar-n">@_selProg.Count seleccionada@(_selProg.Count == 1 ? "" : "s")</span>
                <button type="button" class="mtp-selbar-del" @onclick="EliminarProgSeleccionadasAsync" disabled="@_selProgBusy">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                    @(_selProgBusy ? "Eliminando..." : "Eliminar")
                </button>
                <button type="button" class="mtp-selbar-x" @onclick="() => _selProg.Clear()">Deseleccionar</button>
            </div>
        }
        <div class="mtp-tablebox">
        <div class="mtp-table mtp-table--wide">
            <div class="mtp-head" style="@ProgGrid">
                <div class="mtp-sel-col"><label class="mtp-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodasProgSel" @onchange="ToggleSelAllProg" /></label></div>
                <div></div>
                @foreach (var c in ProgColsVis) { <div>@c.Label</div> }
                <div></div>
            </div>
            @foreach (var grupo in ProgGruposRender())
            {
                @if (_progAgrupar != "")
                {
                    <div class="mtp-group"><span>@grupo.Key</span><span class="mtp-group-n">@grupo.Count()</span></div>
                }
                @foreach (var p in grupo)
                {
                    var pp = p;
                    <div class="mtp-row @(_selProg.Contains(pp.Id) ? "mtp-row-sel" : "")" style="@ProgGrid">
                        <div class="mtp-sel-col"><label class="mtp-chk"><input type="checkbox" checked="@_selProg.Contains(pp.Id)" @onclick:stopPropagation="true" @onchange="e => ToggleSelProg(pp.Id, (bool)(e.Value ?? false))" /></label></div>
                        <div class="mtp-exp-col">
                            <button type="button" class="mtp-exp" title="Abrir la programación completa" @onclick="() => AbrirEditarProgAsync(pp)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </div>
                        @foreach (var c in ProgColsVis)
                        {
                            switch (c.Key)
                            {
                                case "tipo":
                                    <div><span class="mtp-tag">@(p.ModuloOrigenCodigo == "zona" ? "Zona común" : "Equipo")</span></div>
                                    break;
                                case "activo":
                                    <div class="mtp-nom" title="@(string.IsNullOrWhiteSpace(p.OrigenReferencia) ? "" : p.OrigenReferencia)">@(string.IsNullOrWhiteSpace(p.OrigenReferencia) ? "-" : p.OrigenReferencia)</div>
                                    break;
                                case "titulo": <div>@p.Titulo</div> break;
                                case "tercero": <div class="mtp-muted" title="@(p.ProveedorNombre ?? NombreTercero(p.ProveedorId))">@(p.ProveedorId is null ? "-" : (p.ProveedorNombre ?? NombreTercero(p.ProveedorId)))</div> break;
                                case "contrato": <div class="mtp-muted" title="@NombreContrato(p.ContratoId)">@(p.ContratoId is null ? "-" : NombreContrato(p.ContratoId))</div> break;
                                case "costo": <div class="mtp-num">@(p.CostoEstimado is { } ce ? ce.ToString("C0", _cultura) : "-")</div> break;
                                case "tablero": <div>@(string.IsNullOrWhiteSpace(p.TableroNombre) ? "General" : p.TableroNombre)</div> break;
                                case "prioridad": <div>@p.Prioridad</div> break;
                                case "periodicidad": <div>@(p.Tipo == TipoProgramacion.Cron ? $"Cron: {p.CronExpresion}" : PeriodicidadProgLabel(p.Periodicidad))</div> break;
                                case "proxima": <div>@p.FechaProximaEjecucion.ToString("yyyy-MM-dd")</div> break;
                                case "responsables": <div title="@string.Join(", ", p.Responsables.Select(r => r.Nombre))">@(p.Responsables.Count == 0 ? "-" : $"{p.Responsables.Count} resp.")</div> break;
                                case "activa":
                                    <div><button type="button" class="mtp-toggle @(p.Activa ? "on" : "")" title="@(p.Activa ? "Activa" : "Pausada")" @onclick="() => ToggleActivaProgAsync(pp)"><span class="mtp-toggle-knob"></span></button></div>
                                    break;
                                default:
                                    @if (CampoCustomProg(c.Key) is { } cdef)
                                    {
                                        <div>
                                            @if (cdef.Tipo == TipoCampoTablero.Seleccion)
                                            {
                                                <select class="mtp-nf-inp" value="@(ValorCampoProg(pp.Id, cdef.Id) ?? "")" @onchange="e => GuardarCampoValorProg(pp.Id, cdef, e.Value?.ToString())">
                                                    <option value="">-</option>
                                                    @foreach (var o in OpcionesDe(cdef.Opciones) ?? new()) { <option value="@o.Item1" selected="@((ValorCampoProg(pp.Id, cdef.Id) ?? "") == o.Item1)">@o.Item2</option> }
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="mtp-nf-inp" value="@(ValorCampoProg(pp.Id, cdef.Id) ?? "")" @onchange="e => GuardarCampoValorProg(pp.Id, cdef, e.Value?.ToString())" />
                                            }
                                        </div>
                                    }
                                    break;
                            }
                        }
                        @* Cesto por fila retirado: el borrado va por la barra de seleccion multiple (mtp-selbar). *@
                        <div class="mtp-act"></div>
                    </div>
                }
            }
            @* Alta inline CANON (clic-para-abrir, = Unidades/Equipos): por defecto solo la CTA
               "+ Agregar programacion"; al pulsarla se abre la fila lista (un control por columna) que se
               guarda al SALIR (clic fuera o Tab) via AltaBlurGuardar si hay activo+titulo+fecha, y se cierra
               al guardar. El expansor de la fila abre el formulario completo (cron, responsables, correo). *@
            @if (_altaProgAbierta)
            {
            <div class="mtp-newrow mtp-newrow--prog mtp-newrow--edit" style="@ProgGrid" @onkeydown="OnAltaProgKey">
                <div class="mtp-sel-col"></div>
                <div class="mtp-exp-col">
                    <button type="button" class="mtp-exp mtp-exp-fijo" title="Abrir el formulario completo para crear la programación" @onclick="AltaProgAsync">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                </div>
                @foreach (var c in ProgColsVis)
                {
                    switch (c.Key)
                    {
                        case "tipo":
                            <div>
                                <select id="mtpAltaProgFirst" class="mtp-nf-inp" @bind="_altaTipo" @bind:after="OnAltaTipoChanged">
                                    <option value="Equipo">Equipo</option>
                                    <option value="ZonaComun">Zona común</option>
                                </select>
                            </div>
                            break;
                        case "activo":
                            <div>
                                <select class="mtp-nf-inp" @bind="_altaActivoId">
                                    <option value="">@(_altaTipo == "ZonaComun" ? "Zona..." : "Activo...")</option>
                                    @foreach (var a in (_activos ?? new()).Where(x => x.ActivoTipo.ToString() == _altaTipo))
                                    {
                                        <option value="@a.ActivoId">@a.Nombre</option>
                                    }
                                </select>
                            </div>
                            break;
                        case "titulo":
                            <div><input class="mtp-nf-inp" placeholder="Título" @bind="_altaTitulo" @bind:event="oninput" /></div>
                            break;
                        case "tercero":
                            <div class="mtp-terc">
                                <SelectorPersona Jwt="@_jwt" PermiteEmpresa="true" Flotante="true"
                                                 Seleccionada="_altaProveedorSel"
                                                 SeleccionadaChanged="OnAltaTerceroSel"
                                                 Placeholder="Buscar o crear tercero..." />
                            </div>
                            break;
                        case "contrato":
                            <div>
                                <select class="mtp-nf-inp" @bind="_altaContratoKey">
                                    <option value="">Sin contrato</option>
                                    @foreach (var co in ContratosParaTercero()) { <option value="@co.Id">@co.Nombre</option> }
                                </select>
                            </div>
                            break;
                        case "costo":
                            <div>
                                <input type="number" min="0" step="1000" class="mtp-nf-inp mtp-nf-num"
                                       placeholder="Costo estimado" @bind="_altaCosto" />
                            </div>
                            break;
                        case "tablero":
                            <div>
                                <select class="mtp-nf-inp" @bind="_altaTableroKey">
                                    <option value="">General</option>
                                    @foreach (var t in _tableros) { <option value="@t.Id">@t.Nombre</option> }
                                </select>
                            </div>
                            break;
                        case "prioridad":
                            <div>
                                <select class="mtp-nf-inp" @bind="_altaPrioridad">
                                    @foreach (var p in Enum.GetValues<PrioridadTarea>()) { <option value="@p">@p</option> }
                                </select>
                            </div>
                            break;
                        case "periodicidad":
                            <div>
                                <select class="mtp-nf-inp" @bind="_altaPeriodicidad">
                                    @foreach (var p in Enum.GetValues<PeriodicidadProgramacion>()) { <option value="@p">@PeriodicidadProgLabel(p)</option> }
                                </select>
                            </div>
                            break;
                        case "proxima":
                            <div><input type="date" class="mtp-nf-inp" value="@(_altaFecha?.ToString("yyyy-MM-dd"))" @onchange="(e) => _altaFecha = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" /></div>
                            break;
                        case "responsables":
                            <div class="mtp-muted" style="font-size:11px;">en la ficha</div>
                            break;
                        case "activa":
                            <div class="mtp-muted" style="font-size:11px;">(auto)</div>
                            break;
                        default:
                            @if (CampoCustomProg(c.Key) is { } cdefA)
                            {
                                <div>
                                    @if (cdefA.Tipo == TipoCampoTablero.Seleccion)
                                    {
                                        <select class="mtp-nf-inp" value="@(_nuCamposProg.GetValueOrDefault(cdefA.Id))" @onchange="e => _nuCamposProg[cdefA.Id] = e.Value?.ToString()">
                                            <option value="">@cdefA.Label</option>
                                            @foreach (var o in OpcionesDe(cdefA.Opciones) ?? new()) { <option value="@o.Item1">@o.Item2</option> }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="mtp-nf-inp" placeholder="@cdefA.Label" value="@(_nuCamposProg.GetValueOrDefault(cdefA.Id))" @oninput="e => _nuCamposProg[cdefA.Id] = e.Value?.ToString()" />
                                    }
                                </div>
                            }
                            break;
                    }
                }
                @* Guardado invisible: sin "+ Agregar". Se guarda al salir de la fila (clic fuera) o al
                   terminar el tabulado (Tab). Celda de acciones vacia (alineacion). *@
                <div class="mtp-act"></div>
            </div>
            @* Fila-aviso bajo la fila de alta de Programaciones (clases compartidas .tbl-nf-hint*). *@
            <div class="mtp-newrow tbl-nf-hintrow" style="@ProgGrid">
                <div class="mtp-sel-col"></div>
                <div class="mtp-exp-col"></div>
                <div style="grid-column: 3 / -1;">
                    <span class="tbl-nf-hint-txt">
                        <kbd class="tbl-kbd">Tab</kbd> o clic fuera para guardar la fila
                        <span class="tbl-nf-hint-sep">&middot;</span>
                        <kbd class="tbl-kbd">Esc</kbd> para cancelar
                    </span>
                </div>
            </div>
            }
            else
            {
            @* CTA de alta canon (.row-add--sm): abre la fila de alta lista (clic-para-abrir, = Unidades). *@
            <div class="mtp-newrow mtp-cta-row" style="@ProgGrid">
                <div class="mtp-sel-col"></div>
                <div class="mtp-exp-col"></div>
                <div class="mtp-nf-ctacell" style="grid-column: 3 / -1;">
                    <button type="button" class="row-add--sm" @onclick="AbrirAltaProg">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                        Agregar programación
                    </button>
                </div>
            </div>
            }
            @if (_progAgrupar == "")
            {
                <TablaPager Total="ProgFiltradas().Count()" Pagina="_progPagina" PorPagina="_progPorPagina" Entidad="programaciones"
                            PaginaChanged="v => _progPagina = v" PorPaginaChanged="v => { _progPorPagina = v; _progPagina = 1; }" />
            }
            else
            {
                <div class="mtp-footer">Mostrando @ProgFiltradas().Count() de @(_progs.Count) programaciones</div>
            }
        </div>
        </div>
    }
}

@if (_tab == "intervenciones")
{
    @* Intervenciones en TABLA canon (Ola 3): expansor -> ficha; Filtros / Agrupar / Campos (sistema + propios);
       alta inline (crea intervencion + tarea vinculada); paginador. *@
    <div class="mod-filtros" style="margin-bottom:14px; display:flex; align-items:center; gap:10px;">
        <FiltroDinamico @ref="_fdInterv" Campos="CamposFiltroInterv" OnChanged="StateHasChanged" />
        <div class="mod-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="mod-search-inp" placeholder="Buscar intervención..." @bind="_intervQuery" @bind:event="oninput" />
        </div>
        <div style="flex:1;"></div>
        <div class="mtp-menuwrap">
            <button type="button" class="mtp-fbtn @(_intervAgrupar != "" ? "on" : "")" @onclick='() => _intervMenu = _intervMenu == "agr" ? "" : "agr"'>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                <span>Agrupar@(_intervAgrupar != "" ? ": " + IntervAgruparLabel(_intervAgrupar) : "")</span>
            </button>
            @if (_intervMenu == "agr")
            {
                <div class="mtp-menu-bd" @onclick='() => _intervMenu = ""'></div>
                <div class="mtp-menu">
                    @foreach (var g in IntervAgruparOpciones())
                    {
                        var gk = g.Item1;
                        <button class="mtp-menu-it @(_intervAgrupar == gk ? "on" : "")" @onclick='() => { _intervAgrupar = gk; _intervMenu = ""; }'>@g.Item2</button>
                    }
                </div>
            }
        </div>
        <div class="mtp-menuwrap">
            <button type="button" class="mtp-fbtn @(_selIntervAbierto ? "on" : "")" @onclick="() => _selIntervAbierto = true" title="Campos de la intervención: orden, visibilidad, nombre y campos propios">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                <span>Campos</span>
            </button>
        </div>
    </div>

    @if (_intervenciones is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else
    {
        <div class="mtp-tablebox">
        <div class="mtp-table mtp-table--wide">
            <div class="mtp-head" style="@IntervGrid">
                <div></div>
                @foreach (var c in IntervColsVis) { <div>@c.Label</div> }
                <div></div>
            </div>
            @foreach (var grupo in IntervGruposRender())
            {
                @if (_intervAgrupar != "")
                {
                    <div class="mtp-group"><span>@grupo.Key</span><span class="mtp-group-n">@grupo.Count()</span></div>
                }
                @foreach (var i in grupo)
                {
                    var iid = i.Id;
                    <div class="mtp-row" style="@IntervGrid">
                        <div class="mtp-exp-col">
                            <button type="button" class="mtp-exp" title="Abrir la ficha de la intervención" @onclick="() => MostrarFicha(iid)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </div>
                        @foreach (var c in IntervColsVis)
                        {
                            switch (c.Key)
                            {
                                case "codigo": <div class="mtp-muted">@i.Codigo</div> break;
                                case "activo": <div class="mtp-nom" title="@i.ActivoNombre">@i.ActivoNombre</div> break;
                                case "tipo": <div>@RenderTipoBadge(i.Tipo)</div> break;
                                case "titulo": <div>@i.Titulo</div> break;
                                case "estado": <div>@RenderEstadoBadge(i.Estado)</div> break;
                                case "prioridad": <div>@RenderPrioridadBadge(i.Prioridad)</div> break;
                                case "proveedor": <div class="mtp-muted">@(i.ProveedorNombre ?? "-")</div> break;
                                case "programada":
                                    <div>@(i.FechaProgramada is { } fp ? (MarkupString)($"<span class=\"{(i.Vencida ? "text-danger fw-bold" : "")}\">{fp:yyyy-MM-dd}</span>") : (MarkupString)"<span class=\"mtp-muted\">-</span>")</div>
                                    break;
                                case "cierre": <div class="mtp-muted">@(i.FechaCierre?.ToString("yyyy-MM-dd") ?? "-")</div> break;
                                case "tarea":
                                    <div>@(i.TareaId is { } tid ? (MarkupString)($"<a class=\"small\" href=\"/tareas/{tid}\">{i.TareaNumero}</a>") : (MarkupString)"<span class=\"mtp-muted\">-</span>")</div>
                                    break;
                                default:
                                    @if (CampoCustomInterv(c.Key) is { } cdef)
                                    {
                                        <div>
                                            @if (cdef.Tipo == TipoCampoTablero.Seleccion)
                                            {
                                                <select class="mtp-nf-inp" value="@(ValorCampoInterv(iid, cdef.Id) ?? "")" @onchange="e => GuardarCampoValorInterv(iid, cdef, e.Value?.ToString())">
                                                    <option value="">-</option>
                                                    @foreach (var o in OpcionesDe(cdef.Opciones) ?? new()) { <option value="@o.Item1" selected="@((ValorCampoInterv(iid, cdef.Id) ?? "") == o.Item1)">@o.Item2</option> }
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="mtp-nf-inp" value="@(ValorCampoInterv(iid, cdef.Id) ?? "")" @onchange="e => GuardarCampoValorInterv(iid, cdef, e.Value?.ToString())" />
                                            }
                                        </div>
                                    }
                                    break;
                            }
                        }
                        <div class="mtp-act"></div>
                    </div>
                }
            }
            @* Alta inline CANON (clic-para-abrir, = Unidades): por defecto solo la CTA; al pulsarla se abre
               la fila lista y se guarda al SALIR (clic fuera o Tab) si hay activo+titulo; se cierra al guardar.
               Crea la intervencion (+ tarea vinculada). *@
            @if (_altaIntervAbierta)
            {
            <div class="mtp-newrow mtp-newrow--interv mtp-newrow--edit" style="@IntervGrid" @onkeydown="OnAltaIntervKey">
                <div class="mtp-exp-col"></div>
                @foreach (var c in IntervColsVis)
                {
                    switch (c.Key)
                    {
                        case "codigo": <div class="mtp-muted" style="font-size:11px;">(auto)</div> break;
                        case "activo":
                            <div>
                                <select id="mtpAltaIntervFirst" class="mtp-nf-inp" @bind="_iaActivoId">
                                    <option value="">Activo o zona...</option>
                                    @foreach (var a in _activos ?? new()) { <option value="@a.ActivoId">@a.Nombre</option> }
                                </select>
                            </div>
                            break;
                        case "tipo":
                            <div>
                                <select class="mtp-nf-inp" @bind="_iaTipo">
                                    @foreach (var t in Enum.GetValues<TipoIntervencionMantenimiento>()) { <option value="@t">@t</option> }
                                </select>
                            </div>
                            break;
                        case "titulo": <div><input class="mtp-nf-inp" placeholder="Título" @bind="_iaTitulo" @bind:event="oninput" /></div> break;
                        case "estado": <div class="mtp-muted" style="font-size:11px;">Programada</div> break;
                        case "prioridad":
                            <div>
                                <select class="mtp-nf-inp" @bind="_iaPrioridad">
                                    @foreach (var p in Enum.GetValues<PrioridadIntervencion>()) { <option value="@p">@p</option> }
                                </select>
                            </div>
                            break;
                        case "proveedor": <div class="mtp-muted" style="font-size:11px;">en la ficha</div> break;
                        case "programada":
                            <div><input type="date" class="mtp-nf-inp" value="@(_iaFecha?.ToString("yyyy-MM-dd"))" @onchange="(e) => _iaFecha = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" /></div>
                            break;
                        case "cierre": <div class="mtp-muted" style="font-size:11px;">-</div> break;
                        case "tarea": <div class="mtp-muted" style="font-size:11px;">(auto)</div> break;
                        default:
                            @if (CampoCustomInterv(c.Key) is { } cdefA)
                            {
                                <div>
                                    @if (cdefA.Tipo == TipoCampoTablero.Seleccion)
                                    {
                                        <select class="mtp-nf-inp" value="@(_nuCamposInterv.GetValueOrDefault(cdefA.Id))" @onchange="e => _nuCamposInterv[cdefA.Id] = e.Value?.ToString()">
                                            <option value="">@cdefA.Label</option>
                                            @foreach (var o in OpcionesDe(cdefA.Opciones) ?? new()) { <option value="@o.Item1">@o.Item2</option> }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="mtp-nf-inp" placeholder="@cdefA.Label" value="@(_nuCamposInterv.GetValueOrDefault(cdefA.Id))" @oninput="e => _nuCamposInterv[cdefA.Id] = e.Value?.ToString()" />
                                    }
                                </div>
                            }
                            break;
                    }
                }
                <div class="mtp-act"></div>
            </div>
            <div class="mtp-newrow tbl-nf-hintrow" style="@IntervGrid">
                <div class="mtp-exp-col"></div>
                <div style="grid-column: 2 / -1;">
                    <span class="tbl-nf-hint-txt">
                        <kbd class="tbl-kbd">Tab</kbd> o clic fuera para guardar la fila
                        <span class="tbl-nf-hint-sep">&middot;</span>
                        <kbd class="tbl-kbd">Esc</kbd> para cancelar
                    </span>
                </div>
            </div>
            }
            else
            {
            @* CTA de alta canon: abre la fila de alta lista (clic-para-abrir, = Unidades). *@
            <div class="mtp-newrow mtp-cta-row" style="@IntervGrid">
                <div class="mtp-exp-col"></div>
                <div class="mtp-nf-ctacell" style="grid-column: 2 / -1;">
                    <button type="button" class="row-add--sm" @onclick="AbrirAltaInterv">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                        Agregar intervención
                    </button>
                </div>
            </div>
            }
            @if (_intervAgrupar == "")
            {
                <TablaPager Total="IntervFiltradas().Count()" Pagina="_intervPagina" PorPagina="_intervPorPagina" Entidad="intervenciones"
                            PaginaChanged="v => _intervPagina = v" PorPaginaChanged="v => { _intervPorPagina = v; _intervPagina = 1; }" />
            }
            else
            {
                <div class="mtp-footer">Mostrando @IntervFiltradas().Count() de @(_intervenciones.Count) intervenciones</div>
            }
        </div>
        </div>
    }
}
else if (_tab == "planes")
{
    @if (_planes is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else
    {
        @* Planes preventivos en TABLA (patron vista-tabla): alta INLINE (sin modal) + edicion inline de la
           Frecuencia sobre filas existentes. El modal "+ Plan preventivo" del header queda como via alterna. *@
        @* Barra de accion masiva (canon): Planes usa Desactivar (soft-delete), no borrado duro. Solo planes
           activos se pueden seleccionar/desactivar. *@
        @if (_selPlan.Count > 0)
        {
            <div class="mtp-selbar">
                <span class="mtp-selbar-n">@_selPlan.Count seleccionado@(_selPlan.Count == 1 ? "" : "s")</span>
                <button type="button" class="mtp-selbar-del" @onclick="DesactivarPlanesSeleccionadosAsync" disabled="@_selPlanBusy">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.36 6.64A9 9 0 1 1 5.64 6.64M12 2v10"/></svg>
                    @(_selPlanBusy ? "Desactivando..." : "Desactivar")
                </button>
                <button type="button" class="mtp-selbar-x" @onclick="() => _selPlan.Clear()">Deseleccionar</button>
            </div>
        }
        <div class="mtp-tablebox">
        <div class="mtp-table">
            <div class="mtp-head" style="@PlanGrid">
                <div class="mtp-sel-col"><label class="mtp-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodosPlanSel" @onchange="ToggleSelAllPlan" /></label></div>
                <div>Activo</div><div>Plan</div><div>Frecuencia</div><div>Próxima ejecución</div>
                <div>Disparo</div><div>Proveedor</div><div>Estado</div><div></div>
            </div>
            @foreach (var p in _planes)
            {
                var pp = p;
                <div class="mtp-row @(p.Id == _planRecienCreado ? "mtp-row--nuevo" : "") @(_selPlan.Contains(p.Id) ? "mtp-row-sel" : "")" style="@PlanGrid">
                    <div class="mtp-sel-col"><label class="mtp-chk"><input type="checkbox" checked="@_selPlan.Contains(p.Id)" disabled="@(!p.Activo)" @onclick:stopPropagation="true" @onchange="e => ToggleSelPlan(pp.Id, (bool)(e.Value ?? false))" /></label></div>
                    <div class="mtp-nom" title="@p.ActivoNombre">@p.ActivoNombre <span class="mtp-tag">@ActivoTipoLabel(p.ActivoTipo)</span></div>
                    <div title="@p.Nombre">@p.Nombre</div>
                    <div>
                        <select class="mtp-cell-inp @(_planBusy == p.Id ? "is-busy" : "")" disabled="@(_planBusy == p.Id || !p.Activo)"
                                @onchange="(e) => CambiarFrecuenciaPlanAsync(pp, e.Value?.ToString())">
                            @foreach (var f in Enum.GetValues<FrecuenciaMantenimiento>())
                            {
                                <option value="@f" selected="@(p.Frecuencia == f)">@f@(f == FrecuenciaMantenimiento.Personalizada && p.Frecuencia == f ? $" ({p.FrecuenciaDias}d)" : "")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <span class="mtp-dot mt-sem-@p.Semaforo.ToString().ToLower()"></span>
                        <span>@p.ProximaEjecucion.ToString("yyyy-MM-dd")</span>
                        @if (p.DiasParaVencer.HasValue && p.Activo)
                        {
                            <span class="@(p.DiasParaVencer < 0 ? "mt-acard-venc" : p.DiasParaVencer < 7 ? "mt-acard-prox" : "mtp-muted")"> (@(p.DiasParaVencer < 0 ? $"-{-p.DiasParaVencer}d" : $"+{p.DiasParaVencer}d"))</span>
                        }
                    </div>
                    <div>@p.Disparo</div>
                    <div>@(p.ProveedorPreferidoNombre ?? "-")</div>
                    <div>
                        @if (p.Activo)
                        {
                            <button type="button" class="mtp-estado-btn" @onclick="() => DesactivarPlan(p.Id)">Desactivar</button>
                        }
                        else
                        {
                            <button type="button" class="mtp-estado-btn on" @onclick="() => ReactivarPlan(p.Id)">Reactivar</button>
                        }
                    </div>
                    <div></div>
                </div>
            }
            @* Fila de alta inline: captura todos los campos del plan; "+ Agregar" lo crea sin modal. *@
            <div class="mtp-newrow" style="@PlanGrid">
                <div class="mtp-sel-col"></div>
                <div style="display:flex; flex-direction:column; gap:4px;">
                    <select id="mtpAltaPlanFirst" class="mtp-nf-inp" @bind="_planActivoTipo">
                        <option value="Equipo">Equipo</option>
                        <option value="ZonaComun">Zona común</option>
                    </select>
                    <select class="mtp-nf-inp" @bind="_planActivoId">
                        <option value="">Activo...</option>
                        @if (_activos is not null)
                        {
                            @foreach (var a in _activos.Where(x => x.ActivoTipo.ToString() == _planActivoTipo))
                            {
                                <option value="@a.ActivoId">@a.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div><input class="mtp-nf-inp" placeholder="Nombre del plan" @bind="_planNombre" @bind:event="oninput" /></div>
                <div style="display:flex; flex-direction:column; gap:4px;">
                    <select class="mtp-nf-inp" @bind="_planFrecuencia">
                        @foreach (var f in Enum.GetValues<FrecuenciaMantenimiento>()) { <option value="@f">@f</option> }
                    </select>
                    @if (_planFrecuencia == FrecuenciaMantenimiento.Personalizada)
                    {
                        <input type="number" min="1" max="365" class="mtp-nf-inp" placeholder="días" @bind="_planFrecuenciaDias" />
                    }
                </div>
                <div><input type="date" class="mtp-nf-inp" value="@(_planFechaInicio?.ToString("yyyy-MM-dd"))" @onchange="(e) => _planFechaInicio = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" /></div>
                <div>
                    <select class="mtp-nf-inp" @bind="_planDisparo">
                        <option value="ConConfirmacion">Con confirmacion</option>
                        <option value="Automatico">Automático</option>
                    </select>
                </div>
                <div><input type="number" min="0" max="90" class="mtp-nf-inp" placeholder="Días alerta" @bind="_planDiasAlerta" /></div>
                <div>
                    <label class="mtp-nf-chk" title="Notificar residentes al ejecutar">
                        <input type="checkbox" @bind="_planNotificarResidentes" /> Notif.
                    </label>
                </div>
                <div class="mtp-act">
                    <button type="button" class="mtp-add" @onclick="AltaPlanInlineAsync" disabled="@_busy">+ Agregar</button>
                </div>
            </div>
            @* CTA de alta canon (.row-add--sm): lleva el foco a la fila de alta, que se confirma con
               su propio "+ Agregar". *@
            <div class="mtp-newrow mtp-cta-row" style="@PlanGrid">
                <div class="mtp-sel-col"></div>
                <div class="mtp-nf-ctacell" style="grid-column: 2 / -1;">
                    <button type="button" class="row-add--sm" @onclick="FocusAltaPlanAsync">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                        Agregar plan
                    </button>
                </div>
            </div>
            <div class="mtp-footer">Mostrando @_planes.Count de @_planes.Count planes</div>
        </div>
        <button type="button" class="tbl-fab mtp-fab" @onclick="FocusAltaPlanAsync" title="Agregar plan">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            Agregar registro
        </button>
        </div>
    }
}
else if (_tab == "calendario")
{
    @* Calendario de PROGRAMACIONES: cada regla se pinta en sus fechas de ejecucion (proxima +
       recurrencias segun la periodicidad) dentro de la vista. Vista Mes o Semana. *@
    @if (_progs is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else
    {
        <div class="mt-cal">
            <div class="mt-cal-bar">
                <button class="mt-cal-nav" type="button" @onclick="() => MtCalMover(-1)">&#8249;</button>
                <span class="mt-cal-title">@MtCalTitulo</span>
                <button class="mt-cal-nav" type="button" @onclick="() => MtCalMover(1)">&#8250;</button>
                <button class="mt-cal-hoy" type="button" @onclick="MtCalHoy">Hoy</button>
                <div class="mt-cal-vistas">
                    <button type="button" class="mt-cal-vbtn @(_calVista == "mes" ? "on" : "")" @onclick='() => _calVista = "mes"'>Mes</button>
                    <button type="button" class="mt-cal-vbtn @(_calVista == "semana" ? "on" : "")" @onclick='() => _calVista = "semana"'>Semana</button>
                </div>
                <span class="mt-cal-hint">Cada programación se pinta en sus fechas de ejecución. Clic para editarla.</span>
            </div>
            <div class="mt-cal-head">
                @foreach (var dw in new[] { "LUN", "MAR", "MIE", "JUE", "VIE", "SAB", "DOM" }) { <div class="mt-cal-dow">@dw</div> }
            </div>
            <div class="mt-cal-grid @(_calVista == "semana" ? "mt-cal-grid--wk" : "")">
                @foreach (var celda in MtCalCeldas())
                {
                    <div class="mt-cal-cell @(celda.EsHoy ? "mt-cal-cell--hoy" : "") @(celda.EsMes ? "" : "mt-cal-cell--off")">
                        <div class="mt-cal-daynum">@celda.Dia</div>
                        @foreach (var ev in celda.Items.Take(_calVista == "semana" ? 20 : 3))
                        {
                            var evLocal = ev;
                            <div class="mt-cal-ev @ev.Clase" title="Registrar ejecucion de: @ev.Titulo" @onclick="() => AbrirRegistrarEjecucion(evLocal.ProgId, evLocal.Fecha)">
                                @ev.Texto
                            </div>
                        }
                        @if (_calVista == "mes" && celda.Items.Count > 3) { <div class="mt-cal-more">+@(celda.Items.Count - 3) mas</div> }
                    </div>
                }
            </div>
        </div>
    }
}

@* ===== Modal Registrar ejecucion (Etapa A) ===== *@
@if (_showRegistrarEjec)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar ejecución del mantenimiento</h5>
                    <button type="button" class="btn-close" @onclick="CerrarRegistrarEjec"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Mantenimiento</label>
                        <input class="form-control form-control-sm" value="@_ejecTitulo" disabled />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Fecha de ejecución</label>
                        <input type="date" class="form-control form-control-sm" value="@(_ejecFecha?.ToString("yyyy-MM-dd"))"
                               @onchange="(e) => _ejecFecha = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label small">Que se hizo (detalle)</label>
                        <textarea class="form-control form-control-sm" rows="4" placeholder="Describe el trabajo realizado..."
                                  @bind="_ejecDetalle" @bind:event="oninput"></textarea>
                    </div>
                    <p class="text-muted small mb-0">Las fotos y la factura se agregan en la siguiente etapa.</p>
                    @if (!string.IsNullOrEmpty(_ejecMsg)) { <div class="alert @_ejecMsgClass py-1 px-2 mt-2 mb-0 small">@_ejecMsg</div> }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-dark" @onclick="CerrarRegistrarEjec">Cancelar</button>
                    <button class="btn btn-sm" style="background: var(--propia-brand); color: var(--propia-text-inverse);"
                            @onclick="ConfirmarRegistrarEjec"
                            disabled="@(_busy || _ejecFecha is null || string.IsNullOrWhiteSpace(_ejecDetalle))">
                        Registrar ejecución
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal Crear Intervencion ===== *@
@if (_showCrearIntervencion)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva intervencion</h5>
                    <button type="button" class="btn-close" @onclick="CerrarCrearIntervencion"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small">Tipo *</label>
                            <select class="form-select form-select-sm" @bind="_crearTipo">
                                <option value="Correctivo">Correctivo</option>
                                <option value="Preventivo">Preventivo</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Tipo activo *</label>
                            <select class="form-select form-select-sm" @bind="_crearActivoTipo">
                                <option value="Equipo">Equipo</option>
                                <option value="ZonaComun">Zona común</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Activo</label>
                            <select class="form-select form-select-sm" @bind="_crearActivoId">
                                <option value="">Seleccione...</option>
                                @if (_activos is not null)
                                {
                                    @foreach (var a in _activos.Where(x => x.ActivoTipo.ToString() == _crearActivoTipo))
                                    {
                                        <option value="@a.ActivoId">@a.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small">Título *</label>
                            <input class="form-control form-control-sm" @bind="_crearTitulo" @bind:event="oninput" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small">Descripción</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="_crearDescripcion" @bind:event="oninput"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Prioridad</label>
                            <select class="form-select form-select-sm" @bind="_crearPrioridad">
                                @foreach (var p in Enum.GetValues<PrioridadIntervencion>()) { <option value="@p">@p</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Fecha programada</label>
                            <input type="date" class="form-control form-control-sm" value="@(_crearFecha?.ToString("yyyy-MM-dd"))"
                                   @onchange="(e) => _crearFecha = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">&nbsp;</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_crearNotificarResidentes" id="notifIntChk" />
                                <label class="form-check-label small" for="notifIntChk">Notificar residentes</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-dark" @onclick="CerrarCrearIntervencion">Cancelar</button>
                    <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="ConfirmarCrearIntervencion" disabled="@(_busy || string.IsNullOrWhiteSpace(_crearTitulo) || string.IsNullOrEmpty(_crearActivoId))">
                        @(_busy ? "Creando..." : "Crear intervencion")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal Crear Plan ===== *@
@if (_showCrearPlan)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo plan preventivo</h5>
                    <button type="button" class="btn-close" @onclick="CerrarCrearPlan"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small">Tipo de activo *</label>
                            <select class="form-select form-select-sm" @bind="_planActivoTipo">
                                <option value="Equipo">Equipo</option>
                                <option value="ZonaComun">Zona común</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small">Activo *</label>
                            <select class="form-select form-select-sm" @bind="_planActivoId">
                                <option value="">Seleccione...</option>
                                @if (_activos is not null)
                                {
                                    @foreach (var a in _activos.Where(x => x.ActivoTipo.ToString() == _planActivoTipo))
                                    {
                                        <option value="@a.ActivoId">@a.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small">Nombre del plan *</label>
                            <input class="form-control form-control-sm" @bind="_planNombre" @bind:event="oninput" placeholder="Ej: Revisión anual ascensor Torre A" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Frecuencia *</label>
                            <select class="form-select form-select-sm" @bind="_planFrecuencia">
                                @foreach (var f in Enum.GetValues<FrecuenciaMantenimiento>()) { <option value="@f">@f</option> }
                            </select>
                        </div>
                        @if (_planFrecuencia == FrecuenciaMantenimiento.Personalizada)
                        {
                            <div class="col-md-4">
                                <label class="form-label small">Días *</label>
                                <input type="number" min="1" max="365" class="form-control form-control-sm" @bind="_planFrecuenciaDias" />
                            </div>
                        }
                        <div class="col-md-4">
                            <label class="form-label small">Fecha inicio *</label>
                            <input type="date" class="form-control form-control-sm" value="@(_planFechaInicio?.ToString("yyyy-MM-dd"))"
                                   @onchange="(e) => _planFechaInicio = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Disparo</label>
                            <select class="form-select form-select-sm" @bind="_planDisparo">
                                <option value="ConConfirmacion">Con confirmacion</option>
                                <option value="Automatico">Automático</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Días alerta previa</label>
                            <input type="number" min="0" max="90" class="form-control form-control-sm" @bind="_planDiasAlerta" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">&nbsp;</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_planNotificarResidentes" id="notifPlanChk" />
                                <label class="form-check-label small" for="notifPlanChk">Notificar residentes al ejecutar</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-dark" @onclick="CerrarCrearPlan">Cancelar</button>
                    <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="ConfirmarCrearPlan"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_planNombre) || string.IsNullOrEmpty(_planActivoId) || _planFechaInicio is null)">
                        @(_busy ? "Creando..." : "Crear plan")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal Ficha Intervencion ===== *@
@if (_fichaIntervencion is not null)
{
    var i = _fichaIntervencion;
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@i.Codigo &middot; @i.Titulo</h5>
                        <small class="text-muted">@RenderTipoBadge(i.Tipo) &middot; @i.ActivoNombre &middot; Origen: @i.Origen</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _fichaIntervencion = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-3"><small class="text-muted">Estado</small><br>@RenderEstadoBadge(i.Estado)</div>
                        <div class="col-md-3"><small class="text-muted">Prioridad</small><br>@RenderPrioridadBadge(i.Prioridad)</div>
                        <div class="col-md-3"><small class="text-muted">Proveedor</small><br>@(i.ProveedorNombre ?? "-")</div>
                        <div class="col-md-3"><small class="text-muted">Programada</small><br>@(i.FechaProgramada?.ToString("yyyy-MM-dd") ?? "-")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(i.Descripcion))
                    {
                        <p class="small mb-3"><strong>Descripción:</strong> @i.Descripcion</p>
                    }
                    @if (i.TareaId.HasValue)
                    {
                        <p class="small mb-3"><a href="@($"/tareas/{i.TareaId}")">Ver tarea vinculada: @i.TareaNumero</a></p>
                    }
                    @if (i.Estado != EstadoIntervencion.Completada && i.Estado != EstadoIntervencion.Cancelada)
                    {
                        <div class="d-flex gap-2 mb-3 flex-wrap">
                            @if (i.Estado == EstadoIntervencion.Programada)
                            {
                                <button class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(i.Id, EstadoIntervencion.EnEjecucion)">Iniciar ejecución</button>
                            }
                            @if (i.Estado == EstadoIntervencion.EnEjecucion)
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => CambiarEstado(i.Id, EstadoIntervencion.EnRevision)">Pasar a revisión</button>
                            }
                            <button class="btn btn-sm" style="background: var(--propia-primary); color: white;" @onclick="() => _mostrarCerrar = true">Cerrar intervencion</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _mostrarCancelar = true">Cancelar</button>
                        </div>
                    }

                    <h6 class="mt-4 mb-2">Bitácora</h6>
                    @if (i.Bitacora.Count == 0)
                    {
                        <p class="text-muted small">Sin entradas.</p>
                    }
                    else
                    {
                        @foreach (var b in i.Bitacora.OrderByDescending(x => x.CreadoAt))
                        {
                            <div class="border-start ps-3 mb-3" style="border-left-width:3px !important; border-color: var(--propia-primary) !important;">
                                <small class="text-muted">
                                    @b.CreadoAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm") &middot; @b.TipoAutor &middot; @b.AutorNombre
                                </small>
                                <p class="mb-0 small">@b.Contenido</p>
                            </div>
                        }
                    }

                    @if (i.Estado != EstadoIntervencion.Completada && i.Estado != EstadoIntervencion.Cancelada)
                    {
                        <div class="card bg-light mt-3">
                            <div class="card-body py-3">
                                <label class="form-label small fw-semibold">Agregar entrada</label>
                                <textarea class="form-control form-control-sm mb-2" rows="2" @bind="_nuevaEntrada" @bind:event="oninput"></textarea>
                                <div class="d-flex gap-2 align-items-center">
                                    <select class="form-select form-select-sm w-auto" @bind="_nuevaEntradaTipo">
                                        @foreach (var t in Enum.GetValues<TipoAutorBitacoraMantenimiento>()) { <option value="@t">@t</option> }
                                    </select>
                                    <button class="btn btn-sm btn-dark" @onclick="AgregarEntrada" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaEntrada))">
                                        Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_mostrarCerrar)
                    {
                        <div class="card border-success mt-3">
                            <div class="card-body">
                                <h6 class="mb-3">Cerrar intervencion</h6>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label small">Fecha cierre *</label>
                                        <input type="date" class="form-control form-control-sm"
                                               value="@(_cerrarFecha?.ToString("yyyy-MM-dd"))"
                                               @onchange="(e) => _cerrarFecha = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label small">Nota de cierre *</label>
                                        <textarea class="form-control form-control-sm" rows="2" @bind="_cerrarNota" @bind:event="oninput"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="_cerrarCambiaEstado" id="cerrarCambioChk" />
                                            <label class="form-check-label small" for="cerrarCambioChk">Cambiar estado del activo al cerrar</label>
                                        </div>
                                    </div>
                                    @if (_cerrarCambiaEstado)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label small">Nuevo estado *</label>
                                            <select class="form-select form-select-sm" @bind="_cerrarEstadoNuevo">
                                                <option value="">Seleccione...</option>
                                                @if (i.ActivoTipo == TipoActivoMantenimiento.Equipo)
                                                {
                                                    @foreach (var s in Enum.GetValues<EstadoEquipoActivo>()) { <option value="@s">@s</option> }
                                                }
                                                else
                                                {
                                                    @foreach (var s in Enum.GetValues<EstadoZonaComunMantenimiento>()) { <option value="@s">@s</option> }
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _mostrarCerrar = false">Volver</button>
                                    <button class="btn btn-sm btn-success" @onclick="() => ConfirmarCerrar(i.Id)"
                                            disabled="@(_busy || string.IsNullOrWhiteSpace(_cerrarNota) || _cerrarFecha is null)">
                                        Confirmar cierre
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_mostrarCancelar)
                    {
                        <div class="card border-danger mt-3">
                            <div class="card-body">
                                <h6 class="mb-3 text-danger">Cancelar intervencion</h6>
                                <label class="form-label small">Motivo *</label>
                                <textarea class="form-control form-control-sm mb-2" rows="2" @bind="_cancelarMotivo" @bind:event="oninput"></textarea>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _mostrarCancelar = false">Volver</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarCancelar(i.Id)"
                                            disabled="@(_busy || string.IsNullOrWhiteSpace(_cancelarMotivo))">
                                        Confirmar cancelación
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* Selector de Campos (Fase 1) de la PROGRAMACION: solo campos de SISTEMA (la programacion no tiene
   EAV -> SinCamposPropios). Orden/visibilidad/alias viven en unidades-config (entidad 'programacion'). *@
@if (_selProgAbierto)
{
    <div class="mtp-selcfg-back" @onclick="() => _selProgAbierto = false">
        <div class="mtp-selcfg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="mtp-selcfg-head">
                <div>
                    <div class="mtp-selcfg-title">Campos de la programación</div>
                    <div class="mtp-selcfg-sub">Orden, visibilidad, nombre y campos propios del cronograma.</div>
                </div>
                <button class="mtp-selcfg-x" type="button" @onclick="() => _selProgAbierto = false" aria-label="Cerrar">&times;</button>
            </div>
            <div class="mtp-selcfg-body">
                <ConfigCamposEntidad Prefijo="programacion"
                                     EntidadConfig="programacion"
                                     RutaCatalogo="/api/mi-copropiedad/programacion-campos"
                                     Catalogo="@ProgramacionCatalogo"
                                     TituloSingular="programacion"
                                     TituloPlural="Programaciones"
                                     Ejemplo="Ej. Garantia, Responsable externo"
                                     TiposAvanzados="true"
                                     Jwt="@_jwt"
                                     Cambiado="RecargarCamposYConfigProgAsync" />
            </div>
        </div>
    </div>
}

@* Campos de la INTERVENCION: sistema + campos propios (EAV). Config en unidades-config (entidad 'intervencion'). *@
@if (_selIntervAbierto)
{
    <div class="mtp-selcfg-back" @onclick="() => _selIntervAbierto = false">
        <div class="mtp-selcfg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="mtp-selcfg-head">
                <div>
                    <div class="mtp-selcfg-title">Campos de la intervención</div>
                    <div class="mtp-selcfg-sub">Orden, visibilidad, nombre y campos propios de las intervenciones.</div>
                </div>
                <button class="mtp-selcfg-x" type="button" @onclick="() => _selIntervAbierto = false" aria-label="Cerrar">&times;</button>
            </div>
            <div class="mtp-selcfg-body">
                <ConfigCamposEntidad Prefijo="intervencion"
                                     EntidadConfig="intervencion"
                                     RutaCatalogo="/api/mi-copropiedad/intervencion-campos"
                                     Catalogo="@IntervCatalogo"
                                     TituloSingular="intervencion"
                                     TituloPlural="Intervenciones"
                                     Ejemplo="Ej. Garantia, Costo real"
                                     TiposAvanzados="true"
                                     Jwt="@_jwt"
                                     Cambiado="RecargarCamposYConfigIntervAsync" />
            </div>
        </div>
    </div>
}

@* ModalHost DEBE vivir en la pagina (no en MainLayout): comparte instancia Scoped del IModalService. *@
<ModalHost />


@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;

    // Paginacion de la tabla de Programacion (canon TablaPager; sin pager cuando hay agrupacion activa).
    private int _progPagina = 1;
    private int _progPorPagina = 25;
    private IEnumerable<ProgramacionTareaDto> ProgPagina()
    {
        var filt = ProgFiltradas().ToList();
        var totalPag = Math.Max(1, (int)Math.Ceiling(filt.Count / (double)_progPorPagina));
        if (_progPagina > totalPag) _progPagina = totalPag;
        if (_progPagina < 1) _progPagina = 1;
        return filt.Skip((_progPagina - 1) * _progPorPagina).Take(_progPorPagina);
    }
    // Filas a renderizar: sin agrupar -> un grupo vacio ya PAGINADO; agrupado -> los grupos completos (sin pager).
    private IEnumerable<IGrouping<string, ProgramacionTareaDto>> ProgGruposRender()
        => _progAgrupar == "" ? ProgPagina().GroupBy(_ => "") : ProgAgrupadas();

    // Referencia a este componente para los interop de JS (guardado invisible de la fila de alta).
    private DotNetObjectReference<Mantenimiento>? _self;
    private DotNetObjectReference<Mantenimiento> Self => _self ??= DotNetObjectReference.Create(this);
    private string? _altaWiredSig;   // (re)instala el listener de guardado invisible solo cuando cambia el estado
    public void Dispose() { _self?.Dispose(); }
    private string? _msg;
    private string _msgClass = "alert-info";
    private string _tab = "prog";

    // ===== Programaciones en tabla (patron vista-tabla; una fila por PROGRAMACION) =====
    private List<ProgramacionTareaDto>? _progs;
    private List<TableroOpcion> _tableros = new();
    private List<PersonaOpcion> _personas = new();
    private List<ContratoOpcion> _contratos = new();
    private bool _progOpcionesCargadas;
    private FiltroDinamico? _fdProg;
    private string _progQuery = "";
    private string _progAgrupar = "";
    private string _progMenu = "";
    // Fila de alta inline de Programacion: un campo por columna (canon regla 8).
    private string _altaTipo = "Equipo";          // Equipo | ZonaComun (selector antes del activo)
    private string _altaActivoId = "";            // Guid del activo (filtrado por _altaTipo)
    private string _altaTitulo = "";
    private string _altaTableroKey = "";
    private PersonaCandidatoDto? _altaProveedorSel;   // tercero elegido con SelectorPersona (persona o empresa)
    private Guid? _altaProveedorId;
    private string? _altaProveedorNombre;
    private string _altaContratoKey = "";
    private decimal? _altaCosto;                   // costo estimado del mantenimiento (opcional)
    private static readonly System.Globalization.CultureInfo _cultura = new("es-CO");
    // M-09: fechas por defecto y ancla del calendario en hora local de Colombia, no del reloj del servidor
    // (mismo criterio que el job: America/Bogota via CronHelper.Zona, sin tocar Common/).
    private static readonly TimeZoneInfo _zonaLocalMt = Propia.Infrastructure.Programaciones.CronHelper.Zona(null);
    private static DateOnly HoyLocalMt() => DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, _zonaLocalMt));
    private static DateTime AnclaLocalMt() => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, _zonaLocalMt).Date;
    private PrioridadTarea _altaPrioridad = PrioridadTarea.Normal;
    private PeriodicidadProgramacion _altaPeriodicidad = PeriodicidadProgramacion.Mensual;
    private DateOnly? _altaFecha = HoyLocalMt();

    // Contratos con sus ids de proveedor, para filtrar por el tercero elegido en la fila de alta.
    private List<ContratoFull> _contratosFull = new();
    private sealed record ContratoFull(Guid Id, string Nombre, Guid? ProvPersonaId, Guid? ProvEmpresaId);
    private IEnumerable<ContratoFull> ContratosParaTercero() =>
        _altaProveedorId is { } pid
            ? _contratosFull.Where(c => c.ProvPersonaId == pid || c.ProvEmpresaId == pid)
            : _contratosFull;

    private void OnAltaTipoChanged() => _altaActivoId = "";   // al cambiar Equipo/Zona, limpiar el activo

    private void OnAltaTerceroSel(PersonaCandidatoDto? sel)
    {
        _altaProveedorSel = sel;
        _altaProveedorId = sel?.PersonaId;
        _altaProveedorNombre = sel?.NombreCompleto;
        // Si el contrato elegido ya no pertenece al nuevo tercero, se limpia.
        if (!string.IsNullOrEmpty(_altaContratoKey) && Guid.TryParse(_altaContratoKey, out var cid)
            && ContratosParaTercero().All(c => c.Id != cid)) _altaContratoKey = "";
    }

    // ---- Selector de Campos (Fase 1): columnas dirigidas por unidades-config (entidad 'programacion') ----
    // Reemplaza el menu de checkboxes en memoria: orden/visibilidad/alias viven en la config compartida
    // por copropiedad (el componente ConfigCamposEntidad las escribe; aqui se leen para pintar la tabla).
    // La programacion NO tiene EAV: solo campos de SISTEMA del catalogo canonico.
    private sealed record ProgCol(string Key, string Label);
    private bool _selProgAbierto;
    private Dictionary<string, Propia.Application.MiCopropiedad.UnidadCampoConfigDto> _cfgProg = new(StringComparer.Ordinal);

    private static readonly IReadOnlyList<CampoSistemaDef> ProgramacionCatalogo =
        MantenimientoCamposSistema.Todos.Select(c => new CampoSistemaDef(
            c.Clave, c.Label, c.Tipo, c.VisiblePorDefecto, c.Fija,
            OpcionesEditables: false, Semilla: null, Entero: false, Ayuda: null,
