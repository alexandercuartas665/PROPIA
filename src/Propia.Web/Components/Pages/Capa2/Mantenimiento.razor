    // ---------- Calendario de programaciones (estilo Reservas/PQRSD) ----------
    private int _mtCalYear; private int _mtCalMonth; private bool _mtCalInit;
    private void MtCalEnsure() { if (!_mtCalInit) { var t = DateTime.Today; _mtCalYear = t.Year; _mtCalMonth = t.Month; _mtCalInit = true; } }
    private string MtCalTitulo { get { MtCalEnsure(); var s = new DateTime(_mtCalYear, _mtCalMonth, 1).ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-CO")); return char.ToUpper(s[0]) + s.Substring(1); } }
    private void MtCalMover(int d) { MtCalEnsure(); var nf = new DateTime(_mtCalYear, _mtCalMonth, 1).AddMonths(d); _mtCalYear = nf.Year; _mtCalMonth = nf.Month; }
    private void MtCalHoy() { var t = DateTime.Today; _mtCalYear = t.Year; _mtCalMonth = t.Month; _mtCalInit = true; }

    private sealed record MtCalItem(Guid? IntervencionId, string Texto, string Clase, string Titulo);
    private sealed record MtCalCelda(int Dia, bool EsMes, bool EsHoy, List<MtCalItem> Items);

    private List<MtCalCelda> MtCalCeldas()
    {
        MtCalEnsure();
        var primero = new DateTime(_mtCalYear, _mtCalMonth, 1);
        int offset = ((int)primero.DayOfWeek + 6) % 7; // la semana inicia el lunes
        var inicio = primero.AddDays(-offset);
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        // Intervenciones con fecha programada (excluye canceladas) + planes activos por proxima ejecucion.
        var porDia = new Dictionary<DateOnly, List<MtCalItem>>();
        void Add(DateOnly f, MtCalItem it) { if (!porDia.TryGetValue(f, out var l)) porDia[f] = l = new(); l.Add(it); }

        foreach (var it in (_intervenciones ?? new()).Where(x => x.FechaProgramada is not null && x.Estado != EstadoIntervencion.Cancelada))
        {
            var clase = it.Estado == EstadoIntervencion.Completada ? "mt-cal-ev--ok"
                      : it.Vencida ? "mt-cal-ev--err" : "";
            Add(it.FechaProgramada!.Value, new MtCalItem(it.Id, $"{it.Codigo} {it.ActivoNombre}", clase,
                $"{it.Codigo} - {it.Titulo} ({it.ActivoNombre}) - {it.Estado}"));
        }
        foreach (var p in (_planes ?? new()).Where(x => x.Activo))
        {
            var clase = p.ProximaEjecucion < hoy ? "mt-cal-ev--err" : "mt-cal-ev--plan";
            Add(p.ProximaEjecucion, new MtCalItem(null, $"Plan: {p.Nombre}", clase,
                $"Plan preventivo - {p.Nombre} ({p.ActivoNombre}) - {p.Frecuencia}"));
        }

        var res = new List<MtCalCelda>(42);
        for (int i = 0; i < 42; i++)
        {
            var f = inicio.AddDays(i);
            var fd = DateOnly.FromDateTime(f);
            res.Add(new MtCalCelda(f.Day, f.Month == _mtCalMonth, fd == hoy,
                porDia.GetValueOrDefault(fd, new List<MtCalItem>())));
        }
        return res;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _resumen = await http.GetFromJsonAsync<ResumenMantenimientoDto>("/api/mantenimiento/resumen");

            // Tipo/semaforo se filtran client-side (FiltroDinamico); al server solo va la busqueda.
            var activosUrl = "/api/mantenimiento/activos";
            if (!string.IsNullOrEmpty(_query)) activosUrl += $"?q={Uri.EscapeDataString(_query)}";
            _activos = await http.GetFromJsonAsync<List<ActivoPanelDto>>(activosUrl) ?? new();

            // El calendario combina intervenciones (fecha programada) y planes (proxima ejecucion).
            if (_tab is "intervenciones" or "calendario")
                _intervenciones = await http.GetFromJsonAsync<List<IntervencionListaDto>>("/api/mantenimiento/intervenciones") ?? new();
            if (_tab is "planes" or "calendario")
                _planes = await http.GetFromJsonAsync<List<PlanDto>>("/api/mantenimiento/planes") ?? new();

            // Programaciones (tab por defecto): una fila por regla; se juntan las de equipos y zonas.
            if (_tab == "prog")
            {
                var eq = await http.GetFromJsonAsync<List<ProgramacionTareaDto>>("/api/programaciones?moduloOrigen=equipo") ?? new();
                var zn = await http.GetFromJsonAsync<List<ProgramacionTareaDto>>("/api/programaciones?moduloOrigen=zona") ?? new();
                _progs = eq.Concat(zn)
                    .OrderBy(p => p.OrigenReferencia ?? "")
                    .ThenBy(p => p.Titulo)
                    .ToList();
            }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    // ===== Planes preventivos en tabla (vista-tabla; alta inline + edicion inline de frecuencia) =====
    private const string PlanGrid = "grid-template-columns: minmax(190px,1.6fr) minmax(150px,1.4fr) 150px minmax(150px,1.2fr) 130px minmax(110px,1fr) 116px 96px; gap: 10px; align-items: center;";
    private Guid? _planBusy;
    private Guid? _planRecienCreado;
    private static string ActivoTipoLabel(TipoActivoMantenimiento t) => t == TipoActivoMantenimiento.ZonaComun ? "Zona comun" : "Equipo";

    // Edicion inline de la frecuencia de un plan existente (PUT MERGE: conserva el resto de campos).
    private async Task CambiarFrecuenciaPlanAsync(PlanDto plan, string? valor)
    {
        if (_planBusy is not null) return;
        if (!Enum.TryParse<FrecuenciaMantenimiento>(valor, out var freq) || freq == plan.Frecuencia) return;
        _planBusy = plan.Id;
        try
        {
            var dias = freq == FrecuenciaMantenimiento.Personalizada ? (plan.FrecuenciaDias ?? 30) : (int?)null;
            var req = new ActualizarPlanRequest(plan.Nombre, plan.Descripcion, freq, dias,
                plan.ProveedorPreferidoId, plan.Disparo, plan.DiasAlertaPrevio, plan.GeneraNotifResidentes);
            var r = await Auth().PutAsJsonAsync($"/api/mantenimiento/planes/{plan.Id}", req);
            if (r.IsSuccessStatusCode) { _msg = "Frecuencia del plan actualizada."; _msgClass = "alert-success"; await CargarAsync(); }
            else { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _planBusy = null; }
    }

    // Alta inline de un plan preventivo (sin modal). Valida minimos al clic y resalta la fila creada.
    private async Task AltaPlanInlineAsync()
    {
        if (!Guid.TryParse(_planActivoId, out var activoId)) { _msg = "Elige un activo para el plan."; _msgClass = "alert-danger"; return; }
        if (string.IsNullOrWhiteSpace(_planNombre)) { _msg = "El plan necesita un nombre."; _msgClass = "alert-danger"; return; }
        if (_planFechaInicio is null) { _msg = "Indica la fecha de inicio del plan."; _msgClass = "alert-danger"; return; }
        _busy = true; _msg = null;
        try
        {
            var dias = _planFrecuencia == FrecuenciaMantenimiento.Personalizada ? (_planFrecuenciaDias ?? 30) : (int?)null;
            var req = new CrearPlanRequest(
                Enum.Parse<TipoActivoMantenimiento>(_planActivoTipo), activoId,
                _planNombre!, null, _planFrecuencia, dias, _planFechaInicio.Value, null,
                Enum.Parse<DisparoPlanMantenimiento>(_planDisparo), _planDiasAlerta, _planNotificarResidentes);
            var resp = await Auth().PostAsJsonAsync("/api/mantenimiento/planes", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            try { var creado = await resp.Content.ReadFromJsonAsync<PlanDto>(); _planRecienCreado = creado?.Id; } catch { }
            _msg = "Plan preventivo creado."; _msgClass = "alert-success";
            // Limpiar la fila de alta (deja el tipo/disparo/dias como venian para altas seguidas).
            _planNombre = null; _planActivoId = ""; _planFechaInicio = null;
            _planFrecuencia = FrecuenciaMantenimiento.Mensual; _planFrecuenciaDias = null; _planNotificarResidentes = false;
            await CargarAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _busy = false; }
    }

    private async Task MostrarFicha(Guid id)
    {
        try
        {
            _fichaIntervencion = await Auth().GetFromJsonAsync<IntervencionDetalleDto>($"/api/mantenimiento/intervenciones/{id}");
            _mostrarCerrar = _mostrarCancelar = false;
            _cerrarFecha = DateOnly.FromDateTime(DateTime.UtcNow);
            _cerrarNota = _cancelarMotivo = _nuevaEntrada = null;
            _cerrarCambiaEstado = false;
            _cerrarEstadoNuevo = "";
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private void CerrarCrearIntervencion()
    {
        _showCrearIntervencion = false;
        _crearTitulo = _crearDescripcion = null;
        _crearActivoId = "";
        _crearFecha = null;
        _crearPrioridad = PrioridadIntervencion.Normal;
        _crearNotificarResidentes = false;
    }

    private async Task ConfirmarCrearIntervencion()
    {
        _busy = true; _msg = null;
        try
        {
            if (!Guid.TryParse(_crearActivoId, out var activoId)) return;
            var req = new CrearIntervencionRequest(
                Enum.Parse<TipoIntervencionMantenimiento>(_crearTipo),
                Enum.Parse<TipoActivoMantenimiento>(_crearActivoTipo),
                activoId, null,
                OrigenIntervencion.Manual, null,
                _crearTitulo!, _crearDescripcion,
                _crearPrioridad, null, null,
                _crearFecha, _crearNotificarResidentes);
            var resp = await Auth().PostAsJsonAsync("/api/mantenimiento/intervenciones", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Intervencion creada con tarea vinculada."; _msgClass = "alert-success";
            CerrarCrearIntervencion();
            _tab = "intervenciones";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private void CerrarCrearPlan()
    {
        _showCrearPlan = false;
        _planNombre = null;
        _planActivoId = "";
        _planFechaInicio = null;
        _planFrecuencia = FrecuenciaMantenimiento.Mensual;
        _planFrecuenciaDias = null;
        _planDisparo = "ConConfirmacion";
        _planDiasAlerta = 7;
        _planNotificarResidentes = false;
    }

    private async Task ConfirmarCrearPlan()
    {
        _busy = true; _msg = null;
        try
        {
            if (!Guid.TryParse(_planActivoId, out var activoId)) return;
            if (_planFechaInicio is null) return;
            var req = new CrearPlanRequest(
                Enum.Parse<TipoActivoMantenimiento>(_planActivoTipo),
                activoId,
                _planNombre!, null,
                _planFrecuencia, _planFrecuenciaDias,
                _planFechaInicio.Value, null,
                Enum.Parse<DisparoPlanMantenimiento>(_planDisparo),
                _planDiasAlerta, _planNotificarResidentes);
            var resp = await Auth().PostAsJsonAsync("/api/mantenimiento/planes", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = "Plan preventivo creado."; _msgClass = "alert-success";
            CerrarCrearPlan();
            _tab = "planes";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task DesactivarPlan(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mantenimiento/planes/{id}");
        if (resp.IsSuccessStatusCode) { _msg = "Plan desactivado."; _msgClass = "alert-success"; await CargarAsync(); }
    }

    private async Task ReactivarPlan(Guid id)
    {
        var resp = await Auth().PostAsync($"/api/mantenimiento/planes/{id}/reactivar", null);
        if (resp.IsSuccessStatusCode) { _msg = "Plan reactivado."; _msgClass = "alert-success"; await CargarAsync(); }
    }

    private async Task CambiarEstado(Guid id, EstadoIntervencion nuevo)
    {
        var req = new CambiarEstadoIntervencionRequest(nuevo, null, null);
        var resp = await Auth().PostAsJsonAsync($"/api/mantenimiento/intervenciones/{id}/estado", req);
        if (resp.IsSuccessStatusCode) { await MostrarFicha(id); await CargarAsync(); }
        else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
    }

    private async Task ConfirmarCerrar(Guid id)
    {
        _busy = true;
        try
        {
            var req = new CerrarIntervencionRequest(
                _cerrarFecha!.Value, _cerrarNota!,
                _cerrarCambiaEstado, _cerrarCambiaEstado ? _cerrarEstadoNuevo : null,
                false, null);
            var resp = await Auth().PostAsJsonAsync($"/api/mantenimiento/intervenciones/{id}/cerrar", req);
            if (resp.IsSuccessStatusCode) { _mostrarCerrar = false; await MostrarFicha(id); await CargarAsync(); }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _busy = false; }
    }

    private async Task ConfirmarCancelar(Guid id)
    {
        _busy = true;
        try
        {
            var req = new CancelarIntervencionRequest(_cancelarMotivo!);
            var resp = await Auth().PostAsJsonAsync($"/api/mantenimiento/intervenciones/{id}/cancelar", req);
            if (resp.IsSuccessStatusCode) { _mostrarCancelar = false; await MostrarFicha(id); await CargarAsync(); }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _busy = false; }
    }

    private async Task AgregarEntrada()
    {
        if (_fichaIntervencion is null || string.IsNullOrWhiteSpace(_nuevaEntrada)) return;
        _busy = true;
        try
        {
            var req = new AgregarBitacoraRequest(_nuevaEntrada!, _nuevaEntradaTipo);
            var resp = await Auth().PostAsJsonAsync($"/api/mantenimiento/intervenciones/{_fichaIntervencion.Id}/bitacora", req);
            if (resp.IsSuccessStatusCode)
            {
                _nuevaEntrada = null;
                await MostrarFicha(_fichaIntervencion.Id);
            }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; }
        }
        finally { _busy = false; }
    }

    private MarkupString RenderTipoBadge(TipoIntervencionMantenimiento t) => t switch
    {
        TipoIntervencionMantenimiento.Preventivo => new MarkupString("<span class='badge bg-info'>Preventivo</span>"),
        TipoIntervencionMantenimiento.Correctivo => new MarkupString("<span class='badge bg-warning text-dark'>Correctivo</span>"),
        _ => new MarkupString("")
    };

    private MarkupString RenderEstadoBadge(EstadoIntervencion e) => e switch
    {
        EstadoIntervencion.Programada => new MarkupString("<span class='badge bg-secondary'>Programada</span>"),
        EstadoIntervencion.EnEjecucion => new MarkupString("<span class='badge bg-info'>En ejecucion</span>"),
        EstadoIntervencion.EnRevision => new MarkupString("<span class='badge bg-warning text-dark'>En revision</span>"),
        EstadoIntervencion.Completada => new MarkupString("<span class='badge bg-success'>Completada</span>"),
        EstadoIntervencion.Cancelada => new MarkupString("<span class='badge bg-dark'>Cancelada</span>"),
        _ => new MarkupString("")
    };

    private MarkupString RenderPrioridadBadge(PrioridadIntervencion p) => p switch
    {
        PrioridadIntervencion.Urgente => new MarkupString("<span class='badge bg-danger'>Urgente</span>"),
        PrioridadIntervencion.Alta => new MarkupString("<span class='badge bg-warning text-dark'>Alta</span>"),
        PrioridadIntervencion.Normal => new MarkupString("<span class='badge bg-primary'>Normal</span>"),
        PrioridadIntervencion.Baja => new MarkupString("<span class='badge bg-secondary'>Baja</span>"),
        _ => new MarkupString("")
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}
