    // (clic fuera o Tab tras el ultimo campo). La fila de alta siempre esta visible (no hay flag de apertura).
    // Chequea EN SILENCIO el minimo (activo + titulo + fecha) antes de llamar a AltaProgInlineAsync, para no
    // disparar los toasts de validacion de ese metodo al salir de una fila vacia o a medio llenar.
    [JSInvokable] public async Task AltaBlurGuardar()
    {
        if (_busy) return;
        if (string.IsNullOrEmpty(_altaActivoId) || !Guid.TryParse(_altaActivoId, out _)) return;
