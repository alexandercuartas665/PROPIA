    // Etapa A: abrir el modal de "registrar ejecucion" desde una ocurrencia del calendario.
    private void AbrirRegistrarEjecucion(Guid progId, DateOnly fecha)
    {
        var p = _progs?.FirstOrDefault(x => x.Id == progId);
        if (p is null) return;
        if (p.EntidadOrigenId is not { } aid)
        {
            _msg = "Esta programacion no esta ligada a un equipo o zona; no se puede registrar la ejecucion.";
            _msgClass = "alert-warning";
            return;
        }
        _ejecProgId = progId;
        _ejecActivoTipo = string.Equals(p.ModuloOrigenCodigo, "zona", StringComparison.OrdinalIgnoreCase)
            ? TipoActivoMantenimiento.ZonaComun : TipoActivoMantenimiento.Equipo;
        _ejecActivoId = aid;
        _ejecTitulo = p.Titulo;
        _ejecFecha = fecha;
        _ejecDetalle = null;
        _ejecMsg = null;
        _showRegistrarEjec = true;
    }

