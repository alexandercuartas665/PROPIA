    // ===== Seleccion multiple + accion masiva de Planes (canon): Desactivar (soft-delete, reversible) =====
    // Solo se pueden seleccionar planes ACTIVOS (desactivar un plan ya inactivo no aplica).
    private readonly HashSet<Guid> _selPlan = new();
    private bool _selPlanBusy;
    private void ToggleSelPlan(Guid id, bool on) { if (on) _selPlan.Add(id); else _selPlan.Remove(id); }
    private bool TodosPlanSel
    {
        get { var ids = (_planes ?? new()).Where(p => p.Activo).Select(p => p.Id).ToList(); return ids.Count > 0 && ids.All(_selPlan.Contains); }
    }
    private void ToggleSelAllPlan(ChangeEventArgs e)
    {
        _selPlan.Clear();
        if ((bool)(e.Value ?? false)) foreach (var p in (_planes ?? new()).Where(p => p.Activo)) _selPlan.Add(p.Id);
    }
    private async Task DesactivarPlanesSeleccionadosAsync()
    {
        if (_selPlan.Count == 0) return;
        var n = _selPlan.Count;
        var ok = await Modals.ConfirmAsync(
            $"Desactivar {n} plan(es) seleccionado(s)? Se pueden reactivar despues.", "Desactivar planes");
        if (!ok) return;
        _selPlanBusy = true;
        int done = 0, fail = 0;
        foreach (var id in _selPlan.ToList())
        {
            try { var r = await Auth().DeleteAsync($"/api/mantenimiento/planes/{id}"); if (r.IsSuccessStatusCode) done++; else fail++; }
            catch { fail++; }
        }
        _selPlan.Clear(); _selPlanBusy = false;
        _msg = fail == 0 ? $"{done} plan(es) desactivado(s)." : $"{done} desactivado(s), {fail} con error.";
        _msgClass = fail == 0 ? "alert-success" : "alert-danger";
        await CargarAsync();
        StateHasChanged();
    }

