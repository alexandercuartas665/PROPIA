    // Kind de FiltroDinamico segun el tipo del campo propio.
    private static string KindDeTipo(TipoCampoTablero t) => t switch
    {
        TipoCampoTablero.Seleccion => "sel",
        TipoCampoTablero.Numero or TipoCampoTablero.Moneda or TipoCampoTablero.Porcentaje => "num",
        TipoCampoTablero.Fecha or TipoCampoTablero.FechaHora => "fecha",
        _ => "texto"
    };
    private static List<(string, string)>? OpcionesDe(string? opciones)
        => string.IsNullOrWhiteSpace(opciones) ? null
            : opciones.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(o => (o, o)).ToList();

