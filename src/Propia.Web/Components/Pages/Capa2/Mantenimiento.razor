        SemaforoMantenimiento.Verde => new MarkupString("<span style='color:#22c55e;'>&#9679;</span>"),
        SemaforoMantenimiento.Amarillo => new MarkupString("<span style='color:#f59e0b;'>&#9679;</span>"),
        SemaforoMantenimiento.Rojo => new MarkupString("<span style='color:#ef4444;'>&#9679;</span>"),
        _ => new MarkupString("<span style='color:#6b7280;'>&#9679;</span>")
    };

