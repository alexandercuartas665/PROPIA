        return q.Where(i => _fdInterv?.Pasa(campo => campo switch
        {
            "codigo" => i.Codigo ?? "",
            "activo" => i.ActivoNombre ?? "",
            "titulo" => i.Titulo ?? "",
            "tipo" => i.Tipo.ToString(),
            "estado" => i.Estado.ToString(),
            "prioridad" => i.Prioridad.ToString(),
            "proveedor" => i.ProveedorNombre ?? "",
            _ when CampoCustomInterv(campo) is { } cd => ValorCampoInterv(i.Id, cd.Id) ?? "",
            _ => ""
        }) ?? true);
    }

    private string _intervAgrupar = "";
    private string _intervMenu = "";
    private IEnumerable<IGrouping<string, IntervencionListaDto>> IntervAgrupadas()
    {
        Func<IntervencionListaDto, string> key;
        if (CampoCustomInterv(_intervAgrupar) is { } cdAgr)
            key = i => { var v = ValorCampoInterv(i.Id, cdAgr.Id); return string.IsNullOrWhiteSpace(v) ? "(vacio)" : v!; };
        else key = _intervAgrupar switch
        {
            "activo" => i => string.IsNullOrWhiteSpace(i.ActivoNombre) ? "(sin activo)" : i.ActivoNombre,
            "tipo" => i => i.Tipo.ToString(),
            "estado" => i => i.Estado.ToString(),
            "prioridad" => i => i.Prioridad.ToString(),
            _ => _ => ""
        };
        return IntervFiltradas().GroupBy(key);
    }
    private IEnumerable<(string, string)> IntervAgruparOpciones()
        => new[] { ("", "Sin agrupar"), ("activo", "Activo"), ("tipo", "Tipo"), ("estado", "Estado"), ("prioridad", "Prioridad") }
            .Concat(_camposDefInterv.OrderBy(d => d.Orden).Select(d => (ClaveCustomInterv(d), d.Label)));
    private string IntervAgruparLabel(string k) => k switch
    {
        "activo" => "Activo", "tipo" => "Tipo", "estado" => "Estado", "prioridad" => "Prioridad",
        _ => CampoCustomInterv(k)?.Label ?? ""
    };

    private int _intervPagina = 1;
    private int _intervPorPagina = 25;
    private IEnumerable<IntervencionListaDto> IntervPagina()
    {
        var filt = IntervFiltradas().ToList();
        var totalPag = Math.Max(1, (int)Math.Ceiling(filt.Count / (double)_intervPorPagina));
        if (_intervPagina > totalPag) _intervPagina = totalPag;
        if (_intervPagina < 1) _intervPagina = 1;
        return filt.Skip((_intervPagina - 1) * _intervPorPagina).Take(_intervPorPagina);
    }
    private IEnumerable<IGrouping<string, IntervencionListaDto>> IntervGruposRender()
        => _intervAgrupar == "" ? IntervPagina().GroupBy(_ => "") : IntervAgrupadas();

    // Alta inline de intervencion (crea + tarea vinculada). Guarda los campos propios sobre la recien creada.
    private string _iaTipo = "Preventivo";
    private string _iaActivoId = "";
    private string _iaTitulo = "";
    private PrioridadIntervencion _iaPrioridad = PrioridadIntervencion.Normal;
    private DateOnly? _iaFecha = DateOnly.FromDateTime(DateTime.Today);
    private async Task AltaIntervInlineAsync()
    {
        if (string.IsNullOrEmpty(_iaActivoId) || !Guid.TryParse(_iaActivoId, out var activoId)) { _msg = "Elige un activo o zona."; _msgClass = "alert-danger"; return; }
        if (string.IsNullOrWhiteSpace(_iaTitulo)) { _msg = "La intervencion necesita un titulo."; _msgClass = "alert-danger"; return; }
        // El tipo de activo (Equipo/ZonaComun) se deriva del activo elegido (el select lista ambos).
        var activoTipo = _activos?.FirstOrDefault(a => a.ActivoId == activoId)?.ActivoTipo ?? TipoActivoMantenimiento.Equipo;
        _busy = true; _msg = null;
        try
        {
            var req = new CrearIntervencionRequest(
                Enum.Parse<TipoIntervencionMantenimiento>(_iaTipo),
                activoTipo,
                activoId, null, OrigenIntervencion.Manual, null,
                _iaTitulo!.Trim(), null, _iaPrioridad, null, null, _iaFecha, false);
            var resp = await Auth().PostAsJsonAsync("/api/mantenimiento/intervenciones", req);
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            if (_nuCamposInterv.Any(x => !string.IsNullOrWhiteSpace(x.Value)))
            {
                try
                {
                    var creada = await resp.Content.ReadFromJsonAsync<IntervencionDetalleDto>();
                    if (creada is not null)
                        foreach (var kv in _nuCamposInterv.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                        {
                            var cd = _camposDefInterv.FirstOrDefault(d => d.Id == kv.Key);
                            if (cd is not null) await GuardarCampoValorInterv(creada.Id, cd, kv.Value);
                        }
                }
                catch { }
            }
            _nuCamposInterv.Clear();
            _msg = "Intervencion creada con tarea vinculada."; _msgClass = "alert-success";
            _iaActivoId = ""; _iaTitulo = "";
            _altaIntervAbierta = false;   // canon: la fila se cierra al guardar (vuelve al CTA "Agregar intervencion").
            await CargarAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _busy = false; }
    }

