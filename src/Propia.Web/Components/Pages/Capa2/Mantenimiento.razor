    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jwt is null)
        {
            try
            {
                var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
                _authChecked = true;
                if (!string.IsNullOrWhiteSpace(stored))
                {
                    _jwt = stored;
                    await CargarAsync();
                    StateHasChanged();
                }
            }
            catch { }
        }

        // Guardado invisible de la fila de alta (clic fuera + Tab; ignora el picker de persona .sp-pop).
        // Solo cuando la fila de alta esta ABIERTA (clic-para-abrir): observa .mtp-newrow--prog en
        // Programacion o .mtp-newrow--interv en Intervenciones. (Re)instala solo cuando cambia el estado.
        var altaSig = (_tab == "prog" && _altaProgAbierta) ? "prog-on"
                    : (_tab == "intervenciones" && _altaIntervAbierta) ? "interv-on"
                    : "off";
        if (altaSig != _altaWiredSig)
        {
            _altaWiredSig = altaSig;
            try
            {
                if (altaSig == "prog-on")
                    await Js.InvokeVoidAsync("propiaUI.altaAutoSave", Self, ".mtp-newrow--prog", "AltaBlurGuardar", ".sp-pop");
                else if (altaSig == "interv-on")
                    await Js.InvokeVoidAsync("propiaUI.altaAutoSave", Self, ".mtp-newrow--interv", "AltaIntervBlurGuardar", ".sp-pop");
                else
                    await Js.InvokeVoidAsync("propiaUI.altaAutoSaveOff");
            }
            catch { }
        }

        // Foco a la primera celda al abrir la fila de alta (canon clic-para-abrir).
        if (_focusProgPending)
        {
            _focusProgPending = false;
            try { await Js.InvokeVoidAsync("propiaUI.focusBySelector", "#mtpAltaProgFirst"); } catch { }
        }
        if (_focusIntervPending)
        {
            _focusIntervPending = false;
            try { await Js.InvokeVoidAsync("propiaUI.focusBySelector", "#mtpAltaIntervFirst"); } catch { }
        }
    }

