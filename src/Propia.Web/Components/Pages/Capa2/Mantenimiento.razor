        }
        catch (Exception ex) { _ejecMsg = ex.Message; _ejecMsgClass = "alert-danger"; }
        finally { _busy = false; }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _resumen = await http.GetFromJsonAsync<ResumenMantenimientoDto>("/api/mantenimiento/resumen");

            // Tipo/semaforo se filtran client-side (FiltroDinamico); al server solo va la busqueda.
            var activosUrl = "/api/mantenimiento/activos";
            if (!string.IsNullOrEmpty(_query)) activosUrl += $"?q={Uri.EscapeDataString(_query)}";
            _activos = await http.GetFromJsonAsync<List<ActivoPanelDto>>(activosUrl) ?? new();

            // Los tabs Intervenciones/Planes se retiraron del modulo; su codigo queda pero sin
            // boton. Se cargan solo si por algun flujo se activara ese tab (defensivo).
            if (_tab == "intervenciones")
            {
                _intervenciones = await http.GetFromJsonAsync<List<IntervencionListaDto>>("/api/mantenimiento/intervenciones") ?? new();
                // Config de columnas (alias/orden/visibilidad) + campos propios (EAV) de la tabla de intervenciones.
                await CargarConfigIntervAsync();
                await CargarCamposIntervAsync();
            }
            if (_tab == "planes")
                _planes = await http.GetFromJsonAsync<List<PlanDto>>("/api/mantenimiento/planes") ?? new();

            // Programaciones: alimentan tanto la tabla (tab "prog") como el calendario ("calendario").
            if (_tab is "prog" or "calendario")
            {
                // Tableros/personas/contratos para los dropdowns inline y el modal (se cargan una vez).
                await CargarOpcionesProgAsync();
                // Config de columnas del Selector de Campos (alias/orden/visibilidad por copropiedad) + campos propios (EAV).
                await CargarConfigProgAsync();
                await CargarCamposProgAsync();
                var eq = await http.GetFromJsonAsync<List<ProgramacionTareaDto>>("/api/programaciones?moduloOrigen=equipo") ?? new();
                var zn = await http.GetFromJsonAsync<List<ProgramacionTareaDto>>("/api/programaciones?moduloOrigen=zona") ?? new();
                _progs = eq.Concat(zn)
                    .OrderBy(p => p.OrigenReferencia ?? "")
                    .ThenBy(p => p.Titulo)
                    .ToList();
            }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

