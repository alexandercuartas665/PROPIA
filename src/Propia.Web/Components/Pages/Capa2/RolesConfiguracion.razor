@page "/configuracion/roles"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.UsuariosAccesos
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Roles y Permisos - PROPIA</PageTitle>

<div class="mb-3 small text-muted">
    <a href="/usuarios" class="text-decoration-none">Usuarios</a>
    <span class="mx-1">/</span>
    <strong>Roles y Permisos</strong>
</div>

<div class="mb-4">
    <h1 class="h3 mb-1 fw-semibold">Roles y Permisos</h1>
    <p class="text-muted mb-0">Matriz configurable de acceso por modulo y por accion (spec 2.5 v1.0)</p>
</div>

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

@if (_sinPermiso)
{
    <SinPermiso />
    return;
}

@if (_rolEditando is not null)
{
    @* ==================== Vista edicion de matriz ==================== *@
    <div class="mb-3">
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => { _rolEditando = null; _detalleEdit = null; }">&larr; Volver a roles</button>
    </div>
    @if (_detalleEdit is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else
    {
        <h5>Editando: <strong>@_detalleEdit.Nombre</strong>
            <span class="badge bg-light text-dark border ms-2">@_detalleEdit.Tipo</span>
            <span class="text-muted small ms-2">@_detalleEdit.CantidadUsuariosActivos usuarios activos</span>
        </h5>
        <p class="text-muted small">@_detalleEdit.Descripcion</p>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead class="bg-light small">
                        <tr>
                            <th>Modulo</th>
                            @foreach (var a in Enum.GetValues<AccionPermiso>())
                            { <th class="text-center">@a</th> }
                            <th class="text-center">Nivel dato</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var mod in ModulosVisibles)
                        {
                            var modCodigo = mod;
                            <tr>
                                <td><strong>@LabelModulo(mod)</strong></td>
                                @foreach (var accion in Enum.GetValues<AccionPermiso>())
                                {
                                    var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == mod && p.Accion == accion);
                                    var hab = celda?.Habilitado ?? false;
                                    var modC = mod; var accC = accion;
                                    <td class="text-center">
                                        <input type="checkbox" checked="@hab" @onchange="(e) => TogglePermiso(modC, accC, (bool)e.Value!)" />
                                    </td>
                                }
                                <td class="text-center">
                                    @{
                                        var nivelActual = _detalleEdit.Permisos.Where(p => p.ModuloCodigo == mod).Select(p => p.NivelDato).DefaultIfEmpty(NivelDato.SinAcceso).Max();
                                    }
                                    <select class="form-select form-select-sm" @onchange="(e) => CambiarNivel(modCodigo, Enum.Parse<NivelDato>(e.Value!.ToString()!))">
                                        <option value="@NivelDato.SinAcceso" selected="@(nivelActual == NivelDato.SinAcceso)">Sin acceso</option>
                                        <option value="@NivelDato.Propio" selected="@(nivelActual == NivelDato.Propio)">Solo propio</option>
                                        <option value="@NivelDato.Copropiedad" selected="@(nivelActual == NivelDato.Copropiedad)">Toda la PH</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="alert @_msgClass py-2 small mt-3">@_msg</div>
        }
        <small class="text-muted d-block mt-2">Los cambios se guardan al instante. La regla "Administrador conserva acceso a Usuarios y Accesos" se aplica automaticamente.</small>
    }
}
else
{
    @* ==================== Vista lista de roles (3 columnas) ==================== *@
    @if (_roles is null)
    {
        <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-md-4">
                <h6 class="text-muted small">BASE (no eliminables)</h6>
                @foreach (var r in _roles.Where(r => r.Tipo == TipoRol.Base))
                {
                    var rr = r;
                    <div class="card mb-2">
                        <div class="card-body py-2 d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@r.Nombre</strong>
                                <div class="text-muted small">@r.CantidadUsuariosActivos usuarios activos</div>
                            </div>
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => EditarRol(rr.Id)">Editar permisos</button>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-4">
                <h6 class="text-muted small">EXTENDIDOS (predefinidos)</h6>
                @foreach (var r in _roles.Where(r => r.Tipo == TipoRol.Extendido))
                {
                    var rr = r;
                    <div class="card mb-2 @(r.Activo ? "" : "opacity-50")">
                        <div class="card-body py-2 d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@r.Nombre</strong>
                                <div class="text-muted small">@(r.Activo ? "Activo" : "Inactivo") · @r.CantidadUsuariosActivos usuarios</div>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-dark" @onclick="() => ToggleExtendido(rr.Id)">@(r.Activo ? "Desactivar" : "Activar")</button>
                                <button class="btn btn-sm btn-outline-dark" @onclick="() => EditarRol(rr.Id)">Editar</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-4">
                <h6 class="text-muted small">PERSONALIZADOS</h6>
                @foreach (var r in _roles.Where(r => r.Tipo == TipoRol.Personalizado))
                {
                    var rr = r;
                    <div class="card mb-2">
                        <div class="card-body py-2 d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@r.Nombre</strong>
                                <div class="text-muted small">@r.CantidadUsuariosActivos usuarios</div>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-dark" @onclick="() => EditarRol(rr.Id)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarRol(rr.Id)">Quitar</button>
                            </div>
                        </div>
                    </div>
                }
                <div class="card border-primary mt-2">
                    <div class="card-body py-3">
                        <h6 class="small mb-2">Crear rol personalizado</h6>
                        <input class="form-control form-control-sm mb-2" placeholder="Nombre del rol" @bind="_nuevoNombre" />
                        <select class="form-select form-select-sm mb-2" @bind="_copiarDe">
                            <option value="">(Empezar vacio)</option>
                            @foreach (var r in _roles.Where(r => r.Tipo != TipoRol.Sistema))
                            {
                                <option value="@r.Id">Copiar de: @r.Nombre</option>
                            }
                        </select>
                        <button class="btn btn-sm w-100" style="background: var(--propia-primary); color: white;" @onclick="CrearRol" disabled="@_busy">+ Crear rol</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @_msgClass py-2 small mt-3">@_msg</div>
    }
}

@code {
    private string? _jwt;
    private bool _busy;
    private bool _sinPermiso;
    private string? _msg; private string _msgClass = "alert-info";

    private List<RolDto>? _roles;
    private Guid? _rolEditando;
    private RolDetalleDto? _detalleEdit;

    private string _nuevoNombre = "";
    private string _copiarDe = "";

    // Modulos a mostrar en la matriz - todos los del catalogo
    private static readonly string[] ModulosVisibles =
    {
        "DASHBOARD", "MI_COPROPIEDAD", "DIRECTORIO", "USUARIOS_ACCESOS",
        "PRESUPUESTO", "CARTERA", "ASAMBLEAS", "PQRS", "TAREAS",
        "MANTENIMIENTO", "PORTERIA", "RESERVAS", "COMUNICACIONES", "DOCUMENTOS", "REPORTES"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { /* prerender */ }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/roles");
            if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden) { _sinPermiso = true; _roles = new(); return; }
            resp.EnsureSuccessStatusCode();
            _roles = await resp.Content.ReadFromJsonAsync<List<RolDto>>() ?? new();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    private async Task EditarRol(Guid rolId)
    {
        _rolEditando = rolId;
        var http = Auth();
        _detalleEdit = await http.GetFromJsonAsync<RolDetalleDto>($"/api/roles/{rolId}");
    }

    private async Task TogglePermiso(string modulo, AccionPermiso accion, bool habilitado)
    {
        if (_rolEditando is null || _detalleEdit is null) return;
        var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == modulo && p.Accion == accion);
        var nivel = celda?.NivelDato ?? NivelDato.Copropiedad;
        if (habilitado && nivel == NivelDato.SinAcceso) nivel = NivelDato.Copropiedad;

        var http = Auth();
        var resp = await http.PutAsJsonAsync($"/api/roles/{_rolEditando}/permisos",
            new ActualizarPermisoRequest(modulo, accion, habilitado, nivel));
        if (!resp.IsSuccessStatusCode)
        {
            _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger";
        }
        else
        {
            _msg = "Permiso actualizado."; _msgClass = "alert-success";
        }
        await EditarRol(_rolEditando.Value);
    }

    private async Task CambiarNivel(string modulo, NivelDato nivel)
    {
        if (_rolEditando is null || _detalleEdit is null) return;
        // Aplico el nivel a todas las acciones HABILITADAS del modulo
        var http = Auth();
        foreach (var accion in Enum.GetValues<AccionPermiso>())
        {
            var celda = _detalleEdit.Permisos.FirstOrDefault(p => p.ModuloCodigo == modulo && p.Accion == accion);
            if (celda is null || !celda.Habilitado) continue;
            await http.PutAsJsonAsync($"/api/roles/{_rolEditando}/permisos",
                new ActualizarPermisoRequest(modulo, accion, true, nivel));
        }
        await EditarRol(_rolEditando.Value);
    }

    private async Task ToggleExtendido(Guid rolId)
    {
        var http = Auth();
        await http.PutAsync($"/api/roles/{rolId}/activar", null);
        await CargarAsync();
    }

    private async Task CrearRol()
    {
        if (string.IsNullOrWhiteSpace(_nuevoNombre)) return;
        _busy = true; _msg = null;
        try
        {
            var http = Auth();
            Guid? copiar = Guid.TryParse(_copiarDe, out var g) ? g : null;
            var resp = await http.PostAsJsonAsync("/api/roles",
                new CrearRolRequest(_nuevoNombre.Trim(), null, copiar));
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            _msg = $"Rol '{_nuevoNombre}' creado."; _msgClass = "alert-success";
            _nuevoNombre = ""; _copiarDe = "";
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private async Task EliminarRol(Guid rolId)
    {
        var http = Auth();
        var resp = await http.DeleteAsync($"/api/roles/{rolId}");
        if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
        _msg = "Rol eliminado."; _msgClass = "alert-success";
        await CargarAsync();
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private static string LabelModulo(string codigo) => codigo switch
    {
        "DASHBOARD" => "Dashboard",
        "MI_COPROPIEDAD" => "Mi Copropiedad",
        "DIRECTORIO" => "Directorio",
        "USUARIOS_ACCESOS" => "Usuarios y Accesos",
        "PRESUPUESTO" => "Presupuesto y Pagos",
        "CARTERA" => "Cartera",
        "ASAMBLEAS" => "Asambleas",
        "PQRS" => "PQRS y Convivencia",
        "TAREAS" => "Tareas y Proyectos",
        "MANTENIMIENTO" => "Mantenimiento",
        "PORTERIA" => "Porteria",
        "RESERVAS" => "Reservas",
        "COMUNICACIONES" => "Comunicaciones",
        "DOCUMENTOS" => "Documentos",
        "REPORTES" => "Reportes",
        _ => codigo
    };
}
