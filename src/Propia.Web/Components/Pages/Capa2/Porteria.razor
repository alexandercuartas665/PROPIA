    private void OnViNombre(ChangeEventArgs e)
    {
        _viNombre = e.Value?.ToString() ?? "";
        var q = _viNombre.Trim();
        _viSugs = (_autorizaciones ?? new())
            .Where(a => a.Estado == EstadoAutorizacion.Activo && q.Length >= 2 &&
                        a.NombreVisitante.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Take(3).ToList();
    }

    private void PickSug(AutorizacionPreviaDto a)
    {
        _viNombre = a.NombreVisitante;
        _viDoc = a.DocumentoVisitante ?? "";
        _viTipo = a.TipoVisitante;
        _viDestino = a.UnidadPrivadaId;
        _viSugs = new();
    }

    private void SetResidenteFromDestino()
    {
        var u = _unidades?.FirstOrDefault(x => x.Id == _viDestino);
        _waResName = u is not null ? $"Residente Apto {u.Numero}" : "Residente";
        _waResTel = "+57 320 555 01" + (Math.Abs(_viDestino.GetHashCode()) % 90 + 10);
    }

    private async Task SolicitarPermiso()
    {
        if (_turno is null) { Flash("Abre un turno (vista Operacion) antes de registrar.", false); return; }
        SetResidenteFromDestino();
        var hora = DateTime.Now.ToString("HH:mm");
        _viChat.Add(new ChatMsg("sys", "El agente IA inicio la conversacion con el residente.", hora));
        var motivo = string.IsNullOrWhiteSpace(_viMotivo) ? TipoLabel(_viTipo).ToLowerInvariant() : _viMotivo;
        _viChat.Add(new ChatMsg("agent", $"Hola, soy el asistente de {(_coName == "" ? "la copropiedad" : _coName)}. {_viNombre} esta en porteria ({motivo}). Autorizas su ingreso?", hora));
        _viTyping = true; StateHasChanged();
        await Task.Delay(900);
        _viTyping = false; _viAwait = true; StateHasChanged();
    }

    private async Task SimSi()
    {
