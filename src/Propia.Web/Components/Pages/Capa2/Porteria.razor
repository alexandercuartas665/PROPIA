    // ----- Novedades -----
    private void AbrirNovedad()
    {
        _showNovedad = true;
        _nvTipo = TipoNovedadPorteria.General; _nvDescripcion = ""; _nvDestinoTipo = ""; _nvDestinoId = Guid.Empty; _nvGeneraTarea = false;
        _msg = null;
    }
    private void CerrarNovedad() => _showNovedad = false;
    private void OnNvDestinoTipo(ChangeEventArgs e) { _nvDestinoTipo = e.Value?.ToString() ?? ""; _nvDestinoId = Guid.Empty; }
    private async Task RegistrarNovedad()
    {
        if (_turno is null) { Flash("Abre un turno (vista Operacion) antes de registrar novedades.", false); return; }
        if (string.IsNullOrWhiteSpace(_nvDescripcion)) return;
        _busy = true;
        try
        {
            DestinoNovedad? dt = _nvDestinoTipo switch
            {
                "unidad" => DestinoNovedad.UnidadPrivada,
                "zona" => DestinoNovedad.ZonaComun,
                "equipo" => DestinoNovedad.Equipo,
                _ => null
            };
            Guid? did = (dt is not null && _nvDestinoId != Guid.Empty) ? _nvDestinoId : null;
            var req = new CrearNovedadRequest(_nvDescripcion.Trim(), _nvGeneraTarea, _nvTipo, dt, did);
            var resp = await Auth().PostAsJsonAsync($"/api/porteria/turnos/{_turno.Id}/novedades", req);
            if (!resp.IsSuccessStatusCode) { Flash(await resp.Content.ReadAsStringAsync(), false); return; }
            _showNovedad = false;
            var today = DateOnly.FromDateTime(DateTime.Today);
            _novedades = await Auth().GetFromJsonAsync<List<NovedadDto>>($"/api/porteria/novedades?fecha={today:yyyy-MM-dd}") ?? new();
            Flash("Novedad registrada en la minuta.", true);
        }
        finally { _busy = false; }
    }
    private static string TipoNovedadLabel(TipoNovedadPorteria t) => t switch
    {
        TipoNovedadPorteria.General => "Novedad", TipoNovedadPorteria.Dano => "Dano", TipoNovedadPorteria.Reclamo => "Reclamo",
        TipoNovedadPorteria.Seguridad => "Seguridad", TipoNovedadPorteria.Mantenimiento => "Mantenimiento", _ => "Novedad"
    };
