    private void SetCampoVal(Guid id, ChangeEventArgs e) => _viCampos[id] = e.Value?.ToString();
    private bool CampoBool(Guid id) => string.Equals(_viCampos.GetValueOrDefault(id), "true", StringComparison.OrdinalIgnoreCase);
    private void SetCampoBool(Guid id, ChangeEventArgs e) => _viCampos[id] = (e.Value is bool b && b) ? "true" : "false";
    private static string[] CampoOpciones(PorteriaCampoDto c) => string.IsNullOrWhiteSpace(c.Opciones)
        ? Array.Empty<string>()
