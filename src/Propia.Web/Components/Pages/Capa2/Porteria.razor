@page "/porteria"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Porteria
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<PageTitle>Porteria y accesos - PROPIA</PageTitle>

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

<div class="po-wrap">

    <div class="po-head">
        <div>
            <h1 class="po-h1">Porteria y accesos</h1>
            <p class="po-sub">Minuta digital, visitantes y correspondencia@(string.IsNullOrEmpty(_coName) ? "." : " de " + _coName + ".")</p>
            @if (_turno is not null)
            {
                <div class="po-turno">
                    <span class="po-turno-dot"></span>
                    Turno abierto &middot; @_turno.GuardaNombre &middot; @_turno.PuntoAcceso
                    <button class="po-turno-x" @onclick="() => CerrarTurno(_turno!.Id)">Cerrar turno</button>
                </div>
            }
        </div>
        <button class="po-btn-primary" @onclick="AbrirRegistrar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"></path></svg>
            Registrar ingreso
        </button>
    </div>

    <div class="po-chips">
        <button class="po-chip @(_view == "operacion" ? "active" : "")" @onclick='() => CambiarVista("operacion")'>Operacion</button>
        <button class="po-chip @(_view == "minuta" ? "active" : "")" @onclick='() => CambiarVista("minuta")'>Minuta</button>
        <button class="po-chip @(_view == "autorizaciones" ? "active" : "")" @onclick='() => CambiarVista("autorizaciones")'>Autorizaciones previas</button>
        <button class="po-chip @(_view == "vehiculos" ? "active" : "")" @onclick='() => CambiarVista("vehiculos")'>Vehiculos</button>
        <button class="po-chip @(_view == "paquetes" ? "active" : "")" @onclick='() => CambiarVista("paquetes")'>Paquetes</button>
        <button class="po-chip @(_view == "config" ? "active" : "")" @onclick='() => CambiarVista("config")'>Configuracion</button>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="po-flash @(_msgOk ? "ok" : "err")">@_msg</div>
    }

    @if (_turno is null && (_view == "operacion" || _view == "paquetes"))
    {
        <div class="po-banner">
            <div class="po-banner-txt">
                <strong>No hay turno de porteria abierto.</strong>
                <span>Abre tu turno para registrar ingresos, vehiculos y correspondencia.</span>
            </div>
            <div class="po-banner-form">
                <select class="po-input" @bind="_abrirGuardaId">
                    <option value="@Guid.Empty">Selecciona guarda...</option>
                    @if (_personas is not null)
                    {
                        @foreach (var p in _personas)
                        {
                            <option value="@p.Id">@p.Nombres @p.Apellidos</option>
                        }
                    }
                </select>
                <input class="po-input" placeholder="Punto de acceso" @bind="_abrirPunto" @bind:event="oninput" />
                <button class="po-btn-primary sm" disabled="@(_busy || _abrirGuardaId == Guid.Empty || string.IsNullOrWhiteSpace(_abrirPunto))" @onclick="AbrirTurno">Abrir turno</button>
            </div>
        </div>
    }

    @* =================== OPERACION (pantalla principal del prototipo) =================== *@
    @if (_view == "operacion")
    {
        <div class="po-stats">
            <div class="po-stat">
                <div class="po-stat-l">Adentro ahora (personas)</div>
                <div class="po-stat-n" style="color:#6D4FE3">@(_panel?.Hoy.VisitantesActuales ?? 0)</div>
            </div>
            <div class="po-stat">
                <div class="po-stat-l">Paquetes pendientes</div>
                <div class="po-stat-n" style="color:@((_panel?.Hoy.PaquetesPendientes ?? 0) > 0 ? "#C0383C" : "#1B2A3A")">@(_panel?.Hoy.PaquetesPendientes ?? 0)</div>
            </div>
            <div class="po-stat">
                <div class="po-stat-l">Ingresos hoy</div>
                <div class="po-stat-n" style="color:#1B2A3A">@(_panel?.Hoy.Ingresos ?? 0)</div>
            </div>
        </div>

        <div class="po-section-l">ADENTRO AHORA - CONTROL DE PERMANENCIA</div>
        <div class="po-cols">
            @for (var c = 0; c < 3; c++)
            {
                var col = c;
                var items = _adentro.Where(a => Cat(a.TipoVisitante) == col).ToList();
                <div class="po-col">
                    <div class="po-col-h">
                        <span class="po-col-t">@ColTitulo(col)</span>
                        <span class="po-col-n">@items.Count</span>
                    </div>
                    <div class="po-col-body">
                        @if (items.Count == 0)
                        {
                            <div class="po-empty">Nadie en esta categoria</div>
                        }
                        else
                        {
                            @foreach (var a in items)
                            {
                                var reg = a;
                                var dur = _now - reg.Timestamp;
                                var stale = dur.TotalHours >= 3;
                                var aprobado = !string.IsNullOrEmpty(reg.Observacion) && reg.Observacion!.StartsWith("Aprobado", StringComparison.OrdinalIgnoreCase);
                                <div class="po-pcard" style="@(stale ? "background:#FFF8F8;border-color:#F5C8CB" : "")">
                                    <div class="po-pcard-top">
                                        <div class="po-av" style="background:@AvColor(col)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"></path></svg>
                                        </div>
                                        <div class="po-pcard-id">
                                            <div class="po-pcard-name">@reg.Nombre</div>
                                            <div class="po-pcard-meta">@(reg.DestinoNombre ?? TipoLabel(reg.TipoVisitante)) &middot; entro @reg.Timestamp.LocalDateTime.ToString("HH:mm")</div>
                                        </div>
                                        <button class="po-salir" title="Marcar salida" @onclick="() => RegistrarEgreso(reg)">Salida</button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(reg.Observacion))
                                    {
                                        <div class="po-pcard-obs">@reg.Observacion</div>
                                    }
                                    <div class="po-pcard-badges">
                                        @if (aprobado)
                                        {
                                            <span class="po-bdg green">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M5 12l5 5 9-11"></path></svg>
                                                Aprobado
                                            </span>
                                        }
                                        @if (stale)
                                        {
                                            <span class="po-bdg red">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                                                @FormatDur(dur) adentro
                                            </span>
                                            <button class="po-bdg-btn" @onclick="() => AbrirVerificacion(reg)">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2z"></path></svg>
                                                Verificar con residente
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="po-bdg soft-green">@FormatDur(dur)</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* =================== MINUTA DE HOY =================== *@
    @if (_view == "minuta")
    {
        <div class="po-sub-head" style="margin-bottom:12px">
            <div class="po-section-l" style="margin:0">REGISTRO DEL DIA</div>
            <button class="po-btn-primary sm" @onclick="AbrirNovedad">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"></path></svg>
                Registrar novedad
            </button>
        </div>

        @if (_novedades is { Count: > 0 })
        {
            <div class="po-card" style="margin-bottom:14px">
                <div class="po-card-h">Novedades de hoy</div>
                @foreach (var nv in _novedades)
                {
                    <div class="po-row">
                        <div class="po-av lg" style="background:@NovedadColor(nv.Tipo)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
                        </div>
                        <div class="po-row-id">
                            <div class="po-row-name">@TipoNovedadLabel(nv.Tipo)@(string.IsNullOrEmpty(nv.DestinoNombre) ? "" : " - " + nv.DestinoNombre)</div>
                            <div class="po-row-meta">@nv.Descripcion</div>
                        </div>
                        <span class="po-row-hora">@nv.CreadoAt.LocalDateTime.ToString("HH:mm")</span>
                        @if (nv.GeneraTarea) { <span class="po-estado dentro">Tarea</span> }
                    </div>
                }
            </div>
        }

        <div class="po-card">
            <div class="po-card-h">Minuta de hoy</div>
            @{
                var ingresos = _visitasHoy.Where(v => v.TipoEvento == TipoEventoAccesoPorteria.Ingreso)
                                          .OrderByDescending(v => v.Timestamp).ToList();
            }
            @if (ingresos.Count == 0)
            {
                <div class="po-empty" style="padding:28px 0">Aun no hay movimientos registrados hoy.</div>
            }
            else
            {
                @foreach (var v in ingresos)
                {
                    var reg = v;
                    var dentro = _adentro.Any(a => a.Nombre == reg.Nombre && (a.Documento ?? "") == (reg.Documento ?? ""));
                    <div class="po-row">
                        <div class="po-av lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"></path></svg>
                        </div>
                        <div class="po-row-id">
                            <div class="po-row-name">@reg.Nombre</div>
                            <div class="po-row-meta">@TipoLabel(reg.TipoVisitante)@if (!string.IsNullOrEmpty(reg.DestinoNombre)) { <text> &middot; @reg.DestinoNombre</text> }@if (!string.IsNullOrEmpty(reg.Documento)) { <text> &middot; @reg.Documento</text> }@foreach (var cv in (reg.CamposValores ?? new List<PorteriaCampoValorDto>())) { if (!string.IsNullOrWhiteSpace(cv.Valor)) { <text> &middot; @CampoLabel(cv.CampoId): @cv.Valor</text> } }</div>
                        </div>
                        <span class="po-row-hora">@reg.Timestamp.LocalDateTime.ToString("HH:mm")</span>
                        @if (dentro)
                        {
                            <span class="po-estado dentro">Dentro</span>
                            <button class="po-row-salir" @onclick="() => RegistrarEgreso(reg)">Salida</button>
                        }
                        else
                        {
                            <span class="po-estado salio">Salio</span>
                        }
                    </div>
                }
            }
        </div>
    }

    @* =================== AUTORIZACIONES PREVIAS =================== *@
    @if (_view == "autorizaciones")
    {
        <div class="po-sub-head">
            <div class="po-section-l" style="margin:0">AUTORIZACIONES PREVIAS</div>
            <button class="po-btn-primary sm" @onclick="() => _showCrearAuth = true">+ Nueva autorizacion</button>
        </div>
        @if (_autorizaciones is null)
        {
            <div class="po-empty" style="padding:30px 0">Cargando...</div>
        }
        else if (_autorizaciones.Count == 0)
        {
            <div class="po-card"><div class="po-empty" style="padding:34px 0">Sin autorizaciones registradas.</div></div>
        }
        else
        {
            <div class="po-card">
                <table class="po-table">
                    <thead><tr><th>Visitante</th><th>Unidad</th><th>Vigencia</th><th>Estado</th><th>Codigo</th><th>Usos</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in _autorizaciones)
                        {
                            var aid = a.Id;
                            <tr>
                                <td><strong>@a.NombreVisitante</strong><div class="po-cell-sub">@TipoLabel(a.TipoVisitante)</div></td>
                                <td>@a.UnidadNumero</td>
                                <td class="po-cell-sub">@a.VigenciaInicio.LocalDateTime.ToString("yyyy-MM-dd HH:mm")<br>@a.VigenciaFin.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@RenderEstadoAut(a.Estado)</td>
                                <td>@(string.IsNullOrEmpty(a.CodigoNumerico) ? "-" : a.CodigoNumerico)</td>
                                <td>@a.UsosRealizados / @a.UsosMaximos</td>
                                <td>
                                    @if (a.Estado == EstadoAutorizacion.Activo)
                                    {
                                        <button class="po-mini-danger" @onclick="() => RevocarAutorizacion(aid)">Revocar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* =================== VEHICULOS =================== *@
    @if (_view == "vehiculos")
    {
        <div class="po-card" style="margin-bottom:16px">
            <div class="po-card-h">Registro de ingreso / salida de vehiculos</div>
            @if (_turno is null)
            {
                <div class="po-note">Abre un turno (vista Operacion) para registrar el movimiento de vehiculos.</div>
            }
            else
            {
                <div class="po-form-body">
                    <div class="po-form-2">
                        <div>
                            <label class="po-lbl">Placa *</label>
                            <input class="po-input" maxlength="10" placeholder="ABC123" @bind="_rvPlaca" @bind:event="oninput" />
                        </div>
                        <div>
                            <label class="po-lbl">Movimiento</label>
                            <select class="po-input" @bind="_rvEvento">
                                <option value="@TipoEventoAccesoPorteria.Ingreso">Ingreso</option>
                                <option value="@TipoEventoAccesoPorteria.Egreso">Salida</option>
                            </select>
                        </div>
                    </div>
                    <div class="po-form-2">
                        <div>
                            <label class="po-lbl">Conductor</label>
                            <input class="po-input" placeholder="Opcional" @bind="_rvConductor" @bind:event="oninput" />
                        </div>
                        <div>
                            <label class="po-lbl">Observacion</label>
                            <input class="po-input" placeholder="Opcional" @bind="_rvObs" @bind:event="oninput" />
                        </div>
                    </div>
                    <button class="po-btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_rvPlaca))" @onclick="RegistrarMovimientoVehiculo">Registrar movimiento</button>
                    <div class="po-note">La placa se coteja con los vehiculos autorizados: si coincide se marca como residente y su unidad; si no, queda como visita.</div>
                </div>

                <div class="po-card-h" style="margin-top:16px">Minuta vehicular (turno actual)</div>
                @if (_regVehiculos is null)
                {
                    <div class="po-empty" style="padding:22px 0">Cargando...</div>
                }
                else if (_regVehiculos.Count == 0)
                {
                    <div class="po-empty" style="padding:26px 0">Sin movimientos de vehiculos en este turno.</div>
                }
                else
                {
                    <table class="po-table">
                        <thead><tr><th>Hora</th><th>Mov.</th><th>Placa</th><th>Tipo</th><th>Unidad</th><th>Conductor</th></tr></thead>
                        <tbody>
                            @foreach (var r in _regVehiculos)
                            {
                                <tr>
                                    <td>@r.Timestamp.ToCo().ToString("HH:mm")</td>
                                    <td>@(r.TipoEvento == TipoEventoAccesoPorteria.Ingreso ? "Ingreso" : "Salida")</td>
                                    <td><strong>@r.Placa</strong></td>
                                    <td>@(r.EsVisita ? "Visita" : "Residente")</td>
                                    <td>@(string.IsNullOrEmpty(r.UnidadNumero) ? "-" : r.UnidadNumero)</td>
                                    <td>@(string.IsNullOrEmpty(r.Conductor) ? "-" : r.Conductor)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
        <div class="po-grid2">
            <div class="po-card">
                <div class="po-card-h">Vehiculos autorizados</div>
                @if (_vehiculos is null)
                {
                    <div class="po-empty" style="padding:30px 0">Cargando...</div>
                }
                else if (_vehiculos.Count == 0)
                {
                    <div class="po-empty" style="padding:34px 0">Sin vehiculos autorizados aun.</div>
                }
                else
                {
                    <table class="po-table">
                        <thead><tr><th>Placa</th><th>Tipo</th><th>Unidad</th><th>Marca / Modelo</th><th>Parqueadero</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var v in _vehiculos)
                            {
                                var vid = v.Id;
                                <tr>
                                    <td><strong>@v.Placa</strong></td>
                                    <td>@v.Tipo</td>
                                    <td>@v.UnidadNumero</td>
                                    <td>@($"{v.Marca} {v.Modelo}".Trim())@(string.IsNullOrEmpty(v.Color) ? "" : " - " + v.Color)</td>
                                    <td>@(string.IsNullOrEmpty(v.ParqueaderoAsignado) ? "-" : v.ParqueaderoAsignado)</td>
                                    <td><button class="po-mini-danger" @onclick="() => DesactivarVehiculo(vid)">Desactivar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="po-card po-form-card">
                <div class="po-card-h">Autorizar vehiculo</div>
                <div class="po-form-body">
                    <label class="po-lbl">Unidad *</label>
                    <SelectorUnidadCodigo Unidades="_unidades"
                                           UnidadId="@(_vUnidad == Guid.Empty ? (Guid?)null : _vUnidad)"
                                           UnidadIdChanged="@(v => _vUnidad = v ?? Guid.Empty)"
                                           Class="po-input" Placeholder="Codigo de unidad (ej. 101, A-203)..." />
                    <label class="po-lbl">Placa *</label>
                    <input class="po-input" maxlength="10" placeholder="ABC123" @bind="_vPlaca" @bind:event="oninput" />
                    <div class="po-form-2">
                        <div>
                            <label class="po-lbl">Tipo</label>
                            <select class="po-input" @bind="_vTipo">
                                @foreach (var t in Enum.GetValues<TipoVehiculo>()) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div>
                            <label class="po-lbl">Parqueadero</label>
                            <input class="po-input" placeholder="Opcional" @bind="_vParq" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="po-form-2">
                        <div>
                            <label class="po-lbl">Marca</label>
                            <input class="po-input" placeholder="Opcional" @bind="_vMarca" @bind:event="oninput" />
                        </div>
                        <div>
                            <label class="po-lbl">Modelo</label>
                            <input class="po-input" placeholder="Opcional" @bind="_vModelo" @bind:event="oninput" />
                        </div>
                    </div>
                    <button class="po-btn-primary" disabled="@(_busy || _vUnidad == Guid.Empty || string.IsNullOrWhiteSpace(_vPlaca))" @onclick="CrearVehiculo">Autorizar vehiculo</button>
                </div>
            </div>
        </div>
    }

    @* =================== PAQUETES / CORRESPONDENCIA =================== *@
    @if (_view == "paquetes")
    {
        <div class="po-grid2">
            <div class="po-card">
                <div class="po-card-h">Paquetes pendientes</div>
                @{
                    var pend = _correspondencia?.Where(c => c.Estado == EstadoCorrespondencia.Recibido || c.Estado == EstadoCorrespondencia.Notificado).ToList();
                }
                @if (_correspondencia is null)
                {
                    <div class="po-empty" style="padding:30px 0">Cargando...</div>
                }
                else if (pend is null || pend.Count == 0)
                {
                    <div class="po-empty" style="padding:34px 0">No hay paquetes pendientes de entrega.</div>
                }
                else
                {
                    <table class="po-table">
                        <thead><tr><th></th><th>Unidad</th><th>Tipo</th><th>Remitente</th><th>Recibido</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in pend)
                            {
                                var pid = p.Id;
                                <tr>
                                    <td>@RenderSemaforo(p.Semaforo)</td>
                                    <td>@p.UnidadNumero</td>
                                    <td>@p.Tipo</td>
                                    <td>@(string.IsNullOrEmpty(p.Remitente) ? "-" : p.Remitente)</td>
                                    <td class="po-cell-sub">@p.RecibidoAt.LocalDateTime.ToString("MM-dd HH:mm")</td>
                                    <td>
                                        <button class="po-mini-ok" @onclick="() => EntregarPaquete(pid)">Entregar</button>
                                        <button class="po-mini-danger" @onclick="() => DevolverPaquete(pid)">Devolver</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="po-card po-form-card">
                <div class="po-card-h">Registrar paquete</div>
                <div class="po-form-body">
                    <label class="po-lbl">Unidad destinataria *</label>
                    <SelectorUnidadCodigo Unidades="_unidades"
                                           UnidadId="@(_paqUnidad == Guid.Empty ? (Guid?)null : _paqUnidad)"
                                           UnidadIdChanged="@(v => _paqUnidad = v ?? Guid.Empty)"
                                           Class="po-input" Placeholder="Codigo de unidad (ej. 101, A-203)..." />
                    <div class="po-form-2">
                        <div>
                            <label class="po-lbl">Tipo</label>
                            <select class="po-input" @bind="_paqTipo">
                                @foreach (var t in Enum.GetValues<TipoCorrespondencia>()) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div>
                            <label class="po-lbl">Remitente</label>
                            <input class="po-input" placeholder="Opcional" @bind="_paqRemitente" @bind:event="oninput" />
                        </div>
                    </div>
                    @if (_turno is null)
                    {
                        <div class="po-note">Abre un turno (vista Operacion) para registrar paquetes.</div>
                    }
                    <button class="po-btn-primary" disabled="@(_busy || _turno is null || _paqUnidad == Guid.Empty)" @onclick="RegistrarPaquete">Registrar paquete</button>
                </div>
            </div>
        </div>
    }

    @* =================== CONFIGURACION =================== *@
    @if (_view == "config")
    {
        <div class="po-card" style="max-width:720px">
            <div class="po-card-h">Configuracion del modulo</div>
            @if (_config is null)
            {
                <div class="po-empty" style="padding:30px 0">Cargando...</div>
            }
            else
            {
                <div class="po-form-body">
                    <label class="po-check">
                        <input type="checkbox" @bind="_cfgDestinoObl" />
                        Destino del visitante obligatorio al registrar
                    </label>
                    <div class="po-form-2">
                        <div>
                            <label class="po-lbl">Canal de notificacion de paquetes</label>
                            <select class="po-input" @bind="_cfgCanal">
                                @foreach (var c in Enum.GetValues<CanalNotificacionPaquete>()) { <option value="@c">@c</option> }
                            </select>
                        </div>
                        <div>
                            <label class="po-lbl">Retencion datos visitantes (dias)</label>
                            <input type="number" class="po-input" @bind="_cfgRetencion" />
                        </div>
                    </div>
                    <div class="po-form-2">
                        <div>
                            <label class="po-lbl">Umbral paquete amarillo (min)</label>
                            <input type="number" class="po-input" @bind="_cfgAmarillo" />
                        </div>
                        <div>
                            <label class="po-lbl">Umbral paquete rojo (min)</label>
                            <input type="number" class="po-input" @bind="_cfgRojo" />
                        </div>
                    </div>
                    <label class="po-check">
                        <input type="checkbox" @bind="_cfgAutoQr" />
                        Autoregistro por QR activo
                    </label>
                    <label class="po-check">
                        <input type="checkbox" @bind="_cfgNovedadTarea" />
                        Generar tarea automatica desde novedad
                    </label>
                    <button class="po-btn-primary" disabled="@_busy" @onclick="GuardarConfig">Guardar configuracion</button>
                </div>
            }
        </div>

        <div class="po-card" style="max-width:720px;margin-top:14px">
            <div class="po-card-h">Campos personalizados del ingreso</div>
            <div class="po-form-body">
                <div class="po-note" style="background:#F5F8FA;border-color:#E1E8EE;color:#516F90">Campos tipados que apareceran al registrar el ingreso y en la minuta. Patron del proyecto hermano.</div>
                @if (_campos is { Count: > 0 })
                {
                    <div class="poc-campos">
                        @foreach (var c in _campos)
                        {
                            var campo = c;
                            <div class="poc-campo @(_campoDraft.Id == c.Id ? "on" : "")">
                                <div class="poc-campo-id">
                                    <span class="poc-campo-nom">@c.Label</span>
                                    <span class="poc-campo-tipo">@TipoCampoLabel(c.Tipo)</span>
                                    @if (c.MostrarEnFiltro) { <span class="poc-campo-filt">filtro</span> }
                                </div>
                                <button class="po-mini-ok" @onclick="() => EditCampo(campo)">Editar</button>
                                <button class="po-mini-danger" @onclick="() => EliminarCampo(campo.Id)">Quitar</button>
                            </div>
                        }
                    </div>
                }
                <div class="poc-editor">
                    <div class="po-lbl" style="font-weight:800">@(_campoDraft.Id is null ? "Nuevo campo" : "Editar campo")</div>
                    <div class="po-form-2">
                        <input class="po-input" @bind="_campoDraft.Label" @bind:event="oninput" placeholder="Nombre (ej. Empresa)" />
                        <select class="po-input" @bind="_campoDraft.Tipo">
                            @foreach (var tp in Enum.GetValues<TipoCampoTablero>()) { <option value="@tp">@TipoCampoLabel(tp)</option> }
                        </select>
                    </div>
                    @if (_campoDraft.Tipo == TipoCampoTablero.Seleccion)
                    {
                        <textarea class="po-input" rows="3" @bind="_campoDraft.Opciones" @bind:event="oninput" placeholder="Una opcion por linea"></textarea>
                    }
                    <input class="po-input" @bind="_campoDraft.Descripcion" @bind:event="oninput" placeholder="Descripcion / ayuda (opcional)" />
                    <div class="po-form-2">
                        <label class="po-check"><input type="checkbox" @bind="_campoDraft.MostrarEnFiltro" /> Mostrar en filtros</label>
                        <select class="po-input" @bind="_campoDraft.Columna">
                            <option value="1">Ancho normal</option>
                            <option value="2">Ancho completo</option>
                        </select>
                    </div>
                    <div style="display:flex;gap:8px;justify-content:flex-end">
                        @if (_campoDraft.Id is not null) { <button class="po-btn-ghost" @onclick="NuevoCampo">Cancelar</button> }
                        <button class="po-btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_campoDraft.Label))" @onclick="GuardarCampo">@(_campoDraft.Id is null ? "Agregar campo" : "Guardar campo")</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* =================== MODAL REGISTRAR INGRESO (agente IA + WhatsApp) =================== *@
@if (_showRegistrar)
{
    <div class="po-ov" @onclick="CerrarRegistrar">
        <div class="po-modal" @onclick:stopPropagation="true">
            <div class="po-modal-head">
                <div class="po-modal-ic">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"></path></svg>
                </div>
                <div class="po-modal-tt">
                    <div class="po-modal-t">Registrar ingreso</div>
                    <div class="po-modal-s">El portero solo solicita el permiso &mdash; el <b style="color:#6D4FE3">agente IA</b> lo gestiona con el residente por WhatsApp.</div>
                </div>
                <button class="po-modal-x" @onclick="CerrarRegistrar">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="po-modal-body">
                <div class="po-form-pane">
                    <div>
                        <label class="po-lbl">Quien llega? *</label>
                        <input class="po-input" placeholder="Ej. Carlos Perez" value="@_viNombre" @oninput="OnViNombre" />
                        @if (_viSugs.Count > 0)
                        {
                            <div class="po-sugs">
                                <div class="po-sugs-l">VISITANTE AUTORIZADO - TRAE SU APARTAMENTO</div>
                                @foreach (var sg in _viSugs)
                                {
                                    var s = sg;
                                    <button class="po-sug" @onclick="() => PickSug(s)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6D4FE3" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"></path></svg>
                                        <span class="po-sug-n">@s.NombreVisitante</span>
                                        <span class="po-sug-u">@s.UnidadNumero</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="po-form-2">
                        <div>
                            <label class="po-lbl">Tipo de ingreso</label>
                            <select class="po-input" @bind="_viTipo">
                                <option value="@TipoVisitante.VisitaPersonal">Visitante</option>
                                <option value="@TipoVisitante.Proveedor">Proveedor</option>
                                <option value="@TipoVisitante.Delivery">Domicilio</option>
                                <option value="@TipoVisitante.PersonalExterno">Personal externo</option>
                                <option value="@TipoVisitante.Otro">Otro</option>
                            </select>
                        </div>
                        <div>
                            <label class="po-lbl">Documento</label>
                            <input class="po-input" placeholder="CC (opcional)" @bind="_viDoc" @bind:event="oninput" />
                        </div>
                    </div>
                    <div>
                        <label class="po-lbl">Unidad destino *</label>
                        <SelectorUnidadCodigo Unidades="_unidades"
                                               UnidadId="@(_viDestino == Guid.Empty ? (Guid?)null : _viDestino)"
                                               UnidadIdChanged="@(v => _viDestino = v ?? Guid.Empty)"
                                               Class="po-input" Placeholder="Codigo de unidad (ej. 101, A-203)..." />
                    </div>
                    <div>
                        <label class="po-lbl">Motivo <span style="font-weight:600;color:#A6B7C8">(opcional)</span></label>
                        <input class="po-input" placeholder="Ej. Visita familiar - Reparacion" @bind="_viMotivo" @bind:event="oninput" />
                    </div>
                    @if (_campos is { Count: > 0 })
                    {
                        <div class="po-campos-grid">
                            @foreach (var c in _campos)
                            {
                                var campo = c;
                                <div class="po-campo-fld @(c.Columna >= 2 ? "full" : "")">
                                    <label class="po-lbl" title="@c.Descripcion">@c.Label</label>
                                    @switch (c.Tipo)
                                    {
                                        case TipoCampoTablero.AreaTexto:
                                            <textarea class="po-input" rows="2" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="@c.Descripcion"></textarea>
                                            break;
                                        case TipoCampoTablero.Numero:
                                        case TipoCampoTablero.Moneda:
                                            <input class="po-input" type="number" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="@c.Descripcion" />
                                            break;
                                        case TipoCampoTablero.Fecha:
                                            <input class="po-input" type="date" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" />
                                            break;
                                        case TipoCampoTablero.Hora:
                                            <input class="po-input" type="time" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" />
                                            break;
                                        case TipoCampoTablero.Telefono:
                                            <input class="po-input" type="tel" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="@c.Descripcion" />
                                            break;
                                        case TipoCampoTablero.Seleccion:
                                            <select class="po-input" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)">
                                                <option value="">Seleccionar...</option>
                                                @foreach (var op in CampoOpciones(c)) { <option value="@op">@op</option> }
                                            </select>
                                            break;
                                        case TipoCampoTablero.Booleano:
                                            <label class="po-check"><input type="checkbox" checked="@CampoBool(campo.Id)" @onchange="(e) => SetCampoBool(campo.Id, e)" /> Si</label>
                                            break;
                                        default:
                                            <input class="po-input" type="text" value="@CampoVal(campo.Id)" @onchange="(e) => SetCampoVal(campo.Id, e)" placeholder="@c.Descripcion" />
                                            break;
                                    }
                                </div>
                            }
                        </div>
                    }
                    <div class="po-ia-note">
                        <div class="po-ia-ic">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a7 7 0 0 1 7 7v1h1a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-1a7 7 0 0 1-14 0H4a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h1V9a7 7 0 0 1 7-7z"></path><circle cx="9" cy="13" r="1"></circle><circle cx="15" cy="13" r="1"></circle></svg>
                        </div>
                        <div>Al solicitar el permiso, el agente toma el contacto del residente y <b>gestiona la autorizacion por WhatsApp</b>. El portero no necesita llamar.</div>
                    </div>
                    <button class="po-btn-wa" disabled="@(_busy || string.IsNullOrWhiteSpace(_viNombre) || _viDestino == Guid.Empty || _viAwait || _viOk)" @onclick="SolicitarPermiso">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2z"></path></svg>
                        Solicitar permiso de ingreso
                    </button>
                    <button class="po-btn-ghost" disabled="@(_busy || string.IsNullOrWhiteSpace(_viNombre))" @onclick="RegistrarDirecto">Registrar directo (sin solicitar permiso)</button>
                    <div class="po-rn09">Aviso de tratamiento de datos informado al visitante (RN-09).</div>
                </div>

                @* WhatsApp pane *@
                <div class="po-wa-pane">
                    <div class="po-wa-head">
                        <div class="po-wa-av">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"></path></svg>
                        </div>
                        <div class="po-wa-id">
                            <div class="po-wa-name">@(_waResName)</div>
                            <div class="po-wa-tel">@(_waResTel) &middot; residente</div>
                        </div>
                        <span class="po-wa-tag"><span class="po-wa-tag-dot"></span>AGENTE IA EN CONTROL</span>
                    </div>
                    <div class="po-wa-body">
                        @if (_viChat.Count == 0)
                        {
                            <div class="po-wa-empty">
                                <div class="po-wa-empty-ic">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="#25D366"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2z"></path></svg>
                                </div>
                                Completa los datos y solicita el permiso. El agente IA iniciara la conversacion de WhatsApp con el residente.
                            </div>
                        }
                        @foreach (var m in _viChat)
                        {
                            @RenderChat(m)
                        }
                        @if (_viTyping)
                        {
                            <div class="po-wa-typing"><span></span><span></span><span></span></div>
                        }
                    </div>
                    <div class="po-wa-foot">
                        @if (_viAwait)
                        {
                            <div class="po-wa-sim-l">SIMULAR RESPUESTA DEL RESIDENTE</div>
                            <div class="po-wa-sim">
                                <button class="po-wa-yes" @onclick="SimSi">Si, autorizado</button>
                                <button class="po-wa-no" @onclick="SimNo">No autorizo</button>
                            </div>
                        }
                        else if (_viOk)
                        {
                            <div class="po-wa-res ok">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#1A8754" stroke-width="2.6"><path d="M5 12l5 5 9-11"></path></svg>
                                <div>Ingreso autorizado y registrado en la minuta</div>
                                <button @onclick="CerrarRegistrar">Listo</button>
                            </div>
                        }
                        else if (_viNo)
                        {
                            <div class="po-wa-res no">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#C0383C" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                                <div>Ingreso denegado - quedo en la minuta</div>
                                <button @onclick="CerrarRegistrar">Cerrar</button>
                            </div>
                        }
                        else
                        {
                            <div class="po-wa-locked">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
                                El chat se activa cuando el portero solicita el permiso
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* =================== MODAL VERIFICACION DE PERMANENCIA (+3h) =================== *@
@if (_showVf)
{
    <div class="po-ov" @onclick="CerrarVf">
        <div class="po-vf" @onclick:stopPropagation="true">
            <div class="po-vf-head">
                <div class="po-wa-av"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"></path></svg></div>
                <div class="po-wa-id">
                    <div class="po-wa-name">@_waResName</div>
                    <div class="po-wa-tel">Control de permanencia &middot; @(_vfReg?.Nombre)</div>
                </div>
                <button class="po-vf-x" @onclick="CerrarVf"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
            </div>
            <div class="po-wa-body">
                @foreach (var m in _vfChat)
                {
                    @RenderChat(m)
                }
                @if (_vfTyping)
                {
                    <div class="po-wa-typing"><span></span><span></span><span></span></div>
                }
            </div>
            <div class="po-wa-foot">
                @if (_vfAwait)
                {
                    <div class="po-wa-sim-l">SIMULAR RESPUESTA DEL RESIDENTE</div>
                    <div class="po-wa-sim">
                        <button class="po-wa-yes" @onclick="VfSi">Si, sigue aqui</button>
                        <button class="po-wa-no neutral" @onclick="VfNo">Ya salio</button>
                    </div>
                }
                else if (_vfSigue)
                {
                    <div class="po-wa-res ok">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#1A8754" stroke-width="2.6"><path d="M5 12l5 5 9-11"></path></svg>
                        <div>Permanencia verificada con el residente</div>
                        <button @onclick="CerrarVf">Listo</button>
                    </div>
                }
                else if (_vfSalio)
                {
                    <div class="po-wa-res neutral">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#516F90" stroke-width="2.2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg>
                        <div>Salida registrada en la minuta</div>
                        <button @onclick="CerrarVf">Listo</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* =================== MODAL CREAR AUTORIZACION =================== *@
@if (_showCrearAuth)
{
    <div class="po-ov" @onclick="() => _showCrearAuth = false">
        <div class="po-small" @onclick:stopPropagation="true">
            <div class="po-modal-head">
                <div class="po-modal-tt"><div class="po-modal-t">Nueva autorizacion previa</div></div>
                <button class="po-modal-x" @onclick="() => _showCrearAuth = false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
            </div>
            <div class="po-form-body" style="padding:20px 22px">
                <label class="po-lbl">Unidad *</label>
                <SelectorUnidadCodigo Unidades="_unidades"
                                       UnidadId="@(_authUnidad == Guid.Empty ? (Guid?)null : _authUnidad)"
                                       UnidadIdChanged="@(v => _authUnidad = v ?? Guid.Empty)"
                                       Class="po-input" Placeholder="Codigo de unidad (ej. 101, A-203)..." />
                <label class="po-lbl">Nombre del visitante *</label>
                <input class="po-input" @bind="_authNombre" @bind:event="oninput" />
                <div class="po-form-2">
                    <div>
                        <label class="po-lbl">Documento</label>
                        <input class="po-input" placeholder="Opcional" @bind="_authDoc" @bind:event="oninput" />
                    </div>
                    <div>
                        <label class="po-lbl">Tipo</label>
                        <select class="po-input" @bind="_authTipo">
                            @foreach (var t in Enum.GetValues<TipoVisitante>()) { <option value="@t">@TipoLabel(t)</option> }
                        </select>
                    </div>
                </div>
                <div class="po-form-2">
                    <div>
                        <label class="po-lbl">Vigencia inicio *</label>
                        <input type="datetime-local" class="po-input" @bind="_authIni" />
                    </div>
                    <div>
                        <label class="po-lbl">Vigencia fin *</label>
                        <input type="datetime-local" class="po-input" @bind="_authFin" />
                    </div>
                </div>
                <label class="po-lbl">Nota para el portero</label>
                <textarea class="po-input" rows="2" @bind="_authNota" @bind:event="oninput"></textarea>
                <div class="po-modal-foot">
                    <button class="po-btn-ghost" style="flex:1" @onclick="() => _showCrearAuth = false">Cancelar</button>
                    <button class="po-btn-primary" style="flex:1" disabled="@(_busy || _authUnidad == Guid.Empty || string.IsNullOrWhiteSpace(_authNombre))" @onclick="CrearAutorizacion">@(_busy ? "Creando..." : "Crear")</button>
                </div>
            </div>
        </div>
    </div>
}

@* =================== MODAL REGISTRAR NOVEDAD =================== *@
@if (_showNovedad)
{
    <div class="po-ov" @onclick="CerrarNovedad">
        <div class="po-small" @onclick:stopPropagation="true">
            <div class="po-modal-head">
                <div class="po-modal-tt"><div class="po-modal-t">Registrar novedad</div><div class="po-modal-s">Novedad, dano o reclamo del turno</div></div>
                <button class="po-modal-x" @onclick="CerrarNovedad"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg></button>
            </div>
            <div class="po-form-body" style="padding:20px 22px">
                <div class="po-form-2">
                    <div>
                        <label class="po-lbl">Tipo</label>
                        <select class="po-input" @bind="_nvTipo">
                            @foreach (var tp in Enum.GetValues<TipoNovedadPorteria>()) { <option value="@tp">@TipoNovedadLabel(tp)</option> }
                        </select>
                    </div>
                    <div>
                        <label class="po-lbl">Asignar a</label>
                        <select class="po-input" value="@_nvDestinoTipo" @onchange="OnNvDestinoTipo">
                            <option value="">Sin asignar</option>
                            <option value="unidad">Inmueble / unidad</option>
                            <option value="zona">Zona comun</option>
                            <option value="equipo">Equipo / activo</option>
                        </select>
                    </div>
                </div>
                @if (_nvDestinoTipo == "unidad")
                {
                    <div>
                        <label class="po-lbl">Inmueble</label>
                        <SelectorUnidadCodigo Unidades="_unidades"
                                               UnidadId="@(_nvDestinoId == Guid.Empty ? (Guid?)null : _nvDestinoId)"
                                               UnidadIdChanged="@(v => _nvDestinoId = v ?? Guid.Empty)"
                                               Class="po-input" Placeholder="Codigo de unidad (ej. 101, A-203)..." />
                    </div>
                }
                else if (_nvDestinoTipo == "zona")
                {
                    <div>
                        <label class="po-lbl">Zona comun</label>
                        <select class="po-input" @bind="_nvDestinoId">
                            <option value="@Guid.Empty">Seleccionar...</option>
                            @if (_zonas is not null) { @foreach (var z in _zonas) { <option value="@z.Id">@z.Nombre</option> } }
                        </select>
                    </div>
                }
                else if (_nvDestinoTipo == "equipo")
                {
                    <div>
                        <label class="po-lbl">Equipo / activo</label>
                        <select class="po-input" @bind="_nvDestinoId">
                            <option value="@Guid.Empty">Seleccionar...</option>
                            @if (_equipos is not null) { @foreach (var e in _equipos) { <option value="@e.Id">@e.Nombre</option> } }
                        </select>
                    </div>
                }
                <div>
                    <label class="po-lbl">Descripcion *</label>
                    <textarea class="po-input" rows="3" @bind="_nvDescripcion" @bind:event="oninput" placeholder="Describe la novedad, dano o reclamo..."></textarea>
                </div>
                <label class="po-check"><input type="checkbox" @bind="_nvGeneraTarea" /> Generar tarea de seguimiento</label>
                <div class="po-modal-foot">
                    <button class="po-btn-ghost" style="flex:1" @onclick="CerrarNovedad">Cancelar</button>
                    <button class="po-btn-primary" style="flex:1" disabled="@(_busy || _turno is null || string.IsNullOrWhiteSpace(_nvDescripcion))" @onclick="RegistrarNovedad">Registrar</button>
                </div>
                @if (_turno is null) { <div class="po-note">Abre un turno (vista Operacion) para registrar novedades.</div> }
            </div>
        </div>
    </div>
}

