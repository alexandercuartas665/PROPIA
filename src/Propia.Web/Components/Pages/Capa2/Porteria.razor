        if (v == "paquetes" && _correspondencia is null)
            _correspondencia = await http.GetFromJsonAsync<List<CorrespondenciaDto>>("/api/porteria/correspondencia") ?? new();
        if (v == "vehiculos" && _turno is not null)
            await CargarRegistrosVehiculoAsync();
        if (v == "config" && _config is null)
        {
            _config = await http.GetFromJsonAsync<ConfiguracionDto>("/api/porteria/configuracion");
            if (_config is not null)
            {
                _cfgDestinoObl = _config.DestinoVisitanteObligatorio;
                _cfgCanal = _config.CanalNotificacionPaquetes;
                _cfgAmarillo = _config.UmbralPaqueteAmarilloMin;
                _cfgRojo = _config.UmbralPaqueteRojoMin;
                _cfgAutoQr = _config.AutoregistroQrActivo;
                _cfgNovedadTarea = _config.GeneraTareaDesdeNovedad;
                _cfgRetencion = _config.RetencionDatosVisitantesDias;
            }
        }
