    private async Task RegistrarDirecto()
    {
        if (_turno is null) { Flash("Abre un turno (vista Operacion) antes de registrar.", false); return; }
        var ok = await RegistrarVisitaBackend(string.IsNullOrWhiteSpace(_viMotivo) ? null : _viMotivo);
        if (ok) { _showRegistrar = false; await RefrescarOperacionAsync(); Flash("Ingreso registrado en la minuta.", true); }
    }

    private async Task<bool> RegistrarVisitaBackend(string? observacion)
    {
        _busy = true;
        try
        {
            DestinoVisita? destinoTipo = _viDestino != Guid.Empty ? DestinoVisita.UnidadPrivada : null;
            Guid? destinoId = _viDestino != Guid.Empty ? _viDestino : null;
            var campos = (_campos ?? new()).Select(c => new PorteriaCampoValorDto(c.Id, _viCampos.GetValueOrDefault(c.Id))).ToList();
            var req = new RegistrarVisitaRequest(TipoEventoAccesoPorteria.Ingreso, _viTipo, _viNombre,
                string.IsNullOrWhiteSpace(_viDoc) ? null : _viDoc, null, destinoTipo, destinoId, null, null, observacion, true, campos);
            var resp = await Auth().PostAsJsonAsync($"/api/porteria/turnos/{_turno!.Id}/visitas", req);
            if (!resp.IsSuccessStatusCode) { Flash(await resp.Content.ReadAsStringAsync(), false); return false; }
            return true;
        }
        finally { _busy = false; }
    }

    private async Task RegistrarEgreso(RegistroVisitaDto v)
    {
        await RegistrarEgresoCore(v.TipoVisitante, v.Nombre, v.Documento, v.DestinoTipo, v.DestinoId);
    }

    private async Task RegistrarEgreso(AdentroItem a)
    {
        DestinoVisita? dt = a.DestinoNombre is not null ? DestinoVisita.UnidadPrivada : null;
        await RegistrarEgresoCore(a.TipoVisitante, a.Nombre, a.Documento, dt, null);
    }

    private async Task RegistrarEgresoCore(TipoVisitante tipo, string nombre, string? doc, DestinoVisita? dt, Guid? did)
    {
        if (_turno is null) { Flash("No hay turno abierto.", false); return; }
        var req = new RegistrarVisitaRequest(TipoEventoAccesoPorteria.Egreso, tipo, nombre, doc, null, dt, did, null, null, null, true);
        var resp = await Auth().PostAsJsonAsync($"/api/porteria/turnos/{_turno.Id}/visitas", req);
        if (resp.IsSuccessStatusCode) { await RefrescarOperacionAsync(); Flash($"Salida registrada: {nombre}.", true); }
        else Flash(await resp.Content.ReadAsStringAsync(), false);
    }

    // ----- Verificacion permanencia (modal) -----
    private async Task AbrirVerificacion(AdentroItem a)
    {
        _vfReg = a;
        _showVf = true;
        _vfChat = new();
        _vfTyping = _vfAwait = _vfSigue = _vfSalio = false;
        var u = _adentro.FirstOrDefault();
        _waResName = a.DestinoNombre ?? "Residente";
        var hora = DateTime.Now.ToString("HH:mm");
        _vfChat.Add(new ChatMsg("sys", "Control de permanencia automatico (+3h).", hora));
        _vfChat.Add(new ChatMsg("agent", $"Hola, {a.Nombre} ingreso hace mas de 3 horas hacia {a.DestinoNombre ?? "su unidad"}. Sigue contigo?", hora));
        _vfTyping = true; StateHasChanged();
        await Task.Delay(800);
        _vfTyping = false; _vfAwait = true; StateHasChanged();
    }

    private void CerrarVf() => _showVf = false;

    private async Task VfSi()
    {
        _vfAwait = false;
        _vfChat.Add(new ChatMsg("res", "Si, sigue aqui conmigo.", DateTime.Now.ToString("HH:mm")));
        _vfTyping = true; StateHasChanged();
        await Task.Delay(600);
        _vfTyping = false;
        _vfChat.Add(new ChatMsg("agent", "Perfecto, mantengo el registro activo.", DateTime.Now.ToString("HH:mm")));
        _vfSigue = true; StateHasChanged();
    }

    private async Task VfNo()
    {
        _vfAwait = false;
        _vfChat.Add(new ChatMsg("res", "Ya salio.", DateTime.Now.ToString("HH:mm")));
        _vfTyping = true; StateHasChanged();
        await Task.Delay(600);
        _vfTyping = false;
        if (_vfReg is not null)
        {
            DestinoVisita? dt = _vfReg.DestinoNombre is not null ? DestinoVisita.UnidadPrivada : null;
            await RegistrarEgresoCore(_vfReg.TipoVisitante, _vfReg.Nombre, _vfReg.Documento, dt, null);
        }
        _vfSalio = true; StateHasChanged();
    }

    // ----- Autorizaciones -----
    private async Task CrearAutorizacion()
    {
        _busy = true;
        try
        {
            var req = new CrearAutorizacionRequest(_authUnidad, _authNombre,
                string.IsNullOrWhiteSpace(_authDoc) ? null : _authDoc, _authTipo,
                new DateTimeOffset(_authIni, TimeSpan.Zero), new DateTimeOffset(_authFin, TimeSpan.Zero),
                string.IsNullOrWhiteSpace(_authNota) ? null : _authNota, 1, OrigenAutorizacion.Administrador);
            var resp = await Auth().PostAsJsonAsync("/api/porteria/autorizaciones", req);
            if (!resp.IsSuccessStatusCode) { Flash(await resp.Content.ReadAsStringAsync(), false); return; }
            _showCrearAuth = false;
            _authNombre = _authDoc = _authNota = "";
            _autorizaciones = await Auth().GetFromJsonAsync<List<AutorizacionPreviaDto>>("/api/porteria/autorizaciones?estado=1") ?? new();
            Flash("Autorizacion creada.", true);
        }
        finally { _busy = false; }
    }

    private async Task RevocarAutorizacion(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/porteria/autorizaciones/{id}");
        if (resp.IsSuccessStatusCode)
            _autorizaciones = await Auth().GetFromJsonAsync<List<AutorizacionPreviaDto>>("/api/porteria/autorizaciones?estado=1") ?? new();
    }

    // ----- Vehiculos -----
    private async Task CrearVehiculo()
    {
        _busy = true;
        try
        {
            var req = new CrearVehiculoRequest(_vUnidad, _vPlaca.ToUpperInvariant(), _vTipo,
                string.IsNullOrWhiteSpace(_vMarca) ? null : _vMarca,
                string.IsNullOrWhiteSpace(_vModelo) ? null : _vModelo, null,
                string.IsNullOrWhiteSpace(_vParq) ? null : _vParq);
            var resp = await Auth().PostAsJsonAsync("/api/porteria/vehiculos", req);
            if (!resp.IsSuccessStatusCode) { Flash(await resp.Content.ReadAsStringAsync(), false); return; }
            _vPlaca = _vMarca = _vModelo = _vParq = ""; _vUnidad = Guid.Empty;
            _vehiculos = await Auth().GetFromJsonAsync<List<VehiculoAutorizadoDto>>("/api/porteria/vehiculos") ?? new();
            Flash("Vehiculo autorizado.", true);
        }
        finally { _busy = false; }
    }

    private async Task DesactivarVehiculo(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/porteria/vehiculos/{id}");
        if (resp.IsSuccessStatusCode)
            _vehiculos = await Auth().GetFromJsonAsync<List<VehiculoAutorizadoDto>>("/api/porteria/vehiculos") ?? new();
    }

    // Registra un ingreso/egreso de vehiculo en el turno actual (queda append-only en la minuta vehicular).
    private async Task RegistrarMovimientoVehiculo()
    {
        if (_turno is null) { Flash("Abre un turno (vista Operacion) antes de registrar.", false); return; }
        if (string.IsNullOrWhiteSpace(_rvPlaca)) return;
        _busy = true;
        try
        {
            var req = new RegistrarVehiculoRequest(_rvEvento, _rvPlaca.ToUpperInvariant(),
                string.IsNullOrWhiteSpace(_rvConductor) ? null : _rvConductor.Trim(),
                string.IsNullOrWhiteSpace(_rvObs) ? null : _rvObs.Trim());
            var resp = await Auth().PostAsJsonAsync($"/api/porteria/turnos/{_turno.Id}/vehiculos", req);
            if (!resp.IsSuccessStatusCode) { Flash(await resp.Content.ReadAsStringAsync(), false); return; }
            _rvPlaca = _rvConductor = _rvObs = ""; _rvEvento = TipoEventoAccesoPorteria.Ingreso;
            await CargarRegistrosVehiculoAsync();
            _panel = await Auth().GetFromJsonAsync<PanelMonitoreoDto>("/api/porteria/panel");
            Flash("Movimiento vehicular registrado.", true);
        }
        finally { _busy = false; }
    }

    private async Task CargarRegistrosVehiculoAsync()
    {
        if (_turno is null) { _regVehiculos = new(); return; }
        _regVehiculos = await Auth().GetFromJsonAsync<List<RegistroVehiculoDto>>($"/api/porteria/vehiculos/registros?turnoId={_turno.Id}") ?? new();
    }

    // ----- Paquetes -----
    private async Task RegistrarPaquete()
    {
        if (_turno is null) return;
        _busy = true;
        try
        {
            var req = new RegistrarCorrespondenciaRequest(_paqUnidad, _paqTipo,
                string.IsNullOrWhiteSpace(_paqRemitente) ? null : _paqRemitente, null);
            var resp = await Auth().PostAsJsonAsync($"/api/porteria/turnos/{_turno.Id}/correspondencia", req);
            if (!resp.IsSuccessStatusCode) { Flash(await resp.Content.ReadAsStringAsync(), false); return; }
            _paqRemitente = ""; _paqUnidad = Guid.Empty;
            _correspondencia = await Auth().GetFromJsonAsync<List<CorrespondenciaDto>>("/api/porteria/correspondencia") ?? new();
            _panel = await Auth().GetFromJsonAsync<PanelMonitoreoDto>("/api/porteria/panel");
            Flash("Paquete registrado.", true);
        }
        finally { _busy = false; }
    }

    private async Task EntregarPaquete(Guid id)
    {
        var resp = await Auth().PutAsJsonAsync($"/api/porteria/correspondencia/{id}/entregar", new EntregarCorrespondenciaRequest(null));
        if (resp.IsSuccessStatusCode)
        {
            _correspondencia = await Auth().GetFromJsonAsync<List<CorrespondenciaDto>>("/api/porteria/correspondencia") ?? new();
            _panel = await Auth().GetFromJsonAsync<PanelMonitoreoDto>("/api/porteria/panel");
        }
    }

    private async Task DevolverPaquete(Guid id)
    {
        var resp = await Auth().PutAsJsonAsync($"/api/porteria/correspondencia/{id}/devolver", new DevolverCorrespondenciaRequest("Devuelto al transportista"));
        if (resp.IsSuccessStatusCode)
        {
            _correspondencia = await Auth().GetFromJsonAsync<List<CorrespondenciaDto>>("/api/porteria/correspondencia") ?? new();
            _panel = await Auth().GetFromJsonAsync<PanelMonitoreoDto>("/api/porteria/panel");
        }
    }

    // ----- Config -----
    private async Task GuardarConfig()
    {
        _busy = true;
        try
        {
            var req = new ActualizarConfiguracionRequest(_cfgDestinoObl, _cfgCanal, _cfgAmarillo, _cfgRojo, _cfgAutoQr, _cfgNovedadTarea, _cfgRetencion);
            var resp = await Auth().PutAsJsonAsync("/api/porteria/configuracion", req);
            if (!resp.IsSuccessStatusCode) { Flash(await resp.Content.ReadAsStringAsync(), false); return; }
            _config = await resp.Content.ReadFromJsonAsync<ConfiguracionDto>();
            Flash("Configuracion guardada.", true);
        }
        finally { _busy = false; }
    }

    // ----- Campos personalizados -----
    private void NuevoCampo() => _campoDraft = new CampoDraft();
    private void EditCampo(PorteriaCampoDto c) => _campoDraft = new CampoDraft
    {
        Id = c.Id, Label = c.Label, Tipo = c.Tipo, Opciones = c.Opciones ?? "",
        MostrarEnFiltro = c.MostrarEnFiltro, Columna = c.Columna < 1 ? 1 : c.Columna, Descripcion = c.Descripcion ?? ""
    };
    private async Task GuardarCampo()
    {
        if (string.IsNullOrWhiteSpace(_campoDraft.Label)) return;
        _busy = true;
        try
        {
            var body = new GuardarPorteriaCampoRequest(
                _campoDraft.Label.Trim(), _campoDraft.Tipo,
                _campoDraft.Tipo == TipoCampoTablero.Seleccion && !string.IsNullOrWhiteSpace(_campoDraft.Opciones) ? _campoDraft.Opciones.Trim() : null,
                _campoDraft.MostrarEnFiltro, _campoDraft.Columna,
                string.IsNullOrWhiteSpace(_campoDraft.Descripcion) ? null : _campoDraft.Descripcion.Trim());
            var resp = _campoDraft.Id is { } cid
                ? await Auth().PutAsJsonAsync($"/api/porteria/campos/{cid}", body)
                : await Auth().PostAsJsonAsync("/api/porteria/campos", body);
            if (!resp.IsSuccessStatusCode) { Flash(await resp.Content.ReadAsStringAsync(), false); return; }
            _campoDraft = new CampoDraft();
            _campos = await Auth().GetFromJsonAsync<List<PorteriaCampoDto>>("/api/porteria/campos") ?? new();
            Flash("Campo guardado.", true);
        }
        finally { _busy = false; }
    }
    private async Task EliminarCampo(Guid campoId)
    {
        var resp = await Auth().DeleteAsync($"/api/porteria/campos/{campoId}");
        if (resp.IsSuccessStatusCode)
        {
            if (_campoDraft.Id == campoId) _campoDraft = new CampoDraft();
            _campos = await Auth().GetFromJsonAsync<List<PorteriaCampoDto>>("/api/porteria/campos") ?? new();
        }
    }
