        _viChat.Add(new ChatMsg("res", "Si, lo autorizo.", DateTime.Now.ToString("HH:mm")));
        _viTyping = true; StateHasChanged();
        await Task.Delay(700);
        _viTyping = false;
        _viChat.Add(new ChatMsg("agent", "Gracias. Registro el ingreso en la minuta.", DateTime.Now.ToString("HH:mm")));
        StateHasChanged();
