    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarTodoAsync();
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task CargarTodoAsync()
    {
        try
        {
            var http = Auth();
            _panel = await http.GetFromJsonAsync<PanelMonitoreoDto>("/api/porteria/panel");
            _turno = _panel?.TurnoActivo;
            var today = DateOnly.FromDateTime(DateTime.Today);
            _visitasHoy = await http.GetFromJsonAsync<List<RegistroVisitaDto>>($"/api/porteria/visitas?fecha={today:yyyy-MM-dd}") ?? new();
            _autorizaciones = await http.GetFromJsonAsync<List<AutorizacionPreviaDto>>("/api/porteria/autorizaciones?estado=1") ?? new();
            _vehiculos = await http.GetFromJsonAsync<List<VehiculoAutorizadoDto>>("/api/porteria/vehiculos") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            _personas = await http.GetFromJsonAsync<List<PersonaMini>>("/api/directorio/personas") ?? new();
            _campos = await http.GetFromJsonAsync<List<PorteriaCampoDto>>("/api/porteria/campos") ?? new();
            _novedades = await http.GetFromJsonAsync<List<NovedadDto>>($"/api/porteria/novedades?fecha={today:yyyy-MM-dd}") ?? new();
            try { _zonas = await http.GetFromJsonAsync<List<ZonaMini>>("/api/mi-copropiedad/zonas") ?? new(); } catch { _zonas = new(); }
            try { _equipos = await http.GetFromJsonAsync<List<EquipoMini>>("/api/mi-copropiedad/equipos") ?? new(); } catch { _equipos = new(); }
            try
            {
                var resumen = await http.GetFromJsonAsync<ResumenWrap>("/api/mi-copropiedad/resumen");
                _coName = resumen?.Identidad?.Nombre ?? "";
            }
            catch { }
            RecomputarAdentro();
        }
        catch (Exception ex) { Flash(ex.Message, false); }
    }

    private void RecomputarAdentro()
    {
        _now = DateTimeOffset.Now;
        var inside = new Dictionary<string, AdentroItem>();
        foreach (var v in _visitasHoy.OrderBy(x => x.Timestamp))
        {
            var key = (v.Nombre + "|" + (v.Documento ?? "")).ToLowerInvariant();
            if (v.TipoEvento == TipoEventoAccesoPorteria.Ingreso)
            {
                inside[key] = new AdentroItem
                {
                    Nombre = v.Nombre,
                    Documento = v.Documento,
                    TipoVisitante = v.TipoVisitante,
                    DestinoNombre = v.DestinoNombre,
                    Observacion = v.Observacion,
                    Timestamp = v.Timestamp
                };
            }
            else
            {
                inside.Remove(key);
            }
        }
        _adentro = inside.Values.OrderByDescending(x => x.Timestamp).ToList();
    }

    private async Task RefrescarOperacionAsync()
    {
        var http = Auth();
        _panel = await http.GetFromJsonAsync<PanelMonitoreoDto>("/api/porteria/panel");
        _turno = _panel?.TurnoActivo;
        var today = DateOnly.FromDateTime(DateTime.Today);
        _visitasHoy = await http.GetFromJsonAsync<List<RegistroVisitaDto>>($"/api/porteria/visitas?fecha={today:yyyy-MM-dd}") ?? new();
        RecomputarAdentro();
    }

    private async Task CambiarVista(string v)
    {
        _view = v;
        _msg = null;
