    private static string FormatDur(TimeSpan d)
    {
        if (d.TotalMinutes < 1) return "ahora";
        if (d.TotalHours < 1) return $"{(int)d.TotalMinutes}m";
        return $"{(int)d.TotalHours}h {d.Minutes:D2}m";
    }

    private RenderFragment RenderChat(ChatMsg m) => builder =>
    {
        var seq = 0;
        if (m.Kind == "sys")
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "po-wa-sys");
            builder.AddContent(seq++, m.Txt);
            builder.CloseElement();
        }
        else if (m.Kind == "agent")
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "po-wa-agent");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "po-wa-agent-l");
            builder.AddContent(seq++, "Agente PROPIA");
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "po-wa-txt");
            builder.AddContent(seq++, m.Txt);
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "po-wa-hora");
            builder.AddContent(seq++, m.Hora);
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "po-wa-res-msg");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "po-wa-txt");
            builder.AddContent(seq++, m.Txt);
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "po-wa-hora");
            builder.AddContent(seq++, m.Hora);
            builder.CloseElement();
            builder.CloseElement();
        }
    };

