        _viDestino = Guid.Empty; _viSugs = new(); _viChat = new();
        _viTyping = _viAwait = _viOk = _viNo = false;
        _waResName = "Residente"; _waResTel = "+57 3xx xxx xxxx";
        _viCampos.Clear();
        _msg = null;
