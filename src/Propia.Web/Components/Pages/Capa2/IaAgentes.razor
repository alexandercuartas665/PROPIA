@page "/ia/agentes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.InfraestructuraIa
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<PageTitle>Agentes de IA - PROPIA</PageTitle>

@* Infraestructura IA (Capa 2): agentes de IA de la copropiedad. Configurador estilo CUBOT:
   modal de 2 columnas (configuracion + chat de prueba fijo). *@

<div class="mb-4 d-flex align-items-start">
    <div>
        <h1 class="h3 mb-1 fw-semibold">Agentes <span style="color: var(--propia-primary);">IA</span></h1>
        <p class="text-muted mb-0">Configura cada agente: proveedor, comportamiento, recursos y ponlo en produccion</p>
    </div>
    <button class="btn ms-auto" style="background: var(--propia-primary); color: white;" @onclick="AbrirNuevo">+ Nuevo agente</button>
</div>

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

@if (_usage is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card p-3"><div class="small text-muted">Llamadas de IA</div><div class="h4 mb-0">@_usage.TotalCalls</div></div></div>
        <div class="col-6 col-lg-3"><div class="card p-3"><div class="small text-muted">Tokens consumidos</div><div class="h4 mb-0">@_usage.TotalTokens.ToString("N0")</div></div></div>
        <div class="col-6 col-lg-3"><div class="card p-3"><div class="small text-muted">Costo estimado</div><div class="h4 mb-0">$@_usage.EstimatedCostUsd.ToString("0.####")</div><div class="small text-muted">USD aprox.</div></div></div>
        @if (_quota is { HasLimit: true })
        {
            <div class="col-6 col-lg-3">
                <div class="card p-3">
                    <div class="small text-muted">Cupo mensual del plan</div>
                    <div class="h4 mb-0">@_quota.MonthlyUsedCalls / @_quota.MonthlyLimitCalls</div>
                    <div class="progress mt-1" style="height: 6px;">
                        <div class="progress-bar @(_quota.Exceeded ? "bg-danger" : "")" style="width: @(_quota.UsedPct)%; background: var(--propia-primary);"></div>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (_quota is { Exceeded: true })
    {
        <div class="alert alert-warning">Alcanzaste el limite de llamadas de IA de tu plan este mes. Actualiza tu plan para seguir usando los agentes.</div>
    }
}

@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="alert alert-danger">@_loadError <button class="btn btn-sm btn-outline-danger ms-2" @onclick="CargarAsync">Reintentar</button></div>
}

@if (_agents is null)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
}
else if (_agents.Count == 0)
{
    <div class="card p-4 text-center text-muted">Aun no hay agentes. Crea el primero con "+ Nuevo agente".</div>
}
else
{
    <div class="row g-3">
        @foreach (var a in _agents)
        {
            var agent = a;
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fi fi-rr-robot fs-4" style="color: var(--propia-primary);"></i>
                            <strong>@agent.Name</strong>
                            <span class="badge ms-auto @(agent.IsActive ? "bg-success" : "bg-light text-dark border")">@(agent.IsActive ? "En produccion" : "Apagado")</span>
                        </div>
                        <div class="small text-muted mb-2">@(string.IsNullOrWhiteSpace(agent.Role) ? "Agente" : agent.Role) &middot; @ProviderLabel(agent.Provider) &middot; @agent.ResourceCount recurso(s)</div>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm btn-dark" @onclick="() => AbrirDetalle(agent.Id)">Configurar</button>
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => ToggleActivoAsync(agent)">@(agent.IsActive ? "Apagar" : "Encender")</button>
                            <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => EliminarAsync(agent.Id)" disabled="@_busy">Eliminar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ===================== Modal configurador (2 columnas) ===================== *@
@if (_showEditor)
{
    <div class="modal-backdrop-propia" @onclick="Cerrar"></div>
    <div class="ag-modal card">
        <div class="ag-modal-head">
            <h5 class="mb-0">@(_editId is null ? "Nuevo agente" : "Configurar agente")</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Cerrar">Cerrar</button>
        </div>

        <div class="ag-modal-body">
            @* ----- Columna izquierda: configuracion ----- *@
            <div class="ag-col-config">
                @if (!string.IsNullOrEmpty(_editError)) { <div class="alert alert-danger py-2">@_editError</div> }

                <div class="row g-2 mb-2">
                    <div class="col-7"><label class="form-label small">Nombre *</label><input class="form-control" @bind="_form.Name" @bind:event="oninput" /></div>
                    <div class="col-5"><label class="form-label small">Rol / funcion</label><input class="form-control" @bind="_form.Role" @bind:event="oninput" placeholder="copiloto" /></div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-7">
                        <label class="form-label small">Servicio de IA *</label>
                        <select class="form-select" @bind="_form.Provider">
                            @foreach (var p in Enum.GetValues<AiProvider>()) { <option value="@p">@ProviderLabel(p)</option> }
                        </select>
                    </div>
                    <div class="col-5"><label class="form-label small">Modelo</label><input class="form-control" @bind="_form.Model" @bind:event="oninput" placeholder="(por defecto)" /></div>
                </div>

                <label class="form-label small mb-1">Prompt base (comportamiento principal)</label>
                <div class="ag-toolbar">
                    <button type="button" class="ag-fmt" title="Negrita" @onclick='() => Fmt("*","*")'><b>B</b></button>
                    <button type="button" class="ag-fmt fst-italic" title="Cursiva" @onclick='() => Fmt("_","_")'>i</button>
                    <button type="button" class="ag-fmt text-decoration-line-through" title="Tachado" @onclick='() => Fmt("~","~")'>S</button>
                    <button type="button" class="ag-fmt" title="Monoespaciado" @onclick='() => Fmt("```","```")'>&lt;/&gt;</button>
                    <button type="button" class="ag-fmt" title="Lista" @onclick='() => Fmt("\n- ","")'>&bull;</button>
                </div>
                <textarea id="agentPrompt" class="form-control ag-prompt" rows="6" @bind="_form.SystemPrompt" @bind:event="oninput"
                          placeholder="Eres el asistente de la copropiedad. Responde con amabilidad..."></textarea>

                <div class="d-flex align-items-center gap-3 mt-2">
                    <button class="btn" style="background: var(--propia-primary); color:#fff;" @onclick="GuardarAsync" disabled="@_busy">
                        @(_busy ? "Guardando..." : (_editId is null ? "Crear agente" : "Guardar cambios"))
                    </button>
                    @if (_detalle is not null)
                    {
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="enprod" checked="@_detalle.Agent.IsActive" @onchange="ToggleActivoModalAsync" />
                            <label class="form-check-label small" for="enprod">@(_detalle.Agent.IsActive ? "En produccion" : "Apagado")</label>
                        </div>
                    }
                </div>

                @if (_detalle is null)
                {
                    <div class="alert alert-info mt-3 py-2 small mb-0">Guarda el agente para configurar prompts enrutados, recursos y probarlo.</div>
                }
                else
                {
                    @* ----- Prompts enrutados ----- *@
                    <hr class="my-3" />
                    <div class="d-flex align-items-center mb-2">
                        <span class="small fw-semibold text-uppercase text-muted">Prompts enrutados</span>
                        <button class="btn btn-sm btn-outline-dark ms-auto" @onclick="NuevoPrompt">+ Prompt</button>
                    </div>
                    <p class="text-muted" style="font-size:11.5px;">El enrutador evalua el mensaje y aplica el prompt cuya regla coincide, antes del comportamiento base.</p>
                    @foreach (var p in _detalle.Prompts)
                    {
                        var pr = p;
                        <div class="border rounded p-2 mb-2 d-flex align-items-start">
                            <div class="flex-grow-1">
                                <strong>@pr.Name</strong>
                                <div class="small text-muted">Regla: @(string.IsNullOrWhiteSpace(pr.Rule) ? "(a criterio)" : pr.Rule)</div>
                            </div>
                            <button class="btn btn-sm btn-outline-dark py-0 me-1" @onclick="() => EditarPrompt(pr)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => EliminarPromptAsync(pr.Id)">&times;</button>
                        </div>
                    }
                    @if (_showPromptForm)
                    {
                        <div class="border rounded p-2 mb-2 bg-light">
                            <input class="form-control form-control-sm mb-1" placeholder="Nombre" @bind="_promptForm.Name" @bind:event="oninput" />
                            <input class="form-control form-control-sm mb-1" placeholder="Regla (cuando usarlo)" @bind="_promptForm.Rule" @bind:event="oninput" />
                            <textarea class="form-control form-control-sm mb-1" rows="3" placeholder="Instrucciones" @bind="_promptForm.Body" @bind:event="oninput"></textarea>
                            <div class="d-flex gap-2 justify-content-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showPromptForm = false">Cancelar</button>
                                <button class="btn btn-sm btn-dark" @onclick="GuardarPromptAsync" disabled="@_busy">@(_editPromptId is null ? "Agregar" : "Guardar")</button>
                            </div>
                        </div>
                    }

                    @* ----- Recursos ----- *@
                    <hr class="my-3" />
                    <div class="d-flex align-items-center mb-2">
                        <span class="small fw-semibold text-uppercase text-muted">Recursos del agente</span>
                        <button class="btn btn-sm btn-outline-dark ms-auto" @onclick="NuevoRecurso">+ Recurso</button>
                    </div>
                    @foreach (var r in _detalle.Resources)
                    {
                        var rr = r;
                        <div class="border rounded p-2 mb-2 d-flex align-items-start">
                            <div class="flex-grow-1">
                                <strong>@rr.Name</strong> <span class="badge bg-light text-dark border ms-1">@rr.ResourceType</span>
                                @if (!string.IsNullOrWhiteSpace(rr.Detail)) { <div class="small text-muted">@rr.Detail</div> }
                            </div>
                            <button class="btn btn-sm btn-outline-dark py-0 me-1" @onclick="() => EditarRecurso(rr)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => EliminarRecursoAsync(rr.Id)">&times;</button>
                        </div>
                    }
                    @if (_showRecursoForm)
                    {
                        <div class="border rounded p-2 mb-2 bg-light">
                            <input class="form-control form-control-sm mb-1" placeholder="Nombre" @bind="_recursoForm.Name" @bind:event="oninput" />
                            <select class="form-select form-select-sm mb-1" @bind="_recursoForm.ResourceType">
                                @foreach (var t in Enum.GetValues<AgentResourceType>()) { <option value="@t">@t</option> }
                            </select>
                            <textarea class="form-control form-control-sm mb-1" rows="2" placeholder="Detalle / texto / lat,lng" @bind="_recursoForm.Detail" @bind:event="oninput"></textarea>
                            <input class="form-control form-control-sm mb-1" placeholder="URL del archivo (opcional)" @bind="_recursoForm.FileUrl" @bind:event="oninput" />
                            <div class="d-flex gap-2 justify-content-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showRecursoForm = false">Cancelar</button>
                                <button class="btn btn-sm btn-dark" @onclick="GuardarRecursoAsync" disabled="@_busy">@(_editRecursoId is null ? "Agregar" : "Guardar")</button>
                            </div>
                        </div>
                    }
                }
            </div>

            @* ----- Columna derecha: probar agente (fija) ----- *@
            <div class="ag-col-test">
                <div class="small fw-semibold text-uppercase" style="color: var(--propia-primary);">Probar agente</div>
                <p class="text-muted" style="font-size:11.5px;">Conversa como si fueras el residente. Usa el prompt y los recursos de la izquierda.</p>

                @if (_detalle is null)
                {
                    <div class="ag-test-empty border rounded p-4">Guarda el agente para probarlo.</div>
                }
                else
                {
                    @if (_connectedLines.Count > 0)
                    {
                        <div class="ag-phone mb-2">
                            <label class="ag-phone-toggle">
                                <input type="checkbox" checked="@_phoneSend" @onchange="e => _phoneSend = (bool)e.Value!" />
                                <span>Enviar las respuestas a un telefono</span>
                            </label>
                            @if (_phoneSend)
                            {
                                <div class="ag-phone-row">
                                    @if (_connectedLines.Count > 1)
                                    {
                                        <select class="form-select form-select-sm" @bind="_phoneLineId">
                                            @foreach (var ln in _connectedLines) { <option value="@ln.Id">@(string.IsNullOrWhiteSpace(ln.PhoneNumber) ? ln.InstanceName : ln.PhoneNumber)</option> }
                                        </select>
                                    }
                                    <input class="form-control form-control-sm" @bind="_phoneNumber" placeholder="Numero con codigo pais (573001234567)" autocomplete="off" />
                                </div>
                                @if (_phoneInfo is not null) { <div class="text-muted" style="font-size:11px;margin-top:4px;">@_phoneInfo</div> }
                            }
                        </div>
                    }

                    <div class="ag-test">
                        <div class="ag-test-body">
                            @if (_chat.Count == 0)
                            {
                                <div class="ag-test-empty">Escribe un mensaje para probar la respuesta del agente.</div>
                            }
                            else
                            {
                                @foreach (var t in _chat)
                                {
                                    <div class="ag-bubble @(t.Role == "model" ? "bot" : "me")">
                                        @if (!string.IsNullOrWhiteSpace(t.Text)) { <div>@t.Text</div> }
                                        @if (t.Attachments is { Count: > 0 })
                                        {
                                            @foreach (var a in t.Attachments)
                                            {
                                                <div class="ag-attach">
                                                    @switch (a.ResourceType)
                                                    {
                                                        case AgentResourceType.Text: <div class="ag-attach-text">@a.Detail</div> break;
                                                        case AgentResourceType.Image:
                                                            <img src="@a.FileUrl" alt="@a.Name" />
                                                            @if (!string.IsNullOrWhiteSpace(a.Detail)) { <div class="ag-attach-cap">@a.Detail</div> }
                                                            break;
                                                        case AgentResourceType.Video: <video src="@a.FileUrl" controls></video> break;
                                                        case AgentResourceType.Audio: <audio src="@a.FileUrl" controls></audio> break;
                                                        case AgentResourceType.Location: <a href="@MapsLink(a.Detail)" target="_blank">📍 @a.Name</a> break;
                                                        default: <a href="@a.FileUrl" target="_blank">📎 @(a.FileName ?? a.Name)</a> break;
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            }
                            @if (_busy) { <div class="ag-bubble bot ag-typing">Escribiendo...</div> }
                        </div>
                        @if (!string.IsNullOrEmpty(_chatError)) { <div class="text-danger small" style="padding:0 8px 6px;">@_chatError</div> }
                        <div class="ag-test-input">
                            <input class="form-control" placeholder="Mensaje del residente..." @bind="_chatInput" @bind:event="oninput" @onkeydown="@(e => { if (e.Key == "Enter") _ = ProbarChatAsync(); })" disabled="@_busy" />
                            <button class="btn" style="background: var(--propia-primary); color:#fff;" @onclick="ProbarChatAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_chatInput))">Enviar</button>
                        </div>
                    </div>
                    @if (_chat.Count > 0)
                    {
                        <button class="btn btn-sm btn-link mt-1 p-0" @onclick="LimpiarChat" disabled="@_busy">Limpiar conversacion</button>
                    }
                }
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop-propia { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1050; }
    .ag-modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1060; width: min(1100px, 96vw); max-height: 94vh; display: flex; flex-direction: column; }
    .ag-modal-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid #e3e3ec; }
    .ag-modal-body { display: flex; gap: 18px; padding: 18px; overflow-y: auto; }
    .ag-col-config { flex: 1.25; min-width: 0; }
    .ag-col-test { flex: 1; min-width: 0; border-left: 1px solid #eef0f5; padding-left: 18px; }
    @@media (max-width: 860px) { .ag-modal-body { flex-direction: column; } .ag-col-test { border-left: 0; padding-left: 0; border-top: 1px solid #eef0f5; padding-top: 14px; } }

    .ag-toolbar { display: flex; gap: 4px; border: 1px solid #e3e3ec; border-bottom: 0; border-radius: 8px 8px 0 0; padding: 4px 6px; background: #f7f7fb; }
    .ag-fmt { border: 0; background: transparent; width: 28px; height: 26px; border-radius: 6px; font-size: 13px; cursor: pointer; color: #4a4a63; }
    .ag-fmt:hover { background: rgba(89,85,209,.12); color: var(--propia-primary); }
    .ag-prompt { border-radius: 0 0 8px 8px !important; }

    .ag-test { border: 1px solid #e3e3ec; border-radius: 12px; overflow: hidden; }
    .ag-test-body { max-height: 320px; min-height: 150px; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; background: #f5f6fa; }
    .ag-test-empty { color: #8a8a9a; font-size: 12.5px; text-align: center; margin: auto; font-style: italic; }
    .ag-bubble { max-width: 85%; padding: 8px 12px; border-radius: 12px; font-size: 13px; line-height: 1.45; white-space: pre-wrap; word-wrap: break-word; }
    .ag-bubble.me { align-self: flex-end; background: var(--propia-primary, #5955D1); color: #fff; border-bottom-right-radius: 4px; }
    .ag-bubble.bot { align-self: flex-start; background: #fff; border: 1px solid #e3e3ec; border-bottom-left-radius: 4px; }
    .ag-bubble.ag-typing { color: #8a8a9a; font-style: italic; }
    .ag-attach { margin-top: 6px; }
    .ag-attach img, .ag-attach video { max-width: 200px; max-height: 200px; border-radius: 8px; display: block; }
    .ag-attach audio { max-width: 220px; }
    .ag-attach a { font-size: 12px; font-weight: 600; color: var(--propia-primary, #5955D1); text-decoration: none; }
    .ag-attach-text { background: rgba(0,0,0,0.04); border-left: 3px solid var(--propia-primary, #5955D1); border-radius: 4px; padding: 6px 8px; font-size: 12.5px; white-space: pre-wrap; }
    .ag-attach-cap { font-size: 12px; margin-top: 3px; }
    .ag-test-input { display: flex; gap: 8px; padding: 10px; border-top: 1px solid #e3e3ec; background: #fff; }
    .ag-test-input input { flex: 1; }
    .ag-phone { border: 1px solid #e3e3ec; border-radius: 10px; padding: 8px 10px; background: #fff; }
    .ag-phone-toggle { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 600; cursor: pointer; margin: 0; }
    .ag-phone-row { display: flex; gap: 6px; margin-top: 8px; }
</style>

@code {
    private string? _jwt;
    private bool _busy;
    private string? _loadError;

    private List<AiAgentDto>? _agents;
    private AiUsageSummaryDto? _usage;
    private AiQuotaDto? _quota;

    private bool _showEditor;
    private Guid? _editId;
    private AgentForm _form = new();
    private string? _editError;

    private AiAgentDetailDto? _detalle;

    private bool _showPromptForm;
    private Guid? _editPromptId;
    private PromptForm _promptForm = new();
    private bool _showRecursoForm;
    private Guid? _editRecursoId;
    private RecursoForm _recursoForm = new();

    private readonly List<ChatMsg> _chat = new();
    private string _chatInput = "";
    private string? _chatError;

    private List<WhatsAppLineDto> _connectedLines = new();
    private bool _phoneSend;
    private Guid _phoneLineId;
    private string? _phoneNumber;
    private string? _phoneInfo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored)) { _jwt = stored; await CargarAsync(); StateHasChanged(); }
        }
        catch { /* prerender */ }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/ia/agentes");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized) { _loadError = "Sesion expirada"; _jwt = null; return; }
            resp.EnsureSuccessStatusCode();
            _agents = await resp.Content.ReadFromJsonAsync<List<AiAgentDto>>() ?? new();
            _usage = await http.GetFromJsonAsync<AiUsageSummaryDto>("/api/ia/consumo");
            _quota = await http.GetFromJsonAsync<AiQuotaDto>("/api/ia/consumo/cuota");
            _loadError = null;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private void AbrirNuevo()
    {
        _editId = null; _form = new(); _editError = null; _detalle = null;
        _chat.Clear(); _chatError = null; _phoneInfo = null;
        _showPromptForm = false; _showRecursoForm = false; _editPromptId = null; _editRecursoId = null;
        _showEditor = true;
    }

    private async Task AbrirDetalle(Guid id)
    {
        _editError = null; _chat.Clear(); _chatError = null; _phoneInfo = null;
        _showPromptForm = false; _showRecursoForm = false; _editPromptId = null; _editRecursoId = null;
        _showEditor = true;
        _editId = id;
        await CargarDetalleAsync(id);
    }

    private async Task CargarDetalleAsync(Guid id)
    {
        _detalle = await Auth().GetFromJsonAsync<AiAgentDetailDto>($"/api/ia/agentes/{id}");
        if (_detalle is not null)
        {
            _form = new AgentForm
            {
                Name = _detalle.Agent.Name, Role = _detalle.Agent.Role, Provider = _detalle.Agent.Provider,
                Model = _detalle.Agent.Model, SystemPrompt = _detalle.Agent.SystemPrompt
            };
        }
        try
        {
            var lines = await Auth().GetFromJsonAsync<List<WhatsAppLineDto>>("/api/ia/lineas") ?? new();
            _connectedLines = lines.Where(l => l.Status == WhatsAppLineStatus.Connected).ToList();
            if (_phoneLineId == Guid.Empty) _phoneLineId = _connectedLines.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch { _connectedLines = new(); }
    }

    private async Task Cerrar()
    {
        _showEditor = false;
        await CargarAsync();
    }

    private async Task GuardarAsync()
    {
        _editError = null; _busy = true;
        try
        {
            if (_editId is null)
            {
                var resp = await Auth().PostAsJsonAsync("/api/ia/agentes",
                    new CreateAiAgentRequest(_form.Name, _form.Role, _form.Provider, _form.Model, _form.SystemPrompt));
                if (!resp.IsSuccessStatusCode) { _editError = $"HTTP {(int)resp.StatusCode}"; return; }
                var dto = await resp.Content.ReadFromJsonAsync<AiAgentDto>();
                if (dto is not null) { _editId = dto.Id; await CargarDetalleAsync(dto.Id); }  // pasa a modo edicion
            }
            else
            {
                var resp = await Auth().PutAsJsonAsync($"/api/ia/agentes/{_editId}",
                    new UpdateAiAgentRequest(_form.Name, _form.Role, _form.Provider, _form.Model, _form.SystemPrompt));
                if (!resp.IsSuccessStatusCode) { _editError = $"HTTP {(int)resp.StatusCode}"; return; }
                await CargarDetalleAsync(_editId.Value);
            }
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

