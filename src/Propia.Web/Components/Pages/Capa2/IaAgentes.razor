@code {
    private string? _jwt;
    private bool _busy;
    private string? _loadError;

    private List<AiAgentDto>? _agents;
    private AiUsageSummaryDto? _usage;
    private AiQuotaDto? _quota;

    private bool _showEditor;
    private Guid? _editId;
    private AgentForm _form = new();
    private string? _editError;

    private AiAgentDetailDto? _detalle;

    private bool _showPromptForm;
    private Guid? _editPromptId;
    private PromptForm _promptForm = new();
    private bool _showRecursoForm;
    private Guid? _editRecursoId;
    private RecursoForm _recursoForm = new();

    private readonly List<ChatMsg> _chat = new();
    private string _chatInput = "";
    private string? _chatError;

    // Bitacora de depuracion: prompts que se enviaron al LLM en cada llamada (mas reciente arriba).
    private readonly List<AiDebugPrompt> _debugLog = new();
    private bool _debugOpen;
    private void ClearDebugLog() => _debugLog.Clear();

    private List<WhatsAppLineDto> _connectedLines = new();
    private bool _phoneSend;
    private Guid _phoneLineId;
    private string? _phoneNumber;
    private string? _phoneInfo;

    // Conexiones MCP (herramientas habilitadas por agente)
    private List<AgentMcpConnectionDto>? _mcpConnections;
    private readonly Dictionary<string, HashSet<string>> _mcpEnabled = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _mcpExpanded = new(StringComparer.OrdinalIgnoreCase);
    private bool _mcpSaving;
    private bool _mcpOk;
    private string? _mcpMsg;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (!string.IsNullOrWhiteSpace(stored)) { _jwt = stored; await CargarAsync(); StateHasChanged(); }
        }
        catch { /* prerender */ }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/ia/agentes");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevoJwt)) return;
                _jwt = nuevoJwt;
                http = Auth();
                resp = await http.GetAsync("/api/ia/agentes");
            }
            resp.EnsureSuccessStatusCode();
            _agents = await resp.Content.ReadFromJsonAsync<List<AiAgentDto>>() ?? new();
            _usage = await http.GetFromJsonAsync<AiUsageSummaryDto>("/api/ia/consumo");
            _quota = await http.GetFromJsonAsync<AiQuotaDto>("/api/ia/consumo/cuota");
            _loadError = null;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private void AbrirNuevo()
    {
        _editId = null; _form = new(); _editError = null; _detalle = null;
        _chat.Clear(); _chatError = null; _phoneInfo = null;
        _showPromptForm = false; _showRecursoForm = false; _editPromptId = null; _editRecursoId = null;
        _bindings = new(); _bindingsError = null; _versions = new();
        _bindingsOpen = false; _reactionsOpen = false; _versionsOpen = false;
        _cacheFields = new(); _cacheValues = new(); _cacheOpen = false; _cacheModalOpen = false; _percibidosOpen = false;
        _debugLog.Clear(); _debugOpen = false;
        _showEditor = true;
    }

    private async Task AbrirDetalle(Guid id)
    {
        _editError = null; _chat.Clear(); _chatError = null; _phoneInfo = null;
        _showPromptForm = false; _showRecursoForm = false; _editPromptId = null; _editRecursoId = null;
        _debugLog.Clear(); _debugOpen = false;
        _cacheOpen = false; _cacheModalOpen = false; _percibidosOpen = false;
        _showEditor = true;
        _editId = id;
        await CargarDetalleAsync(id);
    }

    private async Task CargarDetalleAsync(Guid id)
    {
        _detalle = await Auth().GetFromJsonAsync<AiAgentDetailDto>($"/api/ia/agentes/{id}");
        if (_detalle is not null)
        {
            _form = new AgentForm
            {
                Name = _detalle.Agent.Name, Role = _detalle.Agent.Role, Provider = _detalle.Agent.Provider,
                Model = _detalle.Agent.Model, SystemPrompt = _detalle.Agent.SystemPrompt,
                ReactionsEnabled = _detalle.Agent.ReactionsEnabled, ReactionRatioN = _detalle.Agent.ReactionRatioN,
                ReactionRatioM = _detalle.Agent.ReactionRatioM, ReactionEmojis = _detalle.Agent.ReactionEmojis
            };
        }
        await ReloadBindingsAsync(id);
        await ReloadCacheAsync();
        if (_versionsOpen) { await ReloadVersionsAsync(); }
        try
        {
            var lines = await Auth().GetFromJsonAsync<List<WhatsAppLineDto>>("/api/ia/lineas") ?? new();
            _connectedLines = lines.Where(l => l.Status == WhatsAppLineStatus.Connected).ToList();
            if (_phoneLineId == Guid.Empty) _phoneLineId = _connectedLines.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch { _connectedLines = new(); }

        await LoadMcpAsync(id);
    }

    // ----- Conexiones MCP -----
    private async Task LoadMcpAsync(Guid agentId)
    {
        _mcpConnections = null; _mcpEnabled.Clear(); _mcpMsg = null;
        try
        {
            var cons = await Auth().GetFromJsonAsync<List<AgentMcpConnectionDto>>($"/api/ia/agentes/{agentId}/mcp") ?? new();
            foreach (var c in cons)
            {
                _mcpEnabled[c.Code] = c.Tools.Where(t => t.Enabled).Select(t => t.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            }
            // Las conexiones MCP arrancan colapsadas; el usuario las abre cuando quiera.
            _mcpExpanded.Clear();
            _mcpConnections = cons;
        }
        catch (Exception ex) { _mcpOk = false; _mcpMsg = "No se pudieron cargar las conexiones: " + ex.Message; _mcpConnections = new(); }
    }

    private bool IsExpanded(string code) => _mcpExpanded.Contains(code);
    private void ToggleConn(string code) { if (!_mcpExpanded.Add(code)) _mcpExpanded.Remove(code); }
    private int CountEnabled(string code) => _mcpEnabled.TryGetValue(code, out var s) ? s.Count : 0;
    private bool IsToolEnabled(string code, string tool) => _mcpEnabled.TryGetValue(code, out var s) && s.Contains(tool);

    private void ToggleTool(string code, string tool, bool on)
    {
        if (!_mcpEnabled.TryGetValue(code, out var s)) { s = new(StringComparer.OrdinalIgnoreCase); _mcpEnabled[code] = s; }
        if (on) { s.Add(tool); } else { s.Remove(tool); }
        _mcpMsg = null;
    }

    private async Task GuardarMcpAsync()
    {
        if (_detalle is null) return;
        _mcpSaving = true; _mcpMsg = null;
        try
        {
            var sel = _mcpEnabled.SelectMany(kv => kv.Value.Select(t => new AgentMcpToolSelection(kv.Key, t))).ToList();
            var resp = await Auth().PutAsJsonAsync($"/api/ia/agentes/{_detalle.Agent.Id}/mcp", new SaveAgentMcpToolsRequest(sel));
            _mcpOk = resp.IsSuccessStatusCode;
            _mcpMsg = _mcpOk ? "Guardado." : $"Error HTTP {(int)resp.StatusCode}";
        }
        catch (Exception ex) { _mcpOk = false; _mcpMsg = ex.Message; }
        finally { _mcpSaving = false; }
    }

    private async Task Cerrar()
    {
        _showEditor = false;
        await CargarAsync();
    }

    private async Task GuardarAsync()
    {
        _editError = null; _busy = true;
        try
        {
            if (_editId is null)
            {
                var resp = await Auth().PostAsJsonAsync("/api/ia/agentes",
                    new CreateAiAgentRequest(_form.Name, _form.Role, _form.Provider, _form.Model, _form.SystemPrompt));
                if (!resp.IsSuccessStatusCode) { _editError = $"HTTP {(int)resp.StatusCode}"; return; }
                var dto = await resp.Content.ReadFromJsonAsync<AiAgentDto>();
                if (dto is not null) { _editId = dto.Id; await CargarDetalleAsync(dto.Id); }  // pasa a modo edicion
            }
            else
            {
                var resp = await Auth().PutAsJsonAsync($"/api/ia/agentes/{_editId}",
                    new UpdateAiAgentRequest(_form.Name, _form.Role, _form.Provider, _form.Model, _form.SystemPrompt,
                        _form.ReactionsEnabled, _form.ReactionRatioN, _form.ReactionRatioM, _form.ReactionEmojis));
                if (!resp.IsSuccessStatusCode) { _editError = $"HTTP {(int)resp.StatusCode}"; return; }
                await CargarDetalleAsync(_editId.Value);
            }
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleActivoModalAsync()
    {
        if (_detalle is null) return;
        _busy = true;
        try
        {
            await Auth().PutAsJsonAsync($"/api/ia/agentes/{_detalle.Agent.Id}/activar", new { Active = !_detalle.Agent.IsActive });
            await CargarDetalleAsync(_detalle.Agent.Id);
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleActivoAsync(AiAgentDto a)
    {
        _busy = true;
        try { await Auth().PutAsJsonAsync($"/api/ia/agentes/{a.Id}/activar", new { Active = !a.IsActive }); await CargarAsync(); }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarAsync(Guid id)
    {
        _busy = true;
        try { await Auth().DeleteAsync($"/api/ia/agentes/{id}"); await CargarAsync(); }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DuplicarAsync(Guid id)
    {
        _busy = true;
        try
        {
            var resp = await Auth().PostAsync($"/api/ia/agentes/{id}/duplicar", null);
            if (!resp.IsSuccessStatusCode)
            {
                _loadError = "No se pudo duplicar: " + await resp.Content.ReadAsStringAsync();
            }
            await CargarAsync();
        }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _busy = false; }
    }

    private void LimpiarChat() { _chat.Clear(); _chatError = null; _phoneInfo = null; _debugLog.Clear(); }

    private async Task Fmt(string before, string after) { try { await Js.InvokeVoidAsync("propiaUI.wrapField", "agentPrompt", before, after); } catch { } }

    // ----- Prompts -----
    private void NuevoPrompt() { _promptForm = new(); _editPromptId = null; _showPromptForm = true; }
    private void EditarPrompt(AiAgentPromptDto p)
    {
        _editPromptId = p.Id;
        _promptForm = new PromptForm { Name = p.Name, Rule = p.Rule, Body = p.Body };
        _showPromptForm = true;
    }

    private async Task GuardarPromptAsync()
    {
        if (_detalle is null) return;
        _busy = true;
        try
        {
            if (_editPromptId is null)
            {
                await Auth().PostAsJsonAsync("/api/ia/agentes/prompts",
                    new CreateAgentPromptRequest(_detalle.Agent.Id, _promptForm.Name, _promptForm.Rule, _promptForm.Body));
            }
            else
            {
                await Auth().PutAsJsonAsync($"/api/ia/agentes/prompts/{_editPromptId}",
                    new UpdateAgentPromptRequest(_promptForm.Name, _promptForm.Rule, _promptForm.Body));
            }
            _showPromptForm = false; _editPromptId = null;
            await CargarDetalleAsync(_detalle.Agent.Id);
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarPromptAsync(Guid id)
    {
        if (_detalle is null) return;
        await Auth().DeleteAsync($"/api/ia/agentes/prompts/{id}");
        await CargarDetalleAsync(_detalle.Agent.Id);
    }

    // ----- Recursos -----
    private void NuevoRecurso() { _recursoForm = new(); _editRecursoId = null; _showRecursoForm = true; }
    private void EditarRecurso(AiAgentResourceDto r)
    {
        _editRecursoId = r.Id;
        _recursoForm = new RecursoForm { Name = r.Name, ResourceType = r.ResourceType, Detail = r.Detail, FileUrl = r.FileUrl };
        _showRecursoForm = true;
    }

    private async Task GuardarRecursoAsync()
    {
        if (_detalle is null) return;
        _busy = true;
        try
        {
            var fileUrl = string.IsNullOrWhiteSpace(_recursoForm.FileUrl) ? null : _recursoForm.FileUrl;
            if (_editRecursoId is null)
            {
                await Auth().PostAsJsonAsync("/api/ia/agentes/recursos",
                    new CreateAgentResourceRequest(_detalle.Agent.Id, _recursoForm.Name, _recursoForm.ResourceType, _recursoForm.Detail, fileUrl, null));
            }
            else
            {
                await Auth().PutAsJsonAsync($"/api/ia/agentes/recursos/{_editRecursoId}",
                    new UpdateAgentResourceRequest(_recursoForm.Name, _recursoForm.ResourceType, _recursoForm.Detail, fileUrl, null));
            }
            _showRecursoForm = false; _editRecursoId = null;
            await CargarDetalleAsync(_detalle.Agent.Id);
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarRecursoAsync(Guid id)
    {
        if (_detalle is null) return;
        await Auth().DeleteAsync($"/api/ia/agentes/recursos/{id}");
        await CargarDetalleAsync(_detalle.Agent.Id);
    }

    // ----- Probar -----
    private async Task ProbarChatAsync()
    {
        if (_detalle is null || string.IsNullOrWhiteSpace(_chatInput)) return;
        _busy = true; _chatError = null; _phoneInfo = null;
        _chat.Add(new ChatMsg("user", _chatInput.Trim(), null));
        _chatInput = "";
        try
        {
            var turns = _chat.Select(m => new AiChatTurn(m.Role, m.Text)).ToList();
            var resp = await Auth().PostAsJsonAsync($"/api/ia/agentes/{_detalle.Agent.Id}/probar",
                new { Turns = turns, SystemPromptOverride = (string?)null });
            var r = await resp.Content.ReadFromJsonAsync<AiChatResult>();
            if (r?.DebugPrompts is { Count: > 0 }) { _debugLog.AddRange(r.DebugPrompts); }
            if (r?.Ok == true)
            {
                _chat.Add(new ChatMsg("model", r.Text ?? "", r.Attachments));
                if (_phoneSend) { await EnviarAlTelefonoAsync(r.Text); }
            }
            else { _chatError = r?.Error ?? "No se pudo obtener respuesta."; }
        }
        catch (Exception ex) { _chatError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EnviarAlTelefonoAsync(string? text)
    {
        _phoneInfo = null;
        if (_phoneLineId == Guid.Empty || string.IsNullOrWhiteSpace(_phoneNumber)) { _phoneInfo = "Elige una linea y un numero."; return; }
        if (string.IsNullOrWhiteSpace(text)) { _phoneInfo = "La respuesta no tiene texto para enviar."; return; }
        var phone = new string(_phoneNumber.Where(char.IsDigit).ToArray());
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/ia/lineas/{_phoneLineId}/probar-envio", new { Phone = phone, Text = text });
            var r = await resp.Content.ReadFromJsonAsync<LineSendResult>();
            _phoneInfo = r?.Ok == true ? $"Enviado a {phone}." : (r?.Error ?? "No se pudo enviar al telefono.");
        }
        catch (Exception ex) { _phoneInfo = "No se pudo enviar al telefono: " + ex.Message; }
    }

    private static string MapsLink(string? latlng)
    {
        if (string.IsNullOrWhiteSpace(latlng)) return "#";
        return $"https://www.google.com/maps?q={Uri.EscapeDataString(latlng.Trim())}";
    }

    // ===== Lineas atendidas + Reacciones + Historial de versiones (portado de CUBOT.travels) =====
    private bool _bindingsOpen;
    private List<AgentLineBindingRowDto> _bindings = new();
    private string? _bindingsError;
    private bool _reactionsOpen;
    private bool _versionsOpen;
    private bool _versionsLoading;
    private const int MaxVersionsShown = 5;
    private List<AiAgentPromptVersionDto> _versions = new();
    private AiAgentPromptVersionDto? _versionPendingRestore;

    private List<string> ReactionEmojiList() =>
        string.IsNullOrWhiteSpace(_form.ReactionEmojis)
            ? new List<string>()
            : _form.ReactionEmojis.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void ToggleBindings() => _bindingsOpen = !_bindingsOpen;

    private async Task ReloadBindingsAsync(Guid agentId)
    {
        _bindingsError = null;
        try { _bindings = await Auth().GetFromJsonAsync<List<AgentLineBindingRowDto>>($"/api/ia/agentes/{agentId}/lineas") ?? new(); }
        catch (Exception ex) { _bindings = new(); _bindingsError = "No se pudieron cargar las lineas: " + ex.Message; }
    }

    private async Task ToggleBindingAsync(AgentLineBindingRowDto b, bool connect)
    {
        if (_editId is null) return;
        _busy = true; _bindingsError = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/ia/agentes/{_editId}/lineas",
                new SetAgentLineBindingRequest(b.WhatsAppLineId, connect, true));
            if (!resp.IsSuccessStatusCode)
                _bindingsError = connect ? "No se pudo vincular (puede estar tomada por otro agente)." : "No se pudo desvincular.";
            await ReloadBindingsAsync(_editId.Value);
        }
        catch (Exception ex) { _bindingsError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleVersionHistory()
    {
        _versionsOpen = !_versionsOpen;
        if (_versionsOpen) await ReloadVersionsAsync();
    }

    private async Task ReloadVersionsAsync()
    {
        if (_editId is null) { _versions = new(); return; }
        _versionsLoading = true;
        try { _versions = await Auth().GetFromJsonAsync<List<AiAgentPromptVersionDto>>($"/api/ia/agentes/{_editId}/versiones") ?? new(); }
        catch { _versions = new(); }
        finally { _versionsLoading = false; }
    }

    private void AskRestoreVersion(AiAgentPromptVersionDto v) => _versionPendingRestore = v;

    private async Task ConfirmRestoreVersionAsync()
    {
        if (_versionPendingRestore is null || _editId is null) return;
        var index = _versionPendingRestore.Index;
        _busy = true;
        try
        {
            await Auth().PostAsync($"/api/ia/agentes/{_editId}/versiones/{index}/restaurar", null);
            _versionPendingRestore = null;
            await CargarDetalleAsync(_editId.Value);
            await ReloadVersionsAsync();
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    // ===== Datos cache del agente (portado de CUBOT.travels, sin CRM) =====
    private bool _cacheOpen;
    private List<AiAgentCacheFieldDto> _cacheFields = new();
    private bool _cacheModalOpen;
    private Guid? _cacheEditId;
    private string _cName = "";
    private string? _cDescription;
    private bool _cIsUpdatable = true;
    private string? _cacheError;
    private bool _percibidosOpen;
    private List<AiAgentCacheValueDto> _cacheValues = new();

    private void ToggleCache() => _cacheOpen = !_cacheOpen;
    private bool AllSticky() => _cacheFields.Count > 0 && _cacheFields.All(f => !f.IsUpdatable);

    private async Task ReloadCacheAsync()
    {
        if (_editId is null) { _cacheFields = new(); return; }
        try { _cacheFields = await Auth().GetFromJsonAsync<List<AiAgentCacheFieldDto>>($"/api/ia/agentes/{_editId}/cache") ?? new(); }
        catch { _cacheFields = new(); }
    }

    private void AbrirCacheField(AiAgentCacheFieldDto? f)
    {
        _cacheError = null;
        _cacheEditId = f?.Id;
        _cName = f?.Label ?? "";
        _cDescription = f?.Description;
        _cIsUpdatable = f?.IsUpdatable ?? true;
        _cacheModalOpen = true;
    }

    private async Task GuardarCacheFieldAsync()
    {
        _cacheError = null;
        if (_editId is null) { return; }
        if (string.IsNullOrWhiteSpace(_cName)) { _cacheError = "El nombre es obligatorio."; return; }
        _busy = true;
        try
        {
            HttpResponseMessage resp;
            if (_cacheEditId is null)
                resp = await Auth().PostAsJsonAsync($"/api/ia/agentes/{_editId}/cache", new CreateAgentCacheFieldRequest(_cName, _cDescription, _cIsUpdatable));
            else
                resp = await Auth().PutAsJsonAsync($"/api/ia/agentes/cache/{_cacheEditId}", new UpdateAgentCacheFieldRequest(_cName, _cDescription, _cIsUpdatable));
            if (!resp.IsSuccessStatusCode) { _cacheError = $"HTTP {(int)resp.StatusCode}"; return; }
            await ReloadCacheAsync();
            _cacheModalOpen = false;
        }
        catch (Exception ex) { _cacheError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarCacheFieldAsync(Guid id)
    {
        if (_editId is null) { return; }
        _busy = true;
        try { await Auth().DeleteAsync($"/api/ia/agentes/cache/{id}"); await ReloadCacheAsync(); }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task BulkStickyAsync()
    {
        if (_editId is null || _cacheFields.Count == 0) { return; }
        _busy = true;
        try
        {
            var actualizable = AllSticky() ? "true" : "false"; // si todos sticky -> pasar a actualizable; si no -> volver sticky
            await Auth().PostAsync($"/api/ia/agentes/{_editId}/cache/sticky?actualizable={actualizable}", null);
            await ReloadCacheAsync();
        }
        finally { _busy = false; }
    }

    private async Task AbrirPercibidos()
    {
        if (_editId is null) { return; }
        _busy = true;
        try { _cacheValues = await Auth().GetFromJsonAsync<List<AiAgentCacheValueDto>>($"/api/ia/agentes/{_editId}/cache/valores") ?? new(); _percibidosOpen = true; }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LimpiarPercibidosAsync()
    {
        if (_editId is null) { return; }
        _busy = true;
        try
        {
            await Auth().DeleteAsync($"/api/ia/agentes/{_editId}/cache/valores");
            _cacheValues = await Auth().GetFromJsonAsync<List<AiAgentCacheValueDto>>($"/api/ia/agentes/{_editId}/cache/valores") ?? new();
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private static string ProviderLabel(AiProvider p) => p switch
    {
        AiProvider.Claude => "Anthropic Claude",
        AiProvider.Gemini => "Google Gemini",
        AiProvider.ChatGpt => "OpenAI ChatGPT",
        AiProvider.DeepSeek => "DeepSeek",
        _ => p.ToString()
    };

