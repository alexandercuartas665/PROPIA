    // ----- Probar -----
    private async Task ProbarChatAsync()
    {
        if (_detalle is null || string.IsNullOrWhiteSpace(_chatInput)) return;
        _busy = true; _chatError = null; _phoneInfo = null;
        _chat.Add(new ChatMsg("user", _chatInput.Trim(), null));
        _chatInput = "";
        try
        {
            var turns = _chat.Select(m => new AiChatTurn(m.Role, m.Text)).ToList();
            var resp = await Auth().PostAsJsonAsync($"/api/ia/agentes/{_detalle.Agent.Id}/probar",
                new { Turns = turns, SystemPromptOverride = (string?)null });
            var r = await resp.Content.ReadFromJsonAsync<AiChatResult>();
            if (r?.Ok == true)
            {
                _chat.Add(new ChatMsg("model", r.Text ?? "", r.Attachments));
                if (_phoneSend) { await EnviarAlTelefonoAsync(r.Text); }
            }
            else { _chatError = r?.Error ?? "No se pudo obtener respuesta."; }
        }
        catch (Exception ex) { _chatError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EnviarAlTelefonoAsync(string? text)
    {
        _phoneInfo = null;
        if (_phoneLineId == Guid.Empty || string.IsNullOrWhiteSpace(_phoneNumber)) { _phoneInfo = "Elige una linea y un numero."; return; }
        if (string.IsNullOrWhiteSpace(text)) { _phoneInfo = "La respuesta no tiene texto para enviar."; return; }
        var phone = new string(_phoneNumber.Where(char.IsDigit).ToArray());
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/ia/lineas/{_phoneLineId}/probar-envio", new { Phone = phone, Text = text });
            var r = await resp.Content.ReadFromJsonAsync<LineSendResult>();
            _phoneInfo = r?.Ok == true ? $"Enviado a {phone}." : (r?.Error ?? "No se pudo enviar al telefono.");
        }
        catch (Exception ex) { _phoneInfo = "No se pudo enviar al telefono: " + ex.Message; }
    }

    private static string MapsLink(string? latlng)
    {
        if (string.IsNullOrWhiteSpace(latlng)) return "#";
        return $"https://www.google.com/maps?q={Uri.EscapeDataString(latlng.Trim())}";
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

