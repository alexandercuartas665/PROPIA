    private FiltroDinamico? _fd;

    private List<FiltroDinamico.CampoDef> CamposFiltroUsr => new()
    {
        new() { Key = "nombre", Label = "Nombre", Kind = "texto" },
        new() { Key = "documento", Label = "Documento", Kind = "texto" },
        new() { Key = "email", Label = "Email", Kind = "texto" },
        new() { Key = "rol", Label = "Rol", Kind = "sel",
                Opciones = RolesDisponibles().Select(r => (r.Id.ToString(), r.Nombre)).ToList() },
        new() { Key = "etiqueta", Label = "Etiqueta", Kind = "multi",
                Opciones = _etiquetas.Select(e => (e.Id.ToString(), e.Nombre)).ToList() },
    };
    private int _pagina = 1;
    private int _porPagina = 25;

    // Orden por columna en la vista Tabla (clic en cabecera; reclic invierte). Se aplica sobre
    // la lista filtrada ANTES de paginar (la paginacion la hace esta pagina, no la sub-vista).
    // Orden multi-criterio apilable (boton "Ordenar", canonico de la tabla de ejemplo). El clic en
    // cabecera es un caso de un solo criterio, sincronizado con esta misma lista.
    private List<TablaOrdenarMenu.Sort> _sortsU = new();
    private string? _sortKeyU => _sortsU.Count > 0 ? _sortsU[0].Key : null;
    private int _sortDirU => _sortsU.Count > 0 ? _sortsU[0].Dir : 1;
    // Columnas ofrecidas en el menu Ordenar: las visibles fijas + las dinamicas (clave "cd:{id}").
    private List<TablaOrdenarMenu.Col> ColsOrdenablesU()
        => ColsVisiblesU().Select(k => new TablaOrdenarMenu.Col(k, ColLabelU(k)))
            .Concat(_defsCampos.Select(d => new TablaOrdenarMenu.Col("cd:" + d.Id, d.Label)))
            .ToList();
    private void OnSortsUChanged() { _pagina = 1; StateHasChanged(); }
    private void OrdenarPorColumnaU(string clave)
    {
        var ex = _sortsU.FirstOrDefault(s => s.Key == clave);
        if (_sortsU.Count == 1 && ex is not null) ex.Dir = -ex.Dir;
        else _sortsU = new() { new TablaOrdenarMenu.Sort { Key = clave, Dir = 1 } };
        _pagina = 1;
    }
    // Valor de orden para una clave (fija via SortStrU; dinamica "cd:{id}" via el valor del campo propio).
    private string ValorOrdenU(UsuarioListaDto u, string key)
    {
        if (key.StartsWith("cd:", StringComparison.Ordinal) && Guid.TryParse(key.AsSpan(3), out var defId))
            return _valoresCampos.TryGetValue(u.UsuarioTenantId, out var m) && m.TryGetValue(defId, out var v) ? (v ?? "") : "";
        return SortStrU(u, key);
    }
    private static string SortStrU(UsuarioListaDto u, string clave)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        return clave switch
        {
            "documento" => u.Documento ?? "",
            "usuario" => u.NombreCompleto ?? "",
            "email" => u.Email ?? "",
            "telefono" => u.Telefono ?? "",
            "rol" => u.RolNombre ?? "",
            "ultimoacceso" => u.UltimoAcceso?.ToString("yyyy-MM-dd HH:mm", ci) ?? "",
            "estado" => u.Estado.ToString(),
            _ => ""
        };
    }
    // Comparacion numerica-aware (copia del patron de Zonas): numeros como numeros, resto texto.
    private static int CmpValTabla(string a, string b)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var na = decimal.TryParse(a, System.Globalization.NumberStyles.Any, ci, out var da);
        var nb = decimal.TryParse(b, System.Globalization.NumberStyles.Any, ci, out var db);
        if (na && nb) return da.CompareTo(db);
        if (na) return -1; if (nb) return 1;
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase);
    }
    // Mensaje breve emitido por la sub-vista (p.ej. "Enlace copiado").
    private void MostrarMensajeInfo(string m) { _msg = m; _msgClass = "alert-info"; StateHasChanged(); }

    // Lista filtrada (tab + reglas dinamicas), sin ordenar; se reusa en la vista y para saber
    // que ids son seleccionables. El orden por columna se aplica aparte, en la rama Tabla.
    private IEnumerable<UsuarioListaDto> UsuariosFiltrados()
    {
        if (_usuarios is null) return Enumerable.Empty<UsuarioListaDto>();
        return _usuarios.Where(u => u.Estado == _tab)
            .Where(u => _fd?.Pasa(campo => campo switch
            {
                "nombre" => u.NombreCompleto,
                "documento" => u.Documento,
                "email" => u.Email ?? "",
                "rol" => u.RolId?.ToString() ?? "",
                "etiqueta" => string.Join(",", u.Etiquetas.Select(e => e.Id)),
                _ => ""
            }) ?? true);
    }

    // ===================== Seleccion multiple + revocar masivo =====================
    // El HashSet vive aqui (la pagina pagina): el hijo pinta los checkboxes y sube eventos.
    private readonly HashSet<Guid> _selU = new();
    private bool _confirmRevocarU;
    private bool _revocandoU;
    // Solo son seleccionables los usuarios ACTIVOS del listado filtrado (los inactivos no se revocan).
    private IEnumerable<Guid> IdsSeleccionablesU()
        => UsuariosFiltrados().Where(u => u.Estado == EstadoUsuarioTenant.Activo).Select(u => u.UsuarioTenantId);
    private bool TodasSelU { get { var ids = IdsSeleccionablesU().ToList(); return ids.Count > 0 && ids.All(_selU.Contains); } }
    private void ToggleSelU((Guid id, bool on) a) { if (a.on) _selU.Add(a.id); else _selU.Remove(a.id); }
    private void ToggleSelAllU(bool on) { _selU.Clear(); if (on) foreach (var id in IdsSeleccionablesU()) _selU.Add(id); }
    private void LimpiarSelU() => _selU.Clear();
    private async Task RevocarSelUAsync()
    {
        if (_selU.Count == 0) return;
        _revocandoU = true;
        int ok = 0, fail = 0;
        foreach (var id in _selU.ToList())
        {
            try
            {
                var r = await Auth().PostAsJsonAsync($"/api/usuarios/{id}/revocar", new RevocarAccesoRequest(null));
                if (r.IsSuccessStatusCode) ok++; else fail++;
            }
            catch { fail++; }
        }
        _selU.Clear(); _confirmRevocarU = false; _revocandoU = false;
        _msg = fail == 0 ? $"{ok} acceso(s) revocado(s)." : $"{ok} revocado(s), {fail} con error.";
        _msgClass = fail == 0 ? "alert-success" : "alert-danger";
        await CargarAsync();
    }

    // ===================== Columnas configurables (config server-side, entidad 'usuario') =====================
    // Catalogo FIJO de columnas (Usuarios no tiene campos propios): clave + label + ancho por defecto.
    private sealed record ColUsr(string Clave, string Label, string Width);
    private static readonly ColUsr[] UsuarioColumnas =
    {
        new("documento", "Documento", "186px"),
        new("usuario", "Usuario", "1.3fr"),
        new("email", "Email", "1.5fr"),
        new("telefono", "Telefono", ".9fr"),
        new("rol", "Rol", "118px"),
        new("ultimoacceso", "Ultimo acceso", "132px"),
        new("estado", "Estado", "88px"),
    };
    private static ColUsr? CatColU(string clave) => Array.Find(UsuarioColumnas, c => c.Clave == clave);

    private Dictionary<string, UnidadCampoConfigDto> _cfgUsr = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _colWU = new(StringComparer.Ordinal);
    private bool _showColMenuU;
    private string _colQU = "";

    private IEnumerable<string> ClavesCandidatasU() => UsuarioColumnas.Select(c => c.Clave);
    private bool VisibleColU(string clave) => _cfgUsr.TryGetValue(clave, out var c) ? !c.Oculto : true;
    private int OrdenColU(string clave, int fallback) => _cfgUsr.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;
    private IEnumerable<string> ClavesOrdenadasU()
        => ClavesCandidatasU().Select((k, i) => (k, ord: OrdenColU(k, i))).OrderBy(x => x.ord).Select(x => x.k);
    private IEnumerable<string> ColsVisiblesU() => ClavesOrdenadasU().Where(VisibleColU);
    private string ColLabelU(string clave)
    {
        if (_cfgUsr.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias)) return c.Alias!;
        return CatColU(clave)?.Label ?? clave;
    }
    private static string ColWidthU(string clave) => CatColU(clave)?.Width ?? "minmax(120px,150px)";
    // grid = [seleccion 38px] [columnas fijas visibles] [columnas dinamicas] [+ addcol 40px] [accion 34px].
    // Debe casar 1:1 con las celdas que pinta UsuariosTablaVista: una pista por campo propio + la del "+".
    private string UtbGridStyleU => "grid-template-columns: 38px " +
