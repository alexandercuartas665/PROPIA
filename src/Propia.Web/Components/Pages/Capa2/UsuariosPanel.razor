    private Task InvitarUsuarioTabla(NuevoUsuarioInvitar d) => CrearUsuarioTablaAsync(d, abrir: false);
    // Gesto del expander: ABRE el modal de CREACION precargado con lo que haya en la fila. El nombre y el rol se
    // completan dentro del modal, que al guardar crea el usuario (Invitacion pendiente) y abre su ficha.
