    // Edicion inline de un campo propio: PUT sobre el registro (UsuarioTenantId). El hijo solo emite (reg, def, valor).
    private async Task GuardarDinamicoU((Guid Registro, Guid Def, string? Valor) x)
    {
        if (x.Registro == Guid.Empty) return;
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/usuarios-campos-valores/{x.Registro}/{x.Def}", new Propia.Application.MiCopropiedad.SetCampoValorRequest(x.Valor));
            if (resp.IsSuccessStatusCode)
            {
                if (!_valoresCampos.TryGetValue(x.Registro, out var d)) _valoresCampos[x.Registro] = d = new();
                d[x.Def] = x.Valor;
            }
        }
        catch { }
    }

