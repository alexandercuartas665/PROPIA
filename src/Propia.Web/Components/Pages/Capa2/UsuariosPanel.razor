    private async Task CrearUsuarioTablaAsync(NuevoUsuarioInvitar d, bool abrir)
    {
        _msg = null;
        var http = Auth();

        // 1) Buscar la persona por documento; si no existe, crearla en el Directorio.
        Guid personaId;
        var buscar = await http.PostAsJsonAsync("/api/directorio/personas/buscar",
            new BuscarPorDocumentoRequest(d.TipoDocumento, d.Documento));
        if (buscar.StatusCode == System.Net.HttpStatusCode.OK)
        {
            var existente = await buscar.Content.ReadFromJsonAsync<PersonaDetalleDto>();
            if (existente is null) { _msg = "No se pudo leer la persona."; _msgClass = "alert-danger"; return; }
            personaId = existente.Id;
        }
        else
        {
            var crear = await http.PostAsJsonAsync("/api/directorio/personas",
                new CrearPersonaRequest(d.TipoDocumento, d.Documento, d.Nombres, d.Apellidos,
                    string.IsNullOrWhiteSpace(d.Email) ? null : d.Email!.Trim(),
                    string.IsNullOrWhiteSpace(d.Telefono) ? null : d.Telefono!.Trim(), null, null));
            if (!crear.IsSuccessStatusCode) { _msg = "No se pudo crear la persona: " + await crear.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
            var nueva = await crear.Content.ReadFromJsonAsync<PersonaDetalleDto>();
            if (nueva is null) { _msg = "No se pudo crear la persona."; _msgClass = "alert-danger"; return; }
            personaId = nueva.Id;
        }

        // 2) 2.5 v2.0: crear el UsuarioTenant en "Invitacion pendiente" con TODOS sus roles/cargos
        //    (modelo elegido: el usuario nace pendiente; el multi-rol vive en el UsuarioTenant).
        var rolIds = d.RolIds is { Count: > 0 } ? d.RolIds.ToList() : (d.RolId != Guid.Empty ? new List<Guid> { d.RolId } : new List<Guid>());
        var cargos = d.Cargos?.ToList() ?? new List<string>();
        var alta = await http.PostAsJsonAsync("/api/usuarios/alta", new CrearUsuarioAltaRequest(personaId, rolIds, cargos));
        if (!alta.IsSuccessStatusCode) { _msg = "No se pudo crear el usuario: " + await alta.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }

        if (abrir)
        {
            // Canon Unidades: crear + abrir la ficha para terminar el registro en el modal. La invitacion se
            // envia luego (desde el modal / "Invitar usuario"); por eso aqui NO se exigio correo.
            await CargarAsync();
            var creado = _usuarios?.FirstOrDefault(u => u.PersonaId == personaId);
            _msg = $"Usuario {d.Nombres} {d.Apellidos} creado. Completa su ficha."; _msgClass = "alert-success";
            if (creado is not null) AbrirEditar(creado);
            return;
        }

        // 3) Enviar la invitacion (link de aceptacion / fijar password).
        var inv = await http.PostAsJsonAsync("/api/usuarios/invitaciones",
            new CrearInvitacionRequest(personaId, d.RolId, CanalEnvioInvitacion.Email));
        if (!inv.IsSuccessStatusCode) { _msg = "Usuario creado, pero no se pudo enviar la invitacion: " + await inv.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; await CargarAsync(); return; }

        _msg = $"Usuario {d.Nombres} {d.Apellidos} creado (Invitación pendiente)."; _msgClass = "alert-success";
        await CargarAsync();
    }

    private async Task EnviarInvitacion()
    {
        if (_personaSel is null || _invRolId == Guid.Empty) return;
        _busy = true; _msg = null; _ultimaInvitacion = null;
        try
        {
            var http = Auth();
            var resp = await http.PostAsJsonAsync("/api/usuarios/invitaciones",
                new CrearInvitacionRequest(_personaSel.Id, _invRolId, _invCanal));
            if (!resp.IsSuccessStatusCode)
