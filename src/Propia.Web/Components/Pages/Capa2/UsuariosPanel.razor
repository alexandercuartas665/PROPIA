            _msg = $"Invitacion enviada a {_personaSel.Nombres} {_personaSel.Apellidos}."; _msgClass = "alert-success";
            _personaSel = null; _buscarPersona = ""; _invRolId = Guid.Empty;
            await CargarAsync();
        }
        finally { _busy = false; }
    }

