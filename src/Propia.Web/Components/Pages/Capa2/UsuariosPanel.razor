    private async Task RecargarGobiernoAsync()
    {
        if (_editUser is null) return;
        _gobUser = await Auth().GetFromJsonAsync<GobiernoPersonaDto>($"/api/mi-copropiedad/gobierno/persona/{_editUser.PersonaId}")
                   ?? new GobiernoPersonaDto(null, new List<GobiernoComiteTag>(), null, null);
        await CargarAsync();  // refresca los tags de gobierno en la lista
    }
    private void GobErr(HttpResponseMessage r)
    { _msg = "No se pudo actualizar el gobierno (" + (int)r.StatusCode + ")."; _msgClass = "alert-danger"; }

    private async Task AgregarConsejo()
    {
        if (_editUser is null) return; _busy = true; _msg = null;
        try
        {
            var req = new AgregarMiembroConsejoRequest(_editUser.PersonaId, _gobCargoConsejo, DateOnly.FromDateTime(DateTime.Today), null);
            var r = await Auth().PostAsJsonAsync("/api/mi-copropiedad/consejo", req);
            if (r.IsSuccessStatusCode) await RecargarGobiernoAsync(); else GobErr(r);
        }
        finally { _busy = false; }
    }
    private async Task QuitarConsejo()
    {
        if (_gobUser?.Consejo is null) return; _busy = true; _msg = null;
        try
        {
            var r = await Auth().PutAsync($"/api/mi-copropiedad/consejo/{_gobUser.Consejo.MiembroId}/desactivar", null);
            if (r.IsSuccessStatusCode) await RecargarGobiernoAsync(); else GobErr(r);
        }
        finally { _busy = false; }
    }
