    private GuardarUnidadCampoConfigRequest FilaConfigU(string clave)
    {
        _cfgUsr.TryGetValue(clave, out var c);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato,
            Oculto: c?.Oculto ?? false, Orden: c?.Orden, Entidad: "usuario");
    }
    private async Task GuardarCfgUAsync(GuardarUnidadCampoConfigRequest req)
    {
        try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { }
    }
    private async Task CargarCfgUAsync()
    {
        try
        {
            var cfg = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config?entidad=usuario") ?? new();
            _cfgUsr = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchosU();
        }
        catch { }
    }
    private void HidratarAnchosU()
    {
        _colWU.Clear();
        foreach (var kv in _cfgUsr) { var w = AnchoDeFormatoTabla(kv.Value.Formato); if (w is > 0) _colWU[kv.Key] = w.Value; }
    }
    private async Task ToggleVisibleColUAsync(string clave)
    {
        var visible = VisibleColU(clave);
        await GuardarCfgUAsync(FilaConfigU(clave) with { Oculto = visible });
        await CargarCfgUAsync(); StateHasChanged();
    }
    private async Task MoverColumnaUAsync(string clave, int dir)
    {
        var keys = ClavesOrdenadasU().ToList();
        var i = keys.IndexOf(clave); var j = i + dir;
        if (i <= 0 || j <= 0 || j >= keys.Count) return; // la 1a columna queda fija
        (keys[i], keys[j]) = (keys[j], keys[i]);
        for (int k = 0; k < keys.Count; k++) await GuardarCfgUAsync(FilaConfigU(keys[k]) with { Orden = k });
        await CargarCfgUAsync(); StateHasChanged();
    }
    private async Task OcultarTodasColUAsync()
    {
        var keys = ClavesOrdenadasU().ToList();
        for (int k = 0; k < keys.Count; k++)
        {
            if (k == 0) continue; // la 1a columna no se oculta
            await GuardarCfgUAsync(FilaConfigU(keys[k]) with { Oculto = true });
        }
        await CargarCfgUAsync(); StateHasChanged();
    }
    private async Task MostrarTodasColUAsync()
    {
        foreach (var k in ClavesOrdenadasU()) await GuardarCfgUAsync(FilaConfigU(k) with { Oculto = false });
        await CargarCfgUAsync(); StateHasChanged();
    }
    private async Task RestablecerColUAsync()
    {
        foreach (var k in ClavesOrdenadasU()) await GuardarCfgUAsync(FilaConfigU(k) with { Oculto = false, Orden = null });
        await CargarCfgUAsync(); StateHasChanged();
    }
    // Reordenar / redimensionar disparados por la sub-vista (que posee las celdas de header + el JS).
    private async Task ReordenarColUAsync((string src, string dest) a)
    {
        if (a.src == a.dest) return;
        var keys = ClavesOrdenadasU().ToList();
        var from = keys.IndexOf(a.src); var to = keys.IndexOf(a.dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, a.src);
        for (int i = 0; i < keys.Count; i++) await GuardarCfgUAsync(FilaConfigU(keys[i]) with { Orden = i });
        await CargarCfgUAsync(); StateHasChanged();
    }
    private async Task RedimensionarColUAsync((string clave, int width) a)
    {
        int? w = a.width <= 0 ? null : Math.Max(70, a.width);
        if (w is null) _colWU.Remove(a.clave); else _colWU[a.clave] = w.Value;
        var fila = FilaConfigU(a.clave);
        await GuardarCfgUAsync(fila with { Formato = ConAnchoTabla(fila.Formato, w) });
        await CargarCfgUAsync(); HidratarAnchosU(); StateHasChanged();
    }
    // Ancho manual persistido en el JSON de Formato bajo la clave "w" (copiado de Zonas).
    private static int? AnchoDeFormatoTabla(string? json)
    {
        try { var o = System.Text.Json.Nodes.JsonNode.Parse(json ?? "") as System.Text.Json.Nodes.JsonObject; return o?["w"]?.GetValue<int>(); }
        catch { return null; }
    }
    private static string? ConAnchoTabla(string? json, int? w)
    {
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(json) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (w is null) o.Remove("w"); else o["w"] = w.Value;
        return o.Count == 0 ? null : o.ToJsonString();
    }

