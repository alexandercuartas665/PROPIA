    // ===== Menu de columna (chevron del header, estilo Airtable). TablaColMenu se pinta una vez a nivel de
    // pagina; UsuariosTablaVista emite OnAbrirColMenu con la clave, la etiqueta, si es dinamica y el cursor.
    // Clave: fija = "documento"/"email"/... ; dinamica = "cd:{guid}" (la misma que usa el orden). =====
    private TablaColMenu? _colMenu;
    private double _colMenuX, _colMenuY;
    private string? _colToast;
    private void ColToast(string m) { _colToast = m; }
    private void AbrirColMenuU((string Clave, string Label, bool Dyn, double X, double Y) a)
    {
        _colMenuX = a.X; _colMenuY = a.Y;
        _colMenu?.Abrir(new TablaColMenu.Ctx(a.Clave, a.Label, a.Dyn), a.X, a.Y);
    }
    private async Task OnColAccion((TablaColMenu.Accion Accion, TablaColMenu.Ctx Col) a)
    {
        var (accion, col) = a;
        CampoDinDef? campo = null;
        if (col.EsDinamico && col.Key.StartsWith("cd:", StringComparison.Ordinal) && Guid.TryParse(col.Key.AsSpan(3), out var defId))
            campo = _defsCampos.FirstOrDefault(d => d.Id == defId);
        switch (accion)
        {
            case TablaColMenu.Accion.OrdenarAsc:
                _sortsU = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = 1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.OrdenarDesc:
                _sortsU = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = -1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.Editar:
            case TablaColMenu.Accion.Descripcion:
                if (campo is not null) AbrirEditarCampoU(campo);
                else ColToast("Los campos del sistema no editan aqui.");
                break;
            case TablaColMenu.Accion.Eliminar:
                if (campo is not null) await EliminarCampoUAsync(campo);
                else ColToast("Los campos del sistema no se eliminan aqui.");
                break;
            case TablaColMenu.Accion.Duplicar:
                if (campo is not null)
                {
                    try
                    {
                        var req = new CrearCampoDefinicionRequest(campo.Label + " (copia)", campo.Tipo, campo.Opciones, campo.Descripcion);
                        var r = await Auth().PostAsJsonAsync("/api/mi-copropiedad/usuarios-campos", req);
                        if (r.IsSuccessStatusCode) { await CargarCamposU(Auth()); ColToast("Campo duplicado."); }
                        else ColToast("No se pudo duplicar el campo.");
                    }
                    catch { ColToast("No se pudo duplicar el campo."); }
                }
                else ColToast("Solo se pueden duplicar campos propios.");
                break;
            case TablaColMenu.Accion.InsertarIzq:
            case TablaColMenu.Accion.InsertarDer:
                AbrirCrearCampoU();
                break;
            case TablaColMenu.Accion.CopiarUrl:
                try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}usuarios#campo-{col.Key}"); ColToast("Enlace del campo copiado."); }
                catch { ColToast("No se pudo copiar el enlace."); }
                break;
            case TablaColMenu.Accion.Ocultar:
                if (col.EsDinamico) { ColToast("Los campos propios se quitan con Eliminar, no se ocultan."); }
                else if (CatColU(col.Key) is null) { ColToast("Esta columna no se puede ocultar."); }
                else { await ToggleVisibleColUAsync(col.Key); ColToast("Columna oculta. Usa Columnas para restaurarla."); }
                break;
            case TablaColMenu.Accion.Agrupar:
                ColToast("Agrupar por este campo aun no esta disponible en Usuarios.");
                break;
            case TablaColMenu.Accion.Filtrar:
                if (_fd is not null && CamposFiltroUsr.Any(c => c.Key == col.Key))
                    await _fd.AgregarReglaCampo(col.Key);
                else ColToast("Filtrar por este campo aun no esta disponible; usa el boton Filtros.");
                break;
            case TablaColMenu.Accion.TituloIa:
                if (campo is not null)
                {
                    ColToast("Sugiriendo un titulo con IA...");
                    var _t = await Propia.Web.Components.Shared.IaCampoTitulo.SugerirAsync(Auth(), "usuarios", campo.Label);
                    if (_t.Ok && !string.IsNullOrWhiteSpace(_t.Titulo))
                    {
                        try
                        {
                            var _rr = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/usuarios-campos/{campo.Id}",
                                new ActualizarCampoDefinicionRequest(_t.Titulo!, campo.Tipo, campo.Opciones, campo.Orden, campo.Descripcion));
                            if (_rr.IsSuccessStatusCode) { await CargarCamposU(Auth()); ColToast($"Titulo IA aplicado: {_t.Titulo}"); }
                            else ColToast("No se pudo aplicar el titulo sugerido.");
                        }
                        catch { ColToast("No se pudo aplicar el titulo sugerido."); }
                    }
                    else ColToast("La IA no pudo sugerir un titulo ahora.");
                }
                else ColToast("Sugerir titulo con IA solo aplica a campos propios.");
                break;
            default:
                ColToast("En construccion: " + accion + ".");
                break;
        }
        StateHasChanged();
    }

