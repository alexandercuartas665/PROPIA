    private async Task SubirFoto(InputFileChangeEventArgs e)
    {
        if (_editUser is null || e.File is null) return;
        if (e.File.Size > 5_000_000) { _msg = "La imagen supera 5 MB."; _msgClass = "alert-danger"; return; }
        _subiendoFoto = true; _msg = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(e.File.OpenReadStream(5_000_000));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(e.File.ContentType);
            content.Add(sc, "file", e.File.Name);
            var r = await Auth().PostAsync($"/api/usuarios/{_editUser.UsuarioTenantId}/foto", content);
            if (r.IsSuccessStatusCode)
            {
                var res = await r.Content.ReadFromJsonAsync<FotoResp>();
                _editFotoUrl = res?.Url;
                await CargarAsync();
            }
            else { _msg = "No se pudo subir la foto (" + (int)r.StatusCode + ")."; _msgClass = "alert-danger"; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _subiendoFoto = false; }
    }
