        _gobComiteId = Guid.Empty; _gobRevisorTp = ""; _gobCargoConsejo = CargoConsejo.Vocal;
        _gobEquipoRol = RolEquipo.Otro; _gobEquipoTipo = TipoVinculacion.Interno;
        _tablerosUser = null; _tableroSel = Guid.Empty;
        _perfilIncompletoAviso = false;
        try
        {
            var http = Auth();
            _comites = await http.GetFromJsonAsync<List<ComiteDto>>("/api/mi-copropiedad/comites") ?? new();
            _gobUser = await http.GetFromJsonAsync<GobiernoPersonaDto>($"/api/mi-copropiedad/gobierno/persona/{u.PersonaId}")
                       ?? new GobiernoPersonaDto(null, new List<GobiernoComiteTag>(), null, null);
            _tablerosUser = await http.GetFromJsonAsync<List<TableroDto>>("/api/tareas/tableros") ?? new();
        }
        catch { _gobUser = new GobiernoPersonaDto(null, new List<GobiernoComiteTag>(), null, null); _tablerosUser = new(); }
    }
