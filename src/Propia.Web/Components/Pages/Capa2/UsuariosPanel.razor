    private void SetTab(EstadoUsuarioTenant tab) { _tab = tab; _selU.Clear(); _ = CargarAsync(); }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync($"/api/usuarios?q={Uri.EscapeDataString(_query)}");
            if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden) { _sinPermiso = true; _usuarios = new(); _pendientes = new(); return; }
            resp.EnsureSuccessStatusCode();
            _usuarios = await resp.Content.ReadFromJsonAsync<List<UsuarioListaDto>>() ?? new();
            _pendientes = await http.GetFromJsonAsync<List<InvitacionDto>>("/api/usuarios/invitaciones") ?? new();
            _etiquetas = await http.GetFromJsonAsync<List<EtiquetaUsuarioDto>>("/api/usuarios/etiquetas") ?? new();
            await CargarCamposU(http);
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
    }

    // ---- Campos dinamicos: catalogo (usuarios-campos) + valores por usuario (usuarios-campos-valores) ----
    // La definicion es por copropiedad; el valor es por UsuarioTenantId (el mismo id que la fila usa como clave).
    private async Task CargarCamposU(HttpClient http)
    {
        try
        {
            var defs = await http.GetFromJsonAsync<List<CampoDinDef>>("/api/mi-copropiedad/usuarios-campos") ?? new();
            _defsCampos = defs.OrderBy(d => d.Orden).ThenBy(d => d.Label).ToList();
        }
        catch { _defsCampos = new(); }
        try
        {
            var vals = await http.GetFromJsonAsync<List<UsuarioCampoValorFlat>>("/api/mi-copropiedad/usuarios-campos-valores") ?? new();
            _valoresCampos = vals.GroupBy(v => v.UsuarioTenantId).ToDictionary(g => g.Key, g => g.ToDictionary(x => x.DefinicionId, x => x.Valor));
        }
        catch { _valoresCampos = new(); }
    }

