    // ---------------- Crear usuario (mismo modal, modo creacion) ----------------
    // Primera palabra = nombres, resto = apellidos (mismo criterio que la fila de alta, UsuariosTablaVista.PartirNombre).
    private static (string Nombres, string Apellidos) PartirNombreU(string completo)
    {
        var p = (completo ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length <= 1) return (p.Length == 1 ? p[0] : "", "");
        return (p[0], string.Join(" ", p[1..]));
    }
    // Valida los minimos (documento + nombre completo + al menos un rol) y, si pasan, crea el usuario reusando el
    // flujo de alta (crea la persona en el Directorio si no existe, crea el UsuarioTenant en Invitacion pendiente,
    // persiste celular) y ABRE su ficha. Si algo falla, el flujo muestra el error y no crea.
    private async Task GuardarCrear()
    {
        var nombre = (_nuevoNombre ?? "").Trim();
        if (string.IsNullOrWhiteSpace(_nuevoDoc)) { _msg = "El documento es obligatorio."; _msgClass = "alert-danger"; return; }
        if (nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length < 2) { _msg = "Escribe el nombre completo (nombres y apellidos)."; _msgClass = "alert-danger"; return; }
        if (_editRolIds.Count == 0) { _msg = "Asigna al menos un rol."; _msgClass = "alert-danger"; return; }
        var (nombres, apellidos) = PartirNombreU(nombre);
        var draft = new NuevoUsuarioInvitar(
            _nuevoTipoDoc, _nuevoDoc.Trim(), nombres, apellidos, _editRolIds[0],
            string.IsNullOrWhiteSpace(_nuevoEmail) ? null : _nuevoEmail.Trim(),
            string.IsNullOrWhiteSpace(_editTelefono) ? null : _editTelefono.Trim(),
            _editRolIds.ToList(),
            _editCargos.Count > 0 ? _editCargos.ToList() : null);
        _creando = false;
        await CrearUsuarioTablaAsync(draft, abrir: true);
    }

    // 2.5 v2.0: persiste lo editable del modal -> celular (Persona.Telefono), roles (multi), cargos (multi) y
    // estado (solo Activo<->Inactivo via revocar/reactivar; los "Pendiente" los fija el sistema). Cada paso es
    // un PUT/POST independiente; si uno falla se detiene mostrando el error y no cierra.
    private async Task GuardarEditar()
    {
        if (_editUser is null) return;
        _busy = true; _msg = null;
        try
        {
            var http = Auth();
            var id = _editUser.UsuarioTenantId;
            var cambios = false;

            // 1) Celular (Persona.Telefono): si cambio.
            var telNuevo = (_editTelefono ?? "").Trim();
            if (!string.Equals((_editUser.Telefono ?? "").Trim(), telNuevo, StringComparison.Ordinal))
            {
                var r = await http.PutAsJsonAsync($"/api/usuarios/{id}/telefono", new ActualizarTelefonoUsuarioRequest(telNuevo));
                if (!r.IsSuccessStatusCode) { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
                cambios = true;
            }

            // 2) Roles (multi): no vacio; el backend tambien lo valida.
            var rolesActuales = (_editUser.Roles?.Select(x => x.Id) ?? Enumerable.Empty<Guid>()).ToHashSet();
            if (_editRolIds.Count > 0 && !_editRolIds.ToHashSet().SetEquals(rolesActuales))
            {
                var r = await http.PutAsJsonAsync($"/api/usuarios/{id}/roles", new ActualizarRolesUsuarioRequest(_editRolIds.ToList()));
                if (!r.IsSuccessStatusCode) { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
                cambios = true;
            }

            // 3) Cargos (multi, descriptivos): vacio es valido.
            var cargosActuales = new HashSet<string>(_editUser.Cargos ?? Enumerable.Empty<string>(), StringComparer.OrdinalIgnoreCase);
            if (!new HashSet<string>(_editCargos, StringComparer.OrdinalIgnoreCase).SetEquals(cargosActuales))
            {
                var r = await http.PutAsJsonAsync($"/api/usuarios/{id}/cargos", new ActualizarCargosUsuarioRequest(_editCargos.ToList()));
                if (!r.IsSuccessStatusCode) { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
                cambios = true;
            }

            // 4) Estado: solo Activo<->Inactivo (revocar / reactivar).
            if (_editEstado != _editUser.Estado)
            {
                if (_editEstado == EstadoUsuarioTenant.Inactivo)
                {
                    var r = await http.PostAsJsonAsync($"/api/usuarios/{id}/revocar", new RevocarAccesoRequest(null));
                    if (!r.IsSuccessStatusCode) { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
                    cambios = true;
                }
                else if (_editEstado == EstadoUsuarioTenant.Activo && _editUser.Estado == EstadoUsuarioTenant.Inactivo)
                {
                    var r = await http.PostAsync($"/api/usuarios/{id}/reactivar", null);
                    if (!r.IsSuccessStatusCode) { _msg = await r.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
                    cambios = true;
                }
                else
                {
                    _msg = "Los estados 'Pendiente' los asigna el sistema; no se cambian a mano."; _msgClass = "alert-info";
                }
            }

            if (cambios && _msgClass != "alert-info") { _msg = "Cambios guardados."; _msgClass = "alert-success"; }
            _editUser = null;
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    // Multi-select de Rol/Cargo en el editar (chips asignados + disponibles para clic).
    private void ToggleEditRol(Guid id) { if (!_editRolIds.Remove(id)) _editRolIds.Add(id); }
    private void QuitarEditRol(Guid id) => _editRolIds.Remove(id);
    private void AgregarEditCargo(string c) { if (!_editCargos.Contains(c, StringComparer.OrdinalIgnoreCase)) _editCargos.Add(c); }
    private void QuitarEditCargo(string c) => _editCargos.RemoveAll(x => string.Equals(x, c, StringComparison.OrdinalIgnoreCase));

    // Datos del sistema (modal): label de estado (= badge de la tabla) y formato de fechas.
    private static string EstadoLabelU(EstadoUsuarioTenant e) => e switch
    {
        EstadoUsuarioTenant.Activo => "Activo",
        EstadoUsuarioTenant.Pendiente => "Invitación pendiente",
        EstadoUsuarioTenant.PendienteContacto => "Pendiente de contacto",
        EstadoUsuarioTenant.Inactivo => "Inactivo",
        _ => e.ToString()
    };
    private static string FechaCortaU(DateTimeOffset? d) => d.HasValue ? d.Value.ToLocalTime().ToString("yyyy-MM-dd") : "Sin registro";
    private static string FechaHoraU(DateTimeOffset? d) => d.HasValue ? d.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Sin registro";

    private async Task RevocarAccesoAsync(Guid usuarioTenantId)
    {
        var http = Auth();
        var resp = await http.PostAsJsonAsync($"/api/usuarios/{usuarioTenantId}/revocar",
            new RevocarAccesoRequest(null));
        if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgClass = "alert-danger"; return; }
        _msg = "Acceso revocado. Sesion invalidada."; _msgClass = "alert-success";
        _editUser = null;
        await CargarAsync();
    }

    private async Task Reactivar(Guid usuarioTenantId)
    {
        var http = Auth();
        await http.PostAsync($"/api/usuarios/{usuarioTenantId}/reactivar", null);
        _msg = "Acceso reactivado."; _msgClass = "alert-success";
        await CargarAsync();
    }

    // ---------------- Helpers ----------------
    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private static string Iniciales(string s)
    {
        var parts = s.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

}
