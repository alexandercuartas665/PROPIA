    // Lista filtrada (tab + reglas dinamicas), sin ordenar; se reusa en la vista y para saber
    // que ids son seleccionables. El orden por columna se aplica aparte, en la rama Tabla.
    // 2.5 v2.0: el tab "Pendientes" agrupa DOS estados (Invitacion pendiente + Pendiente de contacto).
    private static bool EnTab(EstadoUsuarioTenant estado, EstadoUsuarioTenant tab)
        => tab == EstadoUsuarioTenant.Pendiente
            ? (estado == EstadoUsuarioTenant.Pendiente || estado == EstadoUsuarioTenant.PendienteContacto)
            : estado == tab;

    private IEnumerable<UsuarioListaDto> UsuariosFiltrados()
    {
        if (_usuarios is null) return Enumerable.Empty<UsuarioListaDto>();
        return _usuarios.Where(u => EnTab(u.Estado, _tab))
            .Where(u => _fd?.Pasa(campo =>
            {
                if (campo.StartsWith("cd:", StringComparison.Ordinal) && Guid.TryParse(campo.AsSpan(3), out var defId))
                    return _valoresCampos.TryGetValue(u.UsuarioTenantId, out var m) && m.TryGetValue(defId, out var v) ? (v ?? "") : "";
                return campo switch
                {
                    "nombre" => u.NombreCompleto,
                    "documento" => u.Documento,
                    "email" => u.Email ?? "",
                    "telefono" => u.Telefono ?? "",
                    "rol" => u.RolId?.ToString() ?? "",
                    "cargo" => string.Join(",", u.Cargos),
                    "estado" => u.Estado.ToString(),
                    "etiqueta" => string.Join(",", u.Etiquetas.Select(e => e.Id)),
                    "ultimoacceso" => u.UltimoAcceso?.ToString("yyyy-MM-dd") ?? "",
                    "fechavinculacion" => u.FechaVinculacion?.ToString("yyyy-MM-dd") ?? "",
                    _ => ""
                };
            }) ?? true);
    }

