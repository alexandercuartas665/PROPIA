        try
        {
            if (_editRolId != Guid.Empty && _editRolId != _editUser.RolId)
            {
                var http = Auth();
                var resp = await http.PutAsJsonAsync($"/api/usuarios/{_editUser.UsuarioTenantId}/rol",
                    new CambiarRolUsuarioRequest(_editRolId));
