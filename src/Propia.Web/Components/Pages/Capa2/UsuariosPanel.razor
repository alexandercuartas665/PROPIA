            var r = await Auth().PostAsJsonAsync("/api/mi-copropiedad/comites/miembros", req);
            if (r.IsSuccessStatusCode) { _gobComiteId = Guid.Empty; await RecargarGobiernoAsync(); } else GobErr(r);
