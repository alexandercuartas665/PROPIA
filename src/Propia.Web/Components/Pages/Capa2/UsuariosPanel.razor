@using Propia.Application.UsuariosAccesos
@using Propia.Application.Directorio
@using Propia.Application.MiCopropiedad
@using Propia.Application.Tareas
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using Propia.Web.Components.Shared
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals

@if (!Embedded) { <PageTitle>Usuarios y Accesos - PROPIA</PageTitle> }

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

@if (_sinPermiso)
{
    <SinPermiso />
    return;
}

<div class="usr-wrap">

    @* ===================== Encabezado ===================== *@
    <div class="mod-pagehead">
        @if (!Embedded)
        {
            <div>
                <h1 class="mod-pagetitle">Usuarios y Roles</h1>
                <p class="mod-pagesub">Quien puede ingresar y con que permisos. La identidad vive en el Directorio.</p>
            </div>
        }
        <div class="d-flex gap-2 flex-wrap">
            <button class="usr-btn-ghost" @onclick='() => Nav.NavigateTo("/roles")'>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.1A1.6 1.6 0 0 0 6 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.6 1.6 0 0 0 4.6 15H4.5a2 2 0 1 1 0-4h.1A1.6 1.6 0 0 0 6 8.6a1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H10a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V8c0 .7.4 1.3 1 1.5h.1a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1 1.5z"></path></svg>
                Roles y permisos
            </button>
            <button class="usr-btn-primary" @onclick="AbrirInvitar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6"></path></svg>
                Invitar usuario
            </button>
        </div>
    </div>

    @* Las etiquetas se administran dentro del usuario (modal Editar): alli se asignan, se quitan
       y se crean. El catalogo es del tenant, asi que una etiqueta creada queda para todos. *@

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @_msgClass py-2 small">@_msg</div>
    }

    @* KPIs (2.5 v2.0): Usuarios (total) / Activos / Invitacion pendiente. *@
    @if (_usuarios is not null)
    {
        <div class="usr-kpis">
            <div class="usr-kpi">
                <div class="usr-kpi-n">@_usuarios.Count</div>
                <div class="usr-kpi-l">Usuarios</div>
            </div>
            <div class="usr-kpi">
                <div class="usr-kpi-n">@_usuarios.Count(u => u.Estado == EstadoUsuarioTenant.Activo)</div>
                <div class="usr-kpi-l">Activos</div>
            </div>
            <div class="usr-kpi">
                <div class="usr-kpi-n">@_usuarios.Count(u => u.Estado == EstadoUsuarioTenant.Pendiente)</div>
                <div class="usr-kpi-l">Invitación pendiente</div>
            </div>
        </div>
    }

    @* Tabs Activos / Pendientes / Inactivos (sin tarjetas indicador). *@
    <div class="usr-tabs">
        <button type="button" class="usr-tab @(_tab == EstadoUsuarioTenant.Activo ? "active" : "")" @onclick="() => SetTab(EstadoUsuarioTenant.Activo)">Activos</button>
        <button type="button" class="usr-tab @(_tab == EstadoUsuarioTenant.Pendiente ? "active" : "")" @onclick="() => SetTab(EstadoUsuarioTenant.Pendiente)">Pendientes</button>
        <button type="button" class="usr-tab @(_tab == EstadoUsuarioTenant.Inactivo ? "active" : "")" @onclick="() => SetTab(EstadoUsuarioTenant.Inactivo)">Inactivos</button>
    </div>

    @* ===================== Buscador + filtros + vista ===================== *@
    <div class="mod-filtros">
        @* Boton "Filtros" PRIMERO (reglas dinamicas, patron Tareas) y luego el buscador. *@
        @if (!_verInvitaciones || _tab != EstadoUsuarioTenant.Pendiente)
        {
            <FiltroDinamico @ref="_fd" Campos="CamposFiltroUsr" OnChanged="StateHasChanged" />
        }
        <div class="mod-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="mod-search-inp" style="width:280px;" placeholder="Buscar por nombre, documento, email o rol..." @bind="_query" @bind:event="oninput" @onkeyup="CargarAsync" />
        </div>
        @if (!_verInvitaciones || _tab != EstadoUsuarioTenant.Pendiente)
        {
            <div class="usr-bar-right">
                @* "Columnas" (solo en vista Tabla): orden, visibilidad. Usuarios NO tiene campos
                   propios, asi que no hay "+", ni engranaje, ni borrar-campo (solo configurar las fijas). *@
                @if (_vista == "tabla")
                {
                    @* Ordenar (multi-criterio apilable): fuente unica compartida. *@
                    <TablaOrdenarMenu Columnas="ColsOrdenablesU()" Sorts="_sortsU" SortsChanged="OnSortsUChanged" />
                    @* Agrupar (menu compartido, multi-nivel): fuente unica (TablaAgruparMenu + TablaAgrupador +
                       TablaGruposRender). El render agrupado vive en UsuariosTablaVista (donde esta la fila). *@
                    <TablaAgruparMenu Columnas="ColsAgrupablesU()" Grupos="_gruposU" GruposChanged="OnGruposUChanged" />
                    <div class="usr-menu-wrap">
                        <button type="button" class="usr-fbtn @(_showColMenuU ? "on" : "")" @onclick="() => _showColMenuU = !_showColMenuU" title="Campos y columnas de la tabla">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                            <span>Columnas</span>
                        </button>
                        @if (_showColMenuU)
                        {
                            <div class="usr-menu-bd" @onclick="() => _showColMenuU = false"></div>
                            <div class="usr-menu usr-colmenu">
                                <div class="usr-col-search">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                                    <input placeholder="Buscar columna..." value="@_colQU" @oninput="@(e => _colQU = e.Value?.ToString() ?? string.Empty)" />
                                </div>
                                <div class="usr-col-list">
                                    @{ var _colsU = ClavesOrdenadasU().ToList(); }
                                    @for (int _ci = 0; _ci < _colsU.Count; _ci++)
                                    {
                                        var k = _colsU[_ci];
                                        var idx = _ci;
                                        var label = ColLabelU(k);
                                        if (!string.IsNullOrWhiteSpace(_colQU) && !label.Contains(_colQU, StringComparison.OrdinalIgnoreCase)) { continue; }
                                        var fija = idx == 0;
                                        var visible = VisibleColU(k);
                                        <div class="usr-col-it">
                                            <button class="usr-col-mv" disabled="@(idx <= 1)" @onclick="() => MoverColumnaUAsync(k, -1)">&#9650;</button>
                                            <button class="usr-col-mv" disabled="@(idx == 0 || idx == _colsU.Count - 1)" @onclick="() => MoverColumnaUAsync(k, 1)">&#9660;</button>
                                            <span class="usr-col-name">@label</span>
                                            @if (fija) { <span class="usr-col-fija">fija</span> }
                                            else
                                            {
                                                <button class="usr-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => ToggleVisibleColUAsync(k)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                            }
                                        </div>
                                    }
                                    @* Campos propios (dinamicos): en la misma lista, con badge "din" y borrar
                                       (crear = "+" del header; editar = engranaje de la columna). *@
                                    @foreach (var d in _defsCampos)
                                    {
                                        var dd = d;
                                        var dkey = "cd:" + dd.Id;
                                        if (!string.IsNullOrWhiteSpace(_colQU) && !d.Label.Contains(_colQU, StringComparison.OrdinalIgnoreCase)) { continue; }
                                        var dvis = VisibleColU(dkey);
                                        <div class="usr-col-it">
                                            <button class="usr-col-eye @(dvis ? "on" : "")" title="@(dvis ? "Ocultar" : "Mostrar")" @onclick="@(() => ToggleVisibleColUAsync(dkey))"><i class="fi @(dvis ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                            <span class="usr-col-name">@d.Label <span class="usr-col-dyn" title="Campo personalizado">din</span></span>
                                            <button class="usr-col-eye on" title="Editar campo" @onclick="() => AbrirEditarCampoU(dd)"><i class="fi fi-rr-settings-sliders"></i></button>
                                            <button class="usr-col-del" title="Eliminar campo (definicion y valores)" @onclick="() => EliminarCampoUAsync(dd)"><i class="fi fi-rr-trash"></i></button>
                                        </div>
                                    }
                                </div>
                                <div class="usr-col-massacts">
                                    <button type="button" class="usr-col-mass" @onclick="OcultarTodasColUAsync"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                                    <button type="button" class="usr-col-mass" @onclick="MostrarTodasColUAsync"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                                    <button type="button" class="usr-col-reset" @onclick="RestablecerColUAsync">Restablecer</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                @* Dos vistas, las mismas que el Directorio: Lista (filas con avatar) y Tabla
                   (todas las columnas + alta inline). Mismo toggle para que se lean igual. *@
                <div class="usr-viewtoggle">
                    <button class="usr-vbtn @(_vista == "lista" ? "on" : "")" @onclick='() => SetVista("lista")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                        Tarjetas
                    </button>
                    <button class="usr-vbtn @(_vista == "tabla" ? "on" : "")" @onclick='() => SetVista("tabla")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                        Tabla
                    </button>
                </div>
            </div>
        }
    </div>

    @* 2.5 v2.0: las 3 pestanas (Activos/Pendientes/Inactivos) usan la MISMA tabla principal, filtrada por
       estado (Pendientes agrupa Invitacion pendiente + Pendiente de contacto). La vista separada de
       invitaciones queda deshabilitada (_verInvitaciones=false); se conserva por si se requiere. *@
    @if (_verInvitaciones && _tab == EstadoUsuarioTenant.Pendiente)
    {
        @if (_pendientes is null)
        {
            <div class="text-center py-5"><div class="spinner-border" style="color:var(--propia-brand)"></div></div>
        }
        else if (_pendientes.Count == 0)
        {
            <div class="usr-empty">Sin invitaciones pendientes.</div>
        }
        else
        {
            @* Vista TABLA al canon de la maqueta (componentes.html / tabla-base.css): frame .tbl dentro de
               .tblwrap/.tblscroll, header sticky con separadores verticales, filas canon (.nom/.mut/badge).
               Columnas: Persona / Rol / Estado / Acciones. *@
            <div class="tblwrap">
                <div class="tblscroll">
                    <table class="tbl">
                        <colgroup>
                            <col style="width:36%" /><col style="width:16%" /><col style="width:24%" /><col style="width:24%" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Persona</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in _pendientes)
                            {
                                var iid = i.Id;
                                var vencida = i.ExpiraAt < DateTimeOffset.UtcNow;
                                <tr>
                                    <td class="nom">
                                        <div>@i.PersonaNombre</div>
                                        <div class="mut" style="font-weight:400;font-size:11.5px">@i.PersonaDocumento</div>
                                    </td>
                                    <td><span class="usr-rol">@i.RolNombre</span></td>
                                    <td>
                                        @if (vencida)
                                        {
                                            <span class="usr-badge-inact">Invitacion vencida</span>
                                        }
                                        else
                                        {
                                            <span class="usr-badge-pend">Invitacion enviada</span>
                                        }
                                        <div class="mut" style="font-size:11.5px;margin-top:3px">Expira @i.ExpiraAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1 flex-wrap">
                                            <button class="usr-rowbtn" @onclick="() => CopiarLink(i)">Copiar link</button>
                                            <button class="usr-rowbtn" @onclick="() => Reenviar(iid)">Reenviar</button>
                                            <button class="usr-rowbtn usr-rowbtn-danger" @onclick="() => Cancelar(iid)">Cancelar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        @* ===================== Tabla Activos / Inactivos ===================== *@
        @if (_usuarios is null)
        {
            <div class="text-center py-5"><div class="spinner-border" style="color:var(--propia-brand)"></div></div>
        }
        else
        {
            var lista = UsuariosFiltrados().ToList();
            @* Orden por columna (clic en cabecera de la vista Tabla), antes de paginar. *@
            @if (_sortsU.Count > 0)
            {
                lista = lista
                    .OrderBy(u => u, Comparer<UsuarioListaDto>.Create((a, b) =>
                    {
                        foreach (var s in _sortsU)
                        {
                            var c = CmpValTabla(ValorOrdenU(a, s.Key), ValorOrdenU(b, s.Key)) * s.Dir;
                            if (c != 0) return c;
                        }
                        return 0;
                    }))
                    .ToList();
            }
            @if (lista.Count == 0 && _vista == "lista")
            {
                <div class="usr-empty">Sin usuarios @_tab.ToString().ToLower() en esta copropiedad.</div>
            }
            else if (_vista == "lista")
            {
                <UsuariosListaVista Usuarios="lista" OnEditar="AbrirEditar" OnReactivar="Reactivar" />
            }
            else
            {
                @* La Tabla siempre se pinta aunque no haya usuarios: su fila de alta es la
                   via para invitar en caliente (mismo criterio que el Directorio). Render-all +
                   scroll infinito + FAB (canon Unidades/Roles): sin paginacion de servidor. *@
                @* Barra de seleccion multiple: revocar acceso en lote (solo usuarios activos). *@
                @if (_selU.Count > 0)
                {
                    <div class="usr-selbar">
                        <span class="usr-selbar-n">@_selU.Count seleccionado@(_selU.Count == 1 ? "" : "s")</span>
                        <button type="button" class="usr-selbar-del" @onclick="() => _confirmRevocarU = true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            Revocar acceso
                        </button>
                        <button type="button" class="usr-selbar-x" @onclick="LimpiarSelU">Deseleccionar</button>
                    </div>
                }
                @if (_confirmRevocarU)
                {
                    <div class="usr-cfg-back" @onclick="() => { if (!_revocandoU) _confirmRevocarU = false; }">
                        <div class="usr-confirm" @onclick:stopPropagation="true">
                            <div class="usr-confirm-t">Revocar @_selU.Count acceso@(_selU.Count == 1 ? "" : "s")</div>
                            <div class="usr-confirm-s">Invalida la sesión y bloquea el ingreso de los usuarios seleccionados a la copropiedad. Se puede reactivar luego.</div>
                            <div class="usr-confirm-acts">
                                <button type="button" class="usr-btn-ghost" @onclick="() => _confirmRevocarU = false" disabled="@_revocandoU">Cancelar</button>
                                <button type="button" class="usr-selbar-del" @onclick="RevocarSelUAsync" disabled="@_revocandoU">@(_revocandoU ? "Revocando..." : "Si, revocar")</button>
                            </div>
                        </div>
                    </div>
                }
                @* Render-all: se alimenta la lista filtrada+ordenada COMPLETA (agrupada o no); el hijo
                   muestra el footer con el conteo y el FAB, y con agrupacion los oculta. *@
                <UsuariosTablaVista Usuarios="lista" Grupos="_gruposU" Roles="_roles" CargoOpciones="_cargoOpciones"
                                    Total="lista.Count" CrearRolInline="CrearRolInlineAsync"
                                    OnEditar="AbrirEditar" OnReactivar="Reactivar" OnInvitar="InvitarUsuarioTabla"
                                    OnCrearAbrir="CrearUsuarioAbrirTabla"
                                    SortKey="@_sortKeyU" SortDir="_sortDirU" OnOrdenar="OrdenarPorColumnaU"
                                    OnRevocar="RevocarAccesoAsync" OnMensaje="MostrarMensajeInfo"
                                    Columnas="ColsVisiblesU().ToList()" ColLabels="LabelsU()" GridStyle="@UtbGridStyleU"
                                    Seleccion="_selU" TodasSel="TodasSelU" OnToggleSel="ToggleSelU" OnToggleSelAll="ToggleSelAllU"
                                    OnReordenarCol="ReordenarColUAsync" OnRedimensionarCol="RedimensionarColUAsync"
                                    Defs="DefsVisiblesU()" Valores="_valoresCampos"
                                    OnGuardarDinamico="GuardarDinamicoU" OnCrearCampo="AbrirCrearCampoU" OnEditarCampoDef="AbrirEditarCampoU"
                                    OnAbrirColMenu="AbrirColMenuU" />
            }
        }
    }
</div>

@* Menu de columna (chevron del header de la tabla de Usuarios, estilo Airtable): se pinta una sola vez
   y lo abre UsuariosTablaVista via OnAbrirColMenu. Toast inline propio (patron de Tareas) para los avisos. *@
<TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" />
@if (_colToast is not null)
{
    <div style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--propia-text-h1);color:var(--propia-text-inverse);padding:8px 16px;border-radius:9px;z-index:5000;font-size:12.5px;cursor:pointer;box-shadow:0 6px 18px rgba(27,42,58,.28);" @onclick="() => _colToast = null">@_colToast</div>
}

@* ============================================================ *@
@* MODAL: Invitar usuario                                       *@
@* ============================================================ *@
@if (_showInvitar)
{
    <div class="usr-modal-bg" @onclick="CerrarInvitar">
        <div class="usr-modal" @onclick:stopPropagation="true">
            <div class="usr-modal-head">
                <div class="usr-modal-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6"></path></svg>
                </div>
                <div class="flex-grow-1">
                    <div class="usr-modal-title">Invitar usuario</div>
                    <div class="usr-modal-subtitle">Busca la persona en el Directorio y asignale un rol</div>
                </div>
                <ModalHeaderActions EnEdicion="true" MostrarEditar="false" MostrarEliminar="false"
                                    MostrarCancelar="true" Guardando="_busy"
                                    PuedeGuardar="@(_personaSel is not null && _invRolId != Guid.Empty)"
                                    TituloGuardar="Enviar invitacion" OnGuardar="EnviarInvitacion"
                                    OnCancelarEdicion="CerrarInvitar" OnCerrar="CerrarInvitar" />
            </div>
            <div class="usr-modal-body">
                <label class="usr-label">Buscar en el Directorio</label>
                <input class="usr-input" placeholder="Nombre, documento o email" @bind="_buscarPersona" @bind:event="oninput" @onkeyup="BuscarPersonas" disabled="@(_personaSel is not null)" />

                @if (_personaSel is null)
                {
                    @if (_personasEncontradas.Count > 0)
                    {
                        <div class="usr-results">
                            @foreach (var p in _personasEncontradas)
                            {
                                var pp = p;
                                <button type="button" class="usr-result" @onclick="() => SeleccionarPersona(pp)">
                                    <div class="usr-av" style="width:34px;height:34px;font-size:12px">@Iniciales($"{p.Nombres} {p.Apellidos}")</div>
                                    <div class="min-w-0">
                                        <div class="usr-name">@p.Nombres @p.Apellidos</div>
                                        <div class="usr-email">@p.TipoDocumento @p.Documento @(string.IsNullOrEmpty(p.Email) ? "" : $". {p.Email}")</div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="usr-hint">El acceso siempre se otorga a una persona existente en el Directorio (RN-02). Si no aparece, agregala primero alli.</div>
                    }
                }
                else
                {
                    <div class="usr-pick">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="usr-av">@Iniciales($"{_personaSel.Nombres} {_personaSel.Apellidos}")</div>
                            <div class="min-w-0">
                                <div class="usr-name">@_personaSel.Nombres @_personaSel.Apellidos</div>
                                <div class="usr-email">@_personaSel.TipoDocumento @_personaSel.Documento @(string.IsNullOrEmpty(_personaSel.Email) ? "" : $". {_personaSel.Email}")</div>
                            </div>
                            <button class="usr-rowbtn ms-auto" @onclick="() => _personaSel = null">Cambiar</button>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="usr-label">Rol a asignar</label>
                                <select class="usr-select" @bind="_invRolId">
                                    <option value="@Guid.Empty">- Selecciona -</option>
                                    @foreach (var r in _roles.Where(r => r.Activo))
                                    {
                                        <option value="@r.Id">@r.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="usr-label">Canal de envio</label>
                                <select class="usr-select" @bind="_invCanal">
                                    <option value="@CanalEnvioInvitacion.Email">Email</option>
                                    <option value="@CanalEnvioInvitacion.Whatsapp">WhatsApp</option>
                                    <option value="@CanalEnvioInvitacion.Ambos">Email + WhatsApp</option>
                                </select>
                            </div>
                        </div>
                        <div class="usr-note">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                            El token de invitacion expira en 72 horas (RN-11).
                        </div>
                    </div>
                }

                @if (_ultimaInvitacion is not null)
                {
                    <div class="usr-link-ok">
                        <div class="fw-bold mb-1" style="color:var(--propia-success-hover)">Invitacion creada. Comparte este link:</div>
                        <code class="user-select-all d-block mb-2" style="word-break:break-all">@LinkInvitacion(_ultimaInvitacion)</code>
                        <button class="usr-rowbtn" @onclick="CopiarLinkUltima">Copiar link</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================================================ *@
@* MODAL: Editar usuario                                        *@
@* ============================================================ *@
@* MISMO modal para CREAR (_creando: identidad editable, "Crear usuario") y EDITAR (_editUser: identidad
   de solo lectura + estado/datos/zona, "Guardar cambios"). *@
@if (_editUser is not null || _creando)
{
    <div class="usr-modal-bg" @onclick="CerrarEditar">
        <div class="usr-modal usr-modal-user" @onclick:stopPropagation="true">
            <div class="usr-modal-head">
                <div class="usr-modal-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </div>
                <div class="flex-grow-1">
                    <div class="usr-modal-title">@(_creando ? "Crear usuario" : "Editar usuario")</div>
                    <div class="usr-modal-subtitle">Rol de acceso, cargo y participacion en la copropiedad</div>
                </div>
                <ModalHeaderActions EnEdicion="true" MostrarEditar="false" MostrarEliminar="false"
                                    MostrarCancelar="false" Guardando="_busy"
                                    TituloGuardar="@(_creando ? "Crear usuario" : "Guardar cambios")"
                                    OnGuardar="@(async () => { if (_creando) await GuardarCrear(); else await GuardarEditar(); })"
                                    OnCerrar="CerrarEditar" />
            </div>
            <div class="usr-modal-body">
            <div class="usr-mgrid">
            @* ---------- Columna izquierda: identidad (editable solo al crear) + rol + cargo ---------- *@
            <div class="usr-mcol">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="usr-av-edit">
                        @if (!_creando && !string.IsNullOrWhiteSpace(_editFotoUrl))
                        {
                            <img class="usr-av usr-av-img" style="width:64px;height:64px;border-radius:15px" src="@_editFotoUrl" alt="@_editUser!.NombreCompleto" />
                        }
                        else
                        {
                            <div class="usr-av" style="width:64px;height:64px;border-radius:15px;font-size:21px">@Iniciales(_creando ? _nuevoNombre : _editUser!.NombreCompleto)</div>
                        }
                        @if (!_creando)
                        {
                            <label class="usr-av-cam" title="Cambiar foto">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                                <InputFile OnChange="SubirFoto" accept="image/png,image/jpeg,image/webp" style="display:none" />
                            </label>
                        }
                    </div>
                    <div>
                        <div class="usr-name" style="font-size:16px">@(_creando ? (string.IsNullOrWhiteSpace(_nuevoNombre) ? "Nuevo usuario" : _nuevoNombre) : _editUser!.NombreCompleto)</div>
                        <div class="usr-email">@(_creando ? "Se registrara en el Directorio" : (_editUser!.Email ?? "Sin correo") + (_editUser.TieneCuentaPropia ? ". Con cuenta propia" : ". Solo en directorio"))</div>
                        @if (_subiendoFoto) { <div class="usr-email" style="color:#1E88E5">Subiendo foto...</div> }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="usr-label">Nombre completo@(_creando ? " *" : "")</label>
                    @if (_creando)
                    {
                        <input class="usr-input" @bind="_nuevoNombre" @bind:event="oninput" placeholder="Nombres y apellidos" />
                    }
                    else
                    {
                        <input class="usr-input" value="@_editUser!.NombreCompleto" disabled />
                    }
                </div>
                @* Documento + Correo: editables SOLO al crear (persona nueva); al editar son solo lectura (Directorio). *@
                <div class="usr-mgrid mb-3" style="grid-template-columns:1fr 1fr;gap:12px">
                    <div>
                        <label class="usr-label">@(_creando ? "Documento *" : "Documento de identidad")</label>
                        @if (_creando)
                        {
                            <input class="usr-input" @bind="_nuevoDoc" @bind:event="oninput" placeholder="Numero de documento" />
                        }
                        else
                        {
                            <input class="usr-input" value="@_editUser!.Documento" disabled />
                        }
                    </div>
                    <div>
                        <label class="usr-label">@(_creando ? "Correo (opcional)" : "Correo de acceso")</label>
                        @if (_creando)
                        {
                            <input class="usr-input" @bind="_nuevoEmail" @bind:event="oninput" placeholder="correo@@ejemplo.com" />
                        }
                        else
                        {
                            <input class="usr-input" value="@(_editUser!.Email ?? "")" disabled />
                        }
                    </div>
                </div>
                @* Celular (WhatsApp): editable en ambos modos (persiste en Persona.Telefono). *@
                <div class="mb-2">
                    <label class="usr-label">Celular (WhatsApp)</label>
                    <input class="usr-input" @bind="_editTelefono" @bind:event="oninput" placeholder="Numero de celular" />
                </div>
                <div class="usr-hint" style="margin-top:0;margin-bottom:14px">@(_creando ? "La persona se registra en el Directorio; la foto y mas datos se completan luego en la ficha." : "La identidad (nombre, documento, correo) es unica por persona y se edita en el Directorio.")</div>

                @* ROL (multi): chips asignados (x) + disponibles (clic para asignar). Otorga permisos (RBAC). *@
                <div class="usr-gob-sec">
                    <div class="usr-gob-sec-t">ROL@(_creando ? " *" : "")</div>
                    <div class="usr-gob-sec-hint">Otorga permisos en PropIA (referencia a Roles y Permisos). Un usuario puede tener varios.</div>
                    <div class="usr-etq-list">
                        @foreach (var rid in _editRolIds)
                        {
                            var rr = rid;
                            var rn = _roles.FirstOrDefault(r => r.Id == rr)?.Nombre
                                     ?? _editUser?.Roles.FirstOrDefault(x => x.Id == rr)?.Nombre ?? "Rol";
                            <span class="usr-etq-chip" style="background:var(--propia-brand-soft);color:var(--propia-brand-text-2, var(--propia-brand));border-color:transparent">@rn<button class="usr-etq-x" title="Quitar" @onclick="() => QuitarEditRol(rr)">&times;</button></span>
                        }
                        @if (_editRolIds.Count == 0) { <span class="usr-etq-empty">Ninguno asignado</span> }
                    </div>
                    @{ var rolesDisp = _roles.Where(r => r.Activo && !_editRolIds.Contains(r.Id)).ToList(); }
                    @if (rolesDisp.Count > 0)
                    {
                        <div class="usr-etq-disp-t">Disponibles - clic para asignar</div>
                        <div class="usr-etq-list">
                            @foreach (var r in rolesDisp)
                            {
                                var rid3 = r.Id;
                                <span class="usr-etq-off"><button class="usr-etq-pick2" @onclick="() => ToggleEditRol(rid3)"><span class="usr-etq-dot" style="background:var(--propia-brand)"></span>@r.Nombre</button></span>
                            }
                        </div>
                    }
                </div>

                @* CARGO (multi, descriptivo, NO da permisos): chips + disponibles del catalogo "usuario.cargo". *@
                <div class="usr-gob-sec">
                    <div class="usr-gob-sec-t">CARGO</div>
                    <div class="usr-gob-sec-hint">Oficio o funcion del personal interno (descriptivo, no otorga permisos).</div>
                    <div class="usr-etq-list">
                        @foreach (var cg in _editCargos)
                        {
                            var cgv = cg;
                            <span class="usr-etq-chip" style="background:var(--propia-border-divider);color:var(--propia-text-body);border-color:transparent">@cgv<button class="usr-etq-x" title="Quitar" @onclick="() => QuitarEditCargo(cgv)">&times;</button></span>
                        }
                        @if (_editCargos.Count == 0) { <span class="usr-etq-empty">Ninguno asignado</span> }
                    </div>
                    @{ var cargosDisp = _cargoOpciones.Where(c => !_editCargos.Contains(c, StringComparer.OrdinalIgnoreCase)).ToList(); }
                    @if (cargosDisp.Count > 0)
                    {
                        <div class="usr-etq-disp-t">Disponibles - clic para asignar</div>
                        <div class="usr-etq-list">
                            @foreach (var c in cargosDisp)
                            {
                                var cv = c;
                                <span class="usr-etq-off"><button class="usr-etq-pick2" @onclick="() => AgregarEditCargo(cv)"><span class="usr-etq-dot" style="background:var(--propia-text-muted)"></span>@cv</button></span>
                            }
                        </div>
                    }
                </div>
            </div>

            @* ---------- Columna derecha: estado + sistema + zona de acceso (solo al editar) ---------- *@
            <div class="usr-mcol">
                @if (!_creando)
                {
                    @* ESTADO: el backend solo mueve Activo<->Inactivo (revocar/reactivar); "Pendiente..." los fija el sistema. *@
                    <div class="mb-3">
                        <label class="usr-label">Estado</label>
                        <select class="usr-select" @bind="_editEstado">
                            @foreach (var e in Enum.GetValues<EstadoUsuarioTenant>())
                            {
                                <option value="@e">@EstadoLabelU(e)</option>
                            }
                        </select>
                    </div>

                    @* DATOS DEL SISTEMA (solo lectura) *@
                    <div class="usr-gob-sec">
                        <div class="usr-gob-sec-t">Datos del sistema</div>
                        <div class="usr-sysrow"><span>Ultimo acceso</span><b>@FechaCortaU(_editUser!.UltimoAcceso)</b></div>
                        <div class="usr-sysrow"><span>Fecha de vinculacion</span><b>@FechaCortaU(_editUser!.FechaVinculacion)</b></div>
                        <div class="usr-sysrow"><span>Aceptacion de politica de datos</span><b>@(_editUser!.AceptoTratamientoDatos ? FechaHoraU(_editUser!.FechaAceptacionDatos) : "No registrada")</b></div>
                    </div>
                }
                else
                {
                    @* En creacion el estado es fijo (Invitacion pendiente); el usuario nace pendiente. *@
                    <div class="mb-3">
                        <label class="usr-label">Estado</label>
                        <input class="usr-input" value="Invitación pendiente" disabled />
                    </div>
                }

                @* PERSONA UNICA (callout): la identidad vive en el Directorio; la referencian varios modulos. *@
                <div class="usr-dir-box on">
                    <div class="usr-dir-ico">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <div class="flex-grow-1">
                        <div style="font-size:13px;font-weight:700;color:var(--propia-text-body)">Persona unica</div>
                        <div style="font-size:12px;color:var(--propia-ok)">@(_creando ? "Se registrara en el Directorio; Usuarios, Residentes y Terceros podran referenciarla." : "Registrada en el Directorio. Usuarios, Residentes y Terceros la referencian.")</div>
                    </div>
                </div>

                @if (!_creando)
                {
                    <div class="usr-security">
                        <div class="usr-sec-label">ZONA DE ACCESO</div>
                        <div class="d-flex align-items-center gap-3 usr-sec-box">
                            <div class="usr-sec-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>
                            <div class="flex-grow-1">
                                <div style="font-size:13px;font-weight:700;color:var(--propia-text-body)">Revocar acceso</div>
                                <div style="font-size:12px;color:var(--propia-text-faint);line-height:1.4">Invalida la sesión y bloquea el ingreso a la copropiedad. Se puede reactivar luego.</div>
                            </div>
                            <button class="usr-rowbtn usr-rowbtn-danger" @onclick="() => RevocarAccesoAsync(_editUser!.UsuarioTenantId)">Revocar</button>
                        </div>
                    </div>
                }
            </div>
            </div>
            </div>
        </div>
    </div>
}



@* ============================================================ *@
@* CAMPOS DINAMICOS (subsistema "usuarios")                     *@
@* ============================================================ *@
@* "+" del header de la tabla (crear) y engranaje de columna (editar/eliminar) abren este modal focalizado. *@
@if (_crearCampoAbierto)
{
    <CrearCampoModal Prefijo="usuarios"
                     TituloSingular="usuario"
                     Ejemplo="Ej. Extension, Fecha de ingreso"
                     Jwt="@_jwt"
                     Editar="_campoAEditar"
                     TiposAvanzados="true"
                     Guardado="RecargarCamposU"
                     Cerrado="() => { _crearCampoAbierto = false; _campoAEditar = null; }"
                     AbrirGestorAvanzado="AbrirGestorCamposU" />
}

@* Gestor de campos propios de usuarios. SinConfigSistema=true: SOLO gestiona las definiciones propias
   (crear/renombrar/editar tipo/eliminar) y NO toca unidades-config; las columnas FIJAS se configuran en
   el menu "Columnas" (bespoke de Usuarios). Asi ambos no escriben la misma config de columnas. *@
@if (_gestorCamposAbierto)
{
    <div class="usr-modal-bg" @onclick="() => _gestorCamposAbierto = false">
        <div class="usr-modal usr-modal-wide" @onclick:stopPropagation="true">
            <div class="usr-modal-head">
                <div class="usr-modal-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"></path></svg>
                </div>
                <div class="flex-grow-1">
                    <div class="usr-modal-title">Campos de usuarios</div>
                    <div class="usr-modal-subtitle">Campos propios de la copropiedad para la ficha de usuario.</div>
                </div>
                <button class="usr-modal-x" @onclick="() => _gestorCamposAbierto = false">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="usr-modal-body">
                <ConfigCamposEntidad Prefijo="usuarios"
                                     EntidadConfig="usuario"
                                     TituloSingular="usuario"
                                     TituloPlural="Usuarios"
                                     TiposAvanzados="true"
                                     SinConfigSistema="true"
                                     Ejemplo="Ej. Extension, Fecha de ingreso"
                                     Jwt="@_jwt"
                                     Cambiado="RecargarCamposU" />
            </div>
        </div>
    </div>
}

@* "Editar campo" de CUALQUIER columna de sistema de usuarios: UN solo modal canonico focalizado.
   - cargo: lista BLANDA (semillas del catalogo A&D 'usuario.cargo' + agregar por copropiedad).
   - rol / estado: lista EXCEPCION en SOLO LECTURA (universo gobernado: rol por la tabla de roles/RBAC,
     estado por la maquina de estado del sistema); no se agregan opciones.
   - resto (usuario/documento/email/telefono/fechas): sin lista (alias/descripcion/visibilidad). *@
@if (_editSisClave is not null)
{
    <EditarCampoSistemaModal Clave="@_editSisClave" DefLabel="@_editSisLabel" Tipo="@TipoSisU(_editSisClave)" Requerido="false"
                             EntidadConfig="usuario" TituloSingular="usuario" Jwt="@_jwt"
                             ListaCatalogo="@(_editSisClave == "cargo" ? "usuario.cargo" : null)"
                             SemillaFallback="@(_editSisClave == "cargo" ? _cargoOpciones.ToArray() : null)"
                             OpcionesLista="@OpcionesSisU(_editSisClave)"
                             PermiteAgregar="@(_editSisClave == "cargo")"
                             HintReadOnly="@HintSisU(_editSisClave)"
                             Guardado="OnCampoSistemaUGuardado" Cerrado="() => _editSisClave = null" />
}


<ModalHost />

@* Multi-select de Rol del modal "Editar usuario" (chips + menu). Local y autocontenido: el menu es
   position:absolute bajo el control (no necesita el anclaje JS de la tabla), asi funciona en cualquier vista. *@
<style>
    .urole-multi { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 5px; padding: 3px 2px; min-width: 0; }
    .urole-chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 4px 3px 10px; border-radius: 999px; font-size: 12.5px; font-weight: 700; white-space: nowrap; background: var(--propia-brand-soft); color: var(--propia-brand-text-2, var(--propia-brand)); }
    .urole-x { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; opacity: .55; font-size: 13px; line-height: 1; font-family: inherit; }
    .urole-x:hover { opacity: 1; background: var(--propia-brand-soft-2, rgba(109,79,227,.14)); }
    .urole-ph { font-size: 12.5px; color: var(--propia-text-faint); }
    .urole-add { flex: 0 0 auto; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; border: 1px dashed var(--propia-border-input); background: transparent; color: var(--propia-text-muted); border-radius: 6px; font-size: 15px; line-height: 1; cursor: pointer; font-family: inherit; }
    .urole-add:hover { border-style: solid; border-color: var(--propia-brand); color: var(--propia-brand); }
    .urole-back { position: fixed; inset: 0; z-index: 40; background: transparent; }
    .urole-menu { position: absolute; top: 100%; left: 0; margin-top: 4px; z-index: 4000; min-width: 220px; max-height: 280px; overflow: auto; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 10px; box-shadow: var(--propia-shadow-modal, 0 10px 30px rgba(27,42,58,.18)); padding: 5px; }
    .urole-opt { display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; padding: 7px 9px; border: 0; background: transparent; border-radius: 7px; font-size: 13px; color: var(--propia-text-body); cursor: pointer; font-family: inherit; }
    .urole-opt:hover { background: var(--propia-bg-card-soft); }
    .urole-opt.on { color: var(--propia-brand); font-weight: 700; }
    .urole-check { flex: 0 0 auto; width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid var(--propia-border-input); border-radius: 4px; font-size: 11px; color: var(--propia-brand); }
    .urole-opt.on .urole-check { border-color: var(--propia-brand); background: var(--propia-brand-soft); }
</style>

@code {
    // Embebido en el hub de Configuracion: oculta su page-head/PageTitle (conserva las acciones).
    [Parameter] public bool Embedded { get; set; }

    private string? _jwt;
    private bool _authChecked;
    private EstadoUsuarioTenant _tab = EstadoUsuarioTenant.Activo;
    // 2.5 v2.0: las 3 pestanas usan la tabla principal; la vista separada de invitaciones queda apagada.
    private const bool _verInvitaciones = false;
    private string _query = "";
    private bool _busy;
    private bool _sinPermiso;

    // ---- Campos dinamicos (subsistema "usuarios"): catalogo + valores por usuario ----
    private List<CampoDinDef> _defsCampos = new();
    private Dictionary<Guid, Dictionary<Guid, string?>> _valoresCampos = new();  // registro(UsuarioTenantId) -> (defId -> valor)
    private bool _crearCampoAbierto;
    private CampoDinDef? _campoAEditar;
    private bool _gestorCamposAbierto;
    // "Editar campo" de una columna de sistema tipo lista (hoy "cargo") -> modal canonico.
    private string? _editSisClave;
    private string _editSisLabel = "";
    private async Task OnCargoListaGuardada() { await RecargarCargoOpciones(); StateHasChanged(); }
    // Tras editar un campo de sistema (alias/descripcion/visibilidad, o agregar opcion de cargo) recarga lo que
    // corresponda: la config de columnas siempre; las opciones de cargo si fue esa lista (para el select de celda).
    private async Task OnCampoSistemaUGuardado()
    {
        if (_editSisClave == "cargo") await RecargarCargoOpciones();
        await CargarCfgUAsync();
        StateHasChanged();
    }

    // Tipo del campo de sistema por columna (fija el label de tipo y si se muestra seccion de lista).
    private static Propia.Domain.Enums.TipoCampoTablero? TipoSisU(string clave) => clave switch
    {
        "cargo" or "rol" or "estado" => Propia.Domain.Enums.TipoCampoTablero.Seleccion,
        "telefono" => Propia.Domain.Enums.TipoCampoTablero.Telefono,
        "email" => Propia.Domain.Enums.TipoCampoTablero.Email,
        "ultimoacceso" or "fechavinculacion" => Propia.Domain.Enums.TipoCampoTablero.Fecha,
        _ => Propia.Domain.Enums.TipoCampoTablero.Texto
    };
    // Opciones de las listas EXCEPCION (solo lectura): rol = tabla de roles del tenant; estado = maquina de estado.
    private List<EditarCampoSistemaModal.OpcionVista>? OpcionesSisU(string clave) => clave switch
    {
        "rol" => RolesComoOpcionesU(),
        "estado" => EstadosComoOpcionesU(),
        _ => null
    };
    private List<EditarCampoSistemaModal.OpcionVista> RolesComoOpcionesU()
        => _roles.Where(r => r.Activo).Select(r => new EditarCampoSistemaModal.OpcionVista(r.Nombre)).ToList();
    // Universo de estados del usuario (labels iguales al badge de la tabla, ver UsuariosTablaVista.EstadoChip).
    private static List<EditarCampoSistemaModal.OpcionVista> EstadosComoOpcionesU() => new()
    {
        new("Activo"), new("Invitación pendiente"), new("Pendiente de contacto"), new("Inactivo")
    };
    private static string HintSisU(string clave) => clave switch
    {
