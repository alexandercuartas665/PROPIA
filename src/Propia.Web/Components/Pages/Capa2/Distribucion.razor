    // ===== Configuracion de columnas (POR COPROPIEDAD, en unidad_campos_config) =====
    // El orden (Orden) y la visibilidad (Oculto) de cada campo se guardan en la config del tenant,
    // ya no en localStorage: lo que configura un administrador lo ve toda la copropiedad.
    private bool _cfgColsAbierto;
    // Orden por defecto: TODOS los campos del sistema (mas 'agrupacion' derivado) pueden ser columnas.
    // La 'ubicacion' de un campo = su posicion en este orden (que es el orden de columnas de la tabla).
    private static readonly string[] ColDefaultOrder =
    {
        "num", "tipo", "estado", "agrupacion", "coef", "area", "piso", "habitaciones",
        "banos", "parqueaderos", "matricula", "refpago", "pagaadmin", "cuota", "observaciones"
    };
    // Columnas visibles por defecto (las demas quedan disponibles pero ocultas hasta que se activen).
    private static readonly HashSet<string> ColVisibleDefault = new(StringComparer.Ordinal)
    { "num", "tipo", "agrupacion", "matricula", "coef", "refpago" };

    private sealed record ColDef(string Key, string DefLabel, string Width, bool Hideable);
    // Catalogo dinamico: los labels de agrupacion/piso salen de la identidad de la copropiedad.
    // TODOS los campos del sistema son columnas potenciales (mostrar/ocultar/reordenar).
    private ColDef[] Catalogo => new[]
    {
        new ColDef("num", "UNIDAD", "130px", false),
        new ColDef("tipo", "TIPO", "1fr", true),
        new ColDef("estado", "ESTADO", "1fr", true),
        new ColDef("agrupacion", "AGRUPACION", ".9fr", true),
        new ColDef("coef", "COEFICIENTE", ".9fr", true),
        new ColDef("area", "AREA", ".8fr", true),
        new ColDef("piso", "PISO", "70px", true),
        new ColDef("habitaciones", "HABITACIONES", "90px", true),
        new ColDef("banos", "BANOS", "70px", true),
        new ColDef("parqueaderos", "PARQUEADEROS", "100px", true),
        new ColDef("matricula", "MATRICULA", "1.1fr", true),
        new ColDef("refpago", "REF PAGO", "1.1fr", true),
        new ColDef("pagaadmin", "PAGA ADMIN", "90px", true),
        new ColDef("cuota", "CUOTA MENSUAL", "1fr", true),
        new ColDef("observaciones", "OBSERVACIONES", "1.3fr", true),
    };

    // Item unificado de columna: campo del sistema (Def) o campo personalizado (Campo). El orden y la
    // visibilidad de ambos viven en la MISMA config del tenant, asi todo se arrastra junto.
    private sealed record ColItem(string Key, bool EsCustom, ColDef? Def, UnidadCampoDefinicionDto? Campo);
    private static string CampoKey(UnidadCampoDefinicionDto d) => "cd:" + d.Id;
    private static bool EsClaveCustom(string clave) => clave.StartsWith("cd:", StringComparison.Ordinal);

    // Visibilidad: lo guardado por la copropiedad; si el campo no tiene config, su default.
    private static bool VisiblePorDefecto(string clave) => EsClaveCustom(clave) || ColVisibleDefault.Contains(clave);
    private bool VisibleDe(string clave)
        => _camposConfig.TryGetValue(clave, out var c) ? !c.Oculto : VisiblePorDefecto(clave);
    private bool EsVisible(ColDef c) => !c.Hideable || VisibleDe(c.Key);   // 'num' siempre visible
    private bool EsVisibleItem(ColItem it) => it.EsCustom ? VisibleDe(it.Key) : EsVisible(it.Def!);

    // Encabezado de columna: alias de la copropiedad (Configurar) > etiqueta por defecto.
    private string Etiqueta(ColDef c) => AliasCampo(c.Key, c.DefLabel);

    // Orden efectivo: el 'orden' guardado por campo. Los que no lo tienen (todavia nadie los movio)
    // van despues, conservando el orden por defecto del catalogo.
    private int OrdenDe(string clave, int fallback)
        => _camposConfig.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;

    // Todas las columnas (sistema + personalizados) en el orden configurado.
    private IEnumerable<ColItem> ColumnasOrdenadas
    {
        get
        {
            var items = new List<ColItem>();
            var bySys = Catalogo.ToDictionary(c => c.Key, StringComparer.Ordinal);
            foreach (var k in ColDefaultOrder) if (bySys.TryGetValue(k, out var c)) items.Add(new ColItem(c.Key, false, c, null));
            foreach (var c in Catalogo) if (!ColDefaultOrder.Contains(c.Key)) items.Add(new ColItem(c.Key, false, c, null));
            foreach (var d in _camposDef) items.Add(new ColItem(CampoKey(d), true, null, d));
            // OrderBy es estable: los que caen en el fallback conservan el orden por defecto.
            return items.Select((it, i) => (it, ord: OrdenDe(it.Key, i))).OrderBy(x => x.ord).Select(x => x.it);
        }
    }
    private IEnumerable<ColItem> ColumnasVisibles => ColumnasOrdenadas.Where(EsVisibleItem);
    private string GridCols => "34px "
        + string.Join(" ", ColumnasVisibles.Select(it => it.EsCustom ? "minmax(140px,170px)" : it.Def!.Width))
        + " 120px";

    // Fila COMPLETA de config del campo con su estado actual. El PUT reemplaza la fila entera, asi que
    // siempre se manda todo y se muta con 'with' solo lo que cambia (no se pisa lo que no se toca).
    private GuardarUnidadCampoConfigRequest FilaConfig(string clave)
    {
        _camposConfig.TryGetValue(clave, out var c);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato,
            Oculto: c?.Oculto ?? !VisiblePorDefecto(clave), Orden: c?.Orden);
    }

    private Task SetColVisible(string key, bool v) => EnCola(() => GuardarCampoConfigAsync(FilaConfig(key) with { Oculto = !v }));

    private async Task MoverColU(string key, int dir)
    {
        var orden = ColumnasOrdenadas.Select(x => x.Key).ToList();
        var idx = orden.IndexOf(key);
        var ni = idx + dir;
        if (idx < 0 || ni < 0 || ni >= orden.Count) return;
        (orden[idx], orden[ni]) = (orden[ni], orden[idx]);
        await GuardarOrdenAsync(orden);
    }

    // ===== Drag & drop del orden de campos (grilla de configuracion). Sin JS: eventos nativos de Blazor. =====
    private string? _dragColKey;
    private void OnDragStartCol(string key) => _dragColKey = key;
    private void OnDragEndCol() => _dragColKey = null;
    private async Task OnDropCol(string targetKey)
    {
        var src = _dragColKey;
        _dragColKey = null;
        if (src is null || src == targetKey) return;
        var orden = ColumnasOrdenadas.Select(x => x.Key).ToList();
        var from = orden.IndexOf(src);
        var to = orden.IndexOf(targetKey);
        if (from < 0 || to < 0) return;
        orden.RemoveAt(from);
        if (from < to) to--;                 // al quitar el origen, el destino se corre una posicion
        orden.Insert(to, src);
        await GuardarOrdenAsync(orden);
    }

    // Persiste el orden COMPLETO en un solo PUT (no uno por campo) y refresca la config.
    // Se manda la FILA ENTERA de cada campo (no solo la clave) porque al crear filas nuevas hay que
    // fijar tambien su visibilidad: si se dejara el default de la columna, los campos ocultos por
    // defecto se volverian visibles con el primer arrastre.
    private async Task GuardarOrdenAsync(List<string> claves)
    {
        _cfgBusy = true;
        try
        {
            var filas = claves.Select((k, i) => FilaConfig(k) with { Orden = i }).ToList();
            var r = await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config/lote", filas);
            if (r.IsSuccessStatusCode) await CargarCamposConfigAsync();
        }
        catch { }
        finally { _cfgBusy = false; }
    }

    private async Task CargarCamposConfigAsync()
    {
        try
        {
            var list = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config");
            _camposConfig = list?.ToDictionary(x => x.CampoClave, StringComparer.Ordinal) ?? new();
        }
        catch { }
    }

    // ===== Tipo de dato y formato por campo (configurables por copropiedad) =====

    // Tipo que trae de fabrica cada campo del sistema.
    private static TipoCampoTablero TipoSistema(string clave) => clave switch
    {
        "tipo" or "estado" => TipoCampoTablero.Seleccion,
        "coef" or "area" or "piso" or "habitaciones" or "banos" or "parqueaderos" => TipoCampoTablero.Numero,
        "cuota" => TipoCampoTablero.Moneda,
        "pagaadmin" => TipoCampoTablero.Booleano,
        "observaciones" => TipoCampoTablero.AreaTexto,
        _ => TipoCampoTablero.Texto
    };

    private static readonly TipoCampoTablero[] TiposTexto =
        { TipoCampoTablero.Texto, TipoCampoTablero.AreaTexto, TipoCampoTablero.Telefono, TipoCampoTablero.Email, TipoCampoTablero.Url };
    private static readonly TipoCampoTablero[] TiposNumericos = { TipoCampoTablero.Numero, TipoCampoTablero.Moneda };

    // A que tipos se PUEDE cambiar un campo del sistema. Vacio = tipo FIJO.
    // Regla: solo tipos compatibles con la columna real de la base, para no corromper datos.
    private static TipoCampoTablero[] TiposPermitidos(string clave) => clave switch
    {
        "area" or "cuota" => TiposNumericos,                          // ambos decimales en la base
        "matricula" or "refpago" or "observaciones" => TiposTexto,    // todos texto en la base
        // FIJOS: num (identificador), agrupacion (derivado), tipo/estado (listas del sistema),
        // coef (coeficiente de propiedad - Ley 675), los enteros y el Si/No.
        _ => Array.Empty<TipoCampoTablero>()
    };

    private TipoCampoTablero TipoEfectivo(string clave)
        => _camposConfig.TryGetValue(clave, out var c) && c.Tipo is { } t ? t : TipoSistema(clave);

    // Campos que en la base son ENTEROS: no admiten decimales, asi que no se les ofrece ese formato.
    private static bool EsCampoEntero(string clave)
        => clave is "piso" or "habitaciones" or "banos" or "parqueaderos";

