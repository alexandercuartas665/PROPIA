    private List<UnidadDto> Filtradas
    {
        get
        {
            var q = _q.Trim();
            var ci = System.Globalization.CultureInfo.InvariantCulture;
            return _unidades
                .Where(u => q == ""
                    || u.Numero.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (u.PropietarioNombre ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
                .Where(u => _fd?.Pasa(campo => campo switch
                {
                    "numero" => u.Numero,
                    "tipo" => u.Tipo.ToString(),
                    "torre" => u.TorreId?.ToString() ?? "",
                    "piso" => u.Piso?.ToString() ?? "",
                    "area" => u.AreaM2?.ToString(ci) ?? "",
                    "coef" => u.CoeficientePropiedad.ToString(ci),
                    "propietario" => u.PropietarioNombre ?? "",
                    _ => ""
                }) ?? true)
                .ToList();
        }
    }

    private int TotalPaginas => Filtradas.Count == 0 ? 1 : (int)Math.Ceiling(Filtradas.Count / (double)_porPagina);
    private int Desde => (_pagina - 1) * _porPagina;
    private int Hasta => Math.Min(Desde + _porPagina, Filtradas.Count);
    private IEnumerable<UnidadDto> UnidadesPagina => Filtradas.Skip(Desde).Take(_porPagina);

    private void IrAPagina(int p) => _pagina = Math.Clamp(p, 1, TotalPaginas);

    private void CambiarTamanoPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) _porPagina = n;
        _pagina = 1;   // el offset viejo puede no existir con el tamano nuevo
    }

    // ===== Agrupador (Torre / Propietario / Estado / Tipo) =====
    private string _agruparPor = "";   // "", "torre", "propietario", "estado", "tipo"
    private const string AgruparKey = "propia_agrupar_unidades";

    private async Task SetAgrupar(ChangeEventArgs e)
    {
        _agruparPor = e.Value?.ToString() ?? "";
        _pagina = 1;
        try { await Js.InvokeVoidAsync("localStorage.setItem", AgruparKey, _agruparPor); } catch { }
    }

    private bool _showAgruparMenu;
    private string AgruparLabelU(string v) => v switch { "torre" => LabelAgrupacionSingular, "propietario" => "Propietario", "estado" => "Estado", "tipo" => "Tipo", _ => "" };
    private async Task SetAgruparVal(string v)
    {
        _agruparPor = v; _pagina = 1; _showAgruparMenu = false;
        try { await Js.InvokeVoidAsync("localStorage.setItem", AgruparKey, _agruparPor); } catch { }
    }

    private sealed record GrupoUni(string Titulo, List<UnidadDto> Items);

    // Grupos sobre la lista filtrada COMPLETA (sin paginar): agrupar y paginar juntos confunde.
    private List<GrupoUni>? Grupos()
    {
        if (_agruparPor == "") return null;
        var items = Filtradas;
        var gs = _agruparPor switch
        {
            "torre" => items.GroupBy(u => u.TorreNombre ?? $"Sin {LabelAgrupacionSingular.ToLower()}"),
            "estado" => items.GroupBy(u => string.IsNullOrWhiteSpace(u.Estado) ? "Sin estado" : u.Estado!),
            "tipo" => items.GroupBy(u => Etiqueta(u.Tipo)),
            "propietario" => items.GroupBy(u => string.IsNullOrWhiteSpace(u.PropietarioNombre) ? "Sin propietario" : u.PropietarioNombre!),
            _ => null
        };
        if (gs is null) return null;
        return gs.Select(g => new GrupoUni(g.Key, g.ToList()))
                 .OrderBy(g => g.Titulo.StartsWith("Sin ", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
                 .ThenBy(g => g.Titulo, StringComparer.CurrentCultureIgnoreCase)
                 .ToList();
    }

    // Una entrada a pintar: cabecera de grupo o unidad. Sin agrupar va paginado; agrupado va
    // completo (todos los grupos). Sirve para la vista Tabla y la vista Tarjetas por igual.
    private readonly record struct FilaUni(bool EsGrupo, GrupoUni? Grupo, UnidadDto? Unidad);
    private IEnumerable<FilaUni> FilasRender()
    {
        var gs = Grupos();
        if (gs is null)
        {
            foreach (var u in UnidadesPagina) yield return new FilaUni(false, null, u);
        }
        else
        {
            foreach (var g in gs)
            {
                yield return new FilaUni(true, g, null);
                foreach (var u in g.Items) yield return new FilaUni(false, null, u);
            }
        }
    }

    // ===== Configurar columnas (por usuario, localStorage) =====
    private bool _cfgColsAbierto;
    private Dictionary<string, ColPref> _cols = new();
    private const string ColsKey = "propia_cols_unidades";
    private const string ColOrderKey = "propia_colorder_unidades";
    private static readonly string[] ColDefaultOrder = { "num", "torre", "piso", "tipo", "area", "coef", "prop" };
    private List<string> _colOrderU = ColDefaultOrder.ToList();

    public sealed class ColPref { public bool Visible { get; set; } = true; public string? Label { get; set; } }

    private sealed record ColDef(string Key, string DefLabel, string Width, bool Hideable);
    // Catalogo dinamico: los labels de agrupacion/piso salen de la identidad de la copropiedad.
    private ColDef[] Catalogo => new[]
    {
        new ColDef("num", "UNIDAD", "120px", false),
        new ColDef("torre", LabelAgrupacionSingular.ToUpper(), "1fr", true),
        new ColDef("piso", LabelPisoSingular.ToUpper(), ".7fr", true),
        new ColDef("tipo", "TIPO", "1.1fr", true),
        new ColDef("area", "AREA", ".9fr", true),
        new ColDef("coef", "COEFICIENTE", "1fr", true),
        new ColDef("prop", "PROPIETARIO", "1.5fr", true),
    };

    private bool EsVisible(ColDef c) => !c.Hideable || !_cols.TryGetValue(c.Key, out var p) || p.Visible;
    private string Etiqueta(ColDef c) => (_cols.TryGetValue(c.Key, out var p) && !string.IsNullOrWhiteSpace(p.Label)) ? p.Label! : c.DefLabel;
    // Catalogo en el orden elegido por el usuario (claves desconocidas van al final, por seguridad).
    private IEnumerable<ColDef> CatalogoOrdenado
    {
        get
        {
            var byKey = Catalogo.ToDictionary(c => c.Key);
            foreach (var k in _colOrderU) { if (byKey.TryGetValue(k, out var c)) yield return c; }
            foreach (var c in Catalogo) { if (!_colOrderU.Contains(c.Key)) yield return c; }
        }
    }
    private IEnumerable<ColDef> ColsVisibles => CatalogoOrdenado.Where(EsVisible);
    private string GridCols => "34px " + string.Join(" ", ColsVisibles.Select(c => c.Width)) + " 34px";

    private ColPref PrefDe(string key)
    {
        if (!_cols.TryGetValue(key, out var p)) { p = new(); _cols[key] = p; }
        return p;
    }
    private async Task SetColVisible(string key, bool v) { PrefDe(key).Visible = v; await GuardarColsAsync(); }
    private async Task MoverColU(int idx, int dir)
    {
        var ni = idx + dir;
        if (ni < 0 || ni >= _colOrderU.Count) return;
        (_colOrderU[idx], _colOrderU[ni]) = (_colOrderU[ni], _colOrderU[idx]);
        await GuardarColsAsync();
    }
    private async Task SetColLabel(string key, string? label)
    {
        var def = Catalogo.First(c => c.Key == key).DefLabel;
        var l = label?.Trim();
        PrefDe(key).Label = string.IsNullOrWhiteSpace(l) || string.Equals(l, def, StringComparison.Ordinal) ? null : l;
        await GuardarColsAsync();
    }
    private async Task GuardarColsAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", ColsKey, System.Text.Json.JsonSerializer.Serialize(_cols));
            await Js.InvokeVoidAsync("localStorage.setItem", ColOrderKey, System.Text.Json.JsonSerializer.Serialize(_colOrderU));
        }
        catch { }
    }
    private async Task RestablecerCols() { _cols.Clear(); _colOrderU = ColDefaultOrder.ToList(); await GuardarColsAsync(); }

    private async Task RestaurarPrefsAsync()
    {
        try
        {
            var ag = await Js.InvokeAsync<string?>("localStorage.getItem", AgruparKey);
            if (ag is "torre" or "propietario" or "estado" or "tipo") _agruparPor = ag;
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", ColsKey);
            if (!string.IsNullOrWhiteSpace(raw))
                _cols = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, ColPref>>(raw) ?? new();
            var ord = await Js.InvokeAsync<string?>("localStorage.getItem", ColOrderKey);
            if (!string.IsNullOrWhiteSpace(ord))
            {
                var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(ord);
                if (list is { Count: > 0 }) _colOrderU = list;
            }
        }
        catch { }
    }

    // ===== Edicion inline (vista Tabla). El UnidadDto de la lista ya trae todos los campos,
    // asi que se arma el ActualizarUnidadRequest sin traer el detalle. =====
    private async Task GuardarUnidadInline(UnidadDto u, string campo, string? val)
    {
        var v = val?.Trim();
        var numero = u.Numero; var tipo = u.Tipo; var torreId = u.TorreId; var piso = u.Piso;
        var coef = u.CoeficientePropiedad; var area = u.AreaM2;
        switch (campo)
        {
            case "num": if (string.IsNullOrWhiteSpace(v) || v == u.Numero) return; numero = v; break;
            case "tipo": if (!Enum.TryParse<TipoUnidad>(v, out var tp) || tp == u.Tipo) return; tipo = tp; break;
            case "torre": var t = string.IsNullOrEmpty(v) ? (Guid?)null : (Guid.TryParse(v, out var g) ? g : u.TorreId); if (t == u.TorreId) return; torreId = t; break;
            case "piso": var pi = string.IsNullOrWhiteSpace(v) ? (int?)null : (int.TryParse(v, out var pp) ? pp : u.Piso); if (pi == u.Piso) return; piso = pi; break;
            case "coef": if (!decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var cf) || cf == u.CoeficientePropiedad) return; coef = cf; break;
            case "area": var ar = string.IsNullOrWhiteSpace(v) ? (decimal?)null : (decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var aa) ? aa : u.AreaM2); if (ar == u.AreaM2) return; area = ar; break;
            default: return;
        }
        var req = new ActualizarUnidadRequest(numero, tipo, torreId, piso, coef, area,
            u.Habitaciones, u.Banos, u.Parqueaderos, u.Estado, u.Observaciones,
            u.MatriculaInmobiliaria, u.PagaAdministracion, u.CuotaMensual);
        try
        {
            var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{u.Id}", req);
            if (r.IsSuccessStatusCode)
            {
                var nombreTorre = torreId is null ? null : _torres.FirstOrDefault(x => x.Id == torreId)?.Nombre ?? u.TorreNombre;
                var i = _unidades.FindIndex(x => x.Id == u.Id);
                if (i >= 0) _unidades[i] = u with { Numero = numero, Tipo = tipo, TorreId = torreId, TorreNombre = nombreTorre, Piso = piso, CoeficientePropiedad = coef, AreaM2 = area };
            }
        }
        catch { }
    }

    private Task Inline(UnidadDto u, string campo, ChangeEventArgs e) => GuardarUnidadInline(u, campo, e.Value?.ToString());

    // ===== Alta inline: crea una unidad desde la fila de alta de la tabla. Si abrir=true, abre la
    // ficha recien creada (para asignar propietario/detalle); si no, la deja resaltada en la lista. =====
    private async Task CrearUnidadDesdeAltaAsync(bool abrir)
    {
        if (_creandoUnidad) return;
        if (string.IsNullOrWhiteSpace(_nuNum)) { _inlineMsgU = "El numero de la unidad es obligatorio."; return; }
        _creandoUnidad = true;
        try
        {
            var ci = System.Globalization.CultureInfo.InvariantCulture;
            Guid? torreId = Guid.TryParse(_nuTorreId, out var tg) ? tg : null;
            int? piso = int.TryParse(_nuPiso, out var pp) ? pp : null;
            decimal? area = decimal.TryParse(_nuArea, System.Globalization.NumberStyles.Any, ci, out var aa) ? aa : null;
            decimal coef = decimal.TryParse(_nuCoef, System.Globalization.NumberStyles.Any, ci, out var cc) ? cc : 0m;
            var req = new CrearUnidadRequest(_nuNum.Trim(), _nuTipo, torreId, piso, coef, area,
                null, null, null, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
            if (resp.IsSuccessStatusCode)
            {
                UnidadDto? creada = null;
                try { creada = await resp.Content.ReadFromJsonAsync<UnidadDto>(); } catch { }
                if (creada is not null)
                {
                    _unidades.Add(creada);
                    _uniRecienCreados.Add(creada.Id);
                    _inlineMsgU = $"Unidad {creada.Numero} creada.";
                    _nuNum = ""; _nuTorreId = ""; _nuPiso = ""; _nuArea = ""; _nuCoef = ""; _nuTipo = default;
                    if (abrir) await AbrirModalAsync(creada.Id);
                }
                else { await CargarAsync(); }
            }
            else { _inlineMsgU = "No se pudo crear la unidad."; }
        }
        catch { _inlineMsgU = "Error al crear la unidad."; }
        finally { _creandoUnidad = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await RestaurarVistaAsync();
                await RestaurarPrefsAsync();
                await CargarAsync();
            }
            else
            {
                Nav.NavigateTo("/login?returnUrl=%2Fdistribucion", true);
                return;
            }
            StateHasChanged();
        }
        catch { /* prerender */ }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            _loadError = null;
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/resumen");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevoJwt)) return;
                _jwt = nuevoJwt;
                http = Auth();
                resp = await http.GetAsync("/api/mi-copropiedad/resumen");
            }
            resp.EnsureSuccessStatusCode();
            _resumen = await resp.Content.ReadFromJsonAsync<ResumenMiCopropiedadDto>();

            _torres = await http.GetFromJsonAsync<List<TorreDto>>("/api/mi-copropiedad/torres") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            // Si en el modal se borraron unidades, la pagina en la que estabamos puede ya no existir.
            if (_pagina > TotalPaginas) _pagina = TotalPaginas;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private Task AbrirFichaAsync(UnidadDto u) => AbrirModalAsync(u.Id);

    // ===== Carga masiva por plantilla (reemplaza a "Gestionar unidades") =====
    private bool _impBusy;
    private ImportarUnidadesResponse? _impResult;

    // Plantilla CSV generada en cliente (formato que espera importar-csv: crea torres por nombre).
    private async Task DescargarPlantillaUnidadesAsync()
    {
        var csv = "identificador,tipo_unidad,agrupacion,piso,coeficiente,area_m2\n"
                + "101,Apartamento,Torre A,1,0.023400,72\n"
                + "102,Apartamento,Torre A,1,0.023400,72\n"
                + "201,Apartamento,Torre B,2,0.023400,72\n"
                + "L-1,Local,Torre A,0,0.010000,40\n"
                + "P-101,Parqueadero,Torre A,-1,0.001000,12\n";
        try
        {
            var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(csv));
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", "plantilla-unidades-propia.csv", b64);
        }
        catch { }
    }

    private async Task OnPlantillaImportUnidades(InputFileChangeEventArgs e)
    {
        _impBusy = true; _impResult = null;
        try
        {
            var file = e.File;
            using var reader = new StreamReader(file.OpenReadStream(10 * 1024 * 1024));
            var csv = await reader.ReadToEndAsync();
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades/importar-csv", new ImportarUnidadesRequest(csv));
            if (resp.IsSuccessStatusCode)
            {
                _impResult = await resp.Content.ReadFromJsonAsync<ImportarUnidadesResponse>();
                if (_impResult?.Aceptado == true) await CargarAsync();
            }
            else
            {
                _impResult = new ImportarUnidadesResponse(false, 0, 0, 0m,
                    new List<ImportacionFilaError> { new(0, "servidor", $"Error {(int)resp.StatusCode} al procesar la plantilla.") });
            }
        }
        catch (Exception ex)
        {
            _impResult = new ImportarUnidadesResponse(false, 0, 0, 0m,
                new List<ImportacionFilaError> { new(0, "archivo", ex.Message) });
        }
        finally { _impBusy = false; }
    }

    // Mismo modal para el boton y para el clic en una fila; con UnidadInicialId abre en su ficha.
    private async Task AbrirModalAsync(Guid? unidadId)
    {
        if (_resumen is null) return;
        var parameters = new ModalParameters()
            .Set("Jwt", _jwt)
            .Set("AgrupacionLabelSingular", LabelAgrupacionSingular)
            .Set("PisoLabelSingular", LabelPisoSingular);
        // Clic en una fila -> abre en la ficha de esa unidad y oculta el arbol de torres (redundante
        // porque ya se eligio la unidad). El boton "Gestionar unidades" abre en modo navegacion.
        if (unidadId is not null)
        {
            parameters.Set("UnidadInicialId", unidadId);
            parameters.Set("OcultarArbol", true);
        }
        var hubo = await Modals.OpenAsync<GestionarUnidadesModal, bool>(parameters, new ModalOptions { Fullscreen = true });
        if (hubo == true) await CargarAsync();
    }

    private static string Etiqueta(TipoUnidad t) => t switch
    {
        TipoUnidad.UtilCuarto => "Cuarto util",
        _ => t.ToString()   // Apartamento, Local, Casa, Oficina, Bodega, Parqueadero ya se leen bien
    };
}

