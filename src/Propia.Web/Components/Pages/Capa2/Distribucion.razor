    .dst-filtros-spacer { flex: 1 1 auto; min-width: 8px; }
    .dst-fbtn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 9px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); font-size: 12.5px; font-weight: 700; color: var(--propia-text-secondary); cursor: pointer; font-family: inherit; }
    .dst-fbtn:hover { border-color: var(--propia-brand, var(--propia-brand)); }
    .dst-fbtn.on { border-color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); }
    .dst-menu-wrap { position: relative; }
    .dst-menu-bd { position: fixed; inset: 0; z-index: 40; }
    .dst-menu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 41; min-width: 180px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 12px; box-shadow: 0 12px 30px rgba(30,40,60,.18); padding: 6px; }
    .dst-menu-it { display: block; width: 100%; text-align: left; border: 0; background: transparent; border-radius: 8px; padding: 8px 10px; font-size: 12.5px; font-weight: 600; color: var(--propia-text-body); cursor: pointer; font-family: inherit; }
    .dst-menu-it:hover { background: var(--propia-brand-soft); }
    .dst-menu-it.on { background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); }

    /* Toggle Lista/Tabla (mismo look que Directorio/Usuarios) y vista Lista de unidades. */
    .dst-viewtoggle { display: inline-flex; gap: 2px; background: var(--propia-border-divider); border-radius: 9px; padding: 3px; margin-left: auto; }
    .dst-vt { display: inline-flex; align-items: center; gap: 5px; border: 0; background: transparent; color: var(--propia-text-muted); font-size: 12.5px; font-weight: 600; padding: 5px 11px; border-radius: 7px; cursor: pointer; font-family: inherit; }
    .dst-vt.on { background: var(--propia-bg-card); color: var(--propia-brand, var(--propia-brand)); box-shadow: 0 1px 3px rgba(27,42,58,.12); }
    .dst-lista { display: flex; flex-direction: column; }
    .dst-lrow { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-bottom: 1px solid var(--propia-bg-card-soft); cursor: pointer; }
    .dst-lrow:last-child { border-bottom: 0; }
    .dst-lrow:hover { background: var(--propia-brand-soft-2); }
    .dst-lav { width: 38px; height: 38px; border-radius: 10px; background: var(--propia-brand-soft-2); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .dst-lmain { display: flex; flex-direction: column; min-width: 170px; }
    .dst-lnum { font-size: 14px; font-weight: 700; color: var(--propia-text-h1); }
    .dst-lmeta { font-size: 12px; color: var(--propia-text-muted); margin-top: 1px; }
    .dst-lprop { flex: 1; min-width: 0; font-size: 13px; color: var(--propia-text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dst-ltags { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .dst-ltag { font-size: 11px; font-weight: 600; color: var(--propia-text-secondary); background: var(--propia-border-divider); padding: 3px 9px; border-radius: 7px; white-space: nowrap; }
    .dst-ltag--coef { color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); }
    .dst-lchev { flex-shrink: 0; }
    .dst-stat { display: flex; align-items: center; gap: 12px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 12px; padding: 14px 18px; min-width: 150px; }
    .dst-stat-icon { width: 34px; height: 34px; flex-shrink: 0; border-radius: 9px; background: var(--propia-brand-soft-2); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; }
    .dst-stat-n { font-size: 21px; font-weight: 800; color: var(--propia-text-h1); line-height: 1.1; }
    .dst-stat-l { font-size: 12px; color: var(--propia-text-muted); }
    .dst-stat--coef { gap: 8px; font-size: 13px; font-weight: 700; }
    .dst-stat--coef.ok { background: var(--propia-ok-soft); border-color: #BFE8D2; color: #0F8A4F; }
    .dst-stat--coef.warn { background: #FEF6E7; border-color: #F7DFB2; color: #B45309; }

    .dst-empty { background: var(--propia-bg-card); border: 1px dashed #DCE4EC; border-radius: 12px; padding: 34px; text-align: center; display: flex; flex-direction: column; gap: 5px; }
    .dst-empty strong { font-size: 14.5px; color: var(--propia-text-body); }
    .dst-empty span { font-size: 13px; color: var(--propia-text-muted); }

    .dst-table { background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 12px; overflow: hidden; }
    /* Altura acotada para que el cuerpo scrollee DENTRO del contenedor y el
       header (position:sticky) quede fijo mientras se recorren las unidades. */
    .dst-scroll { overflow: auto; max-height: calc(100vh - 300px); }
    .dst-grid { display: grid; grid-template-columns: 120px 1fr .7fr 1.1fr .9fr 1fr 1.5fr 34px; align-items: center; gap: 8px; padding: 9px 16px; min-width: 940px; }
    .dst-head { background: var(--propia-bg-table-head); font-size: 10.5px; font-weight: 700; color: var(--propia-text-muted); letter-spacing: .4px; border-bottom: 1px solid var(--propia-border-card); position: sticky; top: 0; z-index: 6; }
    .dst-row { border-bottom: 1px solid var(--propia-border-divider); font-size: 13px; color: var(--propia-text-body); cursor: pointer; }
    .dst-row:hover { background: var(--propia-brand-soft-2); }
    .dst-c { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dst-c--num { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--propia-text-h1); }
    .dst-num-icon { width: 24px; height: 24px; flex-shrink: 0; border-radius: 7px; background: var(--propia-brand-soft-2); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; }
    .dst-c--torre { color: var(--propia-brand, var(--propia-brand)); font-weight: 600; }
    .dst-sin { color: var(--propia-text-faint); font-style: italic; }
    .dst-mas { margin-left: 6px; font-size: 11px; font-weight: 700; color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); padding: 1px 6px; border-radius: 6px; }
    .dst-act { display: flex; justify-content: flex-end; }

    .dst-pager { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 16px; background: var(--propia-bg-table-head); border-top: 1px solid var(--propia-border-divider); }
    .dst-pager-info { font-size: 12.5px; color: var(--propia-text-muted); }
    .dst-pager-ctrl { display: flex; align-items: center; gap: 8px; }
    .dst-pager-sel { border: 1px solid var(--propia-border-card); border-radius: 7px; padding: 5px 8px; font-size: 12.5px; color: var(--propia-text-body); background: var(--propia-bg-card); outline: none; cursor: pointer; font-family: inherit; }
    .dst-pager-sel:focus { border-color: var(--propia-brand, var(--propia-brand)); }
    .dst-pager-btn { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--propia-border-card); border-radius: 7px; background: var(--propia-bg-card); color: var(--propia-text-secondary); cursor: pointer; }
    .dst-pager-btn:hover:not(:disabled) { border-color: var(--propia-brand, var(--propia-brand)); color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); }
    .dst-pager-btn:disabled { opacity: .4; cursor: default; }
    .dst-pager-pos { font-size: 12.5px; font-weight: 700; color: var(--propia-text-body); min-width: 52px; text-align: center; }

    /* ===== Ola 4: tabla data-driven (expander + inline + grupos + configurar columnas) ===== */
    .dst-grid2 { display: grid; align-items: center; gap: 8px; padding: 6px 16px; min-width: 940px; }
    .dst-agrupar.on { border-color: var(--propia-brand, var(--propia-brand)); color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); font-weight: 700; }
    .dst-cols { display: inline-flex; align-items: center; gap: 6px; }
    /* Expander: se ve al pasar el mouse por la fila. */
    .dst-exp-col { display: flex; align-items: center; justify-content: center; }
    .dst-exp { width: 26px; height: 26px; border: 0; border-radius: 7px; background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0; transition: opacity .12s, background .12s; }
    .dst-row:hover .dst-exp { opacity: 1; }
    .dst-exp:hover { background: var(--propia-brand-soft); }
    /* Celdas editables inline. */
    .dst-cell { width: 100%; box-sizing: border-box; border: 1px solid transparent; border-radius: 7px; padding: 5px 8px; font-size: 12.5px; color: var(--propia-text-secondary); background: transparent; outline: none; font-family: inherit; }
    .dst-cell:hover { border-color: var(--propia-border-card); background: var(--propia-bg-card-soft); }
    .dst-cell:focus { border-color: var(--propia-brand, var(--propia-brand)); background: var(--propia-bg-card); color: var(--propia-text-body); }
    .dst-cell-num { font-weight: 700; color: var(--propia-text-h1); }
    .dst-agr { font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 20px; }
    .dst-agr--individual { background: var(--propia-border-divider); color: #64748B; }
    .dst-agr--principal { background: var(--propia-brand-soft); color: var(--propia-brand); }
    .dst-agr--anexo { background: #E7F6EC; color: #1A8754; }

    /* Anexos (unidades hijas): filas anidadas + controles. */
    .dst-numcell { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .dst-anexo-branch { color: #B7C4D2; font-size: 15px; line-height: 1; flex: 0 0 auto; }
    .dst-row--anexo { background: var(--propia-brand-soft-2); }
    .dst-row--anexo:hover { background: var(--propia-brand-soft-2); }
    .dst-row--anexo .dst-numcell { padding-left: 14px; }
    .dst-anx-cell { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
    .dst-anx-toggle { display: inline-flex; align-items: center; gap: 3px; padding: 3px 7px; border: 1px solid var(--propia-border-card); border-radius: 7px; background: var(--propia-bg-card); color: var(--propia-text-secondary); font-size: 11px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .dst-anx-toggle:hover { border-color: var(--propia-brand-border); color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); }
    .dst-anx-add { padding: 3px 8px; border: 1px dashed #C9B8F2; border-radius: 7px; background: transparent; color: var(--propia-brand, var(--propia-brand)); font-size: 11px; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap; }
    .dst-anx-add:hover { background: var(--propia-brand-soft-2); }
    .dst-anexoadd { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 9px 16px 9px 48px; background: var(--propia-brand-soft-2); border-bottom: 1px solid #E9E3FA; }
    .dst-anexoadd-lbl { font-size: 12px; color: var(--propia-brand-text); }
    .dst-anexoadd-tipo { width: 150px; }
    .dst-anexoadd-num { width: 170px; }
    .dst-anx-cancel { border: 0; background: transparent; color: var(--propia-text-muted); font-size: 12px; font-weight: 600; cursor: pointer; font-family: inherit; }
    .dst-anx-cancel:hover { color: var(--propia-text-secondary); text-decoration: underline; }
    /* Fila de alta inline (crear unidad): inputs punteados en reposo, violeta al enfocar (canonico). */
    .dst-newrow { cursor: default; }
    .dst-newrow:hover { background: transparent; }
    .dst-newrow .dst-exp-fijo { opacity: 1; }
    .dst-newrow .dst-exp-fijo:disabled { opacity: .35; cursor: default; }
    .dst-nf-inp { width: 100%; box-sizing: border-box; border: 1px dashed var(--propia-border-input); border-radius: 7px; padding: 5px 8px; font-size: 12.5px; color: var(--propia-text-body); background: var(--propia-bg-card); outline: none; font-family: inherit; }
    .dst-nf-inp:focus { border-style: solid; border-color: var(--propia-brand, var(--propia-brand)); box-shadow: 0 0 0 2px rgba(109,79,227,.12); }
    .dst-nf-mut { font-size: 11.5px; color: var(--propia-text-faint); display: flex; align-items: center; }
    .dst-act-nf { display: flex; gap: 4px; align-items: center; justify-content: flex-end; }
    .dst-row-add { display: inline-flex; align-items: center; gap: 4px; padding: 6px 10px; border-radius: 7px; border: 1px solid var(--propia-brand-border); background: var(--propia-brand-soft); color: var(--propia-brand, var(--propia-brand)); font-size: 11.5px; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap; }
    .dst-row-add:hover:not(:disabled) { background: var(--propia-brand-soft); }
    .dst-row-add:disabled { opacity: .5; cursor: default; }
    .dst-row-nuevo { background: var(--propia-ok-soft) !important; box-shadow: inset 3px 0 0 #34C759; }
    .dst-toast { position: sticky; bottom: 10px; margin: 10px auto 0; width: fit-content; background: #15703F; color: var(--propia-text-inverse); font-size: 12.5px; font-weight: 600; padding: 8px 16px; border-radius: 9px; cursor: pointer; box-shadow: 0 6px 18px rgba(21,112,63,.28); }
    .dst-ro { color: var(--propia-text-secondary); padding: 5px 2px; }
    /* Cabecera de grupo. */
    .dst-group { display: flex; align-items: center; gap: 10px; padding: 10px 16px 6px; border-top: 1px solid var(--propia-border-divider); }
    .dst-group:first-of-type { border-top: 0; }
    .dst-group-t { font-size: 12px; font-weight: 700; color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft-2); border-radius: 8px; padding: 3px 11px; }
    .dst-group-n { font-size: 11.5px; font-weight: 700; color: var(--propia-text-muted); background: var(--propia-bg-card-soft); border-radius: 10px; padding: 1px 9px; }
    /* Panel Configurar columnas. */
    .dst-cfg-back { position: fixed; inset: 0; z-index: 1080; background: rgba(27,42,58,.55); display: flex; align-items: flex-start; justify-content: center; padding: 40px 20px; overflow-y: auto; }
    .dst-cfg { width: 420px; max-width: 100%; background: var(--propia-bg-card); border-radius: 14px; box-shadow: 0 18px 50px rgba(27,42,58,.28); padding: 18px 20px 16px; }
    .dst-cfg-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
    .dst-cfg-head strong { font-size: 15px; color: var(--propia-text-body); }
    .dst-cfg-x { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--propia-text-muted); border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); cursor: pointer; }
    .dst-cfg-x:hover { background: var(--propia-bg-app); color: var(--propia-text-body); }
    .dst-cfg-sub { font-size: 12.5px; color: var(--propia-text-muted); margin: 2px 0 12px; }
    .dst-cfg-row { display: flex; align-items: center; gap: 10px; padding: 5px 0; }
    .dst-cfg-vis input { width: 16px; height: 16px; accent-color: var(--propia-brand, var(--propia-brand)); cursor: pointer; }
    .dst-cfg-vis input:disabled { cursor: not-allowed; }
    .dst-cfg-inp { flex: 1; border: 1px solid var(--propia-border-card); border-radius: 8px; padding: 7px 10px; font-size: 13px; color: var(--propia-text-body); font-family: inherit; outline: none; }
    .dst-cfg-inp:focus { border-color: var(--propia-brand, var(--propia-brand)); }
    .dst-cfg-req { font-size: 10.5px; font-weight: 700; color: var(--propia-text-muted); text-transform: uppercase; letter-spacing: .3px; }
    .dst-cfg-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px; }
    /* Menu "Campos" (antes modal): popover anclado al boton, patron Tareas. */
    .dst-colsmenu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 41; min-width: 300px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 12px; box-shadow: 0 12px 30px rgba(30,40,60,.18); padding: 8px; }
    .dst-colsmenu-h { font-size: 10.5px; font-weight: 700; letter-spacing: .4px; color: var(--propia-text-faint); text-transform: uppercase; padding: 4px 6px 8px; }
    .dst-colsmenu-i { display: flex; align-items: center; gap: 8px; padding: 4px 6px; border-radius: 7px; }
    .dst-colsmenu-lbl { flex: 1; font-size: 13px; color: var(--propia-text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dst-colsmenu-i:hover { background: var(--propia-bg-hover); }
    .dst-colsmenu-ord { display: flex; gap: 2px; flex: 0 0 auto; }
    .dst-colsmenu-mv { border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-muted); border-radius: 6px; width: 22px; height: 22px; font-size: 9px; line-height: 1; cursor: pointer; }
    .dst-colsmenu-mv:disabled { opacity: .35; cursor: default; }
    .dst-colsmenu-acts { display: flex; gap: 8px; margin-top: 6px; padding-top: 8px; border-top: 1px solid var(--propia-border-divider); }
    .dst-colsmenu-act { flex: 1; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); border-radius: 7px; padding: 6px 8px; font-size: 11.5px; font-weight: 700; color: var(--propia-text-secondary); cursor: pointer; font-family: inherit; }
    .dst-colsmenu-act:hover { border-color: var(--propia-brand, var(--propia-brand)); color: var(--propia-brand, var(--propia-brand)); }

    /* Campos dinamicos: celda de valor en la tabla + modal Configurar */
    .dst-td-campo { font-size: 13px; color: var(--propia-text-body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dst-newrow-campos { display: flex; flex-wrap: wrap; gap: 10px 14px; padding: 8px 12px 10px 46px; border-bottom: 1px solid var(--propia-border-divider); background: var(--propia-bg-subtle, transparent); }
    .dst-nfc-f { display: flex; flex-direction: column; gap: 3px; min-width: 150px; }
    .dst-nfc-lbl { font-size: 10.5px; font-weight: 700; letter-spacing: .3px; color: var(--propia-text-faint); text-transform: uppercase; }
    .dst-nfc-empty { font-size: 13px; color: var(--propia-text-muted); padding: 6px 2px 14px; }
    .dst-cfg-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 6px; }
    .dst-cfg-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; border: 1px solid var(--propia-border-card); border-radius: 9px; background: var(--propia-bg-card); }
    .dst-cfg-item-main { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; min-width: 0; }
    .dst-cfg-item-lbl { font-size: 13px; font-weight: 600; color: var(--propia-text-body); }
    .dst-cfg-item-tipo { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; color: var(--propia-brand, var(--propia-brand)); background: var(--propia-brand-soft, transparent); border-radius: 6px; padding: 2px 7px; }
    .dst-cfg-item-op { font-size: 12px; color: var(--propia-text-muted); }
    .dst-cfg-item-act { display: flex; gap: 6px; flex: 0 0 auto; }
    .dst-cfg-form { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--propia-border-divider); }
    .dst-cfg-form-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; color: var(--propia-text-secondary); margin-bottom: 10px; }
    .dst-cfg-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .dst-cfg-form-foot { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; }
    .dst-cfg-msg { margin-top: 10px; font-size: 12.5px; color: var(--propia-danger, var(--propia-text-body)); }
    /* Configurar: tipos de unidad (chips base + propios) */
    .dst-cfg-block { margin-bottom: 6px; }
    .dst-cfg-sep { height: 1px; background: var(--propia-border-divider); margin: 16px 0; }
    .dst-tipos-wrap { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .dst-tipo-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: var(--propia-brand); background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-soft); border-radius: 20px; padding: 4px 10px; }
    .dst-tipo-chip--base { color: var(--propia-text-secondary); background: var(--propia-bg-app); border-color: var(--propia-border-card); }
    .dst-tipo-x { border: 0; background: transparent; color: var(--propia-brand); cursor: pointer; font-size: 15px; line-height: 1; padding: 0 0 0 2px; }
    .dst-tipo-x:hover { color: var(--propia-danger); }
    .dst-tipos-add { display: flex; gap: 8px; align-items: center; }
    .dst-tipos-add .dst-nf-inp { flex: 1; }

    /* === Configuracion avanzada de campos (grilla estilo Airtable) === */
    .cga-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--propia-border-divider); margin-bottom: 12px; }
    .cga-tab { position: relative; padding: 8px 14px; border: 0; border-bottom: 2px solid transparent; background: transparent; font-size: 13px; font-weight: 700; color: var(--propia-text-muted); cursor: pointer; font-family: inherit; }
