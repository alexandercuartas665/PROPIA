    private string AliasCampo(string clave, string def)
        => _camposConfig.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias) ? c.Alias! : def;

    private Task GuardarAliasAsync(string clave, string? valor)
        => EnCola(() => GuardarCampoConfigAsync(
            FilaConfig(clave) with { Alias = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim() }));

    // ===== Opciones de las listas del SISTEMA (Tipo y Estado) =====
    // Se guardan en Opciones de la config del campo como JSON: el ORDEN del arreglo es el orden de
    // la lista y 'Oculta' saca la opcion de los selectores SIN borrarla (las unidades que ya la
    // usan la conservan). Las opciones SEMILLA -los tipos base del enum y los tres estados de
    // fabrica- no se pueden eliminar, solo ocultar; las propias de la copropiedad si.
    //
    // Claves: en Estado la clave ES el texto de la opcion; en Tipo es "e:<Enum>" para las base y
    // "c:<guid>" para las propias (que viven en tipos_unidad_custom).
    private sealed record OpcionLista(string K, bool Oculta = false);

    private string? _listaAbierta;      // clave del campo cuya lista se administra en el popup
    private string _nuevaOpcion = "";
    private string? _listaMsg;
    private string? _estadoMsg;

    private void AbrirLista(string clave) { _listaAbierta = clave; _nuevaOpcion = ""; _listaMsg = null; }
    private void CerrarLista() { _listaAbierta = null; _nuevaOpcion = ""; _listaMsg = null; }
    private void OnNuevaOpcionKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter" && _listaAbierta is { } k) _ = AgregarOpcionListaAsync(k); }

    private static bool EsSemilla(string clave, string k)
        => clave == "tipo" ? k.StartsWith("e:", StringComparison.Ordinal)
                           : EstadoSemilla.Contains(k, StringComparer.OrdinalIgnoreCase);

    private string EtiquetaOpcion(string clave, string k)
    {
        if (clave != "tipo") return k;
        if (k.StartsWith("e:", StringComparison.Ordinal))
            return Enum.TryParse<TipoUnidad>(k[2..], out var t) ? Etiqueta(t) : k[2..];
        return Guid.TryParse(k[2..], out var g) ? (_tiposCustom.FirstOrDefault(x => x.Id == g)?.Nombre ?? k) : k;
    }

    /// <summary>Cuantas unidades usan esa opcion (para avisar antes de ocultarla o quitarla).</summary>
    private int UsosDeOpcion(string clave, string k)
    {
        if (clave == "estado")
            return _estadosUso.FirstOrDefault(u => string.Equals(u.Estado, k, StringComparison.OrdinalIgnoreCase))?.Unidades ?? 0;
        if (k.StartsWith("e:", StringComparison.Ordinal))
            return Enum.TryParse<TipoUnidad>(k[2..], out var t) ? _unidades.Count(u => u.TipoCustomId is null && u.Tipo == t) : 0;
        return Guid.TryParse(k[2..], out var g) ? _unidades.Count(u => u.TipoCustomId == g) : 0;
    }

    /// <summary>Universo actual de opciones. En Tipo sale del enum + los tipos propios; en Estado,
    /// de la semilla mas las que la copropiedad haya agregado (que viven en lo guardado).</summary>
    private List<string> UniversoOpciones(string clave, List<OpcionLista> guardadas)
        => clave == "tipo"
            ? TiposUnidadSel.Select(t => "e:" + t).Concat(_tiposCustom.Select(t => "c:" + t.Id)).ToList()
            : EstadoSemilla.Concat(guardadas.Select(g => g.K)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    private List<OpcionLista> LeerOpciones(string clave)
    {
        var raw = _camposConfig.TryGetValue(clave, out var c) ? c.Opciones : null;
        var guardadas = new List<OpcionLista>();
        var habiaGuardado = !string.IsNullOrWhiteSpace(raw);
        if (habiaGuardado)
        {
            var t = raw!.TrimStart();
            if (t.StartsWith('['))
            {
                try { guardadas = System.Text.Json.JsonSerializer.Deserialize<List<OpcionLista>>(raw!) ?? new(); }
                catch { guardadas = new(); }
            }
            else
            {
                // Formato legado (una por linea): Estado guardaba nombres, Tipo guardaba ids propios.
                foreach (var l in raw!.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    guardadas.Add(new OpcionLista(clave == "tipo" ? "c:" + l : l));
            }
        }

        var universo = UniversoOpciones(clave, guardadas);
        var res = new List<OpcionLista>();
        // Lo guardado manda el orden y la visibilidad; lo que ya no existe se descarta.
        foreach (var g in guardadas)
            if (universo.Contains(g.K, StringComparer.OrdinalIgnoreCase)
                && !res.Any(x => string.Equals(x.K, g.K, StringComparison.OrdinalIgnoreCase)))
                res.Add(g);
        // Lo que no estaba guardado va al final. Si la copropiedad YA habia configurado la lista,
        // una semilla ausente venia de haberla borrado con la regla vieja: se respeta como oculta.
        foreach (var k in universo)
            if (!res.Any(x => string.Equals(x.K, k, StringComparison.OrdinalIgnoreCase)))
                res.Add(new OpcionLista(k, habiaGuardado && EsSemilla(clave, k)));
        return res;
    }

    private Task GuardarOpcionesAsync(string clave, List<OpcionLista> ops)
        => EnCola(() => GuardarCampoConfigAsync(
            FilaConfig(clave) with { Opciones = System.Text.Json.JsonSerializer.Serialize(ops) }));

    // Estados ofrecidos al elegir: solo los visibles, en su orden.
    private IEnumerable<string> EstadosConfig() => LeerOpciones("estado").Where(o => !o.Oculta).Select(o => o.K);

    // Tipos ofrecidos al elegir: los base y los propios que no esten ocultos.
    private HashSet<string> OcultasTipo()
        => LeerOpciones("tipo").Where(o => o.Oculta).Select(o => o.K).ToHashSet(StringComparer.OrdinalIgnoreCase);
    private IEnumerable<TipoUnidad> TiposBaseVisibles
    {
        get { var oc = OcultasTipo(); return TiposUnidadSel.Where(t => !oc.Contains("e:" + t)); }
    }
    private List<TipoUnidadCustomDto> TiposCustomVisibles
    {
        get { var oc = OcultasTipo(); return _tiposCustom.Where(t => !oc.Contains("c:" + t.Id)).ToList(); }
    }

    // Al ocultar una opcion, las unidades que ya la usan la conservan. Estos helpers la agregan al
    // selector de ESA fila para que su valor siga visible y no se sobreescriba sin querer.
    private IEnumerable<string> EstadosConVigente(string? actual)
    {
        var vis = EstadosConfig().ToList();
        if (!string.IsNullOrWhiteSpace(actual) && !vis.Contains(actual!, StringComparer.OrdinalIgnoreCase))
            vis.Add(actual!);
        return vis;
    }
    private IEnumerable<TipoUnidad> TiposBaseConVigente(UnidadDto u)
    {
        var vis = TiposBaseVisibles.ToList();
        if (u.TipoCustomId is null && !vis.Contains(u.Tipo)) vis.Add(u.Tipo);
        return vis;
    }
    private List<TipoUnidadCustomDto> TiposCustomConVigente(UnidadDto u)
    {
        var vis = TiposCustomVisibles;
        if (u.TipoCustomId is { } g && vis.All(t => t.Id != g))
        {
            var tc = _tiposCustom.FirstOrDefault(t => t.Id == g);
            if (tc is not null) vis = vis.Append(tc).ToList();
        }
        return vis;
    }

    private async Task ToggleOcultaOpcionAsync(string clave, string k)
    {
        var ops = LeerOpciones(clave);
        var i = ops.FindIndex(o => string.Equals(o.K, k, StringComparison.OrdinalIgnoreCase));
        if (i < 0) return;
        _listaMsg = null;
        if (!ops[i].Oculta)
        {
            var n = UsosDeOpcion(clave, k);
            if (n > 0) _listaMsg = $"'{EtiquetaOpcion(clave, k)}' queda oculta, pero {n} unidad(es) la conservan.";
        }
        ops[i] = ops[i] with { Oculta = !ops[i].Oculta };
        await GuardarOpcionesAsync(clave, ops);
    }

    private async Task MoverOpcionListaAsync(string clave, string k, int dir)
    {
        var ops = LeerOpciones(clave);
        var i = ops.FindIndex(o => string.Equals(o.K, k, StringComparison.OrdinalIgnoreCase));
        var ni = i + dir;
        if (i < 0 || ni < 0 || ni >= ops.Count) return;
        (ops[i], ops[ni]) = (ops[ni], ops[i]);
        _listaMsg = null;
        await GuardarOpcionesAsync(clave, ops);
    }

    private async Task AgregarOpcionListaAsync(string clave)
    {
        var v = _nuevaOpcion.Trim();
        if (v.Length == 0) return;
        var ops = LeerOpciones(clave);
        if (ops.Any(o => string.Equals(EtiquetaOpcion(clave, o.K), v, StringComparison.OrdinalIgnoreCase)))
        { _listaMsg = $"Ya existe '{v}'."; return; }
        _listaMsg = null;
        if (clave == "tipo")
        {
            // En Tipo, una opcion propia es una fila de tipos_unidad_custom.
            _nuevoTipoNombre = v;
            await AgregarTipoCustomAsync();
            _nuevaOpcion = "";
            if (!string.IsNullOrEmpty(_tipoMsg)) _listaMsg = _tipoMsg;
            return;
        }
        ops.Add(new OpcionLista(v));
        _nuevaOpcion = "";
        await GuardarOpcionesAsync(clave, ops);
    }

    private async Task QuitarOpcionListaAsync(string clave, string k)
    {
        if (EsSemilla(clave, k)) { _listaMsg = "Las opciones de fabrica no se eliminan; se pueden ocultar."; return; }
        var n = UsosDeOpcion(clave, k);
        if (n > 0)
        {
            var ok = await Js.InvokeAsync<bool>("confirm",
                $"'{EtiquetaOpcion(clave, k)}' la usan {n} unidad(es). Si la eliminas, esas unidades quedan con un valor que ya no esta en la lista. Es mejor ocultarla. Eliminar de todas formas?");
            if (!ok) return;
        }
        _listaMsg = null;
        if (clave == "tipo")
        {
            if (!Guid.TryParse(k[2..], out var g)) return;
            var tc = _tiposCustom.FirstOrDefault(x => x.Id == g);
            if (tc is null) return;
            await EliminarTipoCustomAsync(tc);
            if (!string.IsNullOrEmpty(_tipoMsg)) _listaMsg = _tipoMsg;
            return;
        }
        var ops = LeerOpciones(clave);
        ops.RemoveAll(o => string.Equals(o.K, k, StringComparison.OrdinalIgnoreCase));
        await GuardarOpcionesAsync(clave, ops);
    }

    // Renombrar: en Tipo es renombrar la fila propia; en Estado es cambiar el texto y, si esta en
    // uso, ofrecer migrar tambien el valor de esas unidades.
    private async Task RenombrarOpcionListaAsync(string clave, string k, string? valor)
    {
        var nuevo = valor?.Trim() ?? "";
        if (nuevo.Length == 0) { _listaMsg = "El nombre no puede quedar vacio."; return; }
        if (string.Equals(nuevo, EtiquetaOpcion(clave, k), StringComparison.Ordinal)) return;
        var ops = LeerOpciones(clave);
        if (ops.Any(o => !string.Equals(o.K, k, StringComparison.OrdinalIgnoreCase)
                         && string.Equals(EtiquetaOpcion(clave, o.K), nuevo, StringComparison.OrdinalIgnoreCase)))
        { _listaMsg = $"Ya existe '{nuevo}'."; return; }
        _listaMsg = null;

        if (clave == "tipo")
        {
            if (!Guid.TryParse(k[2..], out var g)) return;
            var tc = _tiposCustom.FirstOrDefault(x => x.Id == g);
            if (tc is null) return;
            await RenombrarTipoCustomAsync(tc, nuevo);
            if (!string.IsNullOrEmpty(_tipoMsg)) _listaMsg = _tipoMsg;
            return;
        }

        var n = UsosDeOpcion(clave, k);
        var migrar = false;
        if (n > 0)
            migrar = await Js.InvokeAsync<bool>("confirm",
                $"El estado '{k}' lo usan {n} unidad(es). Aceptar para renombrarlo tambien en esas unidades; Cancelar para cambiar solo la lista.");

        var i = ops.FindIndex(o => string.Equals(o.K, k, StringComparison.OrdinalIgnoreCase));
        if (i < 0) return;
        ops[i] = ops[i] with { K = nuevo };
        await GuardarOpcionesAsync(clave, ops);
        if (migrar)
        {
            try
            {
                var r = await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades/estados/renombrar",
                    new RenombrarEstadoRequest(k, nuevo));
                if (r.IsSuccessStatusCode) { await CargarAsync(); _listaMsg = $"Renombrado en {n} unidad(es)."; }
                else _listaMsg = "Se renombro la lista, pero no se pudo actualizar las unidades.";
            }
            catch { _listaMsg = "Se renombro la lista, pero no se pudo actualizar las unidades."; }
        }
    }

    // Restaurar semilla: en Tipo solo limpia orden/ocultas (las opciones propias son datos y se
    // conservan); en Estado vuelve a las tres de fabrica, asi que se confirma antes.
    private async Task RestaurarListaSemillaAsync(string clave)
    {
        if (clave == "estado")
        {
            var propias = LeerOpciones("estado").Where(o => !EsSemilla("estado", o.K)).ToList();
            if (propias.Count > 0)
            {
                var ok = await Js.InvokeAsync<bool>("confirm",
                    $"Se van a quitar {propias.Count} opcion(es) propia(s) de Estado y volver a las de fabrica. Continuar?");
                if (!ok) return;
            }
            await GuardarOpcionesAsync("estado", EstadoSemilla.Select(s => new OpcionLista(s)).ToList());
            _listaMsg = "Opciones restauradas a las de fabrica.";
            return;
        }
        await GuardarOpcionesAsync(clave, new List<OpcionLista>());
        _listaMsg = "Orden y visibilidad restaurados.";
    }

    // Guarda la fila de configuracion COMPLETA del campo (alias, lista, tipo, formato, visibilidad, orden).
    private async Task GuardarCampoConfigAsync(GuardarUnidadCampoConfigRequest req)
    {
        _cfgBusy = true;
        try
        {
            var r = await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req);
            if (r.IsSuccessStatusCode)
            {
                var dto = await r.Content.ReadFromJsonAsync<UnidadCampoConfigDto>();
                if (dto is not null) _camposConfig[req.CampoClave] = dto;
            }
        }
        catch { }
        finally { _cfgBusy = false; }
    }

    // ===== Configurar: tipos de unidad propios (semilla = tipos base del enum) =====
    private string _nuevoTipoNombre = "";
    private string? _tipoMsg;

    private async Task OnNuevoTipoKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await AgregarTipoCustomAsync(); }

    private async Task AgregarTipoCustomAsync()
    {
        var nombre = _nuevoTipoNombre.Trim();
        if (string.IsNullOrWhiteSpace(nombre)) return;
        // Evita duplicar un tipo base o uno propio ya existente.
        if (TiposUnidadSel.Any(t => string.Equals(Etiqueta(t), nombre, StringComparison.OrdinalIgnoreCase))
            || _tiposCustom.Any(t => string.Equals(t.Nombre, nombre, StringComparison.OrdinalIgnoreCase)))
        { _tipoMsg = $"Ya existe un tipo '{nombre}'."; return; }
        _cfgBusy = true; _tipoMsg = null;
        try
        {
            var req = new CrearTipoUnidadCustomRequest(nombre, true, null);
            var r = await Auth().PostAsJsonAsync("/api/mi-copropiedad/tipos-unidad", req);
            if (r.IsSuccessStatusCode)
            {
                var creado = await r.Content.ReadFromJsonAsync<TipoUnidadCustomDto>();
                if (creado is not null) { _tiposCustom = _tiposCustom.Append(creado).ToList(); AplicarOrdenTiposCustom(); }
                _nuevoTipoNombre = "";
            }
            else { _tipoMsg = await MensajeError(r, "No se pudo agregar el tipo."); }
        }
        catch (Exception ex) { _tipoMsg = ex.Message; }
        finally { _cfgBusy = false; }
    }

    private async Task EliminarTipoCustomAsync(TipoUnidadCustomDto tc)
    {
        _cfgBusy = true; _tipoMsg = null;
        try
        {
            var r = await Auth().DeleteAsync($"/api/mi-copropiedad/tipos-unidad/{tc.Id}");
            if (r.IsSuccessStatusCode) _tiposCustom = _tiposCustom.Where(t => t.Id != tc.Id).ToList();
            else { _tipoMsg = "No se pudo quitar el tipo (puede tener unidades asignadas)."; }
        }
        catch (Exception ex) { _tipoMsg = ex.Message; }
        finally { _cfgBusy = false; }
    }

    // Renombra un tipo propio en sitio. Las unidades apuntan al tipo por id, asi que no hay que migrar datos.
    private async Task RenombrarTipoCustomAsync(TipoUnidadCustomDto tc, string? valor)
    {
        var nombre = valor?.Trim() ?? "";
        if (nombre.Length == 0) { _tipoMsg = "El nombre no puede quedar vacio."; return; }
        if (string.Equals(nombre, tc.Nombre, StringComparison.Ordinal)) return;
        if (TiposUnidadSel.Any(t => string.Equals(Etiqueta(t), nombre, StringComparison.OrdinalIgnoreCase))
            || _tiposCustom.Any(t => t.Id != tc.Id && string.Equals(t.Nombre, nombre, StringComparison.OrdinalIgnoreCase)))
        { _tipoMsg = $"Ya existe un tipo '{nombre}'."; return; }
        _cfgBusy = true; _tipoMsg = null;
        try
        {
            var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/tipos-unidad/{tc.Id}", new RenombrarTipoUnidadRequest(nombre));
            if (r.IsSuccessStatusCode)
            {
                var i = _tiposCustom.FindIndex(t => t.Id == tc.Id);
                if (i >= 0) _tiposCustom[i] = tc with { Nombre = nombre };
                // Las unidades muestran el nombre cacheado del tipo propio: hay que refrescarlas.
                await CargarAsync();
            }
            else { _tipoMsg = await MensajeError(r, "No se pudo renombrar el tipo."); }
        }
        catch (Exception ex) { _tipoMsg = ex.Message; }
        finally { _cfgBusy = false; }
    }

    // El orden de los tipos propios sale del mismo modelo de opciones del campo 'tipo', asi el
    // orden elegido en el popup se respeta en la tabla, el alta, la ficha y los filtros.
    private void AplicarOrdenTiposCustom()
    {
        var ord = LeerOpciones("tipo").Select(o => o.K).ToList();
        _tiposCustom = _tiposCustom
            .Select(t => (t, i: ord.IndexOf("c:" + t.Id)))
            .OrderBy(x => x.i < 0 ? int.MaxValue : x.i)     // los que no estan en el orden van al final
            .ThenBy(x => x.t.Nombre, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.t).ToList();
    }

    private static async Task<string> MensajeError(HttpResponseMessage resp, string porDefecto)
    {
        try { var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); if (err is not null && err.TryGetValue("error", out var m) && !string.IsNullOrWhiteSpace(m)) return m; }
        catch { }
        return porDefecto;
    }

    // ===== Configurar campos dinamicos de unidades =====
    private void AbrirConfigCampos()
    {
        _cfgMsg = null; _cfgEditId = null; _cfgLabel = ""; _cfgTipo = TipoCampoTablero.Texto; _cfgOpciones = "";
        _tipoMsg = null; _nuevoTipoNombre = "";
        _listaAbierta = null; _nuevaOpcion = ""; _listaMsg = null; _estadoMsg = null;
        _cfgTab = "unidad";
        _configCamposAbierto = true;
    }

    private void EditarCampoDef(UnidadCampoDefinicionDto d)
    {
        _cfgEditId = d.Id; _cfgLabel = d.Label; _cfgTipo = d.Tipo; _cfgOpciones = d.Opciones ?? ""; _cfgMsg = null;
    }

    private void CancelarEdicionCampo()
    {
        _cfgEditId = null; _cfgLabel = ""; _cfgTipo = TipoCampoTablero.Texto; _cfgOpciones = "";
    }

    private async Task GuardarCampoDefAsync()
    {
        if (_cfgBusy) return;
        if (string.IsNullOrWhiteSpace(_cfgLabel)) { _cfgMsg = "El nombre del campo es obligatorio."; return; }
        if (_cfgTipo == TipoCampoTablero.Seleccion && string.IsNullOrWhiteSpace(_cfgOpciones))
        { _cfgMsg = "Un campo de tipo Lista necesita al menos una opcion (una por linea)."; return; }
        _cfgBusy = true; _cfgMsg = null;
        try
        {
            var opciones = _cfgTipo == TipoCampoTablero.Seleccion ? _cfgOpciones : null;
            if (_cfgEditId is Guid id)
            {
                var orden = _camposDef.FirstOrDefault(c => c.Id == id)?.Orden ?? 0;
                var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-campos/{id}",
                    new ActualizarCampoDefinicionRequest(_cfgLabel.Trim(), _cfgTipo, opciones, orden));
                if (!resp.IsSuccessStatusCode) { _cfgMsg = "No se pudo actualizar el campo."; return; }
            }
            else
            {
                var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades-campos",
                    new CrearCampoDefinicionRequest(_cfgLabel.Trim(), _cfgTipo, opciones));
                if (!resp.IsSuccessStatusCode) { _cfgMsg = "No se pudo crear el campo."; return; }
            }
            await RecargarCamposDefAsync();
            CancelarEdicionCampo();
        }
        catch (Exception ex) { _cfgMsg = "Error: " + ex.Message; }
        finally { _cfgBusy = false; }
    }

    private async Task EliminarCampoDefAsync(UnidadCampoDefinicionDto d)
    {
        if (_cfgBusy) return;
        _cfgBusy = true; _cfgMsg = null;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-campos/{d.Id}");
            if (!resp.IsSuccessStatusCode) { _cfgMsg = "No se pudo eliminar el campo."; return; }
            if (_cfgEditId == d.Id) CancelarEdicionCampo();
            await RecargarCamposDefAsync();
        }
        catch (Exception ex) { _cfgMsg = "Error: " + ex.Message; }
        finally { _cfgBusy = false; }
    }

    private async Task RecargarCamposDefAsync()
    {
        try { _camposDef = await Auth().GetFromJsonAsync<List<UnidadCampoDefinicionDto>>("/api/mi-copropiedad/unidades-campos") ?? new(); }
        catch { }
        // Limpia valores de alta de campos que ya no existen.
        var vivos = _camposDef.Select(c => c.Id).ToHashSet();
        foreach (var k in _nuCampos.Keys.Where(k => !vivos.Contains(k)).ToList()) _nuCampos.Remove(k);
    }

    private static string[] OpcionesDe(UnidadCampoDefinicionDto d) => string.IsNullOrWhiteSpace(d.Opciones)
        ? System.Array.Empty<string>()
        : d.Opciones.Split('\n', System.StringSplitOptions.RemoveEmptyEntries | System.StringSplitOptions.TrimEntries);

    private static string TipoLabel(TipoCampoTablero t) => t switch
    {
        TipoCampoTablero.AreaTexto => "Texto largo",
        TipoCampoTablero.Numero => "Numero",
        TipoCampoTablero.Moneda => "Moneda",
        TipoCampoTablero.Fecha => "Fecha",
        TipoCampoTablero.Seleccion => "Lista",
        TipoCampoTablero.Booleano => "Si / No",
        TipoCampoTablero.Hora => "Hora",
        TipoCampoTablero.Telefono => "Telefono",
        TipoCampoTablero.Email => "Correo",
        TipoCampoTablero.Url => "Enlace",
        _ => "Texto"
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    // Cliente para la CARGA MASIVA: el import de una plantilla grande (cientos de unidades/personas)
    // puede tardar minutos; el timeout de 30s de "PropiaApi" la cancelaria. Se amplia a 10 min.
    private HttpClient AuthLarga()
    {
        var http = Auth();
        http.Timeout = TimeSpan.FromMinutes(10);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            _loadError = null;
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/resumen");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevoJwt)) return;
                _jwt = nuevoJwt;
                http = Auth();
                resp = await http.GetAsync("/api/mi-copropiedad/resumen");
            }
            resp.EnsureSuccessStatusCode();
            _resumen = await resp.Content.ReadFromJsonAsync<ResumenMiCopropiedadDto>();

            _torres = await http.GetFromJsonAsync<List<TorreDto>>("/api/mi-copropiedad/torres") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            try { _camposDef = await http.GetFromJsonAsync<List<UnidadCampoDefinicionDto>>("/api/mi-copropiedad/unidades-campos") ?? new(); } catch { _camposDef = new(); }
            try { _tiposCustom = await http.GetFromJsonAsync<List<TipoUnidadCustomDto>>("/api/mi-copropiedad/tipos-unidad") ?? new(); } catch { _tiposCustom = new(); }
            try { _camposConfig = (await http.GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config") ?? new()).ToDictionary(c => c.CampoClave, StringComparer.Ordinal); } catch { _camposConfig = new(); }
            AplicarOrdenTiposCustom();   // el orden de los tipos propios sale de la config del campo 'tipo'
            try { _estadosUso = await http.GetFromJsonAsync<List<UnidadEstadoUsoDto>>("/api/mi-copropiedad/unidades/estados-uso") ?? new(); } catch { _estadosUso = new(); }
            try
            {
                var flat = await http.GetFromJsonAsync<List<UnidadCampoValorFlatDto>>("/api/mi-copropiedad/unidades-campos-valores") ?? new();
                _camposValores = flat.GroupBy(v => v.UnidadId).ToDictionary(g => g.Key, g => g.ToDictionary(x => x.DefinicionId, x => x.Valor));
            }
            catch { _camposValores = new(); }
            // Si en el modal se borraron unidades, la pagina en la que estabamos puede ya no existir.
            if (_pagina > TotalPaginas) _pagina = TotalPaginas;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private Task AbrirFichaAsync(UnidadDto u) => AbrirModalAsync(u.Id);

    // ===== Carga masiva por plantilla (reemplaza a "Gestionar unidades") =====
    private bool _impBusy;
    private bool _plantillaBusy;
    private bool _cargaBusy;
    private ImportarUnidadesResponse? _impResult;
    private Propia.Application.MiCopropiedad.ResultadoCargaUnidades? _cargaResult;

    // ---- Modal de carga por Excel ----
    private bool _showCargaModal;
    private IBrowserFile? _cargaFile;
    private string? _cargaFileName;
    // Bytes del archivo, leidos al seleccionarlo (mientras el <InputFile> sigue montado). Necesario porque
    // al pasar al paso de confirmacion el <InputFile> se desmonta del DOM: leer el stream despues fallaria
    // con "_blazorFilesById is null". Se envian estos bytes al procesar.
    private byte[]? _cargaBytes;

    private bool _confirmCarga;      // paso de confirmacion del reemplazo (antes de procesar)
    private bool _confirmChecked;    // el usuario marco "entiendo que se reemplazaran..."

    private void AbrirCargaModal()
    {
        _cargaFile = null; _cargaFileName = null; _cargaBytes = null; _cargaResult = null;
        _confirmCarga = false; _confirmChecked = false; _showCargaModal = true;
    }
    private void CerrarCargaModal() { if (!_cargaBusy) _showCargaModal = false; }
    private void ReiniciarCarga()
    {
        _cargaResult = null; _cargaFile = null; _cargaFileName = null; _cargaBytes = null;
        _confirmCarga = false; _confirmChecked = false;
    }

    // Abre el paso de confirmacion (la carga reemplaza categorias dependientes; no procesar sin avisar).
    private void PedirConfirmacionCarga()
    {
        if (_cargaBytes is null) return;
        _confirmChecked = false; _confirmCarga = true;
    }
    private void VolverSeleccion() { _confirmCarga = false; _confirmChecked = false; }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _cargaFile = e.File;
        _cargaFileName = e.File?.Name;
        _cargaBytes = null;
        if (e.File is not null)
        {
            // Bufferiza YA (el InputFile esta montado). Asi el procesado no depende del elemento del DOM.
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(15_000_000).CopyToAsync(ms);
            _cargaBytes = ms.ToArray();
        }
    }

    // Sube el archivo seleccionado y guarda el resultado para el log detallado.
    private async Task EjecutarCargaAsync()
    {
        if (_cargaBytes is null) return;
        _cargaBusy = true; _cargaResult = null;
        try
        {
            // Contenido nuevo por intento (un HttpContent no se puede reenviar tras enviarse).
            // Se envian los bytes ya bufferizados (no se relee el <InputFile>, que puede estar desmontado).
            MultipartFormDataContent Contenido()
            {
                var c = new MultipartFormDataContent();
                var sc = new ByteArrayContent(_cargaBytes!);
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
                c.Add(sc, "file", _cargaFileName ?? "carga.xlsx");
                return c;
            }
            // reemplazar=true: el usuario confirmo el reemplazo de las categorias dependientes.
            const string url = "/api/mi-copropiedad/distribucion/importar-carga?reemplazar=true";
            var resp = await AuthLarga().PostAsync(url, Contenido());
            // Si el token expiro (401), refresca la sesion y reintenta una vez (como CargarAsync).
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (!string.IsNullOrEmpty(nuevoJwt))
                {
                    _jwt = nuevoJwt;
                    resp = await AuthLarga().PostAsync(url, Contenido());
                }
            }
            if (resp.IsSuccessStatusCode)
            {
                _cargaResult = await resp.Content.ReadFromJsonAsync<Propia.Application.MiCopropiedad.ResultadoCargaUnidades>();
                _confirmCarga = false;
                await CargarAsync();   // refresca la vista con las unidades creadas/actualizadas
            }
            else
            {
                var motivo = resp.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Tu sesion expiro. Vuelve a iniciar sesion y reintenta la carga."
                    : $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}";
                _cargaResult = new Propia.Application.MiCopropiedad.ResultadoCargaUnidades(0, 0, 0, 0, 0, 0, 0, 0,
                    new List<Propia.Application.MiCopropiedad.CargaUnidadesError> { new("GENERAL", 0, motivo) });
            }
        }
        catch (Exception ex)
        {
            _cargaResult = new Propia.Application.MiCopropiedad.ResultadoCargaUnidades(0, 0, 0, 0, 0, 0, 0, 0,
                new List<Propia.Application.MiCopropiedad.CargaUnidadesError> { new("GENERAL", 0, ex.Message) });
        }
        finally { _cargaBusy = false; }
    }

    // Resumen por hoja para el log del modal: creados + actualizados (contadores del backend) + errores.
    private readonly record struct ResumenHoja(string Hoja, int Creados, int Actualizados, int Errores);
    private IEnumerable<ResumenHoja> ResumenHojas()
    {
        if (_cargaResult is null) yield break;
        int Err(string h) => _cargaResult.Errores.Count(e => string.Equals(e.Hoja, h, StringComparison.OrdinalIgnoreCase));
        yield return new("UNIDADES PRIVADAS", _cargaResult.Unidades + _cargaResult.Anexos, _cargaResult.UnidadesActualizadas, Err("UNIDADES PRIVADAS"));
        yield return new("PERSONAS", _cargaResult.Personas, 0, Err("PERSONAS"));
        yield return new("VEHICULOS", _cargaResult.Vehiculos, 0, Err("VEHICULOS"));
        yield return new("MASCOTAS", _cargaResult.Mascotas, 0, Err("MASCOTAS"));
        yield return new("TERCEROS", _cargaResult.Terceros, 0, Err("TERCEROS"));
        yield return new("ZONAS COMUNES", _cargaResult.Zonas, 0, Err("ZONAS COMUNES"));
        yield return new("EQUIPOS", _cargaResult.Equipos, 0, Err("EQUIPOS"));
        var gen = Err("GENERAL");
        if (gen > 0) yield return new("GENERAL", 0, 0, gen);
    }

    // Plantilla Excel multi-hoja generada por el backend (con datos de referencia + dropdowns).
    private async Task DescargarPlantillaCargaExcelAsync()
    {
        _plantillaBusy = true;
        try
        {
            var resp = await Auth().GetAsync("/api/mi-copropiedad/distribucion/plantilla-carga");
            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                var b64 = Convert.ToBase64String(bytes);
                await Js.InvokeVoidAsync("propiaUI.downloadBase64", "Plantilla carga unidades privadas.xlsx",
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
            }
        }
        catch { }
        finally { _plantillaBusy = false; }
    }

    // Plantilla CSV generada en cliente (formato que espera importar-csv: crea torres por nombre).
    private async Task DescargarPlantillaUnidadesAsync()
    {
        var csv = "identificador,tipo_unidad,agrupacion,piso,coeficiente,area_m2\n"
                + "101,Apartamento,Torre A,1,0.023400,72\n"
                + "102,Apartamento,Torre A,1,0.023400,72\n"
                + "201,Apartamento,Torre B,2,0.023400,72\n"
                + "L-1,Local,Torre A,0,0.010000,40\n"
                + "P-101,Parqueadero,Torre A,-1,0.001000,12\n";
        try
        {
            var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(csv));
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", "plantilla-unidades-propia.csv", b64);
        }
        catch { }
    }

    private async Task OnPlantillaImportUnidades(InputFileChangeEventArgs e)
    {
        _impBusy = true; _impResult = null;
        try
        {
            var file = e.File;
            using var reader = new StreamReader(file.OpenReadStream(10 * 1024 * 1024));
            var csv = await reader.ReadToEndAsync();
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades/importar-csv", new ImportarUnidadesRequest(csv));
            if (resp.IsSuccessStatusCode)
            {
                _impResult = await resp.Content.ReadFromJsonAsync<ImportarUnidadesResponse>();
                if (_impResult?.Aceptado == true) await CargarAsync();
            }
            else
            {
                _impResult = new ImportarUnidadesResponse(false, 0, 0, 0m,
                    new List<ImportacionFilaError> { new(0, "servidor", $"Error {(int)resp.StatusCode} al procesar la plantilla.") });
            }
        }
        catch (Exception ex)
        {
            _impResult = new ImportarUnidadesResponse(false, 0, 0, 0m,
                new List<ImportacionFilaError> { new(0, "archivo", ex.Message) });
        }
        finally { _impBusy = false; }
    }

    // Mismo modal para el boton y para el clic en una fila; con UnidadInicialId abre en su ficha.
    private async Task AbrirModalAsync(Guid? unidadId)
    {
        if (_resumen is null) return;
        var parameters = new ModalParameters()
            .Set("Jwt", _jwt)
            .Set("AgrupacionLabelSingular", LabelAgrupacionSingular)
            .Set("PisoLabelSingular", LabelPisoSingular);
        // Clic en una fila -> abre en la ficha de esa unidad y oculta el arbol de torres (redundante
        // porque ya se eligio la unidad). El boton "Gestionar unidades" abre en modo navegacion.
        if (unidadId is not null)
        {
            parameters.Set("UnidadInicialId", unidadId);
            parameters.Set("OcultarArbol", true);
        }
        var hubo = await Modals.OpenAsync<GestionarUnidadesModal, bool>(parameters, new ModalOptions { Width = "80vw" });
        if (hubo == true) await CargarAsync();
    }

    // Tipos de unidad ofrecidos en los selectores (se excluye ZonaComun: las zonas comunes son otro modulo).
    // El valor del enum se conserva por compatibilidad de datos historicos.
    private static IEnumerable<TipoUnidad> TiposUnidadSel => Enum.GetValues<TipoUnidad>().Where(t => t != TipoUnidad.ZonaComun);

    private static string Etiqueta(TipoUnidad t) => t switch
    {
        TipoUnidad.UtilCuarto => "Cuarto util",
        TipoUnidad.ZonaComun => "Zona comun",
        TipoUnidad.ParqueaderoDeposito => "Parqueadero + deposito",
        // Valor guardado que no corresponde a ningun tipo del enum (dato viejo o importado mal).
        // Se muestra asi, y NO como el primer tipo de la lista: si se disfrazara, cualquier edicion
        // de la fila guardaria un tipo que nadie eligio.
        _ when !Enum.IsDefined(t) => $"(sin definir: {(int)t})",
        // El resto (Apartamento, Local, Casa, Oficina, Bodega, Parqueadero, Deposito, Area, Lote,
        // Piso, Individuo, Consultorio, Habitacion, Empresa, Cabana, Cama) se lee bien con ToString.
        _ => t.ToString()
    };
}

