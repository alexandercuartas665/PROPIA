            if (ag is "torre" or "propietario" or "estado" or "tipo") _agruparPor = ag;
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", ColsKey);
            if (!string.IsNullOrWhiteSpace(raw))
                _cols = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, ColPref>>(raw) ?? new();
            var ord = await Js.InvokeAsync<string?>("localStorage.getItem", ColOrderKey);
            if (!string.IsNullOrWhiteSpace(ord))
            {
                var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(ord);
                if (list is { Count: > 0 }) _colOrderU = list;
            }
        }
        catch { }
    }

    // ===== Edicion inline (vista Tabla). El UnidadDto de la lista ya trae todos los campos,
    // asi que se arma el ActualizarUnidadRequest sin traer el detalle. =====
    private async Task GuardarUnidadInline(UnidadDto u, string campo, string? val)
    {
        var v = val?.Trim();
        var numero = u.Numero; var tipo = u.Tipo; var torreId = u.TorreId; var piso = u.Piso;
        var coef = u.CoeficientePropiedad; var area = u.AreaM2;
        var matricula = u.MatriculaInmobiliaria; var refpago = u.ReferenciaPago;
        switch (campo)
        {
            case "num": if (string.IsNullOrWhiteSpace(v) || v == u.Numero) return; numero = v; break;
            case "tipo": if (!Enum.TryParse<TipoUnidad>(v, out var tp) || tp == u.Tipo) return; tipo = tp; break;
            case "torre": var t = string.IsNullOrEmpty(v) ? (Guid?)null : (Guid.TryParse(v, out var g) ? g : u.TorreId); if (t == u.TorreId) return; torreId = t; break;
            case "piso": var pi = string.IsNullOrWhiteSpace(v) ? (int?)null : (int.TryParse(v, out var pp) ? pp : u.Piso); if (pi == u.Piso) return; piso = pi; break;
            case "coef": if (!decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var cf) || cf == u.CoeficientePropiedad) return; coef = cf; break;
            case "area": var ar = string.IsNullOrWhiteSpace(v) ? (decimal?)null : (decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var aa) ? aa : u.AreaM2); if (ar == u.AreaM2) return; area = ar; break;
            case "matricula": var mt = string.IsNullOrWhiteSpace(v) ? null : v; if (mt == u.MatriculaInmobiliaria) return; matricula = mt; break;
            case "refpago": var rp = v ?? ""; if (rp == (u.ReferenciaPago ?? "")) return; refpago = rp; break;
            default: return;
        }
        var req = new ActualizarUnidadRequest(numero, tipo, torreId, piso, coef, area,
            u.Habitaciones, u.Banos, u.Parqueaderos, u.Estado, u.Observaciones,
            matricula, u.PagaAdministracion, u.CuotaMensual, refpago);
        try
        {
            var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{u.Id}", req);
            if (r.IsSuccessStatusCode)
            {
                var nombreTorre = torreId is null ? null : _torres.FirstOrDefault(x => x.Id == torreId)?.Nombre ?? u.TorreNombre;
                var i = _unidades.FindIndex(x => x.Id == u.Id);
                if (i >= 0) _unidades[i] = u with { Numero = numero, Tipo = tipo, TorreId = torreId, TorreNombre = nombreTorre, Piso = piso, CoeficientePropiedad = coef, AreaM2 = area, MatriculaInmobiliaria = matricula, ReferenciaPago = refpago };
            }
        }
        catch { }
    }

    private Task Inline(UnidadDto u, string campo, ChangeEventArgs e) => GuardarUnidadInline(u, campo, e.Value?.ToString());

    // ===== Alta inline: crea una unidad desde la fila de alta de la tabla. Si abrir=true, abre la
    // ficha recien creada (para asignar propietario/detalle); si no, la deja resaltada en la lista. =====
    private async Task CrearUnidadDesdeAltaAsync(bool abrir)
    {
        if (_creandoUnidad) return;
        if (string.IsNullOrWhiteSpace(_nuNum)) { _inlineMsgU = "El numero de la unidad es obligatorio."; return; }
        _creandoUnidad = true;
        try
        {
            var ci = System.Globalization.CultureInfo.InvariantCulture;
            Guid? torreId = Guid.TryParse(_nuTorreId, out var tg) ? tg : null;
            int? piso = int.TryParse(_nuPiso, out var pp) ? pp : null;
            var numero = _nuNum.Trim();

            // Codigo mascara TORRE-APARTAMENTO (ej. A1-202) en el campo "Nueva unidad".
            // Si trae separador, se parsea, se crea la torre si no existe y se infiere el piso del apto.
            if (numero.IndexOfAny(new[] { '-', '/' }) >= 0)
            {
                var parts = numero.Split(new[] { '-', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (parts.Length >= 2)
                {
                    var tId = await ResolverOCrearTorreAsync(parts[0]);
                    if (tId is null) { _inlineMsgU = "No se pudo resolver o crear la torre del codigo."; _creandoUnidad = false; return; }
                    torreId = tId;
                    numero = string.Join("-", parts.Skip(1)).Trim();
                    piso = InferirPiso(numero) ?? piso;
                }
            }

            decimal? area = decimal.TryParse(_nuArea, System.Globalization.NumberStyles.Any, ci, out var aa) ? aa : null;
            decimal coef = decimal.TryParse(_nuCoef, System.Globalization.NumberStyles.Any, ci, out var cc) ? cc : 0m;
            var req = new CrearUnidadRequest(numero, _nuTipo, torreId, piso, coef, area,
                null, null, null, null, null,
                MatriculaInmobiliaria: string.IsNullOrWhiteSpace(_nuMatricula) ? null : _nuMatricula.Trim(),
                ReferenciaPago: string.IsNullOrWhiteSpace(_nuRefPago) ? null : _nuRefPago.Trim());
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
            if (resp.IsSuccessStatusCode)
            {
                UnidadDto? creada = null;
                try { creada = await resp.Content.ReadFromJsonAsync<UnidadDto>(); } catch { }
                if (creada is not null)
                {
                    _unidades.Add(creada);
                    _uniRecienCreados.Add(creada.Id);
                    _inlineMsgU = $"Unidad {creada.Numero} creada.";
                    _nuNum = ""; _nuTorreId = ""; _nuPiso = ""; _nuArea = ""; _nuCoef = ""; _nuTipo = default; _nuMatricula = ""; _nuRefPago = "";
                    if (abrir) await AbrirModalAsync(creada.Id);
                }
                else { await CargarAsync(); }
            }
            else
            {
                var detalle = await resp.Content.ReadAsStringAsync();
                _inlineMsgU = string.IsNullOrWhiteSpace(detalle) ? "No se pudo crear la unidad." : $"No se pudo crear: {detalle}";
            }
        }
        catch (Exception ex) { _inlineMsgU = "Error al crear la unidad: " + ex.Message; }
        finally { _creandoUnidad = false; }
    }

    // Infiere el piso desde el numero de apartamento (convencion: 202 -> piso 2, 1502 -> piso 15).
    // Solo cuando el apto es numerico y tiene 3+ digitos; si no, devuelve null (no se fuerza el piso).
    private static int? InferirPiso(string apto)
    {
        apto = (apto ?? "").Trim();
        if (apto.Length >= 3 && apto.All(char.IsDigit))
        {
            var floorPart = apto[..^2];
            if (int.TryParse(floorPart, out var f) && f > 0) return f;
        }
        return null;
    }

    // Resuelve la torre por token del codigo (nombre exacto, "Torre X" o ultima palabra); si no existe, la crea.
    private async Task<Guid?> ResolverOCrearTorreAsync(string token)
    {
        token = token.Trim();
        var existe = _torres.FirstOrDefault(t =>
            t.Nombre.Equals(token, StringComparison.OrdinalIgnoreCase)
            || t.Nombre.Equals($"{LabelAgrupacionSingular} {token}", StringComparison.OrdinalIgnoreCase)
            || string.Equals(t.Nombre.Split(' ').LastOrDefault(), token, StringComparison.OrdinalIgnoreCase));
        if (existe is not null) return existe.Id;

        var nombre = token.Length <= 4 ? $"{LabelAgrupacionSingular} {token}" : token;
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/torres", new CrearTorreRequest(nombre, null, null));
        if (!resp.IsSuccessStatusCode) return null;
        var nueva = await resp.Content.ReadFromJsonAsync<TorreDto>();
        if (nueva is null) return null;
        _torres.Add(nueva);
        return nueva.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await RestaurarVistaAsync();
                await RestaurarPrefsAsync();
                await CargarAsync();
            }
            else
            {
                Nav.NavigateTo("/login?returnUrl=%2Fdistribucion", true);
                return;
            }
            StateHasChanged();
        }
        catch { /* prerender */ }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            _loadError = null;
            var http = Auth();
            var resp = await http.GetAsync("/api/mi-copropiedad/resumen");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevoJwt)) return;
                _jwt = nuevoJwt;
                http = Auth();
                resp = await http.GetAsync("/api/mi-copropiedad/resumen");
            }
            resp.EnsureSuccessStatusCode();
            _resumen = await resp.Content.ReadFromJsonAsync<ResumenMiCopropiedadDto>();

            _torres = await http.GetFromJsonAsync<List<TorreDto>>("/api/mi-copropiedad/torres") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            // Si en el modal se borraron unidades, la pagina en la que estabamos puede ya no existir.
            if (_pagina > TotalPaginas) _pagina = TotalPaginas;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private Task AbrirFichaAsync(UnidadDto u) => AbrirModalAsync(u.Id);

    // ===== Carga masiva por plantilla (reemplaza a "Gestionar unidades") =====
    private bool _impBusy;
    private bool _plantillaBusy;
    private bool _cargaBusy;
    private ImportarUnidadesResponse? _impResult;
    private Propia.Application.MiCopropiedad.ResultadoCargaUnidades? _cargaResult;

    // ---- Modal de carga por Excel ----
    private bool _showCargaModal;
    private IBrowserFile? _cargaFile;
    private string? _cargaFileName;

    private void AbrirCargaModal()
    {
        _cargaFile = null; _cargaFileName = null; _cargaResult = null; _showCargaModal = true;
    }
    private void CerrarCargaModal() { if (!_cargaBusy) _showCargaModal = false; }
    private void ReiniciarCarga() { _cargaResult = null; _cargaFile = null; _cargaFileName = null; }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _cargaFile = e.File;
        _cargaFileName = e.File?.Name;
    }

    // Sube el archivo seleccionado y guarda el resultado para el log detallado.
    private async Task EjecutarCargaAsync()
    {
        if (_cargaFile is null) return;
        _cargaBusy = true; _cargaResult = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(_cargaFile.OpenReadStream(15_000_000));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            content.Add(sc, "file", _cargaFile.Name);
            var resp = await Auth().PostAsync("/api/mi-copropiedad/distribucion/importar-carga", content);
            if (resp.IsSuccessStatusCode)
            {
                _cargaResult = await resp.Content.ReadFromJsonAsync<Propia.Application.MiCopropiedad.ResultadoCargaUnidades>();
                await CargarAsync();   // refresca la vista con las unidades creadas
            }
            else
            {
                _cargaResult = new Propia.Application.MiCopropiedad.ResultadoCargaUnidades(0, 0, 0, 0, 0, 0, 0, 0,
                    new List<Propia.Application.MiCopropiedad.CargaUnidadesError> { new("GENERAL", 0, $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}") });
            }
        }
        catch (Exception ex)
        {
            _cargaResult = new Propia.Application.MiCopropiedad.ResultadoCargaUnidades(0, 0, 0, 0, 0, 0, 0, 0,
                new List<Propia.Application.MiCopropiedad.CargaUnidadesError> { new("GENERAL", 0, ex.Message) });
        }
        finally { _cargaBusy = false; }
    }

    // Resumen por hoja para el log del modal: creados (contadores del backend) + errores de esa hoja.
    private readonly record struct ResumenHoja(string Hoja, int Creados, int Errores);
    private IEnumerable<ResumenHoja> ResumenHojas()
    {
        if (_cargaResult is null) yield break;
        int Err(string h) => _cargaResult.Errores.Count(e => string.Equals(e.Hoja, h, StringComparison.OrdinalIgnoreCase));
        yield return new("UNIDADES PRIVADAS", _cargaResult.Unidades + _cargaResult.Anexos, Err("UNIDADES PRIVADAS"));
        yield return new("PERSONAS", _cargaResult.Personas, Err("PERSONAS"));
        yield return new("VEHICULOS", _cargaResult.Vehiculos, Err("VEHICULOS"));
        yield return new("MASCOTAS", _cargaResult.Mascotas, Err("MASCOTAS"));
        yield return new("ZONAS COMUNES", _cargaResult.Zonas, Err("ZONAS COMUNES"));
        yield return new("EQUIPOS", _cargaResult.Equipos, Err("EQUIPOS"));
        var gen = Err("GENERAL");
        if (gen > 0) yield return new("GENERAL", 0, gen);
    }

    // Plantilla Excel multi-hoja generada por el backend (con datos de referencia + dropdowns).
    private async Task DescargarPlantillaCargaExcelAsync()
    {
        _plantillaBusy = true;
        try
        {
            var resp = await Auth().GetAsync("/api/mi-copropiedad/distribucion/plantilla-carga");
            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                var b64 = Convert.ToBase64String(bytes);
                await Js.InvokeVoidAsync("propiaUI.downloadBase64", "Plantilla carga unidades privadas.xlsx",
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
            }
        }
        catch { }
        finally { _plantillaBusy = false; }
    }

    // Plantilla CSV generada en cliente (formato que espera importar-csv: crea torres por nombre).
    private async Task DescargarPlantillaUnidadesAsync()
    {
        var csv = "identificador,tipo_unidad,agrupacion,piso,coeficiente,area_m2\n"
                + "101,Apartamento,Torre A,1,0.023400,72\n"
                + "102,Apartamento,Torre A,1,0.023400,72\n"
                + "201,Apartamento,Torre B,2,0.023400,72\n"
                + "L-1,Local,Torre A,0,0.010000,40\n"
                + "P-101,Parqueadero,Torre A,-1,0.001000,12\n";
        try
        {
            var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(csv));
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", "plantilla-unidades-propia.csv", b64);
        }
        catch { }
    }

    private async Task OnPlantillaImportUnidades(InputFileChangeEventArgs e)
    {
        _impBusy = true; _impResult = null;
        try
        {
            var file = e.File;
            using var reader = new StreamReader(file.OpenReadStream(10 * 1024 * 1024));
            var csv = await reader.ReadToEndAsync();
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades/importar-csv", new ImportarUnidadesRequest(csv));
            if (resp.IsSuccessStatusCode)
            {
                _impResult = await resp.Content.ReadFromJsonAsync<ImportarUnidadesResponse>();
                if (_impResult?.Aceptado == true) await CargarAsync();
            }
            else
            {
                _impResult = new ImportarUnidadesResponse(false, 0, 0, 0m,
                    new List<ImportacionFilaError> { new(0, "servidor", $"Error {(int)resp.StatusCode} al procesar la plantilla.") });
            }
        }
        catch (Exception ex)
        {
            _impResult = new ImportarUnidadesResponse(false, 0, 0, 0m,
                new List<ImportacionFilaError> { new(0, "archivo", ex.Message) });
        }
        finally { _impBusy = false; }
    }

    // Mismo modal para el boton y para el clic en una fila; con UnidadInicialId abre en su ficha.
    private async Task AbrirModalAsync(Guid? unidadId)
    {
        if (_resumen is null) return;
        var parameters = new ModalParameters()
            .Set("Jwt", _jwt)
            .Set("AgrupacionLabelSingular", LabelAgrupacionSingular)
            .Set("PisoLabelSingular", LabelPisoSingular);
        // Clic en una fila -> abre en la ficha de esa unidad y oculta el arbol de torres (redundante
        // porque ya se eligio la unidad). El boton "Gestionar unidades" abre en modo navegacion.
        if (unidadId is not null)
        {
            parameters.Set("UnidadInicialId", unidadId);
            parameters.Set("OcultarArbol", true);
        }
        var hubo = await Modals.OpenAsync<GestionarUnidadesModal, bool>(parameters, new ModalOptions { Width = "80vw" });
        if (hubo == true) await CargarAsync();
    }

    private static string Etiqueta(TipoUnidad t) => t switch
    {
        TipoUnidad.UtilCuarto => "Cuarto util",
        _ => t.ToString()   // Apartamento, Local, Casa, Oficina, Bodega, Parqueadero ya se leen bien
    };
}

