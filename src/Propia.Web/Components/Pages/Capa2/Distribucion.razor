@page "/distribucion"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IModalService Modals

<PageTitle>Unidades Privadas - PROPIA</PageTitle>

@* Unidades Privadas: modulo propio (antes era la seccion 2 "Distribucion" del acordeon de
   Mi copropiedad). Muestra la composicion de la PH (agrupaciones, unidades, coeficientes) y
   lista todas las unidades en tabla. El detalle y la edicion siguen viviendo en
   GestionarUnidadesModal: la tabla es de consulta y el clic en una fila abre la ficha.
   La ruta sigue siendo /distribucion para no romper enlaces guardados. *@

<div class="dst-pagehead">
    <div>
        <h1 class="dst-pagetitle">Unidades Privadas</h1>
        <p class="dst-pagesub">Composicion de @(_resumen?.Identidad.Nombre ?? "la copropiedad") &mdash; @LabelAgrupacionPlural.ToLower(), @LabelPisoSingular.ToLower()s y unidades con su coeficiente.</p>
    </div>
    @if (_authChecked && _jwt is not null)
    {
        @* Estandar del sistema (como Zonas/Equipos): carga masiva por plantilla. La plantilla
           crea torres y unidades; para editar una unidad se abre su ficha desde el expander. *@
        <div class="dst-head-actions">
            <button class="dst-btn-soft" type="button" @onclick="DescargarPlantillaCargaExcelAsync" disabled="@_plantillaBusy" title="Plantilla Excel multi-hoja (unidades, personas, vehiculos, mascotas, terceros) con datos de referencia y listas">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
                @(_plantillaBusy ? "Generando..." : "Descargar plantilla (Excel)")
            </button>
            <button class="propia-btn-brand" type="button" @onclick="AbrirCargaModal" title="Cargar la plantilla Excel: se procesa cada hoja y se muestra el detalle">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V9m0 0l-4 4m4-4l4 4M4 3h16"/></svg>
                Cargar plantilla (Excel)
            </button>
            <button class="dst-btn-soft" type="button" @onclick="AbrirConfigCampos" title="Configurar los campos dinamicos de las unidades (aparecen en la fila de alta y en la ficha)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                Configurar
            </button>
        </div>
    }
</div>

@if (_impResult is not null)
{
    <div class="dst-impres @(_impResult.Aceptado ? "ok" : "err")">
        @if (_impResult.Aceptado)
        {
            <b>Carga completa:</b> <span>@_impResult.UnidadesCreadas unidades creadas (suma de coeficientes @_impResult.SumaCoeficientes.ToString("0.####")%).</span>
        }
        else
        {
            <b>No se pudo cargar la plantilla.</b>
            <ul class="dst-impres-list">@foreach (var er in _impResult.Errores.Take(12)) { <li>@(er.Fila > 0 ? $"Fila {er.Fila} - " : "")@er.Campo: @er.Mensaje</li> }</ul>
        }
        <button type="button" class="dst-impres-x" @onclick="() => _impResult = null" title="Cerrar">&times;</button>
    </div>
}

@* ============ Modal de carga por Excel (seleccion + log detallado por hoja) ============ *@
@if (_showCargaModal)
{
    <div class="cg-back" @onclick="CerrarCargaModal">
        <div class="cg-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="cg-head">
                <div>
                    <div class="cg-title">Cargar plantilla (Excel)</div>
                    <div class="cg-sub">Se procesa cada hoja y se muestra el detalle de creados y errores.</div>
                </div>
                <button class="cg-x" type="button" @onclick="CerrarCargaModal" aria-label="Cerrar">&times;</button>
            </div>

            <div class="cg-body">
                @if (_cargaResult is null && !_confirmCarga)
                {
                    @* Paso 1: seleccionar archivo *@
                    <label class="cg-drop">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21V9m0 0l-4 4m4-4l4 4M4 3h16"/></svg>
                        <span class="cg-drop-t">@(_cargaFileName ?? "Selecciona el archivo .xlsx")</span>
                        <span class="cg-drop-h">Usa la plantilla descargada. Formato .xlsx</span>
                        <InputFile OnChange="OnFileSelected" accept=".xlsx" style="display:none" disabled="@_cargaBusy" />
                    </label>
                    <div class="cg-note">
                        Al procesar: las <b>unidades</b> existentes se <b>actualizan</b>; personas, vehiculos,
                        mascotas, zonas comunes y equipos que traiga el archivo se <b>reemplazan</b> por los del
                        archivo (los actuales de esta copropiedad se retiran; los vehiculos con historial de
                        porteria se conservan como inactivos).
                    </div>
                    <div class="cg-actions">
                        <button class="cg-btn-ghost" type="button" @onclick="CerrarCargaModal" disabled="@_cargaBusy">Cancelar</button>
                        <button class="cg-btn-brand" type="button" @onclick="PedirConfirmacionCarga" disabled="@(_cargaBusy || _cargaBytes is null)">
                            Continuar
                        </button>
                    </div>
                }
                else if (_cargaResult is null && _confirmCarga)
                {
                    @* Paso 1b: confirmacion (reemplazo destructivo de dependientes) *@
                    <div class="cg-confirm">
                        <div class="cg-confirm-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
                        </div>
                        <div class="cg-confirm-title">Confirmar carga con reemplazo</div>
                        <div class="cg-confirm-sub">
                            Vas a procesar <b>@_cargaFileName</b>. Las <b>unidades</b> se actualizan (sin borrar),
                            pero <b>personas, vehiculos, mascotas, zonas comunes y equipos</b> que incluya el archivo
                            <b>reemplazan</b> a los actuales de esta copropiedad: los registros vigentes se retiran y
                            se cargan los del archivo (los vehiculos con historial de porteria quedan inactivos).
                            Esta accion <b>no se puede deshacer</b>.
                        </div>
                        <label class="cg-confirm-chk">
                            <input type="checkbox" checked="@_confirmChecked"
                                   @onchange="@(e => _confirmChecked = (bool)(e.Value ?? false))" disabled="@_cargaBusy" />
                            <span>Entiendo que se reemplazaran esas categorias y confirmo la carga.</span>
                        </label>
                        @if (_cargaBusy)
                        {
                            <div class="cg-progress" role="progressbar" aria-label="Procesando la plantilla"><div class="cg-progress-bar"></div></div>
                            <div class="cg-progress-txt">Procesando la plantilla, no cierres esta ventana...</div>
                        }
                        <div class="cg-actions">
                            <button class="cg-btn-ghost" type="button" @onclick="VolverSeleccion" disabled="@_cargaBusy">Volver</button>
                            <button class="cg-btn-danger" type="button" @onclick="EjecutarCargaAsync" disabled="@(_cargaBusy || !_confirmChecked)">
                                @(_cargaBusy ? "Procesando..." : "Reemplazar y cargar")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    @* Paso 2: resultado con log detallado por hoja *@
                    var okTotal = _cargaResult.Errores.Count == 0;
                    <div class="cg-summary @(okTotal ? "ok" : "warn")">
                        @if (okTotal) { <strong>Carga completa sin errores.</strong> }
                        else { <strong>Carga con @_cargaResult.Errores.Count advertencia(s).</strong> }
                        <span>@_cargaResult.Copropiedades copropiedad(es) procesada(s).</span>
                    </div>

                    <table class="cg-tbl">
                        <thead><tr><th>Hoja</th><th>Creados</th><th>Actualizados</th><th>Errores</th></tr></thead>
                        <tbody>
                            @foreach (var f in ResumenHojas())
                            {
                                <tr class="@(f.Errores > 0 ? "cg-row-warn" : "")">
                                    <td>@f.Hoja</td>
                                    <td>@f.Creados</td>
                                    <td>@(f.Actualizados > 0 ? f.Actualizados.ToString() : "-")</td>
                                    <td>@(f.Errores > 0 ? f.Errores.ToString() : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (_cargaResult.Errores.Count > 0)
                    {
                        <div class="cg-log-title">Detalle de errores</div>
                        <div class="cg-log">
                            @foreach (var er in _cargaResult.Errores)
                            {
                                <div class="cg-log-item">
                                    <span class="cg-log-hoja">@er.Hoja</span>
                                    @if (er.Fila > 0) { <span class="cg-log-fila">fila @er.Fila</span> }
                                    <span class="cg-log-msg">@er.Motivo</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="cg-actions">
                        <button class="cg-btn-ghost" type="button" @onclick="ReiniciarCarga">Cargar otro</button>
                        <button class="cg-btn-brand" type="button" @onclick="CerrarCargaModal">Cerrar</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_configCamposAbierto)
{
    <div class="cg-back" @onclick="() => _configCamposAbierto = false">
        <div class="cg-modal cg-modal--wide" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="cg-head">
                <div>
                    <div class="cg-title">Configuracion avanzada de campos</div>
                    <div class="cg-sub">Orden, visibilidad, tipo y comportamiento de cada campo de la unidad.</div>
                </div>
                <button class="cg-x" type="button" @onclick="() => _configCamposAbierto = false" aria-label="Cerrar">&times;</button>
            </div>
            <div class="cg-body">
                @* Tabs: el mismo gestor sirve para la unidad y para cada entidad vinculada a ella. *@
                <div class="cga-tabs">
                    @foreach (var t in CfgTabs)
                    {
                        var tt = t;
                        <button type="button" class="cga-tab @(_cfgTab == tt.Clave ? "cga-tab--on" : "")"
                                @onclick="() => _cfgTab = tt.Clave">@tt.Titulo</button>
                    }
                </div>

                @if (_cfgTab != "unidad")
                {
                    @* Entidades vinculadas: catalogo propio de la copropiedad (sin campos del sistema). *@
                    var tab = CfgTabs.First(x => x.Clave == _cfgTab);
                    <ConfigCamposEntidad Prefijo="@tab.Clave" TituloSingular="@tab.Singular" TituloPlural="@tab.Titulo"
                                         Ejemplo="@tab.Ejemplo" Jwt="@_jwt" />
                }
                else
                {

                @* Grilla estilo Airtable: Orden+Visibilidad | Label | Tipo de Dato | Config especifica. *@
                <div class="cga-grid cga-head-row">
                    <div></div>
                    <div>Label</div>
                    <div>Tipo de Dato</div>
                    <div>Configuracion especifica</div>
                    <div></div>
                </div>

                @* --- Grilla unificada: TODOS los campos (sistema + personalizados) en el ORDEN de la tabla.
                       La 'ubicacion' de un campo = su posicion aqui = su columna en la tabla. Se reordena por
                       drag & drop (manija) o con las flechas; el ojo muestra/oculta la columna. --- *@
                @foreach (var it in ColumnasOrdenadas)
                {
                    var key = it.Key;
                    var esCustom = it.EsCustom;
                    var cs = esCustom ? null : CamposSistema.FirstOrDefault(x => x.Clave == key);
                    var (tdato, fija) = esCustom ? ("", false) : TipoDatoUi(key);
                    var permitidos = esCustom ? Array.Empty<TipoCampoTablero>() : TiposPermitidos(key);
                    var tefe = esCustom ? it.Campo!.Tipo : TipoEfectivo(key);
                    var fmt = esCustom ? null : FormatoDe(key);
                    var vis = EsVisibleItem(it);
                    var puedeOcultar = esCustom || it.Def!.Hideable;
                    <div class="cga-grid cga-row @(_dragColKey == key ? "cga-row--drag" : "")"
                         @ondragover:preventDefault="true" @ondrop="() => OnDropCol(key)">
                        <div class="cga-ctrl">
                            <span class="cga-grip" draggable="true" title="Arrastra para reubicar la columna"
                                  @ondragstart="() => OnDragStartCol(key)" @ondragend="OnDragEndCol">
                                <svg width="12" height="16" viewBox="0 0 12 16" fill="currentColor"><circle cx="3" cy="3" r="1.4"/><circle cx="9" cy="3" r="1.4"/><circle cx="3" cy="8" r="1.4"/><circle cx="9" cy="8" r="1.4"/><circle cx="3" cy="13" r="1.4"/><circle cx="9" cy="13" r="1.4"/></svg>
                            </span>
                            <button type="button" class="cga-mini" title="Subir" @onclick="() => MoverColU(key, -1)">&#9650;</button>
                            <button type="button" class="cga-mini" title="Bajar" @onclick="() => MoverColU(key, 1)">&#9660;</button>
                            <button type="button" class="cga-eye @(vis ? "on" : "")" title="@(vis ? "Visible en la tabla" : "Oculta")" @onclick="() => SetColVisible(key, !vis)" disabled="@(!puedeOcultar)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <div>
                            @if (esCustom) { <span class="cga-custom-lbl">@it.Campo!.Label</span> }
                            else { <input class="cga-inp" placeholder="@(cs?.DefLabel ?? it.Def!.DefLabel)" value="@(AliasConfig(key))" @onchange="@(e => GuardarAliasAsync(key, e.Value?.ToString()))" /> }
                        </div>
                        <div class="cga-tipo">
                            @if (esCustom)
                            {
                                <span class="cga-tipo-badge cga-tipo-badge--edit">@TipoLabel(it.Campo!.Tipo)</span>
                            }
                            else if (permitidos.Length > 0)
                            {
                                @* Tipo intercambiable: solo entre tipos compatibles con la columna real. *@
                                <select class="cga-inp cga-tipo-sel" value="@tefe" @onchange="@(e => SetTipoCampoAsync(key, e.Value?.ToString()))" disabled="@_cfgBusy">
                                    @foreach (var t in permitidos) { <option value="@t" selected="@(t == tefe)">@TipoLabel(t)</option> }
                                </select>
                            }
                            else
                            {
                                <span class="cga-tipo-badge">@tdato</span>
                                <svg class="cga-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" title="Tipo fijo del sistema"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                                @if (fija) { <span class="cga-fija">FIJA</span> }
                            }
                        </div>
                        <div class="cga-cfg">
                            @if (esCustom)
                            {
                                @if (it.Campo!.Tipo == TipoCampoTablero.Seleccion && !string.IsNullOrWhiteSpace(it.Campo!.Opciones))
                                {
                                    <span class="cga-cfg-hint">@string.Join(", ", OpcionesDe(it.Campo!))</span>
                                }
                            }
                            else if (key is "tipo" or "estado")
                            {
                                @* La lista se administra en un popup aparte: expandirla aqui dentro
                                   empujaba toda la grilla hacia abajo. *@
                                var ops = LeerOpciones(key);
                                <button class="dst-btn-soft" type="button" @onclick="() => AbrirLista(key)">Gestionar lista</button>
                                <span class="cga-cfg-hint" style="margin-left:6px;">
                                    @ops.Count(o => !o.Oculta) visibles@(ops.Any(o => o.Oculta) ? $" ({ops.Count(o => o.Oculta)} ocultas)" : "")
                                </span>
                            }
                            else if (key == "agrupacion") { <span class="cga-cfg-hint">Segun el codigo / anexos</span> }
                            else if (EsCampoEntero(key)) { <span class="cga-cfg-hint">Entero (sin decimales)</span> }
                            else if (tefe is TipoCampoTablero.Numero or TipoCampoTablero.Moneda)
                            {
                                @* Numero / Moneda: decimales + separador de miles (+ moneda si aplica). *@
                                <div class="cga-fmt">
                                    <label class="cga-fmt-lbl">Decimales</label>
                                    <select class="cga-inp cga-fmt-dec" value="@(fmt!.Dec ?? 2)" @onchange="@(e => SetFormatoDecAsync(key, e.Value?.ToString()))" disabled="@_cfgBusy">
                                        @foreach (var d in new[] { 0, 1, 2, 3, 4 }) { <option value="@d" selected="@((fmt!.Dec ?? 2) == d)">@d</option> }
                                    </select>
                                    <label class="cga-fmt-chk" title="Separador de miles (se aplica en las vistas de solo lectura)">
                                        <input type="checkbox" checked="@fmt!.Miles" @onchange="@(e => SetFormatoMilesAsync(key, (bool)(e.Value ?? false)))" disabled="@_cfgBusy" />
                                        <span>Miles</span>
                                    </label>
                                    @if (tefe == TipoCampoTablero.Moneda) { <span class="cga-fmt-tag">COP</span> }
                                </div>
                            }
                            else if (tefe is TipoCampoTablero.Texto or TipoCampoTablero.AreaTexto or TipoCampoTablero.Telefono or TipoCampoTablero.Email or TipoCampoTablero.Url)
                            {
                                <div class="cga-fmt">
                                    <label class="cga-fmt-lbl">Max. caracteres</label>
                                    <input class="cga-inp cga-fmt-max" type="number" min="1" max="4000" placeholder="sin limite"
                                           value="@(fmt!.Max?.ToString() ?? "")" @onchange="@(e => SetFormatoMaxAsync(key, e.Value?.ToString()))" disabled="@_cfgBusy" />
                                </div>
                            }
                            else if (tefe == TipoCampoTablero.Booleano) { <span class="cga-cfg-hint">Si / No</span> }
                        </div>
                        <div class="cga-row-act">
                            @if (esCustom)
                            {
                                var dd = it.Campo!;
                                <button class="dst-btn-soft" type="button" @onclick="() => EditarCampoDef(dd)" disabled="@_cfgBusy">Editar</button>
                                <button class="dst-btn-soft" type="button" @onclick="() => EliminarCampoDefAsync(dd)" disabled="@_cfgBusy">Eliminar</button>
                            }
                        </div>
                    </div>
                }

                <div class="dst-cfg-sep"></div>

                <div class="dst-cfg-form">
                    <div class="dst-cfg-form-title">@(_cfgEditId is null ? "Nuevo campo personalizado" : "Editar campo")</div>
                    <div class="dst-cfg-form-grid">
                        <div>
                            <label class="dst-nfc-lbl">Nombre</label>
                            <input class="dst-nf-inp" @bind="_cfgLabel" @bind:event="oninput" placeholder="Ej. N de medidor, Color de fachada" />
                        </div>
                        <div>
                            <label class="dst-nfc-lbl">Tipo</label>
                            <select class="dst-nf-inp" @bind="_cfgTipo">
                                <option value="@TipoCampoTablero.Texto">Texto</option>
                                <option value="@TipoCampoTablero.AreaTexto">Texto largo</option>
                                <option value="@TipoCampoTablero.Numero">Numero</option>
                                <option value="@TipoCampoTablero.Moneda">Moneda</option>
                                <option value="@TipoCampoTablero.Fecha">Fecha</option>
                                <option value="@TipoCampoTablero.Hora">Hora</option>
                                <option value="@TipoCampoTablero.Seleccion">Lista de opciones</option>
                                <option value="@TipoCampoTablero.Booleano">Si / No</option>
                                <option value="@TipoCampoTablero.Telefono">Telefono</option>
                                <option value="@TipoCampoTablero.Email">Correo</option>
                                <option value="@TipoCampoTablero.Url">Enlace</option>
                            </select>
                        </div>
                    </div>
                    @if (_cfgTipo == TipoCampoTablero.Seleccion)
                    {
                        <div style="margin-top:8px;">
                            <label class="dst-nfc-lbl">Opciones (una por linea)</label>
                            <textarea class="dst-nf-inp" rows="4" @bind="_cfgOpciones" @bind:event="oninput" placeholder="Habitada&#10;Desocupada&#10;Arrendada"></textarea>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_cfgMsg)) { <div class="dst-cfg-msg">@_cfgMsg</div> }
                    <div class="dst-cfg-form-foot">
                        @if (_cfgEditId is not null)
                        {
                            <button class="dst-btn-soft" type="button" @onclick="CancelarEdicionCampo" disabled="@_cfgBusy">Cancelar</button>
                        }
                        <button class="propia-btn-brand" type="button" @onclick="GuardarCampoDefAsync" disabled="@(_cfgBusy || string.IsNullOrWhiteSpace(_cfgLabel))">
                            @(_cfgBusy ? "Guardando..." : (_cfgEditId is null ? "Crear campo" : "Guardar cambios"))
                        </button>
                    </div>
                </div>

                }
            </div>
        </div>

        @* ===== Popup de opciones de una lista del sistema (Tipo / Estado) =====
           Va ENCIMA del modal de configuracion: administrarla aqui evita empujar la grilla hacia
           abajo. Las opciones SEMILLA no se eliminan, se OCULTAN. *@
        @if (_listaAbierta is not null)
        {
            var lk = _listaAbierta;
            var ops = LeerOpciones(lk);
            <div class="cgl-back" @onclick="CerrarLista">
                <div class="cgl-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                    <div class="cg-head">
                        <div>
                            <div class="cg-title">Opciones de @AliasCampo(lk, lk == "tipo" ? "Tipo" : "Estado")</div>
                            <div class="cg-sub">
                                Las opciones de fabrica no se pueden eliminar, pero si ocultar: dejan de ofrecerse
                                sin perder las unidades que ya las usan.
                            </div>
                        </div>
                        <button class="cg-x" type="button" @onclick="CerrarLista" aria-label="Cerrar">&times;</button>
                    </div>
                    <div class="cg-body">
                        <div class="cga-opts-list cgl-list">
                            @for (var i = 0; i < ops.Count; i++)
                            {
                                var idx = i;
                                var op = ops[i];
                                var semilla = EsSemilla(lk, op.K);
                                var usos = UsosDeOpcion(lk, op.K);
                                <div class="cga-opt-row @(op.Oculta ? "cga-opt-row--oculta" : "")">
                                    <div class="cga-opt-move">
                                        <button type="button" class="cga-mini" title="Subir" disabled="@(idx == 0 || _cfgBusy)" @onclick="() => MoverOpcionListaAsync(lk, op.K, -1)">&#9650;</button>
                                        <button type="button" class="cga-mini" title="Bajar" disabled="@(idx == ops.Count - 1 || _cfgBusy)" @onclick="() => MoverOpcionListaAsync(lk, op.K, 1)">&#9660;</button>
                                    </div>
                                    @if (semilla)
                                    {
                                        <svg class="cga-opt-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" title="Opcion de fabrica: se puede ocultar, no eliminar"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                                        <span class="cga-opt-name">@EtiquetaOpcion(lk, op.K)</span>
                                    }
                                    else
                                    {
                                        <span class="cga-opt-dot"></span>
                                        <input class="cga-inp cga-opt-inp" value="@EtiquetaOpcion(lk, op.K)" title="Renombrar la opcion"
                                               @onchange="@(e => RenombrarOpcionListaAsync(lk, op.K, e.Value?.ToString()))" disabled="@_cfgBusy" />
                                    }
                                    @if (usos > 0) { <span class="cgl-usos" title="@usos unidad(es) usan esta opcion">@usos</span> }
                                    <button type="button" class="cga-eye @(op.Oculta ? "" : "on")"
                                            title="@(op.Oculta ? "Oculta: no se ofrece al elegir" : "Visible")"
                                            @onclick="() => ToggleOcultaOpcionAsync(lk, op.K)" disabled="@_cfgBusy">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    @if (!semilla)
                                    {
                                        <button type="button" class="cga-opt-x" title="Eliminar la opcion" @onclick="() => QuitarOpcionListaAsync(lk, op.K)" disabled="@_cfgBusy">&times;</button>
                                    }
                                </div>
                            }
                            <div class="cga-opt-add">
                                <input class="cga-inp" placeholder="Anadir nueva opcion..." @bind="_nuevaOpcion" @bind:event="oninput" @onkeyup="OnNuevaOpcionKeyUp" />
                                <button class="cga-add-btn" type="button" @onclick="() => AgregarOpcionListaAsync(lk)" disabled="@(_cfgBusy || string.IsNullOrWhiteSpace(_nuevaOpcion))">Anadir</button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_listaMsg)) { <div class="dst-cfg-msg">@_listaMsg</div> }
                        <div class="cgl-foot">
                            <button class="dst-btn-soft" type="button" @onclick="() => RestaurarListaSemillaAsync(lk)" disabled="@_cfgBusy">Restaurar semilla</button>
                            <button class="dst-btn-soft" type="button" @onclick="CerrarLista">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!_authChecked)
{
    <div class="dst-loading"><div class="spinner-border" style="color: var(--propia-brand, var(--propia-brand));"></div></div>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    @* Filtros. Sin value= en el buscador: Blazor Server lo reafirma en cada re-render y
       se come pulsaciones mientras el round-trip esta en vuelo. *@
    @* Barra de herramientas SIEMPRE visible (canon regla 14): con 0 unidades tambien se ven
       Filtros/Buscar/Agrupar/Campos + el selector Tarjetas/Tabla, para empezar a cargar. *@
        <div class="dst-filtros">
            @* Boton "Filtros" (reglas dinamicas, componente compartido) PRIMERO y luego el buscador,
               orden estandar. Reemplaza los selects sueltos "Todo tipo"/"Toda torre". *@
            <FiltroDinamico @ref="_fd" Campos="CamposFiltroU" OnChanged="@(() => { _pagina = 1; StateHasChanged(); })" />
            <div class="dst-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input class="dst-search-inp" placeholder="Buscar unidad o propietario..."
                       @oninput="@(e => { _q = e.Value?.ToString() ?? string.Empty; _pagina = 1; })" />
            </div>
            <div class="dst-filtros-spacer"></div>
            @* Agrupador como boton + menu (pregunta por cual campo). Patron Tableros. *@
            <div class="dst-menu-wrap">
                <button type="button" class="dst-fbtn @(_agruparPor != "" ? "on" : "")" @onclick="() => _showAgruparMenu = !_showAgruparMenu" title="Agrupar unidades">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    <span>Agrupar@(_agruparPor != "" ? ": " + AgruparLabelU(_agruparPor) : "")</span>
                </button>
                @if (_showAgruparMenu)
                {
                    <div class="dst-menu-bd" @onclick="() => _showAgruparMenu = false"></div>
                    <div class="dst-menu">
                        @foreach (var g in new[] { ("", "Sin agrupar"), ("torre", LabelAgrupacionSingular), ("propietario", "Propietario"), ("estado", "Estado"), ("tipo", "Tipo") })
                        {
                            var gk = g.Item1;
                            <button class="dst-menu-it @(_agruparPor == gk ? "on" : "")" @onclick="() => SetAgruparVal(gk)">@g.Item2</button>
                        }
                    </div>
                }
            </div>
            @if (_vista == "tabla")
            {
                <div class="dst-menu-wrap">
                    <button type="button" class="dst-fbtn @(_cfgColsAbierto ? "on" : "")" @onclick="() => _cfgColsAbierto = !_cfgColsAbierto" title="Campos y columnas de la tabla">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                        <span>Campos</span>
                    </button>
                    @if (_cfgColsAbierto)
                    {
                        <div class="dst-menu-bd" @onclick="() => _cfgColsAbierto = false"></div>
                        <div class="dst-colsmenu">
                            <div class="dst-colsmenu-h">COLUMNAS (orden y visibilidad)</div>
                            @{ var itemsSys = ColumnasOrdenadas.Where(x => !x.EsCustom).ToList(); }
                            @for (int i = 0; i < itemsSys.Count; i++)
                            {
                                var col = itemsSys[i].Def!;
                                var key = col.Key;
                                var vis = EsVisible(col);
                                <div class="dst-colsmenu-i">
                                    <div class="dst-colsmenu-ord">
                                        <button class="dst-colsmenu-mv" @onclick="() => MoverColU(key, -1)" title="Subir">&#9650;</button>
                                        <button class="dst-colsmenu-mv" @onclick="() => MoverColU(key, 1)" title="Bajar">&#9660;</button>
                                    </div>
                                    <label class="dst-cfg-vis" title="@(col.Hideable ? "Mostrar u ocultar" : "Columna requerida, siempre visible")">
                                        <input type="checkbox" checked="@vis" disabled="@(!col.Hideable)" @onchange="@(e => SetColVisible(key, (bool)(e.Value ?? false)))" />
                                    </label>
                                    <span class="dst-colsmenu-lbl">@Etiqueta(col)</span>
                                    @if (!col.Hideable) { <span class="dst-cfg-req">fija</span> }
                                </div>
                            }
                            <div class="dst-colsmenu-acts">
                                <button type="button" class="dst-colsmenu-act" @onclick="RestablecerCols">Restablecer</button>
                            </div>
                        </div>
                    }
                </div>
            }
            @* Toggle Lista/Tabla, igual que en los demas modulos: la seleccion se recuerda por
               modulo (propia_view_unidades) y sobrevive al cierre de sesion. *@
            <div class="dst-viewtoggle">
                @* Orden y nomenclatura estandar del sistema: Tarjetas primero, Tabla despues. *@
                <button type="button" class="dst-vt @(_vista == "lista" ? "on" : "")" @onclick='() => SetVista("lista")' title="Tarjetas">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    Tarjetas
                </button>
                <button type="button" class="dst-vt @(_vista == "tabla" ? "on" : "")" @onclick='() => SetVista("tabla")' title="Tabla">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                    Tabla
                </button>
            </div>
        </div>

    @if (_unidades.Count > 0 && Filtradas.Count == 0)
    {
        <div class="dst-empty">
            <strong>Ninguna unidad coincide con el filtro.</strong>
            <span>Ajusta la busqueda o limpia los filtros.</span>
        </div>
    }
    else
    {
        <div class="dst-table">
            @* Con cero unidades se muestra igual la tabla (cabecera + fila de alta) para poder
               escribir la primera unidad directo aqui, en vez de un estado vacio sin accion. *@
            @if (_vista == "tabla" || _unidades.Count == 0)
            {
                @* Tabla: primera columna Expandir (hover -> abre ficha) + celdas editables inline.
                   Columnas configurables (mostrar/ocultar/renombrar) y agrupables. *@
                <div class="dst-scroll">
                    <div class="dst-head dst-grid2" style="grid-template-columns:@GridCols">
                        <div></div>
                        @foreach (var it in ColumnasVisibles)
                        {
                            if (it.EsCustom) { <div title="Campo personalizado">@it.Campo!.Label</div> }
                            else { <div>@Etiqueta(it.Def!)</div> }
                        }
                        <div></div>
                    </div>
                    @foreach (var item in FilasRender())
                    {
                        if (item.EsGrupo)
                        {
                            var g = item.Grupo!;
                            <div class="dst-group"><span class="dst-group-t">@g.Titulo</span><span class="dst-group-n">@g.Items.Count</span></div>
                            continue;
                        }
                        var uu = item.Unidad!;
                        var esAnexo = item.EsAnexo;
                        var nAnx = esAnexo ? 0 : Anexos(uu.Id).Count;
                        <div class="dst-row dst-grid2 @(esAnexo ? "dst-row--anexo" : "") @(_uniRecienCreados.Contains(uu.Id) ? "dst-row-nuevo" : "")" style="grid-template-columns:@GridCols">
                            <div class="dst-exp-col">
                                <button type="button" class="dst-exp" title="Abrir la ficha de la unidad" @onclick="() => AbrirFichaAsync(uu)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                </button>
                            </div>
                            @foreach (var it in ColumnasVisibles)
                            {
                                if (it.EsCustom)
                                {
                                    var vv = ValorCampo(uu.Id, it.Campo!.Id);
                                    <div class="dst-td-campo" title="@it.Campo!.Label">@(string.IsNullOrWhiteSpace(vv) ? "-" : vv)</div>
                                    continue;
                                }
                                switch (it.Def!.Key)
                                {
                                    case "num":
                                        <div class="dst-numcell">
                                            @if (esAnexo) { <span class="dst-anexo-branch" title="Anexo">&#8627;</span> }
                                            <input class="dst-cell dst-cell-num" value="@uu.Numero" @onchange="@(e => Inline(uu, "num", e))" />
                                        </div>
                                        break;
                                    case "torre":
                                        <select class="dst-cell" @onchange="@(e => Inline(uu, "torre", e))">
                                            <option value="" selected="@(uu.TorreId is null)">-</option>
                                            @foreach (var t in _torres.OrderBy(x => x.Nombre))
                                            {
                                                <option value="@t.Id" selected="@(uu.TorreId == t.Id)">@t.Nombre</option>
                                            }
                                        </select>
                                        break;
                                    case "piso":
                                        <input class="dst-cell" type="number" value="@(uu.Piso?.ToString() ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "piso", e))" />
                                        break;
                                    case "tipo":
                                        @* Si el tipo de la unidad quedo oculto se ofrece igual: si no, el select
                                           mostraria otra opcion y al tocar la celda se guardaria un valor que
                                           nadie eligio. *@
                                        <select class="dst-cell" @onchange="@(e => Inline(uu, "tipo", e))">
                                            @foreach (var t in TiposBaseConVigente(uu))
                                            {
                                                <option value="@($"e:{t}")" selected="@(uu.TipoCustomId is null && uu.Tipo == t)">@Etiqueta(t)</option>
                                            }
                                            @{ var tcv = TiposCustomConVigente(uu); }
                                            @if (tcv.Count > 0)
                                            {
                                                <optgroup label="Tipos propios">
                                                    @foreach (var tc in tcv) { <option value="@($"c:{tc.Id}")" selected="@(uu.TipoCustomId == tc.Id)">@tc.Nombre</option> }
                                                </optgroup>
                                            }
                                        </select>
                                        break;
                                    case "estado":
                                        <select class="dst-cell" @onchange="@(e => Inline(uu, "estado", e))">
                                            @foreach (var es in EstadosConVigente(uu.Estado))
                                            {
                                                <option value="@es" selected="@(string.Equals(uu.Estado, es, StringComparison.OrdinalIgnoreCase))">@es</option>
                                            }
                                        </select>
                                        break;
                                    case "area":
                                        <input class="dst-cell" type="number" step="@PasoDe("area")" value="@NumeroCelda(uu.AreaM2, "area")" placeholder="-" @onchange="@(e => Inline(uu, "area", e))" />
                                        break;
                                    case "coef":
                                        <input class="dst-cell" type="number" step="@PasoDe("coef")" value="@NumeroCelda(uu.CoeficientePropiedad, "coef")" @onchange="@(e => Inline(uu, "coef", e))" />
                                        break;
                                    case "habitaciones":
                                        <input class="dst-cell" type="number" value="@(uu.Habitaciones?.ToString() ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "habitaciones", e))" />
                                        break;
                                    case "banos":
                                        <input class="dst-cell" type="number" value="@(uu.Banos?.ToString() ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "banos", e))" />
                                        break;
                                    case "parqueaderos":
                                        <input class="dst-cell" type="number" value="@(uu.Parqueaderos?.ToString() ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "parqueaderos", e))" />
                                        break;
                                    case "pagaadmin":
                                        <select class="dst-cell" @onchange="@(e => Inline(uu, "pagaadmin", e))">
                                            <option value="true" selected="@(uu.PagaAdministracion)">Si</option>
                                            <option value="false" selected="@(!uu.PagaAdministracion)">No</option>
                                        </select>
                                        break;
                                    case "cuota":
                                        <input class="dst-cell" type="number" step="@PasoDe("cuota")" value="@NumeroCelda(uu.CuotaMensual, "cuota")" placeholder="-" @onchange="@(e => Inline(uu, "cuota", e))" />
                                        break;
                                    case "observaciones":
                                        <input class="dst-cell" type="@TipoInput("observaciones")" maxlength="@MaxDe("observaciones")" value="@(uu.Observaciones ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "observaciones", e))" />
                                        break;
                                    case "agrupacion":
                                        <div class="dst-c dst-ro">
                                            @{ var agr = AgrupacionDe(uu); }
                                            <span class="dst-agr dst-agr--@agr.ToLowerInvariant()">@agr</span>
                                        </div>
                                        break;
                                    case "matricula":
                                        <input class="dst-cell" type="@TipoInput("matricula")" maxlength="@MaxDe("matricula")" value="@(uu.MatriculaInmobiliaria ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "matricula", e))" />
                                        break;
                                    case "refpago":
                                        <input class="dst-cell" type="@TipoInput("refpago")" maxlength="@MaxDe("refpago")" value="@(uu.ReferenciaPago ?? "")" placeholder="-" @onchange="@(e => Inline(uu, "refpago", e))" />
                                        break;
                                    case "prop":
                                        <div class="dst-c dst-ro">
                                            @if (string.IsNullOrWhiteSpace(uu.PropietarioNombre)) { <span class="dst-sin">Sin propietario</span> }
                                            else
                                            {
                                                <span>@uu.PropietarioNombre</span>
                                                @if (uu.PropietariosCount > 1) { <span class="dst-mas" title="@uu.PropietariosCount propietarios">+@(uu.PropietariosCount - 1)</span> }
                                            }
                                        </div>
                                        break;
                                }
                            }
                            <div class="dst-anx-cell">
                                @if (!esAnexo)
                                {
                                    @if (nAnx > 0)
                                    {
                                        <button class="dst-anx-toggle" type="button" @onclick="() => ToggleAnexos(uu.Id)" title="Ver anexos (parqueaderos, cuartos utiles, bodegas)">
                                            @if (_anexosExpandidos.Contains(uu.Id)) { <span>&#9662;</span> } else { <span>&#9656;</span> }
                                            <span>@nAnx</span>
                                        </button>
                                    }
                                    <button class="dst-anx-add" type="button" @onclick="() => AbrirAgregarAnexo(uu)" title="Agregar anexo (parqueadero / cuarto util / bodega)">+ anexo</button>
                                }
                            </div>
                        </div>
                        @if (!esAnexo && _anexoAddPara == uu.Id)
                        {
                            <div class="dst-anexoadd">
                                <span class="dst-anexoadd-lbl">&#8627; Nuevo anexo de <strong>@uu.Numero</strong></span>
                                <select class="dst-nf-inp dst-anexoadd-tipo" @bind="_anexoTipo">
                                    <option value="@TipoUnidad.Parqueadero">Parqueadero</option>
                                    <option value="@TipoUnidad.UtilCuarto">Cuarto util</option>
                                    <option value="@TipoUnidad.Bodega">Bodega</option>
                                    <option value="@TipoUnidad.Deposito">Deposito</option>
                                    <option value="@TipoUnidad.ParqueaderoDeposito">Parqueadero + deposito</option>
                                </select>
                                <input class="dst-nf-inp dst-anexoadd-num" placeholder="Numero (ej. P-12)" @bind="_anexoNum" @bind:event="oninput" />
                                <button class="dst-row-add" type="button" @onclick="() => CrearAnexoAsync(uu)" disabled="@(_creandoAnexo || string.IsNullOrWhiteSpace(_anexoNum))">@(_creandoAnexo ? "..." : "Agregar")</button>
                                <button class="dst-anx-cancel" type="button" @onclick="@(() => { _anexoAddPara = null; _anexoNum = string.Empty; })">Cancelar</button>
                            </div>
                        }
                    }
                    @* Fila de alta inline: crear unidad desde la tabla (como Zonas/Seguros). El propietario
                       se asigna despues en la ficha (expander). El expander de esta fila crea y abre la ficha. *@
                    <div class="dst-row dst-newrow dst-grid2" style="grid-template-columns:@GridCols">
                        <div class="dst-exp-col">
                            <button type="button" class="dst-exp dst-exp-fijo" title="Abrir el modal de creacion" @onclick="OnExpandNuevaFila" disabled="@_creandoUnidad">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </div>
                        @foreach (var it in ColumnasVisibles)
                        {
                            if (it.EsCustom)
                            {
                                var cdd = it.Campo!;
                                var val = _nuCampos.GetValueOrDefault(cdd.Id);
                                switch (cdd.Tipo)
                                {
                                    case TipoCampoTablero.Seleccion:
                                        <select class="dst-nf-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                            <option value="">- elegir -</option>
                                            @foreach (var op in OpcionesDe(cdd)) { <option value="@op">@op</option> }
                                        </select>
                                        break;
                                    case TipoCampoTablero.Numero:
                                    case TipoCampoTablero.Moneda:
                                        <input class="dst-nf-inp" type="number" step="any" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" placeholder="@cdd.Label" />
                                        break;
                                    case TipoCampoTablero.Fecha:
                                        <input class="dst-nf-inp" type="date" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" />
                                        break;
                                    case TipoCampoTablero.Booleano:
                                        <select class="dst-nf-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()">
                                            <option value="">- elegir -</option>
                                            <option value="Si">Si</option>
                                            <option value="No">No</option>
                                        </select>
                                        break;
                                    default:
                                        <input class="dst-nf-inp" value="@val" @onchange="(e) => _nuCampos[cdd.Id] = e.Value?.ToString()" placeholder="@cdd.Label" />
                                        break;
                                }
                                continue;
                            }
                            switch (it.Def!.Key)
                            {
                                case "num":
                                    <input class="dst-nf-inp" placeholder="A1-202" title="Codigo TORRE-APARTAMENTO (ej. A1-202). La torre sale del codigo y el piso se infiere del numero de apto." @bind="_nuNum" @bind:event="oninput" />
                                    break;
                                case "torre":
                                    <div class="dst-nf-mut" title="Se toma del codigo (ej. la 'A1' de A1-202)">del codigo</div>
                                    break;
                                case "piso":
                                    <div class="dst-nf-mut" title="Se infiere del numero de apto (ej. 202 = piso 2)">auto</div>
                                    break;
                                case "tipo":
                                    <select class="dst-nf-inp" @bind="_nuTipoKey">
                                        @foreach (var t in TiposBaseVisibles) { <option value="@($"e:{t}")">@Etiqueta(t)</option> }
                                        @if (TiposCustomVisibles.Count > 0)
                                        {
                                            <optgroup label="Tipos propios">
                                                @foreach (var tc in TiposCustomVisibles) { <option value="@($"c:{tc.Id}")">@tc.Nombre</option> }
                                            </optgroup>
                                        }
                                    </select>
                                    break;
                                case "area":
                                    <input class="dst-nf-inp" type="number" step="@PasoDe("area")" placeholder="-" @bind="_nuArea" @bind:event="oninput" />
                                    break;
                                case "coef":
                                    <input class="dst-nf-inp" type="number" step="@PasoDe("coef")" placeholder="0" @bind="_nuCoef" @bind:event="oninput" />
                                    break;
                                case "agrupacion":
                                    <div class="dst-nf-mut" title="Se define al crear anexos (+ anexo)">auto</div>
                                    break;
                                case "matricula":
                                    <input class="dst-nf-inp" type="@TipoInput("matricula")" maxlength="@MaxDe("matricula")" placeholder="@AliasCampo("matricula", "Matricula")" @bind="_nuMatricula" @bind:event="oninput" />
                                    break;
                                case "refpago":
                                    <input class="dst-nf-inp" type="@TipoInput("refpago")" maxlength="@MaxDe("refpago")" placeholder="@AliasCampo("refpago", "Ref. pago")" @bind="_nuRefPago" @bind:event="oninput" />
                                    break;
                                default:
                                    <div class="dst-nf-mut" title="Se define en la ficha de la unidad">En la ficha</div>
                                    break;
                            }
                        }
                        <div class="dst-act dst-act-nf">
                            <button type="button" class="dst-row-add" @onclick="() => CrearUnidadDesdeAltaAsync(false)" disabled="@_creandoUnidad">@(_creandoUnidad ? "Creando..." : "+ Agregar")</button>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_inlineMsgU)) { <div class="dst-toast" @onclick="() => _inlineMsgU = null">@_inlineMsgU</div> }
            }
            else
            {
                @* Vista Lista: fila compacta y amigable por unidad (icono + numero + torre/piso/tipo
                   + propietario + tags de area y coeficiente). Comparte paginacion con la Tabla. *@
                <div class="dst-lista">
                    @foreach (var item in FilasRender())
                    {
                        if (item.EsGrupo)
                        {
                            var g = item.Grupo!;
                            <div class="dst-group"><span class="dst-group-t">@g.Titulo</span><span class="dst-group-n">@g.Items.Count</span></div>
                            continue;
                        }
                        var uu = item.Unidad!;
                        var u = uu;
                        <div class="dst-lrow" @onclick="() => AbrirFichaAsync(uu)" title="Abrir ficha de la unidad">
                            <span class="dst-lav">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-6 9 6v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
                            </span>
                            <span class="dst-lmain">
                                <span class="dst-lnum">@u.Numero</span>
                                <span class="dst-lmeta">@(u.TorreNombre ?? "-")@(u.Piso is null ? "" : $" - {LabelPisoSingular} {u.Piso}") - @EtiquetaU(u)</span>
                            </span>
                            <span class="dst-lprop">
                                @if (string.IsNullOrWhiteSpace(u.PropietarioNombre))
                                {
                                    <span class="dst-sin">Sin propietario</span>
                                }
                                else
                                {
                                    <span>@u.PropietarioNombre</span>
                                    @if (u.PropietariosCount > 1)
                                    {
                                        <span class="dst-mas" title="@u.PropietariosCount propietarios">+@(u.PropietariosCount - 1)</span>
                                    }
                                }
                            </span>
                            <span class="dst-ltags">
                                @if (u.AreaM2 is not null)
                                {
                                    <span class="dst-ltag">@($"{u.AreaM2:0.##} m2")</span>
                                }
                                <span class="dst-ltag dst-ltag--coef">Coef @u.CoeficientePropiedad.ToString("0.####")</span>
                            </span>
                            <svg class="dst-lchev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C3D0DD" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                        </div>
                    }
                </div>
            }

            @* Paginacion: una PH puede tener cientos de unidades y no se listan todas de golpe.
               Con agrupacion activa se muestran todos los grupos completos, sin paginar. *@
            @if (_agruparPor == "")
            {
            <div class="dst-pager">
                <div class="dst-pager-info">
                    Mostrando @(Filtradas.Count == 0 ? 0 : Desde + 1)-@Hasta de @Filtradas.Count unidades
                </div>
                <div class="dst-pager-ctrl">
                    <select class="dst-pager-sel" @onchange="CambiarTamanoPagina">
                        @foreach (var n in TamanosPagina)
                        {
                            <option value="@n" selected="@(n == _porPagina)">@n por pagina</option>
                        }
                    </select>
                    @if (TotalPaginas > 1)
                    {
                        <button class="dst-pager-btn" disabled="@(_pagina <= 1)" @onclick="() => IrAPagina(_pagina - 1)" title="Anterior">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
                        </button>
                        <span class="dst-pager-pos">@_pagina / @TotalPaginas</span>
                        <button class="dst-pager-btn" disabled="@(_pagina >= TotalPaginas)" @onclick="() => IrAPagina(_pagina + 1)" title="Siguiente">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                        </button>
                    }
                </div>
            </div>
            }
        </div>
    }
}


