    // Crea el anexo como unidad (tipo parqueadero/cuarto/bodega) y lo vincula a la principal (RN-09).
    private async Task CrearAnexoAsync(UnidadDto principal)
    {
        if (_creandoAnexo || string.IsNullOrWhiteSpace(_anexoNum)) return;
        _creandoAnexo = true;
        try
        {
            var req = new CrearUnidadRequest(_anexoNum.Trim(), _anexoTipo, principal.TorreId, principal.Piso, 0m, null,
                null, null, null, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
            if (!resp.IsSuccessStatusCode) { _inlineMsgU = "No se pudo crear el anexo: " + await resp.Content.ReadAsStringAsync(); return; }
            var creada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
            if (creada is not null)
            {
                var vresp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{principal.Id}/vinculos",
                    new CrearVinculoUnidadRequest(creada.Id, true));
                if (!vresp.IsSuccessStatusCode) _inlineMsgU = "Anexo creado, pero no se pudo vincular: " + await vresp.Content.ReadAsStringAsync();
            }
            _anexoAddPara = null; _anexoNum = "";
            _anexosExpandidos.Add(principal.Id);
            await CargarAsync();
        }
        catch (Exception ex) { _inlineMsgU = "Error al crear el anexo: " + ex.Message; }
        finally { _creandoAnexo = false; }
