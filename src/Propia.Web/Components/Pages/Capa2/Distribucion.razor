        var l = label?.Trim();
        PrefDe(key).Label = string.IsNullOrWhiteSpace(l) || string.Equals(l, def, StringComparison.Ordinal) ? null : l;
        await GuardarColsAsync();
    }
    private async Task GuardarColsAsync()
    {
