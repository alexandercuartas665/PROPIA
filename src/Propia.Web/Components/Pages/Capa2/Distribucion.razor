        if (_agruparPor == "") return null;
        var items = Filtradas;
        var gs = _agruparPor switch
        {
            "torre" => items.GroupBy(u => u.TorreNombre ?? $"Sin {LabelAgrupacionSingular.ToLower()}"),
            "estado" => items.GroupBy(u => string.IsNullOrWhiteSpace(u.Estado) ? "Sin estado" : u.Estado!),
            "tipo" => items.GroupBy(u => EtiquetaU(u)),
            "propietario" => items.GroupBy(u => string.IsNullOrWhiteSpace(u.PropietarioNombre) ? "Sin propietario" : u.PropietarioNombre!),
            _ => null
        };
        if (gs is null) return null;
        return gs.Select(g => new GrupoUni(g.Key, g.ToList()))
                 .OrderBy(g => g.Titulo.StartsWith("Sin ", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
                 .ThenBy(g => g.Titulo, StringComparer.CurrentCultureIgnoreCase)
                 .ToList();
