    private string _vista = "tabla";   // "tabla" | "lista" (se recuerda por modulo)
    private const string VistaKey = "propia_view_unidades";

    private bool HayFiltros => !string.IsNullOrWhiteSpace(_q) || (_fd?.Hay ?? false);

    // La vista (Lista/Tabla) se recuerda por modulo en localStorage: sobrevive al cierre de
    // sesion (el logout solo borra llaves puntuales, no hace localStorage.clear()).
    private async Task SetVista(string v)
    {
        _vista = v;
        try { await Js.InvokeVoidAsync("localStorage.setItem", VistaKey, v); } catch { }
    }

    private async Task RestaurarVistaAsync()
    {
        try
        {
            var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey);
            if (v == "lista" || v == "tabla") _vista = v;
        }
        catch { }
