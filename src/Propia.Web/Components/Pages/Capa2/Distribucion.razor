    private bool EsVisible(ColDef c) => !c.Hideable || !_cols.TryGetValue(c.Key, out var p) || p.Visible;
    private string Etiqueta(ColDef c) => (_cols.TryGetValue(c.Key, out var p) && !string.IsNullOrWhiteSpace(p.Label)) ? p.Label! : c.DefLabel;
    // Catalogo en el orden elegido por el usuario (claves desconocidas van al final, por seguridad).
    private IEnumerable<ColDef> CatalogoOrdenado
    {
        get
        {
            var byKey = Catalogo.ToDictionary(c => c.Key);
