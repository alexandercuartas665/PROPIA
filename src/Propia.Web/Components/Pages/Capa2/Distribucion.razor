            foreach (var c in Catalogo) { if (!_colOrderU.Contains(c.Key)) yield return c; }
        }
    }
    private IEnumerable<ColDef> ColsVisibles => CatalogoOrdenado.Where(EsVisible);
    private string GridCols => "34px " + string.Join(" ", ColsVisibles.Select(c => c.Width)) + " 120px";

    private ColPref PrefDe(string key)
    {
        if (!_cols.TryGetValue(key, out var p)) { p = new(); _cols[key] = p; }
        return p;
    }
    private async Task SetColVisible(string key, bool v) { PrefDe(key).Visible = v; await GuardarColsAsync(); }
    private async Task MoverColU(int idx, int dir)
    {
        var ni = idx + dir;
        if (ni < 0 || ni >= _colOrderU.Count) return;
        (_colOrderU[idx], _colOrderU[ni]) = (_colOrderU[ni], _colOrderU[idx]);
        await GuardarColsAsync();
    }
    private async Task SetColLabel(string key, string? label)
    {
