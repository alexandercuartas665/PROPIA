    /* Chip de proveedor por color: Evolution=morado, Cloud=azul, YCloud=verde */
    .lw-prov.evo, .lw-prov.cloud, .lw-prov.yc { align-self:flex-start; font-size:9.5px; font-weight:800; letter-spacing:.5px; padding:2px 8px; border-radius:6px; }
