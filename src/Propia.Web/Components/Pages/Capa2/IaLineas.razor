    .lw-actions { display:flex; flex-wrap:wrap; gap:7px; align-items:center; margin-top:13px; }
    .lw-btn-sm { font-size:11.5px; font-weight:700; padding:7px 12px; border-radius:9px; border:1px solid var(--propia-border-card); background:var(--propia-bg-card); color:var(--propia-text-secondary); cursor:pointer; transition:all .13s ease; }
    .lw-btn-sm:hover { border-color:var(--propia-brand); color:var(--propia-brand); background:var(--propia-brand-soft); }
    .lw-btn-sm:disabled { opacity:.5; cursor:not-allowed; }
    .lw-btn-sm.dark { background:var(--propia-brand); color: var(--propia-text-inverse); border-color:var(--propia-brand); box-shadow:0 3px 9px rgba(109,79,227,.25); }
    .lw-btn-sm.dark:hover { background:var(--propia-brand-hover); color: var(--propia-text-inverse); }
    .lw-btn-sm.danger { color:#C0383C; border-color:#F5C8CB; margin-left:auto; }
    .lw-btn-sm.danger:hover { background:var(--propia-danger-soft); border-color:#E0565B; color:#C0383C; }
    .lw-ov { position:fixed; inset:0; z-index:81; background:rgba(27,42,58,.6); display:flex; align-items:center; justify-content:center; padding:24px; }
    .lw-modal { width:min(460px,96vw); max-height:calc(100vh - 48px); overflow-y:auto; background:var(--propia-bg-card); border-radius:16px; box-shadow:0 30px 70px rgba(27,42,58,.45); padding:22px 24px; }
    .lw-modal h5 { font-size:17px; font-weight:800; color:var(--propia-text-h1); margin:0 0 14px; }
    .lw-fld { margin-bottom:12px; }
    .lw-fld label { font-size:11px; font-weight:700; color:var(--propia-text-muted); display:block; margin-bottom:5px; }
    .lw-input { width:100%; border:1px solid var(--propia-border-card); border-radius:9px; padding:9px 12px; font-size:13px; color:var(--propia-text-body); outline:none; box-sizing:border-box; font-family:inherit; }
    .lw-input:focus { border-color:var(--propia-brand); }
    .lw-modal-foot { display:flex; gap:8px; justify-content:flex-end; margin-top:6px; position:sticky; bottom:-22px; padding:10px 0 4px; background:var(--propia-bg-card); }   /* los botones siempre a la vista */
    .lw-hint { font-size:12px; color:var(--propia-text-muted); line-height:1.45; margin-bottom:12px; }
    .lw-pasos { font-size:12.5px; color:var(--propia-text-body); padding-left:18px; margin:0 0 12px; line-height:1.55; }
    .lw-btn-sm.warn { border-color:var(--propia-warning-border, var(--propia-border-card)); background:var(--propia-warning-bg); color:var(--propia-warning); }
    .lw-btn-ghost { font-size:12.5px; font-weight:700; padding:9px 14px; border-radius:9px; border:1px solid var(--propia-border-card); background:var(--propia-bg-card); color:var(--propia-text-secondary); cursor:pointer; }
    .lw-btn-ghost:hover { border-color:var(--propia-text-faint); }

    /* KPIs + Avanzado + tabla (estilo dashboard del hermano) */
    .lw-kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:14px; }
    .lw-kpi { background:var(--propia-bg-card); border:1px solid var(--propia-border-card); border-radius:14px; padding:16px 18px; box-shadow:0 1px 2px rgba(45,62,80,.05); display:flex; align-items:center; gap:13px; }
    .lw-kpi-ic { width:42px; height:42px; border-radius:11px; background:var(--propia-brand-soft); color:var(--propia-brand); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .lw-kpi-ic.ok { background:var(--propia-ok-soft); color:#1A8754; }
    .lw-kpi-ic.warn { background:var(--propia-bg-card)4E2; color:#E8910C; }
    .lw-kpi-l { font-size:11px; font-weight:700; letter-spacing:.4px; color:var(--propia-text-faint); }
    .lw-kpi-n { font-size:26px; font-weight:800; letter-spacing:-1px; color:var(--propia-text-h1); line-height:1.1; }
    .lw-kpi-s { font-size:11px; color:var(--propia-text-muted); }
    .lw-adv { background:var(--propia-bg-card); border:1px solid var(--propia-border-card); border-radius:12px; margin-bottom:14px; }
    .lw-adv summary { display:flex; align-items:center; gap:8px; padding:12px 16px; cursor:pointer; font-size:13px; color:var(--propia-text-secondary); list-style:none; }
    .lw-adv summary::-webkit-details-marker { display:none; }
    .lw-adv summary strong { color:var(--propia-text-h1); }
    .lw-adv summary span { color:var(--propia-text-faint); font-size:12px; }
    .lw-adv-body { padding:0 16px 14px; }
    .lw-adv-row { display:flex; justify-content:space-between; align-items:center; font-size:13px; color:var(--propia-text-secondary); padding:8px 0; border-top:1px solid var(--propia-border-divider); }
    .lw-adv-note { font-size:12px; color:var(--propia-text-muted); line-height:1.5; margin-top:6px; }
    .lw-tablecard { background:var(--propia-bg-card); border:1px solid var(--propia-border-card); border-radius:14px; box-shadow:0 1px 2px rgba(45,62,80,.05); overflow-x:auto; }
    .lw-table { width:100%; border-collapse:collapse; font-size:13px; min-width:640px; }
    .lw-table thead th { position:relative; text-align:left; font-size:10.5px; letter-spacing:.4px; font-weight:700; color:var(--propia-text-faint); padding:12px 16px; background:var(--propia-bg-app); border-bottom:1px solid var(--propia-border-divider); }
    /* Handle de redimensionar (= .mas-col-rz del canon); la guia la pinta propiaTablaResize. cursor grab via [data-clave]. */
    .lw-col-rz { position:absolute; top:0; right:-4px; width:8px; height:100%; cursor:col-resize; z-index:3; }
    .lw-col-rz::after { content:""; position:absolute; top:6px; bottom:6px; left:3px; width:2px; border-radius:2px; background:transparent; transition:background .12s; }
    .lw-col-rz:hover::after { background:var(--propia-brand); }
    .lw-table tbody td { padding:12px 16px; border-bottom:1px solid var(--propia-border-divider); color:var(--propia-text-body); vertical-align:middle; }
    .lw-table tbody tr:last-child td { border-bottom:none; }
    .lw-table tbody tr:hover { background:var(--propia-bg-hover); }
    .lw-td-nom { font-size:13.5px; font-weight:700; color:var(--propia-text-h1); margin-bottom:3px; }
    .lw-td-mut { color:var(--propia-text-muted); }
    .lw-prov { font-size:9.5px; font-weight:800; letter-spacing:.4px; color:var(--propia-brand); background:var(--propia-brand-soft); padding:2px 7px; border-radius:5px; }
    .lw-row-actions { display:flex; gap:7px; justify-content:flex-end; flex-wrap:wrap; }
    @@media (max-width:760px) { .lw-kpis { grid-template-columns:1fr; } }
</style>

@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private bool? _serverReady;
    private string? _loadError;
    private string? _info;

    private List<WhatsAppLineDto>? _lineas;

    // ===== Columnas: catalogo + config (orden/ancho) por copropiedad, entidad 'lineawhatsapp' =====
    private sealed record ColDef(string Key, string Label);
    private static readonly ColDef[] Catalogo =
        { new("linea", "Linea"), new("telefono", "Teléfono"), new("estado", "Estado"), new("ultima", "Última conexión") };
    private List<string> _colOrder = Catalogo.Select(c => c.Key).ToList();
    private const string EntCfg = "lineawhatsapp";
    private Dictionary<string, UnidadCampoConfigDto> _cfg = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _colW = new(StringComparer.Ordinal);
    private DotNetObjectReference<IaLineas>? _self;
    private IEnumerable<string> ColsVisibles => _colOrder;
    private static string ColLabel(string k) => Catalogo.First(c => c.Key == k).Label;
    private static string CeldaClass(string k) => k switch { "telefono" or "ultima" => "lw-td-mut", _ => "" };
    private RenderFragment CeldaContenido(WhatsAppLineDto line, string key) => builder =>
    {
        switch (key)
        {
            case "linea":
                builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "lw-td-nom"); builder.AddContent(2, line.InstanceName); builder.CloseElement();
                builder.OpenElement(3, "span"); builder.AddAttribute(4, "class", "lw-prov"); builder.AddContent(5, line.Provider == WhatsAppProvider.Cloud ? "CLOUD (META)" : "EVOLUTION"); builder.CloseElement();
                break;
            case "telefono": builder.AddContent(0, string.IsNullOrWhiteSpace(line.PhoneNumber) ? "-" : line.PhoneNumber); break;
            case "estado":
                builder.OpenElement(0, "span"); builder.AddAttribute(1, "class", "lw-badge"); builder.AddAttribute(2, "style", StatusBadgeStyle(line.Status)); builder.AddContent(3, StatusLabel(line.Status)); builder.CloseElement();
                break;
            case "ultima": builder.AddContent(0, line.LastConnectedAt is null ? "-" : line.LastConnectedAt.Value.ToCo().ToString("dd MMM HH:mm")); break;
        }
    };

    private UnidadCampoConfigDto? CfgDe(string k) => _cfg.TryGetValue(k, out var c) ? c : null;
    private GuardarUnidadCampoConfigRequest FilaConfig(string clave)
    {
        var c = CfgDe(clave);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato, Oculto: c?.Oculto ?? false, Orden: c?.Orden, Entidad: EntCfg, Descripcion: c?.Descripcion);
    }
    private async Task GuardarCfg(GuardarUnidadCampoConfigRequest req)
    { try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { } }
    private async Task CargarConfigAsync()
    {
        try
        {
            var lista = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>($"/api/mi-copropiedad/unidades-config?entidad={EntCfg}") ?? new();
            _cfg = lista.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
        }
        catch { _cfg = new(StringComparer.Ordinal); }
        _colOrder = Catalogo.Select((c, i) => (c.Key, ord: CfgDe(c.Key)?.Orden ?? (1000 + i)))
                            .OrderBy(x => x.ord).Select(x => x.Key).ToList();
        HidratarAnchos();
    }
    private void HidratarAnchos()
    {
        _colW.Clear();
        foreach (var kv in _cfg) { var w = AnchoDeFormato(kv.Value.Formato); if (w is > 0) _colW[kv.Key] = w.Value; }
    }
    private static int? AnchoDeFormato(string? json)
    { try { var o = System.Text.Json.Nodes.JsonNode.Parse(json ?? "") as System.Text.Json.Nodes.JsonObject; return o?["w"]?.GetValue<int>(); } catch { return null; } }
    private static string? ConAncho(string? json, int? w)
    {
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(json) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (w is null) o.Remove("w"); else o["w"] = w.Value;
        return o.Count == 0 ? null : o.ToJsonString();
    }
    private string ColStyle(string k) => $"width:{(_colW.TryGetValue(k, out var w) ? w : AnchoDefault(k))}px";
    private static int AnchoDefault(string k) => k switch { "linea" => 240, "ultima" => 180, "estado" => 150, _ => 190 };

    private async Task IniciarReorder(MouseEventArgs e, string k)
    { _self ??= DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("propiaTablaColReorder.start", _self, k, e.ClientX, e.ClientY); } catch { } }
    [JSInvokable]
    public async Task OnColReorder(string src, string dest)
    {
        if (src == dest) return;
        var keys = _colOrder.ToList();
        var from = keys.IndexOf(src); var to = keys.IndexOf(dest);
        if (from < 0 || to < 0) return;
        keys.RemoveAt(from); keys.Insert(to, src);
        for (int i = 0; i < keys.Count; i++) await GuardarCfg(FilaConfig(keys[i]) with { Orden = i });
        await CargarConfigAsync(); StateHasChanged();
    }
    private async Task IniciarResize(MouseEventArgs e, string k)
    { _self ??= DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("propiaTablaResize.start", _self, k, e.ClientX); } catch { } }
    private Task ResetResize(string k) => OnColResize(k, 0);
    [JSInvokable]
    public async Task OnColResize(string clave, int width)
    {
        int? w = width <= 0 ? null : Math.Max(70, width);
        if (w is null) _colW.Remove(clave); else _colW[clave] = w.Value;
        await GuardarCfg(FilaConfig(clave) with { Formato = ConAncho(CfgDe(clave)?.Formato, w) });
        await CargarConfigAsync(); StateHasChanged();
    }
    public void Dispose() { _self?.Dispose(); }

    private bool _showCrear;
    private LineForm _crear = new();
    private string? _crearError;

    private bool _showQr;
    private string? _qr;
    private string? _qrError;

    private bool _showProbar;
    private Guid _probarLineId;
    private string _probarPhone = "";
    private string _probarText = "Mensaje de prueba desde PROPIA.";
    private string? _probarMsg;
    private string _probarMsgClass = "alert-info";

    private bool _showEliminar;
    private WhatsAppLineDto? _eliminarLine;
    private string? _eliminarError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarServidorAsync();
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { /* prerender */ }
    }

    private async Task CargarServidorAsync()
    {
        try
        {
            var r = await Auth().GetFromJsonAsync<ServerReady>("/api/ia/lineas/servidor-listo");
            _serverReady = r?.Ready;
        }
        catch { _serverReady = null; }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/ia/lineas");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevoJwt)) return;
                _jwt = nuevoJwt;
                http = Auth();
                resp = await http.GetAsync("/api/ia/lineas");
            }
            resp.EnsureSuccessStatusCode();
            _lineas = await resp.Content.ReadFromJsonAsync<List<WhatsAppLineDto>>() ?? new();
            await CargarConfigAsync();   // orden/ancho de columnas por copropiedad
            _loadError = null;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private async Task CrearAsync()
    {
        _crearError = null;
        _busy = true;
        try
        {
            var req = new CreateWhatsAppLineRequest(_crear.InstanceName, _crear.PhoneNumber, _crear.Provider,
                _crear.CloudPhoneNumberId, _crear.CloudBusinessAccountId, _crear.CloudAccessToken, _crear.CloudWebhookVerifyToken,
                _crear.YCloudApiKey, _crear.YCloudFromNumber);
            var resp = await Auth().PostAsJsonAsync("/api/ia/lineas", req);
            if (!resp.IsSuccessStatusCode)
            {
                _crearError = await ErrorMsg(resp);
                return;
            }
            var proveedor = _crear.Provider;
            var creada = await resp.Content.ReadFromJsonAsync<WhatsAppLineDto>();
            var secreto = _crearSecreto.Trim();
            _showCrear = false;
            _crear = new();
            _crearSecreto = ""; _copiadoCrear = false;
            await CargarAsync();
            if (proveedor == WhatsAppProvider.YCloud && creada is not null)
            {
                if (secreto.Length > 0)
                {
                    // Deja el webhook listo de una vez: la linea queda recibiendo mensajes de YCloud.
                    var rs = await Auth().PutAsJsonAsync($"/api/ia/lineas/{creada.Id}/ycloud-webhook", new YCloudWebhookSecretoRequest(secreto));
                    if (!rs.IsSuccessStatusCode) _loadError = "La línea se creó, pero no se pudo guardar el secreto del webhook: " + await ErrorMsg(rs);
                    await CargarAsync();
                }
                else
                {
                    // Sin secreto: se abre el panel del webhook de la linea nueva para que no quede a medias.
                    await AbrirWebhookAsync(creada);
                }
            }
        }
        catch (Exception ex) { _crearError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConectarAsync(WhatsAppLineDto line)
    {
        _busy = true; _qr = null; _qrError = null; _info = null;
        try
        {
            var resp = await Auth().PostAsync($"/api/ia/lineas/{line.Id}/conectar", null);
            var r = await resp.Content.ReadFromJsonAsync<LineConnectResult>();
            if (line.Provider != WhatsAppProvider.Evolution)
            {
                // Cloud (Meta) y YCloud no usan QR: el connect valida las credenciales contra el proveedor.
                var prov = line.Provider == WhatsAppProvider.Cloud ? "Cloud (Meta)" : "YCloud";
                if (r?.Ok == true) { _info = $"Linea {prov} validada y conectada."; }
                else { _loadError = r?.Error ?? $"No se pudo validar la linea {prov}."; }
            }
            else
            {
                _qr = r?.QrBase64;
                _qrError = r?.Error;
                _showQr = true;
            }
            await CargarAsync();
        }
        catch (Exception ex)
        {
            if (line.Provider != WhatsAppProvider.Evolution) { _loadError = ex.Message; }
            else { _qrError = ex.Message; _showQr = true; }
        }
        finally { _busy = false; }
    }

    private async Task RefrescarAsync(Guid id)
    {
        _busy = true;
        try { await Auth().PostAsync($"/api/ia/lineas/{id}/refrescar", null); await CargarAsync(); }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DesconectarAsync(Guid id)
    {
        _busy = true;
        try { await Auth().PostAsync($"/api/ia/lineas/{id}/desconectar", null); await CargarAsync(); }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _busy = false; }
    }

    // ----- Webhook de entrada de YCloud -----
    // URL universal del webhook (enruta por el numero de la linea): la misma para todas las copropiedades.
    private const string RutaWebhookYCloud = "/webhooks/ycloud";
    private string WebhookUrlUniversal => new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority) + RutaWebhookYCloud;
    private bool EsLocal => new Uri(Nav.BaseUri).IsLoopback;
    private string _crearSecreto = "";
    private bool _copiadoCrear;

    private async Task CopiarTextoAsync(string texto)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", texto); _copiadoCrear = true; }
        catch { _crearError = "No se pudo copiar: selecciona la URL y cópiala a mano."; }
    }

    private bool _showWebhook, _webhookOk, _webhookLocal, _copiado;
    private WhatsAppLineDto? _webhookLine;
    private string _webhookUrl = "", _webhookSecreto = "";
    private string? _webhookMsg;

    private async Task AbrirWebhookAsync(WhatsAppLineDto line)
    {
        _webhookLine = line; _webhookSecreto = ""; _webhookMsg = null; _copiado = false;
        try
        {
            var info = await Auth().GetFromJsonAsync<YCloudWebhookInfoDto>($"/api/ia/lineas/{line.Id}/ycloud-webhook");
            var baseUri = new Uri(Nav.BaseUri);
            _webhookLocal = baseUri.IsLoopback;
            _webhookUrl = baseUri.GetLeftPart(UriPartial.Authority) + (info?.Ruta ?? "");
        }
        catch (Exception ex) { _webhookMsg = ex.Message; _webhookOk = false; }
        _showWebhook = true;
    }

    private async Task CopiarUrlAsync()
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", _webhookUrl); _copiado = true; }
        catch { _webhookMsg = "No se pudo copiar: selecciona la URL y cópiala a mano."; _webhookOk = false; }
    }

    private async Task GuardarWebhookAsync(bool quitar)
    {
        if (_webhookLine is null) return;
        _busy = true; _webhookMsg = null;
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/ia/lineas/{_webhookLine.Id}/ycloud-webhook",
                new YCloudWebhookSecretoRequest(quitar ? null : _webhookSecreto.Trim()));
            if (!resp.IsSuccessStatusCode) { _webhookOk = false; _webhookMsg = await ErrorMsg(resp); return; }
            _webhookLine = await resp.Content.ReadFromJsonAsync<WhatsAppLineDto>() ?? _webhookLine;
            _webhookSecreto = "";
            _webhookOk = true;
            _webhookMsg = quitar ? "Secreto quitado: la línea deja de recibir mensajes por el webhook." : "Secreto guardado: la línea ya puede recibir mensajes de YCloud.";
            await CargarAsync();
        }
        catch (Exception ex) { _webhookOk = false; _webhookMsg = ex.Message; }
        finally { _busy = false; }
    }

    private void AbrirProbar(Guid id)
    {
        _probarLineId = id; _probarMsg = null; _showProbar = true;
    }

    private void AbrirEliminar(WhatsAppLineDto line)
    {
        _eliminarLine = line; _eliminarError = null; _showEliminar = true;
    }

    private async Task EliminarAsync()
    {
        if (_eliminarLine is null) return;
        _busy = true; _eliminarError = null;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/ia/lineas/{_eliminarLine.Id}");
            if (resp.IsSuccessStatusCode)
            {
                _showEliminar = false;
                _eliminarLine = null;
                await CargarAsync();
            }
            else { _eliminarError = await ErrorMsg(resp); }
        }
        catch (Exception ex) { _eliminarError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ProbarEnvioAsync()
    {
        _busy = true; _probarMsg = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/ia/lineas/{_probarLineId}/probar-envio",
                new { Phone = _probarPhone, Text = _probarText });
            var r = await resp.Content.ReadFromJsonAsync<LineSendResult>();
            if (r?.Ok == true) { _probarMsg = "Mensaje enviado."; _probarMsgClass = "alert-success"; }
            else { _probarMsg = r?.Error ?? "No se pudo enviar."; _probarMsgClass = "alert-danger"; }
        }
        catch (Exception ex) { _probarMsg = ex.Message; _probarMsgClass = "alert-danger"; }
        finally { _busy = false; }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private static async Task<string> ErrorMsg(HttpResponseMessage resp)
    {
        try { var e = await resp.Content.ReadFromJsonAsync<ApiError>(); return e?.Error ?? $"HTTP {(int)resp.StatusCode}"; }
        catch { return $"HTTP {(int)resp.StatusCode}"; }
    }

    private static string QrSrc(string qr) => qr.StartsWith("data:") ? qr : $"data:image/png;base64,{qr}";

    // Clave corta de estado para el acento/punto de la tarjeta (on/warn/err/off/idle).
