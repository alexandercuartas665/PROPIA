    .lw-card-body { display:flex; flex-direction:column; gap:7px; padding:12px 0; border-top:1px solid var(--propia-border-divider); border-bottom:1px solid var(--propia-border-divider); }
    .lw-row { display:flex; align-items:center; gap:8px; font-size:12.5px; font-weight:600; color:var(--propia-text-secondary); }
    .lw-row svg { color:var(--propia-text-faint); flex-shrink:0; }
