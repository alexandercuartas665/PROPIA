    .lw-card-top { display:flex; align-items:center; gap:11px; margin-bottom:13px; }
    .lw-ava { position:relative; width:40px; height:40px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:#fff; background:linear-gradient(135deg,#25D366,#128C7E); box-shadow:0 5px 12px rgba(18,140,126,.30); }
    .lw-card:not(.s-on) .lw-ava { background:linear-gradient(135deg,#B4C3D2,#94A7BA); box-shadow:none; }
    .lw-live { position:absolute; right:-3px; bottom:-3px; width:12px; height:12px; border-radius:50%; background:var(--lw-acc,#C3D0DD); border:2.5px solid var(--propia-bg-card); }
    .lw-card.s-on .lw-live { animation:lwpulse 2s infinite; }
    @@keyframes lwpulse { 0% { box-shadow:0 0 0 0 rgba(31,174,84,.5); } 70% { box-shadow:0 0 0 7px rgba(31,174,84,0); } 100% { box-shadow:0 0 0 0 rgba(31,174,84,0); } }
    .lw-card-id { flex:1; min-width:0; display:flex; flex-direction:column; gap:4px; }
    .lw-card-nom { font-size:14.5px; font-weight:800; color:var(--propia-text-h1); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; letter-spacing:-.2px; }
    .lw-badge { font-size:10px; font-weight:800; padding:4px 10px; border-radius:20px; flex-shrink:0; display:inline-flex; align-items:center; gap:5px; text-transform:uppercase; letter-spacing:.3px; align-self:flex-start; }
    .lw-badge::before { content:""; width:6px; height:6px; border-radius:50%; background:currentColor; }
    .lw-webhook-box { margin:6px 0 12px; padding:12px 14px; border-radius:10px; background:var(--propia-brand-soft-2); border:1px solid var(--propia-brand-border); }
