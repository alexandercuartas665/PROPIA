    };

    private static string ProvLabel(WhatsAppProvider p) => p switch
    {
        WhatsAppProvider.Cloud => "CLOUD (META)",
        WhatsAppProvider.YCloud => "YCLOUD",
        _ => "EVOLUTION"
    };

    private static string ProvClass(WhatsAppProvider p) => p switch
    {
        WhatsAppProvider.Cloud => "cloud",
        WhatsAppProvider.YCloud => "yc",
        _ => "evo"
    };

    // Numero a mostrar en la tarjeta: el telefono explicito y, si no hay, el remitente del proveedor (YCloud).
    private static string NumeroLinea(WhatsAppLineDto l)
    {
        if (!string.IsNullOrWhiteSpace(l.PhoneNumber)) { return l.PhoneNumber!; }
        if (l.Provider == WhatsAppProvider.YCloud && !string.IsNullOrWhiteSpace(l.YCloudFromNumber)) { return l.YCloudFromNumber!; }
        return "Sin numero";
    }

