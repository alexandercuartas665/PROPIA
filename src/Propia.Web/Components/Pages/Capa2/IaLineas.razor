    {
        WhatsAppLineStatus.Created => "Creada",
        WhatsAppLineStatus.Connecting => "Conectando",
        WhatsAppLineStatus.Connected => "Conectada",
        WhatsAppLineStatus.Disconnected => "Desconectada",
        WhatsAppLineStatus.Failed => "Error",
        WhatsAppLineStatus.Disabled => "Deshabilitada",
        _ => s.ToString()
    };

    private static string StatusBadgeStyle(WhatsAppLineStatus s) => s switch
    {
        WhatsAppLineStatus.Connected => "color:#15703F;background:#E6F6EE",
        WhatsAppLineStatus.Connecting => "color:#1D4ED8;background:#E0EAFF",
        WhatsAppLineStatus.Failed => "color:#A12B30;background:#FDE7E7",
        WhatsAppLineStatus.Disabled => "color:#516F90;background:#EEF3F8",
