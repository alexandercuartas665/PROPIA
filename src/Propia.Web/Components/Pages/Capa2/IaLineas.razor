@page "/ia/lineas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.InfraestructuraIa
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Lineas WhatsApp - PROPIA</PageTitle>

@* Infraestructura IA (Capa 2): lineas WhatsApp de la copropiedad. Portado de CUBOT.travels,
   re-estilizado a la plantilla PROPIA (Lexend / morado). Conexion contra el servidor Evolution maestro. *@

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

<div class="lw-wrap">
    <div class="lw-head">
        <div>
            <h1 class="lw-h1">Lineas <span style="color:var(--propia-brand)">WhatsApp</span></h1>
            <p class="lw-sub">Conecta números de WhatsApp para atender a los residentes de la copropiedad.</p>
        </div>
        <button class="lw-btn-primary" @onclick="() => { _showCrear = true; _crearSecreto = string.Empty; _copiadoCrear = false; }">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"></path></svg>
            Nueva linea
        </button>
    </div>

    @if (_serverReady == false)
    {
        <div class="lw-warn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
            <span>El servidor Evolution (WhatsApp) aun no esta configurado a nivel plataforma. Un administrador de A&amp;D GROUP debe configurarlo en la consola SuperAdmin antes de conectar lineas.</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="lw-err">@_loadError <button class="lw-btn-sm" style="margin-left:8px" @onclick="CargarAsync">Reintentar</button></div>
    }
    @if (!string.IsNullOrEmpty(_info))
    {
        <div class="lw-ok">@_info</div>
    }

    @if (_lineas is not null)
    {
        <div class="lw-kpis">
            <div class="lw-kpi">
                <div class="lw-kpi-ic"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="5" y="2" width="14" height="20" rx="2"></rect><path d="M11 18h2"></path></svg></div>
                <div><div class="lw-kpi-l">LINEAS</div><div class="lw-kpi-n">@_lineas.Count</div><div class="lw-kpi-s">Total registradas</div></div>
            </div>
            <div class="lw-kpi">
                <div class="lw-kpi-ic ok"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"></path></svg></div>
                <div><div class="lw-kpi-l">CONECTADAS</div><div class="lw-kpi-n" style="color:var(--propia-success)">@_lineas.Count(l => l.Status == WhatsAppLineStatus.Connected)</div><div class="lw-kpi-s">En linea</div></div>
            </div>
            <div class="lw-kpi">
                <div class="lw-kpi-ic warn"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></div>
                <div><div class="lw-kpi-l">PENDIENTES</div><div class="lw-kpi-n" style="color:#E8910C">@_lineas.Count(l => l.Status != WhatsAppLineStatus.Connected)</div><div class="lw-kpi-s">Por conectar</div></div>
            </div>
        </div>

        <details class="lw-adv">
            <summary><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg><strong>Avanzado</strong> <span>Servidor y webhook de WhatsApp</span></summary>
            <div class="lw-adv-body">
                <div class="lw-adv-row"><span>Servidor Evolution maestro</span><b style="color:@(_serverReady == true ? "#15703F" : "#A12B30")">@(_serverReady == true ? "Configurado y listo" : "No configurado")</b></div>
                <div class="lw-adv-note">El servidor Evolution (no oficial) y el webhook se administran a nivel plataforma en la consola SuperAdmin (A&amp;D GROUP). Las lineas Cloud (Meta) usan su propio Access Token por linea.</div>
            </div>
        </details>
    }

    @if (_lineas is null)
    {
        <div class="lw-empty"><div class="spinner-border" style="color:var(--propia-brand)"></div></div>
    }
    else if (_lineas.Count == 0)
    {
        <div class="lw-empty">
            <div class="lw-empty-ic">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#6D4FE3" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            </div>
            Aun no hay lineas conectadas. Crea la primera con <b>"Nueva linea"</b>.
        </div>
    }
    else
    {
        <div class="lw-grid">
            @foreach (var l in _lineas)
            {
                var line = l;
                var conn = line.Status == WhatsAppLineStatus.Connected;
                <div class="lw-card s-@StatusKey(line.Status)">
                    <div class="lw-card-top">
                        <div class="lw-ava">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                            <span class="lw-live"></span>
                        </div>
                        <div class="lw-card-id">
                            <div class="lw-card-nom" title="@line.InstanceName">@line.InstanceName</div>
                            <span class="lw-prov @ProvClass(line.Provider)">@ProvLabel(line.Provider)</span>
                        </div>
                        <span class="lw-badge" style="@StatusBadgeStyle(line.Status)">@StatusLabel(line.Status)</span>
                    </div>
                    <div class="lw-card-body">
                        <div class="lw-row">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            <span>@NumeroLinea(line)</span>
                        </div>
                        <div class="lw-row">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5l3 2"></path></svg>
                            <span>Ultima conexion: <b>@(line.LastConnectedAt is null ? "-" : line.LastConnectedAt.Value.ToCo().ToString("dd MMM, HH:mm"))</b></span>
                        </div>
                    </div>
                    <div class="lw-actions">
                        @if (!conn)
                        {
                            <button class="lw-btn-sm dark" @onclick="() => ConectarAsync(line)" disabled="@_busy">@(line.Provider == WhatsAppProvider.Evolution ? "Conectar / QR" : "Validar")</button>
                        }
                        <button class="lw-btn-sm @(conn ? "dark" : "")" @onclick="() => AbrirProbar(line.Id)">Probar envio</button>
                        @if (line.Provider == WhatsAppProvider.YCloud)
                        {
                            <button class="lw-btn-sm @(line.YCloudWebhookConfigurado ? "" : "warn")" title="@(line.YCloudWebhookConfigurado ? "Webhook de entrada configurado" : "Configura el webhook para recibir mensajes")" @onclick="() => AbrirWebhookAsync(line)" disabled="@_busy">@(line.YCloudWebhookConfigurado ? "Webhook ✓" : "Webhook")</button>
                        }
                        <button class="lw-btn-sm" @onclick="() => RefrescarAsync(line.Id)" disabled="@_busy">Actualizar</button>
                        @if (conn)
                        {
                            <button class="lw-btn-sm" @onclick="() => DesconectarAsync(line.Id)" disabled="@_busy">Desconectar</button>
                        }
                        <button class="lw-btn-sm danger" @onclick="() => AbrirEliminar(line)" disabled="@_busy">Eliminar</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ---- Modal crear ---- *@
@if (_showCrear)
{
    <div class="lw-ov" @onclick="() => _showCrear = false">
        <div class="lw-modal" @onclick:stopPropagation="true">
            <h5>Nueva linea WhatsApp</h5>
            @if (!string.IsNullOrEmpty(_crearError)) { <div class="lw-err">@_crearError</div> }
            <div class="lw-fld">
                <label>Proveedor</label>
                <select class="lw-input" @bind="_crear.Provider">
                    <option value="@WhatsAppProvider.Evolution">Evolution (QR, no oficial)</option>
                    <option value="@WhatsAppProvider.Cloud">WhatsApp Cloud API (Meta oficial)</option>
                    <option value="@WhatsAppProvider.YCloud">YCloud (BSP oficial)</option>
                </select>
            </div>
            <div class="lw-fld">
                <label>Nombre de la instancia</label>
                <input class="lw-input" @bind="_crear.InstanceName" @bind:event="oninput" placeholder="Ej. Portería principal" />
            </div>
            <div class="lw-fld">
                <label>Número (opcional)</label>
                <input class="lw-input" @bind="_crear.PhoneNumber" @bind:event="oninput" placeholder="+57 300 000 0000" />
            </div>
            @if (_crear.Provider == WhatsAppProvider.Cloud)
            {
                <div class="lw-fld">
                    <label>Phone Number ID (Meta) *</label>
                    <input class="lw-input" @bind="_crear.CloudPhoneNumberId" @bind:event="oninput" placeholder="Ej. 123456789012345" />
                </div>
                <div class="lw-fld">
                    <label>WhatsApp Business Account ID (opcional)</label>
                    <input class="lw-input" @bind="_crear.CloudBusinessAccountId" @bind:event="oninput" />
                </div>
                <div class="lw-fld">
                    <label>Access Token (Meta) *</label>
                    <input class="lw-input" type="password" @bind="_crear.CloudAccessToken" @bind:event="oninput" placeholder="EAAG..." />
                </div>
                <div class="lw-fld">
                    <label>Verify Token del webhook (opcional)</label>
                    <input class="lw-input" @bind="_crear.CloudWebhookVerifyToken" @bind:event="oninput" />
                </div>
            }
            @if (_crear.Provider == WhatsAppProvider.YCloud)
            {
                <div class="lw-fld">
                    <label>API Key de YCloud *</label>
                    <input class="lw-input" type="password" @bind="_crear.YCloudApiKey" @bind:event="oninput" placeholder="xxxxxxxx..." />
                </div>
                <div class="lw-fld">
                    <label>Número remitente (con código de pais, sin +) *</label>
                    <input class="lw-input" @bind="_crear.YCloudFromNumber" @bind:event="oninput" placeholder="573000000000" />
                </div>
                <p class="lw-sub" style="margin:-4px 0 6px;font-size:12px">Sin QR: al "Validar" se verifica la API key contra YCloud.</p>

                @* Webhook que atendera la linea: la URL universal (enruta por el numero) y, si ya lo tiene, el secreto. *@
                <div class="lw-webhook-box">
                    <div class="lw-webhook-t">Webhook de entrada de esta línea</div>
                    <div class="lw-hint" style="margin:0 0 8px">Sin el webhook la línea solo envía: los mensajes que lleguen por YCloud no entran a PROPIA.</div>
                    <div class="lw-fld">
                        <label>URL del webhook (cópiala en YCloud) · la misma para todos los números</label>
                        <div style="display:flex;gap:6px">
                            <input class="lw-input" readonly value="@WebhookUrlUniversal" />
                            <button type="button" class="lw-btn-ghost" @onclick="() => CopiarTextoAsync(WebhookUrlUniversal)">@(_copiadoCrear ? "Copiada" : "Copiar")</button>
                        </div>
                        @if (EsLocal) { <div class="lw-hint" style="margin-top:6px">Estás en un entorno local: YCloud no alcanza esta dirección. Configura el webhook desde la app publicada.</div> }
                    </div>
                    <ol class="lw-pasos">
                        <li>En YCloud, <b>Developers &gt; Webhooks</b>: crea un endpoint con esa URL (si tu cuenta ya tiene uno con esta URL, sirve el mismo).</li>
                        <li>Activa los eventos <b>whatsapp.inbound_message.received</b> y <b>whatsapp.message.updated</b>.</li>
                        <li>Copia el <b>secreto</b> (signing secret) del endpoint y pégalo aquí.</li>
                    </ol>
                    <div class="lw-fld" style="margin-bottom:0">
                        <label>Secreto del endpoint (puedes agregarlo después en el botón Webhook de la línea)</label>
                        <input class="lw-input" type="password" autocomplete="off" @bind="_crearSecreto" @bind:event="oninput" placeholder="whsec_..." />
                    </div>
                </div>
            }
            <div class="lw-modal-foot">
                <button class="lw-btn-ghost" @onclick="() => _showCrear = false">Cancelar</button>
                <button class="lw-btn-primary" @onclick="CrearAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_crear.InstanceName) || (_crear.Provider == WhatsAppProvider.Cloud && (string.IsNullOrWhiteSpace(_crear.CloudPhoneNumberId) || string.IsNullOrWhiteSpace(_crear.CloudAccessToken))) || (_crear.Provider == WhatsAppProvider.YCloud && (string.IsNullOrWhiteSpace(_crear.YCloudApiKey) || string.IsNullOrWhiteSpace(_crear.YCloudFromNumber))))">Crear</button>
            </div>
        </div>
    </div>
}

@* ---- Modal QR ---- *@
@if (_showQr)
{
    <div class="lw-ov" @onclick="() => _showQr = false">
        <div class="lw-modal" style="text-align:center" @onclick:stopPropagation="true">
            <h5>Escanea el código QR</h5>
            @if (!string.IsNullOrEmpty(_qr))
            {
                <img src="@QrSrc(_qr)" alt="QR" style="max-width:280px;margin:0 auto;border-radius:10px" />
                <p class="lw-sub" style="margin-top:12px">WhatsApp &gt; Dispositivos vinculados &gt; Vincular un dispositivo. Luego pulsa "Refrescar".</p>
            }
            else
            {
                <p class="lw-sub">@(_qrError ?? "No se recibio el QR. Intenta de nuevo.")</p>
            }
            <div class="lw-modal-foot" style="justify-content:center">
                <button class="lw-btn-ghost" @onclick="() => _showQr = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ---- Modal probar envio ---- *@
@if (_showProbar)
{
    <div class="lw-ov" @onclick="() => _showProbar = false">
        <div class="lw-modal" @onclick:stopPropagation="true">
            <h5>Enviar mensaje de prueba</h5>
            @if (!string.IsNullOrEmpty(_probarMsg)) { <div class="@(_probarMsgClass == "alert-success" ? "lw-ok" : "lw-err")">@_probarMsg</div> }
            <div class="lw-fld">
                <label>Número destino (con código de pais)</label>
                <input class="lw-input" @bind="_probarPhone" @bind:event="oninput" placeholder="573000000000" />
            </div>
            <div class="lw-fld">
                <label>Mensaje</label>
                <textarea class="lw-input" rows="3" @bind="_probarText" @bind:event="oninput"></textarea>
            </div>
            <div class="lw-modal-foot">
                <button class="lw-btn-ghost" @onclick="() => _showProbar = false">Cerrar</button>
                <button class="lw-btn-primary" @onclick="ProbarEnvioAsync" disabled="@_busy">Enviar</button>
            </div>
        </div>
    </div>
}

@* ---- Modal webhook de entrada (YCloud) ---- *@
@if (_showWebhook && _webhookLine is not null)
{
    <div class="lw-ov" @onclick="() => _showWebhook = false">
        <div class="lw-modal" style="width:min(560px,96vw)" @onclick:stopPropagation="true">
            <h5>Webhook de entrada · @_webhookLine.InstanceName</h5>
            <div class="lw-hint">Sin el webhook la línea solo envía: los mensajes que llegan por YCloud (respuestas de residentes y de los agentes) no entran a PROPIA.</div>
            @if (!string.IsNullOrEmpty(_webhookMsg)) { <div class="@(_webhookOk ? "lw-ok" : "lw-err")">@_webhookMsg</div> }
            <div class="lw-fld">
                <label>1. URL del webhook (cópiala en YCloud) · es la misma para todas las copropiedades y números</label>
                <div style="display:flex;gap:6px">
                    <input class="lw-input" readonly value="@_webhookUrl" />
                    <button class="lw-btn-ghost" @onclick="CopiarUrlAsync">@(_copiado ? "Copiada" : "Copiar")</button>
                </div>
                @if (_webhookLocal) { <div class="lw-hint" style="margin-top:6px">Estás en un entorno local: YCloud no alcanza esta dirección. Configura el webhook desde la app publicada.</div> }
            </div>
            <ol class="lw-pasos">
                <li>En YCloud entra a <b>Developers &gt; Webhooks</b> y crea un endpoint con esa URL (uno por cuenta de YCloud: si tu cuenta tiene varios números o los usan varias copropiedades, sirve el mismo; PROPIA reconoce la copropiedad por el número).</li>
                <li>Activa los eventos <b>whatsapp.inbound_message.received</b> y <b>whatsapp.message.updated</b>.</li>
                <li>Copia el <b>secreto</b> (signing secret) del endpoint y pégalo aquí, en cada línea de esa cuenta.</li>
            </ol>
            <div class="lw-fld">
                <label>2. Secreto del endpoint @(_webhookLine.YCloudWebhookConfigurado ? "(ya hay uno guardado: escribe otro para cambiarlo)" : "")</label>
                <input class="lw-input" type="password" autocomplete="off" @bind="_webhookSecreto" @bind:event="oninput" placeholder="whsec_..." />
            </div>
            <div class="lw-modal-foot">
                @if (_webhookLine.YCloudWebhookConfigurado) { <button class="lw-btn-ghost" style="margin-right:auto" @onclick="() => GuardarWebhookAsync(true)" disabled="@_busy">Quitar secreto</button> }
                <button class="lw-btn-ghost" @onclick="() => _showWebhook = false">Cerrar</button>
                <button class="lw-btn-primary" @onclick="() => GuardarWebhookAsync(false)" disabled="@(_busy || string.IsNullOrWhiteSpace(_webhookSecreto))">Guardar secreto</button>
            </div>
        </div>
    </div>
}

@* ---- Modal eliminar ---- *@
@if (_showEliminar && _eliminarLine is not null)
{
    <div class="lw-ov" @onclick="() => _showEliminar = false">
        <div class="lw-modal" @onclick:stopPropagation="true">
            <h5>Eliminar linea</h5>
            @if (!string.IsNullOrEmpty(_eliminarError)) { <div class="lw-err">@_eliminarError</div> }
            <p class="lw-sub" style="margin:0 0 6px">
                Vas a eliminar la linea <b>@_eliminarLine.InstanceName</b> por completo. Esto borra su instancia
                en el servidor de WhatsApp y su vinculo con el agente. Las conversaciones se conservan (quedan sin linea).
            </p>
            <p class="lw-sub" style="margin:0">Esta accion no se puede deshacer.</p>
            <div class="lw-modal-foot">
                <button class="lw-btn-ghost" @onclick="() => _showEliminar = false" disabled="@_busy">Cancelar</button>
                <button class="lw-btn-sm danger" style="padding:9px 16px;font-size:12.5px" @onclick="EliminarAsync" disabled="@_busy">Eliminar linea</button>
            </div>
        </div>
    </div>
}

<style>
    /* Canon margen lateral (= Unidades): sin padding horizontal propio ni max-width/centrado. */
    .lw-wrap { width:100%; max-width:none; margin:0; padding:6px 0 60px; box-sizing:border-box; font-family:'Lexend',-apple-system,sans-serif; animation:fadeUp .2s ease; }
    .lw-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:18px; flex-wrap:wrap; }
    .lw-h1 { font-size:27px; font-weight:800; letter-spacing:-.6px; color:var(--propia-text-h1); margin:0; }
    .lw-sub { font-size:14px; color:var(--propia-text-muted); margin:4px 0 0; }
    .lw-btn-primary { display:inline-flex; align-items:center; justify-content:center; gap:7px; padding:10px 16px; border-radius:10px; background:var(--propia-brand); color: var(--propia-text-inverse); font-size:13px; font-weight:700; border:none; cursor:pointer; box-shadow:0 6px 16px rgba(109,79,227,.3); }
    .lw-btn-primary:hover { background:var(--propia-brand-hover); }
    .lw-btn-primary:disabled { opacity:.5; cursor:not-allowed; }
    .lw-warn { display:flex; gap:10px; align-items:center; background:var(--propia-bg-card)8E9; border:1px solid #F3E2B8; color:#7A5B12; border-radius:12px; padding:12px 16px; font-size:13px; margin-bottom:16px; }
    .lw-err { display:flex; align-items:center; background:var(--propia-danger-soft); border:1px solid #F5C8CB; color:#A12B30; border-radius:12px; padding:11px 14px; font-size:12.5px; margin-bottom:12px; }
    .lw-ok { background:var(--propia-ok-soft); border:1px solid #BFE8CF; color:#15703F; border-radius:12px; padding:11px 14px; font-size:12.5px; margin-bottom:12px; }
