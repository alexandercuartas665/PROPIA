@page "/ia/lineas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.InfraestructuraIa
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Lineas WhatsApp - PROPIA</PageTitle>

@* Infraestructura IA (Capa 2): lineas WhatsApp de la copropiedad. Portado de CUBOT.travels,
   re-estilizado a la plantilla PROPIA (Lexend / morado). Conexion contra el servidor Evolution maestro. *@

@if (!_authChecked)
{
    <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div>
    return;
}

@if (string.IsNullOrEmpty(_jwt))
{
    <AuthMessage />
    return;
}

<div class="lw-wrap">
    <div class="lw-head">
        <div>
            <h1 class="lw-h1">Lineas <span style="color:#6D4FE3">WhatsApp</span></h1>
            <p class="lw-sub">Conecta numeros de WhatsApp para atender a los residentes de la copropiedad.</p>
        </div>
        <button class="lw-btn-primary" @onclick="() => _showCrear = true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"></path></svg>
            Nueva linea
        </button>
    </div>

    @if (_serverReady == false)
    {
        <div class="lw-warn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
            <span>El servidor Evolution (WhatsApp) aun no esta configurado a nivel plataforma. Un administrador de A&amp;D GROUP debe configurarlo en la consola SuperAdmin antes de conectar lineas.</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="lw-err">@_loadError <button class="lw-btn-sm" style="margin-left:8px" @onclick="CargarAsync">Reintentar</button></div>
    }
    @if (!string.IsNullOrEmpty(_info))
    {
        <div class="lw-ok">@_info</div>
    }

    @if (_lineas is not null)
    {
        <div class="lw-kpis">
            <div class="lw-kpi">
                <div class="lw-kpi-ic"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="5" y="2" width="14" height="20" rx="2"></rect><path d="M11 18h2"></path></svg></div>
                <div><div class="lw-kpi-l">LINEAS</div><div class="lw-kpi-n">@_lineas.Count</div><div class="lw-kpi-s">Total registradas</div></div>
            </div>
            <div class="lw-kpi">
                <div class="lw-kpi-ic ok"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"></path></svg></div>
                <div><div class="lw-kpi-l">CONECTADAS</div><div class="lw-kpi-n" style="color:#1A8754">@_lineas.Count(l => l.Status == WhatsAppLineStatus.Connected)</div><div class="lw-kpi-s">En linea</div></div>
            </div>
            <div class="lw-kpi">
                <div class="lw-kpi-ic warn"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></div>
                <div><div class="lw-kpi-l">PENDIENTES</div><div class="lw-kpi-n" style="color:#E8910C">@_lineas.Count(l => l.Status != WhatsAppLineStatus.Connected)</div><div class="lw-kpi-s">Por conectar</div></div>
            </div>
        </div>

        <details class="lw-adv">
            <summary><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg><strong>Avanzado</strong> <span>Servidor y webhook de WhatsApp</span></summary>
            <div class="lw-adv-body">
                <div class="lw-adv-row"><span>Servidor Evolution maestro</span><b style="color:@(_serverReady == true ? "#15703F" : "#A12B30")">@(_serverReady == true ? "Configurado y listo" : "No configurado")</b></div>
                <div class="lw-adv-note">El servidor Evolution (no oficial) y el webhook se administran a nivel plataforma en la consola SuperAdmin (A&amp;D GROUP). Las lineas Cloud (Meta) usan su propio Access Token por linea.</div>
            </div>
        </details>
    }

    @if (_lineas is null)
    {
        <div class="lw-empty"><div class="spinner-border" style="color:#6D4FE3"></div></div>
    }
    else if (_lineas.Count == 0)
    {
        <div class="lw-empty">
            <div class="lw-empty-ic">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#6D4FE3" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            </div>
            Aun no hay lineas conectadas. Crea la primera con <b>"Nueva linea"</b>.
        </div>
    }
    else
    {
        <div class="lw-tablecard">
            <table class="lw-table">
                <thead><tr><th>LINEA</th><th>TELEFONO</th><th>ESTADO</th><th>ULTIMA CONEXION</th><th></th></tr></thead>
                <tbody>
                    @foreach (var l in _lineas)
                    {
                        var line = l;
                        <tr>
                            <td>
                                <div class="lw-td-nom">@line.InstanceName</div>
                                <span class="lw-prov">@(line.Provider == WhatsAppProvider.Cloud ? "CLOUD (META)" : "EVOLUTION")</span>
                            </td>
                            <td class="lw-td-mut">@(string.IsNullOrWhiteSpace(line.PhoneNumber) ? "-" : line.PhoneNumber)</td>
                            <td><span class="lw-badge" style="@StatusBadgeStyle(line.Status)">@StatusLabel(line.Status)</span></td>
                            <td class="lw-td-mut">@(line.LastConnectedAt is null ? "-" : line.LastConnectedAt.Value.ToLocalTime().ToString("dd MMM HH:mm"))</td>
                            <td class="lw-row-actions">
                                @if (line.Status != WhatsAppLineStatus.Connected)
                                {
                                    <button class="lw-btn-sm dark" @onclick="() => ConectarAsync(line)" disabled="@_busy">@(line.Provider == WhatsAppProvider.Cloud ? "Validar" : "Conectar / QR")</button>
                                }
                                <button class="lw-btn-sm @(line.Status == WhatsAppLineStatus.Connected ? "dark" : "")" @onclick="() => AbrirProbar(line.Id)">Probar envio</button>
                                <button class="lw-btn-sm" @onclick="() => RefrescarAsync(line.Id)" disabled="@_busy">Actualizar</button>
                                @if (line.Status == WhatsAppLineStatus.Connected)
                                {
                                    <button class="lw-btn-sm" @onclick="() => DesconectarAsync(line.Id)" disabled="@_busy">Desconectar</button>
                                }
                                <button class="lw-btn-sm danger" @onclick="() => AbrirEliminar(line)" disabled="@_busy">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ---- Modal crear ---- *@
@if (_showCrear)
{
    <div class="lw-ov" @onclick="() => _showCrear = false">
        <div class="lw-modal" @onclick:stopPropagation="true">
            <h5>Nueva linea WhatsApp</h5>
            @if (!string.IsNullOrEmpty(_crearError)) { <div class="lw-err">@_crearError</div> }
            <div class="lw-fld">
                <label>Proveedor</label>
                <select class="lw-input" @bind="_crear.Provider">
                    <option value="@WhatsAppProvider.Evolution">Evolution (QR, no oficial)</option>
                    <option value="@WhatsAppProvider.Cloud">WhatsApp Cloud API (Meta oficial)</option>
                </select>
            </div>
            <div class="lw-fld">
                <label>Nombre de la instancia</label>
                <input class="lw-input" @bind="_crear.InstanceName" @bind:event="oninput" placeholder="Ej. Porteria principal" />
            </div>
            <div class="lw-fld">
                <label>Numero (opcional)</label>
                <input class="lw-input" @bind="_crear.PhoneNumber" @bind:event="oninput" placeholder="+57 300 000 0000" />
            </div>
            @if (_crear.Provider == WhatsAppProvider.Cloud)
            {
                <div class="lw-fld">
                    <label>Phone Number ID (Meta) *</label>
                    <input class="lw-input" @bind="_crear.CloudPhoneNumberId" @bind:event="oninput" placeholder="Ej. 123456789012345" />
                </div>
                <div class="lw-fld">
                    <label>WhatsApp Business Account ID (opcional)</label>
                    <input class="lw-input" @bind="_crear.CloudBusinessAccountId" @bind:event="oninput" />
                </div>
                <div class="lw-fld">
                    <label>Access Token (Meta) *</label>
                    <input class="lw-input" type="password" @bind="_crear.CloudAccessToken" @bind:event="oninput" placeholder="EAAG..." />
                </div>
                <div class="lw-fld">
                    <label>Verify Token del webhook (opcional)</label>
                    <input class="lw-input" @bind="_crear.CloudWebhookVerifyToken" @bind:event="oninput" />
                </div>
            }
            <div class="lw-modal-foot">
                <button class="lw-btn-ghost" @onclick="() => _showCrear = false">Cancelar</button>
                <button class="lw-btn-primary" @onclick="CrearAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_crear.InstanceName) || (_crear.Provider == WhatsAppProvider.Cloud && (string.IsNullOrWhiteSpace(_crear.CloudPhoneNumberId) || string.IsNullOrWhiteSpace(_crear.CloudAccessToken))))">Crear</button>
            </div>
        </div>
    </div>
}

@* ---- Modal QR ---- *@
@if (_showQr)
{
    <div class="lw-ov" @onclick="() => _showQr = false">
        <div class="lw-modal" style="text-align:center" @onclick:stopPropagation="true">
            <h5>Escanea el codigo QR</h5>
            @if (!string.IsNullOrEmpty(_qr))
            {
                <img src="@QrSrc(_qr)" alt="QR" style="max-width:280px;margin:0 auto;border-radius:10px" />
                <p class="lw-sub" style="margin-top:12px">WhatsApp &gt; Dispositivos vinculados &gt; Vincular un dispositivo. Luego pulsa "Refrescar".</p>
            }
            else
            {
                <p class="lw-sub">@(_qrError ?? "No se recibio el QR. Intenta de nuevo.")</p>
            }
            <div class="lw-modal-foot" style="justify-content:center">
                <button class="lw-btn-ghost" @onclick="() => _showQr = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ---- Modal probar envio ---- *@
@if (_showProbar)
{
    <div class="lw-ov" @onclick="() => _showProbar = false">
        <div class="lw-modal" @onclick:stopPropagation="true">
            <h5>Enviar mensaje de prueba</h5>
            @if (!string.IsNullOrEmpty(_probarMsg)) { <div class="@(_probarMsgClass == "alert-success" ? "lw-ok" : "lw-err")">@_probarMsg</div> }
            <div class="lw-fld">
                <label>Numero destino (con codigo de pais)</label>
                <input class="lw-input" @bind="_probarPhone" @bind:event="oninput" placeholder="573000000000" />
            </div>
            <div class="lw-fld">
                <label>Mensaje</label>
                <textarea class="lw-input" rows="3" @bind="_probarText" @bind:event="oninput"></textarea>
            </div>
            <div class="lw-modal-foot">
                <button class="lw-btn-ghost" @onclick="() => _showProbar = false">Cerrar</button>
                <button class="lw-btn-primary" @onclick="ProbarEnvioAsync" disabled="@_busy">Enviar</button>
            </div>
        </div>
    </div>
}

@* ---- Modal eliminar ---- *@
@if (_showEliminar && _eliminarLine is not null)
{
    <div class="lw-ov" @onclick="() => _showEliminar = false">
        <div class="lw-modal" @onclick:stopPropagation="true">
            <h5>Eliminar linea</h5>
            @if (!string.IsNullOrEmpty(_eliminarError)) { <div class="lw-err">@_eliminarError</div> }
            <p class="lw-sub" style="margin:0 0 6px">
                Vas a eliminar la linea <b>@_eliminarLine.InstanceName</b> por completo. Esto borra su instancia
                en el servidor de WhatsApp y su vinculo con el agente. Las conversaciones se conservan (quedan sin linea).
            </p>
            <p class="lw-sub" style="margin:0">Esta accion no se puede deshacer.</p>
            <div class="lw-modal-foot">
                <button class="lw-btn-ghost" @onclick="() => _showEliminar = false" disabled="@_busy">Cancelar</button>
                <button class="lw-btn-sm danger" style="padding:9px 16px;font-size:12.5px" @onclick="EliminarAsync" disabled="@_busy">Eliminar linea</button>
            </div>
        </div>
    </div>
}

<style>
    .lw-wrap { width:100%; max-width:1700px; margin:0 auto; padding:6px 28px 60px; box-sizing:border-box; font-family:'Lexend',-apple-system,sans-serif; animation:fadeUp .2s ease; }
    .lw-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:18px; flex-wrap:wrap; }
    .lw-h1 { font-size:27px; font-weight:800; letter-spacing:-.6px; color:#1B2A3A; margin:0; }
    .lw-sub { font-size:14px; color:#7C98B6; margin:4px 0 0; }
    .lw-btn-primary { display:inline-flex; align-items:center; justify-content:center; gap:7px; padding:10px 16px; border-radius:10px; background:#6D4FE3; color:#fff; font-size:13px; font-weight:700; border:none; cursor:pointer; box-shadow:0 6px 16px rgba(109,79,227,.3); }
    .lw-btn-primary:hover { background:#5838C9; }
    .lw-btn-primary:disabled { opacity:.5; cursor:not-allowed; }
    .lw-warn { display:flex; gap:10px; align-items:center; background:#FFF8E9; border:1px solid #F3E2B8; color:#7A5B12; border-radius:12px; padding:12px 16px; font-size:13px; margin-bottom:16px; }
    .lw-err { display:flex; align-items:center; background:#FDE7E7; border:1px solid #F5C8CB; color:#A12B30; border-radius:12px; padding:11px 14px; font-size:12.5px; margin-bottom:12px; }
    .lw-ok { background:#E6F6EE; border:1px solid #BFE8CF; color:#15703F; border-radius:12px; padding:11px 14px; font-size:12.5px; margin-bottom:12px; }
    .lw-empty { background:#fff; border:1px dashed #D7E0EA; border-radius:14px; padding:44px 24px; text-align:center; color:#7C98B6; font-size:13px; }
    .lw-empty-ic { width:54px; height:54px; border-radius:14px; background:#F1ECFD; display:flex; align-items:center; justify-content:center; margin:0 auto 12px; }
    .lw-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(330px,1fr)); gap:14px; }
    .lw-card { background:#fff; border:1px solid #E1E8EE; border-radius:14px; box-shadow:0 1px 2px rgba(45,62,80,.05); padding:16px 18px; }
    .lw-card-top { display:flex; align-items:center; gap:9px; margin-bottom:11px; }
    .lw-ic { width:36px; height:36px; border-radius:10px; background:#E6F6EE; color:#1FAE54; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .lw-card-nom { font-size:14px; font-weight:800; color:#1B2A3A; flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .lw-badge { font-size:10.5px; font-weight:800; padding:3px 9px; border-radius:7px; flex-shrink:0; }
    .lw-meta { font-size:12px; color:#7C98B6; line-height:1.6; margin-bottom:13px; }
    .lw-actions { display:flex; flex-wrap:wrap; gap:7px; }
    .lw-btn-sm { font-size:11.5px; font-weight:700; padding:6px 11px; border-radius:8px; border:1px solid #E1E8EE; background:#fff; color:#516F90; cursor:pointer; }
    .lw-btn-sm:hover { border-color:#6D4FE3; color:#6D4FE3; }
    .lw-btn-sm:disabled { opacity:.5; cursor:not-allowed; }
    .lw-btn-sm.dark { background:#6D4FE3; color:#fff; border-color:#6D4FE3; }
    .lw-btn-sm.dark:hover { background:#5838C9; color:#fff; }
    .lw-btn-sm.danger { color:#C0383C; border-color:#F5C8CB; margin-left:auto; }
    .lw-btn-sm.danger:hover { background:#FDE7E7; }
    .lw-ov { position:fixed; inset:0; z-index:81; background:rgba(27,42,58,.6); display:flex; align-items:center; justify-content:center; padding:24px; }
    .lw-modal { width:min(460px,96vw); background:#fff; border-radius:16px; box-shadow:0 30px 70px rgba(27,42,58,.45); padding:22px 24px; }
    .lw-modal h5 { font-size:17px; font-weight:800; color:#1B2A3A; margin:0 0 14px; }
    .lw-fld { margin-bottom:12px; }
    .lw-fld label { font-size:11px; font-weight:700; color:#7C98B6; display:block; margin-bottom:5px; }
    .lw-input { width:100%; border:1px solid #E1E8EE; border-radius:9px; padding:9px 12px; font-size:13px; color:#33475B; outline:none; box-sizing:border-box; font-family:inherit; }
    .lw-input:focus { border-color:#6D4FE3; }
    .lw-modal-foot { display:flex; gap:8px; justify-content:flex-end; margin-top:6px; }
    .lw-btn-ghost { font-size:12.5px; font-weight:700; padding:9px 14px; border-radius:9px; border:1px solid #E1E8EE; background:#fff; color:#516F90; cursor:pointer; }
    .lw-btn-ghost:hover { border-color:#C3D0DD; }

    /* KPIs + Avanzado + tabla (estilo dashboard del hermano) */
    .lw-kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:14px; }
    .lw-kpi { background:#fff; border:1px solid #E1E8EE; border-radius:14px; padding:16px 18px; box-shadow:0 1px 2px rgba(45,62,80,.05); display:flex; align-items:center; gap:13px; }
    .lw-kpi-ic { width:42px; height:42px; border-radius:11px; background:#F1ECFD; color:#6D4FE3; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .lw-kpi-ic.ok { background:#E6F6EE; color:#1A8754; }
    .lw-kpi-ic.warn { background:#FFF4E2; color:#E8910C; }
    .lw-kpi-l { font-size:11px; font-weight:700; letter-spacing:.4px; color:#A6B7C8; }
    .lw-kpi-n { font-size:26px; font-weight:800; letter-spacing:-1px; color:#1B2A3A; line-height:1.1; }
    .lw-kpi-s { font-size:11px; color:#7C98B6; }
    .lw-adv { background:#fff; border:1px solid #E1E8EE; border-radius:12px; margin-bottom:14px; }
    .lw-adv summary { display:flex; align-items:center; gap:8px; padding:12px 16px; cursor:pointer; font-size:13px; color:#516F90; list-style:none; }
    .lw-adv summary::-webkit-details-marker { display:none; }
    .lw-adv summary strong { color:#1B2A3A; }
    .lw-adv summary span { color:#A6B7C8; font-size:12px; }
    .lw-adv-body { padding:0 16px 14px; }
    .lw-adv-row { display:flex; justify-content:space-between; align-items:center; font-size:13px; color:#516F90; padding:8px 0; border-top:1px solid #F4F7FA; }
    .lw-adv-note { font-size:12px; color:#7C98B6; line-height:1.5; margin-top:6px; }
    .lw-tablecard { background:#fff; border:1px solid #E1E8EE; border-radius:14px; box-shadow:0 1px 2px rgba(45,62,80,.05); overflow-x:auto; }
    .lw-table { width:100%; border-collapse:collapse; font-size:13px; min-width:640px; }
    .lw-table thead th { text-align:left; font-size:10.5px; letter-spacing:.4px; font-weight:700; color:#A6B7C8; padding:12px 16px; background:#F8FAFC; border-bottom:1px solid #EEF3F8; }
    .lw-table tbody td { padding:12px 16px; border-bottom:1px solid #F4F7FA; color:#33475B; vertical-align:middle; }
    .lw-table tbody tr:last-child td { border-bottom:none; }
    .lw-table tbody tr:hover { background:#FAFBFD; }
    .lw-td-nom { font-size:13.5px; font-weight:700; color:#1B2A3A; margin-bottom:3px; }
    .lw-td-mut { color:#7C98B6; }
    .lw-prov { font-size:9.5px; font-weight:800; letter-spacing:.4px; color:#6D4FE3; background:#F1ECFD; padding:2px 7px; border-radius:5px; }
    .lw-row-actions { display:flex; gap:7px; justify-content:flex-end; flex-wrap:wrap; }
    @@media (max-width:760px) { .lw-kpis { grid-template-columns:1fr; } }
</style>

@code {
    private string? _jwt;
    private bool _authChecked;
    private bool _busy;
    private bool? _serverReady;
    private string? _loadError;
    private string? _info;

    private List<WhatsAppLineDto>? _lineas;

    private bool _showCrear;
    private LineForm _crear = new();
    private string? _crearError;

    private bool _showQr;
    private string? _qr;
    private string? _qrError;

    private bool _showProbar;
    private Guid _probarLineId;
    private string _probarPhone = "";
    private string _probarText = "Mensaje de prueba desde PROPIA.";
    private string? _probarMsg;
    private string _probarMsgClass = "alert-info";

    private bool _showEliminar;
    private WhatsAppLineDto? _eliminarLine;
    private string? _eliminarError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            _authChecked = true;
            if (!string.IsNullOrWhiteSpace(stored))
            {
                _jwt = stored;
                await CargarServidorAsync();
                await CargarAsync();
                StateHasChanged();
            }
        }
        catch { /* prerender */ }
    }

    private async Task CargarServidorAsync()
    {
        try
        {
            var r = await Auth().GetFromJsonAsync<ServerReady>("/api/ia/lineas/servidor-listo");
            _serverReady = r?.Ready;
        }
        catch { _serverReady = null; }
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            var resp = await http.GetAsync("/api/ia/lineas");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevoJwt = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (string.IsNullOrEmpty(nuevoJwt)) return;
                _jwt = nuevoJwt;
                http = Auth();
                resp = await http.GetAsync("/api/ia/lineas");
            }
            resp.EnsureSuccessStatusCode();
            _lineas = await resp.Content.ReadFromJsonAsync<List<WhatsAppLineDto>>() ?? new();
            _loadError = null;
        }
        catch (Exception ex) { _loadError = ex.Message; }
    }

    private async Task CrearAsync()
    {
        _crearError = null;
        _busy = true;
        try
        {
            var req = new CreateWhatsAppLineRequest(_crear.InstanceName, _crear.PhoneNumber, _crear.Provider,
                _crear.CloudPhoneNumberId, _crear.CloudBusinessAccountId, _crear.CloudAccessToken, _crear.CloudWebhookVerifyToken);
            var resp = await Auth().PostAsJsonAsync("/api/ia/lineas", req);
            if (!resp.IsSuccessStatusCode)
            {
                _crearError = await ErrorMsg(resp);
                return;
            }
            _showCrear = false;
            _crear = new();
            await CargarAsync();
        }
        catch (Exception ex) { _crearError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConectarAsync(WhatsAppLineDto line)
    {
        _busy = true; _qr = null; _qrError = null; _info = null;
        try
        {
            var resp = await Auth().PostAsync($"/api/ia/lineas/{line.Id}/conectar", null);
            var r = await resp.Content.ReadFromJsonAsync<LineConnectResult>();
            if (line.Provider == WhatsAppProvider.Cloud)
            {
                // Cloud (Meta) no usa QR: el connect valida el token contra Graph.
                if (r?.Ok == true) { _info = "Linea Cloud validada y conectada con Meta."; }
                else { _loadError = r?.Error ?? "No se pudo validar el token de Meta."; }
            }
            else
            {
                _qr = r?.QrBase64;
                _qrError = r?.Error;
                _showQr = true;
            }
            await CargarAsync();
        }
        catch (Exception ex)
        {
            if (line.Provider == WhatsAppProvider.Cloud) { _loadError = ex.Message; }
            else { _qrError = ex.Message; _showQr = true; }
        }
        finally { _busy = false; }
    }

    private async Task RefrescarAsync(Guid id)
    {
        _busy = true;
        try { await Auth().PostAsync($"/api/ia/lineas/{id}/refrescar", null); await CargarAsync(); }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DesconectarAsync(Guid id)
    {
        _busy = true;
        try { await Auth().PostAsync($"/api/ia/lineas/{id}/desconectar", null); await CargarAsync(); }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _busy = false; }
    }

    private void AbrirProbar(Guid id)
    {
        _probarLineId = id; _probarMsg = null; _showProbar = true;
    }

    private void AbrirEliminar(WhatsAppLineDto line)
    {
        _eliminarLine = line; _eliminarError = null; _showEliminar = true;
    }

    private async Task EliminarAsync()
    {
        if (_eliminarLine is null) return;
        _busy = true; _eliminarError = null;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/ia/lineas/{_eliminarLine.Id}");
            if (resp.IsSuccessStatusCode)
            {
                _showEliminar = false;
                _eliminarLine = null;
                await CargarAsync();
            }
            else { _eliminarError = await ErrorMsg(resp); }
        }
        catch (Exception ex) { _eliminarError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ProbarEnvioAsync()
    {
        _busy = true; _probarMsg = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/ia/lineas/{_probarLineId}/probar-envio",
                new { Phone = _probarPhone, Text = _probarText });
            var r = await resp.Content.ReadFromJsonAsync<LineSendResult>();
            if (r?.Ok == true) { _probarMsg = "Mensaje enviado."; _probarMsgClass = "alert-success"; }
            else { _probarMsg = r?.Error ?? "No se pudo enviar."; _probarMsgClass = "alert-danger"; }
        }
        catch (Exception ex) { _probarMsg = ex.Message; _probarMsgClass = "alert-danger"; }
        finally { _busy = false; }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    private static async Task<string> ErrorMsg(HttpResponseMessage resp)
    {
        try { var e = await resp.Content.ReadFromJsonAsync<ApiError>(); return e?.Error ?? $"HTTP {(int)resp.StatusCode}"; }
        catch { return $"HTTP {(int)resp.StatusCode}"; }
    }

    private static string QrSrc(string qr) => qr.StartsWith("data:") ? qr : $"data:image/png;base64,{qr}";

    private static string StatusLabel(WhatsAppLineStatus s) => s switch
    {
        WhatsAppLineStatus.Created => "Creada",
        WhatsAppLineStatus.Connecting => "Conectando",
        WhatsAppLineStatus.Connected => "Conectada",
        WhatsAppLineStatus.Disconnected => "Desconectada",
        WhatsAppLineStatus.Failed => "Error",
        WhatsAppLineStatus.Disabled => "Deshabilitada",
        _ => s.ToString()
    };

    private static string StatusBadgeStyle(WhatsAppLineStatus s) => s switch
    {
        WhatsAppLineStatus.Connected => "color:#15703F;background:#E6F6EE",
        WhatsAppLineStatus.Connecting => "color:#1D4ED8;background:#E0EAFF",
        WhatsAppLineStatus.Failed => "color:#A12B30;background:#FDE7E7",
        WhatsAppLineStatus.Disabled => "color:#516F90;background:#EEF3F8",
        _ => "color:#7C98B6;background:#F5F8FA"
    };

    private sealed class LineForm
    {
        public string InstanceName { get; set; } = "";
        public string? PhoneNumber { get; set; }
        public WhatsAppProvider Provider { get; set; } = WhatsAppProvider.Evolution;
        public string? CloudPhoneNumberId { get; set; }
        public string? CloudBusinessAccountId { get; set; }
        public string? CloudAccessToken { get; set; }
        public string? CloudWebhookVerifyToken { get; set; }
    }

    private sealed record ServerReady(bool Ready);
    private sealed record ApiError(string Error);
}
