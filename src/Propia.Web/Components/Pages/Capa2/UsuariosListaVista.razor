@* Vista Lista de Usuarios: filas con avatar, rol y ultimo acceso (equivalente a la
   Lista del Directorio). Es de lectura: para invitar en caliente esta la vista Tabla.
   Extraida de Usuarios.razor, que aporta las clases usr-*; aqui no va estilo propio. *@
@using Propia.Application.UsuariosAccesos
@using Propia.Domain.Enums

<div class="usr-table">
    <div class="usr-th">
        <div style="width:42px;flex-shrink:0"></div>
        <div style="width:280px;flex-shrink:0">USUARIO</div>
        <div style="flex:1">ROL</div>
        <div style="width:160px;flex-shrink:0">ULTIMO ACCESO</div>
        <div style="width:130px;flex-shrink:0;text-align:right"></div>
    </div>
    @foreach (var u in Usuarios)
    {
        var uu = u;
        <div class="usr-row">
            @if (!string.IsNullOrWhiteSpace(u.FotoUrl))
            {
                <img class="usr-av usr-av-img" src="@u.FotoUrl" alt="@u.NombreCompleto" />
            }
            else
            {
                <div class="usr-av">@Iniciales(u.NombreCompleto)</div>
            }
            <div style="width:280px;flex-shrink:0;min-width:0">
                <div class="usr-name">@u.NombreCompleto</div>
                <div class="usr-email">@(u.Email ?? "Sin correo")</div>
                <div class="usr-etq-row">
                    @if (!u.EnDirectorio)
                    {
                        <span class="usr-nodir">Sin Directorio</span>
                    }
                    @foreach (var gg in u.GruposGobierno)
                    {
                        <span class="usr-gob-tag">@gg</span>
                    }
                    @* Solo lectura: las etiquetas se asignan en el modal del usuario. *@
                    @foreach (var et in u.Etiquetas)
                    {
                        <span class="usr-etq-chip usr-etq-chip-sm" style="background:@ChipBg(et.Color);color:@(et.Color ?? "#6D4FE3");border-color:@(et.Color ?? "#DCD2F8")">
                            @et.Nombre
                        </span>
                    }
                </div>
            </div>
            <div style="flex:1"><span class="usr-rol">@u.RolNombre</span></div>
            <div style="width:160px;flex-shrink:0">
                @if (u.Estado == EstadoUsuarioTenant.Activo)
                {
                    <div style="font-size:12.5px;color:var(--propia-text-secondary);font-weight:600">@(u.UltimoAcceso?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "Sin registro")</div>
                    <div class="usr-email">@(u.TieneCuentaPropia ? "Con cuenta propia" : "Solo en directorio")</div>
                }
                else
                {
                    <span class="usr-badge-inact">Acceso revocado</span>
                }
            </div>
            <div style="width:130px;flex-shrink:0;text-align:right" class="d-flex gap-1 justify-content-end">
                @if (u.Estado == EstadoUsuarioTenant.Activo)
                {
                    <button class="usr-rowbtn" @onclick="() => OnEditar.InvokeAsync(uu)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        Editar
                    </button>
                }
                else
                {
                    <button class="usr-rowbtn" @onclick="() => OnReactivar.InvokeAsync(uu.UsuarioTenantId)">Reactivar</button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<UsuarioListaDto> Usuarios { get; set; } = new();
    [Parameter] public EventCallback<UsuarioListaDto> OnEditar { get; set; }
    [Parameter] public EventCallback<Guid> OnReactivar { get; set; }

    private static string Iniciales(string? nombre)
    {
        var n = (nombre ?? "").Trim();
        if (n.Length == 0) return "?";
        var partes = n.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var s = partes.Length >= 2 ? $"{partes[0][0]}{partes[1][0]}" : n[..Math.Min(2, n.Length)];
        return s.ToUpper();
    }

    private static string ChipBg(string? color)
        => string.IsNullOrWhiteSpace(color) ? "#F3EFFE" : color + "1A";
}
