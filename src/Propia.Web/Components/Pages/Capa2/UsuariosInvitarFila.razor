@* Fila de alta inline en la tabla de Usuarios: crea/encuentra la persona y la invita con un rol.
   Es UI "tonta": recolecta los datos y los emite; la pagina Usuarios hace el POST con su Auth(). *@
@using Propia.Application.UsuariosAccesos
@using Propia.Domain.Enums

<div class="usr-invrow">
    <div class="usr-inv-av">+</div>
    <div class="usr-inv-fields">
        <select class="usr-inv-inp usr-inv-doc" @bind="_d.TipoDocumento">
            <option value="@TipoDocumento.CC">CC</option>
            <option value="@TipoDocumento.CE">CE</option>
            <option value="@TipoDocumento.PA">PA</option>
            <option value="@TipoDocumento.TI">TI</option>
        </select>
        <input class="usr-inv-inp" placeholder="Documento" @bind="_d.Documento" @bind:event="oninput" @onkeydown="Key" />
        <input class="usr-inv-inp" placeholder="Nombres" @bind="_d.Nombres" @bind:event="oninput" @onkeydown="Key" />
        <input class="usr-inv-inp" placeholder="Apellidos" @bind="_d.Apellidos" @bind:event="oninput" @onkeydown="Key" />
        <select class="usr-inv-inp usr-inv-rol" @bind="_d.RolId">
            <option value="@Guid.Empty">Rol...</option>
            @foreach (var r in Roles.Where(r => r.Activo))
            {
                <option value="@r.Id">@r.Nombre</option>
            }
        </select>
    </div>
    <button class="usr-inv-add" @onclick="Invitar" disabled="@(_busy || !Valido)">@(_busy ? "..." : "+ Invitar")</button>
</div>

@code {
    [Parameter] public List<RolDto> Roles { get; set; } = new();
    [Parameter] public EventCallback<NuevoUsuarioInvitar> OnInvitar { get; set; }

    private bool _busy;
    private readonly Draft _d = new();

    private bool Valido =>
        !string.IsNullOrWhiteSpace(_d.Documento) &&
        !string.IsNullOrWhiteSpace(_d.Nombres) &&
        !string.IsNullOrWhiteSpace(_d.Apellidos) &&
        _d.RolId != Guid.Empty;

    private sealed class Draft
    {
        public TipoDocumento TipoDocumento = TipoDocumento.CC;
        public string Documento = "";
        public string Nombres = "";
        public string Apellidos = "";
        public Guid RolId = Guid.Empty;
        public void Reset() { TipoDocumento = TipoDocumento.CC; Documento = ""; Nombres = ""; Apellidos = ""; RolId = Guid.Empty; }
    }

    private async Task Key(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && Valido) await Invitar();
    }

    private async Task Invitar()
    {
        if (!Valido) return;
        _busy = true;
        try
        {
            await OnInvitar.InvokeAsync(new NuevoUsuarioInvitar(
                _d.TipoDocumento, _d.Documento.Trim(), _d.Nombres.Trim(), _d.Apellidos.Trim(), _d.RolId));
            _d.Reset();
        }
        finally { _busy = false; }
    }
}

<style>
    .usr-invrow { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: #FBFAFE; border-top: 1px dashed #DCD2F8; }
    .usr-inv-av { width: 42px; height: 42px; flex-shrink: 0; border-radius: 10px; border: 1.5px dashed #CBD6E2; color: var(--propia-primary, #6D4FE3); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 600; }
    .usr-inv-fields { display: grid; grid-template-columns: 76px 1fr 1.2fr 1.2fr 1.2fr; gap: 8px; flex: 1; min-width: 0; }
    .usr-inv-inp { width: 100%; border: 1px solid #E1E8EE; border-radius: 8px; padding: 8px 10px; font-size: 13px; color: #33475B; outline: none; font-family: inherit; box-sizing: border-box; background: #fff; }
    .usr-inv-inp:focus { border-color: var(--propia-primary, #6D4FE3); }
    .usr-inv-add { flex-shrink: 0; border: 1px solid var(--propia-primary, #6D4FE3); background: var(--propia-primary, #6D4FE3); color: #fff; font-size: 12.5px; font-weight: 600; padding: 9px 14px; border-radius: 8px; cursor: pointer; white-space: nowrap; font-family: inherit; }
    .usr-inv-add:disabled { opacity: .5; cursor: default; }
</style>
