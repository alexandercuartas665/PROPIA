    private async Task CargarCfgRAsync()
    {
        try
        {
            var cfg = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config?entidad=personas") ?? new();
            _cfgPer = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchosR();
        }
        catch { }
    }
    private async Task ToggleVisibleColR(string clave)
    {
        var visible = VisibleCol(clave);
        await GuardarCfgRAsync(FilaConfigR(clave) with { Oculto = visible });
        await CargarCfgRAsync(); StateHasChanged();
    }
    private async Task MoverColumnaR(string clave, int dir)
    {
        var keys = ClavesOrdenadas().ToList();
        var i = keys.IndexOf(clave); var j = i + dir;
        if (i <= 0 || j <= 0 || j >= keys.Count) return; // la 1a columna queda fija
        (keys[i], keys[j]) = (keys[j], keys[i]);
        for (int k = 0; k < keys.Count; k++) await GuardarCfgRAsync(FilaConfigR(keys[k]) with { Orden = k });
        await CargarCfgRAsync(); StateHasChanged();
    }
    private async Task OcultarTodasColR()
    {
        var keys = ClavesOrdenadas().ToList();
        for (int k = 0; k < keys.Count; k++)
        {
            if (k == 0) continue; // la 1a no se oculta
            await GuardarCfgRAsync(FilaConfigR(keys[k]) with { Oculto = true });
        }
        await CargarCfgRAsync(); StateHasChanged();
    }
    private async Task MostrarTodasColR()
    {
        foreach (var k in ClavesOrdenadas()) await GuardarCfgRAsync(FilaConfigR(k) with { Oculto = false });
        await CargarCfgRAsync(); StateHasChanged();
    }
    private async Task RestablecerColR()
    {
        foreach (var k in ClavesOrdenadas()) await GuardarCfgRAsync(FilaConfigR(k) with { Oculto = !VisibleColDefault(k), Orden = null });
        await CargarCfgRAsync(); StateHasChanged();
    }
    private async Task EliminarCampoDinR()
    {
        if (_campoAEliminar is null) return;
        _colBusy = true;
        try
        {
            var r = await Auth().DeleteAsync($"/api/mi-copropiedad/personas-campos/{_campoAEliminar.Id}");
            _msg = r.IsSuccessStatusCode ? $"Campo \"{_campoAEliminar.Label}\" eliminado." : "No se pudo eliminar el campo.";
            _msgError = !r.IsSuccessStatusCode;
            if (r.IsSuccessStatusCode) await CargarAsync();
        }
        catch (Exception ex) { _msg = "Error al eliminar el campo: " + ex.Message; _msgError = true; }
        _campoAEliminar = null; _colBusy = false; StateHasChanged();
    }

    // ---------- Crear / editar UN campo (modal focalizado): "+" crea; engranaje edita ----------
    private bool _crearCampoAbierto;
    private CampoDinDef? _campoAEditar;
    private void AbrirCrearCampoR() { _campoAEditar = null; _crearCampoAbierto = true; }
    private void AbrirEditarCampoR(CampoDinDef c)
    {
        _campoAEditar = new CampoDinDef(c.Id, c.Label, c.Orden, c.Tipo, c.Opciones, c.Descripcion);
        _crearCampoAbierto = true;
    }
    private async Task RecargarTrasCrearCampoR()
    {
        _crearCampoAbierto = false; _campoAEditar = null;
        await CargarAsync();
        StateHasChanged();
    }
    private void AbrirGestorDesdeCrearR()
    {
        _crearCampoAbierto = false; _campoAEditar = null;
