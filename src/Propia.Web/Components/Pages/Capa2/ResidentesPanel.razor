@using Propia.Application.MiCopropiedad
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@using Propia.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IModalService Modals
@inject IJSRuntime Js
@implements IDisposable

@if (!Embedded) { <PageTitle>Residentes - PROPIA</PageTitle> }

@* Residentes: vista agregada de TODAS las personas de las unidades (propietarios, residentes,
   arrendatarios, familiares, apoderados). Misma vista tabla estandar del sistema (paridad con
   Zonas/Equipos): seleccion + borrado masivo, alta "nace fila", menu Columnas inline, "+" para
   crear campo, engranaje para editar/eliminar campo, ordenar/mover/redimensionar columnas y menu
   contextual. Toda alta reutiliza el endpoint de Unidades Privadas, que ya asegura el registro en
   Directorio. Las columnas (orden/visibilidad/alias/ancho) viven en unidades-config (entidad
   'personas'), como en Zonas/Equipos. *@

@if (!Embedded)
{
    <div class="res-pagehead">
        <h1 class="res-pagetitle">Residentes</h1>
        <p class="res-pagesub">Todas las personas de las unidades de @(_copNombre ?? "la copropiedad"). Cada registro queda tambien en el Directorio.</p>
    </div>
}

@if (!_authChecked || _jwt is null)
{
    <div class="res-loading"><div class="spinner-border" style="color: var(--propia-brand, var(--propia-brand));"></div></div>
}
else
{
    @* ===== Barra estandar: Filtros + buscador + Agrupar + Columnas/Campos + toggle ===== *@
    <div class="res-filtros">
        <FiltroDinamico @ref="_fd" Campos="CamposFiltro" OnChanged="@(() => { _pagina = 1; StateHasChanged(); })" />
        <div class="res-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input class="res-search-inp" placeholder="Buscar por nombre, documento o unidad..."
                   @oninput="@(e => { _q = e.Value?.ToString() ?? string.Empty; _pagina = 1; })" />
        </div>
        <div class="res-filtros-spacer"></div>

        @* Ordenar (multi-criterio apilable): fuente unica compartida. *@
        <TablaOrdenarMenu Columnas="ColsOrdenables()" Sorts="_sorts" SortsChanged="OnSortsChanged" />

        @* Agrupar (menu) - disponible en ambas vistas. *@
        <div class="res-menu-wrap">
            <button type="button" class="res-fbtn @(_agruparPor != "" ? "on" : "")" @onclick="() => _showAgrupar = !_showAgrupar" title="Agrupar residentes">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <span>Agrupar@(_agruparPor != "" ? ": " + AgruparLabel(_agruparPor) : "")</span>
            </button>
            @if (_showAgrupar)
            {
                <div class="res-menu-bd" @onclick="() => _showAgrupar = false"></div>
                <div class="res-menu">
                    @foreach (var g in new[] { ("", "Sin agrupar"), ("rol", "Rol"), ("unidad", "Unidad"), ("torre", "Torre") })
                    {
                        var gk = g.Item1;
                        <button class="res-menu-it @(_agruparPor == gk ? "on" : "")" @onclick="() => SetAgrupar(gk)">@g.Item2</button>
                    }
                    @foreach (var d in _defs)
                    {
                        var gk = "cd:" + d.Id;
                        <button class="res-menu-it @(_agruparPor == gk ? "on" : "")" @onclick="@(() => SetAgrupar(gk))">@d.Label</button>
                    }
                </div>
            }
        </div>

        @if (_vista == "tabla")
        {
            @* "Columnas" inline (milimetrico a Zonas/Equipos): orden, visibilidad y borrar campo
               dinamico. Crear campo nuevo = "+" del header; editar/eliminar = engranaje de la columna. *@
            <div class="res-menu-wrap">
                <button type="button" class="res-fbtn @(_showColMenu ? "on" : "")" @onclick="() => _showColMenu = !_showColMenu" title="Columnas: orden, visibilidad y campos">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                    <span>Columnas</span>
                </button>
                @if (_showColMenu)
                {
                    <div class="res-menu-bd" @onclick="() => _showColMenu = false"></div>
                    <div class="res-menu res-colmenu">
                        <div class="res-col-search">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                            <input placeholder="Buscar campo..." value="@_colQ" @oninput="@(e => _colQ = e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="res-col-list">
                            @{ var _cols = ClavesOrdenadas().ToList(); }
                            @for (int _ci = 0; _ci < _cols.Count; _ci++)
                            {
                                var k = _cols[_ci];
                                var idx = _ci;
                                var label = ColLabel(k);
                                if (!string.IsNullOrWhiteSpace(_colQ) && !label.Contains(_colQ, StringComparison.OrdinalIgnoreCase)) { continue; }
                                var fija = idx == 0;
                                var visible = VisibleCol(k);
                                var custom = CampoCustom(k);
                                <div class="res-col-it">
                                    <button class="res-col-mv" disabled="@(idx <= 1)" @onclick="() => MoverColumnaR(k, -1)">&#9650;</button>
                                    <button class="res-col-mv" disabled="@(idx == 0 || idx == _cols.Count - 1)" @onclick="() => MoverColumnaR(k, 1)">&#9660;</button>
                                    <span class="res-col-name">@label @if (custom is not null) { <span class="res-col-dyn" title="Campo personalizado">din</span> }</span>
                                    @if (fija) { <span class="res-col-fija">fija</span> }
                                    else
                                    {
                                        <button class="res-col-eye @(visible ? "on" : "")" title="@(visible ? "Ocultar" : "Mostrar")" @onclick="() => ToggleVisibleColR(k)"><i class="fi @(visible ? "fi-rr-eye" : "fi-rr-eye-crossed")"></i></button>
                                    }
                                    @if (custom is not null) { <button class="res-col-del" title="Eliminar campo (definicion y valores)" @onclick="() => _campoAEliminar = custom"><i class="fi fi-rr-trash"></i></button> }
                                </div>
                            }
                        </div>
                        <div class="res-col-massacts">
                            <button type="button" class="res-col-mass" @onclick="OcultarTodasColR"><i class="fi fi-rr-eye-crossed"></i> Ocultar todos</button>
                            <button type="button" class="res-col-mass" @onclick="MostrarTodasColR"><i class="fi fi-rr-eye"></i> Mostrar todo</button>
                            <button type="button" class="res-col-reset" @onclick="RestablecerColR">Restablecer</button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @* En Tarjetas no hay columnas ni "+": aqui se mantiene la entrada al gestor de campos. *@
            <div class="res-menu-wrap">
                <button type="button" class="res-fbtn @(_configCamposAbierto ? "on" : "")" @onclick="() => _configCamposAbierto = true" title="Campos del residente: crear, renombrar, ordenar y ocultar">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v18H3zM14 3h7v18h-7z"/></svg>
                    <span>Campos</span>
                </button>
            </div>
        }

        @* Toggle Tarjetas/Tabla, canon del sistema (Tarjetas primero). Se recuerda por modulo. *@
        <div class="res-viewtoggle">
            <button type="button" class="res-vt @(_vista == "tarjetas" ? "on" : "")" @onclick='() => SetVista("tarjetas")' title="Tarjetas">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Tarjetas
            </button>
            <button type="button" class="res-vt @(_vista == "tabla" ? "on" : "")" @onclick='() => SetVista("tabla")' title="Tabla">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                Tabla
            </button>
        </div>
    </div>

    @* Modal del gestor de campos del residente (gestor AVANZADO, fallback). *@
    @if (_configCamposAbierto)
    {
        <div class="cg-back" @onclick="() => _configCamposAbierto = false">
            <div class="cg-modal cg-modal--wide" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                <div class="cg-head">
                    <div>
                        <div class="cg-title">Campos del residente</div>
                        <div class="cg-sub">Orden, visibilidad, tipo y comportamiento de cada campo del residente.</div>
                    </div>
                    <button class="cg-x" type="button" @onclick="() => _configCamposAbierto = false" aria-label="Cerrar">&times;</button>
                </div>
                <div class="cg-body">
                    <ConfigCamposEntidad Prefijo="personas"
                                         EntidadConfig="personas"
                                         TiposAvanzados="true"
                                         TituloSingular="residente"
                                         TituloPlural="residentes"
                                         Ejemplo="Ej. Numero de parqueadero, Fecha de ingreso"
                                         Jwt="@_jwt"
                                         Cambiado="RecargarCamposAsync" />
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_msg)) { <div class="res-msg @(_msgError ? "err" : "ok")">@_msg</div> }

    @* ===== Vista Tarjetas ===== (con 0 residentes se fuerza la tabla, para poder dar de alta el primero) *@
    @if (_vista == "tarjetas" && _residentes.Count > 0)
    {
        <div class="res-cardswrap">
            <div class="res-cards">
                @foreach (var item in FilasRender())
                {
                    if (item.EsGrupo)
                    {
                        <div class="res-cards-group"><span class="res-group-chip">@item.GrupoTitulo</span><span class="res-group-n">@item.GrupoCount</span></div>
                        continue;
                    }
                    var r = item.Fila!;
                    <div class="res-card @(_resRecienCreados.Contains(r.UnidadPersonaId) ? "res-card-nuevo" : "")" @onclick="() => AbrirFicha(r)" title="Abrir ficha del residente">
                        <div class="res-card-top">
                            <span class="res-cod">@r.UnidadCodigo</span>
                            @RolBadge(r.Rol)
                        </div>
                        <div class="res-card-nom">@r.Nombre @if (r.EntidadTipo == EntidadDirectorio.Empresa) { <span class="res-tag">Empresa</span> }</div>
                        <div class="res-card-line"><span class="res-card-k">Documento</span><span class="res-card-v">@(string.IsNullOrWhiteSpace(r.Documento) ? "-" : r.Documento)</span></div>
                        <div class="res-card-line"><span class="res-card-k">Telefono</span><span class="res-card-v">@(string.IsNullOrWhiteSpace(r.Telefono) ? "-" : r.Telefono)</span></div>
                        <div class="res-card-line"><span class="res-card-k">Email</span><span class="res-card-v">@(string.IsNullOrWhiteSpace(r.Email) ? "-" : r.Email)</span></div>
                        <div class="res-card-line"><span class="res-card-k">Habita</span><span class="res-card-v">@(r.Habita ? "Si" : "No")</span></div>
                        @foreach (var d in _defs)
                        {
                            var val = ValorDe(r.UnidadPersonaId, d.Id);
                            var txt = (d.Tipo == TipoCampoTablero.Directorio || d.Tipo == TipoCampoTablero.Usuario) ? NombrePersona(val) : val;
                            <div class="res-card-line"><span class="res-card-k">@d.Label</span><span class="res-card-v">@(string.IsNullOrWhiteSpace(txt) ? "-" : txt)</span></div>
                        }
                    </div>
                }
            </div>
            @if (_agruparPor == "")
            {
                <TablaPager Total="Filtrados.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="residentes"
                            PaginaChanged="p => { _pagina = p; }"
                            PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
            }
        </div>
    }
    else
    {
    @* ===== Tabla ===== *@
    @if (_selR.Count > 0)
    {
        <div class="res-selbar">
            <span class="res-selbar-n">@_selR.Count seleccionado@(_selR.Count == 1 ? "" : "s")</span>
            <button type="button" class="res-selbar-del" @onclick="() => _confirmDelSel = true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                Eliminar
            </button>
            <button type="button" class="res-selbar-x" @onclick="LimpiarSelR">Deseleccionar</button>
        </div>
    }
    @if (_confirmDelSel)
    {
        <div class="res-cfg-back" @onclick="() => { if (!_delBusy) _confirmDelSel = false; }">
            <div class="res-confirm" @onclick:stopPropagation="true">
                <div class="res-confirm-t">Eliminar @_selR.Count residente@(_selR.Count == 1 ? "" : "s")</div>
                <div class="res-confirm-s">Esta accion desvincula los residentes seleccionados de sus unidades de forma permanente y no se puede deshacer.</div>
                <div class="res-confirm-acts">
                    <button type="button" class="res-fbtn" @onclick="() => _confirmDelSel = false" disabled="@_delBusy">Cancelar</button>
                    <button type="button" class="res-selbar-del" @onclick="EliminarSelResidentesAsync" disabled="@_delBusy">@(_delBusy ? "Eliminando..." : "Si, eliminar")</button>
                </div>
            </div>
        </div>
    }
    @if (_campoAEliminar is not null)
    {
        <div class="res-cfg-back" @onclick="() => { if (!_colBusy) _campoAEliminar = null; }">
            <div class="res-confirm" @onclick:stopPropagation="true">
                <div class="res-confirm-t">Eliminar campo "@_campoAEliminar.Label"</div>
                <div class="res-confirm-s">Se elimina la definicion del campo y todos sus valores en los residentes. No se puede deshacer.</div>
                <div class="res-confirm-acts">
                    <button type="button" class="res-fbtn" @onclick="() => _campoAEliminar = null" disabled="@_colBusy">Cancelar</button>
                    <button type="button" class="res-selbar-del" @onclick="EliminarCampoDinR" disabled="@_colBusy">@(_colBusy ? "Eliminando..." : "Si, eliminar campo")</button>
                </div>
            </div>
        </div>
    }
    <div class="res-table">
        <div class="res-scroll">
            <div class="res-head res-listgrid zc-list-head" style="@PerGridStyle">
                <div class="res-sel-cell"><label class="res-chk" title="Seleccionar todo"><input type="checkbox" checked="@TodasSelR" @onchange="@(e => ToggleSelAllR((bool)(e.Value ?? false)))" /></label></div>
                <div></div>
                @foreach (var k in ColsVisibles())
                {
                    var clave = k;
                    if (CampoCustom(clave) is not null)
                    {
                        <div class="res-th-dyn res-th-sortable" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                             @onmousedown="e => IniciarReorderR(e, clave)" @onclick="() => OrdenarPorColumnaR(clave)">
                            <span class="res-th-lbl">@ColLabel(clave).ToUpperInvariant()</span>
                            @if (_sortKey == clave) { <span class="res-th-arrow">@((MarkupString)(_sortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                            @ChevCol(clave, ColLabel(clave), true)
                            <span class="res-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResizeR(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResizeR(clave)" @ondblclick:stopPropagation="true"></span>
                        </div>
                    }
                    else
                    {
                        <div class="res-th-dyn res-th-sortable @(CenterCol(clave) ? "res-c" : "")" data-clave="@clave" title="Clic: ordenar | arrastra: mover columna"
                             @onmousedown="e => IniciarReorderR(e, clave)" @onclick="() => OrdenarPorColumnaR(clave)">
                            <span class="res-th-lbl">@ColLabel(clave).ToUpperInvariant()</span>
                            @if (_sortKey == clave) { <span class="res-th-arrow">@((MarkupString)(_sortDir > 0 ? "&#9650;" : "&#9660;"))</span> }
                            @ChevCol(clave, ColLabel(clave), false)
                            <span class="res-col-rz" title="Arrastra para ajustar el ancho | doble clic para autoajustar" @onmousedown="e => IniciarResizeR(e, clave)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="() => ResetResizeR(clave)" @ondblclick:stopPropagation="true"></span>
                        </div>
                    }
                }
                <div></div>
                <div class="res-addcol-h"><button type="button" class="res-addcol-btn" title="Crear campo nuevo (columna)" @onclick="AbrirCrearCampoR"><i class="fi fi-rr-plus"></i></button></div>
            </div>

            @foreach (var item in FilasRender())
            {
                if (item.EsGrupo)
                {
                    <div class="res-group">
                        <span class="res-group-chip">@item.GrupoTitulo</span>
                        <span class="res-group-n">@item.GrupoCount</span>
                    </div>
                    continue;
                }
                var r = item.Fila!;
                <div class="res-listrow res-listgrid @(_selR.Contains(r.UnidadPersonaId) ? "res-row-sel" : "") @(_resRecienCreados.Contains(r.UnidadPersonaId) ? "res-row-nuevo" : "")" style="@PerGridStyle" @oncontextmenu="e => AbrirCtxR(e, r)" @oncontextmenu:preventDefault="true">
                    <div class="res-sel-cell"><label class="res-chk"><input type="checkbox" checked="@_selR.Contains(r.UnidadPersonaId)" @onchange="@(e => ToggleSelR(r.UnidadPersonaId, (bool)(e.Value ?? false)))" @onclick:stopPropagation="true" /></label></div>
                    <div class="res-col-exp">
                        <button type="button" class="res-exp res-exp-fijo" title="Abrir ficha del residente" @onclick="() => AbrirFicha(r)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                        </button>
                    </div>
                    @foreach (var k in ColsVisibles())
                    {
                        if (CampoCustom(k) is CampoDinDef def)
                        {
                            var d = def;
                            var val = ValorDe(r.UnidadPersonaId, d.Id);
                            if (d.Tipo == TipoCampoTablero.Seleccion)
                            {
                                <div class="res-selcell">
                                    @if (!string.IsNullOrWhiteSpace(val))
                                    {
                                        var col = ColorOpcion(d, val);
                                        <span class="res-chip" style="background:@(col ?? PaletaChips.Neutro);color:@PaletaChips.TextoSobre(col)">@val</span>
                                    }
                                    <select class="res-editcell" value="@val" @onchange="e => GuardarDinamicoAsync(r.UnidadPersonaId, d.Id, e.Value?.ToString())">
                                        <option value="">-</option>
                                        @foreach (var op in d.OpcionesArray()) { <option value="@op" selected="@(op == val)">@op</option> }
                                    </select>
                                </div>
                            }
                            else if (d.Tipo == TipoCampoTablero.Formula)
                            {
                                <div class="res-c-cell res-auto" title="Se calcula automaticamente">@(string.IsNullOrWhiteSpace(val) ? "-" : val)</div>
                            }
                            else if (d.Tipo == TipoCampoTablero.Usuario)
                            {
                                <select class="res-editcell" value="@val" @onchange="e => GuardarDinamicoAsync(r.UnidadPersonaId, d.Id, e.Value?.ToString())">
                                    <option value="">-</option>
                                    @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId" selected="@(u.PersonaId.ToString() == val)">@u.NombreCompleto</option> }
                                </select>
                            }
                            else if (d.Tipo == TipoCampoTablero.Directorio)
                            {
                                <div class="res-c-cell res-mut">@(NombrePersona(val) ?? "-")</div>
                            }
                            else
                            {
                                <input class="res-editcell" value="@val" placeholder="-" @onchange="e => GuardarDinamicoAsync(r.UnidadPersonaId, d.Id, e.Value?.ToString())" />
                            }
                            continue;
                        }
                        switch (k)
                        {
                            case "unidad": <div class="res-c-cell"><span class="res-cod">@r.UnidadCodigo</span></div>; break;
                            case "nombre": <div class="res-c-cell res-nom">@r.Nombre @if (r.EntidadTipo == EntidadDirectorio.Empresa) { <span class="res-tag">Empresa</span> }</div>; break;
                            case "documento": <div class="res-c-cell">@r.Documento</div>; break;
                            case "rol": <div class="res-c-cell res-c">@RolBadge(r.Rol)</div>; break;
                            case "telefono": <input class="res-editcell" value="@r.Telefono" placeholder="-" @onchange="e => EditarContactoAsync(r, TipoContacto.Telefono, e.Value?.ToString())" />; break;
                            case "email": <input class="res-editcell" value="@r.Email" placeholder="-" @onchange="e => EditarContactoAsync(r, TipoContacto.Email, e.Value?.ToString())" />; break;
                            case "habita": <div class="res-c-cell res-c">@(r.Habita ? "Si" : "No")</div>; break;
                        }
                    }
                    <div class="res-list-act">
                        <button type="button" class="res-row-del" @onclick="() => EliminarResidenteAsync(r.UnidadPersonaId, r.Nombre)" title="Eliminar">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                        </button>
                    </div>
                    <div class="res-addcol-cell"></div>
                </div>
            }

            @* Alta inline "nace fila" (canon): CTA morado que abre una fila editable con foco
               redondeado + acciones checkmark/x. La unidad por codigo (autocompletado) + la persona
               por el control de terceros (SelectorPersona), que la busca/crea en el Directorio. *@
            @if (_altaAbierta)
            {
            <div class="res-listnew res-newrow--edit res-listgrid" style="@PerGridStyle" @key="_nonce" @onkeydown="OnAltaKeydownR">
                <div class="res-sel-cell"></div>
                <div class="res-col-exp">
                    <span class="res-exp res-exp-mut" title="Nuevo residente">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </span>
                </div>
                @foreach (var k in ColsVisibles())
                {
                    if (CampoCustom(k) is CampoDinDef def)
                    {
                        var d = def;
                        var dv = _nuDinamicos.TryGetValue(d.Id, out var _dv) ? _dv : "";
                        if (d.Tipo == TipoCampoTablero.Seleccion)
                        {
                            <select class="res-nf-inp" value="@dv" @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())">
                                <option value="">@d.Label</option>
                                @foreach (var op in d.OpcionesArray()) { <option value="@op" selected="@(op == dv)">@op</option> }
                            </select>
                        }
                        else if (d.Tipo == TipoCampoTablero.Formula)
                        {
                            <div class="res-c-cell res-auto">(se calcula)</div>
                        }
                        else if (d.Tipo == TipoCampoTablero.Usuario)
                        {
                            <select class="res-nf-inp" value="@dv" @onchange="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())">
                                <option value="">@d.Label</option>
                                @foreach (var u in _usuariosTenant) { <option value="@u.PersonaId" selected="@(u.PersonaId.ToString() == dv)">@u.NombreCompleto</option> }
                            </select>
                        }
                        else if (d.Tipo == TipoCampoTablero.Directorio)
                        {
                            <SelectorPersona Flotante="true" Jwt="@_jwt" Placeholder="@d.Label"
                                             SeleccionadaChanged="c => OnDirectorioNuevo(d.Id, c)" />
                        }
                        else
                        {
                            <input class="res-nf-inp" placeholder="@d.Label" value="@dv"
                                   @oninput="e => SetDinamicoNuevo(d.Id, e.Value?.ToString())" />
                        }
                        continue;
                    }
                    switch (k)
                    {
                        case "unidad":
                            <div class="res-nf-unidad">
                                <input class="res-nf-inp" @ref="_unidadRef" placeholder="Ej. A1-101" @bind="_unidadQuery" @bind:event="oninput" @onfocus="() => _unidadDrop = true" autocomplete="off" />
                                @if (_unidadDrop && UnidadesFiltradas().Any())
                                {
                                    <div class="res-drop">
                                        @foreach (var u in UnidadesFiltradas())
                                        {
                                            <button type="button" class="res-drop-it" @onclick="() => ElegirUnidad(u)">
                                                <span class="res-drop-cod">@CodigoUnidad(u)</span>
                                                <span class="res-drop-meta">@u.Tipo@(u.PropietarioNombre is { Length: > 0 } pn ? " - " + pn : "")</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            break;
                        case "nombre":
                            <div class="res-nf-persona">
                                @if (_personaSel is null)
                                {
                                    <SelectorPersona Seleccionada="_personaSel" SeleccionadaChanged="OnPersonaSel" Jwt="@_jwt" PermiteEmpresa="true" Flotante="true" Placeholder="Buscar o crear..." EmailInicial="@_ptEmail" TelefonoInicial="@_ptTel" />
                                }
                                else
                                {
                                    <div class="res-nf-selname" title="@_personaSel.NombreCompleto">
                                        <span>@_personaSel.NombreCompleto</span>
                                        <button type="button" class="res-nf-selx" title="Cambiar tercero" @onclick="LimpiarPersonaSel">&times;</button>
                                    </div>
                                }
                            </div>
                            break;
                        case "documento":
                            <input class="res-nf-inp res-nf-ro-inp" readonly tabindex="-1" placeholder="Documento"
                                   value="@(_personaSel is null ? "" : $"{_personaSel.TipoDocumento} {_personaSel.DocumentoEnmascarado}")" />
                            break;
                        case "rol":
                            <select class="res-nf-inp" @bind="_rolNuevo">
                                @foreach (var rr in Enum.GetValues<RolUnidadPersona>()) { <option value="@rr">@RolLabel(rr)</option> }
                            </select>
                            break;
                        case "telefono":
                            <input class="res-nf-inp" placeholder="Telefono" @bind="_ptTel" @bind:event="oninput" />
                            break;
                        case "email":
                            <input class="res-nf-inp" placeholder="Email" @bind="_ptEmail" @bind:event="oninput" />
                            break;
                        case "habita":
                            <label class="res-nf-habchk" title="Reside en la unidad"><input type="checkbox" @bind="_habitaNuevo" /> <span>Si</span></label>
                            break;
                    }
                }
                <div class="res-list-act res-nf-actbtns">
                    <button type="button" class="res-nf-ok" title="Guardar (Enter)" @onclick="() => AgregarAsync(false)" disabled="@(_busy || !AltaValida)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                    </button>
                    <button type="button" class="res-nf-cancel" title="Cancelar (Esc)" @onclick="CerrarAltaR" disabled="@_busy">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                </div>
                <div class="res-addcol-cell"></div>
            </div>
            }
            else
            {
            <div class="res-listnew res-newrow--cta res-listgrid" style="@PerGridStyle">
                <div class="res-sel-cell"></div>
                <div class="res-col-exp"></div>
                <div class="res-nf-ctacell" style="grid-column: 3 / -1;">
                    <button type="button" class="res-nf-cta" @onclick="AbrirAltaR">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                        Agregar registro
                    </button>
                </div>
            </div>
            }

            @if (_residentes.Count > 0 && Filtrados.Count == 0)
            {
                <div class="res-empty">Ningun registro coincide con el filtro.</div>
            }
            else if (_residentes.Count == 0)
            {
                <div class="res-empty">Aun no hay personas en las unidades. Agrega la primera con "Agregar registro".</div>
            }
        </div>

        @* Footer canonico (solo sin agrupacion: agrupar y paginar juntos confunde). *@
        @if (_agruparPor == "")
        {
            <TablaPager Total="Filtrados.Count" Pagina="_pagina" PorPagina="_porPagina" Entidad="residentes"
                        PaginaChanged="p => { _pagina = p; }"
                        PorPaginaChanged="n => { _porPagina = n; _pagina = 1; }" />
        }
    </div>
    }
}

@* Crear / editar UN campo (modal focalizado). "+" crea; engranaje edita. *@
@if (_crearCampoAbierto)
{
    <CrearCampoModal Prefijo="personas"
                     TituloSingular="residente"
                     Ejemplo="Ej. Numero de parqueadero, Fecha de ingreso"
                     Jwt="@_jwt"
                     Editar="_campoAEditar"
                     TiposAvanzados="false"
                     Guardado="RecargarTrasCrearCampoR"
                     Cerrado="() => { _crearCampoAbierto = false; _campoAEditar = null; }"
                     AbrirGestorAvanzado="AbrirGestorDesdeCrearR" />
}

@* Menu contextual (clic derecho sobre una fila). *@
<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />

@* Menu de columna estilo Airtable (flecha del header) + toast, replica de Tareas. *@
<TablaColMenu @ref="_colMenu" OnAccion="OnColAccion" />
@if (_colToast is not null)
{
    <div style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--propia-text-h1);color:var(--propia-text-inverse);padding:8px 16px;border-radius:9px;z-index:5000;font-size:12.5px;cursor:pointer;box-shadow:0 6px 18px rgba(27,42,58,.28);" @onclick="() => _colToast = null">@_colToast</div>
}

@* IModalService es scoped por circuito: el host debe declararse en la pagina para renderizar el modal. *@
<ModalHost />

@code {
    // Cuando el hub de Configuracion lo embebe, oculta su page-head/PageTitle (chrome redundante).
    [Parameter] public bool Embedded { get; set; }

    private bool _authChecked;
