    // ===== Menu de columna estilo Airtable (la flecha del header abre TablaColMenu) =====
    // Cablea las acciones reales del modulo; lo que depende de backend nuevo se avisa por toast.
    private TablaColMenu? _colMenu;
    private string? _colToast;
    private void ColToast(string m) { _colToast = m; StateHasChanged(); }
    private void AbrirColMenu(MouseEventArgs e, string clave, string label, bool dyn)
        => _colMenu?.Abrir(new TablaColMenu.Ctx(clave, label, dyn), e.ClientX, e.ClientY);
    // Flecha del header (reutiliza la clase del engranaje, sin CSS nuevo). Se inserta en cada columna.
    private RenderFragment ChevCol(string clave, string label, bool dyn) =>@<button type="button" class="res-th-edit" title="Opciones de columna" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="(e) => AbrirColMenu(e, clave, label, dyn)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg></button>;
    private async Task OnColAccion((TablaColMenu.Accion Accion, TablaColMenu.Ctx Col) a)
    {
        var (accion, col) = a;
        var campo = col.EsDinamico ? CampoCustom(col.Key) : null;
        switch (accion)
        {
            case TablaColMenu.Accion.OrdenarAsc:
                _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = 1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.OrdenarDesc:
                _sorts = new() { new TablaOrdenarMenu.Sort { Key = col.Key, Dir = -1 } }; _pagina = 1; break;
            case TablaColMenu.Accion.Editar:
            case TablaColMenu.Accion.Descripcion:
                if (campo is not null) AbrirEditarCampoR(campo);
                else ColToast("Los campos del sistema no editan su configuracion aqui.");
                break;
            case TablaColMenu.Accion.Eliminar:
                if (campo is not null) _campoAEliminar = campo;
                else ColToast("Los campos del sistema no se eliminan aqui.");
                break;
            case TablaColMenu.Accion.Duplicar:
                if (campo is not null) await DuplicarCampoAsync(campo);
                else ColToast("Solo se pueden duplicar campos propios.");
                break;
            case TablaColMenu.Accion.InsertarIzq:
            case TablaColMenu.Accion.InsertarDer:
                AbrirCrearCampoR();
                break;
            case TablaColMenu.Accion.Ocultar:
                await ToggleVisibleColR(col.Key);
                break;
            case TablaColMenu.Accion.CopiarUrl:
                try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}residentes#campo-{col.Key}"); ColToast("Enlace del campo copiado."); }
                catch { ColToast("No se pudo copiar el enlace."); }
                break;
            case TablaColMenu.Accion.Agrupar:
                {
                    var g = GrupoDeClave(col.Key);
                    if (g is null) { ColToast("Agrupar por este campo no esta disponible."); break; }
                    await SetAgrupar(g);
                }
                break;
            case TablaColMenu.Accion.Filtrar:
                if (_fd is not null && CamposFiltro.Any(c => c.Key == col.Key))
                    await _fd.AgregarReglaCampo(col.Key);
                else ColToast("Filtrar por este campo aun no esta disponible; usa el boton Filtros.");
                break;
            case TablaColMenu.Accion.TituloIa:
                if (campo is not null)
                {
                    ColToast("Sugiriendo un titulo con IA...");
                    var _t = await Propia.Web.Components.Shared.IaCampoTitulo.SugerirAsync(Auth(), "residentes", campo.Label);
                    if (_t.Ok && !string.IsNullOrWhiteSpace(_t.Titulo))
                    {
                        try
                        {
                            var _rr = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/personas-campos/{campo.Id}",
                                new ActualizarCampoDefinicionRequest(_t.Titulo!, campo.Tipo, campo.Opciones, campo.Orden, campo.Descripcion));
                            if (_rr.IsSuccessStatusCode) { await RecargarCamposAsync(); ColToast($"Titulo IA aplicado: {_t.Titulo}"); }
                            else ColToast("No se pudo aplicar el titulo sugerido.");
                        }
                        catch { ColToast("No se pudo aplicar el titulo sugerido."); }
                    }
                    else ColToast("La IA no pudo sugerir un titulo ahora.");
                }
                else ColToast("Sugerir titulo con IA solo aplica a campos propios.");
                break;
        }
        StateHasChanged();
    }
