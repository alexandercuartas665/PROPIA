    // ---------- Tercero (control del Directorio) ----------
    private async Task OnPersonaSel(PersonaCandidatoDto? p)
    {
        _personaSel = p;
        _ptTel = _ptEmail = _ptTelOrig = _ptEmailOrig = "";
        if (p is not null)
        {
            var tel = TelDe(p); var email = EmailDe(p);
            if (tel is null || email is null)
            {
                try
                {
                    var url = p.EntidadTipo == EntidadDirectorio.Empresa
                        ? $"/api/directorio/empresas/{p.PersonaId}"
                        : $"/api/directorio/personas/{p.PersonaId}";
                    var resp = await Auth().GetAsync(url);
                    if (resp.IsSuccessStatusCode)
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
                        var obj = doc.RootElement;
                        if (obj.TryGetProperty("persona", out var pe)) obj = pe;
                        else if (obj.TryGetProperty("empresa", out var ee)) obj = ee;
                        if (tel is null && obj.TryGetProperty("telefono", out var te) && te.ValueKind == System.Text.Json.JsonValueKind.String) tel = te.GetString();
                        if (email is null && obj.TryGetProperty("email", out var em) && em.ValueKind == System.Text.Json.JsonValueKind.String) email = em.GetString();
                    }
                }
                catch { }
            }
            _ptTel = _ptTelOrig = tel ?? "";
            _ptEmail = _ptEmailOrig = email ?? "";
        }
        StateHasChanged();
    }

    private void LimpiarPersonaSel()
    {
        _personaSel = null;
        _ptTel = _ptEmail = _ptTelOrig = _ptEmailOrig = "";
    }

    private static string? TelDe(PersonaCandidatoDto? p) => ContactoDe(p, TipoContacto.Telefono);
    private static string? EmailDe(PersonaCandidatoDto? p) => ContactoDe(p, TipoContacto.Email);
    private static string? ContactoDe(PersonaCandidatoDto? p, TipoContacto tipo)
    {
        if (p?.Contactos is null) return null;
        return p.Contactos.FirstOrDefault(c => c.Tipo == tipo && c.Principal)?.Valor
            ?? p.Contactos.FirstOrDefault(c => c.Tipo == tipo)?.Valor;
    }

    private async Task<bool> SincronizarContactoAsync(EntidadDirectorio tipo, Guid entidadId, TipoContacto cual, string? valor)
    {
        try
        {
            var http = Auth();
            var actuales = await http.GetFromJsonAsync<List<ContactoRapidoDto>>(
                $"/api/directorio/contactos-rapidos?tipo={tipo}&id={entidadId}") ?? new();
            var nuevos = actuales.Where(c => c.Tipo != cual).ToList();
            if (!string.IsNullOrWhiteSpace(valor))
                nuevos.Add(new ContactoRapidoDto(cual, valor.Trim(), "Principal", null, true));
            var resp = await http.PutAsJsonAsync("/api/directorio/contactos-rapidos",
                new ReemplazarContactosRequest(tipo, entidadId, nuevos));
            return resp.IsSuccessStatusCode;
        }
        catch { return false; }
    }

    // Edicion inline de un contacto en una fila existente -> sincroniza al Directorio (global).
    private async Task EditarContactoAsync(ResidenteResumenDto r, TipoContacto cual, string? valor)
    {
        var actual = cual == TipoContacto.Email ? r.Email : r.Telefono;
        if (string.Equals((valor ?? "").Trim(), (actual ?? "").Trim(), StringComparison.OrdinalIgnoreCase)) return;
        var entidadId = r.EntidadTipo == EntidadDirectorio.Empresa ? r.EmpresaId : r.PersonaId;
        if (entidadId is not Guid id) return;
        _busy = true; _msg = ""; _msgError = false;
        var ok = await SincronizarContactoAsync(r.EntidadTipo, id, cual, valor);
        _busy = false;
        if (ok) { _msg = $"Contacto de {r.Nombre} actualizado en el Directorio."; _msgError = false; await CargarAsync(); }
        else { _msg = "No se pudo actualizar el contacto (correo en uso u otro error)."; _msgError = true; }
    }

    // ---------- Alta ----------
    private async Task AgregarAsync(bool abrir)
    {
        if (_busy) return;
        // Validar minimos al clic con mensaje (canon regla 8), en vez de un retorno mudo.
        if (UnidadElegida is not { } unidad)
        {
            _msg = _sinUnidades
                ? "Primero crea las unidades privadas (en Unidades Privadas). Luego escribe su codigo aqui."
                : "Selecciona una unidad existente: escribe su codigo en el campo Unidad y elige de la lista.";
            _msgError = true; return;
        }
        if (_personaSel is not { } sel)
        {
            _msg = "Busca o crea la persona (residente/propietario) antes de agregar."; _msgError = true; return;
        }
        _busy = true; _msg = ""; _msgError = false;
        try
        {
            var esEmpresa = sel.EntidadTipo == EntidadDirectorio.Empresa;
            var req = new AgregarPersonaUnidadRequest(
                "", "", "", null, null,
                _rolNuevo, _habitaNuevo, null,
                PersonaId: esEmpresa ? null : sel.PersonaId,
                EntidadTipo: sel.EntidadTipo,
                EmpresaId: esEmpresa ? sel.PersonaId : null);
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{unidad.Id}/personas", req);
            if (!resp.IsSuccessStatusCode)
            {
                _msg = "No se pudo agregar: " + await resp.Content.ReadAsStringAsync(); _msgError = true; return;
            }
            var creada = await resp.Content.ReadFromJsonAsync<UnidadPersonaDto>();
            if (creada is not null)
            {
                _resRecienCreados.Add(creada.Id);   // resalta la fila hasta el proximo refresco
                // Los campos propios se guardan despues del alta: necesitan el id del registro (UnidadPersona).
                foreach (var (defId, valor) in _nuDinamicos.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                    await Auth().PutAsJsonAsync($"/api/mi-copropiedad/personas-campos-valores/{creada.Id}/{defId}", new SetCampoValorRequest(valor));
            }
            // Si el usuario ajusto correo/telefono del tercero, se sincroniza al Directorio.
            if (_ptTel.Trim() != _ptTelOrig.Trim()) await SincronizarContactoAsync(sel.EntidadTipo, sel.PersonaId, TipoContacto.Telefono, _ptTel);
            if (_ptEmail.Trim() != _ptEmailOrig.Trim()) await SincronizarContactoAsync(sel.EntidadTipo, sel.PersonaId, TipoContacto.Email, _ptEmail);
            _msg = $"{sel.NombreCompleto} agregado a {_unidadQuery}."; _msgError = false;
            LimpiarPersonaSel(); _rolNuevo = RolUnidadPersona.Residente; _habitaNuevo = true; _unidadQuery = ""; _unidadDrop = false; _nuDinamicos.Clear();
            _altaAbierta = false; _nonce++;
            await CargarAsync();
            if (abrir && creada is not null)
            {
                if (creada.EntidadTipo == EntidadDirectorio.Empresa && creada.EmpresaId is Guid eid) Nav.NavigateTo($"/directorio/empresas/{eid}");
                else if (creada.PersonaId != Guid.Empty) await AbrirFichaPersonaAsync(creada.PersonaId, sel.NombreCompleto);
            }
        }
        catch (Exception ex) { _msg = "Error: " + ex.Message; _msgError = true; }
        finally { _busy = false; }
    }

    // El expander abre una ficha RAPIDA en un modal (editar datos, foto, documentos) SIN salir de
    // Residentes. Empresas siguen al Directorio (no tienen ficha rapida todavia).
    private async Task AbrirFicha(ResidenteResumenDto r)
    {
        if (r.EntidadTipo == EntidadDirectorio.Empresa)
        {
            if (r.EmpresaId is Guid eid) Nav.NavigateTo($"/directorio/empresas/{eid}");
            return;
        }
        if (r.PersonaId is Guid pid) await AbrirFichaPersonaAsync(pid, r.Nombre);
    }

    private async Task AbrirFichaPersonaAsync(Guid personaId, string? nombre)
    {
        var parameters = new ModalParameters()
            .Set("Jwt", _jwt).Set("PersonaId", personaId).Set("NombreInicial", nombre);
        var options = new ModalOptions { Width = "720px", Height = "auto" };
        var cambio = await Modals.OpenAsync<FichaResidenteModal, bool>(parameters, options);
        // Si se edito algo (datos/foto/documentos) se refresca la tabla para reflejar el cambio global.
        if (cambio == true) await CargarAsync();
    }

    private static string RolLabel(RolUnidadPersona r) => r switch
    {
        RolUnidadPersona.Propietario => "Propietario",
        RolUnidadPersona.Residente => "Residente",
        RolUnidadPersona.Familiar => "Familiar",
        RolUnidadPersona.Arrendatario => "Arrendatario",
        RolUnidadPersona.Apoderado => "Apoderado",
        _ => r.ToString()
    };

    private RenderFragment RolBadge(RolUnidadPersona r) => builder =>
    {
        var cls = r switch
        {
            RolUnidadPersona.Propietario => "res-rol res-rol-prop",
            RolUnidadPersona.Residente => "res-rol res-rol-resi",
            RolUnidadPersona.Arrendatario => "res-rol res-rol-arr",
            _ => "res-rol res-rol-otro"
        };
        builder.AddMarkupContent(0, $"<span class=\"{cls}\">{RolLabel(r)}</span>");
    };
}

