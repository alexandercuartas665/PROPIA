    // Redimensionar columnas; el ancho PERSISTE por copropiedad en el JSON de Formato (clave "w").
    private readonly Dictionary<string, int> _colW = new(StringComparer.Ordinal);
    private DotNetObjectReference<ResidentesPanel>? _selfR;
    private async Task IniciarResizeR(MouseEventArgs e, string clave)
    {
