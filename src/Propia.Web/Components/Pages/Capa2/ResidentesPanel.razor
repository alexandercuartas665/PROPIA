    private async Task EliminarSelResidentesAsync()
    {
        if (_selR.Count == 0) return;
        _delBusy = true; int ok = 0, fail = 0;
        foreach (var id in _selR.ToList())
        {
            try { var r = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-personas/{id}"); if (r.IsSuccessStatusCode) ok++; else fail++; }
            catch { fail++; }
        }
        _selR.Clear(); _confirmDelSel = false; _delBusy = false;
        _msg = fail == 0 ? $"{ok} residente(s) eliminado(s)." : $"{ok} eliminado(s), {fail} con error."; _msgError = fail != 0;
        await CargarAsync(); StateHasChanged();
    }

