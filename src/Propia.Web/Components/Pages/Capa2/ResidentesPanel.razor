    private string _q = "";

    // Agrupacion
    private string _agruparPor = "";
    private bool _showAgrupar;
    private const string AgruparKey = "propia_residentes_group";

    // Paginacion
    private int _porPagina = 25;
    private int _pagina = 1;

    // Gestor de campos AVANZADO (fallback del "+"/engranaje).
    private bool _configCamposAbierto;
    // El gestor compartido cambio algo (crear/renombrar/ocultar campo): refresca la vista.
    private async Task RecargarCamposAsync() { await CargarAsync(); StateHasChanged(); }

    // Vista Tabla/Tarjetas (canon del sistema), recordada por modulo.
    private string _vista = "tabla";
    private const string VistaKey = "propia_view_residentes";
    private async Task SetVista(string v) { _vista = v; try { await Js.InvokeVoidAsync("localStorage.setItem", VistaKey, v); } catch { } }
    private async Task RestaurarVistaAsync()
    {
        try { var v = await Js.InvokeAsync<string?>("localStorage.getItem", VistaKey); if (v == "tabla" || v == "tarjetas") _vista = v; } catch { }
    }

    // ---------- Campos propios del residente (persona) como columnas dinamicas ----------
    private List<CampoDinDef> _defs = new();
    private Dictionary<Guid, Dictionary<Guid, string?>> _valores = new();   // unidadPersonaId -> (defId -> valor)
    private readonly Dictionary<Guid, string> _nuDinamicos = new();         // captura en la fila de alta
    private List<UsuarioOpc> _usuariosTenant = new();                       // campo Usuario (tenant, RLS)
    private Dictionary<Guid, string> _usuarioNombre = new();                // id -> nombre (Usuario y Directorio)
    private sealed record UsuarioOpc(Guid PersonaId, string NombreCompleto, string? Email);

    private string? ValorDe(Guid registroId, Guid defId)
        => _valores.TryGetValue(registroId, out var d) && d.TryGetValue(defId, out var v) ? v : null;
    private string? NombrePersona(string? val)
        => !string.IsNullOrWhiteSpace(val) && Guid.TryParse(val, out var g) && _usuarioNombre.TryGetValue(g, out var n) ? n : val;
    private void SetDinamicoNuevo(Guid defId, string? valor) => _nuDinamicos[defId] = valor ?? string.Empty;
    private static string? ColorOpcion(CampoDinDef d, string? val)
        => d.OpcionesDetalle().FirstOrDefault(o => string.Equals(o.K, val, StringComparison.Ordinal))?.Color;

    // Directorio en la fila de alta: guarda el id y cachea el nombre para el render inmediato.
    private void OnDirectorioNuevo(Guid defId, PersonaCandidatoDto? c)
    {
        if (c is null) { _nuDinamicos.Remove(defId); return; }
        SetDinamicoNuevo(defId, c.PersonaId.ToString());
        _usuarioNombre[c.PersonaId] = c.NombreCompleto;
    }

    // Catalogo de campos del modulo + valores + config de columnas (unidades-config, entidad 'personas').
    private async Task CargarCamposAsync(HttpClient http)
    {
        var defs = await http.GetFromJsonAsync<List<PersonaCampoDefinicionDto>>("/api/mi-copropiedad/personas-campos") ?? new();
        _defs = defs.OrderBy(d => d.Orden).ThenBy(d => d.Label)
                    .Select(d => new CampoDinDef(d.Id, d.Label, d.Orden, d.Tipo, d.Opciones, d.Descripcion)).ToList();
        var vals = await http.GetFromJsonAsync<List<PersonaCampoValorFlatDto>>("/api/mi-copropiedad/personas-campos-valores") ?? new();
        _valores = vals.GroupBy(v => v.UnidadPersonaId).ToDictionary(g => g.Key, g => g.ToDictionary(x => x.DefinicionId, x => x.Valor));
        try { _usuariosTenant = await http.GetFromJsonAsync<List<UsuarioOpc>>("/api/usuarios") ?? new(); } catch { _usuariosTenant = new(); }
        try
        {
            var vinc = await http.GetFromJsonAsync<List<UsuarioOpc>>("/api/mi-copropiedad/personas-vinculadas") ?? new();
            _usuarioNombre = vinc.GroupBy(x => x.PersonaId).ToDictionary(g => g.Key, g => g.First().NombreCompleto);
        }
        catch { _usuarioNombre = new(); }
        // Config de columnas (orden/visibilidad/alias/ancho) por copropiedad.
        try
        {
            var cfg = await http.GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config?entidad=personas") ?? new();
            _cfgPer = cfg.ToDictionary(c => c.CampoClave, StringComparer.Ordinal);
            HidratarAnchosR();
        }
        catch { _cfgPer = new(StringComparer.Ordinal); }
    }

    // Edicion inline de un campo propio de una fila existente (PUT MERGE al valor del registro).
    private async Task GuardarDinamicoAsync(Guid registroId, Guid defId, string? valor)
    {
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/personas-campos-valores/{registroId}/{defId}", new SetCampoValorRequest(valor));
            if (!resp.IsSuccessStatusCode) { _msg = "No se pudo guardar el campo: " + await resp.Content.ReadAsStringAsync(); _msgError = true; return; }
            if (!_valores.TryGetValue(registroId, out var d)) _valores[registroId] = d = new();
            d[defId] = valor;
        }
        catch (Exception ex) { _msg = "No se pudo guardar el campo: " + ex.Message; _msgError = true; }
    }

    // ---------- Catalogo de columnas de SISTEMA + config compartida (entidad 'personas') ----------
    private sealed record SysColR(string Clave, string Label, TipoCampoTablero Tipo, bool VisibleDefault = true);
    private static readonly SysColR[] SistemaR =
    {
        new("unidad", "Unidad", TipoCampoTablero.Texto),
        new("nombre", "Nombre", TipoCampoTablero.Texto),
        new("documento", "Documento", TipoCampoTablero.Texto),
        new("rol", "Rol", TipoCampoTablero.Seleccion),
        new("telefono", "Telefono", TipoCampoTablero.Telefono),
        new("email", "Email", TipoCampoTablero.Email),
        new("habita", "Habita", TipoCampoTablero.Booleano),
    };
    private static SysColR? SysR(string clave) => SistemaR.FirstOrDefault(c => c.Clave == clave);
    private static bool CenterCol(string clave) => clave is "rol" or "habita";

    private Dictionary<string, UnidadCampoConfigDto> _cfgPer = new(StringComparer.Ordinal);

    private static string ClaveCustom(CampoDinDef c) => "cd:" + c.Id;
    private static bool EsCustom(string clave) => clave.StartsWith("cd:", StringComparison.Ordinal);
    private CampoDinDef? CampoCustom(string clave)
        => EsCustom(clave) && Guid.TryParse(clave[3..], out var g) ? _defs.FirstOrDefault(c => c.Id == g) : null;

    private IEnumerable<string> ClavesCandidatas()
        => SistemaR.Select(c => c.Clave).Concat(_defs.OrderBy(d => d.Orden).Select(ClaveCustom));
    private bool VisibleColDefault(string clave)
        => EsCustom(clave) || (SysR(clave)?.VisibleDefault ?? true);
    private bool VisibleCol(string clave)
        => _cfgPer.TryGetValue(clave, out var c) ? !c.Oculto : VisibleColDefault(clave);
    private int OrdenCol(string clave, int fallback)
        => _cfgPer.TryGetValue(clave, out var c) && c.Orden is { } o ? o : 1000 + fallback;
    private IEnumerable<string> ClavesOrdenadas()
        => ClavesCandidatas().Select((k, i) => (k, ord: OrdenCol(k, i))).OrderBy(x => x.ord).Select(x => x.k);
    private IEnumerable<string> ColsVisibles() => ClavesOrdenadas().Where(VisibleCol);

    private string ColLabel(string clave)
    {
        if (_cfgPer.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias)) return c.Alias!;
        return CampoCustom(clave)?.Label ?? SysR(clave)?.Label ?? clave;
    }
    private static string ColWidth(string clave) => clave switch
    {
        "unidad" => "150px",
        "nombre" => "2fr",
        "documento" => "150px",
        "rol" => "128px",
        "telefono" => "1.1fr",
        "email" => "1.5fr",
        "habita" => "80px",
        _ => "minmax(140px,1fr)"   // campos propios
    };
    private string PerGridStyle => "grid-template-columns: 38px 34px "
        + string.Join(" ", ColsVisibles().Select(k => _colW.TryGetValue(k, out var w) ? w + "px" : ColWidth(k)))
        + " 60px 40px";

    // ---------- Menu "Columnas" inline (orden/visibilidad + borrar DIN). Persistencia identica a
    //            Zonas/Equipos: unidades-config con Entidad="personas". ----------
    private bool _showColMenu;
    private string _colQ = "";
    private bool _colBusy;
    private CampoDinDef? _campoAEliminar;

    private GuardarUnidadCampoConfigRequest FilaConfigR(string clave)
    {
        _cfgPer.TryGetValue(clave, out var c);
        return new GuardarUnidadCampoConfigRequest(clave, c?.Alias, c?.Opciones, c?.Tipo, c?.Formato,
            Oculto: c?.Oculto ?? !VisibleColDefault(clave), Orden: c?.Orden, Entidad: "personas");
    }
    private async Task GuardarCfgRAsync(GuardarUnidadCampoConfigRequest req)
    {
        try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/unidades-config", req); } catch { }
