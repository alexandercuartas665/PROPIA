    private string SortStrR(ResidenteResumenDto r, string k)
    {
        var cd = CampoCustom(k);
        if (cd is not null)
        {
            var v = ValorDe(r.UnidadPersonaId, cd.Id) ?? "";
            return (cd.Tipo == TipoCampoTablero.Directorio || cd.Tipo == TipoCampoTablero.Usuario) ? (NombrePersona(v) ?? v) : v;
        }
        return k switch
        {
            "unidad" => r.UnidadCodigo ?? "",
            "nombre" => r.Nombre ?? "",
            "documento" => r.Documento ?? "",
            "rol" => RolLabel(r.Rol),
            "telefono" => r.Telefono ?? "",
            "email" => r.Email ?? "",
            "habita" => r.Habita ? "Si" : "No",
            _ => ""
        };
