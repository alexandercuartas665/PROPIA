@page "/org/tablero"
@page "/tablero-compartido"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Shared.Auth
@using Propia.Web.Services
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Tablero compartido - PROPIA</PageTitle>

@* Tablero compartido (Capa 1): Kanban cross-tenant que ESPEJA las tareas reales de las
   copropiedades que el usuario administra. Columnas = etapas agrupadas por NOMBRE; al arrastrar,
   la tarea se mueve a la etapa de ese nombre EN SU tenant (si no existe alli, se rechaza).
   Sin tablas propias: el estado siempre vive en el tenant dueno de la tarea. *@

<div class="tc-wrap">
    <div class="tc-head">
        <div>
            <h1>Tablero compartido</h1>
            <p>Las tareas de todas tus copropiedades, en un solo tablero. Cada tarjeta vive en su copropiedad — aquí solo la ves y la mueves.</p>
        </div>
        <button class="tc-btn" @onclick="CargarAsync" disabled="@_cargando" title="Actualizar">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
            Actualizar
        </button>
    </div>

    @if (_sinAcceso)
    {
        <div class="tc-empty">
            <h2>Solo para administradores</h2>
            <p>El tablero compartido reúne las tareas de las copropiedades que administras. Tu usuario no administra ninguna todavía.</p>
        </div>
    }
    else if (_cargando && _dto is null)
    {
        <div class="tc-loading"><div class="tc-spin"></div>Cargando tus copropiedades...</div>
    }
    else if (_dto is not null)
    {
        <div class="tc-filtros">
            @foreach (var c in _dto.Copropiedades)
            {
                <button class="tc-chip @(_filtro.Count == 0 || _filtro.Contains(c.TenantId) ? "on" : "")"
                        @onclick="() => ToggleFiltro(c.TenantId)" title="@c.Nombre">
                    <span class="tc-chip-ava" style="background:@ColorTenant(c.TenantId)">@Inicial(c.Nombre)</span>
                    @c.Nombre <span class="n">@c.Tarjetas</span>
                </button>
            }
            <input class="tc-buscar" placeholder="Buscar tarea..." @bind="_busqueda" @bind:event="oninput" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="tc-error">@_error <button class="x" @onclick="() => _error = null">&times;</button></div>
        }

        @if (TarjetasVisibles().Count == 0)
        {
            <div class="tc-empty">
                <h2>Sin tareas activas</h2>
                <p>@(_dto.Tarjetas.Count == 0 ? "Tus copropiedades no tienen tareas abiertas." : "Ninguna tarea coincide con el filtro.")</p>
            </div>
        }
        else
        {
            <div class="tc-board">
                @foreach (var col in Columnas())
                {
                    <div class="tc-col" ondragover="event.preventDefault()" @ondrop="() => OnDropAsync(col.Nombre)">
                        <div class="tc-col-head">
                            <span class="dot" style="background:@(col.Color ?? "#9AABBE")"></span>
                            <span class="t">@col.Nombre</span>
                            <span class="c">@col.Tarjetas.Count</span>
                        </div>
                        <div class="tc-col-body">
                            @foreach (var t in col.Tarjetas)
                            {
                                <div class="tc-card" draggable="true" @ondragstart="() => OnDragStart(t)">
                                    <div class="tc-card-top">
                                        <span class="tc-copro" style="background:@(ColorTenant(t.TenantId))22; color:@ColorTenant(t.TenantId)" title="@t.TenantNombre">
                                            @Inicial(t.TenantNombre) @Corto(t.TenantNombre)
                                        </span>
                                        <span class="tc-num">@t.NumeroTarea</span>
                                    </div>
                                    <div class="tc-titulo">@t.Titulo</div>
                                    <div class="tc-meta">
                                        @if (!string.IsNullOrEmpty(t.TableroNombre)) { <span>@t.TableroNombre</span> }
                                        @if (!string.IsNullOrEmpty(t.ResponsableNombre)) { <span>@t.ResponsableNombre</span> }
                                        @if (t.FechaVencimiento is DateOnly v)
                                        {
                                            <span class="@(v < DateOnly.FromDateTime(DateTime.Today) ? "vencida" : "")">@v.ToString("dd MMM")</span>
                                        }
                                    </div>
                                    @if (t.Progreso > 0)
                                    {
                                        <div class="tc-prog"><i style="width:@(t.Progreso)%"></i></div>
                                    }
                                    <button class="tc-abrir" title="Abrir en su copropiedad" @onclick="() => AbrirEnTenantAsync(t)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14L21 3"/></svg>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    /* Full-width (convencion de modulos): el tablero respira hasta 1900px */
    .tc-wrap { max-width: 1900px; margin: 0 auto; padding: 22px 26px; }
    .tc-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
    .tc-head h1 { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.01em; }
    .tc-head p { margin: 4px 0 0; color: var(--bs-secondary-color, #7C98B6); font-size: 13.5px; max-width: 72ch; }
    .tc-btn {
        display: inline-flex; align-items: center; gap: 7px; border-radius: 10px; border: 1px solid var(--bs-border-color, #E9EEF3);
        background: var(--bs-body-bg, #fff); color: var(--bs-body-color, #33475B); font-weight: 700; font-size: 13px; padding: 8px 14px; cursor: pointer;
    }
    .tc-btn:hover { border-color: #5955D1; color: #5955D1; }
    .tc-btn[disabled] { opacity: .5; }

    .tc-filtros { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
    .tc-chip {
        display: inline-flex; align-items: center; gap: 7px; border: 1.5px solid var(--bs-border-color, #E9EEF3);
        background: var(--bs-body-bg, #fff); border-radius: 20px; padding: 5px 12px 5px 6px; font-size: 12.5px; font-weight: 700;
        color: var(--bs-secondary-color, #7C98B6); cursor: pointer; opacity: .55;
    }
    .tc-chip.on { opacity: 1; border-color: #D9D2F6; color: var(--bs-body-color, #33475B); }
    .tc-chip-ava { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-size: 11px; font-weight: 800; }
    .tc-chip .n { background: var(--bs-tertiary-bg, #F7F8FB); border-radius: 10px; padding: 1px 7px; font-size: 11px; }
    .tc-buscar {
        margin-left: auto; height: 34px; border-radius: 10px; border: 1.5px solid var(--bs-border-color, #E9EEF3);
        background: var(--bs-body-bg, #fff); padding: 0 12px; font-size: 13px; min-width: 220px; color: var(--bs-body-color, #33475B);
    }
    .tc-buscar:focus { outline: none; border-color: #6D4FE3; }

    .tc-error {
        background: #FDE8E8; color: #C81E1E; border-radius: 10px; padding: 9px 14px; font-size: 13px;
        margin-bottom: 12px; display: flex; align-items: center; gap: 10px;
    }
    .tc-error .x { margin-left: auto; border: 0; background: none; color: inherit; font-size: 16px; cursor: pointer; }

    .tc-board { display: flex; gap: 14px; align-items: flex-start; overflow-x: auto; padding-bottom: 16px; }
    .tc-col { flex: 0 0 300px; background: var(--bs-tertiary-bg, #F4F5F9); border-radius: 14px; padding: 10px; }
    .tc-col-head { display: flex; align-items: center; gap: 8px; padding: 4px 6px 10px; font-size: 13px; font-weight: 800; }
    .tc-col-head .dot { width: 9px; height: 9px; border-radius: 50%; }
    .tc-col-head .c { margin-left: auto; color: var(--bs-secondary-color, #9AABBE); font-weight: 700; font-variant-numeric: tabular-nums; }
    .tc-col-body { display: flex; flex-direction: column; gap: 8px; min-height: 60px; }

    .tc-card {
        position: relative; background: var(--bs-body-bg, #fff); border: 1px solid var(--bs-border-color, #E9EEF3);
        border-radius: 12px; padding: 10px 12px; cursor: grab; transition: box-shadow .12s, transform .12s;
    }
    .tc-card:hover { box-shadow: 0 6px 16px rgba(41,41,75,.10); transform: translateY(-1px); }
    .tc-card-top { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
    .tc-copro { display: inline-flex; align-items: center; gap: 5px; border-radius: 14px; padding: 2px 9px; font-size: 10.5px; font-weight: 800; }
    .tc-num { margin-left: auto; color: var(--bs-secondary-color, #9AABBE); font-size: 11px; font-weight: 700; }
    .tc-titulo { font-size: 13.5px; font-weight: 700; line-height: 1.35; margin-bottom: 6px; }
    .tc-meta { display: flex; flex-wrap: wrap; gap: 4px 10px; color: var(--bs-secondary-color, #7C98B6); font-size: 11.5px; }
    .tc-meta .vencida { color: #C81E1E; font-weight: 800; }
    .tc-prog { height: 5px; border-radius: 4px; background: var(--bs-tertiary-bg, #F7F8FB); margin-top: 8px; overflow: hidden; }
    .tc-prog i { display: block; height: 100%; border-radius: 4px; background: linear-gradient(90deg, #7A77E0, #5955D1); }
    .tc-abrir {
        position: absolute; right: 8px; bottom: 8px; border: 0; background: transparent; color: var(--bs-secondary-color, #9AABBE);
        padding: 4px; border-radius: 7px; cursor: pointer; opacity: 0; transition: opacity .12s;
    }
    .tc-card:hover .tc-abrir { opacity: 1; }
    .tc-abrir:hover { background: #F1ECFD; color: #5955D1; }

    .tc-empty {
        border: 1.5px dashed #D9D2F6; border-radius: 16px; padding: 48px 28px; text-align: center;
        background: var(--bs-body-bg, #fff);
    }
    .tc-empty h2 { margin: 0 0 6px; font-size: 17px; font-weight: 800; }
    .tc-empty p { margin: 0 auto; color: var(--bs-secondary-color, #7C98B6); font-size: 13.5px; max-width: 52ch; }
    .tc-loading { display: flex; align-items: center; gap: 10px; color: var(--bs-secondary-color, #7C98B6); font-size: 13.5px; padding: 40px 0; justify-content: center; }
    .tc-spin { width: 20px; height: 20px; border-radius: 50%; border: 3px solid #F1ECFD; border-top-color: #5955D1; animation: tcSpin .8s linear infinite; }
    @@keyframes tcSpin { to { transform: rotate(360deg); } }
</style>

@code {
    private string? _jwt;
    private bool _cargando = true;
    private bool _sinAcceso;
    private string? _error;
    private string _busqueda = "";
    private TableroDto? _dto;
    private readonly HashSet<Guid> _filtro = new();

    private TarjetaDto? _drag;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            _jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
        }
        catch { }
        if (string.IsNullOrWhiteSpace(_jwt))
        {
            Nav.NavigateTo("/login?returnUrl=%2Forg%2Ftablero", forceLoad: true);
            return;
        }
        await CargarAsync();
        StateHasChanged();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;
        StateHasChanged();
        try
        {
            var resp = await Auth().GetAsync("/api/tablero-compartido");
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevo = await SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (nuevo is null) return;
                _jwt = nuevo;
                resp = await Auth().GetAsync("/api/tablero-compartido");
            }
            if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _sinAcceso = true;
                return;
            }
            if (resp.IsSuccessStatusCode)
            {
                _dto = await resp.Content.ReadFromJsonAsync<TableroDto>();
                _sinAcceso = false;
            }
            else
            {
                _error = "No se pudo cargar el tablero. Intenta de nuevo.";
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; StateHasChanged(); }
    }

    // ---------- columnas: etapas agrupadas por nombre ----------

    private sealed record Columna(string Nombre, string? Color, int Orden, List<TarjetaDto> Tarjetas);

    private List<TarjetaDto> TarjetasVisibles()
    {
        if (_dto is null) return new();
        var q = _dto.Tarjetas.AsEnumerable();
        if (_filtro.Count > 0) q = q.Where(t => _filtro.Contains(t.TenantId));
        var b = _busqueda.Trim();
        if (b.Length > 0)
            q = q.Where(t => t.Titulo.Contains(b, StringComparison.OrdinalIgnoreCase)
                || t.NumeroTarea.Contains(b, StringComparison.OrdinalIgnoreCase)
                || (t.ResponsableNombre?.Contains(b, StringComparison.OrdinalIgnoreCase) ?? false));
        return q.ToList();
    }

    private List<Columna> Columnas()
        => TarjetasVisibles()
            .GroupBy(t => t.EstadoNombre.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new Columna(
                g.First().EstadoNombre.Trim(),
                g.Select(t => t.EstadoColor).FirstOrDefault(c => !string.IsNullOrEmpty(c)),
                g.Min(t => t.EstadoOrden),
                g.OrderBy(t => t.FechaVencimiento ?? DateOnly.MaxValue).ThenBy(t => t.TenantNombre).ToList()))
            .OrderBy(c => c.Orden).ThenBy(c => c.Nombre, StringComparer.OrdinalIgnoreCase)
            .ToList();

    // ---------- drag & drop ----------

    private void OnDragStart(TarjetaDto t) => _drag = t;

    private async Task OnDropAsync(string estadoDestino)
    {
        var t = _drag;
        _drag = null;
        if (t is null || _dto is null) return;
        if (string.Equals(t.EstadoNombre.Trim(), estadoDestino, StringComparison.OrdinalIgnoreCase)) return;
        _error = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/tablero-compartido/mover",
                new { TenantId = t.TenantId, TareaId = t.TareaId, EstadoNombreDestino = estadoDestino });
            if (resp.IsSuccessStatusCode)
            {
                // Optimista: la tarjeta cambia de columna ya; el orden/color fino llega al refrescar.
                var idx = _dto.Tarjetas.FindIndex(x => x.TareaId == t.TareaId && x.TenantId == t.TenantId);
                if (idx >= 0) _dto.Tarjetas[idx] = _dto.Tarjetas[idx] with { EstadoNombre = estadoDestino };
            }
            else
            {
                var r = await resp.Content.ReadFromJsonAsync<MoverResp>();
                _error = r?.Error ?? "No se pudo mover la tarea.";
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        StateHasChanged();
    }

    // ---------- abrir en su copropiedad ----------

    private async Task AbrirEnTenantAsync(TarjetaDto t)
    {
        try
        {
            var resp = await Auth().PostAsJsonAsync("/connect/switch-tenant", new SwitchTenantRequestDto(t.TenantId));
            if (!resp.IsSuccessStatusCode) { _error = "No se pudo cambiar a esa copropiedad."; return; }
            var dto = await resp.Content.ReadFromJsonAsync<LoginResponseDto>();
            if (string.IsNullOrWhiteSpace(dto?.AccessToken)) { _error = "Respuesta inesperada del servidor."; return; }
            await Js.InvokeVoidAsync("propiaAuth.save", dto!.AccessToken, t.TenantId.ToString(), t.TenantNombre);
            Nav.NavigateTo($"/tareas?abrir={t.TareaId}", forceLoad: true);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ---------- helpers ----------

    private static readonly string[] Paleta = { "#5955D1", "#1D63D8", "#16794C", "#A16207", "#C2410C", "#9D174D", "#0E7490", "#6D28D9" };

    private string ColorTenant(Guid tenantId)
    {
        var i = _dto?.Copropiedades.ToList().FindIndex(c => c.TenantId == tenantId) ?? 0;
        return Paleta[Math.Max(0, i) % Paleta.Length];
    }

    private static string Inicial(string? n) => string.IsNullOrWhiteSpace(n) ? "?" : n.Trim()[..1].ToUpperInvariant();

    private static string Corto(string n)
    {
        n = n.Trim();
        return n.Length <= 18 ? n : n[..17] + "…";
    }

    private void ToggleFiltro(Guid tenantId)
    {
        if (!_filtro.Add(tenantId)) _filtro.Remove(tenantId);
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }

    // ---------- DTOs (espejo de Application.TableroCompartido) ----------

    private sealed record TarjetaDto(
        Guid TareaId, Guid TenantId, string TenantNombre, string NumeroTarea, string Titulo, string? Color,
        Guid EstadoId, string EstadoNombre, string? EstadoColor, int EstadoOrden,
        string? TableroNombre, string? ResponsableNombre, DateOnly? FechaVencimiento,
        int Progreso, string Prioridad, bool EsProyecto);

    private sealed record CoproDto(Guid TenantId, string Nombre, string? LogoUrl, int Tarjetas);
    private sealed record TableroDto(List<CoproDto> Copropiedades, List<TarjetaDto> Tarjetas);
    private sealed record MoverResp(bool Ok, string? Error);
}
