@page "/_probe"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@* Pagina minima sin layout para diagnosticar si @onclick funciona. *@

<h1>Probe (@_counter)</h1>
<button @onclick="() => _counter++">Click</button>
<p>Si el contador sube al hacer click, los eventos Blazor estan llegando al servidor.</p>

@code {
    private int _counter = 0;
}
