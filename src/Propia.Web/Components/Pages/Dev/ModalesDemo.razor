@* Pagina de demo para validar el patron de componentes globales.
   Pruebas en /_dev/modales (solo desarrollo). Cuando el patron este probado,
   los modales se invocan desde sus modulos correspondientes. *@

@page "/_dev/modales"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Web.Components.Shared.Modals
@inject IModalService Modals

<div class="dev-page">
    <div class="dev-header">
        <div class="propia-eyebrow">DEVELOPMENT</div>
        <h1>Demo de componentes globales</h1>
        <p>
            Esta pagina prueba el patron <code>IModalService</code> + <code>ModalHost</code>
            con el primer modal piloto. Ver [[00.3. COMPONENTES GLOBALES]] del vault.
        </p>
    </div>

    <div class="dev-card">
        <h2>C.1 ProgramarMantenimientoModal</h2>
        <p>
            Modal piloto basado en el prototipo PROPIA.dc.html L.2402-2426.
            Devuelve <code>MantenimientoProgramado</code> con los datos del formulario,
            o <code>null</code> si el usuario cancela.
        </p>

        <button class="propia-btn-brand" @onclick="AbrirProgramarMantenimiento">
            Programar mantenimiento (demo)
        </button>

        <button class="propia-btn-ghost" @onclick="DebugContador" style="margin-left:8px;">
            Debug click (@_contador)
        </button>

        @if (_ultimoResultado is not null)
        {
            <div class="dev-result">
                <div class="propia-eyebrow">ULTIMO RESULTADO</div>
                <pre>@_ultimoResultadoJson</pre>
            </div>
        }

        @if (_canceladoUltimo)
        {
            <div class="dev-cancelled">
                <span class="propia-badge propia-badge--neutral">Cancelado</span>
                El usuario cerro el modal sin confirmar.
            </div>
        }
    </div>

    <div class="dev-card">
        <h2>Validacion del patron</h2>
        <ul class="dev-checklist">
            <li>Click en "Programar mantenimiento (demo)" abre el modal global</li>
            <li>Backdrop oscuro cubre la pagina (`var(--propia-bg-overlay)`)</li>
            <li>Modal con tipografia Lexend y paleta brand `#6D4FE3`</li>
            <li>Click fuera del modal lo cierra (CloseOnBackdrop=true)</li>
            <li>Tecla Esc no esta implementada aun (V2)</li>
            <li>Confirmar devuelve el draft tipado al caller</li>
            <li>Boton confirmar deshabilitado si falta Proveedor</li>
        </ul>
    </div>
</div>

@* Modal host: vive DENTRO de la pagina para compartir el mismo circuit Scoped
   que el caller. Ver nota en MainLayout.razor L.77-84. *@
<ModalHost />

@code {
    private MantenimientoProgramado? _ultimoResultado;
    private string _ultimoResultadoJson = string.Empty;
    private bool _canceladoUltimo;
    private int _contador = 0;

    private void DebugContador() => _contador++;

    private async Task AbrirProgramarMantenimiento()
    {
        _canceladoUltimo = false;

        var parameters = new ModalParameters()
            .Set("ActivoNombre", "Ascensor Torre A - Otis")
            .Set("ActivoId", Guid.NewGuid())
            .Set("ProveedorPredeterminado", "Otis Colombia SAS")
            .Set("Contratos", new List<ContratoOption>
            {
                new() { Id = Guid.NewGuid(), Nombre = "Contrato Otis - Mantenimiento mensual 2026" },
                new() { Id = Guid.NewGuid(), Nombre = "Contrato Plomeria - Mantenimiento trimestral" }
            });

        var result = await Modals.OpenAsync<ProgramarMantenimientoModal, MantenimientoProgramado>(parameters);

        if (result is null)
        {
            _canceladoUltimo = true;
            return;
        }

        _ultimoResultado = result;
        _ultimoResultadoJson = System.Text.Json.JsonSerializer.Serialize(result,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        StateHasChanged();
    }
}

<style>
