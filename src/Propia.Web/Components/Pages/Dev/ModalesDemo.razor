        max-width: 720px;
        margin: 0 auto;
        padding: 24px;
        font-family: var(--propia-font-base, 'Lexend', sans-serif);
    }

    .dev-header { margin-bottom: 24px; }
    .dev-header h1 {
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -0.6px;
        color: var(--propia-text-h1);
        margin-top: 4px;
    }
    .dev-header p {
        font-size: 14px;
        color: var(--propia-text-secondary);
        line-height: 1.5;
        margin-top: 6px;
    }

    .dev-card {
        background: var(--propia-bg-card);
        border: 1px solid var(--propia-border-card);
        border-radius: var(--propia-radius-card);
        box-shadow: var(--propia-shadow-card);
        padding: 22px 24px;
        margin-bottom: 18px;
    }
    .dev-card h2 {
        font-size: 17px;
        font-weight: 700;
        color: var(--propia-text-h1);
        margin: 0 0 6px;
    }
    .dev-card p {
        font-size: 13.5px;
        color: var(--propia-text-secondary);
        line-height: 1.5;
        margin: 0 0 14px;
    }
    .dev-card code {
        font-family: var(--propia-font-mono);
        font-size: 12px;
        background: var(--propia-brand-soft);
        color: var(--propia-brand-text-2);
