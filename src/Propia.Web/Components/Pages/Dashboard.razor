@page "/dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Nav
<PageTitle>Dashboard - PROPIA</PageTitle>

@* Ruta legada. El dashboard real es el modulo 2.2 (DashboardCopropiedad, /dashboard-copropiedad),
   que consume datos reales de /api/dashboard. Esta pagina antes mostraba datos demo hardcodeados;
   ahora redirige al dashboard real para tener una sola fuente de verdad. *@

@code {
    protected override void OnInitialized() => Nav.NavigateTo("/dashboard-copropiedad", replace: true);
}
