    {
        "nit" => "NIT",
        "razon_social" => "Razón social",
        "nombre_comercial" => "Nombre comercial",
        "numero_identificacion" => "Documento",
        "nombres" => "Nombre",
        "direccion" => "Dirección",
        "ciudad" => "Ciudad",
        "email" => "Correo",
        "telefono" => "Teléfono",
        "actividad_economica" => "Actividad económica",
        "regimen_tributario" => "Régimen tributario",
        "representante_legal_nombres" => "Representante legal",
        "banco" => "Banco",
        "numero_cuenta" => "Cuenta bancaria",
        _ => null
    };

    private static string ExtDe(string nombre, string mime)
    {
        var ext = Path.GetExtension(nombre).TrimStart('.').ToUpperInvariant();
        if (ext.Length is > 0 and <= 4) return ext == "JPEG" ? "JPG" : ext;
        return mime.Contains("pdf", StringComparison.OrdinalIgnoreCase) ? "PDF" : "IMG";
    }

    private static async Task<string> ErrorAsync(HttpResponseMessage resp, string generico = "No se pudo registrar el documento.")
    {
        var txt = await resp.Content.ReadAsStringAsync();
        try { using var doc = System.Text.Json.JsonDocument.Parse(txt); if (doc.RootElement.TryGetProperty("error", out var e)) return e.GetString() ?? generico; } catch { }
        return $"{generico} ({(int)resp.StatusCode})";
    }

    private static string Iniciales(string n)
        => string.Concat(n.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
