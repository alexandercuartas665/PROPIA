@* App.razor - host del Blazor Web App con assets NexLink integrados *@
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6D4FE3" />
    @* Host unificado: la API vive en el MISMO origen que la Web. Vacio => propia-auth.js hace fetch relativo (mismo origen). *@
    <meta name="propia-api-base" content="" />
    <base href="/" />
    <title>PROPIA - Plataforma de Copropiedades</title>

    @* Capa de sesion: hidrata sessionStorage desde localStorage para que el JWT sobreviva al cierre
       del navegador / la pestaña. Debe correr ANTES del auth-guard. *@
    <script src="js/propia-auth.js?v=2"></script>

    @* Marca de plataforma (white-label): aplica el logo/icono configurado en el Super Admin
       a login + sidebar + favicon. Si no hay marca configurada, deja el asset PropIA por defecto. *@
    <script src="js/propia-branding.js?v=1"></script>

    @* Script inline: aplicar theme + estado de sesion + AUTH GUARD ANTES del primer render.
       El guard intercepta accesos sin sesion a rutas protegidas y redirige a /login antes de
       que Blazor renderice el MainLayout (no se ve flash de sidebar/modulos). *@
    <script>
        (function () {
            try {
                // ---- Theme ----
                // D-01: sin preferencia guardada -> 'light' (NO se hereda el prefers-color-scheme del SO,
                // que hacia salir el login en oscuro sin que el usuario lo eligiera). El "Automatico" queda
                // como opcion explicita del menu si se habilita.
                var t = localStorage.getItem('propia_theme');
                if (t !== 'dark' && t !== 'light') { t = 'light'; }
                document.documentElement.setAttribute('data-bs-theme', t);

                // ---- Auth state (para el CSS del CTA del header) ----
                // sessionStorage fue hidratada por propia-auth.js si habia algo en localStorage.
                var hasJwt = !!sessionStorage.getItem('propia_jwt');
                document.documentElement.setAttribute('data-propia-auth', hasJwt ? 'in' : 'out');

                // ---- Auth guard ----
                // Whitelist de rutas publicas (no requieren JWT). Todo lo demas requiere auth.
                // Diseno seguro por defecto: si me olvido de marcar una ruta, queda protegida.
                var path = (window.location.pathname || '/').toLowerCase();
                var publicExact = ['/', '/login', '/registro', '/error', '/signin-google', '/admin/login'];
                var publicPrefix = ['/onboarding/', '/invitacion/', '/c/', '/restaurar', '/olvidaste', '/admin/login/'];
                var isPublic = publicExact.indexOf(path) !== -1
                    || publicPrefix.some(function (p) { return path.indexOf(p) === 0; });

                if (!isPublic) {
                    // El path / no es publico en realidad - lo trato como publico arriba porque
                    // Home redirige a /login y queremos evitar el flash. Si el usuario entra a una
                    // ruta protegida sin JWT (sessionStorage vacia), lo mandamos a /login con
                    // returnUrl para retomar despues.
                    var isAdminArea = path === '/admin' || path.indexOf('/admin/') === 0;
                    // Cualquier sesion valida (cliente o super admin) deja pasar el guard. El
                    // acceso fino lo resuelve cada pagina + la autorizacion del API. Sin esto,
                    // el super admin logueado (propia_admin_jwt) era rebotado desde rutas fuera
                    // de /admin como /panel-plataforma. Mismo criterio que propia-auth.js (commit d9c2c90).
                    var hasRequiredJwt = !!sessionStorage.getItem('propia_jwt') || !!sessionStorage.getItem('propia_admin_jwt');
                    if (!hasRequiredJwt) {
                        var loginUrl = isAdminArea ? '/admin/login' : '/login';
                        var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                        // location.replace evita ensuciar el historial del navegador
                        window.location.replace(loginUrl + '?returnUrl=' + returnUrl);
                        return; // detener el resto del bootstrap
                    }
                }
            } catch (e) { }
        })();
    </script>
    <style>
        /* Bug fix MCP: pre-resolver visibilidad CTA antes de que JS la procese */
        html[data-propia-auth="in"] [data-propia-cta-login] { display: none !important; }
        html[data-propia-auth="in"] [data-propia-cta-logout] { display: inline-flex !important; }
        html[data-propia-auth="out"] [data-propia-cta-logout] { display: none !important; }
        html[data-propia-auth="out"] [data-propia-cta-copropiedad] { display: none !important; }

        /* Overlay de reconexion Blazor: oculto por defecto, visible cuando Blazor aplica las clases de estado */
        #components-reconnect-modal { display: none; }
        #components-reconnect-modal.components-reconnect-show,
        #components-reconnect-modal.components-reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected {
            display: flex; position: fixed; inset: 0; z-index: 20000;
            align-items: center; justify-content: center; background: rgba(20,18,40,.45);
        }
        /* En "reconnecting" el overlay NO aparece de inmediato: se hace visible a los ~2.5s, de modo
           que los microcortes de red se reconectan sin que el usuario vea nada. Los estados
           failed/rejected (ya no reintenta) si se muestran al instante. */
        #components-reconnect-modal.components-reconnect-show { opacity: 0; animation: reconnect-fadein 0s linear 2.5s forwards; }
        #components-reconnect-modal.components-reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected { opacity: 1; }
        @@keyframes reconnect-fadein { to { opacity: 1; } }
        .reconnect-card { background:var(--propia-bg-card); border-radius:14px; padding:24px 28px; text-align:center; box-shadow:0 10px 40px rgba(0,0,0,.2); max-width:340px; font-family:'Lexend',-apple-system,BlinkMacSystemFont,sans-serif; }
        .reconnect-spinner { width:34px; height:34px; border:3px solid var(--propia-border-card); border-top-color:var(--propia-brand); border-radius:50%; margin:0 auto 12px; animation:reconnect-spin .8s linear infinite; }
        @@keyframes reconnect-spin { to { transform: rotate(360deg); } }
        .reconnect-msg { font-size:14px; color:var(--propia-text-h1); font-weight:600; }
        .reconnect-reload { display:none; margin-top:14px; border:0; background:var(--propia-brand); color: var(--propia-text-inverse); padding:9px 17px; border-radius:9px; cursor:pointer; font-size:13px; font-weight:700; box-shadow:0 4px 12px rgba(109,79,227,.3); }
        .reconnect-reload:hover { background:var(--propia-brand-hover); }
        #components-reconnect-modal.components-reconnect-failed .reconnect-spinner,
        #components-reconnect-modal.components-reconnect-rejected .reconnect-spinner { display:none; }
        #components-reconnect-modal.components-reconnect-failed .reconnect-reload,
        #components-reconnect-modal.components-reconnect-rejected .reconnect-reload { display:inline-block; }
    </style>

    @* Fuentes: Lexend (paleta prototipo PROPIA) + Instrument Sans (legacy NexLink) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@@300;400;500;600;700;800&family=Instrument+Sans:ital,wght@@0,400..700;1,400..700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="assets/libs/node-waves/waves.css" />
    @* Cargar directamente los CSS de flaticon sin depender de @@import en cadena
       (Chrome puede no expandir los @@import multi-nivel a tiempo) *@
    <link rel="stylesheet" href="assets/libs/flaticon/css/regular/rounded.css" />
    <link rel="stylesheet" href="assets/libs/flaticon/css/solid/rounded.css" />
    <link rel="stylesheet" href="assets/css/styles.css" />
    @* Design tokens del prototipo PROPIA: paleta + tipografia + radios + sombras.
       Se carga DESPUES de NexLink para poder overridear con variables CSS. *@
    <link rel="stylesheet" href="css/propia-tokens.css?v=5" />
    @* CSS por modulo extraido de los <style> inline (auditoria R-02: fuera del render tree). *@
    <link rel="stylesheet" href="css/modules/tareas.css?v=2" />
    @* V-06: el proyecto NO usa CSS aislado (0 archivos .razor.css), asi que el bundle
       Propia.Web.styles.css no se genera y daba 404 en cada carga. Se retira el link.
       Si se adopta CSS aislado (.razor.css) en el futuro, volver a agregar el <link>. *@

    <link rel="icon" type="image/png" href="img/brand/favicon.png" />
    <link rel="apple-touch-icon" href="img/brand/favicon.png" />
    <meta name="description" content="PROPIA - Plataforma SaaS de gestion integral de copropiedades. Operado por A&D GROUP S.A.S." />
    <meta property="og:title" content="PROPIA - Plataforma de Copropiedades" />
    <meta property="og:description" content="SaaS multi-tenant con WhatsApp nativo, IA integrada y arquitectura de 3 capas." />
    <meta property="og:type" content="website" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />

    @* Overlay de reconexion Blazor Server: Blazor le aplica las clases components-reconnect-*
       cuando el circuito SignalR se cae. Evita el congelamiento SILENCIOSO de la UI (ej. el chat
       quedando en "Pensando..."): muestra un aviso visible y reintenta; si no recupera, ofrece recargar. *@
    <div id="components-reconnect-modal" class="reconnect-modal">
        <div class="reconnect-card">
            <div class="reconnect-spinner"></div>
            <div class="reconnect-msg">Reconectando con el servidor...</div>
            <button class="reconnect-reload" onclick="location.reload()">Recargar pagina</button>
        </div>
    </div>

    @* Scripts NexLink *@
    <script src="assets/libs/jquery/jquery.min.js"></script>
    <script src="assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="assets/libs/node-waves/waves.min.js"></script>

    @* Logica de UI PROPIA (theme switch + sidebar toggle + rail tabs + tooltips del rail) *@
    <script src="js/propia-ui.js?v=9"></script>

    @* SignalR para Conversaciones realtime. CDN para evitar agregar NuGet. *@
    <script src="https://unpkg.com/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="js/propia-chat-hub.js?v=1"></script>

    @* TinyMCE (editor enriquecido para respuestas PQRSD). Build self-hosted por CDN (sin API key). *@
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7.6.0/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="js/propia-tiny.js?v=6"></script>

    @* Blazor framework SIEMPRE despues de los scripts JS de UI. autostart=false para configurar
       la reconexion (mas reintentos) y auto-recargar si definitivamente no recupera. *@
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        (function () {
            // Reconexion tolerante: ~30 intentos cada 3s (~90s) antes de rendirse. Con el circuito
            // retenido en el servidor, al volver de una pestana quieta se reengancha sin recargar.
            Blazor.start({
                circuit: {
                    reconnectionOptions: { maxRetries: 30, retryIntervalMilliseconds: 3000 }
                }
            });
            // Si el overlay llega a failed/rejected (ya no reintenta), recarga sola tras 4s para no
            // dejar al usuario con el boton "Recargar pagina" (que igual se conserva como respaldo).
            var m = document.getElementById('components-reconnect-modal');
            if (m && window.MutationObserver) {
                new MutationObserver(function () {
                    if (m.classList.contains('components-reconnect-failed') || m.classList.contains('components-reconnect-rejected')) {
                        setTimeout(function () {
                            if (m.classList.contains('components-reconnect-failed') || m.classList.contains('components-reconnect-rejected')) {
                                location.reload();
                            }
                        }, 4000);
                    }
                }).observe(m, { attributes: true, attributeFilter: ['class'] });
            }
        })();
    </script>

    @* Tras cada navegacion "enhanced" de Blazor (SPA, sin recargar) el <body> se reemplaza y el
       <head>/atributos de <html> pueden reajustarse: re-aplicamos tema y re-sincronizamos el
       header (CTA Ingresar/Salir) + bindings del sidebar. Esto elimina el efecto de "logueando"
       en cada modulo. Se registra via Blazor.addEventListener (API correcta del evento). *@
    <script>
        (function () {
            function reg() {
                if (window.Blazor && window.Blazor.addEventListener) {
                    window.Blazor.addEventListener('enhancedload', function () {
                        try {
                            var t = localStorage.getItem('propia_theme');
                            if (t === 'dark' || t === 'light') { document.documentElement.setAttribute('data-bs-theme', t); }
                            if (window.propiaUI && window.propiaUI.rebind) { window.propiaUI.rebind(); }
                        } catch (e) { }
                    });
                } else {
                    setTimeout(reg, 50);
                }
            }
            reg();
        })();
    </script>
</body>

</html>
