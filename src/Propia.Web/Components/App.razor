<body>
    <Routes />

    @* Overlay de reconexion Blazor Server: Blazor le aplica las clases components-reconnect-*
       cuando el circuito SignalR se cae. Evita el congelamiento SILENCIOSO de la UI (ej. el chat
       quedando en "Pensando..."): muestra un aviso visible y reintenta; si no recupera, ofrece recargar. *@
    <div id="components-reconnect-modal" class="reconnect-modal">
        <div class="reconnect-card">
            <div class="reconnect-spinner"></div>
            <div class="reconnect-msg">Reconectando con el servidor...</div>
            <button class="reconnect-reload" onclick="location.reload()">Recargar página</button>
        </div>
    </div>

    @* Scripts NexLink *@
    <script src="assets/libs/jquery/jquery.min.js"></script>
    <script src="assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="assets/libs/node-waves/waves.min.js"></script>

    @* Logica de UI PROPIA (theme switch + sidebar toggle + rail tabs + tooltips del rail) *@
    <script src="js/propia-ui.js?v=30"></script>
    <script src="js/propia-sala.js?v=2"></script>
    <script src="js/propia-dictado.js?v=11"></script>

    @* Miniaturas de PDF (carga multiple de contratos/polizas); pdf.js se carga perezoso desde asset local. *@
    <script src="js/propia-pdfthumb.js?v=6"></script>
    <script src="js/propia-iai.js?v=2"></script>

    @* SignalR para Conversaciones realtime. CDN para evitar agregar NuGet. *@
    <script src="https://unpkg.com/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="js/propia-chat-hub.js?v=1"></script>

    @* TinyMCE (editor enriquecido para respuestas PQRSD). Build self-hosted por CDN (sin API key). *@
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7.6.0/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="js/propia-tiny.js?v=8"></script>

    @* Blazor framework SIEMPRE despues de los scripts JS de UI. autostart=false para configurar
       la reconexion (mas reintentos) y auto-recargar si definitivamente no recupera. *@
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        (function () {
            // ---- Modo diagnostico (temporal): activar con ?diag=1 en la URL una vez; persiste en
            // localStorage (apagar con ?diag=0). Solo imprime en consola; no cambia el comportamiento.
            // Sirve para cazar el caso "UI pensando pero server 200": muestra el transporte del
            // circuito (WebSocket vs LongPolling), su traza, y CUALQUIER error JS no capturado que
            // pueda abortar el pintado de la respuesta. ----
            var diag = false;
            try {
                var qs = new URLSearchParams(window.location.search);
                if (qs.get('diag') === '1') { localStorage.setItem('propia_diag', '1'); }
                else if (qs.get('diag') === '0') { localStorage.removeItem('propia_diag'); }
                diag = localStorage.getItem('propia_diag') === '1';
            } catch (e) { }

            var circuitOpts = { reconnectionOptions: { maxRetries: 30, retryIntervalMilliseconds: 3000 } };

            if (diag) {
                console.log('%c[PROPIA-DIAG] modo diagnostico ACTIVO', 'color:blueviolet;font-weight:bold');
                // Errores JS no capturados: un throw aqui puede dejar a Blazor sin aplicar el diff del DOM.
                window.addEventListener('error', function (ev) {
                    console.error('[PROPIA-DIAG] window.error:', ev.message, 'en', ev.filename + ':' + ev.lineno, ev.error);
                });
                window.addEventListener('unhandledrejection', function (ev) {
                    console.error('[PROPIA-DIAG] promesa rechazada:', ev.reason);
                });
                // Traza del SignalR del circuito: imprime el transporte elegido y cada corte/reintento.
                if (window.signalR) {
                    circuitOpts.configureSignalR = function (builder) {
                        try { builder.configureLogging(signalR.LogLevel.Trace); } catch (e) { }
                    };
                }
            }

            // Reconexion tolerante: ~30 intentos cada 3s (~90s) antes de rendirse. Con el circuito
            // retenido en el servidor, al volver de una pestana quieta se reengancha sin recargar.
            Blazor.start({ circuit: circuitOpts });
            // Recarga AUTOMATICA (el boton "Recargar pagina" queda solo de respaldo). Casos:
            //  - failed/rejected (el servidor se reinicio o hubo deploy: el circuito ya no existe) -> recargar
            //    apenas el servidor responda;
            //  - reconectando mas de 15s -> el circuito no vuelve solo; recargar cuando haya servidor.
            // Mientras el overlay esta visible se sondea /health cada 2s (un deploy tarda: un solo intento
            // fallido dejaba al usuario con el boton). Recargar SOLO si el servidor responde: con el servidor
            // caido un reload deja la pagina de error del navegador, que ya no se recupera sola.
            var m = document.getElementById('components-reconnect-modal');
            if (m && window.MutationObserver) {
                var caido = function () { return m.classList.contains('components-reconnect-failed') || m.classList.contains('components-reconnect-rejected'); };
                var visibleOverlay = function () { return caido() || m.classList.contains('components-reconnect-show'); };
                var desde = 0;   // cuando aparecio el overlay (0 = oculto)
                var recargando = false, sondeo = null;
                var recargarSiHayServidor = function () {
                    if (recargando || !visibleOverlay()) return;
                    recargando = true;
                    // /health (GET liviano); la pagina Blazor responde 404 a HEAD.
                    fetch('/health', { cache: 'no-store' })
                        .then(function (r) { if (r.ok && visibleOverlay()) location.reload(); else recargando = false; })
                        .catch(function () { recargando = false; });
                };
                var revisar = function () {
                    if (!visibleOverlay()) { if (sondeo) { clearInterval(sondeo); sondeo = null; } return; }
                    if (caido() || (desde && Date.now() - desde > 15000)) recargarSiHayServidor();
                };
                new MutationObserver(function () {
                    desde = visibleOverlay() ? (desde || Date.now()) : 0;
                    if (visibleOverlay() && !sondeo) sondeo = setInterval(revisar, 2000);
                    if (caido()) revisar();
                }).observe(m, { attributes: true, attributeFilter: ['class'] });

                // Pestana en segundo plano / equipo suspendido: el navegador congela los timers. Al volver a la
                // pestana con el overlay abierto: si ya se rindio, recargar YA (si hay servidor); si no,
                // reintentar la reconexion y dejar que el sondeo decida.
                document.addEventListener('visibilitychange', function () {
                    if (document.visibilityState !== 'visible' || !visibleOverlay()) return;
                    if (caido()) { recargarSiHayServidor(); return; }
                    try { if (window.Blazor && Blazor.reconnect) Blazor.reconnect(); } catch (e) { }
                });
            }
        })();
    </script>

    @* Tras cada navegacion "enhanced" de Blazor (SPA, sin recargar) el <body> se reemplaza y el
       <head>/atributos de <html> pueden reajustarse: re-aplicamos tema y re-sincronizamos el
       header (CTA Ingresar/Salir) + bindings del sidebar. Esto elimina el efecto de "logueando"
       en cada modulo. Se registra via Blazor.addEventListener (API correcta del evento). *@
    <script>
        (function () {
            function reg() {
                if (window.Blazor && window.Blazor.addEventListener) {
                    window.Blazor.addEventListener('enhancedload', function () {
                        try {
                            var t = localStorage.getItem('propia_theme');
                            if (t === 'auto') { t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light'; }
                            if (t === 'dark' || t === 'light') { document.documentElement.setAttribute('data-bs-theme', t); }
                            if (window.propiaUI && window.propiaUI.rebind) { window.propiaUI.rebind(); }
                        } catch (e) { }
                    });
                } else {
                    setTimeout(reg, 50);
                }
            }
            reg();
        })();
    </script>
</body>

</html>

@code {
    // HttpContext disponible en el render estatico (SSR) del host. Se usa para leer la cookie del tema.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Tema con el que sale el HTML del servidor: cookie propia_theme (dark/light). "auto" o ausente -> light
    // (sin sorpresa del SO); el script inline y propia-ui.js afinan segun localStorage/preferencia del sistema.
    private string ThemeInicial =>
        HttpContext?.Request.Cookies.TryGetValue("propia_theme", out var t) == true && t == "dark"
            ? "dark" : "light";
}
