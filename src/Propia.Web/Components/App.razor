@* App.razor - host del Blazor Web App con assets NexLink integrados *@
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#5955D1" />
    @* Meta para que propia-ui.js sepa donde esta el API REST. En Dev https://localhost:7205, en Prod env var *@
    <meta name="propia-api-base" content="https://localhost:7205" />
    <base href="/" />
    <title>PROPIA - Plataforma de Copropiedades</title>

    @* Script inline: aplicar theme guardado ANTES del primer render para evitar FOUC *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('propia_theme');
                if (t !== 'dark' && t !== 'light') {
                    t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { }
        })();
    </script>

    @* NexLink fonts y assets *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@@0,400..700;1,400..700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="assets/libs/node-waves/waves.css" />
    <link rel="stylesheet" href="assets/libs/flaticon/css/all/all.css" />
    <link rel="stylesheet" href="assets/css/styles.css" />
    <link rel="stylesheet" href="@Assets["Propia.Web.styles.css"]" />

    <link rel="icon" type="image/svg+xml" href="favicon-p.svg" />
    <link rel="alternate icon" type="image/png" href="assets/images/favicon.png" />
    <meta name="description" content="PROPIA - Plataforma SaaS de gestion integral de copropiedades. Operado por A&D GROUP S.A.S." />
    <meta property="og:title" content="PROPIA - Plataforma de Copropiedades" />
    <meta property="og:description" content="SaaS multi-tenant con WhatsApp nativo, IA integrada y arquitectura de 3 capas." />
    <meta property="og:type" content="website" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />

    @* Scripts NexLink *@
    <script src="assets/libs/jquery/jquery.min.js"></script>
    <script src="assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="assets/libs/node-waves/waves.min.js"></script>

    @* Logica de UI PROPIA (theme switch + sidebar toggle + rail tabs) *@
    <script src="js/propia-ui.js"></script>

    @* Blazor framework SIEMPRE despues de los scripts JS de UI *@
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
