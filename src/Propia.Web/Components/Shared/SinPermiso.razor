@* Mensaje amable cuando el rol del usuario no tiene permiso para el modulo (HTTP 403).
   Reemplaza el error crudo "Response status code does not indicate success: 403". *@

<div class="card border-0 shadow-sm my-4" style="max-width: 560px; margin-inline: auto;">
    <div class="card-body text-center py-5">
        <div class="mb-3" style="font-size: 2.5rem;">🔒</div>
        <h5 class="mb-2">No tienes acceso a este modulo</h5>
        <p class="text-muted mb-4">
            @Mensaje
        </p>
        <a href="/" class="btn btn-sm" style="background: var(--propia-primary); color:#fff;">Ir al inicio</a>
    </div>
</div>

@code {
    /// <summary>Texto explicativo opcional.</summary>
    [Parameter] public string Mensaje { get; set; } =
        "Tu rol en esta copropiedad no incluye este permiso. Si crees que deberias tener acceso, pidele al Administrador que lo habilite en Roles y Permisos.";
}
