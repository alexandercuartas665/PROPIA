@* Boton "Continuar con Google" para /login y /registro.
   Al hacer click:
   1. Genera state aleatorio + lo guarda en sessionStorage.
   2. Pide al API la URL de challenge de Google (POST /connect/google/start).
   3. Redirige el browser a esa URL (Google).
   Google redirige despues a /signin-google?code=...&state=... (ver SignInGoogle.razor). *@

@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<button type="button" class="btn google-btn w-100 mb-3" @onclick="ContinueAsync" disabled="@_busy">
    @if (_busy)
    {
        <span class="spinner-border spinner-border-sm me-2"></span><span>Conectando con Google...</span>
    }
    else
    {
        <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="me-2">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
        </svg>
        <span>Continuar con Google</span>
    }
</button>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-warning py-2 small mb-3">@_error</div>
}

<style>
    .google-btn {
        background: var(--propia-bg-card);
        border: 1px solid #d6d6e0;
        color: var(--propia-text-h1);
        font-weight: 600;
        padding: 10px 14px;
        border-radius: 8px;
        transition: background .15s, border-color .15s;
    }
    .google-btn:hover:not(:disabled) { background: #f8f7ff; border-color: var(--propia-brand); }
    .google-btn:disabled { opacity: .7; cursor: wait; }
</style>

@code {
    private bool _busy;
    private string? _error;

    private async Task ContinueAsync()
    {
        _busy = true; _error = null;
        try
        {
            var state = Guid.NewGuid().ToString("N");
            await Js.InvokeVoidAsync("sessionStorage.setItem", "propia_google_state", state);

            var redirectUri = $"{Nav.BaseUri.TrimEnd('/')}/signin-google";
            await Js.InvokeVoidAsync("sessionStorage.setItem", "propia_google_redirect_uri", redirectUri);

            var http = HttpFactory.CreateClient("PropiaApi");
            var resp = await http.PostAsJsonAsync("/connect/google/start", new { RedirectUri = redirectUri, State = state });
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                _error = ExtractError(body) ?? "El login con Google no esta disponible.";
                return;
            }
            var dto = await resp.Content.ReadFromJsonAsync<StartResponse>();
            if (dto is null || string.IsNullOrEmpty(dto.AuthorizeUrl))
            {
                _error = "Respuesta inesperada del servidor.";
                return;
            }

            // Redirigir al usuario a Google
            await Js.InvokeVoidAsync("eval", $"window.location.href = '{dto.AuthorizeUrl}'");
        }
        catch (Exception ex) { _error = $"No se pudo iniciar el login con Google: {ex.Message}"; }
        finally { _busy = false; StateHasChanged(); }
    }

    private static string? ExtractError(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("error", out var e)) return e.GetString();
        }
        catch { }
        return null;
    }

    private sealed record StartResponse(string AuthorizeUrl);
}
