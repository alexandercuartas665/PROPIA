@* Barra de progreso del wizard 2.1 - 5 pasos *@

<div class="wizard-progress">
    @for (int i = 1; i <= 5; i++)
    {
        var pasoVisible = i;
        var pasoFormal = pasoVisible <= 1 ? 1
                       : pasoVisible == 2 ? 3
                       : pasoVisible == 3 ? 4
                       : pasoVisible == 4 ? 5
                       : 6;  // Paso 5 = Activacion
        var completado = MapPasoVisible(Paso) > pasoVisible;
        var activo = MapPasoVisible(Paso) == pasoVisible;
        <div class="wizard-step @(completado ? "completed" : "") @(activo ? "active" : "")">
            <div class="wizard-step-dot">@(completado ? "OK" : pasoVisible.ToString())</div>
            <small class="wizard-step-label">@PasoLabels[pasoVisible - 1]</small>
        </div>
        if (i < 5)
        {
            <div class="wizard-step-line @(completado ? "completed" : "")"></div>
        }
    }
</div>

<style>
    .wizard-progress {
        display: flex;
        align-items: center;
        margin-bottom: 2rem;
        padding: 0 0.5rem;
        max-width: 560px;
        width: 100%;
    }
    .wizard-step { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; min-width: 0; }
    .wizard-step-dot {
        width: 32px; height: 32px; border-radius: 50%;
        background: #e6e6ee; color: #6e6e85;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.85rem; font-weight: 600;
        transition: all 0.2s;
    }
    .wizard-step.active .wizard-step-dot {
        background: var(--propia-primary, #5955D1);
        color: white;
        box-shadow: 0 0 0 4px rgba(89, 85, 209, 0.15);
    }
    .wizard-step.completed .wizard-step-dot {
        background: #10b981; color: white;
    }
    .wizard-step-label {
        font-size: 0.7rem;
        color: #6e6e85;
        white-space: nowrap;
        text-align: center;
    }
    .wizard-step.active .wizard-step-label,
    .wizard-step.completed .wizard-step-label { color: #1a1a2e; font-weight: 600; }

    .wizard-step-line {
        flex: 1;
        height: 2px;
        background: #e6e6ee;
        margin: 0 0.4rem;
        margin-top: -1.1rem; /* alineado con los dots */
    }
    .wizard-step-line.completed { background: #10b981; }
</style>

@code {
    [Parameter] public int Paso { get; set; }

    private static readonly string[] PasoLabels =
        { "Registro", "Perfil", "Organizacion", "Copropiedad", "Activacion" };

    // El paso interno usa 1=registro, 2=email, 3=perfil, 4=org, 5=cp, 6=activacion, 99=exito
    // El paso visible es 1..5
    private static int MapPasoVisible(int pasoInterno) => pasoInterno switch
    {
        1 or 2 => 1,
        3 => 2,
        4 => 3,
        5 => 4,
        6 or 99 => 5,
        _ => 1
    };
}
