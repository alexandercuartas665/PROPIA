@* Paso individual dentro de un <ModuloWizard>. Se auto-registra en el wizard
   padre via CascadingParameter. *@

@implements IDisposable

@code {
    [CascadingParameter] private ModuloWizard? Parent { get; set; }

    /// <summary>Titulo corto del paso (mostrado en el stepper).</summary>
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;

    /// <summary>Descripcion opcional, mostrada arriba del contenido al entrar al paso.</summary>
    [Parameter] public string? Descripcion { get; set; }

    /// <summary>Funcion de validacion sincrona - retorna true si se puede avanzar.</summary>
    [Parameter] public Func<bool>? CanAdvance { get; set; }

    /// <summary>Mensaje mostrado si CanAdvance retorna false. Default generico.</summary>
    [Parameter] public string? MensajeError { get; set; }

    /// <summary>Contenido del paso.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal RenderFragment? GetContent() => ChildContent;

    protected override void OnInitialized()
    {
        Parent?.RegisterStep(this);
    }

    public void Dispose()
    {
        Parent?.UnregisterStep(this);
    }
}
