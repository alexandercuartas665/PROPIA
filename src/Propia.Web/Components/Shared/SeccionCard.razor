@* Hito de configuracion estilo prototipo PROPIA.dc.html L.469-490.
   Card con chevron animado, icono brand, titulo + subtitulo y badge estado.

   Con SinAcordeon la tarjeta deja de plegarse: sin chevron, encabezado no clicable y
   cuerpo siempre visible. Es para paginas que muestran los datos directamente. *@

<div class="propia-hito @(Abierta || SinAcordeon ? "propia-hito--abierta" : "")">
    <button class="propia-hito-header @(SinAcordeon ? "propia-hito-header--plano" : "")"
            @onclick="OnToggle" type="button">
        @if (!SinAcordeon)
        {
            <svg class="propia-hito-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M9 6l6 6-6 6" />
            </svg>
        }
        <div class="propia-hito-icon">
            @if (IconoSvg is not null)
            {
                @IconoSvg
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="9" r="3" />
                    <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" />
                </svg>
            }
        </div>
        <div class="propia-hito-texto">
            <div class="propia-hito-titulo">@Titulo</div>
            @if (!string.IsNullOrEmpty(Subtitulo))
            {
                <div class="propia-hito-subtitulo">@Subtitulo</div>
            }
        </div>
        @if (Completa)
        {
            <span class="propia-hito-badge propia-hito-badge--ok">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M5 12l5 5 9-11" />
                </svg>
                Completa
            </span>
        }
        else
        {
            <span class="propia-hito-badge propia-hito-badge--pend">Pendiente</span>
        }
    </button>
    @if (Abierta || SinAcordeon)
    {
        <div class="propia-hito-cuerpo">
            @ChildContent
        </div>
    }
</div>

<style>
    .propia-hito {
        background: var(--propia-bg-card, var(--propia-bg-card));
        border: 1px solid var(--propia-border-card, var(--propia-border-card));
        border-radius: 14px;
        margin-bottom: 12px;
        box-shadow: 0 1px 2px rgba(45, 62, 80, .05);
        overflow: hidden;
        font-family: var(--propia-font-base, 'Lexend', sans-serif);
    }
    .propia-hito-header {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        padding: 18px 22px;
        text-align: left;
        background: transparent;
        border: 0;
        cursor: pointer;
    }
    .propia-hito-header:hover { background: rgba(245, 248, 250, .55); }
    /* Modo plano: el encabezado es solo un rotulo, no invita a hacer clic. */
    .propia-hito-header--plano { cursor: default; pointer-events: none; }
    .propia-hito-header--plano:hover { background: transparent; }
    .propia-hito-chevron {
        color: var(--propia-text-faint);
        transform: rotate(0deg);
        transition: transform .18s;
        flex-shrink: 0;
    }
    .propia-hito--abierta .propia-hito-chevron { transform: rotate(90deg); }
    .propia-hito-icon {
        width: 34px; height: 34px;
        border-radius: 9px;
        background: var(--propia-brand-soft, var(--propia-brand-soft));
        color: var(--propia-brand, var(--propia-brand));
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .propia-hito-texto { flex: 1; min-width: 0; }
    .propia-hito-titulo {
        font-size: 15px; font-weight: 700;
        color: var(--propia-text-h1, var(--propia-text-h1));
        letter-spacing: -0.1px;
    }
    .propia-hito-subtitulo {
        font-size: 12px;
        color: var(--propia-text-mute, var(--propia-text-faint));
        margin-top: 2px;
    }
    .propia-hito-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 700;
        padding: 5px 11px;
        border-radius: 20px;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .propia-hito-badge--ok {
        color: #1A8754;
        background: var(--propia-ok-soft);
    }
    .propia-hito-badge--pend {
        color: #B45309;
        background: #FEF3C7;
    }
    .propia-hito-cuerpo {
        padding: 18px 22px 22px;
        border-top: 1px solid var(--propia-border-divider);
    }

    /* Dark mode */
    [data-bs-theme="dark"] .propia-hito {
        background: var(--propia-bg-card);
        border-color: var(--propia-border-card);
    }
    [data-bs-theme="dark"] .propia-hito-titulo { color: var(--propia-text-body); }
    [data-bs-theme="dark"] .propia-hito-subtitulo { color: #8696B5; }
    [data-bs-theme="dark"] .propia-hito-header:hover { background: rgba(255,255,255,.03); }
    [data-bs-theme="dark"] .propia-hito-cuerpo { border-top-color: var(--propia-border-card); }
</style>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public RenderFragment? IconoSvg { get; set; }
    [Parameter] public bool Completa { get; set; }
    [Parameter] public bool Abierta { get; set; }
    /// <summary>Sin plegado: el cuerpo siempre se ve y el encabezado no responde al clic.</summary>
    [Parameter] public bool SinAcordeon { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
