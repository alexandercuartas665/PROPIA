@* Lista con busqueda estilo Airtable (reemplaza al <select> nativo donde se diligencia rapido con teclado).
   - El disparador es un boton enfocable: con Tab se ve el foco; Enter/Espacio/flecha abajo o empezar a escribir
     abre la caja.
   - La caja es mas grande que la celda, flota con position:fixed anclada al disparador (propiaUI.anchorFloatMenu)
     para no recortarse en tablas con overflow, y trae un buscador: se escribe para filtrar (sin tildes ni
     mayusculas), flechas para moverse, Enter elige, Esc cancela, Tab elige lo resaltado si se escribio algo.
   - Solo deja elegir entre las opciones (no texto libre). Estilos en css/modules/tareas.css (prefijo lbx-).
   - Multiple="true" (etiquetas): casillas para marcar varias; la caja queda abierta mientras se marca
     (clic o Enter sobre lo resaltado), Esc o Tab la cierran. El padre recibe cada cambio por OnToggle(valor)
     y pinta el disparador con TriggerContent (p.ej. los chips).
   - Opcion.Sub (auditoria UX T-01, 2026-11-25): texto secundario en gris (rol, cargo); tambien se busca por el.
   - Opcion.SoloAlBuscar: la opcion no se lista hasta escribir MinLetrasBuscar letras (p.ej. cientos de residentes
     detras del equipo de trabajo); con opciones ocultas se muestra TextoOcultas al pie. *@
@inject IJSRuntime Js

<span class="lbx-wrap @WrapClass" @ref="_wrap">
    <button type="button" id="@_trgId" class="lbx-trg @TriggerClass @(_open ? "lbx-trg--open" : "")" style="@TriggerStyle"
            @ref="_trg" @onclick="() => Abrir(null)" @onkeydown="TrgKeyAsync" disabled="@Disabled" title="@Title" aria-haspopup="listbox" aria-expanded="@(_open ? "true" : "false")">
        @if (TriggerContent is not null)
        {
            @TriggerContent
        }
        else if (Multiple)
        {
            <span class="lbx-trg-tx">@(TextoMultiple())</span>
        }
        else
        {
            <span class="lbx-trg-tx">@(string.IsNullOrEmpty(Valor) && TextoVacio is not null ? TextoVacio : (Actual?.Texto ?? Placeholder))</span>
        }
        @if (Chevron)
        {
            <svg class="lbx-chev" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        }
    </button>
    @if (_open)
    {
        var vis = Filtradas();
        <div class="lbx-pop @(Multiple ? "lbx-pop--multi" : "")" id="@_popId" role="listbox" aria-multiselectable="@(Multiple ? "true" : "false")" @onmousedown:preventDefault="true" @onclick:stopPropagation="true">
            <input class="lbx-q" @ref="_qRef" placeholder="Buscar..." autocomplete="off"
                   @bind="_q" @bind:event="oninput" @bind:after="AlFiltrar"
                   @onkeydown="QKeyAsync" @onblur="AlSalir" />
            <div class="lbx-list">
                @if (vis.Count == 0)
                {
                    <div class="lbx-empty">Sin coincidencias</div>
                }
                @for (var i = 0; i < vis.Count; i++)
                {
                    var o = vis[i]; var idx = i;
                    var marcada = Multiple ? EstaMarcada(o.Valor) : o.Valor == (Valor ?? "");
                    <button type="button" tabindex="-1" class="lbx-it @(idx == _hi ? "hi" : "") @(marcada ? "sel" : "")"
                            role="option" aria-selected="@(marcada ? "true" : "false")"
                            @onmouseenter="() => _hi = idx" @onclick="() => ClicItemAsync(o)">
                        @if (Multiple)
                        {
                            <span class="lbx-cb @(marcada ? "on" : "")">
                                @if (marcada) { <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> }
                            </span>
                        }
                        @if (OpcionesComoChip && !string.IsNullOrWhiteSpace(o.Color))
                        {
                            <span class="lbx-it-tx"><span class="lbx-chip" style="@PaletaChips.ChipEstilo(o.Color)">@o.Texto</span></span>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(o.Color)) { <span class="lbx-dot" style="background:@o.Color"></span> }
                            <span class="lbx-it-tx">@o.Texto</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(o.Sub)) { <span class="lbx-it-sub">@o.Sub</span> }
                        @if (!Multiple && marcada)
                        {
                            <svg class="lbx-ck" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        }
                    </button>
                }
            </div>
            @if (HayOcultas && Norm(_q).Length < MinLetrasBuscar)
            {
                <div class="lbx-hint">@TextoOcultas</div>
            }
        </div>
    }
</span>

@code {
    /// <summary>Opcion de la lista. Valor = lo que se guarda ("" = vacio); Texto = lo que se ve; Color = punto opcional.</summary>
    public record Opcion(string Valor, string Texto, string? Color = null, string? Sub = null, bool SoloAlBuscar = false);

    /// <summary>Letras minimas para mostrar las opciones SoloAlBuscar.</summary>
    [Parameter] public int MinLetrasBuscar { get; set; } = 2;
    /// <summary>Pie de la caja cuando hay opciones que solo aparecen al buscar.</summary>
    [Parameter] public string TextoOcultas { get; set; } = "Escribe 2 letras para ver más opciones.";
    private bool HayOcultas => Opciones.Any(o => o.SoloAlBuscar);

    [Parameter] public IReadOnlyList<Opcion> Opciones { get; set; } = Array.Empty<Opcion>();
    [Parameter] public string? Valor { get; set; }
    [Parameter] public EventCallback<string?> ValorChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Elegir...";
    /// <summary>Texto del disparador cuando no hay valor (p.ej. "-" en celdas de tabla); null = usa la opcion vacia.</summary>
    [Parameter] public string? TextoVacio { get; set; }
    [Parameter] public string TriggerClass { get; set; } = "";
    [Parameter] public string? TriggerStyle { get; set; }
    [Parameter] public bool Chevron { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Seleccion multiple con casillas (etiquetas). Usa Valores + OnToggle en vez de Valor/ValorChanged.</summary>
    /// <summary>true: las opciones con color se muestran como chip pastel de la paleta unica (en vez de punto).</summary>
    [Parameter] public bool OpcionesComoChip { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public IEnumerable<string>? Valores { get; set; }
    /// <summary>Multiple: se dispara al marcar/desmarcar una opcion (con su Valor).</summary>
    [Parameter] public EventCallback<string> OnToggle { get; set; }
    /// <summary>Contenido propio del disparador (chips, icono "+"); si es null se usa el texto de la opcion.</summary>
    [Parameter] public RenderFragment? TriggerContent { get; set; }
    [Parameter] public string? Title { get; set; }
    /// <summary>Clase extra del contenedor (p.ej. "lbx-wrap--inline" para un disparador pequeno como el "+").</summary>
    [Parameter] public string? WrapClass { get; set; }

    private readonly string _trgId = "lbx-t-" + Guid.NewGuid().ToString("N")[..10];
    private readonly string _popId = "lbx-p-" + Guid.NewGuid().ToString("N")[..10];
    private ElementReference _trg, _qRef, _wrap;
    private bool _open, _anclar, _focoTrg, _refocoQ;
    private string _q = "";
    private int _hi;

    private Opcion? Actual => Opciones.FirstOrDefault(o => o.Valor == (Valor ?? ""));
    private bool EstaMarcada(string v) => Valores?.Contains(v) == true;
    private string TextoMultiple()
    {
        var n = Valores?.Count() ?? 0;
        return n == 0 ? (TextoVacio ?? Placeholder) : n == 1 ? (Opciones.FirstOrDefault(o => EstaMarcada(o.Valor))?.Texto ?? "1") : $"{n} seleccionadas";
    }

    private async Task ClicItemAsync(Opcion o)
    {
        if (Multiple) { await OnToggle.InvokeAsync(o.Valor); _refocoQ = true; }
        else await ElegirAsync(o, true);
    }

    private List<Opcion> Filtradas()
    {
        var q = Norm(_q);
        // Opciones SoloAlBuscar: ocultas hasta escribir MinLetrasBuscar letras.
        var fuente = q.Length >= MinLetrasBuscar ? Opciones : Opciones.Where(o => !o.SoloAlBuscar);
        if (q.Length == 0) return fuente.ToList();
        // Buscando: sin la opcion vacia ("Sin valor" no debe ganarle a lo buscado) y primero lo que EMPIEZA por lo
        // escrito, luego una palabra que empieza por ello, luego el resto que lo contiene (orden estable). Tambien
        // encuentra por el texto secundario (Sub: rol, cargo), al final.
        return fuente.Where(o => o.Valor.Length > 0)
            .Select(o => (o, n: Norm(o.Texto), sub: Norm(o.Sub)))
            .Where(x => x.n.Contains(q) || x.sub.Contains(q))
            .OrderBy(x => x.n.StartsWith(q) ? 0 : (" " + x.n).Contains(" " + q) ? 1 : x.n.Contains(q) ? 2 : 3)
            .Select(x => x.o).ToList();
    }

    private void Abrir(string? semilla)
    {
        if (Disabled) return;
        _q = semilla ?? "";
        var vis = Filtradas();
        var i = semilla is null && !Multiple ? vis.FindIndex(o => o.Valor == (Valor ?? "")) : 0;
        _hi = i < 0 ? 0 : i;
        _open = true;
        _anclar = true;
    }

    private void AlFiltrar() => _hi = 0;

    private async Task TrgKeyAsync(KeyboardEventArgs e)
    {
        if (Disabled) return;
        var imprimible = e.Key.Length == 1 && e.Key != " " && !e.CtrlKey && !e.AltKey && !e.MetaKey;
        if (_open)
        {
            // Letras que llegan al disparador mientras el buscador aun no tiene el foco (latencia del circuito):
            // se acumulan en la busqueda en vez de perderse.
            if (imprimible) { _q += e.Key; _hi = 0; }
            return;
        }
        if (e.Key == "ArrowDown") { Abrir(null); return; }
        // Empezar a escribir sobre la celda abre el buscador con esa letra (como Airtable).
        if (imprimible) Abrir(e.Key);
        await Task.CompletedTask;
    }

    private async Task QKeyAsync(KeyboardEventArgs e)
    {
        if (!_open) return;   // tecla que llego con la lista ya cerrada (p.ej. Esc y Tab muy seguidos): no elegir nada
        var vis = Filtradas();
        switch (e.Key)
        {
            case "ArrowDown": if (vis.Count > 0) _hi = Math.Min(_hi + 1, vis.Count - 1); break;
            case "ArrowUp": _hi = Math.Max(_hi - 1, 0); break;
            case "Enter":
                if (vis.Count == 0) break;
                if (Multiple) await OnToggle.InvokeAsync(vis[Math.Clamp(_hi, 0, vis.Count - 1)].Valor);
                else await ElegirAsync(vis[Math.Clamp(_hi, 0, vis.Count - 1)], true);
                break;
            case "Escape": _open = false; _focoTrg = true; break;
            case "Tab":
                // Tab con algo escrito elige lo resaltado; sin escribir, solo sale (deja el valor como estaba).
                // En Multiple, Tab solo cierra (lo marcado ya quedo marcado).
                if (!Multiple && _q.Length > 0 && vis.Count > 0) await ElegirAsync(vis[Math.Clamp(_hi, 0, vis.Count - 1)], false);
                else _open = false;
                break;
        }
    }

    private void AlSalir() => _open = false;

    private async Task ElegirAsync(Opcion o, bool volverAlDisparador)
    {
        _open = false;
        _focoTrg = volverAlDisparador;
        if (o.Valor != (Valor ?? "")) await ValorChanged.InvokeAsync(o.Valor.Length == 0 ? null : o.Valor);
    }

    // El foco se devuelve a la lista SOLO si el usuario sigue en ella (propiaUI.focoSiSigue). Con la latencia de prod,
    // un Tab dado antes de que vuelva el render ya movio el foco a la columna siguiente: antes se lo traia de vuelta
    // ("salta a la fecha y rebota a Etiquetas", Alex 2026-11-23). Si ya se fue, la caja se cierra.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && _anclar)
        {
            _anclar = false;
            try
            {
                await Js.InvokeVoidAsync("propiaUI.anchorFloatMenu", "#" + _trgId, "#" + _popId);
                // foco en el buscador con el cursor al final de lo ya escrito
                if (!await Js.InvokeAsync<bool>("propiaUI.focoSiSigue", _wrap, _qRef, true)) { _open = false; StateHasChanged(); }
            }
            catch { }
        }
        else if (_open && _refocoQ)
        {
            _refocoQ = false;
            try { if (!await Js.InvokeAsync<bool>("propiaUI.focoSiSigue", _wrap, _qRef, false)) { _open = false; StateHasChanged(); } } catch { }
        }
        else if (_focoTrg)
        {
            _focoTrg = false;
            try { await Js.InvokeVoidAsync("propiaUI.focoSiSigue", _wrap, _trg, false); } catch { }
        }
    }

    /// <summary>minusculas + sin tildes, para filtrar de forma tolerante.</summary>
    private static string Norm(string? s)
    {
        s = (s ?? "").Trim().ToLowerInvariant();
        if (s.Length == 0) return s;
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var ch in s.Normalize(System.Text.NormalizationForm.FormD))
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(ch);
        return sb.ToString();
    }
}
