@* ============================================================================================
   EXPLORADOR DE FOLDERS (Documentos v2; replica PROPUESTAS.md seccion 2). Modal grande con 3 columnas:
     ESTRUCTURA (arbol) | DOCUMENTOS (Miniaturas o Tabla, propia_expedientes_vista) | CHAT (ocultable).
   Solo Estructura y Chat se redimensionan (propiaUI.explorerSplits, clave propia.folders.colw.v3); Documentos
   ocupa el centro. El clic en un documento abre el modal "Documento" (.xdv-*: visor + metadatos), que va SOBRE el
   explorador y navega < n / total > entre los documentos del mismo grupo (activos o archivados). Clic derecho en
   una fila o miniatura = menu de acciones. Esc cierra en orden: Cargar -> Versiones -> Documento -> Explorador.
   Responsive: tablet (<=1180px) Estructura | Documentos y el chat como panel que se desliza encima (arranca
   cerrado); celular (<=700px) pantalla completa con pestanas Folders / Documentos (n) / Chat IA.
   La conversacion vive en el API (por copropiedad + folder raiz + usuario). Un documento con archivo NUNCA se
   elimina: se archiva y se puede restaurar.
   ============================================================================================ *@
@using Propia.Application.Documentos
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<div class="doc-ov" @onclick="Cerrar"></div>
<div class="exp-modal fbrowse xf-modal" role="dialog" aria-modal="true" aria-labelledby="xf-title" @onkeydown="OnKey" tabindex="-1">
    <div class="exp-modal-head">
        <div style="display:flex;align-items:center;gap:12px;min-width:0;">
            <div class="exp-modal-icon" style="color:var(--propia-brand);background:var(--propia-brand-soft)"><i class="fi fi-rr-folder-tree"></i></div>
            <div style="min-width:0;">
                <div class="exp-modal-title" id="xf-title">Folders de la copropiedad</div>
                <div class="doc-sub xf-head-sub" style="margin:2px 0 0;">Navega la estructura, abre un documento para verlo y capturar sus metadatos, y conversa con la IA.</div>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:6px">
            <div class="xf-vista" role="group" aria-label="Vista de los documentos">
                <button type="button" class="xf-vista-b @(_vista == "mini" ? "on" : "")" aria-pressed="@((_vista == "mini").ToString().ToLowerInvariant())" title="Ver en miniaturas" @onclick='() => SetVista("mini")'><i class="fi fi-rr-apps"></i><span>Miniaturas</span></button>
                <button type="button" class="xf-vista-b @(_vista == "tabla" ? "on" : "")" aria-pressed="@((_vista == "tabla").ToString().ToLowerInvariant())" title="Ver en tabla" @onclick='() => SetVista("tabla")'><i class="fi fi-rr-list"></i><span>Tabla</span></button>
            </div>
            <button type="button" class="doc-btn-ghost sm xf-chat-tog" @onclick="ToggleChat" title="@(ChatOculto ? "Mostrar chat" : "Ocultar chat")">
                <i class="fi @(ChatOculto ? "fi-rr-comment-alt" : "fi-rr-angle-double-small-right")"></i> @(ChatOculto ? "Mostrar chat" : "Ocultar chat")
            </button>
            <button type="button" class="doc-x" @onclick="Cerrar" aria-label="Cerrar"><i class="fi fi-rr-cross-small"></i></button>
        </div>
    </div>

    @* Celular: las 3 columnas son pestanas (una a la vez); en escritorio/tablet no se ven. *@
    <div class="xf-mtabs" role="tablist">
        <button type="button" role="tab" aria-selected="@((_panel == "struct").ToString().ToLowerInvariant())" class="xf-mtab @(_panel == "struct" ? "on" : "")" @onclick='() => SetPanel("struct")'><i class="fi fi-rr-folder-tree"></i> Folders</button>
        <button type="button" role="tab" aria-selected="@((_panel == "docs").ToString().ToLowerInvariant())" class="xf-mtab @(_panel == "docs" ? "on" : "")" @onclick='() => SetPanel("docs")'><i class="fi fi-rr-document"></i> @("Documentos" + (_detalle is not null ? $" ({_detalle.Documentos.Count})" : ""))</button>
        <button type="button" role="tab" aria-selected="@((_panel == "chat").ToString().ToLowerInvariant())" class="xf-mtab @(_panel == "chat" ? "on" : "")" @onclick='() => SetPanel("chat")'><i class="fi fi-rr-comment-alt"></i> Chat IA</button>
    </div>

    <div class="exp-cols fbrowse-flex xf-p-@(_panel) @(ChatOculto ? "chat-hidden" : "")">
        @* ---------------- Col 1: estructura ---------------- *@
        <div class="exp-col exp-col-struct" style="flex:0 0 222px">
            <div class="exp-col-head"><div class="exp-sec-title">Estructura de folders</div></div>
            <div class="exp-struct-tree" role="tree" aria-label="Estructura de folders">
                @if (_arbol is null) { <div class="doc-sub" style="padding:8px;">Cargando...</div> }
                else { @foreach (var f in _arbol) { @Nodo(f, 0) } }
            </div>
        </div>
        <div class="exp-split" data-resize="struct" data-side="left" title="Arrastra para cambiar el ancho" role="separator" aria-orientation="vertical"><span class="exp-split-grip"><i class="fi fi-rr-grip-dots-vertical"></i></span></div>

        @* ---------------- Col 2: documentos (miniaturas o tabla) ---------------- *@
        <div class="exp-col exp-col-docs xf-docs-wide" style="flex:1 1 0">
            <div class="exp-col-head">
                <div class="exp-sec-title">Documentos @if (_detalle is not null) { <span class="doc-sub">&middot; @_detalle.Nombre</span> }</div>
                @if (!string.IsNullOrEmpty(_detalle?.Radicado)) { <span class="exp-rad" title="Radicado del expediente"><i class="fi fi-rr-hastag"></i>@_detalle.Radicado</span> }
                <button type="button" class="exp-ico-btn" title="Descargar el folder y sus subfolders en un ZIP" @onclick="DescargarZip" disabled="@(_detalle is null || _busyZip)"><i class="fi @(_busyZip ? "fi-rr-spinner" : "fi-rr-folder-download")"></i></button>
            </div>
            @if (_detalle is null)
            {
                <div class="doc-sub" style="padding:10px 16px;">Selecciona un folder en la estructura.</div>
            }
            else
            {
                var enTabla = _vista == "tabla";
                <div class="exp-docs-scroll @(enTabla ? "xft-docs" : "")">
                    @if (_detalle.Documentos.Count == 0)
                    {
                        <div class="doc-sub" style="padding:14px;">Este folder no tiene documentos activos. Cárgalos abajo.</div>
                    }
                    else if (enTabla)
                    {
                        @TablaDocs(_detalle.Documentos, false)
                    }
                    else
                    {
                        <div class="exp-thumbs">
                            @foreach (var d in _detalle.Documentos) { @Miniatura(d, false) }
                        </div>
                    }
                    @if (_detalle.Archivados.Count > 0)
                    {
                        <div class="exp-arch">
                            <button type="button" class="exp-arch-tog" @onclick="() => _verArchivados = !_verArchivados" aria-expanded="@_verArchivados.ToString().ToLowerInvariant()">
                                <i class="fi @(_verArchivados ? "fi-rr-angle-small-down" : "fi-rr-angle-small-right")"></i> Archivados (@_detalle.Archivados.Count)
                            </button>
                            @if (_verArchivados)
                            {
                                if (enTabla) { @TablaDocs(_detalle.Archivados, true) }
                                else
                                {
                                    <div class="exp-thumbs exp-thumbs--arch">
                                        @foreach (var d in _detalle.Archivados) { @Miniatura(d, true) }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="exp-add" style="padding:12px 16px;border-top:1px solid var(--propia-border-divider);">
                    <button type="button" class="doc-btn-primary sm full" @onclick="AbrirCargarNuevo"><i class="fi fi-rr-cloud-upload"></i> Cargar documento</button>
                </div>
            }
        </div>

        @* ---------------- Col 3: chat (ocultable; en celular se pinta si su pestana esta activa) ---------------- *@
        @if (!ChatOculto || _panel == "chat")
        {
            <div class="exp-split" data-resize="chat" data-side="right" title="Arrastra para cambiar el ancho" role="separator" aria-orientation="vertical"><span class="exp-split-grip"><i class="fi fi-rr-grip-dots-vertical"></i></span></div>
            <div class="exp-col exp-col-chat" style="flex:0 0 322px">
                <div class="act-panel">
                    <div class="act-h">
                        <i class="fi fi-rr-comment-alt"></i> Conversar con los documentos
                        <span style="margin-left:auto;display:flex;align-items:center;gap:4px">
                            @if (_chatInfo is not null && !_chatInfo.IaDisponible) { <span class="exp-cap-type cat-otro" title="La IA no está configurada en Super Admin">Sin IA</span> }
                            else if (_chatInfo?.Modelo is not null) { <span class="exp-cap-type cat-sel" title="@($"{_chatInfo.Proveedor} · {_chatInfo.Modelo}")">IA</span> }
                            <button type="button" class="exp-ico-btn" title="Limpiar la conversación" @onclick="LimpiarChat" disabled="@(_chatMsgs.Count == 0 || _chatPensando)"><i class="fi fi-rr-trash"></i></button>
                        </span>
                    </div>
                    <div class="act-chat xf-chat" role="log" aria-live="polite">
                        @if (_chatMsgs.Count == 0 && !_chatCargando)
                        {
                            <div class="act-msg"><span class="act-av">IA</span><div class="act-msg-b"><div class="act-who">Asistente</div><div class="act-bubble">Hola. Puedo responder sobre los documentos de este folder: resumir, decir qué falta o buscar datos dentro de los archivos. Pregúntame lo que necesites.</div></div></div>
                        }
                        @foreach (var m in _chatMsgs)
                        {
                            var mio = m.Rol == "user";
                            <div class="act-msg @(mio ? "mine" : "")">
                                <span class="act-av">@(mio ? "TÚ" : "IA")</span>
                                <div class="act-msg-b">
                                    <div class="act-who">@(mio ? "Tú" : "Asistente")</div>
                                    <div class="act-bubble @(m.Error ? "is-err" : "")">@MdLite(m.Texto)</div>
                                    <div class="act-time">@m.Cuando.LocalDateTime.ToString("dd MMM HH:mm")</div>
                                </div>
                            </div>
                        }
                        @if (_chatPensando) { <div class="act-typing">El asistente está leyendo los documentos...</div> }
                    </div>
                    <div class="act-qr-row">
                        <span class="act-qr-lbl">Respuesta rápida</span>
                        <button type="button" class="act-qr" @onclick='() => EnviarChat("Resume el folder")'>Resume el folder</button>
                        <button type="button" class="act-qr" @onclick='() => EnviarChat("Qué documentos faltan")'>Qué documentos faltan</button>
                        <button type="button" class="act-qr" @onclick='() => EnviarChat("Extrae las fechas clave")'>Extrae las fechas clave</button>
                    </div>
                    <div class="act-composer">
                        <input class="fr-in act-input" placeholder="Pregunta sobre los documentos..." @bind="_chatTexto" @bind:event="oninput" @onkeydown="OnChatKey" aria-label="Mensaje" />
                        <button type="button" class="act-cbtn act-send" title="Enviar" @onclick="() => EnviarChat(null)" disabled="@(string.IsNullOrWhiteSpace(_chatTexto) || _chatPensando)"><i class="fi fi-rr-paper-plane"></i></button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* ===================== Modal "Documento" (visor + metadatos), sobre el explorador ===================== *@
@if (_verDoc && Doc is { } doc && _detalle is { } det)
{
    var grupo = doc.Archivado ? det.Archivados : det.Documentos;
    var gi = grupo.ToList().FindIndex(x => x.Id == doc.Id);
    var prev = gi > 0 ? grupo[gi - 1] : null;
    var next = gi >= 0 && gi < grupo.Count - 1 ? grupo[gi + 1] : null;
    <div class="doc-ov xdv-ov" @onclick="CerrarDocumento"></div>
    <div class="exp-modal xdv-modal" role="dialog" aria-modal="true" aria-labelledby="xdv-title" tabindex="-1" @onkeydown="OnDocKey">
        <div class="exp-modal-head xdv-head">
            <div class="xdv-head-l">
                <div class="xdv-nav">
                    <button type="button" class="exp-ico-btn" title="Documento anterior" disabled="@(prev is null)" @onclick="() => NavDoc(prev)"><i class="fi fi-rr-angle-small-left"></i></button>
                    <span class="xdv-nav-n">@(gi + 1) / @grupo.Count</span>
                    <button type="button" class="exp-ico-btn" title="Documento siguiente" disabled="@(next is null)" @onclick="() => NavDoc(next)"><i class="fi fi-rr-angle-small-right"></i></button>
                </div>
                <div class="doc-ficon sm"><i class="fi fi-rr-document"></i></div>
                <div class="xdv-tit">
                    <div class="exp-modal-title" id="xdv-title">@doc.Nombre @if (doc.Archivado) { <span class="exp-cap-type cat-otro">Archivado</span> }</div>
                    <div class="doc-sub xdv-sub">
                        @(doc.ArchivoNombre ?? "Sin archivo") &middot; @det.Nombre@(string.IsNullOrEmpty(det.Radicado) ? "" : $" ({det.Radicado})")
                        @if (_visorVersionNum > 0) { <text> &middot; versión @_visorVersionNum (anterior) &middot; </text><button type="button" class="exp-ver-link" @onclick="() => CargarVisorActual(doc)">volver a la actual</button> }
                        else if (doc.NumeroVersiones > 1) { <text> &middot; versión actual (v@(doc.NumeroVersiones))</text> }
                    </div>
                </div>
            </div>
            <div class="xdv-acts">
                @if (doc.NumeroVersiones > 0) { <button type="button" class="doc-btn-ghost sm" @onclick="() => VerVersiones(doc)"><i class="fi fi-rr-time-past"></i> Versiones (@doc.NumeroVersiones)</button> }
                @if (!doc.Archivado) { <button type="button" class="doc-btn-soft sm" @onclick="() => AbrirCargarVersion(doc)"><i class="fi fi-rr-cloud-upload"></i> @(doc.Cargado ? "Reemplazar" : "Cargar archivo")</button> }
                <button type="button" class="doc-btn-primary sm" @onclick="() => Descargar(doc)" disabled="@(!doc.Cargado)"><i class="fi fi-rr-download"></i> Descargar</button>
                <button type="button" class="doc-x" @onclick="CerrarDocumento" aria-label="Cerrar"><i class="fi fi-rr-cross-small"></i></button>
            </div>
        </div>
        <div class="xdv-body">
            <div class="xdv-viewer">
                <div class="exp-viewer-body">
                    @if (!doc.Cargado)
                    {
                        <div class="exp-viewer-empty">
                            <i class="fi fi-rr-cloud-upload"></i>
                            <div>Esta casilla aún no tiene archivo.@(doc.Obligatorio ? " Es obligatoria en el folder." : "")</div>
                            @if (!doc.Archivado) { <button type="button" class="doc-btn-primary sm" @onclick="() => AbrirCargarVersion(doc)"><i class="fi fi-rr-cloud-upload"></i> Cargar archivo</button> }
                        </div>
                    }
                    else if (_visorCargando)
                    {
                        <div class="exp-viewer-empty"><i class="fi fi-rr-spinner"></i><div>Cargando documento...</div></div>
                    }
                    else if (_visorKind == "image" && !string.IsNullOrEmpty(_visorDataUri))
                    {
                        <img class="exp-viewer-img" src="@_visorDataUri" alt="@_visorNombre" />
                    }
                    else if (_visorKind == "pdf" && !string.IsNullOrEmpty(_visorDataUri))
                    {
                        <iframe class="exp-viewer-frame" src="@_visorDataUri" title="@_visorNombre"></iframe>
                    }
                    else if (_visorKind == "text")
                    {
                        <pre class="exp-viewer-text">@_visorTexto</pre>
                    }
                    else if (_visorKind == "html" && !string.IsNullOrEmpty(_visorHtml))
                    {
                        <div class="exp-viewer-html">@((MarkupString)_visorHtml)</div>
                    }
                    else
                    {
                        <div class="exp-viewer-empty">
                            <i class="fi fi-rr-file"></i>
                            <div>Vista previa no disponible para este tipo de archivo. Descárgalo para verlo.</div>
                            <button type="button" class="doc-btn-primary sm" @onclick="() => Descargar(doc)"><i class="fi fi-rr-download"></i> Descargar</button>
                        </div>
                    }
                </div>
            </div>
            <div class="xdv-meta">
                <div class="exp-sec-title">Metadatos del documento</div>
                <div class="doc-sub xdv-meta-sub">Captura los valores. Una IA los usa para indexar y buscar dentro del documento.</div>
                @if (_faltan.Count > 0)
                {
                    <div class="exp-cap-warn"><i class="fi fi-rr-exclamation"></i><span>Obligatorios sin valor: @string.Join(", ", _faltan).</span></div>
                }
                @if (_guardadoOk) { <div class="exp-cap-saved"><i class="fi fi-rr-check"></i> Guardado.</div> }
                @if (_capError is not null) { <div class="doc-banner err" style="margin:0 0 10px;">@_capError</div> }
                <div class="exp-cap-scroll xdv-cap-scroll">
                    @if (_esquema is null) { <div class="doc-sub">Cargando...</div> }
                    else if (_esquema.Count == 0) { <div class="doc-sub">Este documento no tiene metadatos definidos. Agrégalos en "Configurar folders".</div> }
                    else
                    {
                        <div class="exp-cap">
                            @foreach (var c in _esquema)
                            {
                                var cc = c;
                                <div class="exp-cap-fld">
                                    <div class="exp-cap-head">
                                        <span class="exp-cap-name">@c.Label@(c.Obligatorio ? " *" : "")</span>
                                        <span class="exp-cap-type @FolderUi.CatClase(c.Tipo)">@FolderUi.TipoCorto(c.Tipo)</span>
                                        @if (!string.IsNullOrEmpty(c.HeredadoDe)) { <span class="doc-sub" style="font-size:10.5px;">&middot; @c.HeredadoDe</span> }
                                    </div>
                                    <FolderCampoInput Campo="cc" Valor="@ValorDe(cc.Id)" ValorChanged="v => GuardarValor(cc, v)" />
                                    @if (!string.IsNullOrEmpty(c.Descripcion)) { <div class="exp-cap-desc"><i class="fi fi-rr-sparkles"></i><span>@c.Descripcion</span></div> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_cargarAbierto)
{
    <CargarDocumentoModal Jwt="@Jwt" FolderId="@_cargarFolderId" DocumentoId="@_cargarDocId" NombreContexto="@_cargarNombre"
                          Cargado="OnCargado" Cerrado="() => _cargarAbierto = false" />
}

@if (_versionesDoc is not null)
{
    var vd = _versionesDoc;
    <div class="doc-ov doc-ov--top" @onclick="() => _versionesDoc = null"></div>
    <div class="doc-modal xv-modal" style="width:min(460px,96vw);" role="dialog" aria-modal="true" aria-labelledby="xv-title" tabindex="-1" @onkeydown="@(e => { if (e.Key == "Escape") _versionesDoc = null; })">
        <div class="doc-modal-head">
            <div style="display:flex;align-items:center;gap:10px;min-width:0;">
                <div class="doc-ficon sm"><i class="fi fi-rr-time-past"></i></div>
                <div style="min-width:0;"><h5 class="mb-0" id="xv-title" style="margin:0">Versiones &middot; @vd.Nombre</h5><div class="doc-sub" style="margin:2px 0 0;">@vd.NumeroVersiones versión(es). Reemplazar el documento crea una nueva y conserva las anteriores.</div></div>
            </div>
            <button type="button" class="doc-x" @onclick="() => _versionesDoc = null" aria-label="Cerrar"><i class="fi fi-rr-cross-small"></i></button>
        </div>
        <div class="doc-modal-body">
            @if (_versiones is null) { <div class="doc-sub">Cargando...</div> }
            else if (_versiones.Count == 0) { <div class="doc-sub">Este documento aún no tiene versiones.</div> }
            else
            {
                <div class="exp-vers-list">
                    @foreach (var v in _versiones)
                    {
                        var vv = v; var cur = v.Numero == vd.NumeroVersiones;
                        <div class="exp-vers-row">
                            <span class="exp-vers-ic @(cur ? "cur" : "")"><i class="fi @(cur ? "fi-rr-badge-check" : "fi-rr-time-past")"></i></span>
                            <div style="flex:1;min-width:0">
                                <div class="exp-vers-name">Versión @v.Numero @if (cur) { <span class="exp-vers-cur">ACTUAL</span> }</div>
                                <div class="exp-vers-meta">@v.CreadoAt.LocalDateTime.ToString("dd MMM yyyy HH:mm") &middot; @v.ArchivoNombre &middot; @FolderUi.FormatBytes(v.ArchivoTamano)@(string.IsNullOrEmpty(v.NotasCambio) ? "" : " · " + v.NotasCambio)</div>
                            </div>
                            <button type="button" class="exp-ico-btn" title="Ver esta versión" @onclick="() => VerVersion(vd, vv)"><i class="fi fi-rr-eye"></i></button>
                            <button type="button" class="exp-ico-btn" title="Descargar esta versión" @onclick="() => DescargarVersion(vd, vv)"><i class="fi fi-rr-download"></i></button>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="doc-modal-foot">
            <button type="button" class="doc-btn-soft" @onclick="() => { var d = vd; _versionesDoc = null; AbrirCargarVersion(d); }" disabled="@vd.Archivado"><i class="fi fi-rr-cloud-upload"></i> Subir nueva versión</button>
            <button type="button" class="doc-btn-primary" @onclick="() => _versionesDoc = null">Cerrar</button>
        </div>
    </div>
}

<TablaCtxMenu Abierto="_ctxOpen" X="_ctxX" Y="_ctxY" Items="_ctxItems" Cerrado="() => _ctxOpen = false" />

@code {
    [Parameter] public string? Jwt { get; set; }
    /// <summary>Folder con el que abre (tarjeta pulsada).</summary>
    [Parameter] public Guid FolderInicial { get; set; }
    [Parameter] public bool ChatOculto { get; set; }
    [Parameter] public EventCallback<bool> ChatOcultoChanged { get; set; }
    [Parameter] public EventCallback Cerrado { get; set; }
    /// <summary>Hubo cambios (cargas, archivados...) para que la pagina recargue tarjetas.</summary>
    [Parameter] public EventCallback Cambio { get; set; }

    private List<FolderNodoDto>? _arbol;
    private readonly HashSet<Guid> _abiertos = new();
    private Guid _sel;
    private FolderDetalleDto? _detalle;
    private Guid _docSel;
    private bool _verArchivados;
    private bool _hubo;
    private bool _busyZip;
    // Vista de los documentos (mini | tabla, propia_expedientes_vista), pestana activa en celular y modal Documento.
    private string _vista = "mini";
    private string _panel = "docs";
    private bool _verDoc, _focoDoc, _focoExplorador;

    // Visor
    private bool _visorCargando;
    private string _visorKind = "none";
    private string? _visorDataUri, _visorHtml, _visorTexto, _visorNombre;
    private int _visorVersionNum;

    // Captura
    private List<FolderCampoDto>? _esquema;
    private readonly Dictionary<Guid, string?> _valores = new();
    private List<string> _faltan = new();
    private bool _guardadoOk;
    private string? _capError;

    // Cargar / versiones
    private bool _cargarAbierto;
    private Guid? _cargarFolderId, _cargarDocId;
    private string? _cargarNombre;
    private FolderDocumentoDto? _versionesDoc;
    private List<FolderVersionDto>? _versiones;

    // Chat (persistente en el API por copropiedad + folder raiz + usuario)
    private string? _chatTexto;
    private bool _chatPensando, _chatCargando, _chatScroll;
    private Guid _chatRaiz;
    private FolderChatDto? _chatInfo;
    private List<FolderChatMensajeDto> _chatMsgs = new();

    private FolderDocumentoDto? Doc => _detalle?.Documentos.Concat(_detalle.Archivados).FirstOrDefault(d => d.Id == _docSel);

    protected override async Task OnInitializedAsync()
    {
        await CargarArbolAsync();
        if (_arbol is { Count: > 0 })
        {
            foreach (var r in _arbol) _abiertos.Add(r.Id);
            var inicial = Buscar(_arbol, FolderInicial) is not null ? FolderInicial : _arbol[0].Id;
            AbrirCadena(inicial);
            await Seleccionar(inicial);
        }
        _chatScroll = true;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        try
        {
            await Js.InvokeVoidAsync("propiaUI.explorerSplits", ".xf-modal", "propia.folders.colw.v3");
            if (first)
            {
                await Js.InvokeVoidAsync("propiaUI.modalFocus", ".xf-modal");
                var v = await Js.InvokeAsync<string?>("localStorage.getItem", "propia_expedientes_vista");
                var ancho = await Js.InvokeAsync<int>("propiaUI.anchoVentana");
                var cambio = false;
                if (v == "tabla") { _vista = "tabla"; cambio = true; }
                // Tablet / celular: el chat arranca cerrado (es un panel que se desliza encima).
                if (ancho <= 1180 && !ChatOculto) { ChatOculto = true; await ChatOcultoChanged.InvokeAsync(true); cambio = true; }
                if (cambio) StateHasChanged();
            }
            // Modal Documento: trampa de foco (Tab) y foco en el propio modal (no en un boton: Esc y flechas quedan aqui).
            if (_focoDoc) { _focoDoc = false; await Js.InvokeVoidAsync("propiaUI.modalFocus", ".xdv-modal"); await Js.InvokeVoidAsync("propiaUI.focusBySelector", ".xdv-modal"); }
            if (_focoExplorador) { _focoExplorador = false; await Js.InvokeVoidAsync("propiaUI.focusBySelector", ".xf-modal"); }
            if (_chatScroll) { _chatScroll = false; await Js.InvokeVoidAsync("propiaUI.scrollBottom", ".xf-chat"); }
        }
        catch { }
    }

    private async Task SetVista(string v)
    {
        _vista = v == "tabla" ? "tabla" : "mini";
        try { await Js.InvokeVoidAsync("localStorage.setItem", "propia_expedientes_vista", _vista); } catch { }
    }

    private void SetPanel(string p) { _panel = p; if (p == "chat") _chatScroll = true; }

    // ===================== Arbol =====================
    private RenderFragment Nodo(FolderNodoDto f, int depth) => __builder =>
    {
        var pad = 8 + depth * 16;
        var tieneHijos = f.Hijos.Count > 0;
        var abierto = _abiertos.Contains(f.Id);
        <div class="ftree-node" role="treeitem" aria-expanded="@(tieneHijos ? abierto.ToString().ToLowerInvariant() : null)" aria-selected="@((_sel == f.Id).ToString().ToLowerInvariant())">
            <div class="ftree-row @(_sel == f.Id ? "sel" : "")" style="padding-left:@(pad)px" tabindex="0" @onclick="() => Seleccionar(f.Id)" @onkeydown="@(e => OnNodoKey(e, f))">
                @if (tieneHijos)
                {
                    <button type="button" class="ftree-caret" aria-label="@(abierto ? "Colapsar" : "Expandir")" @onclick:stopPropagation="true" @onclick="() => Toggle(f.Id)"><i class="fi @(abierto ? "fi-rr-angle-small-down" : "fi-rr-angle-small-right")"></i></button>
                }
                else { <span class="ftree-caret"></span> }
                <i class="fi fi-rr-folder ftree-ic"></i>
                <span class="ftree-name">@f.Nombre</span>
                @if (f.Documentos > 0) { <span class="ftree-count">@f.Documentos</span> }
            </div>
            @if (abierto && tieneHijos)
            {
                <div class="ftree-kids" role="group">@foreach (var h in f.Hijos) { @Nodo(h, depth + 1) }</div>
            }
        </div>
    };

    private static FolderNodoDto? Buscar(IEnumerable<FolderNodoDto>? lista, Guid id)
    {
        if (lista is null) return null;
        foreach (var n in lista) { if (n.Id == id) return n; var h = Buscar(n.Hijos, id); if (h is not null) return h; }
        return null;
    }

    private void AbrirCadena(Guid id)
    {
        // Abre todos los ancestros del folder inicial para que quede visible en el arbol.
        bool Visitar(FolderNodoDto n)
        {
            if (n.Id == id) return true;
            foreach (var h in n.Hijos) if (Visitar(h)) { _abiertos.Add(n.Id); return true; }
            return false;
        }
        foreach (var r in _arbol ?? new()) Visitar(r);
    }

    private void Toggle(Guid id) { if (!_abiertos.Remove(id)) _abiertos.Add(id); }

    private async Task OnNodoKey(KeyboardEventArgs e, FolderNodoDto f)
    {
        if (e.Key == "Enter" || e.Key == " ") await Seleccionar(f.Id);
        else if (e.Key == "ArrowRight" && f.Hijos.Count > 0) _abiertos.Add(f.Id);
        else if (e.Key == "ArrowLeft") _abiertos.Remove(f.Id);
    }

    private async Task CargarArbolAsync()
    {
        try { _arbol = await Auth().GetFromJsonAsync<List<FolderNodoDto>>("/api/folders/arbol") ?? new(); }
        catch { _arbol = new(); }
    }

    private async Task Seleccionar(Guid id)
    {
        _sel = id; _docSel = Guid.Empty; _detalle = null; _esquema = null; _verArchivados = false; _verDoc = false;
        // Celular: si el folder tiene documentos se pasa a la pestana Documentos; si solo tiene subfolders, se
        // despliega en el arbol y se queda en Folders.
        if (Buscar(_arbol, id) is { } n)
        {
            if (n.Documentos + n.Archivados > 0 || n.Hijos.Count == 0) _panel = "docs";
            else { _panel = "struct"; _abiertos.Add(id); }
        }
        LimpiarVisor();
        await CargarDetalleAsync();
        var raiz = RaizDe(id);
        if (raiz != _chatRaiz) { _chatRaiz = raiz; await CargarChatAsync(); }
    }

    /// <summary>Folder raiz (de primer nivel) al que pertenece un folder: la conversacion del chat se guarda por raiz.</summary>
    private Guid RaizDe(Guid id)
    {
        foreach (var r in _arbol ?? new()) if (r.Id == id || Buscar(r.Hijos, id) is not null) return r.Id;
        return id;
    }

    private async Task CargarDetalleAsync()
    {
        try { _detalle = await Auth().GetFromJsonAsync<FolderDetalleDto>($"/api/folders/{_sel}"); }
        catch { _detalle = null; }
    }

    private async Task Recargar()
    {
        _hubo = true;
        await CargarArbolAsync();
        await CargarDetalleAsync();
        if (_docSel != Guid.Empty && Doc is null) { _docSel = Guid.Empty; _verDoc = false; LimpiarVisor(); _esquema = null; }
    }

    // ===================== Documentos (miniaturas) =====================
    private RenderFragment Miniatura(FolderDocumentoDto d, bool archivado) => __builder =>
    {
        var (ext, extClase) = FolderUi.ExtBadge(d.ArchivoNombre);
        var sel = _docSel == d.Id;
        var titulo = archivado ? d.Nombre + " (archivado)" : d.Nombre;
        var clases = "exp-thumb" + (sel ? " sel" : "") + (archivado ? " exp-thumb--arch" : "") + (d.Cargado ? "" : " exp-thumb--vacio");
        <div class="@clases" role="button" tabindex="0" title="@titulo" @onclick="() => SelDoc(d, true)" @onkeydown="e => OnThumbKey(e, d)" @oncontextmenu="e => AbrirCtxDoc(e, d)" @oncontextmenu:preventDefault="true">
            <div class="exp-thumb-paper">
                <div class="exp-thumb-head"><span class="exp-thumb-ext @extClase">@(d.Cargado ? ext : "VACÍO")</span></div>
                <div class="exp-thumb-title">@d.Nombre</div>
                <div class="exp-thumb-lines">@for (var k = 0; k < (archivado ? 5 : 6); k++) { <i style="width:@(52 + (k * 17) % 43)%"></i> }</div>
                @if (archivado)
                {
                    <div class="exp-thumb-archtag"><i class="fi fi-rr-archive"></i> Archivado</div>
                    <div class="exp-thumb-hacts"><button type="button" class="exp-thumb-hact" title="Restaurar documento" @onclick:stopPropagation="true" @onclick="() => Restaurar(d)"><i class="fi fi-rr-rotate-right"></i></button></div>
                }
                else
                {
                    <div class="exp-thumb-hacts">
                        @if (!d.Cargado) { <button type="button" class="exp-thumb-hact is-up" title="Cargar archivo" @onclick:stopPropagation="true" @onclick="() => AbrirCargarVersion(d)"><i class="fi fi-rr-cloud-upload"></i></button> }
                        <button type="button" class="exp-thumb-hact" title="Duplicar documento" @onclick:stopPropagation="true" @onclick="() => Duplicar(d)"><i class="fi fi-rr-copy-alt"></i></button>
                        <button type="button" class="exp-thumb-hact" title="Ver versiones (@d.NumeroVersiones)" @onclick:stopPropagation="true" @onclick="() => VerVersiones(d)"><i class="fi fi-rr-time-past"></i></button>
                        @if (d.Cargado) { <button type="button" class="exp-thumb-hact is-arch" title="Archivar (no se elimina)" @onclick:stopPropagation="true" @onclick="() => Archivar(d)"><i class="fi fi-rr-archive"></i></button> }
                        else { <button type="button" class="exp-thumb-hact is-arch" title="Quitar casilla vacía" @onclick:stopPropagation="true" @onclick="() => QuitarCasilla(d)"><i class="fi fi-rr-trash"></i></button> }
                    </div>
                    @if (d.NumeroVersiones > 1) { <span class="exp-thumb-vbadge" title="@d.NumeroVersiones versiones"><i class="fi fi-rr-time-past"></i> @d.NumeroVersiones</span> }
                    @if (!d.Cargado && d.Obligatorio) { <span class="exp-thumb-oblig">Obligatorio</span> }
                }
            </div>
            <div class="exp-thumb-name">@d.Nombre</div>
            <div class="exp-thumb-sub">@(archivado ? "Archivado" + (d.NumeroVersiones > 1 ? " · v" + d.NumeroVersiones : "") : (d.Cargado ? $"{d.CamposPropios.Count + (d.Valores.Count)} metadato(s)" : "Sin archivo"))</div>
        </div>
    };

    private async Task OnThumbKey(KeyboardEventArgs e, FolderDocumentoDto d) { if (e.Key == "Enter" || e.Key == " ") await SelDoc(d, true); }

    /// <summary>Selecciona un documento (esquema + visor). abrir=true abre el modal Documento.</summary>
    private async Task SelDoc(FolderDocumentoDto d, bool abrir = false)
    {
        _docSel = d.Id; _guardadoOk = false; _capError = null;
        if (abrir) { if (!_verDoc) _focoDoc = true; _verDoc = true; }
        LimpiarVisor();
        await CargarEsquemaAsync(d);
        if (d.Cargado) await CargarVisorActual(d);
    }

    private async Task NavDoc(FolderDocumentoDto? d) { if (d is not null) await SelDoc(d, true); }

    private void CerrarDocumento() { _verDoc = false; _focoExplorador = true; }

    private void OnDocKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _cargarAbierto || _versionesDoc is not null) return; // los cierra su propio modal
        CerrarDocumento();
    }

    // ===================== Vista Tabla de los documentos =====================
    // Clic (o Enter) en la fila abre el modal Documento; las acciones de la miniatura viven en el clic derecho.
    private RenderFragment TablaDocs(IReadOnlyList<FolderDocumentoDto> lista, bool archivados) => __builder =>
    {
        <div class="tblwrap xft-wrap">
            <div class="tblscroll xft-scroll">
                <table class="tbl xft-tbl">
                    <thead><tr><th>DOCUMENTO</th><th>ESTADO</th><th>METADATOS</th><th class="xft-num xft-c-opc">VERSIONES</th><th class="xft-c-opc">ACTUALIZADO</th></tr></thead>
                    <tbody>
                        @foreach (var d in lista)
                        {
                            var dd = d;
                            var (ext, extClase) = FolderUi.ExtBadge(d.ArchivoNombre);
                            var esq = EsquemaEfectivo(d);
                            var capt = esq.Count(c => !string.IsNullOrWhiteSpace(ValorGuardado(d, c.Id)));
                            var faltan = esq.Where(c => c.Obligatorio && string.IsNullOrWhiteSpace(ValorGuardado(d, c.Id))).Select(c => c.Label).ToList();
                            <tr class="xft-row @(_docSel == d.Id ? "sel" : "") @(archivados ? "xft-row--arch" : "")" tabindex="0" title="Abrir el documento · clic derecho para más acciones"
                                @onclick="() => SelDoc(dd, true)" @onkeydown="e => OnThumbKey(e, dd)" @oncontextmenu="e => AbrirCtxDoc(e, dd)" @oncontextmenu:preventDefault="true">
                                <td class="xft-c-doc"><span class="xft-doc"><span class="exp-thumb-ext @extClase">@(d.Cargado ? ext : "VACÍO")</span><span class="xft-2l"><b>@d.Nombre</b>
                                    <small title="@d.ArchivoNombre">@(d.Cargado ? $"{d.ArchivoNombre} · {FolderUi.FormatBytes(d.ArchivoTamano)}" : "Sin archivo cargado")</small></span></span></td>
                                <td>
                                    @if (archivados) { <span class="xft-est xft-est--arch"><i class="fi fi-rr-archive"></i> Archivado</span> }
                                    else if (d.Cargado) { <span class="xft-est xft-est--ok"><i class="fi fi-rr-check-circle"></i> Cargado</span> }
                                    else { <span class="xft-est xft-est--vacio"><i class="fi fi-rr-cloud-upload"></i> @(d.Obligatorio ? "Falta (obligatorio)" : "Sin archivo")</span> }
                                </td>
                                <td>
                                    @if (esq.Count == 0) { <span class="doc-sub">-</span> }
                                    else
                                    {
                                        <span class="xft-meta @(faltan.Count > 0 ? "is-warn" : "")" title="@(faltan.Count > 0 ? "Obligatorios sin valor: " + string.Join(", ", faltan) : null)">@if (faltan.Count > 0) { <i class="fi fi-rr-exclamation"></i><text> </text> }@capt de @esq.Count</span>
                                    }
                                </td>
                                <td class="xft-num xft-c-opc">@(d.NumeroVersiones > 0 ? d.NumeroVersiones.ToString() : "-")</td>
                                <td class="xft-c-opc">@(d.UltimaVersionAt is { } u ? u.LocalDateTime.ToString("dd MMM yyyy") : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="xft-foot">@(lista.Count == 1 ? "1 documento" : $"{lista.Count} documentos")<span class="doc-sub xft-hint-m"> · clic derecho en una fila para más acciones</span><span class="doc-sub xft-hint-t"> · mantén presionada una fila para más acciones</span></div>
        </div>
    };

    // Esquema efectivo de un documento: metadatos heredados de la cadena de folders + los del folder + los propios.
    private List<FolderCampoDto> EsquemaEfectivo(FolderDocumentoDto d)
        => (_detalle?.CamposHeredados ?? Array.Empty<FolderCampoDto>()).Concat(_detalle?.CamposPropios ?? Array.Empty<FolderCampoDto>()).Concat(d.CamposPropios).ToList();

    private static string? ValorGuardado(FolderDocumentoDto d, Guid defId) => d.Valores.FirstOrDefault(v => v.DefinicionId == defId)?.Valor;

    // ===================== Clic derecho en una fila o miniatura =====================
    private bool _ctxOpen;
    private double _ctxX, _ctxY;
    private List<TablaCtxMenu.Item> _ctxItems = new();
    private void AbrirCtxDoc(MouseEventArgs e, FolderDocumentoDto d)
    {
        _ctxX = e.ClientX; _ctxY = e.ClientY;
        var items = new List<TablaCtxMenu.Item> { new("Abrir documento", "fi-rr-eye", OnClick: async () => { await SelDoc(d, true); StateHasChanged(); }) };
        if (d.Archivado)
        {
            items.Add(new(Sep: true));
            items.Add(new("Restaurar documento", "fi-rr-rotate-right", OnClick: async () => { await Restaurar(d); StateHasChanged(); }));
        }
        else
        {
            items.Add(new(d.Cargado ? "Reemplazar archivo" : "Cargar archivo", "fi-rr-cloud-upload", OnClick: () => { AbrirCargarVersion(d); StateHasChanged(); return Task.CompletedTask; }));
            items.Add(new("Duplicar documento", "fi-rr-copy-alt", OnClick: async () => { await Duplicar(d); StateHasChanged(); }));
            items.Add(new($"Ver versiones ({d.NumeroVersiones})", "fi-rr-time-past", OnClick: async () => { await VerVersiones(d); StateHasChanged(); }));
            if (d.Cargado) items.Add(new("Descargar", "fi-rr-download", OnClick: () => Descargar(d)));
            items.Add(new(Sep: true));
            items.Add(d.Cargado
                ? new("Archivar (no se elimina)", "fi-rr-archive", OnClick: async () => { await Archivar(d); StateHasChanged(); })
                : new("Quitar casilla vacía", "fi-rr-trash", Danger: true, OnClick: async () => { await QuitarCasilla(d); StateHasChanged(); }));
        }
        _ctxItems = items;
        _ctxOpen = true;
    }

    private async Task Duplicar(FolderDocumentoDto d)
    {
        var r = await Auth().PostAsync($"/api/folders/documentos/{d.Id}/duplicar", null);
        if (r.IsSuccessStatusCode)
        {
            var nuevo = await r.Content.ReadFromJsonAsync<FolderDocumentoDto>();
            await Recargar();
            if (nuevo is not null) { var n = _detalle?.Documentos.FirstOrDefault(x => x.Id == nuevo.Id); if (n is not null) await SelDoc(n); }
        }
    }

    private async Task Archivar(FolderDocumentoDto d)
    {
        var r = await Auth().PostAsync($"/api/folders/documentos/{d.Id}/archivar", null);
        if (r.IsSuccessStatusCode) { if (_docSel == d.Id) { _docSel = Guid.Empty; _verDoc = false; LimpiarVisor(); _esquema = null; } _verArchivados = true; await Recargar(); }
    }

    private async Task Restaurar(FolderDocumentoDto d)
    {
        var r = await Auth().PostAsync($"/api/folders/documentos/{d.Id}/restaurar", null);
        if (r.IsSuccessStatusCode) await Recargar();
    }

    private async Task QuitarCasilla(FolderDocumentoDto d)
    {
        var r = await Auth().DeleteAsync($"/api/folders/documentos/{d.Id}");
        if (r.IsSuccessStatusCode) { if (_docSel == d.Id) { _docSel = Guid.Empty; _verDoc = false; _esquema = null; } await Recargar(); }
    }

    private void AbrirCargarNuevo()
    {
        if (_detalle is null) return;
        _cargarFolderId = _detalle.Id; _cargarDocId = null; _cargarNombre = _detalle.Nombre; _cargarAbierto = true;
    }

    private void AbrirCargarVersion(FolderDocumentoDto d)
    {
        _cargarFolderId = null; _cargarDocId = d.Id; _cargarNombre = d.Nombre; _cargarAbierto = true;
    }

    private async Task OnCargado(FolderDocumentoDto d)
    {
        _cargarAbierto = false;
        // Indexacion en segundo plano (texto para la IA) para que la primera pregunta no tenga que esperar la extraccion.
        _ = Task.Run(async () => { try { await Auth().PostAsync($"/api/folders/documentos/{d.Id}/indexar", null); } catch { } });
        await Recargar();
        var n = _detalle?.Documentos.FirstOrDefault(x => x.Id == d.Id);
        if (n is not null) await SelDoc(n);
    }

    private async Task DescargarZip()
    {
        if (_detalle is null) return;
        _busyZip = true;
        try
        {
            var bytes = await Auth().GetByteArrayAsync($"/api/folders/{_detalle.Id}/zip");
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", Sanitize(_detalle.Nombre) + ".zip", "application/zip", Convert.ToBase64String(bytes));
        }
        catch { }
        finally { _busyZip = false; }
    }

    // ===================== Visor =====================
    private void LimpiarVisor() { _visorKind = "none"; _visorDataUri = _visorHtml = _visorTexto = _visorNombre = null; _visorVersionNum = 0; _visorCargando = false; }

    private Task CargarVisorActual(FolderDocumentoDto d) { _visorVersionNum = 0; return CargarVisorDesde($"/api/folders/documentos/{d.Id}/preview"); }

    private async Task VerVersion(FolderDocumentoDto d, FolderVersionDto v)
    {
        _versionesDoc = null;
        if (_docSel != d.Id) { _docSel = d.Id; _guardadoOk = false; _capError = null; await CargarEsquemaAsync(d); }
        if (!_verDoc) _focoDoc = true;
        _verDoc = true;
        _visorVersionNum = v.Numero;
        await CargarVisorDesde($"/api/folders/documentos/{d.Id}/versiones/{v.Id}/preview");
    }

    private async Task CargarVisorDesde(string url)
    {
        _visorCargando = true; _visorKind = "none"; _visorDataUri = _visorHtml = _visorTexto = null;
        StateHasChanged();
        try
        {
            var dto = await Auth().GetFromJsonAsync<DocumentoPreviewDto>(url);
            if (dto is not null) { _visorNombre = dto.Nombre; _visorKind = dto.Kind; _visorDataUri = dto.DataUri; _visorHtml = dto.Html; _visorTexto = dto.Texto; }
        }
        catch { _visorKind = "none"; }
        finally { _visorCargando = false; }
    }

    private async Task Descargar(FolderDocumentoDto d)
    {
        try
        {
            var dto = await Auth().GetFromJsonAsync<DescargaDocumentoDto>($"/api/folders/documentos/{d.Id}/descargar");
            if (dto is not null) await Js.InvokeVoidAsync("propiaUI.downloadBase64", dto.NombreArchivo, dto.TipoMime, dto.ContenidoBase64);
        }
        catch { }
    }

    private async Task DescargarVersion(FolderDocumentoDto d, FolderVersionDto v)
    {
        try
        {
            var dto = await Auth().GetFromJsonAsync<DescargaDocumentoDto>($"/api/folders/documentos/{d.Id}/versiones/{v.Id}/descargar");
            if (dto is not null) await Js.InvokeVoidAsync("propiaUI.downloadBase64", dto.NombreArchivo, dto.TipoMime, dto.ContenidoBase64);
        }
        catch { }
    }

    private async Task VerVersiones(FolderDocumentoDto d)
    {
        _versionesDoc = d; _versiones = null;
        try { _versiones = await Auth().GetFromJsonAsync<List<FolderVersionDto>>($"/api/folders/documentos/{d.Id}/versiones") ?? new(); }
        catch { _versiones = new(); }
    }

    // ===================== Captura de metadatos =====================
    private async Task CargarEsquemaAsync(FolderDocumentoDto d)
    {
        _esquema = null; _valores.Clear(); _faltan = new();
        try
        {
            _esquema = await Auth().GetFromJsonAsync<List<FolderCampoDto>>($"/api/folders/documentos/{d.Id}/campos") ?? new();
            var fresco = await Auth().GetFromJsonAsync<FolderDocumentoDto>($"/api/folders/documentos/{d.Id}");
            foreach (var v in (fresco ?? d).Valores) _valores[v.DefinicionId] = v.Valor;
            RecalcularFaltan();
        }
        catch (Exception ex) { _capError = ex.Message; _esquema = new(); }
    }

    private string? ValorDe(Guid id) => _valores.TryGetValue(id, out var v) ? v : null;

    private async Task GuardarValor(FolderCampoDto c, string? v)
    {
        if (Doc is null) return;
        _valores[c.Id] = v; _guardadoOk = false; _capError = null;
        try
        {
            var r = await Auth().PutAsJsonAsync($"/api/folders/documentos/{Doc.Id}/valores",
                new GuardarValoresRequest(new[] { new CampoValorRequest(c.Id, v) }, ValidarObligatorios: false));
            if (!r.IsSuccessStatusCode) { _capError = await LeerError(r); return; }
            _guardadoOk = true; _hubo = true;
            RecalcularFaltan();
        }
        catch (Exception ex) { _capError = ex.Message; }
    }

    private void RecalcularFaltan()
        => _faltan = (_esquema ?? new()).Where(c => c.Obligatorio && string.IsNullOrWhiteSpace(ValorDe(c.Id))).Select(c => c.Label).ToList();

    // ===================== Chat =====================
    private async Task ToggleChat()
    {
        ChatOculto = !ChatOculto;
        await ChatOcultoChanged.InvokeAsync(ChatOculto);
        _chatScroll = !ChatOculto;
    }

    private async Task OnChatKey(KeyboardEventArgs e) { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_chatTexto)) await EnviarChat(null); }

    private async Task CargarChatAsync()
    {
        if (_chatRaiz == Guid.Empty) return;
        _chatCargando = true; _chatMsgs = new();
        try
        {
            _chatInfo = await Auth().GetFromJsonAsync<FolderChatDto>($"/api/folders/{_chatRaiz}/chat");
            _chatMsgs = _chatInfo?.Mensajes.ToList() ?? new();
        }
        catch { _chatInfo = null; }
        finally { _chatCargando = false; _chatScroll = true; }
    }

    private async Task EnviarChat(string? texto)
    {
        var t = (texto ?? _chatTexto ?? "").Trim();
        if (t.Length == 0 || _chatPensando || _chatRaiz == Guid.Empty) return;
        _chatTexto = null;
        _chatMsgs.Add(new FolderChatMensajeDto(Guid.Empty, "user", t, DateTimeOffset.Now, false));
        _chatPensando = true; _chatScroll = true;
        StateHasChanged();
        try
        {
            var r = await Auth().PostAsJsonAsync($"/api/folders/{_chatRaiz}/chat", new EnviarFolderChatRequest(t, _sel == Guid.Empty ? null : _sel));
            if (r.IsSuccessStatusCode)
            {
                var dto = await r.Content.ReadFromJsonAsync<FolderChatRespuestaDto>();
                if (dto is not null)
                {
                    _chatMsgs.RemoveAll(m => m.Id == Guid.Empty);
                    _chatMsgs.Add(dto.Usuario); _chatMsgs.Add(dto.Asistente);
                }
            }
            else _chatMsgs.Add(new FolderChatMensajeDto(Guid.NewGuid(), "assistant", "No pude enviar la pregunta: " + await LeerError(r), DateTimeOffset.Now, true));
        }
        catch (Exception ex) { _chatMsgs.Add(new FolderChatMensajeDto(Guid.NewGuid(), "assistant", "No pude enviar la pregunta: " + ex.Message, DateTimeOffset.Now, true)); }
        finally { _chatPensando = false; _chatScroll = true; }
    }

    /// <summary>
    /// Render minimo y seguro de la respuesta de la IA: escapa HTML y luego convierte **negrita**, `codigo`,
    /// viñetas ("- " / "* " al inicio de linea) y saltos de linea. Sin enlaces ni HTML del modelo.
    /// </summary>
    private static MarkupString MdLite(string? texto)
    {
        if (string.IsNullOrEmpty(texto)) return new MarkupString("");
        var t = System.Net.WebUtility.HtmlEncode(texto.Replace("\r\n", "\n"));
        t = System.Text.RegularExpressions.Regex.Replace(t, @"\*\*(.+?)\*\*", "<b>$1</b>");
        t = System.Text.RegularExpressions.Regex.Replace(t, @"`([^`]+)`", "<code>$1</code>");
        var lineas = t.Split('\n');
        var sb = new System.Text.StringBuilder();
        var enLista = false;
        foreach (var l in lineas)
        {
            var esItem = l.StartsWith("- ") || l.StartsWith("* ") || l.StartsWith("• ");
            if (esItem && !enLista) { sb.Append("<ul>"); enLista = true; }
            if (!esItem && enLista) { sb.Append("</ul>"); enLista = false; }
            if (esItem) sb.Append("<li>").Append(l[2..]).Append("</li>");
            else sb.Append(l).Append("<br/>");
        }
        if (enLista) sb.Append("</ul>");
        var html = sb.ToString();
        if (html.EndsWith("<br/>")) html = html[..^5];
        return new MarkupString(html);
    }

    private async Task LimpiarChat()
    {
        if (_chatRaiz == Guid.Empty) return;
        var r = await Auth().DeleteAsync($"/api/folders/{_chatRaiz}/chat");
        if (r.IsSuccessStatusCode) _chatMsgs = new();
    }

    // ===================== Infra =====================
    private async Task Cerrar()
    {
        if (_hubo) await Cambio.InvokeAsync();
        await Cerrado.InvokeAsync();
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (_cargarAbierto || _versionesDoc is not null) return; // los cierra su propio modal
        if (_verDoc) { CerrarDocumento(); return; }
        await Cerrar();
    }

    private static string Sanitize(string s) { var inv = System.IO.Path.GetInvalidFileNameChars(); return new string(s.Select(c => inv.Contains(c) ? '_' : c).ToArray()); }

    private static async Task<string> LeerError(HttpResponseMessage r)
    {
        var txt = await r.Content.ReadAsStringAsync();
        try { var d = System.Text.Json.JsonDocument.Parse(txt); if (d.RootElement.TryGetProperty("error", out var e)) return e.GetString() ?? txt; } catch { }
        return string.IsNullOrWhiteSpace(txt) ? $"Error {(int)r.StatusCode}" : txt;
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt)) http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }
