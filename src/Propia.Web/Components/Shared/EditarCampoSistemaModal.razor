@* ============================================================================================
   Editor FOCALIZADO de UN campo de SISTEMA (columna fija) de la vista tabla. Lo abre "Editar campo"
   del menu de columna cuando la columna NO es propia. A diferencia de CrearCampoModal (campos propios),
   aqui el TIPO es fijo (solo lectura) y no hay "Eliminar": un campo de sistema no cambia de tipo ni se
   borra. Edita, por copropiedad: alias (nombre visible), descripcion y visibilidad. Persisten en la
   config del tenant ({RutaConfig}, discriminada por 'entidad'); el PUT reemplaza la fila entera, asi
   que se cargan y reenvian los demas campos (opciones/tipo-override/formato/orden) sin tocarlos.
   ============================================================================================ *@
@inject IHttpClientFactory HttpFactory
@using Propia.Domain.Enums
@using Propia.Application.MiCopropiedad
@using Propia.Application.Catalogos

<div class="ecs-back" @onclick="Cerrar">
    <div class="ecs-shell" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
        <div class="ecs-head">
            <div class="ecs-head-ic"><i class="fi fi-rr-table-columns"></i></div>
            <div class="ecs-head-tt">
                <div class="ecs-head-h">Editar campo</div>
                <div class="ecs-head-s">Campo del sistema de @TituloSingular.ToLowerInvariant()</div>
            </div>
            <button class="ecs-x" type="button" @onclick="Cerrar" aria-label="Cerrar"><i class="fi fi-rr-cross-small"></i></button>
        </div>

        <div class="ecs-body">
            <div class="ecs-fld">
                <label>Nombre visible</label>
                <input class="ecs-in" @bind="_alias" @bind:event="oninput" placeholder="@DefLabel" />
                <span class="ecs-hint">Como se muestra la columna en esta copropiedad. Vacio = "@DefLabel".</span>
            </div>

            <div class="ecs-fld">
                <label>Tipo de campo</label>
                <div class="ecs-tipo" title="Los campos del sistema tienen un tipo fijo">
                    <i class="fi fi-rr-lock"></i>
                    <span>@(Tipo is { } t ? TipoLabel(t) : "Campo del sistema")</span>
                    <span class="ecs-tipo-lock">El tipo es fijo</span>
                </div>
            </div>

            @* Campo del sistema tipo LISTA: opciones existentes en SOLO LECTURA (no se quitan ni editan;
               pueden estar en uso) + agregar opciones propias. Se muestra si el padre pasa OpcionesLista
               (modo clasico) o si el modal auto-sirve la lista (ListaCatalogo/SemillaFallback, modo E0). *@
            @if (EfectivasOpciones is not null)
            {
                <div class="ecs-fld">
                    <label>Opciones de la lista</label>
                    @if (EditableInline)
                    {
                        @* Lista auto-servida (catalogo): editor completo inline (reordenar/color/ocultar/renombrar/
                           agregar). Persiste el override del tenant (config Opciones) -> ya NO delega al gestor. *@
                        <OpcionesLista Opciones="_opcsEdit" OpcionesChanged="PersistirOpcsAsync" />
                    }
                    else
                    {
                        <div class="ecs-opts">
                            @if (EfectivasOpciones.Count == 0)
                            {
                                <div class="ecs-opt-empty">Esta lista aun no tiene opciones.</div>
                            }
                            else
                            {
                                @foreach (var o in EfectivasOpciones)
                                {
                                    <div class="ecs-opt ecs-opt--ro" title="Opcion existente (no se puede quitar)">
                                        <span class="ecs-opt-color" style="background:@(string.IsNullOrWhiteSpace(o.Color) ? "var(--propia-border-divider)" : o.Color)"></span>
                                        <span class="ecs-opt-txt">@o.Texto</span>
                                    </div>
                                }
                            }
                        </div>
                        @if (PermiteAgregar)
                        {
                            <div class="ecs-opt-add">
                                <input class="ecs-in" placeholder="Nueva opción..." @bind="_nuevaOpcion" @bind:event="oninput"
                                       @onkeydown="OnNuevaOpcionKey" disabled="@_busy" />
                                <button type="button" class="ecs-btn-soft" @onclick="AgregarOpcionAsync"
                                        disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaOpcion))"><i class="fi fi-rr-plus"></i> Añadir</button>
                            </div>
                            <span class="ecs-hint">No se pueden quitar opciones existentes (pueden estar en uso); solo agregar.</span>
                        }
                        else
                        {
                            <span class="ecs-hint">@HintReadOnly</span>
                        }
                        @if (AbrirGestorAvanzado.HasDelegate)
                        {
                            <div class="ecs-adv" style="margin-top:8px;">
                                <button type="button" class="ecs-btn-ghost" @onclick="AbrirGestor"><i class="fi fi-rr-settings-sliders"></i> Gestionar colores y orden</button>
                            </div>
                        }
                    }
                </div>
            }

            @* Seccion extra opcional especifica del modulo (opt-in; null en el resto). Tareas la usa para la
               configuracion de cierre del campo Etapa (estado de cierre + motivos). *@
            @SeccionExtra

            <div class="ecs-fld">
                <label>Descripción (opcional)</label>
                <textarea class="ecs-in" style="min-height:54px;resize:vertical;" @bind="_descripcion" @bind:event="oninput"
                          placeholder="Nota o ayuda del campo; se muestra en el menu de la columna"></textarea>
            </div>

            <div class="ecs-fld">
                <label>Visibilidad</label>
                <label class="ecs-tog @(Requerido ? "off" : "")" title="@(Requerido ? "Campo obligatorio: no se puede ocultar" : "Mostrar u ocultar la columna en la tabla")">
                    <input type="checkbox" checked="@(!_oculto)" disabled="@Requerido"
                           @onchange="e => _oculto = !(bool)(e.Value ?? false)" />
                    <span>@(_oculto ? "Oculto en la tabla" : "Visible en la tabla")</span>
                    @if (Requerido) { <span class="ecs-req">obligatorio</span> }
                </label>
            </div>

            @* Formato (antes solo estaba en el gestor avanzado): decimales/miles en numericos, max en texto. *@
            @if (Tipo is TipoCampoTablero.Numero or TipoCampoTablero.Moneda or TipoCampoTablero.Porcentaje)
            {
                <div class="ecs-fld">
                    <label>Formato</label>
                    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                        <select class="ecs-in" style="width:120px;" value="@_fmtDec" @onchange="e => _fmtDec = int.TryParse(e.Value?.ToString(), out var n) ? Math.Clamp(n, 0, 6) : 2">
                            @foreach (var d in new[] { 0, 1, 2, 3, 4 }) { <option value="@d" selected="@(_fmtDec == d)">@d decimales</option> }
                        </select>
                        <label class="ecs-tog" style="margin:0;" title="Separador de miles (en las vistas de solo lectura)">
                            <input type="checkbox" checked="@_fmtMiles" @onchange="e => _fmtMiles = (bool)(e.Value ?? false)" />
                            <span>Separador de miles</span>
                        </label>
                        @if (Tipo == TipoCampoTablero.Moneda) { <span class="ecs-req">COP</span> }
                        else if (Tipo == TipoCampoTablero.Porcentaje) { <span class="ecs-req">%</span> }
                    </div>
                </div>
            }
            else if (Tipo is TipoCampoTablero.Texto or TipoCampoTablero.AreaTexto or TipoCampoTablero.Telefono or TipoCampoTablero.Email or TipoCampoTablero.Url)
            {
                <div class="ecs-fld">
                    <label>Máximo de caracteres</label>
                    <input class="ecs-in" type="number" min="1" max="4000" placeholder="sin límite"
                           value="@(_fmtMax?.ToString() ?? "")" @onchange="e => _fmtMax = int.TryParse(e.Value?.ToString(), out var n) && n > 0 ? n : (int?)null" />
                </div>
            }

            @if (!string.IsNullOrEmpty(_msg)) { <div class="ecs-msg">@_msg</div> }
        </div>

        <div class="ecs-foot">
            <span class="ecs-spacer"></span>
            <button type="button" class="ecs-btn-ghost" @onclick="Cerrar" disabled="@_busy">Cancelar</button>
            <button type="button" class="ecs-btn-brand" @onclick="GuardarAsync" disabled="@_busy">
                <i class="fi fi-rr-check"></i> @(_busy ? "Guardando..." : "Guardar cambios")
            </button>
        </div>
    </div>
</div>

@code {
    /// <summary>Clave estable del campo de sistema (ej. "matricula", "telefono").</summary>
    [Parameter, EditorRequired] public string Clave { get; set; } = "";
    /// <summary>Etiqueta por defecto del sistema (placeholder del alias).</summary>
    [Parameter] public string DefLabel { get; set; } = "";
    /// <summary>Tipo del campo (solo lectura). Null = no se conoce; se muestra generico.</summary>
    [Parameter] public TipoCampoTablero? Tipo { get; set; }
    /// <summary>true = campo obligatorio: no se puede ocultar.</summary>
    [Parameter] public bool Requerido { get; set; }
    /// <summary>Ruta base de la config (por defecto "unidades-config"; absoluta si empieza con /api/).</summary>
    [Parameter] public string RutaConfig { get; set; } = "unidades-config";
    /// <summary>Discriminador 'entidad' de la config (ej. "unidad", "personas", "poliza").</summary>
    [Parameter, EditorRequired] public string EntidadConfig { get; set; } = "";
    [Parameter] public string TituloSingular { get; set; } = "registro";
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public EventCallback Guardado { get; set; }
    [Parameter] public EventCallback Cerrado { get; set; }
    /// <summary>Opciones actuales de una lista de SISTEMA (solo lectura). Null = el campo no es lista
    /// (no se muestra la seccion). El padre las provee (semilla + propias) y persiste al agregar.</summary>
    [Parameter] public List<OpcionVista>? OpcionesLista { get; set; }
    /// <summary>Agregar una opcion propia: el padre la persiste (field-specific) y refresca OpcionesLista.</summary>
    [Parameter] public EventCallback<string> OnAgregarOpcion { get; set; }

    // ===== Modo E0 (auto-servir la lista): si el padre NO pasa OpcionesLista pero da ListaCatalogo,
    // el modal arma solo la lista (semilla del catalogo global + override por copropiedad) y "agregar"
    // escribe al override del tenant (config Opciones). Asi cada modulo cablea el modal con ~2 lineas
    // y la opcion nueva aparece tambien en el <select> de la celda (que lee esa misma config). =====
    /// <summary>Clave de lista del catalogo global (ej. "contrato.tipocontrato"). Si se da (y el padre
    /// no pasa OpcionesLista), el modal auto-sirve las opciones desde el catalogo + override del tenant.</summary>
    [Parameter] public string? ListaCatalogo { get; set; }
    /// <summary>Opciones de fabrica de respaldo (labels) si el catalogo no cargo o esta vacio.</summary>
    [Parameter] public string[]? SemillaFallback { get; set; }
    /// <summary>false = lista de SOLO LECTURA (se muestra pero no se agrega desde aqui; p.ej. listas atadas
    /// a enum del sistema cuyo universo no se amplia por copropiedad). Default true.</summary>
    [Parameter] public bool PermiteAgregar { get; set; } = true;
    /// <summary>Texto bajo la lista cuando PermiteAgregar=false: explica DONDE se administra ese universo
    /// (ej. Roles del usuario -> "Roles y permisos"). Default: consola A&D (Super Admin).</summary>
    [Parameter] public string HintReadOnly { get; set; } = "Las opciones de esta lista se administran en la consola A&D (Super Admin).";
    /// <summary>Si se pasa, muestra un boton "Gestionar colores y orden" que delega al gestor avanzado del
    /// padre (p.ej. el editor por-tablero de estados/prioridades/etiquetas de Tareas). Opcional.</summary>
    [Parameter] public EventCallback AbrirGestorAvanzado { get; set; }
    /// <summary>Seccion extra opcional especifica del modulo, renderizada tras la lista de opciones (opt-in;
    /// null en los modulos que no la usan). Tareas la usa para la config de cierre del campo Etapa.</summary>
    [Parameter] public RenderFragment? SeccionExtra { get; set; }

    /// <summary>Opcion de lista para mostrar en solo lectura (texto + color opcional).</summary>
    public sealed record OpcionVista(string Texto, string? Color = null);

    private string _nuevaOpcion = "";
    private string _alias = "";
    private string _descripcion = "";
    private bool _oculto;
    private int _fmtDec = 2;      // decimales (numericos)
    private bool _fmtMiles;       // separador de miles (numericos)
    private int? _fmtMax;         // max caracteres (texto)
    private UnidadCampoConfigDto? _actual;   // fila actual (para preservar opciones/tipo/formato/orden)
    private bool _busy;
    private string? _msg;

    // Formato del campo (mismo JSON que escribia el gestor avanzado): {Dec, Miles, Max}.
    private sealed record FmtCfg(int? Dec = null, bool Miles = false, string? Moneda = null, int? Max = null);
    private static FmtCfg ParseFmt(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new FmtCfg();
        try { return System.Text.Json.JsonSerializer.Deserialize<FmtCfg>(json) ?? new FmtCfg(); } catch { return new FmtCfg(); }
    }
    // FUSIONA el formato con el JSON existente (preserva "w" = ancho de columna y otras claves). Numerico ->
    // Dec/Miles; texto -> Max; otros tipos conservan el formato previo intacto.
    private string? FormatoActual()
    {
        bool num = Tipo is TipoCampoTablero.Numero or TipoCampoTablero.Moneda or TipoCampoTablero.Porcentaje;
        bool txt = Tipo is TipoCampoTablero.Texto or TipoCampoTablero.AreaTexto or TipoCampoTablero.Telefono or TipoCampoTablero.Email or TipoCampoTablero.Url;
        if (!num && !txt) return _actual?.Formato;
        System.Text.Json.Nodes.JsonObject o;
        try { o = string.IsNullOrWhiteSpace(_actual?.Formato) ? new() : (System.Text.Json.Nodes.JsonNode.Parse(_actual!.Formato!) as System.Text.Json.Nodes.JsonObject ?? new()); }
        catch { o = new(); }
        if (num) { o["Dec"] = _fmtDec; o["Miles"] = _fmtMiles; o.Remove("Max"); }
        else { if (_fmtMax is int m) o["Max"] = m; else o.Remove("Max"); o.Remove("Dec"); o.Remove("Miles"); o.Remove("Moneda"); }
        return o.Count == 0 ? null : o.ToJsonString();
    }

    // Modo E0: lista que arma el propio modal (null = no auto-servido) + JSON de override vigente.
    private List<OpcionVista>? _opcionesSelf;
    private string? _opcionesJson;
    private bool AutoServido => OpcionesLista is null && Tipo == TipoCampoTablero.Seleccion
                                 && (!string.IsNullOrWhiteSpace(ListaCatalogo) || (SemillaFallback is { Length: > 0 }));
    // Lista efectiva a mostrar: la del padre (modo clasico) o la auto-servida (modo E0).
    private List<OpcionVista>? EfectivasOpciones => OpcionesLista ?? _opcionesSelf;

    // Edicion inline COMPLETA (reordenar/color/ocultar) SOLO en el modo auto-servido (catalogo): ahi el override
    // usa el formato OpcionCampo [{K,Oculta,Color}] y el modal ya lo persiste. En el modo clasico los formatos
    // de override son heterogeneos por modulo (p.ej. Directorio etiquetas = List<string>), por eso NO se generaliza.
    private bool EditableInline => AutoServido && PermiteAgregar;
    private readonly List<OpcionCampo> _opcsEdit = new();   // lista editable (full, incl ocultas) del modo auto-servido

    private string CfgUrl => RutaConfig.StartsWith("/api/", StringComparison.OrdinalIgnoreCase)
        ? RutaConfig : $"/api/mi-copropiedad/{RutaConfig}";

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var filas = await Auth().GetFromJsonAsync<List<UnidadCampoConfigDto>>($"{CfgUrl}?entidad={EntidadConfig}") ?? new();
            _actual = filas.FirstOrDefault(f => string.Equals(f.CampoClave, Clave, StringComparison.OrdinalIgnoreCase));
        }
        catch { _actual = null; }
        _alias = _actual?.Alias ?? "";
        _descripcion = _actual?.Descripcion ?? "";
        _oculto = _actual?.Oculto ?? false;
        _opcionesJson = _actual?.Opciones;
        var fmt = ParseFmt(_actual?.Formato);
        _fmtDec = fmt.Dec ?? 2; _fmtMiles = fmt.Miles; _fmtMax = fmt.Max;

        if (AutoServido) await ConstruirOpcionesSelfAsync();
        if (EditableInline)
        {
            _opcsEdit.Clear();
            if (!string.IsNullOrWhiteSpace(_opcionesJson)) _opcsEdit.AddRange(OpcionCampo.Parse(_opcionesJson));
            else _opcsEdit.AddRange((_opcionesSelf ?? new()).Select(v => new OpcionCampo(v.Texto, false, v.Color)));
        }
    }

    // Persiste la lista EDITADA (full, incl ocultas) como override del tenant (config Opciones). Mismo write que
    // AgregarOpcionSelfAsync pero con reordenar/color/ocultar. Preserva alias/formato/oculto/orden de la fila.
    private async Task PersistirOpcsAsync()
    {
        var json = OpcionCampo.Serializar(_opcsEdit.Where(o => !string.IsNullOrWhiteSpace(o.K)).ToList());
        _busy = true; _msg = null;
        try
        {
            var r = await Auth().PutAsJsonAsync(CfgUrl, new GuardarUnidadCampoConfigRequest(
                CampoClave: Clave, Alias: _actual?.Alias, Opciones: json, Tipo: _actual?.Tipo,
                Formato: _actual?.Formato, Oculto: _actual?.Oculto ?? false, Orden: _actual?.Orden,
                Entidad: EntidadConfig, Descripcion: _actual?.Descripcion));
            if (r.IsSuccessStatusCode)
            {
                _opcionesJson = json;
                _opcionesSelf = _opcsEdit.Where(o => !o.Oculta).Select(o => new OpcionVista(o.K, o.Color)).ToList();
                await Guardado.InvokeAsync();   // el padre recarga su config -> la celda ofrece la lista nueva
            }
            else { _msg = "No se pudo guardar la lista."; }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    // Arma la lista auto-servida: si la copropiedad ya personalizo (config Opciones no vacia) esa es la
    // fuente visible (el <select> de la celda lee lo mismo); si no, las semillas del catalogo global
    // (o SemillaFallback). Solo las visibles (no ocultas); el ocultar/reordenar se hace en otra parte.
    private async Task ConstruirOpcionesSelfAsync()
    {
        // Override del tenant (lo que realmente ve la celda hoy).
        var delTenant = OpcionCampo.Parse(_opcionesJson).Where(o => !o.Oculta)
            .Select(o => new OpcionVista(o.K, o.Color)).ToList();
        if (delTenant.Count > 0) { _opcionesSelf = delTenant; return; }

        // Sin override: semillas del catalogo global (fallback a SemillaFallback).
        var sem = new List<OpcionVista>();
        if (!string.IsNullOrWhiteSpace(ListaCatalogo))
        {
            try
            {
                var cat = await Auth().GetFromJsonAsync<List<CatalogoOpcionDto>>(
                    $"/api/catalogos?lista={Uri.EscapeDataString(ListaCatalogo!)}") ?? new();
                sem = cat.Select(o => new OpcionVista(o.Label, o.Color)).ToList();
            }
            catch { sem = new(); }
        }
        if (sem.Count == 0 && SemillaFallback is { Length: > 0 })
            sem = SemillaFallback.Select(s => new OpcionVista(s)).ToList();
        _opcionesSelf = sem;
    }

    private async Task Cerrar() => await Cerrado.InvokeAsync();
    private async Task AbrirGestor() { await Cerrado.InvokeAsync(); await AbrirGestorAvanzado.InvokeAsync(); }

    private void OnNuevaOpcionKey(KeyboardEventArgs e) { if (e.Key == "Enter") _ = AgregarOpcionAsync(); }

    // Agregar una opcion propia: valida vacio/duplicado y delega la persistencia field-specific al padre
    // (ej. Tipo crea un tipo propio; Estado agrega al config). El padre refresca OpcionesLista.
    private async Task AgregarOpcionAsync()
    {
        var v = (_nuevaOpcion ?? "").Trim();
        if (string.IsNullOrWhiteSpace(v)) return;
        if (EfectivasOpciones is not null && EfectivasOpciones.Any(o => string.Equals(o.Texto, v, StringComparison.OrdinalIgnoreCase)))
        { _msg = "Esa opcion ya existe."; return; }
        _msg = null; _nuevaOpcion = "";
        if (AutoServido) await AgregarOpcionSelfAsync(v);
        else await OnAgregarOpcion.InvokeAsync(v);
    }

    // Modo E0: persiste la opcion nueva en el override del tenant (config Opciones = semillas+propias) para
    // que aparezca tanto aqui como en el <select> de la celda. Preserva alias/descr/oculto/tipo/formato/orden.
    private async Task AgregarOpcionSelfAsync(string v)
    {
        _busy = true;
        try
        {
            var lista = (_opcionesSelf ?? new()).Select(o => new OpcionCampo(o.Texto, false, o.Color)).ToList();
            lista.Add(new OpcionCampo(v));
            var json = OpcionCampo.Serializar(lista);
            var r = await Auth().PutAsJsonAsync(CfgUrl, FilaRequest(json));
            if (r.IsSuccessStatusCode)
            {
                _opcionesJson = json;
                (_opcionesSelf ??= new()).Add(new OpcionVista(v));
                await Guardado.InvokeAsync();   // el padre recarga su config -> la celda ofrece la opcion nueva
            }
            else { _msg = "No se pudo agregar la opcion."; }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    // Request de config con los valores vigentes del formulario + las opciones dadas (preserva lo no editado).
    private GuardarUnidadCampoConfigRequest FilaRequest(string? opcionesJson)
        => new(
            CampoClave: Clave,
            Alias: string.IsNullOrWhiteSpace(_alias) ? null : _alias.Trim(),
            Opciones: opcionesJson,
            Tipo: _actual?.Tipo,
            Formato: FormatoActual(),
            Oculto: _oculto,
            Orden: _actual?.Orden,
            Entidad: EntidadConfig,
            Descripcion: string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion.Trim());

    private async Task GuardarAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var r = await Auth().PutAsJsonAsync(CfgUrl, FilaRequest(_opcionesJson));
            if (r.IsSuccessStatusCode) { await Guardado.InvokeAsync(); await Cerrado.InvokeAsync(); }
            else { _msg = "No se pudo guardar el campo."; }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private static string TipoLabel(TipoCampoTablero t) => t switch
    {
        TipoCampoTablero.Texto => "Texto de una sola linea",
        TipoCampoTablero.AreaTexto => "Texto largo",
        TipoCampoTablero.Numero => "Numero",
        TipoCampoTablero.Moneda => "Moneda",
        TipoCampoTablero.Porcentaje => "Porcentaje",
        TipoCampoTablero.Fecha => "Fecha",
        TipoCampoTablero.FechaHora => "Fecha y hora",
        TipoCampoTablero.Hora => "Hora",
        TipoCampoTablero.Seleccion => "Lista",
        TipoCampoTablero.Booleano => "Si / No",
        TipoCampoTablero.Telefono => "Telefono",
        TipoCampoTablero.Email => "Email",
        TipoCampoTablero.Url => "URL",
        TipoCampoTablero.Formula => "Funcion / calculado",
        TipoCampoTablero.Usuario => "Usuario",
        TipoCampoTablero.Directorio => "Directorio",
        _ => "Texto"
    };
}

<style>
