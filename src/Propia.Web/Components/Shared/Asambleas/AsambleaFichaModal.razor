@* AsambleaFichaModal - ficha de una sesion de asamblea en MODAL (replica RP.asambleaFichaModal, PROPUESTAS.md 7.1 bis y 8).
   Frame estandar de ficha (1056 x 86vh, is-fixedh + .asm-modal): cabecera con navegacion < n/total > entre las sesiones
   de la bandeja, icono con el color del estado, titulo + badge, linea "tipo - modalidad - fecha - lugar", ultimo envio
   de enlaces y las acciones del ciclo (Votar con mi cuenta - Enviar enlaces - Cancelar - Citar / Abrir sala / Cerrar
   sesion - Segunda convocatoria - X); franja de quorum; pestanas Orden del dia | Participantes | Sala virtual
   (Virtual/Mixta) | Documentos | Acta. Ley 675 (ola 2): instalacion con presidente y secretario, punto en curso, orden
   del dia editable en Borrador, poderes con limite, votos de la sala en bloque, elecciones por planchas, cierre con el
   quorum de la instalacion. Los dialogos internos son .modal de Bootstrap por encima. Devuelve true si hubo cambios.
   Las pestanas van en el segundo bloque de codigo. *@
@inherits ModalBase<bool>
@using Propia.Application.Asambleas
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

@if (_s is null)
{
    <div class="asm-head">
        <div class="asm-head-tt"><div class="asm-head-h"><span class="asm-head-titulo">Asamblea</span></div></div>
        <div class="asm-head-acts"><button type="button" class="asm-x" title="Cerrar" @onclick="Cerrar">@IconoX</button></div>
    </div>
    <div class="asm-body">
        @if (_msg is not null) { <div class="alert @_msgClass py-2 small">@_msg</div> }
        else { <div class="text-center py-5"><div class="spinner-border" style="color: var(--propia-primary);"></div></div> }
    </div>
    return;
}

@* ---------------------------------------------------------------- cabecera *@
<div class="asm-head">
    @if (Lista is { Count: > 1 } && Idx >= 0)
    {
        <div class="asm-nav">
            <button type="button" class="asm-nav-btn" title="Sesión anterior" disabled="@(Idx <= 0)" @onclick="() => IrAAsync(-1)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <span class="asm-nav-pos">@(Idx + 1) / @Lista.Count</span>
            <button type="button" class="asm-nav-btn" title="Sesión siguiente" disabled="@(Idx >= Lista.Count - 1)" @onclick="() => IrAAsync(1)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
            </button>
        </div>
    }
    <div class="asm-head-ic" style="background:@EstadoColor(_s.Estado);"><i class="fi fi-rr-podium-star"></i></div>
    <div class="asm-head-tt">
        <div class="asm-head-h">
            <span class="asm-head-titulo">@_s.Titulo</span>
            @BadgeEstado(_s.Estado)
            @if (_s.SegundaConvocatoria) { <span class="badge bg-warning text-dark">2da convocatoria</span> }
        </div>
        <div class="asm-head-s">
            @TipoTexto(_s.Tipo) &middot; @_s.Modalidad &middot; @Local(_s.FechaSesion).ToString("yyyy-MM-dd HH:mm")
            @if (!string.IsNullOrEmpty(_s.LugarFisico)) { <text> &middot; @_s.LugarFisico</text> }
            @if (!string.IsNullOrEmpty(_s.EnlaceVideo) && !_s.SalaPropia) { <text> &middot; <a href="@_s.EnlaceVideo" target="_blank" rel="noopener">Enlace video</a></text> }
        </div>
        @if (_s.Estado == EstadoSesion.Cancelada && !string.IsNullOrEmpty(_s.MotivoCancelacion))
        {
            <div class="asm-head-envio">Cancelada: @_s.MotivoCancelacion</div>
        }
        @if (_envio is not null && (_s.Estado == EstadoSesion.Citada || _s.Estado == EstadoSesion.EnCurso))
        {
            <div class="asm-head-envio" title="@string.Join(" | ", _envio.Errores)">
                Último envío de enlaces (@_envio.Inicio.LocalDateTime.ToString("HH:mm")):
                @(_envio.EnCurso ? "en curso, " : "")@_envio.Enviados de @_envio.Total enviados@(_envio.Fallidos > 0 ? $", {_envio.Fallidos} fallidos" : "")
                <button class="btn btn-link btn-sm p-0 ms-1 align-baseline" @onclick="CargarEstadoEnvioAsync">actualizar</button>
            </div>
        }
    </div>
    <div class="asm-head-acts">
        @if (_miRuta is not null) { <a class="btn btn-sm btn-outline-primary" href="@_miRuta" target="_blank" rel="noopener">Votar con mi cuenta</a> }
        @if (_s.Estado == EstadoSesion.Citada || _s.Estado == EstadoSesion.EnCurso)
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="() => _dlg = Dlg.Enlaces" disabled="@_busy">Enviar enlaces de voto</button>
        }
        @if (_s.Estado == EstadoSesion.Borrador || _s.Estado == EstadoSesion.Citada)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="() => { _motivo = string.Empty; _dlg = Dlg.Cancelar; }" disabled="@_busy">Cancelar sesión</button>
        }
        @if (_s.Estado == EstadoSesion.Borrador)
        {
            <button class="btn btn-sm" style="background: var(--propia-primary); color: var(--propia-text-inverse);" @onclick="() => CitarAsync(false)" disabled="@_busy">Citar (envia citacion)</button>
        }
        @if (_s.Estado == EstadoSesion.Citada)
        {
            <button class="btn btn-sm btn-success" @onclick="PedirAbrirSala" disabled="@_busy">Abrir sala</button>
        }
        @if (_s.Estado == EstadoSesion.EnCurso)
        {
            <button class="btn btn-sm btn-danger" @onclick="PedirCerrar" disabled="@_busy">Cerrar sesión</button>
        }
        @if (_s.Estado == EstadoSesion.QuorumFallido && !_s.SegundaConvocatoria)
        {
            if (_s.SesionHijaId is Guid hija)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="() => IrASesionAsync(hija)">Ver segunda convocatoria</button>
            }
            else
            {
                <button class="btn btn-sm" style="background: var(--propia-primary); color: var(--propia-text-inverse);" @onclick="SegundaConvocatoriaAsync" disabled="@_busy">Convocar segunda convocatoria</button>
            }
        }
        @if (_s.SegundaConvocatoria && _s.SesionPadreId is Guid padre)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => IrASesionAsync(padre)">Ver primera convocatoria</button>
        }
        <button type="button" class="asm-x" title="Cerrar" @onclick="Cerrar">@IconoX</button>
    </div>
</div>

@* ---------------------------------------------------------------- franja de quorum *@
@if (_s.Estado is EstadoSesion.EnCurso or EstadoSesion.Cerrada or EstadoSesion.QuorumFallido)
{
    var q = _s.QuorumActual;
    <div class="asm-quorum">
        <div class="asm-quorum-row">
            <span class="asm-quorum-lbl">Quórum</span>
            <span><strong>@q.PctRepresentado.ToString("0.00")%</strong> representado @QuorumRequeridoTexto(q)</span>
            <span class="asm-quorum-n">@q.ParticipantesPresentes / @q.ParticipantesTotales unidades</span>
            @if (q.Alcanzado) { <span class="badge bg-success">Alcanzado</span> } else { <span class="badge bg-warning text-dark">Insuficiente</span> }
        </div>
        <div class="progress" style="height: 6px;"><div class="progress-bar @(q.Alcanzado ? "bg-success" : "bg-warning")" style="width: @(Math.Min(100, (double)q.PctRepresentado).ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div></div>
    </div>
}

@* ---------------------------------------------------------------- pestanas *@
<div class="asm-tabs" role="tablist">
    <button type="button" role="tab" class="asm-tab @(_tab == "orden" ? "on" : "")" @onclick='() => _tab = "orden"'>Orden del día (@_s.Puntos.Count)</button>
    <button type="button" role="tab" class="asm-tab @(_tab == "participantes" ? "on" : "")" @onclick='() => _tab = "participantes"'>Participantes (@_s.Participantes.Count)</button>
    @if (_s.Modalidad != ModalidadSesion.Presencial)
    {
        <button type="button" role="tab" class="asm-tab @(_tab == "sala" ? "on" : "")" @onclick='() => _tab = "sala"'>Sala virtual @if (_s.Estado == EstadoSesion.EnCurso && _s.SalaPropia) { <span class="asm-live">EN VIVO</span> }</button>
    }
    <button type="button" role="tab" class="asm-tab @(_tab == "documentos" ? "on" : "")" @onclick='() => _tab = "documentos"'>Documentos (@_s.Documentos.Count)</button>
    <button type="button" role="tab" class="asm-tab @(_tab == "acta" ? "on" : "")" @onclick='() => _tab = "acta"'>Acta @if (_s.Acta is not null) { @BadgeActa(_s.Acta.Estado) }</button>
</div>

<div class="asm-body">
    @if (_msg is not null) { <div class="alert @_msgClass py-2 small">@_msg</div> }

    @switch (_tab)
    {
        case "participantes":
            @Participantes()
            break;
        case "sala":
            @Sala()
            break;
        case "documentos":
            @Documentos()
            break;
        case "acta":
            @Acta()
            break;
        default:
            @Orden()
            break;
    }
</div>

@* ---------------------------------------------------------------- dialogos *@
@if (_dlg == Dlg.Cerrar)
{
    var va = VotacionAbierta();
    var pend = _s.Puntos.Where(p => p.Estado == EstadoPunto.Pendiente || (p.Estado == EstadoPunto.EnDiscusion && p.RequiereVotacion && p.Votacion is null)).ToList();
    var inst = _s.Instalacion;
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Cerrar sesión</h5><button type="button" class="btn-close" @onclick="() => _dlg = Dlg.Ninguno"></button></div>
            <div class="modal-body">
                @if (va is not null) { <div class="alert alert-danger py-2 small">Hay una votación abierta (punto @va.Numero). Ciérrala antes de cerrar la sesión.</div> }
                @if (inst is not null)
                {
                    <p class="small mb-2">Quórum de instalación: <b>@inst.QuorumPct.ToString("0.00")%</b> (@Local(inst.Hora).ToString("HH:mm")). La sesión se cierra como <b>Cerrada</b> y se genera el borrador del acta.</p>
                }
                else
                {
                    <p class="small mb-2">La asamblea <b>no se instaló</b> (no hubo quórum o no se designaron presidente y secretario): se cierra como <b>Quórum fallido</b> y podrás convocar la segunda convocatoria.</p>
                }
                @if (pend.Count > 0) { <p class="small mb-2">Puntos sin tratar que quedarán como <b>No tratado</b>: @string.Join(", ", pend.Select(p => p.Numero)).</p> }
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="asm-cq" @bind="_corregir">
                    <label class="form-check-label small" for="asm-cq">Corregir el quórum (queda justificado en el acta)</label>
                </div>
                @if (_corregir)
                {
                    <div class="ms-4 mt-1">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="asm-cqv" id="asm-cq1" checked="@_cierreQuorum" @onchange="() => _cierreQuorum = true">
                            <label class="form-check-label small" for="asm-cq1">Hubo quórum</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="asm-cqv" id="asm-cq0" checked="@(!_cierreQuorum)" @onchange="() => _cierreQuorum = false">
                            <label class="form-check-label small" for="asm-cq0">No hubo quórum</label>
                        </div>
                        <textarea class="form-control form-control-sm mt-1" rows="2" placeholder="Justificación (obligatoria)" @bind="_justificacion" @bind:event="oninput"></textarea>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-dark" @onclick="() => _dlg = Dlg.Ninguno">Cancelar</button>
                <button class="btn btn-sm btn-danger" @onclick="CerrarSesionAsync" disabled="@(_busy || va is not null)">Cerrar sesión</button>
            </div>
        </div></div>
    </div>
}
@if (_dlg == Dlg.Enlaces)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Enviar enlaces de voto</h5><button type="button" class="btn-close" @onclick="() => _dlg = Dlg.Ninguno"></button></div>
            <div class="modal-body small">
                <p>Cada propietario de las unidades citadas, y cada apoderado con poder aprobado, recibirá un correo con su enlace personal para registrar asistencia y votar sin crear cuenta.</p>
                <p class="mb-0 text-muted">Residentes, familiares y arrendatarios no reciben enlace. Si vuelves a enviar, el enlace anterior sigue funcionando.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-dark" @onclick="() => _dlg = Dlg.Ninguno">Cancelar</button>
                <button class="btn btn-sm btn-primary" @onclick="EnviarEnlacesAsync" disabled="@_busy">Enviar correos</button>
            </div>
        </div></div>
    </div>
}
@if (_dlg == Dlg.Cancelar)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Cancelar sesión</h5><button type="button" class="btn-close" @onclick="() => _dlg = Dlg.Ninguno"></button></div>
            <div class="modal-body">
                <p class="small">La sesión queda <b>Cancelada</b>@(_s.Estado == EstadoSesion.Citada ? " (avisa a los citados por tus canales: el sistema no envía el aviso)" : ""). No se puede reabrir.</p>
                <label class="form-label small">Motivo *</label>
                <textarea class="form-control form-control-sm" rows="3" @bind="_motivo" @bind:event="oninput"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-dark" @onclick="() => _dlg = Dlg.Ninguno">Volver</button>
                <button class="btn btn-sm btn-danger" @onclick="CancelarSesionAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_motivo))">Cancelar sesión</button>
            </div>
        </div></div>
    </div>
}
@if (_dlg == Dlg.ConfirmarCitar)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Citar dentro del plazo</h5><button type="button" class="btn-close" @onclick="() => _dlg = Dlg.Ninguno"></button></div>
            <div class="modal-body small"><p class="mb-0">@_confirmTexto ¿Citar de todas formas?</p></div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-dark" @onclick="() => _dlg = Dlg.Ninguno">Volver</button>
                <button class="btn btn-sm btn-primary" @onclick="() => CitarAsync(true)" disabled="@_busy">Citar</button>
            </div>
        </div></div>
    </div>
}
@if (_dlg == Dlg.ConfirmarSala)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Abrir sala</h5><button type="button" class="btn-close" @onclick="() => _dlg = Dlg.Ninguno"></button></div>
            <div class="modal-body small"><p class="mb-0">La sesión está programada para el @Local(_s.FechaSesion).ToString("yyyy-MM-dd 'a las' HH:mm"). ¿Abrir la sala desde ya?</p></div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-dark" @onclick="() => _dlg = Dlg.Ninguno">Volver</button>
                <button class="btn btn-sm btn-success" @onclick="AbrirSalaAsync" disabled="@_busy">Abrir sala</button>
            </div>
        </div></div>
    </div>
}
@if (_dlg == Dlg.Firmar && _s.Instalacion is { } instF)
{
    var nombreF = _firmaRol == RolFirmaActa.Presidente ? instF.PresidenteNombre : instF.SecretarioNombre;
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Firmar como @(_firmaRol == RolFirmaActa.Presidente ? "presidente" : "secretario")</h5><button type="button" class="btn-close" @onclick="() => _dlg = Dlg.Ninguno"></button></div>
            <div class="modal-body small">
                <p>Firma <b>@nombreF</b>. Con las dos firmas (presidente y secretario) el acta queda <b>inmutable</b> con su hash SHA-256 (RN-10).</p>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button class="btn btn-sm btn-success" @onclick="() => FirmarRolAsync(null)" disabled="@_busy">Firmar con mi cuenta</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="PedirCodigoAsync" disabled="@_busy">@(_codigo is null ? "Enviar código a su correo" : "Enviar otro código")</button>
                </div>
                <div class="text-muted mb-2">"Firmar con mi cuenta" solo sirve si entraste con la cuenta de quien firma. Si no, envíale el código a su correo y escríbelo aquí.</div>
                @if (_codigo is not null)
                {
                    <div class="alert alert-info py-2 mb-2">Código enviado a <b>@_codigo.CorreoEnmascarado</b> (vence a las @Local(_codigo.Expira).ToString("HH:mm")).@if (_codigo.CodigoDev is { } dev) { <div class="mt-1">Solo en desarrollo (no se envía correo): <b>@dev</b></div> }</div>
                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" style="max-width:160px" inputmode="numeric" maxlength="6" placeholder="Código de 6 dígitos" @bind="_codigoTxt" @bind:event="oninput" />
                        <button class="btn btn-sm btn-success" @onclick="() => FirmarRolAsync(_codigoTxt)" disabled="@(_busy || (_codigoTxt?.Trim().Length ?? 0) != 6)">Firmar con el código</button>
                    </div>
                }
                @if (_firmaError is not null) { <div class="alert alert-danger py-2 mt-2 mb-0">@_firmaError</div> }
            </div>
            <div class="modal-footer"><button class="btn btn-sm btn-outline-dark" @onclick="() => _dlg = Dlg.Ninguno">Cerrar</button></div>
        </div></div>
    </div>
}
@if (_dlg == Dlg.Votar)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Emitir voto: @OpcionTexto(_opcionVotar ?? "")</h5><button type="button" class="btn-close" @onclick="() => _dlg = Dlg.Ninguno"></button></div>
            <div class="modal-body">
                <p class="small">Selecciona la unidad que emite el voto.</p>
                <select class="form-select form-select-sm" @bind="_unidadVotarId">
                    <option value="">Selecciona unidad...</option>
                    @foreach (var p in _s.Participantes.Where(p => p.Presente))
                    {
                        <option value="@p.UnidadPrivadaId">@p.UnidadNumero - @p.Nombre (coef @p.Coeficiente.ToString("0.00000"))</option>
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-dark" @onclick="() => _dlg = Dlg.Ninguno">Cancelar</button>
                <button class="btn btn-sm btn-primary" @onclick="ConfirmarVotoAsync" disabled="@(_busy || string.IsNullOrEmpty(_unidadVotarId))">Confirmar voto</button>
            </div>
        </div></div>
    </div>
}
@if (_dlg == Dlg.Bloque && PuntoDeVotacion(_bloqueVotacionId) is { } pb)
{
    var ya = pb.Votacion!.Votos.Select(v => v.UnidadPrivadaId).ToHashSet();
    var faltan = _s.Participantes.Where(p => p.Presente && !ya.Contains(p.UnidadPrivadaId)).ToList();
    var marcados = faltan.Count(f => _bloque.ContainsKey(f.UnidadPrivadaId));
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Registrar votos de la sala · Punto @pb.Numero</h5><button type="button" class="btn-close" @onclick="() => _dlg = Dlg.Ninguno"></button></div>
            <div class="modal-body">
                <p class="small mb-2">Asamblea presencial o mixta: registra el voto de cada unidad presente en la sala. Las que votaron por su enlace ya no aparecen (@pb.Votacion.Votos.Count).</p>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var op in pb.OpcionesVoto)
                    {
                        var o = op;
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => { foreach (var f in faltan) _bloque[f.UnidadPrivadaId] = o; }">Todos: @OpcionTexto(o)</button>
                    }
                    <button class="btn btn-sm btn-link" @onclick="() => _bloque.Clear()">Limpiar</button>
                </div>
                <table class="table table-sm small mb-0">
                    <thead class="text-muted"><tr><th>Unidad</th><th>Persona</th><th class="text-end">Coef.</th>@foreach (var op in pb.OpcionesVoto) { <th class="text-center">@OpcionTexto(op)</th> }</tr></thead>
                    <tbody>
                        @foreach (var f in faltan)
                        {
                            var uid = f.UnidadPrivadaId;
                            <tr>
                                <td><strong class="u-cod">@f.UnidadNumero</strong></td>
                                <td>@f.Nombre</td>
                                <td class="text-end">@f.Coeficiente.ToString("0.00000")</td>
                                @foreach (var op in pb.OpcionesVoto)
                                {
                                    var o = op;
                                    <td class="text-center"><input type="radio" class="form-check-input" name="bq-@uid" checked="@(_bloque.TryGetValue(uid, out var sel) && sel == o)" @onchange="() => _bloque[uid] = o" /></td>
                                }
                            </tr>
                        }
                        @if (faltan.Count == 0) { <tr><td colspan="@(3 + pb.OpcionesVoto.Count)" class="text-muted text-center py-3">Todas las unidades presentes ya votaron.</td></tr> }
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <span class="small text-muted me-auto">@marcados de @faltan.Count con voto marcado</span>
                <button class="btn btn-sm btn-outline-dark" @onclick="() => _dlg = Dlg.Ninguno">Cancelar</button>
