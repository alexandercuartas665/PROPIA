        EstadoActa.Firmada => @<span class="badge bg-success">Firmada</span>,
        _ => __b => { }
    };
    private static string ResultadoTexto(ResultadoVotacion r) => r switch
    {
        ResultadoVotacion.Aprobado => "Aprobado",
        ResultadoVotacion.Rechazado => "No aprobado",
        ResultadoVotacion.Elegido => "Elegido",
        _ => "Sin resultado"
    };
    private static string OpcionTexto(string op) => op switch { "Si" => "Sí", "Abstencion" => "Abstención", _ => op };
    private static bool EsEleccion(SesionPuntoDto p) => !p.OpcionesVoto.Contains("Si");

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt!);
        return http;
    }
    private static async Task<string> LeerErrorAsync(HttpResponseMessage r)
    {
        var txt = await r.Content.ReadAsStringAsync();
        try { var d = System.Text.Json.JsonDocument.Parse(txt); if (d.RootElement.TryGetProperty("error", out var e)) return e.GetString() ?? "Error."; } catch { }
        return string.IsNullOrWhiteSpace(txt) ? $"Error {(int)r.StatusCode}." : txt;
    }
}

@code {
    // ===================== Pestana Orden del dia =====================
    // Instalacion (EnCurso): con quorum se designan presidente y secretario (Ley 675 art. 47). Sin instalacion no hay votaciones.
    private string? _instPres;
    private string _instSec = "admin";
    private Task InstalarAsync()
    {
        if (!Guid.TryParse(_instPres, out var pres)) return Task.CompletedTask;
        Guid? sec = Guid.TryParse(_instSec, out var s) ? s : null;
        return EjecutarAsync(h => h.PutAsJsonAsync($"/api/asambleas/{_id}/instalar", new InstalarSesionRequest(pres, sec)), "Asamblea instalada.");
    }

    private RenderFragment Instalacion()
    {
        if (_s!.Estado != EstadoSesion.EnCurso) return __b => { };
        if (_s.Instalacion is { } i)
            return @<div class="asm-inst asm-inst--ok"><i class="fi fi-rr-check-circle"></i><div>Asamblea instalada a las @Local(i.Hora).ToString("HH:mm") con el @i.QuorumPct.ToString("0.00")% de los coeficientes. Presidente: <b>@i.PresidenteNombre</b> &middot; Secretario: <b>@i.SecretarioNombre</b></div></div>;
        var q = _s.QuorumActual;
        var pres = _s.Participantes.Where(p => p.Presente).ToList();
        return @<div class="asm-inst">
            <div class="asm-inst-t">Instalación de la asamblea</div>
            <div class="asm-inst-s">Verificado el quórum, la asamblea designa presidente y secretario, que firman el acta (Ley 675 art. 47). Sin instalación no se abren votaciones.</div>
            @if (!q.Alcanzado)
            {
                <div class="alert alert-warning py-2 small mb-0 mt-2">Aún no hay quórum: @q.ParticipantesPresentes de @q.ParticipantesTotales unidades presentes.</div>
            }
            else
            {
                <div class="row g-2 mt-1">
                    <div class="col-md-5">
                        <label class="form-label small mb-1">Presidente de la asamblea</label>
                        <select class="form-select form-select-sm" @bind="_instPres">
                            <option value="">Elige un asistente...</option>
                            @foreach (var p in pres) { <option value="@p.UnidadPrivadaId">@p.UnidadNumero - @p.Nombre</option> }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-1">Secretario de la asamblea</label>
                        <select class="form-select form-select-sm" @bind="_instSec">
                            <option value="admin">Administración</option>
                            @foreach (var p in pres) { <option value="@p.UnidadPrivadaId">@p.UnidadNumero - @p.Nombre</option> }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-sm btn-success w-100" @onclick="InstalarAsync" disabled="@(_busy || string.IsNullOrEmpty(_instPres))">Instalar</button></div>
