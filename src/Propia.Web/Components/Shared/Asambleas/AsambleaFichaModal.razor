                                <button class="btn btn-link btn-sm p-0 ms-2 text-danger" @onclick="() => QuitarPuntoAsync(pid)" disabled="@(_busy || _s.Puntos.Count <= 1)">Quitar</button>
                            }
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(p.Descripcion)) { <p class="small text-muted mb-1">@p.Descripcion</p> }
                    <div class="small text-muted mb-1">
                        @if (p.RequiereVotacion)
                        {
                            if (EsEleccion(p)) { <span class="badge bg-light text-dark border me-1">Elección: @string.Join(" / ", p.OpcionesVoto)</span> }
                            else { <span class="badge bg-light text-dark border me-1">@p.TipoMayoria @p.MayoriaPct.ToString("0.##")%</span> }
                            <span class="badge bg-light text-dark border me-1">@p.ModalidadVoto</span>
                        }
                        else { <em>No requiere votación formal</em> }
                    </div>
                    @if (p.Votacion is { } v) { @VotacionCard(p, v) }
                    @if (_s.Estado == EstadoSesion.EnCurso && _s.Instalacion is not null)
                    {
                        <div class="d-flex gap-2 mt-1">
                            @if (p.Estado == EstadoPunto.Pendiente) { <button class="btn btn-sm btn-outline-secondary" @onclick="() => IniciarPuntoAsync(pid)" disabled="@_busy">Iniciar punto</button> }
                            @if (p.Estado == EstadoPunto.EnDiscusion && !p.RequiereVotacion) { <button class="btn btn-sm btn-outline-success" @onclick="() => MarcarTratadoAsync(pid)" disabled="@_busy">Marcar tratado</button> }
                            @if (p.RequiereVotacion && p.Votacion is null && p.Estado is EstadoPunto.Pendiente or EstadoPunto.EnDiscusion) { <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirVotacionAsync(pid)" disabled="@_busy">Abrir votación</button> }
                        </div>
                    }
                </div>
            }
            @if (_edit is { Id: null }) { @PuntoEditor() }
            else if (_s.Estado == EstadoSesion.Borrador) { <button class="btn btn-sm btn-outline-dark mt-2" @onclick="() => _edit = new PuntoEdit()">+ Agregar punto</button> }
        </div></div>
    </div>;

    private RenderFragment VotacionCard(SesionPuntoDto p, VotacionDto v) => @<div class="card bg-light mb-1"><div class="card-body py-2 small">
        <div class="d-flex justify-content-between align-items-start gap-2">
