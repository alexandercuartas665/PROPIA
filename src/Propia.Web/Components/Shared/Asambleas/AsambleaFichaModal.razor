    // Mientras la IA redacta, la ficha se refresca sola cada 3 s (no mientras se edita).
    protected override void OnAfterRender(bool firstRender)
    {
        var redactando = _s?.Acta?.EstadoRedaccion == EstadoRedaccionActa.Redactando && !_actaEdit;
        if (redactando && _poll is null)
            _poll = new System.Threading.Timer(_ => InvokeAsync(async () =>
            {
                if (_busy || _actaEdit) return;
                await CargarAsync();
                if (_s?.Acta?.EstadoRedaccion != EstadoRedaccionActa.Redactando) { _poll?.Dispose(); _poll = null; }
                StateHasChanged();
            }), null, 3000, 3000);
        else if (!redactando && _poll is not null) { _poll.Dispose(); _poll = null; }
    }
    public void Dispose()
    {
        _poll?.Dispose(); _txPoll?.Dispose(); _salaPoll?.Dispose();
        if (_salaConectada) { try { _ = Js.InvokeVoidAsync("propiaSala.salir"); } catch { } }
        if (_dictando) { try { _ = Js.InvokeVoidAsync("propiaUI.dictado.stop"); } catch { } }
        _dictRef?.Dispose();
    }

    // ===================== Transcripcion (ola 4) =====================
    private List<TranscripcionLineaDto> _tx = new();
    private bool _dictando;
    private string? _parcial, _dictadoError;
    private DotNetObjectReference<AsambleaFichaModal>? _dictRef;
    private System.Threading.Timer? _txPoll;

    private async Task CargarTranscripcionAsync()
    {
        if (_s is null || _s.Estado is not (EstadoSesion.EnCurso or EstadoSesion.Cerrada or EstadoSesion.QuorumFallido)) { _tx = new(); return; }
        try { _tx = await Auth().GetFromJsonAsync<List<TranscripcionLineaDto>>($"/api/asambleas/{_id}/transcripcion") ?? new(); }
        catch { }
        // Mientras la transcripcion esta activa, la bitacora se refresca sola (lineas de otros y del proveedor).
        if (_s.Estado == EstadoSesion.EnCurso && _s.TranscripcionActiva)
            _txPoll ??= new System.Threading.Timer(_ => InvokeAsync(async () =>
            {
                if (_busy) return;
                try { _tx = await Auth().GetFromJsonAsync<List<TranscripcionLineaDto>>($"/api/asambleas/{_id}/transcripcion") ?? _tx; } catch { }
                StateHasChanged();
            }), null, 4000, 4000);
        else { _txPoll?.Dispose(); _txPoll = null; }
    }

    private async Task ToggleTranscripcionAsync()
    {
        var activa = !_s!.TranscripcionActiva;
        if (!activa && _dictando) await DetenerDictadoAsync();
        await EjecutarAsync(h => h.PutAsJsonAsync($"/api/asambleas/{_id}/transcripcion/activa", new ActivarTranscripcionRequest(activa)));
    }

    private async Task ToggleDictadoAsync()
    {
        _dictadoError = null;
        if (_dictando) { await DetenerDictadoAsync(); return; }
        var r = await Js.InvokeAsync<string>("propiaUI.dictado.start", JsRef(), "es-CO");
        if (r == "ok") _dictando = true;
        else _dictadoError = r == "no-soportado" ? "Este navegador no reconoce voz: usa Chrome o Edge." : "No se pudo iniciar el micrófono.";
    }
    private async Task DetenerDictadoAsync()
    {
        try { await Js.InvokeVoidAsync("propiaUI.dictado.stop"); } catch { }
        _dictando = false; _parcial = null;
    }

    [JSInvokable]
    public async Task DictadoFinal(string texto, double? confianza)
    {
        if (string.IsNullOrWhiteSpace(texto) || _s is null) return;
        _parcial = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/asambleas/{_id}/transcripcion",
                new AgregarTranscripcionRequest(texto.Trim(), confianza is double c ? (decimal)Math.Round(c, 4) : null));
            if (resp.IsSuccessStatusCode && await resp.Content.ReadFromJsonAsync<TranscripcionLineaDto>() is { } l) _tx.Add(l);
            else if (!resp.IsSuccessStatusCode) { _dictadoError = await LeerErrorAsync(resp); await DetenerDictadoAsync(); }
        }
        catch (Exception ex) { _dictadoError = ex.Message; }
        StateHasChanged();
    }
    [JSInvokable]
    public void DictadoParcial(string texto) { _parcial = texto; StateHasChanged(); }
    [JSInvokable]
    public void DictadoError(string error)
    {
        _dictando = false; _parcial = null;
        _dictadoError = error switch
        {
            "not-allowed" or "service-not-allowed" => "El navegador no dio permiso para usar el micrófono.",
            "audio-capture" => "No se encontró un micrófono.",
            "network" => "El reconocimiento de voz del navegador necesita conexión a internet.",
            _ => "El reconocimiento de voz se detuvo (" + error + ")."
        };
        StateHasChanged();
    }

    private RenderFragment Transcripcion() => @<div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
            <h6 class="mb-0 d-flex align-items-center gap-2">Transcripción @if (_s!.TranscripcionActiva) { <span class="asm-live">TRANSCRIBIENDO</span> }</h6>
            @if (_s.Estado == EstadoSesion.EnCurso)
            {
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm @(_s.TranscripcionActiva ? "btn-outline-dark" : "btn-primary")" @onclick="ToggleTranscripcionAsync" disabled="@_busy">@(_s.TranscripcionActiva ? "Pausar transcripción" : "Transcribir")</button>
                    <button class="btn btn-sm @(_dictando ? "btn-danger" : "btn-outline-primary")" @onclick="ToggleDictadoAsync" disabled="@(!_s.TranscripcionActiva)" title="Reconocimiento de voz del navegador (Chrome o Edge)"><i class="fi fi-rr-microphone me-1"></i>@(_dictando ? "Detener mi voz" : "Mi voz a texto")</button>
                </div>
            }
        </div>
        <div class="asm-tx-info">Esta sesión se transcribe para elaborar el acta (Ley 1581 de 2012). "Mi voz a texto" usa el reconocimiento de voz de tu navegador; cada frase queda con tu nombre y el punto en curso.</div>
        @if (_dictando) { <div class="asm-tx-interim">@(string.IsNullOrEmpty(_parcial) ? "Escuchando..." : _parcial + "...")</div> }
        @if (_dictadoError is not null) { <div class="alert alert-warning py-2 small mb-2">@_dictadoError</div> }
        <div class="asm-tx-full">@TxLista()</div>
    </div></div>;

    private RenderFragment TxLista() => __b =>
    {
        if (_tx.Count == 0) { __b.AddMarkupContent(0, "<div class=\"asm-tx-info\">Sin transcripción.</div>"); return; }
        var seq = 1;
        foreach (var l in _tx)
        {
            __b.OpenElement(seq++, "div");
            __b.AddAttribute(seq++, "class", "asm-tx-l" + (l.Tipo == TipoLineaTranscripcion.Sistema ? " is-sis" : ""));
            __b.OpenElement(seq++, "span"); __b.AddAttribute(seq++, "class", "asm-tx-h"); __b.AddContent(seq++, Local(l.Hora).ToString("HH:mm")); __b.CloseElement();
            __b.OpenElement(seq++, "span");
            if (l.Tipo == TipoLineaTranscripcion.Sistema) __b.AddContent(seq++, l.Texto);
            else
            {
                __b.OpenElement(seq++, "b"); __b.AddContent(seq++, (l.AutorNombre ?? "Participante") + (l.UnidadNumero is null ? "" : $" ({l.UnidadNumero})") + ":"); __b.CloseElement();
                __b.AddContent(seq++, " " + l.Texto + " ");
                if (l.PuntoNumero is int pn) { __b.OpenElement(seq++, "span"); __b.AddAttribute(seq++, "class", "asm-tx-p"); __b.AddContent(seq++, "P" + pn); __b.CloseElement(); }
            }
            __b.CloseElement();
            __b.CloseElement();
        }
    };

    private async Task EnviarEnlacesAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/asambleas/{_id}/enviar-enlaces", new EnviarEnlacesRequest(null, Nav.BaseUri));
            if (resp.IsSuccessStatusCode && await resp.Content.ReadFromJsonAsync<EnvioEnlacesDto>() is { } r)
            {
                var sin = r.SinCorreo.Count == 0 ? "" :
                    $" {r.SinCorreo.Count} sin correo registrado: {string.Join(", ", r.SinCorreo.Take(10))}{(r.SinCorreo.Count > 10 ? "..." : "")}.";
                _msg = r.Destinatarios == 0 ? "La sesión no tiene propietarios ni apoderados habilitados para recibir enlace."
                    : r.ConCorreo == 0
                    ? $"No se envió ningún correo: ninguno de los {r.Destinatarios} propietarios o apoderados tiene correo.{sin}"
                    : $"Enviando {(r.ConCorreo == 1 ? "1 correo" : $"{r.ConCorreo} correos")} con el enlace de voto (salen en segundo plano).{sin}";
                _msgClass = r.ConCorreo == 0 ? "alert-warning" : "alert-success";
            }
            else { _msg = await LeerErrorAsync(resp); _msgClass = "alert-danger"; }
            await CargarEstadoEnvioAsync();
        }
        finally { _busy = false; _dlg = Dlg.Ninguno; }
    }

    // ===================== Textos y badges =====================
    private static string TipoTexto(TipoSesion t) => t switch
