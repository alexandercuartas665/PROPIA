    // ===================== Pestana Participantes (+ poderes) =====================
    private string _partQ = "";
    private int _partPagina = 1, _partPorPagina = 25;
    private List<SesionParticipanteDto> PartFiltrados()
    {
        var q = _partQ.Trim();
        return q.Length == 0 ? _s!.Participantes.ToList()
            : _s!.Participantes.Where(p => (p.UnidadNumero + " " + p.Nombre).Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }
    private int PartPaginaActual(int n) => Math.Clamp(_partPagina, 1, Math.Max(1, (int)Math.Ceiling(n / (double)_partPorPagina)));

    // Poderes: registrar (unidad + apoderado del directorio + tipo) y aprobar/rechazar, con el limite por persona.
    private sealed class PoderForm
    {
        public string Unidad { get; set; } = "";
        public PersonaCandidatoDto? Apoderado { get; set; }
        public TipoPoder Tipo { get; set; } = TipoPoder.Pdf;
    }
    private PoderForm? _poderForm;
    private List<(Guid Id, string Numero, string Nombre)>? _unidades;
    private async Task NuevoPoderAsync()
    {
        _poderForm = new PoderForm();
        if (_s!.Participantes.Count > 0)
            _unidades = _s.Participantes.Select(p => (p.UnidadPrivadaId, p.UnidadNumero, p.Nombre)).ToList();
        else if (_unidades is null)
        {
            try
            {
                var l = await Auth().GetFromJsonAsync<List<Propia.Application.MiCopropiedad.UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
                _unidades = l.OrderBy(u => u.Numero).Select(u => (u.Id, u.Numero, u.PropietarioNombre ?? "")).ToList();
            }
            catch { _unidades = new(); }
        }
    }
    private async Task RegistrarPoderAsync()
    {
        var f = _poderForm!;
        if (!Guid.TryParse(f.Unidad, out var unidad)) { _msg = "Elige la unidad que otorga el poder."; _msgClass = "alert-danger"; return; }
        if (f.Apoderado is null) { _msg = "Elige el apoderado."; _msgClass = "alert-danger"; return; }
        if (await EjecutarAsync(h => h.PostAsJsonAsync($"/api/asambleas/{_id}/poderes", new OtorgarPoderRequest(unidad, f.Apoderado.PersonaId, f.Tipo, null)), "Poder registrado."))
            _poderForm = null;
    }
    private Task DecidirPoderAsync(Guid poderId, bool aprobar)
        => EjecutarAsync(h => h.PutAsJsonAsync($"/api/asambleas/poderes/{poderId}/decidir", new DecidirPoderRequest(aprobar, null)));

    private RenderFragment Participantes()
    {
        var suma = _s!.Participantes.Sum(p => p.Coeficiente);   // los coeficientes ya estan en porcentaje
        var lst = PartFiltrados();
        var pg = PartPaginaActual(lst.Count);
        var vivo = _s.Estado is not (EstadoSesion.Cerrada or EstadoSesion.QuorumFallido or EstadoSesion.Cancelada);
        var lim = _s.LimitePoderesPorPersona;
        return @<div>
            @if (_s.Participantes.Count > 0 && Math.Abs(suma - 100m) > 0.01m)
            {
                <div class="alert alert-warning py-2 small">Los coeficientes de las unidades suman <b>@suma.ToString("0.00")%</b> (deben sumar 100%). El quórum y las votaciones se calculan sobre esa suma: corrige los coeficientes en Unidades Privadas.</div>
            }
            <div class="row g-3">
                <div class="col-lg-7"><div class="card"><div class="card-body">
                    @if (_s.Participantes.Count == 0)
                    {
                        <p class="text-muted small mb-0">Aun no se ha citado la sesión: al citar se registran todas las unidades a nombre de su propietario.</p>
                    }
                    else
                    {
                        <div class="asm-part-tool"><input class="form-control form-control-sm" placeholder="Buscar unidad o persona..." @bind="_partQ" @bind:event="oninput" @bind:after="() => _partPagina = 1" /></div>
                        <div class="asf-part-scroll">
                            <table class="table table-sm mb-0 small">
                                <thead class="text-muted"><tr><th>Unidad</th><th>Persona</th><th class="text-end">Coef.</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var p in lst.Skip((pg - 1) * _partPorPagina).Take(_partPorPagina))
                                    {
                                        var uid = p.UnidadPrivadaId;
                                        var presente = p.Presente;
                                        var pd = _s.Poderes.FirstOrDefault(x => x.OtorganteUnidadId == uid && x.Estado == EstadoPoder.Aprobado);
                                        <tr>
                                            <td><strong class="u-cod">@p.UnidadNumero</strong></td>
                                            <td>@p.Nombre@if (pd is not null) { <div class="text-muted">por poder: @pd.ApoderadoNombre</div> }</td>
                                            <td class="text-end">@p.Coeficiente.ToString("0.00000")</td>
                                            <td>
                                                @if (_s.Estado == EstadoSesion.EnCurso)
                                                {
                                                    <button class="btn btn-sm @(presente ? "btn-success" : "btn-outline-secondary")" @onclick="() => CheckInAsync(uid, !presente)" disabled="@_busy">@(presente ? "Presente" : "Ausente")</button>
                                                }
                                                else if (presente) { <span class="badge bg-success">Presente</span> }
                                            </td>
                                        </tr>
                                    }
                                    @if (lst.Count == 0) { <tr><td colspan="4" class="text-muted text-center py-3">Ninguna unidad coincide con la búsqueda.</td></tr> }
                                </tbody>
                            </table>
                        </div>
                        <TablaPager Total="lst.Count" Pagina="pg" PorPagina="_partPorPagina" Entidad="unidades"
                                    PaginaChanged="n => _partPagina = n"
                                    PorPaginaChanged="n => { _partPorPagina = n; _partPagina = 1; }" />
                    }
                </div></div></div>
                <div class="col-lg-5"><div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Poderes (@_s.Poderes.Count)</h6>
                        <span class="small text-muted">@(lim is > 0 ? $"Límite: {lim} por persona" : "Sin límite por persona")</span>
                    </div>
                    @if (_s.Poderes.Count == 0) { <p class="text-muted small">No hay poderes registrados.</p> }
                    else
                    {
                        <ul class="list-unstyled small mb-2">
                            @foreach (var p in _s.Poderes)
                            {
                                var pid = p.Id;
                                <li class="mb-1 d-flex align-items-center gap-1 flex-wrap">
                                    <span class="badge me-1" style="background:@PoderColor(p.Estado); color: var(--propia-text-inverse);">@p.Estado</span>
                                    <strong class="u-cod">@p.OtorganteUnidadNumero</strong> &rarr; @p.ApoderadoNombre <span class="text-muted">(@(p.TipoPoder == TipoPoder.Digital ? "Digital" : "Escrito"))</span>
                                    @if (vivo && p.Estado == EstadoPoder.Pendiente)
                                    {
                                        <span class="ms-auto">
                                            <button class="btn btn-sm btn-outline-success py-0" @onclick="() => DecidirPoderAsync(pid, true)" disabled="@_busy">Aprobar</button>
                                            <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => DecidirPoderAsync(pid, false)" disabled="@_busy">Rechazar</button>
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (vivo)
                    {
                        if (_poderForm is not null)
                        {
                            <div class="asm-pedit">
                                <div class="row g-2">
                                    <div class="col-12"><label class="form-label small mb-1">Unidad que otorga el poder</label>
                                        <select class="form-select form-select-sm" @bind="_poderForm.Unidad">
                                            <option value="">Elige la unidad...</option>
                                            @foreach (var u in _unidades ?? new()) { <option value="@u.Id">@u.Numero@(string.IsNullOrWhiteSpace(u.Nombre) ? "" : " - " + u.Nombre)</option> }
                                        </select></div>
                                    <div class="col-8"><label class="form-label small mb-1">Apoderado</label>
                                        <SelectorPersona Flotante="true" Jwt="@Jwt" Placeholder="Buscar en el directorio..." Seleccionada="_poderForm.Apoderado" SeleccionadaChanged="c => _poderForm.Apoderado = c" /></div>
                                    <div class="col-4"><label class="form-label small mb-1">Tipo</label>
                                        <select class="form-select form-select-sm" @bind="_poderForm.Tipo">
                                            <option value="@TipoPoder.Pdf">Escrito</option>
                                            <option value="@TipoPoder.Digital">Digital</option>
                                        </select></div>
                                </div>
                                <div class="small text-muted mt-1">El poder escrito queda Pendiente hasta aprobarlo; el digital queda aprobado al registrarlo.</div>
                                <div class="d-flex justify-content-end gap-2 mt-2">
                                    <button class="btn btn-sm btn-outline-dark" @onclick="() => _poderForm = null">Cancelar</button>
                                    <button class="btn btn-sm btn-primary" @onclick="RegistrarPoderAsync" disabled="@_busy">Registrar poder</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-dark" @onclick="NuevoPoderAsync">+ Registrar poder</button>
                        }
                    }
                    else { <div class="small text-muted mt-2">La sesión terminó: los poderes ya no cambian.</div> }
                </div></div></div>
            </div>
        </div>;
    }
    private static string PoderColor(EstadoPoder e) => e switch
    {
        EstadoPoder.Aprobado => "var(--propia-success)",
        EstadoPoder.Rechazado => "var(--propia-danger)",
        _ => "var(--propia-text-faint)"
    };

    // ===================== Pestana Sala virtual (Virtual/Mixta) =====================
    private Task UsarSalaPropiaAsync() => EjecutarAsync(h => h.PutAsJsonAsync($"/api/asambleas/{_id}", new ActualizarSesionRequest(SalaPropia: true)), "La sesión usará la sala virtual de PROPIA.");

    private RenderFragment Sala()
    {
        if (!_s!.SalaPropia)
        {
            var puede = _s.Estado is EstadoSesion.Borrador or EstadoSesion.Citada;
            return @<div class="asm-sala-aviso">
                <i class="fi fi-rr-share-square"></i>
                <div class="asm-sala-aviso-t">Esta sesión usa un enlace externo</div>
                <div class="asm-sala-aviso-s"><span>La videollamada ocurre fuera de PROPIA</span>@if (!string.IsNullOrEmpty(_s.EnlaceVideo)) { <span> (<a href="@_s.EnlaceVideo" target="_blank" rel="noopener">@_s.EnlaceVideo</a>)</span> }<span>: la asistencia y los votos se registran a mano.</span></div>
                @if (puede) { <button type="button" class="btn btn-sm btn-primary mt-2" @onclick="UsarSalaPropiaAsync" disabled="@_busy">Usar la sala virtual de PROPIA</button> }
                @if (_s.Estado == EstadoSesion.EnCurso) { <div class="text-start mt-3">@Transcripcion()</div> }
            </div>;
        }
        var gracia = (_cfg?.GraciaReconexionSeg ?? 0) + " s";
        if (_s.Estado is EstadoSesion.Borrador or EstadoSesion.Citada)
            return @<div class="asm-sala-aviso">
                <i class="fi fi-rr-video-camera-alt"></i>
                <div class="asm-sala-aviso-t">La sala virtual se abre con la sesión</div>
                <div class="asm-sala-aviso-s">Al pulsar <b>Abrir sala</b> se habilita la videollamada. Los propietarios y apoderados entran desde su enlace personal o con su cuenta: <b>al entrar quedan presentes</b> y al salir se registra la salida tras @gracia de gracia de reconexión.</div>
            </div>;
        if (_s.Estado != EstadoSesion.EnCurso)
        {
            var grabada = _s.Documentos.Any(d => d.Tipo == TipoDocumentoSesion.Grabacion);
            return @<div class="asm-sala-aviso">
                <i class="fi fi-rr-video-slash"></i>
                <div class="asm-sala-aviso-t">La sala virtual se cerró con la sesión</div>
                <div class="asm-sala-aviso-s">@(grabada ? "La grabación quedó en Documentos como soporte del acta." : "Esta sesión no se grabó.")</div>
            </div>;
        }
        if (_salaCfg is { Configurada: false })
            return @<div>
                <div class="asm-sala-aviso">
                    <i class="fi fi-rr-video-camera-alt"></i>
                    <div class="asm-sala-aviso-t">La sala virtual no está configurada</div>
                    <div class="asm-sala-aviso-s">A&amp;D debe activar el servidor de video (LiveKit). Mientras tanto registra la asistencia en Participantes y los votos en el Orden del día.</div>
                </div>
                @Transcripcion()
            </div>;
        return @<div class="asm-sala">
            @Escenario()
            @Lateral()
        </div>;
    }

    // ===================== Sala virtual en vivo (ola 5: LiveKit) =====================
    private sealed record SalaPart(string Id, string Nombre, bool Yo, bool Mod, bool Mic, bool Cam, bool Pantalla, bool Habla, bool Mano);
    private sealed record SalaMsg(string Autor, string Texto, DateTime Hora, bool Yo);
    private static readonly System.Text.Json.JsonSerializerOptions JsonWeb = new(System.Text.Json.JsonSerializerDefaults.Web);
    private SalaConfigDto? _salaCfg;
    private bool _salaConectada, _salaConectando, _conMic = true, _conCam, _mic, _cam, _compartir;
    private string? _salaAviso, _salaEstado, _palabra, _ultPartsJson;
    private string _salaPanel = "gestion", _chatTxt = "";
    private List<SalaPart> _salaParts = new();
    private readonly List<SalaMsg> _chat = new();
    private System.Threading.Timer? _salaPoll;
    private string GridId => "asm-grid-" + _id.ToString("N");
    private DotNetObjectReference<AsambleaFichaModal> JsRef() => _dictRef ??= DotNetObjectReference.Create(this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // El mosaico vive en un contenedor que Blazor recrea al volver a la pestana: se re-ubica (no-op si es el mismo).
        if (_salaConectada && _tab == "sala") { try { await Js.InvokeAsync<bool>("propiaSala.montar", GridId); } catch { } }
    }

    private async Task EntrarSalaAsync()
    {
        _salaAviso = null; _salaConectando = true;
        try
        {
            var resp = await Auth().PostAsync($"/api/asambleas/{_id}/sala/acceso", null);
            if (!resp.IsSuccessStatusCode) { _salaAviso = await LeerErrorAsync(resp); return; }
            var a = (await resp.Content.ReadFromJsonAsync<SalaAccesoDto>())!;
            StateHasChanged();
            var r = await Js.InvokeAsync<string>("propiaSala.conectar", JsRef(), GridId, a.Url, a.Token, _conMic, _conCam);
            if (r.StartsWith("error:")) { _salaAviso = "No se pudo entrar a la sala: " + r[6..]; return; }
            _salaConectada = true; _salaEstado = "conectado"; _mic = _conMic && r != "ok:sin-microfono"; _cam = _conCam && r != "ok:sin-camara";
            if (r == "ok:sin-microfono") _salaAviso = "El navegador no dio permiso para el micrófono: entraste sin audio.";
            else if (r == "ok:sin-camara") _salaAviso = "El navegador no dio permiso para la cámara: entraste sin video.";
            // Mientras se esta en la sala, la ficha se refresca sola (asistencia por webhook, votos, grabacion).
            _salaPoll ??= new System.Threading.Timer(_ => InvokeAsync(async () =>
            {
                if (_busy || !_salaConectada) return;
                await CargarAsync();
                if (_s is not null && _s.Estado != EstadoSesion.EnCurso) await SalirSalaAsync();
                StateHasChanged();
            }), null, 5000, 5000);
        }
        catch (Exception ex) { _salaAviso = ex.Message; }
        finally { _salaConectando = false; }
    }

    private async Task SalirSalaAsync()
    {
        _salaPoll?.Dispose(); _salaPoll = null;
        try { await Js.InvokeVoidAsync("propiaSala.salir"); } catch { }
        _salaConectada = false; _mic = _cam = _compartir = false; _salaParts = new(); _palabra = null; _ultPartsJson = null;
    }

    private async Task MicAsync() { _mic = await Js.InvokeAsync<bool>("propiaSala.microfono", !_mic); }
    private async Task CamAsync()
    {
        var quiero = !_cam;
        _cam = await Js.InvokeAsync<bool>("propiaSala.camara", quiero);
        if (quiero && !_cam) _salaAviso = "No se pudo encender la cámara (permiso del navegador).";
    }
    private async Task PantallaAsync() { _compartir = await Js.InvokeAsync<bool>("propiaSala.pantalla", !_compartir); }
    private async Task GrabarAsync()
    {
        var activa = _s!.GrabandoDesde is null;
        await EjecutarAsync(h => h.PutAsync($"/api/asambleas/{_id}/sala/grabacion?activa={(activa ? "true" : "false")}", null),
            activa ? "Grabación iniciada: el video queda en Documentos al terminar." : "Grabación detenida: el video llegará a Documentos en unos minutos.");
    }
    private async Task DarPalabraAsync(string? identidad) => await Js.InvokeVoidAsync("propiaSala.darPalabra", identidad);
    private async Task SilenciarTodosAsync() { await Js.InvokeVoidAsync("propiaSala.silenciarTodos"); _salaAviso = "Se pidió silenciar todos los micrófonos."; }
    private async Task EnviarChatAsync()
    {
        var t = _chatTxt.Trim();
        if (t.Length == 0) return;
        if (await Js.InvokeAsync<bool>("propiaSala.chat", t)) { _chat.Add(new SalaMsg("Tú", t, Local(DateTimeOffset.UtcNow), true)); _chatTxt = ""; }
    }
    private async Task ChatKeyAsync(KeyboardEventArgs e) { if (e.Key == "Enter") await EnviarChatAsync(); }

    [JSInvokable]
    public void SalaParticipantes(string json)
    {
        if (json == _ultPartsJson) return;
        _ultPartsJson = json;
        _salaParts = System.Text.Json.JsonSerializer.Deserialize<List<SalaPart>>(json, JsonWeb) ?? new();
        if (_salaParts.FirstOrDefault(x => x.Yo) is { } yo) { _mic = yo.Mic; _cam = yo.Cam; _compartir = yo.Pantalla; }
        StateHasChanged();
    }
    [JSInvokable]
    public void SalaChat(string autor, string texto, bool yo) { _chat.Add(new SalaMsg(autor, texto, Local(DateTimeOffset.UtcNow), yo)); StateHasChanged(); }
    [JSInvokable]
    public void SalaPalabra(string identidad) { _palabra = string.IsNullOrEmpty(identidad) ? null : identidad; StateHasChanged(); }
    [JSInvokable]
    public void SalaAviso(string texto) { _salaAviso = texto; StateHasChanged(); }
    [JSInvokable]
    public void SalaMicrofono(bool on) { _mic = on; StateHasChanged(); }
    [JSInvokable]
    public void SalaEstado(string estado)
    {
        _salaEstado = estado;
        if (estado.StartsWith("desconectado"))
        {
            _salaPoll?.Dispose(); _salaPoll = null;
            _salaConectada = false; _salaParts = new(); _palabra = null; _ultPartsJson = null;
            if (estado != "desconectado:1") _salaAviso = "Saliste de la sala.";
        }
        StateHasChanged();
    }

    private static string Iniciales(string n) => string.Concat(n.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));

    private RenderFragment Ctrl(string label, string icono, bool on, Func<Task> accion, string extra = "", bool deshabilitado = false, string? titulo = null)
        => @<button type="button" class="asm-ctrl @(on ? "on" : "") @extra" title="@(titulo ?? label)" @onclick="accion" disabled="@deshabilitado"><i class="fi fi-rr-@icono"></i><span>@label</span></button>;

    private RenderFragment Escenario()
    {
        var grabando = _s!.GrabandoDesde is not null;
        var enSala = _salaParts.Count;
        return @<div class="asm-stage">
            <div class="asm-stage-top">
                @if (_salaConectada) { <span class="asm-live">EN VIVO</span><span>@enSala en la sala</span> }
                else { <span>La sala está abierta</span> }
                @if (grabando) { <span class="asm-rec"><i class="fi fi-rr-record-vinyl"></i> Grabando desde las @Local(_s.GrabandoDesde!.Value).ToString("HH:mm")</span> }
                @if (_s.TranscripcionActiva) { <span class="asm-txon"><i class="fi fi-rr-subtitles"></i> Transcribiendo para el acta</span> }
                @if (_dictando) { <span class="asm-txon"><i class="fi fi-rr-microphone-alt"></i> Tu voz se transcribe</span> }
                @if (_compartir) { <span class="asm-share-on"><i class="fi fi-rr-screen"></i> Estás compartiendo tu pantalla</span> }
                @if (_salaEstado == "reconectando") { <span class="asm-rec">Reconectando...</span> }
            </div>
            @if (grabando || _s.TranscripcionActiva)
            {
                <div class="asm-aviso-datos">Esta sesión se @(grabando && _s.TranscripcionActiva ? "graba y se transcribe" : grabando ? "graba" : "transcribe") para elaborar el acta (Ley 1581 de 2012).</div>
            }
            @if (_salaAviso is not null) { <div class="asm-stage-aviso">@_salaAviso <button type="button" class="asm-stage-aviso-x" @onclick="() => _salaAviso = null" aria-label="Cerrar aviso">&times;</button></div> }
            @if (!_salaConectada)
            {
                <div class="asm-prejoin">
                    <div class="asm-tile-av"><i class="fi fi-rr-video-camera-alt"></i></div>
                    <div class="asm-prejoin-t">Entra como moderador</div>
                    <div class="asm-prejoin-s">Los propietarios y apoderados entran con su enlace de la asamblea: al entrar quedan presentes y, si salen, la salida se registra tras @(_cfg?.GraciaReconexionSeg ?? 60) s de gracia de reconexión.</div>
                    <div class="asm-prejoin-op">
                        <label><input type="checkbox" @bind="_conMic" /> Micrófono</label>
                        <label><input type="checkbox" @bind="_conCam" /> Cámara</label>
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="EntrarSalaAsync" disabled="@_salaConectando">@(_salaConectando ? "Conectando..." : "Entrar a la sala")</button>
                </div>
            }
            <div class="asm-grid @(_salaConectada ? "" : "d-none")" id="@GridId"></div>
            @if (_salaConectada)
            {
                <div class="asm-ctrls">
                    @Ctrl(_mic ? "Silenciar" : "Activar micrófono", _mic ? "microphone" : "microphone-slash", _mic, MicAsync)
                    @Ctrl(_cam ? "Apagar cámara" : "Encender cámara", _cam ? "video-camera-alt" : "video-slash", _cam, CamAsync)
                    @Ctrl(_compartir ? "Dejar de compartir" : "Compartir pantalla", "screen", _compartir, PantallaAsync)
                    @Ctrl(grabando ? "Detener grabación" : "Grabar", grabando ? "stop-circle" : "record-vinyl", grabando, GrabarAsync, grabando ? "is-rec" : "",
                        _busy || _salaCfg?.GrabacionConfigurada != true, _salaCfg?.GrabacionConfigurada == true ? null : "La grabación no está configurada (almacenamiento de LiveKit)")
                    @Ctrl(_s.TranscripcionActiva ? "Pausar transcripción" : "Transcribir", "subtitles", _s.TranscripcionActiva, ToggleTranscripcionAsync, "", _busy)
                    @Ctrl(_dictando ? "Dejar de dictar" : "Mi voz a texto", "microphone-alt", _dictando, ToggleDictadoAsync, "", !_s.TranscripcionActiva)
                    <button type="button" class="asm-ctrl asm-ctrl--salir" title="Salir de la sala" @onclick="SalirSalaAsync"><i class="fi fi-rr-phone-slash"></i><span>Salir</span></button>
                </div>
            }
        </div>;
    }

    private RenderFragment Lateral()
    {
        var nVoz = _tx.Count(l => l.Tipo == TipoLineaTranscripcion.Voz);
        return @<aside class="asm-side">
            <div class="asm-side-tabs">
                <button type="button" class="asm-side-tab @(_salaPanel == "gestion" ? "on" : "")" @onclick='() => _salaPanel = "gestion"'>Moderación</button>
                <button type="button" class="asm-side-tab @(_salaPanel == "tx" ? "on" : "")" @onclick='() => _salaPanel = "tx"'>Transcripción (@nVoz)</button>
                <button type="button" class="asm-side-tab @(_salaPanel == "chat" ? "on" : "")" @onclick='() => _salaPanel = "chat"'>Chat (@_chat.Count)</button>
            </div>
            @if (_salaPanel == "tx")
            {
                var pa = _s!.Puntos.FirstOrDefault(p => p.Id == _s.PuntoActualId);
                <div class="asm-side-body">
                    <div class="asm-tx-info">@(_s.TranscripcionActiva ? (pa is null ? "Inicia un punto del orden del día para asociar lo que se dice." : $"Asociando al punto {pa.Numero}: {pa.Titulo}") : "La transcripción está en pausa. Actívala con Transcribir: con ella la IA redacta el acta al cerrar.")</div>
                    @if (_dictando) { <div class="asm-tx-interim">@(string.IsNullOrEmpty(_parcial) ? "Escuchando..." : _parcial + "...")</div> }
                    @if (_dictadoError is not null) { <div class="alert alert-warning py-2 small mb-2">@_dictadoError</div> }
                    @TxLista()
                </div>
            }
            else if (_salaPanel == "chat")
            {
                <div class="asm-side-body">
                    @if (_chat.Count == 0) { <div class="asm-side-vacio mt-2">Sin mensajes. El chat no se guarda: es solo de la llamada.</div> }
                    @foreach (var c in _chat)
                    {
                        <div class="asm-chat-msg"><div class="asm-chat-hd"><b>@c.Autor</b><span>@c.Hora.ToString("HH:mm")</span></div><div>@c.Texto</div></div>
                    }
                </div>
                <div class="asm-chat-new">
                    <input class="form-control form-control-sm" placeholder="Escribe a la sala..." @bind="_chatTxt" @bind:event="oninput" @onkeydown="ChatKeyAsync" disabled="@(!_salaConectada)" maxlength="1000" />
                    <button type="button" class="btn btn-sm btn-primary" @onclick="EnviarChatAsync" disabled="@(!_salaConectada)">Enviar</button>
                </div>
            }
            else
            {
                var manos = _salaParts.Where(x => x.Mano && !x.Yo).ToList();
                var habla = _palabra is null ? null : _salaParts.FirstOrDefault(x => x.Id == _palabra);
                var va = VotacionAbierta();
                var otros = _salaParts.Where(x => !x.Yo).OrderBy(x => x.Nombre).ToList();
                <div class="asm-side-body">
                    <div class="asm-side-sec d-flex justify-content-between align-items-center">
                        <span>PALABRA (@manos.Count)</span>
                        @if (_salaConectada && otros.Count > 0) { <button type="button" class="btn btn-sm btn-link p-0" @onclick="SilenciarTodosAsync">Silenciar a todos</button> }
                    </div>
                    @if (habla is not null)
                    {
                        <div class="asm-side-row is-habla"><span class="asm-side-av">@Iniciales(habla.Nombre)</span><div class="asm-side-nm">@habla.Nombre<small>tiene la palabra</small></div><button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => DarPalabraAsync(null)">Terminar</button></div>
                    }
                    @if (manos.Count == 0) { <div class="asm-side-vacio">@(_salaConectada ? "Nadie ha pedido la palabra." : "Entra a la sala para moderar los turnos.")</div> }
                    @foreach (var m in manos)
                    {
                        var ident = m.Id;
                        <div class="asm-side-row"><span class="asm-side-av"><i class="fi fi-rr-hand"></i></span><div class="asm-side-nm">@m.Nombre</div><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => DarPalabraAsync(ident)">Dar la palabra</button></div>
                    }
                    <div class="asm-side-sec">VOTACIÓN</div>
                    @if (va?.Votacion is { } v)
                    {
                        <div class="asm-vot">
                            <div class="asm-vot-t">@va.Numero. @va.Titulo</div>
                            <div class="asm-vot-s">@v.Votos.Count de @_s!.Participantes.Count(x => x.Presente) presentes han votado@(va.ModalidadVoto == ModalidadVoto.Secreto ? " · voto secreto" : "")</div>
                            @if (va.ModalidadVoto != ModalidadVoto.Secreto && v.Votos.Count > 0)
                            {
                                var tot = v.Votos.Sum(x => x.CoeficienteAportado);
                                @foreach (var op in va.OpcionesVoto)
                                {
                                    var pct = tot > 0 ? v.Votos.Where(x => x.Opcion == op).Sum(x => x.CoeficienteAportado) / tot * 100m : 0m;
                                    <div class="asm-vot-op"><span>@OpcionTexto(op)</span><div class="asm-vot-bar"><div style="width:@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div><b>@pct.ToString("0.00")%</b></div>
                                }
                            }
                            <button type="button" class="btn btn-sm btn-outline-dark w-100 mt-2" @onclick="() => CerrarVotacionAsync(v.Id)" disabled="@_busy">Cerrar votación</button>
                        </div>
                    }
                    else
                    {
                        var pend = _s!.Puntos.Where(p => p.RequiereVotacion && p.Votacion is null && p.Estado is EstadoPunto.Pendiente or EstadoPunto.EnDiscusion).Take(3).ToList();
                        <div class="asm-side-vacio">@(pend.Count > 0 ? "Ningún punto en votación." : "No quedan puntos por votar.")</div>
                        @foreach (var p in pend)
                        {
                            var pid = p.Id;
                            <div class="asm-side-row"><div class="asm-side-nm">@p.Numero. @p.Titulo</div><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AbrirVotacionAsync(pid)" disabled="@(_busy || _s.Instalacion is null)">Abrir</button></div>
                        }
                    }
                    <div class="asm-side-sec">EN LA SALA (@otros.Count)</div>
                    @if (otros.Count == 0) { <div class="asm-side-vacio">@(_salaConectada ? "Aún no entra nadie más." : "—")</div> }
                    @foreach (var o in otros.Take(40))
                    {
                        <div class="asm-side-row"><span class="asm-side-av">@Iniciales(o.Nombre)</span><div class="asm-side-nm">@o.Nombre<small>@(o.Mod ? "Moderador" : "Copropietario")@(o.Mic ? "" : " · silenciado")</small></div></div>
                    }
                    @if (otros.Count > 40) { <div class="asm-side-vacio">y @(otros.Count - 40) más (ver Participantes)</div> }
                </div>
            }
        </aside>;
    }

    // ===================== Pestana Documentos =====================
    private TipoDocumentoSesion _docTipo = TipoDocumentoSesion.Informe;
    private bool _subiendo;
    private async Task SubirDocumentoAsync(InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (f.Size > 10_000_000) { _msg = "Máximo 10 MB por documento."; _msgClass = "alert-danger"; return; }
        _subiendo = true; _msg = null;
        try
        {
            // Bufferizar antes de cualquier await de red (InputFile se puede desmontar al re-renderizar).
            using var ms = new MemoryStream();
            await f.OpenReadStream(10_000_000).CopyToAsync(ms);
            using var form = new MultipartFormDataContent();
            var file = new ByteArrayContent(ms.ToArray());
            file.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType);
            form.Add(file, "file", f.Name);
            form.Add(new StringContent(((int)_docTipo).ToString()), "tipo");
            var resp = await Auth().PostAsync($"/api/asambleas/{_id}/documentos/archivo", form);
            if (!resp.IsSuccessStatusCode) { _msg = await LeerErrorAsync(resp); _msgClass = "alert-danger"; return; }
            _hubo = true;
            await CargarAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _msgClass = "alert-danger"; }
        finally { _subiendo = false; }
    }
    private Task EliminarDocumentoAsync(Guid docId) => EjecutarAsync(h => h.DeleteAsync($"/api/asambleas/documentos/{docId}"));
    private static bool Generado(TipoDocumentoSesion t) => t is TipoDocumentoSesion.Convocatoria or TipoDocumentoSesion.Acta or TipoDocumentoSesion.Grabacion;
    private static string TipoDocTexto(TipoDocumentoSesion t) => t switch
    {
        TipoDocumentoSesion.Convocatoria => "Convocatoria",
        TipoDocumentoSesion.Informe => "Informe",
        TipoDocumentoSesion.Poder => "Poder",
        TipoDocumentoSesion.Grabacion => "Grabación",
        TipoDocumentoSesion.Acta => "Acta",
        _ => "Soporte"
    };

    private RenderFragment Documentos() => @<div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
            <h6 class="mb-0">Documentos de la sesión</h6>
            @if (_s!.Estado != EstadoSesion.Cerrada)
            {
                <div class="d-flex gap-2 align-items-center">
                    <select class="form-select form-select-sm" style="width:auto" @bind="_docTipo">
                        <option value="@TipoDocumentoSesion.Informe">Informe</option>
                        <option value="@TipoDocumentoSesion.Poder">Poder escaneado</option>
                        <option value="@TipoDocumentoSesion.Otro">Soporte</option>
                    </select>
                    <label class="btn btn-sm btn-outline-dark mb-0 @(_subiendo ? "disabled" : "")"><i class="fi fi-rr-upload me-1"></i>@(_subiendo ? "Subiendo..." : "Subir documento")<InputFile OnChange="SubirDocumentoAsync" hidden disabled="@_subiendo" /></label>
                </div>
            }
        </div>
        @if (_s.Documentos.Count == 0)
        {
            <div class="asm-empty"><i class="fi fi-rr-folder-open"></i><div class="asm-empty-t">Sin documentos.</div><div class="asm-empty-s">Al citar se genera la convocatoria; sube informes, cotizaciones o poderes escaneados.</div></div>
        }
        else
        {
            <table class="table table-sm small mb-0">
                <thead class="text-muted"><tr><th>Documento</th><th>Tipo</th><th>Fecha</th><th class="text-end">Tamaño</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in _s.Documentos)
                    {
                        var did = d.Id;
                        <tr>
                            <td><i class="fi fi-rr-document me-1"></i>@d.Nombre @if (Generado(d.Tipo)) { <span class="badge bg-light text-dark border">Generado</span> }</td>
                            <td>@TipoDocTexto(d.Tipo)</td>
                            <td>@Local(d.CreatedAt).ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">@(d.TamanioBytes > 0 ? Math.Max(1, d.TamanioBytes / 1024).ToString("#,##0") + " KB" : "")</td>
                            <td class="text-end">
                                <a class="btn btn-link btn-sm p-0" href="@d.UrlStorage" target="_blank" rel="noopener">Ver</a>
                                @if (!Generado(d.Tipo) && _s.Estado != EstadoSesion.Cerrada) { <button class="btn btn-link btn-sm p-0 ms-2 text-danger" @onclick="() => EliminarDocumentoAsync(did)" disabled="@_busy">Eliminar</button> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div></div>;

    // ===================== Pestana Acta (borrador por IA + doble firma + publicacion) =====================
    private RenderFragment Acta()
    {
        var a = _s!.Acta;
        if (a is null)
        {
            return @<div class="asm-empty"><i class="fi fi-rr-document"></i><div class="asm-empty-t">Aún no hay acta</div>
                <div class="asm-empty-s">@(_s.Estado == EstadoSesion.QuorumFallido ? "La sesión se cerró sin quórum: no se genera acta. Convoca la segunda convocatoria." : "Al cerrar la sesión con quórum, la IA redacta el borrador del acta con los datos de la sesión.")</div></div>;
        }
        var firmaP = a.FirmaPresidente; var firmaS = a.FirmaSecretario;
        var algunaFirma = firmaP is not null || firmaS is not null;
        var borrador = a.Estado == EstadoActa.Borrador;
        var redactando = a.EstadoRedaccion == EstadoRedaccionActa.Redactando;
        if (string.IsNullOrEmpty(a.BorradorHtml))
        {
            // Acta anterior a la ola 3 (solo datos en JSON).
            return @<div>
                <div class="asm-acta-bar">
                    <div class="asm-acta-ia"><i class="fi fi-rr-document"></i><div><b>Acta</b> &middot; @BadgeActa(a.Estado)<div class="small text-muted">Esta acta solo tiene los datos de la sesión (se generó antes del acta legible).</div></div></div>
                    @if (borrador) { <div class="asm-acta-acts"><button class="btn btn-sm btn-primary" @onclick="RedactarActaAsync" disabled="@_busy">Redactar acta con IA</button></div> }
                </div>
                <details class="small" open><summary class="text-muted">Datos de la sesión (JSON)</summary><pre class="bg-light p-2 mt-2 small" style="max-height: 300px; overflow:auto;">@a.ContenidoGenerado</pre></details>
            </div>;
        }
        return @<div>
            <div class="asm-acta-bar">
                <div class="asm-acta-ia"><i class="fi fi-rr-magic-wand"></i><div><b>Acta No. @a.Numero</b> &middot; @BadgeActa(a.Estado)
                    <div class="small text-muted">
                        @if (redactando) { <span class="spinner-border spinner-border-sm me-1" style="color: var(--propia-primary);"></span>@("La IA está redactando el acta con los datos de la sesión...") }
                        else if (a.EstadoRedaccion == EstadoRedaccionActa.Error && borrador) { <span>No se pudo redactar con la IA (@a.ErrorRedaccion). Queda el borrador con los datos de la sesión.</span> }
                        else { <span>@(a.RedactadaPorIa ? "Borrador redactado por la IA" : "Borrador con los datos de la sesión")@(a.Editada ? " y editado a mano" : "")@(borrador ? ". Revísalo antes de firmar." : ".")</span> }
                    </div></div></div>
                <div class="asm-acta-acts">
                    @if (borrador && algunaFirma) { <span class="small text-muted align-self-center">Ya tiene una firma: el texto no se puede cambiar.</span> }
                    @if (borrador && !algunaFirma)
                    {
                        if (_actaEdit)
                        {
                            <button class="btn btn-sm btn-primary" @onclick="GuardarActaAsync" disabled="@_busy">Guardar cambios</button>
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => { _actaEdit = false; _actaRev++; }">Cancelar</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => _actaEdit = true" disabled="@(_busy || redactando)">Editar</button>
                            <button class="btn btn-sm btn-outline-dark" @onclick="RegenerarActaAsync" disabled="@(_busy || redactando)">Regenerar con IA</button>
                        }
                    }
                    @if (borrador && !_actaEdit && _s.Instalacion is not null)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => AbrirFirma(RolFirmaActa.Presidente)" disabled="@(_busy || firmaP is not null || redactando)">@(firmaP is not null ? "✓ Presidente" : "Firmar como presidente")</button>
                        <button class="btn btn-sm btn-success" @onclick="() => AbrirFirma(RolFirmaActa.Secretario)" disabled="@(_busy || firmaS is not null || redactando)">@(firmaS is not null ? "✓ Secretario" : "Firmar como secretario")</button>
                    }
                    @if (a.Estado == EstadoActa.Firmada && a.PublicadaEn is null)
                    {
                        <button class="btn btn-sm" style="background: var(--propia-primary); color: var(--propia-text-inverse);" @onclick="PublicarActaAsync" disabled="@_busy">Publicar</button>
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_s.JustificacionQuorum)) { <div class="alert alert-warning py-2 small">Quórum corregido al cerrar: @_s.JustificacionQuorum</div> }
            @if (a.Estado == EstadoActa.Firmada)
            {
                <div class="small text-muted mb-2">
                    Firmada @a.TimestampFirma?.ToOffset(Colombia).ToString("yyyy-MM-dd HH:mm") por presidente y secretario &middot; Hash: <code class="small">@(a.HashDocumento is null ? "" : a.HashDocumento[..Math.Min(16, a.HashDocumento.Length)])</code>...
                    @if (a.PublicadaEn.HasValue)
                    {
                        <text> &middot; <span class="badge bg-success">Publicada @Local(a.PublicadaEn.Value).ToString("yyyy-MM-dd")</span></text>
                        @if (a.ComunicadoId is not null) { <text> &middot; <a href="/comunicaciones" target="_blank" rel="noopener">Comunicado en borrador</a></text> }
                        @if (!string.IsNullOrEmpty(a.DocumentoUrl)) { <text> &middot; <a href="@a.DocumentoUrl" target="_blank" rel="noopener">PDF</a></text> }
                    }
                    else if (a.PlazoPublicacion is { } pz) { <text> &middot; publicar antes del @pz.ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CO")) (20 días hábiles, Ley 675 art. 47)</text> }
                </div>
            }
            <div @key="ClavePapel(a)" id="asm-acta-doc" class="asm-acta-paper @(_actaEdit ? "is-edit" : "")" contenteditable="@(_actaEdit ? "true" : "false")">@((MarkupString)a.BorradorHtml)</div>
            <details class="small mt-3"><summary class="text-muted">Transcripción de la sesión (@_tx.Count líneas)</summary><div class="asm-tx-full">@TxLista()</div></details>
            <details class="small mt-2"><summary class="text-muted">Datos de la sesión (JSON, anexo)</summary><pre class="bg-light p-2 mt-2 small" style="max-height: 300px; overflow:auto;">@a.ContenidoGenerado</pre></details>
        </div>;
    }
}
