        EstadoSesion.QuorumFallido => @<span class="badge bg-warning text-dark">Quórum fallido</span>,
        EstadoSesion.Cancelada => @<span class="badge bg-secondary">Cancelada</span>,
        _ => __b => { }
    };
    private static RenderFragment BadgePunto(EstadoPunto e) => e switch
    {
        EstadoPunto.Pendiente => @<span class="badge bg-light text-dark border">Pendiente</span>,
        EstadoPunto.EnDiscusion => @<span class="badge bg-info text-dark">En discusión</span>,
        EstadoPunto.EnVotacion => @<span class="badge bg-primary">En votación</span>,
        EstadoPunto.Cerrado => @<span class="badge bg-success">Cerrado</span>,
        EstadoPunto.NoTratado => @<span class="badge bg-secondary">No tratado</span>,
