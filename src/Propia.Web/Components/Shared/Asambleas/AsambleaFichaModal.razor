    };
    private static string QuorumRequeridoTexto(QuorumDto q) =>
        q.SegundaConvocatoria ? "(segunda convocatoria: basta un número plural)"
        : q.PctRequerido is decimal r ? $"(se requiere {(q.Criterio == CriterioMayoria.AlMenos ? "al menos el" : "más del")} {r:0.00}%)" : "";
    private static string EstadoColor(EstadoSesion e) => e switch
