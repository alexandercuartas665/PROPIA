            <div class="col-md-12"><label class="form-label small mb-1">Opciones de voto para elecciones (planchas o candidatos, separadas por coma; vacío = Sí / No / Abstención)</label>
                <input class="form-control form-control-sm" @bind="_edit!.Opciones" @bind:event="oninput" placeholder="Plancha 1, Plancha 2, Voto en blanco" /></div>
            <div class="col-md-4"><div class="form-check mt-1"><input class="form-check-input" type="checkbox" id="asm-pe-rv" @bind="_edit!.RequiereVotacion" /><label class="form-check-label small" for="asm-pe-rv">Requiere votación</label></div></div>
            <div class="col-md-4"><select class="form-select form-select-sm" @bind="_edit!.TipoMayoria">
                <option value="@TipoMayoria.Simple">Mayoría simple</option><option value="@TipoMayoria.Calificada">Mayoría calificada (70%)</option>
            </select></div>
            <div class="col-md-4"><div class="input-group input-group-sm"><span class="input-group-text">Más del</span><input type="number" min="50" max="100" class="form-control" @bind="_edit!.MayoriaPct" /><span class="input-group-text">%</span></div></div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-2">
            <button class="btn btn-sm btn-outline-dark" @onclick="() => _edit = null">Cancelar</button>
            <button class="btn btn-sm btn-primary" @onclick="GuardarPuntoAsync" disabled="@_busy">@(_edit!.Id is null ? "Agregar punto" : "Guardar punto")</button>
        </div>
    </div>;

    private RenderFragment NotaPlazo()
    {
        if (_s!.Estado != EstadoSesion.Borrador) return __b => { };
        var plazo = _cfg?.PlazoCitacionDias ?? _s.PlazoCitacionDias;
        var dias = (int)Math.Floor((_s.FechaSesion - DateTimeOffset.UtcNow).TotalDays);
        var fuera = !_s.SegundaConvocatoria && dias < plazo;
        var bloquea = fuera && _s.Tipo == TipoSesion.AsambleaOrdinaria;
        return @<div class="asm-nota">Puedes editar el orden del día hasta citar: la citación sale con este orden.@if (fuera) {<text> <b>Ojo:</b> faltan @Math.Max(0, dias) días para la sesión y el plazo de citación es de @plazo@(bloquea ? " (la asamblea ordinaria no se puede citar así: cambia la fecha)." : ".")</text>}</div>;
    }

    private RenderFragment Orden() => @<div>
        @if (_s!.Modalidad == ModalidadSesion.Presencial && _s.Estado == EstadoSesion.EnCurso) { @Transcripcion() }
        @Instalacion()
        @NotaPlazo()
        <div class="card"><div class="card-body">
            @foreach (var p in _s!.Puntos)
            {
                var pid = p.Id;
                if (_edit?.Id == pid) { @PuntoEditor() continue; }
                var actual = _s.PuntoActualId == pid && _s.Estado == EstadoSesion.EnCurso;
                <div class="border-bottom py-2 @(actual ? "asm-punto-actual" : "")">
                    <div class="d-flex justify-content-between mb-1 gap-2">
                        <strong>@p.Numero. @p.Titulo @if (actual) { <span class="asm-live">EN CURSO</span> }</strong>
                        <span class="small d-flex gap-1 align-items-center">
                            @BadgePunto(p.Estado)
                            @if (_s.Estado == EstadoSesion.Borrador)
