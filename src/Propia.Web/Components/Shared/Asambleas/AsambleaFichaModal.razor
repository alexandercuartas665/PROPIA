    // Edicion del orden del dia (solo Borrador): titulo, descripcion, votacion, mayoria y opciones propias (planchas).
    private sealed class PuntoEdit
    {
        public Guid? Id { get; set; }
        public string Titulo { get; set; } = "";
        public string? Descripcion { get; set; }
        public string Opciones { get; set; } = "";
        public bool RequiereVotacion { get; set; } = true;
        public TipoMayoria TipoMayoria { get; set; } = TipoMayoria.Simple;
        public decimal MayoriaPct { get; set; } = 50m;
        public ModalidadVoto ModalidadVoto { get; set; } = ModalidadVoto.Publico;
        public string? Narrativa { get; set; }
    }
    private PuntoEdit? _edit;
    private void EditarPunto(SesionPuntoDto p) => _edit = new PuntoEdit
    {
        Id = p.Id, Titulo = p.Titulo, Descripcion = p.Descripcion, RequiereVotacion = p.RequiereVotacion,
        TipoMayoria = p.TipoMayoria, MayoriaPct = p.MayoriaPct, ModalidadVoto = p.ModalidadVoto, Narrativa = p.NarrativaSecretario,
        Opciones = EsEleccion(p) ? string.Join(", ", p.OpcionesVoto) : ""
    };
    private List<string> OpcionesEdit() => (_edit?.Opciones ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    private async Task GuardarPuntoAsync()
    {
        if (_edit is null) return;
        if (string.IsNullOrWhiteSpace(_edit.Titulo)) { _msg = "El punto necesita un título."; _msgClass = "alert-danger"; return; }
        if (_edit.TipoMayoria == TipoMayoria.Calificada && _edit.MayoriaPct < 70m) _edit.MayoriaPct = 70m;
        var e = _edit;
        var ok = e.Id is Guid id
            ? await EjecutarAsync(h => h.PutAsJsonAsync($"/api/asambleas/puntos/{id}", new ActualizarPuntoRequest(e.Titulo.Trim(), e.Descripcion,
                e.RequiereVotacion, e.TipoMayoria, e.MayoriaPct, e.ModalidadVoto, e.Narrativa, OpcionesEdit())))
            : await EjecutarAsync(h => h.PostAsJsonAsync($"/api/asambleas/{_id}/puntos", new CrearPuntoRequest(0, e.Titulo.Trim(), e.Descripcion,
                e.RequiereVotacion, e.TipoMayoria, e.MayoriaPct, e.ModalidadVoto, null, OpcionesEdit())));
        if (ok) _edit = null;
    }
    private Task QuitarPuntoAsync(Guid puntoId) => EjecutarAsync(h => h.DeleteAsync($"/api/asambleas/puntos/{puntoId}"));

    private RenderFragment PuntoEditor() => @<div class="asm-pedit">
        <div class="row g-2">
            <div class="col-md-8"><label class="form-label small mb-1">Título *</label><input class="form-control form-control-sm" @bind="_edit!.Titulo" @bind:event="oninput" /></div>
            <div class="col-md-4"><label class="form-label small mb-1">Modalidad voto</label>
                <select class="form-select form-select-sm" @bind="_edit!.ModalidadVoto">
                    <option value="@ModalidadVoto.Publico">Publico</option><option value="@ModalidadVoto.Secreto">Secreto</option>
                </select></div>
