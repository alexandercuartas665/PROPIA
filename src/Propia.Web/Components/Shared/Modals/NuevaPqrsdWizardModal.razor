@* Modal "Radicar PQR" alineado al prototipo PROPIA.dc.html:
   un solo formulario (no wizard) con grid 2-cols, campos Tipo+Prioridad / Unidad+Solicitante /
   Asunto / Descripcion. Categoria queda como dropdown adicional porque la spec del modulo 2.9
   la requiere (legal). *@

@using Propia.Application.Pqrsd
@using Propia.Domain.Enums
@inherits ModalBase<bool>
@inject IHttpClientFactory HttpFactory

<div class="npq">
    <div class="npq-head">
        <div class="npq-head-l">
            <span class="npq-icon-bx">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
            </span>
            <div>
                <h2 class="npq-title">Radicar nueva PQR</h2>
                <p class="npq-sub">Completa los datos y queda asignada al solicitante. El plazo legal arranca inmediatamente.</p>
            </div>
        </div>
        <button type="button" class="npq-close" @onclick="Cerrar" aria-label="Cerrar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
    </div>

    <div class="npq-body">
        <div class="npq-grid">
            <div class="npq-field">
                <label class="npq-lbl">Tipo</label>
                <select class="npq-input" @bind="_tipoStr" @bind:after="OnTipoChange">
                    <option value="">- elegir -</option>
                    @foreach (var t in Enum.GetValues<TipoPqrsd>())
                    {
                        <option value="@t">@TipoLabel(t)</option>
                    }
                </select>
                @if (_plazoCalculado.HasValue)
                {
                    <span class="npq-helper">@_plazoCalculado.Value dias habiles - vence aprox. @_fechaVencimiento.ToString("dd MMM")</span>
                }
            </div>

            <div class="npq-field">
                <label class="npq-lbl">Categoria</label>
                <select class="npq-input" @bind="_categoriaIdStr">
                    <option value="">- elegir -</option>
                    @foreach (var c in _categorias.Where(c => c.Activa).OrderBy(c => c.Orden))
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>

            <div class="npq-field">
                <label class="npq-lbl">Unidad / apartamento</label>
                <input class="npq-input" @bind="_unidadTexto" @bind:event="oninput" placeholder="Ej. Apto 802 (opcional)" />
            </div>

            <div class="npq-field">
                <label class="npq-lbl">Solicitante</label>
                <input class="npq-input" @bind="_solicitanteTexto" @bind:event="oninput" placeholder="Nombre de quien solicita (opcional)" />
            </div>

            <div class="npq-field npq-field--full">
                <label class="npq-lbl">Asunto</label>
                <input class="npq-input" @bind="_asunto" @bind:event="oninput" placeholder="Resumen del caso" />
            </div>

            <div class="npq-field npq-field--full">
                <label class="npq-lbl">Descripcion <span class="npq-charcount">@(_descripcion?.Length ?? 0) / 2000</span></label>
                <textarea class="npq-input npq-textarea" rows="5" maxlength="2000" @bind="_descripcion" @bind:event="oninput"
                    placeholder="Detalle de la peticion, queja o reclamo..."></textarea>
            </div>

            <div class="npq-field npq-field--full">
                <label class="npq-check">
                    <input type="checkbox" @bind="_identidadReservada" />
                    <span><strong>Reservar mi identidad.</strong> El admin no vera mi nombre.</span>
                </label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="npq-msg @(_msgError ? "npq-msg--err" : "npq-msg--ok")">@_msg</div>
        }
    </div>

    <div class="npq-foot">
        <button type="button" class="npq-btn-ghost" @onclick="Cerrar" disabled="@_busy">Cancelar</button>
        <button type="button" class="npq-btn-brand" @onclick="Radicar" disabled="@(!PuedeRadicar || _busy)">
            @if (_busy) { <span>Radicando...</span> }
            else
            {
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                <span>Radicar</span>
            }
        </button>
    </div>
</div>

<style>
    .npq { display: flex; flex-direction: column; max-height: 90vh; font-family: var(--propia-font-base, 'Lexend', sans-serif); background: #fff; }
    .npq-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 24px; border-bottom: 1px solid #EEF3F8; }
    .npq-head-l { display: flex; align-items: center; gap: 12px; }
    .npq-icon-bx { width: 38px; height: 38px; border-radius: 10px; background: var(--propia-brand-soft, #F1ECFD); color: var(--propia-brand, #6D4FE3); display: inline-flex; align-items: center; justify-content: center; }
    .npq-title { font-size: 17px; font-weight: 800; color: #1B2A3A; letter-spacing: -0.3px; margin: 0; }
    .npq-sub { font-size: 12.5px; color: #7C98B6; margin: 2px 0 0; }
    .npq-close { width: 34px; height: 34px; border: 0; border-radius: 8px; background: transparent; color: #7C98B6; cursor: pointer; }
    .npq-close:hover { background: #F1F5F9; }

    .npq-body { overflow-y: auto; padding: 20px 24px; }
    .npq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
    .npq-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .npq-field--full { grid-column: 1 / -1; }
    .npq-lbl { font-size: 11px; color: #7C98B6; font-weight: 700; }
    .npq-input {
        width: 100%; border: 1.5px solid #E1E8EE; border-radius: 9px;
        padding: 10px 12px; font-size: 13.5px; color: #33475B;
        font-family: inherit; outline: none; background: #fff;
    }
    .npq-input:focus { border-color: var(--propia-brand, #6D4FE3); }
    .npq-textarea { resize: vertical; min-height: 100px; }
    .npq-helper { font-size: 11px; color: var(--propia-brand, #6D4FE3); font-weight: 600; margin-top: 2px; }
    .npq-charcount { font-size: 10px; font-weight: 600; color: #A6B7C8; float: right; }
    .npq-check { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; background: #FAFBFD; border: 1px solid #EEF3F8; border-radius: 10px; font-size: 12.5px; color: #516F90; cursor: pointer; }
    .npq-check input { margin-top: 2px; }
    .npq-msg { margin-top: 14px; padding: 10px 14px; border-radius: 9px; font-size: 12.5px; font-weight: 600; }
    .npq-msg--ok { background: #E6F6EE; color: #15703F; }
    .npq-msg--err { background: #FEE2E2; color: #B91C1C; }

    .npq-foot { display: flex; align-items: center; justify-content: flex-end; gap: 9px; padding: 14px 24px; border-top: 1px solid #EEF3F8; background: #FAFBFD; }
    .npq-btn-ghost { padding: 9px 16px; border-radius: 9px; border: 1px solid #E1E8EE; background: #fff; font-size: 13px; font-weight: 600; color: #516F90; cursor: pointer; font-family: inherit; }
    .npq-btn-ghost:hover { border-color: var(--propia-brand, #6D4FE3); color: var(--propia-brand, #6D4FE3); }
    .npq-btn-brand {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 9px 18px; border-radius: 9px; border: 0;
        background: var(--propia-brand, #6D4FE3); color: #fff;
        font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
        box-shadow: 0 4px 12px rgba(109,79,227,.25);
    }
    .npq-btn-brand:hover { background: var(--propia-brand-hover, #5838C9); }
    .npq-btn-brand:disabled { opacity: .55; cursor: not-allowed; box-shadow: none; }
</style>

@code {
    [Parameter] public string? Jwt { get; set; }

    private string _tipoStr = "";
    private string _categoriaIdStr = "";
    private string _unidadTexto = "";
    private string _solicitanteTexto = "";
    private string _asunto = "";
    private string _descripcion = "";
    private bool _identidadReservada = false;
    private bool _busy;
    private string? _msg;
    private bool _msgError;
    private int? _plazoCalculado;
    private DateTime _fechaVencimiento;
    private List<PqrsdCategoriaDto> _categorias = new();
    private List<PqrsdPlazoDto> _plazos = new();

    private bool PuedeRadicar =>
        !string.IsNullOrEmpty(_tipoStr) &&
        !string.IsNullOrEmpty(_categoriaIdStr) &&
        !string.IsNullOrWhiteSpace(_descripcion) &&
        _descripcion.Length >= 10;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = Auth();
            _categorias = (await http.GetFromJsonAsync<List<PqrsdCategoriaDto>>("/api/pqrsd/categorias")) ?? new();
            _plazos = (await http.GetFromJsonAsync<List<PqrsdPlazoDto>>("/api/pqrsd/plazos")) ?? new();
        }
        catch (Exception ex) { _msg = "No se pudo cargar el catalogo: " + ex.Message; _msgError = true; }
    }

    private void OnTipoChange()
    {
        if (Enum.TryParse<TipoPqrsd>(_tipoStr, out var t))
        {
            var p = _plazos.FirstOrDefault(p => p.Tipo == t);
            _plazoCalculado = p?.DiasHabiles ?? PlazoDefault(t);
            _fechaVencimiento = DateTime.Today.AddDays((int)Math.Ceiling(_plazoCalculado.Value * 1.4));
        }
        else
        {
            _plazoCalculado = null;
        }
    }

    private async Task Radicar()
    {
        if (!PuedeRadicar) return;
        _busy = true;
        try
        {
            var tipo = Enum.Parse<TipoPqrsd>(_tipoStr);
            var catId = Guid.Parse(_categoriaIdStr);
            // Compone descripcion enriquecida: asunto + unidad/solicitante + texto libre
            // (sin tocar el schema del backend; cuando el backend acepte asignacion explicita los campos
            // pasaran directos).
            var sb = new System.Text.StringBuilder();
            if (!string.IsNullOrWhiteSpace(_asunto)) sb.AppendLine("Asunto: " + _asunto.Trim()).AppendLine();
            if (!string.IsNullOrWhiteSpace(_unidadTexto)) sb.AppendLine("Unidad: " + _unidadTexto.Trim());
            if (!string.IsNullOrWhiteSpace(_solicitanteTexto)) sb.AppendLine("Solicitante: " + _solicitanteTexto.Trim());
            if (sb.Length > 0) sb.AppendLine();
            sb.Append(_descripcion.Trim());

            var req = new RadicarPqrsdRequest(tipo, catId, sb.ToString(), _identidadReservada, null);
            var resp = await Auth().PostAsJsonAsync("/api/pqrsd", req);
            if (resp.IsSuccessStatusCode)
            {
                Close(true);
            }
            else
            {
                _msg = "No se pudo radicar: " + await resp.Content.ReadAsStringAsync();
                _msgError = true;
            }
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
        _busy = false;
    }

    private void Cerrar() => Cancel();

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private static string TipoLabel(TipoPqrsd t) => t switch
    {
        TipoPqrsd.Peticion => "Peticion",
        TipoPqrsd.SolicitudDocumentos => "Solicitud de documentos",
        TipoPqrsd.Consulta => "Consulta",
        TipoPqrsd.Queja => "Queja",
        TipoPqrsd.Reclamo => "Reclamo",
        TipoPqrsd.Sugerencia => "Sugerencia",
        TipoPqrsd.Denuncia => "Denuncia",
        TipoPqrsd.Felicitacion => "Felicitacion",
        _ => t.ToString()
    };

    private static int PlazoDefault(TipoPqrsd t) => t switch
    {
        TipoPqrsd.SolicitudDocumentos => 10,
        TipoPqrsd.Consulta => 30,
        TipoPqrsd.Felicitacion => 5,
        _ => 15
    };
}
