@* Modal "Radicar PQR" (Fase 2 del overhaul): mas grande, con selector de persona del directorio
   (crear al vuelo), selector de propiedad, plazo editable por tipo, adjuntos reales y campos dinamicos. *@

@using Propia.Application.Pqrsd
@using Propia.Application.MiCopropiedad
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inherits ModalBase<bool>
@inject IHttpClientFactory HttpFactory

<div class="npq">
    <div class="npq-head">
        <div class="npq-head-l">
            <span class="npq-icon-bx">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
            </span>
            <div>
                <h2 class="npq-title">Radicar nueva PQR</h2>
                <p class="npq-sub">Completa los datos y queda asignada al solicitante. El plazo legal arranca inmediatamente.</p>
            </div>
        </div>
        <button type="button" class="npq-close" @onclick="Cerrar" aria-label="Cerrar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
    </div>

    <div class="npq-body">
        @if (_radicadoNumero is not null)
        {
            <div class="npq-done">
                <div class="npq-done-ico">&#10003;</div>
                <h3 class="npq-done-title">PQR radicada con exito</h3>
                <p class="npq-done-txt">Se creo el radicado con el numero:</p>
                <div class="npq-done-num">@_radicadoNumero</div>
                <p class="npq-done-hint">Guarda este numero para hacer seguimiento del caso.</p>
            </div>
        }
        else
        {
        <div class="npq-grid">
            <div class="npq-field">
                <label class="npq-lbl">Tipo de PQR</label>
                <select class="npq-input" @bind="_tipoIdSel" @bind:after="OnTipoChange">
                    <option value="">- elegir -</option>
                    @foreach (var t in _tipos)
                    {
                        <option value="@t.Id">@t.Nombre (@t.DiasHabiles d)</option>
                    }
                </select>
                @if (_plazoCalculado.HasValue)
                {
                    <span class="npq-helper">Vence aprox. @_fechaVencimiento.ToString("dd MMM") (@_plazoCalculado.Value dias habiles)</span>
                }
            </div>

            <div class="npq-field">
                <label class="npq-lbl">Tiempo de respuesta (dias habiles) <span class="npq-tag-edit">segun el tipo</span></label>
                <input class="npq-input" type="number" value="@_plazoEditable" readonly disabled />
                <span class="npq-helper-muted">El plazo lo define el tipo. Los tipos y categorias se administran en "Configurar PQRSD".</span>
            </div>

            <div class="npq-field">
                <label class="npq-lbl">Categoria</label>
                <select class="npq-input" @bind="_categoriaIdStr">
                    <option value="">- elegir -</option>
                    @foreach (var c in _categorias.Where(c => c.Activa).OrderBy(c => c.Orden))
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>

            <div class="npq-field">
                <label class="npq-lbl">Propiedad relacionada</label>
                <SelectorUnidadCascada Unidades="_unidades" UnidadId="_unidadSel"
                                       UnidadIdChanged="@(v => _unidadSel = v)"
                                       Class="npq-input" MostrarLabels="false" />
            </div>

            <div class="npq-field">
                <label class="npq-lbl">Solicitante (persona del directorio)</label>
                <SelectorPersona Jwt="@Jwt" @bind-Seleccionada="_personaSel"
                                 Placeholder="Buscar por nombre o documento (o crear nueva)..." />
                <span class="npq-helper-muted">Si no la encuentras, puedes crearla desde el buscador. Si lo dejas vacio, el radicador seras tu.</span>
            </div>

            <div class="npq-field npq-field--full">
                <label class="npq-lbl">Asunto</label>
                <input class="npq-input" @bind="_asunto" @bind:event="oninput" placeholder="Resumen del caso" />
            </div>

            <div class="npq-field npq-field--full">
                <label class="npq-lbl">Descripcion <span class="npq-charcount">@(_descripcion?.Length ?? 0) / 2000</span></label>
                <textarea class="npq-input npq-textarea" rows="5" maxlength="2000" @bind="_descripcion" @bind:event="oninput"
                    placeholder="Detalle de la peticion, queja o reclamo..."></textarea>
            </div>

            @* Campos dinamicos del tablero *@
            @foreach (var c in _campos.OrderBy(c => c.Orden))
            {
                <div class="npq-field @(c.Columna == 2 ? "npq-field--full" : "")">
                    <label class="npq-lbl">@c.Label @if (c.Requerido) { <span class="npq-req">*</span> }</label>
                    @RenderCampo(c)
                    @if (!string.IsNullOrWhiteSpace(c.Descripcion)) { <span class="npq-helper-muted">@c.Descripcion</span> }
                </div>
            }

            @* Adjuntos *@
            <div class="npq-field npq-field--full">
                <label class="npq-lbl">Adjuntos (documentos o imagenes)</label>
                <label class="npq-drop">
                    <InputFile OnChange="OnArchivos" multiple class="npq-drop-input" />
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                    <span class="npq-drop-main">Arrastra aqui tus archivos</span>
                    <span class="npq-drop-hint">o haz clic para seleccionarlos &middot; hasta 50 MB c/u</span>
                </label>
                @if (_archivos.Count > 0)
                {
                    <div class="npq-files">
                        @foreach (var f in _archivos)
                        {
                            <span class="npq-file-chip">@f.Name <button type="button" @onclick="() => QuitarArchivo(f)">&times;</button></span>
                        }
                    </div>
                }
            </div>

            <div class="npq-field npq-field--full">
                <label class="npq-check">
                    <input type="checkbox" @bind="_identidadReservada" disabled="@(!EsDenuncia)" />
                    <span><strong>Reservar identidad.</strong> Solo aplica a Denuncias (Ley 675 Art. 58).</span>
                </label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="npq-msg @(_msgError ? "npq-msg--err" : "npq-msg--ok")">@_msg</div>
        }
        }
    </div>

    <div class="npq-foot">
        @if (_radicadoNumero is not null)
        {
            <button type="button" class="npq-btn-brand" @onclick="() => Close(true)">Listo</button>
        }
        else
        {
            <button type="button" class="npq-btn-ghost" @onclick="Cerrar" disabled="@_busy">Cancelar</button>
            <button type="button" class="npq-btn-brand" @onclick="Radicar" disabled="@(!PuedeRadicar || _busy)">
                @if (_busy) { <span>@_busyMsg</span> }
                else
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                    <span>Radicar</span>
                }
            </button>
        }
    </div>
</div>

<style>
    .npq { display: flex; flex-direction: column; max-height: 92vh; font-family: var(--propia-font-base, 'Lexend', sans-serif); background: #fff; }
    .npq-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 26px; border-bottom: 1px solid #EEF3F8; }
    .npq-head-l { display: flex; align-items: center; gap: 12px; }
    .npq-icon-bx { width: 38px; height: 38px; border-radius: 10px; background: var(--propia-brand-soft, #F1ECFD); color: var(--propia-brand, #6D4FE3); display: inline-flex; align-items: center; justify-content: center; }
    .npq-title { font-size: 17px; font-weight: 800; color: #1B2A3A; letter-spacing: -0.3px; margin: 0; }
    .npq-sub { font-size: 12.5px; color: #7C98B6; margin: 2px 0 0; }
    .npq-close { width: 34px; height: 34px; border: 0; border-radius: 8px; background: transparent; color: #7C98B6; cursor: pointer; }
    .npq-close:hover { background: #F1F5F9; }

    .npq-body { overflow-y: auto; padding: 22px 26px; }
    .npq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .npq-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .npq-field--full { grid-column: 1 / -1; }
    .npq-lbl { font-size: 11px; color: #7C98B6; font-weight: 700; display: flex; align-items: center; gap: 6px; }
    .npq-req { color: #DC2626; }
    .npq-tag-edit { font-size: 9.5px; font-weight: 700; color: var(--propia-brand, #6D4FE3); background: #F1ECFD; padding: 1px 6px; border-radius: 20px; }
    .npq-tipo-new { margin-left: auto; border: 0; background: transparent; color: var(--propia-brand, #6D4FE3); font-size: 10.5px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .npq-tipo-new:hover { text-decoration: underline; }
    .npq-newtipo { background: #FAFBFD; border: 1px dashed #D3DEE9; border-radius: 10px; padding: 12px; }
    .npq-newtipo-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .npq-newtipo-row .npq-input { flex: 1; min-width: 110px; margin-bottom: 0; }
    .npq-newtipo-row .npq-btn-brand { white-space: nowrap; }
    .npq-input {
        width: 100%; border: 1.5px solid #E1E8EE; border-radius: 9px;
        padding: 10px 12px; font-size: 13.5px; color: #33475B;
        font-family: inherit; outline: none; background: #fff;
    }
    .npq-input:focus { border-color: var(--propia-brand, #6D4FE3); }
    .npq-input:disabled { background: #F6F8FB; color: #9FB2C4; }
    .npq-textarea { resize: vertical; min-height: 100px; }
    .npq-helper { font-size: 11px; color: var(--propia-brand, #6D4FE3); font-weight: 600; margin-top: 2px; }
    .npq-helper-muted { font-size: 10.5px; color: #9FB2C4; margin-top: 1px; }
    .npq-charcount { font-size: 10px; font-weight: 600; color: #A6B7C8; margin-left: auto; }
    .npq-check { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; background: #FAFBFD; border: 1px solid #EEF3F8; border-radius: 10px; font-size: 12.5px; color: #516F90; cursor: pointer; }
    .npq-check input { margin-top: 2px; }

    .npq-drop { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 30px 18px; min-height: 140px; border: 2px dashed #D3DEE9; border-radius: 12px; color: #7C98B6; cursor: pointer; background: #FAFBFD; text-align: center; transition: border-color .15s, background .15s, color .15s; }
    .npq-drop:hover { border-color: var(--propia-brand, #6D4FE3); color: var(--propia-brand, #6D4FE3); background: #F6F3FE; }
    .npq-drop svg { width: 32px; height: 32px; opacity: .85; }
    .npq-drop-main { font-size: 13.5px; font-weight: 700; }
    .npq-drop-hint { font-size: 11.5px; color: #9FB2C4; }
    /* El input real cubre toda la caja (transparente) para que el drag-and-drop funcione sobre el area completa. */
    .npq-drop-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .npq-files { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .npq-file-chip { display: inline-flex; align-items: center; gap: 6px; background: #EEF3F8; border-radius: 20px; padding: 4px 6px 4px 11px; font-size: 11.5px; color: #33475B; }
    .npq-file-chip button { border: 0; background: #D3DEE9; color: #516F90; width: 16px; height: 16px; border-radius: 50%; cursor: pointer; line-height: 1; }

    .npq-done { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 26px 20px 10px; }
    .npq-done-ico { width: 62px; height: 62px; border-radius: 50%; background: #E6F6EE; color: #15954F; font-size: 34px; line-height: 62px; margin-bottom: 12px; }
    .npq-done-title { font-size: 18px; font-weight: 800; color: #1B2A3A; margin: 0 0 4px; }
    .npq-done-txt { font-size: 13px; color: #7C98B6; margin: 0 0 10px; }
    .npq-done-num { display: inline-block; background: #F1ECFD; border: 1px dashed #C4B5F3; color: var(--propia-brand, #6D4FE3); font-weight: 800; font-size: 1.25rem; letter-spacing: .5px; padding: 9px 22px; border-radius: 10px; }
    .npq-done-hint { font-size: 11.5px; color: #9FB2C4; margin: 12px 0 0; }

    .npq-msg { margin-top: 14px; padding: 10px 14px; border-radius: 9px; font-size: 12.5px; font-weight: 600; }
    .npq-msg--ok { background: #E6F6EE; color: #15703F; }
    .npq-msg--err { background: #FEE2E2; color: #B91C1C; }

    .npq-foot { display: flex; align-items: center; justify-content: flex-end; gap: 9px; padding: 14px 26px; border-top: 1px solid #EEF3F8; background: #FAFBFD; }
    .npq-btn-ghost { padding: 9px 16px; border-radius: 9px; border: 1px solid #E1E8EE; background: #fff; font-size: 13px; font-weight: 600; color: #516F90; cursor: pointer; font-family: inherit; }
    .npq-btn-ghost:hover { border-color: var(--propia-brand, #6D4FE3); color: var(--propia-brand, #6D4FE3); }
    .npq-btn-brand {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 9px 18px; border-radius: 9px; border: 0;
        background: var(--propia-brand, #6D4FE3); color: #fff;
        font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
        box-shadow: 0 4px 12px rgba(109,79,227,.25);
    }
    .npq-btn-brand:hover { background: var(--propia-brand-hover, #5838C9); }
    .npq-btn-brand:disabled { opacity: .55; cursor: not-allowed; box-shadow: none; }

    /* Movil (hasta 640px): full-height, form en 1 columna y body con scroll. */
    @@media (max-width: 640px) {
        .npq { max-height: 100vh; }
        .npq-head { padding: 12px 14px; gap: 10px; }
        .npq-head-l { min-width: 0; }
        .npq-title { font-size: 16px; }
        .npq-body { padding: 18px 14px; flex: 1; min-height: 0; }
        .npq-grid { grid-template-columns: 1fr; }
        .npq-foot { padding: 12px 14px; }
        .npq-newtipo-row { flex-direction: column; align-items: stretch; }
    }
</style>

@code {
    [Parameter] public string? Jwt { get; set; }

    private string _tipoIdSel = "";
    private List<PqrsdTipoDto> _tipos = new();
    private string _categoriaIdStr = "";
    private string _unidadIdStr = "";
    private Guid? _unidadSel
    {
        get => Guid.TryParse(_unidadIdStr, out var g) && g != Guid.Empty ? g : (Guid?)null;
        set => _unidadIdStr = value?.ToString() ?? "";
    }
    private PersonaCandidatoDto? _personaSel;
    private string _asunto = "";
    private string _descripcion = "";
    private bool _identidadReservada = false;
    private bool _busy;
    private string _busyMsg = "Radicando...";
    private string? _msg;
    private bool _msgError;
    private string? _radicadoNumero;
    private int? _plazoCalculado;
    private int _plazoEditable = 15;
    private DateTime _fechaVencimiento;
    private List<PqrsdCategoriaDto> _categorias = new();
    private List<PqrsdPlazoDto> _plazos = new();
    private List<UnidadDto> _unidades = new();
    private List<PqrsdCampoDto> _campos = new();
    private readonly Dictionary<Guid, string> _campoValores = new();
    private readonly List<IBrowserFile> _archivos = new();

    private PqrsdTipoDto? TipoSel() => Guid.TryParse(_tipoIdSel, out var id) ? _tipos.FirstOrDefault(t => t.Id == id) : null;
    private bool EsDenuncia => TipoSel()?.Legal == TipoPqrsd.Denuncia;

    private bool PuedeRadicar =>
        !string.IsNullOrEmpty(_tipoIdSel) &&
        !string.IsNullOrEmpty(_categoriaIdStr) &&
        !string.IsNullOrWhiteSpace(_descripcion) &&
        _descripcion.Length >= 10;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = Auth();
            _categorias = (await http.GetFromJsonAsync<List<PqrsdCategoriaDto>>("/api/pqrsd/categorias")) ?? new();
            _tipos = (await http.GetFromJsonAsync<List<PqrsdTipoDto>>("/api/pqrsd/tipos")) ?? new();
            _campos = (await http.GetFromJsonAsync<List<PqrsdCampoDto>>("/api/pqrsd/campos")) ?? new();
            _unidades = (await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades")) ?? new();
            foreach (var c in _campos.Where(c => !string.IsNullOrEmpty(c.ValorPorDefecto)))
                _campoValores[c.Id] = c.ValorPorDefecto!;
        }
        catch (Exception ex) { _msg = "No se pudo cargar el catalogo: " + ex.Message; _msgError = true; }
    }

    private void OnTipoChange()
    {
        var t = TipoSel();
        if (t is not null)
        {
            _plazoEditable = t.DiasHabiles;
            _plazoCalculado = _plazoEditable;
            RecalcularVencimiento();
            if (t.Legal != TipoPqrsd.Denuncia) _identidadReservada = false;
        }
        else { _plazoCalculado = null; }
    }

    private void RecalcularVencimiento()
    {
        if (_plazoEditable < 1) _plazoEditable = 1;
        _plazoCalculado = _plazoEditable;
        _fechaVencimiento = DateTime.Today.AddDays((int)Math.Ceiling(_plazoEditable * 1.4));
    }

    private RenderFragment RenderCampo(PqrsdCampoDto c) => builder =>
    {
        var val = _campoValores.GetValueOrDefault(c.Id, "");
        switch (c.Tipo)
        {
            case TipoCampoTablero.AreaTexto:
                builder.OpenElement(0, "textarea");
                builder.AddAttribute(1, "class", "npq-input npq-textarea");
                builder.AddAttribute(2, "rows", "2");
                builder.AddAttribute(3, "value", val);
                builder.AddAttribute(4, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetCampo(c.Id, e.Value?.ToString())));
                builder.CloseElement();
                break;
            case TipoCampoTablero.Booleano:
                builder.OpenElement(10, "label");
                builder.AddAttribute(11, "class", "npq-check");
                builder.OpenElement(12, "input");
                builder.AddAttribute(13, "type", "checkbox");
                builder.AddAttribute(14, "checked", val == "true");
                builder.AddAttribute(15, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetCampo(c.Id, (e.Value is true) ? "true" : "false")));
                builder.CloseElement();
                builder.OpenElement(16, "span");
                builder.AddContent(17, "Si");
                builder.CloseElement();
                builder.CloseElement();
                break;
            case TipoCampoTablero.Seleccion:
                builder.OpenElement(20, "select");
                builder.AddAttribute(21, "class", "npq-input");
                builder.AddAttribute(22, "value", val);
                builder.AddAttribute(23, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetCampo(c.Id, e.Value?.ToString())));
                builder.OpenElement(24, "option"); builder.AddAttribute(25, "value", ""); builder.AddContent(26, "- elegir -"); builder.CloseElement();
                foreach (var op in (c.Opciones ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    builder.OpenElement(27, "option"); builder.AddAttribute(28, "value", op); builder.AddContent(29, op); builder.CloseElement();
                }
                builder.CloseElement();
                break;
            default:
                builder.OpenElement(30, "input");
                builder.AddAttribute(31, "class", "npq-input");
                builder.AddAttribute(32, "type", c.Tipo switch { TipoCampoTablero.Numero or TipoCampoTablero.Moneda => "number", TipoCampoTablero.Fecha => "date", TipoCampoTablero.Hora => "time", TipoCampoTablero.Email => "email", TipoCampoTablero.Url => "url", TipoCampoTablero.Telefono => "tel", _ => "text" });
                builder.AddAttribute(33, "value", val);
                builder.AddAttribute(34, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetCampo(c.Id, e.Value?.ToString())));
                builder.CloseElement();
                break;
        }
    };

    private void SetCampo(Guid id, string? valor) => _campoValores[id] = valor ?? "";

    private void OnArchivos(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(20))
            if (_archivos.All(a => a.Name != f.Name)) _archivos.Add(f);
    }
    private void QuitarArchivo(IBrowserFile f) => _archivos.Remove(f);

    private async Task Radicar()
    {
        if (!PuedeRadicar) return;
        _busy = true; _busyMsg = "Radicando..."; _msg = null;
        try
        {
            var tipoSel = TipoSel();
            if (tipoSel is null) { _msg = "Elige un tipo de PQR."; _msgError = true; _busy = false; return; }
            var catId = Guid.Parse(_categoriaIdStr);

            var desc = string.IsNullOrWhiteSpace(_asunto)
                ? _descripcion.Trim()
                : $"Asunto: {_asunto.Trim()}\n\n{_descripcion.Trim()}";

            Guid? unidadId = Guid.TryParse(_unidadIdStr, out var uid) ? uid : null;
            Guid? radId = _personaSel?.PersonaId;
            var campos = _campoValores.Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
                .Select(kv => new PqrsdCampoValorDto(kv.Key, kv.Value)).ToList();

            var req = new RadicarPqrsdRequest(tipoSel.Legal, catId, desc, _identidadReservada, null, unidadId, radId, campos, tipoSel.Id);
            var resp = await Auth().PostAsJsonAsync("/api/pqrsd", req);
            if (!resp.IsSuccessStatusCode)
            {
                _msg = "No se pudo radicar: " + await resp.Content.ReadAsStringAsync();
                _msgError = true; _busy = false; return;
            }

            var creado = await resp.Content.ReadFromJsonAsync<PqrsdExpedienteDetalleDto>();
            if (creado is not null && _archivos.Count > 0)
            {
                _busyMsg = "Subiendo adjuntos...";
                StateHasChanged();
                foreach (var f in _archivos)
                {
                    try
                    {
                        using var content = new MultipartFormDataContent();
                        var stream = f.OpenReadStream(52_428_800); // 50 MB
                        var sc = new StreamContent(stream);
                        sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType);
                        content.Add(sc, "file", f.Name);
                        await Auth().PostAsync($"/api/pqrsd/{creado.Id}/adjuntos/upload", content);
                    }
                    catch { /* continuar con el resto */ }
                }
            }
            // Terminar informando el numero de radicado (el usuario cierra con "Listo", que refresca el tablero).
            _radicadoNumero = creado?.NumeroRadicado ?? "(sin numero)";
            _busy = false;
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; _busy = false; }
    }

    private void Cerrar() => Cancel();

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private static string TipoLabel(TipoPqrsd t) => t switch
    {
        TipoPqrsd.Peticion => "Peticion",
        TipoPqrsd.SolicitudDocumentos => "Solicitud de documentos",
        TipoPqrsd.Consulta => "Consulta",
        TipoPqrsd.Queja => "Queja",
        TipoPqrsd.Reclamo => "Reclamo",
        TipoPqrsd.Sugerencia => "Sugerencia",
        TipoPqrsd.Denuncia => "Denuncia",
        TipoPqrsd.Felicitacion => "Felicitacion",
        _ => t.ToString()
    };

    private static int PlazoDefault(TipoPqrsd t) => t switch
    {
        TipoPqrsd.SolicitudDocumentos => 10,
        TipoPqrsd.Consulta => 30,
        TipoPqrsd.Felicitacion => 5,
        _ => 15
    };
}
