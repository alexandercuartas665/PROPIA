@* ProgramadorTareaModal - componente global reutilizable.
   Captura la programacion de una tarea recurrente: a que TABLERO va, con que PERIODICIDAD
   se dispara, en que FECHA de ejecucion y a que USUARIOS afecta. Devuelve un
   CrearProgramacionRequest (o null si se cancela); el caller lo persiste en /api/programaciones.
   Llamable desde cualquier escenario (vencimiento de contrato, mantenimiento, etc.). *@

@inherits ModalBase<Propia.Application.Programaciones.CrearProgramacionRequest>
@using Propia.Application.Programaciones
@using Propia.Domain.Enums

<div class="ptm-header">
    <div class="ptm-header-ic">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h18v18H3zM3 10h18M8 2v4M16 2v4"/><path d="M12 14v3M10.5 15.5h3" stroke-width="1.6"/></svg>
    </div>
    <div class="ptm-header-tx">
        <div class="ptm-title">@(Existente is null ? "Programar tarea" : "Editar programacion")</div>
        <div class="ptm-sub">Se crea automaticamente en el panel de Tareas segun la periodicidad.</div>
    </div>
    <button class="ptm-close" @onclick="Cancel" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

<div class="ptm-body">
    <div class="ptm-field">
        <label class="ptm-lbl">Titulo de la tarea <span class="ptm-req">*</span></label>
        <input class="ptm-input" @bind="_titulo" @bind:event="oninput" placeholder="Ej. Renovar contrato de vigilancia" />
    </div>
    <div class="ptm-field">
        <label class="ptm-lbl">Descripcion</label>
        <textarea class="ptm-input ptm-ta" rows="2" @bind="_descripcion" placeholder="Detalle / alcance de la tarea"></textarea>
    </div>

    <div class="ptm-row">
        <div class="ptm-field ptm-grow">
            <label class="ptm-lbl">Tablero de destino</label>
            <select class="ptm-input" @bind="_tableroId">
                <option value="">- Tablero General -</option>
                @foreach (var t in Tableros) { <option value="@t.Id">@t.Nombre</option> }
            </select>
        </div>
        <div class="ptm-field ptm-w160">
            <label class="ptm-lbl">Prioridad</label>
            <select class="ptm-input" @bind="_prioridad">
                <option value="@PrioridadTarea.Urgente">Urgente</option>
                <option value="@PrioridadTarea.Alta">Alta</option>
                <option value="@PrioridadTarea.Normal">Normal</option>
                <option value="@PrioridadTarea.Baja">Baja</option>
            </select>
        </div>
    </div>

    @* Dos formas de programar: la simple de siempre, o cron para horarios finos. *@
    <div class="ptm-field">
        <label class="ptm-lbl">Regla de disparo</label>
        <div class="ptm-tipos">
            <button type="button" class="ptm-tipo @(_tipo == TipoProgramacion.Periodicidad ? "on" : "")"
                    @onclick="() => _tipo = TipoProgramacion.Periodicidad">Periodicidad</button>
            <button type="button" class="ptm-tipo @(_tipo == TipoProgramacion.Cron ? "on" : "")"
                    @onclick="ActivarCron">Cron (avanzado)</button>
        </div>
    </div>

    @if (_tipo == TipoProgramacion.Periodicidad)
    {
        <div class="ptm-field">
            <label class="ptm-lbl">Periodicidad</label>
            <div class="ptm-chips">
                @foreach (var p in _periodos)
                {
                    var pp = p;
                    <button type="button" class="ptm-chip @(_periodicidad == pp ? "on" : "")" @onclick="() => _periodicidad = pp">@PeriodicidadLabel(pp)</button>
                }
            </div>
        </div>

        <div class="ptm-row">
            <div class="ptm-field ptm-grow">
                <label class="ptm-lbl">@(_periodicidad == PeriodicidadProgramacion.Unica ? "Fecha de ejecucion" : "Primera ejecucion") <span class="ptm-req">*</span></label>
                <input class="ptm-input" type="date" @bind="_fecha" />
            </div>
            @if (_periodicidad != PeriodicidadProgramacion.Unica)
            {
                <div class="ptm-field ptm-grow">
                    <label class="ptm-lbl">Hasta (opcional)</label>
                    <input class="ptm-input" type="date" @bind="_fechaFin" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="ptm-field">
            <label class="ptm-lbl">Expresion cron <span class="ptm-req">*</span></label>
            @* Sin value= a proposito: en Blazor Server reafirmar value en cada re-render
               se come pulsaciones mientras se escribe. *@
            @* value= solo mientras nadie ha escrito: al editar hay que mostrar el cron guardado,
               pero reafirmarlo en cada re-render se come pulsaciones en Blazor Server. *@
            @if (_cronTocado)
            {
                <input class="ptm-input ptm-cron" placeholder="minuto hora dia-del-mes mes dia-de-semana"
                       @oninput="OnCronInput" />
            }
            else
            {
                <input class="ptm-input ptm-cron" placeholder="minuto hora dia-del-mes mes dia-de-semana"
                       value="@_cron" @oninput="OnCronInput" />
            }
            <div class="ptm-cron-presets">
                @foreach (var p in _presets)
                {
                    var pp = p;
                    <button type="button" class="ptm-preset" @onclick="() => AplicarPreset(pp.Expr)">@pp.Label</button>
                }
            </div>
        </div>

        <div class="ptm-field">
            <label class="ptm-lbl">Hasta (opcional)</label>
            <input class="ptm-input" type="date" @bind="_fechaFin" />
        </div>

        @* Previsualizacion: el usuario no deberia tener que adivinar que hace "0 8 * * 1". *@
        @if (_cronPreview is not null)
        {
            <div class="ptm-cron-box @(_cronPreview.Valida ? "ok" : "bad")">
                @if (!_cronPreview.Valida)
                {
                    <div class="ptm-cron-err">@_cronPreview.Error</div>
                }
                else
                {
                    <div class="ptm-cron-t">Proximas ejecuciones (@_zonaHoraria)</div>
                    <ul class="ptm-cron-list">
                        @foreach (var f in _cronPreview.Proximas)
                        {
                            <li>@FechaLocal(f)</li>
                        }
                    </ul>
                }
            </div>
        }
    }

    <div class="ptm-field">
        <label class="ptm-lbl">Usuarios afectados (responsables)</label>
        @if (Personas.Count == 0)
        {
            <div class="ptm-empty">No hay usuarios disponibles; la tarea quedara sin responsable (se puede asignar luego en el tablero).</div>
        }
        else
        {
            <input class="ptm-input ptm-mb" placeholder="Filtrar usuarios..." value="@_filtro" @oninput="(e) => _filtro = e.Value?.ToString() ?? string.Empty" />
            <div class="ptm-personas">
                @foreach (var per in PersonasFiltradas())
                {
                    var pid = per.Id;
                    <label class="ptm-persona @(_responsables.Contains(pid) ? "on" : "")">
                        <input type="checkbox" checked="@_responsables.Contains(pid)" @onchange="() => ToggleResponsable(pid)" />
                        <span>@per.Nombre</span>
                    </label>
                }
            </div>
        }
    </div>

    @* Cuando se MATERIALIZAN las tareas, que es distinto de cada cuanto se repiten. Con
       "al llegar la fecha" el tablero solo muestra la proxima; con un horizonte se adelantan
       todas las del periodo y el calendario queda completo desde ya. *@
    @if (_periodicidad != PeriodicidadProgramacion.Unica || _tipo == TipoProgramacion.Cron)
    {
        <div class="ptm-field">
            <label class="ptm-lbl">Cuando se crean las tareas</label>
            <div class="ptm-chips">
                @foreach (var h in Horizontes)
                {
                    <button type="button" class="ptm-chip @(_horizonteDias == h.Dias ? "on" : "")"
                            @onclick="() => _horizonteDias = h.Dias">@h.Label</button>
                }
            </div>
            <div class="ptm-hint">
                @if (_horizonteDias == 0)
                {
                    <text>Cada tarea aparece el dia que toca. En el calendario solo se ve la proxima.</text>
                }
                else
                {
                    <text>Se adelantan todas las ocurrencias de los proximos @_horizonteDias dias, para verlas en el calendario y repartirlas con tiempo.</text>
                }
            </div>
        </div>
    }

    @* El correo sale al generarse la tarea, a los responsables marcados arriba que tengan
       email en el Directorio. Por eso el aviso cuando no hay ninguno seleccionado. *@
    <div class="ptm-field">
        <label class="ptm-check">
            <input type="checkbox" checked="@_notificarCorreo" @onchange="() => _notificarCorreo = !_notificarCorreo" />
            <span>Enviar correo a los responsables al generarse la tarea</span>
        </label>
        @if (_notificarCorreo && _responsables.Count == 0)
        {
            <div class="ptm-warn">Selecciona al menos un responsable: el correo va a la direccion registrada de esos usuarios.</div>
        }
    </div>

    <div class="ptm-callout">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ptm-callout-ic"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <div class="ptm-callout-tx">
            @if (_tipo == TipoProgramacion.Cron)
            {
                <text>Se creara una tarea <b>cada vez que corra el cron</b>@(_fechaFin.HasValue ? ", hasta el tope indicado." : ".")</text>
            }
            else if (_periodicidad == PeriodicidadProgramacion.Unica)
            {
                <text>Se creara <b>una tarea</b> en la fecha indicada.</text>
            }
            else
            {
                <text>Se creara una tarea <b>@(PeriodicidadLabel(_periodicidad).ToLower())</b> desde la fecha indicada@(_fechaFin.HasValue ? " hasta el tope." : ".")</text>
                @if (_horizonteDias > 0)
                {
                    <text> Las de los proximos <b>@HorizonteLabel()</b> se crean de una vez.</text>
                }
            }
        </div>
    </div>
</div>

<div class="ptm-footer">
    <button type="button" class="ptm-btn ptm-ghost" @onclick="Cancel">Cancelar</button>
    <button type="button" class="ptm-btn ptm-brand" @onclick="Confirmar" disabled="@(!IsValid)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
        @(Existente is null ? "Programar" : "Guardar cambios")
    </button>
</div>

@code {
    [Parameter] public List<TableroOpcion> Tableros { get; set; } = new();
    [Parameter] public List<PersonaOpcion> Personas { get; set; } = new();
    [Parameter] public string? PrefillTitulo { get; set; }
    [Parameter] public string? PrefillDescripcion { get; set; }
    [Parameter] public DateOnly? PrefillFecha { get; set; }
    [Parameter] public Guid? PrefillTableroId { get; set; }
    [Parameter] public PeriodicidadProgramacion PrefillPeriodicidad { get; set; } = PeriodicidadProgramacion.Unica;
    [Parameter] public string? ModuloOrigenCodigo { get; set; }
    [Parameter] public Guid? EntidadOrigenId { get; set; }
    [Parameter] public string? OrigenReferencia { get; set; }

    /// <summary>Regla que se esta editando. Null = alta. Solo cambia el prefill y el rotulo del boton;
    /// el modal devuelve siempre el mismo request y es el panel quien decide POST o PUT.</summary>
    [Parameter] public ProgramacionTareaDto? Existente { get; set; }

    private string _titulo = "";
    private string? _descripcion;
    private string _tableroId = "";
    private PrioridadTarea _prioridad = PrioridadTarea.Normal;
    private PeriodicidadProgramacion _periodicidad = PeriodicidadProgramacion.Unica;
    private DateTime? _fecha = DateTime.Today;
    private DateTime? _fechaFin;
    private string _filtro = "";
    private readonly HashSet<Guid> _responsables = new();

    private TipoProgramacion _tipo = TipoProgramacion.Periodicidad;
    private string _cron = "";
    private string _zonaHoraria = Propia.Infrastructure.Programaciones.CronHelper.ZonaHorariaPorDefecto;
    private CronPreviewResult? _cronPreview;
    private bool _cronTocado;
    private bool _notificarCorreo;

    /// <summary>
    /// Dias de generacion anticipada. 0 = la tarea aparece cuando llega la fecha (comportamiento
    /// clasico). Mayor que 0 = el job adelanta todo lo que caiga en la ventana.
    /// </summary>
    private int _horizonteDias;

    private static readonly (int Dias, string Label)[] Horizontes =
    {
        (0,   "Al llegar la fecha"),
        (30,  "Un mes antes"),
        (90,  "Un trimestre"),
        (180, "Un semestre"),
        (365, "Todo el anio")
    };

    private string HorizonteLabel() =>
        Horizontes.FirstOrDefault(h => h.Dias == _horizonteDias).Label?.ToLower() ?? $"{_horizonteDias} dias";

    private readonly (string Label, string Expr)[] _presets =
    {
        ("Cada dia 8:00", "0 8 * * *"),
        ("Lunes 8:00", "0 8 * * 1"),
        ("Dia 1 del mes 8:00", "0 8 1 * *"),
        ("Dia 15 del mes 8:00", "0 8 15 * *"),
        ("Cada 6 horas", "0 */6 * * *"),
        ("Trimestral (1 ene/abr/jul/oct)", "0 8 1 1,4,7,10 *")
    };

    private readonly PeriodicidadProgramacion[] _periodos =
    {
        PeriodicidadProgramacion.Unica, PeriodicidadProgramacion.Diaria, PeriodicidadProgramacion.Semanal,
        PeriodicidadProgramacion.Quincenal, PeriodicidadProgramacion.Mensual, PeriodicidadProgramacion.Bimestral,
        PeriodicidadProgramacion.Trimestral, PeriodicidadProgramacion.Semestral, PeriodicidadProgramacion.Anual
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(PrefillTitulo)) _titulo = PrefillTitulo!;
        if (!string.IsNullOrWhiteSpace(PrefillDescripcion)) _descripcion = PrefillDescripcion;
        if (PrefillFecha.HasValue) _fecha = PrefillFecha.Value.ToDateTime(TimeOnly.MinValue);
        if (PrefillTableroId.HasValue) _tableroId = PrefillTableroId.Value.ToString();
        _periodicidad = PrefillPeriodicidad;

        // Edicion: la regla guardada manda sobre cualquier prefill del escenario que abrio el modal.
        if (Existente is { } ex)
        {
            _titulo = ex.Titulo;
            _descripcion = ex.Descripcion;
            _prioridad = ex.Prioridad;
            _tableroId = ex.TableroId?.ToString() ?? "";
            _tipo = ex.Tipo;
            _periodicidad = ex.Periodicidad;
            _cron = ex.CronExpresion ?? "";
            _zonaHoraria = ex.ZonaHoraria;
            _fecha = ex.FechaProximaEjecucion.ToDateTime(TimeOnly.MinValue);
            _fechaFin = ex.FechaFin?.ToDateTime(TimeOnly.MinValue);
            _notificarCorreo = ex.NotificarPorCorreo;
            _horizonteDias = ex.HorizonteDias;
            foreach (var r in ex.Responsables) _responsables.Add(r.PersonaId);

            // El preview valida el boton Guardar: sin esto una regla cron abre deshabilitada.
            if (_tipo == TipoProgramacion.Cron && !string.IsNullOrWhiteSpace(_cron)) RefrescarPreview();
        }
    }

    private bool IsValid => !string.IsNullOrWhiteSpace(_titulo) && (
        _tipo == TipoProgramacion.Periodicidad
            ? _fecha.HasValue
            : _cronPreview is { Valida: true });

    private void ActivarCron()
    {
        _tipo = TipoProgramacion.Cron;
        if (string.IsNullOrWhiteSpace(_cron)) AplicarPreset(_presets[0].Expr);
    }

    private void OnCronInput(ChangeEventArgs e)
    {
        _cronTocado = true;
        _cron = e.Value?.ToString() ?? string.Empty;
        RefrescarPreview();
    }

    private void AplicarPreset(string expr)
    {
        _cron = expr;
        RefrescarPreview();
    }

    // Blazor Server: el componente ya corre en el servidor, asi que la previsualizacion
    // se calcula en proceso con el mismo helper que usa el job. Sin viaje HTTP.
    private void RefrescarPreview()
    {
        if (string.IsNullOrWhiteSpace(_cron)) { _cronPreview = null; return; }
        var helper = Propia.Infrastructure.Programaciones.CronHelper.Proximas(_cron, _zonaHoraria, DateTimeOffset.UtcNow, 4);
        _cronPreview = helper.Count > 0
            ? new CronPreviewResult(true, null, helper)
            : new CronPreviewResult(false, "Expresion no valida. Formato: minuto hora dia-del-mes mes dia-de-semana (ej. 0 8 * * 1).", Array.Empty<DateTimeOffset>());
    }

    private string FechaLocal(DateTimeOffset utc)
    {
        var zona = Propia.Infrastructure.Programaciones.CronHelper.Zona(_zonaHoraria);
        return TimeZoneInfo.ConvertTime(utc, zona).ToString("ddd dd MMM yyyy, HH:mm");
    }

    private IEnumerable<PersonaOpcion> PersonasFiltradas()
        => string.IsNullOrWhiteSpace(_filtro)
            ? Personas
            : Personas.Where(p => p.Nombre.Contains(_filtro, StringComparison.OrdinalIgnoreCase));

    private void ToggleResponsable(Guid id)
    {
        if (!_responsables.Add(id)) _responsables.Remove(id);
    }

    private void Confirmar()
    {
        if (!IsValid) return;
        var responsables = Personas.Where(p => _responsables.Contains(p.Id))
            .Select(p => new ResponsableProgramacionDto(p.Id, p.Nombre)).ToList();
        Guid? tablero = Guid.TryParse(_tableroId, out var g) ? g : null;
        var req = new CrearProgramacionRequest(
            _titulo.Trim(),
            string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion!.Trim(),
            _prioridad,
            tablero,
            _periodicidad,
            DateOnly.FromDateTime(_fecha ?? DateTime.Today),
            _fechaFin.HasValue ? DateOnly.FromDateTime(_fechaFin.Value) : null,
            responsables,
            ModuloOrigenCodigo,
            EntidadOrigenId,
            OrigenReferencia,
            _tipo,
            _tipo == TipoProgramacion.Cron ? _cron.Trim() : null,
            _zonaHoraria,
            _notificarCorreo,
            _horizonteDias);
        Close(req);
    }

    private static string PeriodicidadLabel(PeriodicidadProgramacion p) => p switch
    {
        PeriodicidadProgramacion.Unica => "Unica",
        PeriodicidadProgramacion.Diaria => "Diaria",
        PeriodicidadProgramacion.Semanal => "Semanal",
        PeriodicidadProgramacion.Quincenal => "Quincenal",
        PeriodicidadProgramacion.Mensual => "Mensual",
        PeriodicidadProgramacion.Bimestral => "Bimestral",
        PeriodicidadProgramacion.Trimestral => "Trimestral",
        PeriodicidadProgramacion.Semestral => "Semestral",
        PeriodicidadProgramacion.Anual => "Anual",
        _ => p.ToString()
    };
}

<style>
    .ptm-header { display: flex; align-items: center; gap: 12px; padding: 18px 24px; border-bottom: 1px solid var(--propia-border-divider, #EEF3F8); flex-shrink: 0; }
    .ptm-header-ic { width: 38px; height: 38px; border-radius: 10px; background: var(--propia-brand-soft, #F1ECFD); color: var(--propia-brand, #6D4FE3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .ptm-title { font-size: 16px; font-weight: 800; letter-spacing: -.3px; color: var(--propia-text-h1, #1B2A3A); }
    .ptm-sub { font-size: 12px; color: var(--propia-text-muted, #7C98B6); margin-top: 1px; }
    .ptm-close { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: var(--propia-text-muted, #7C98B6); border: 1px solid var(--propia-border-card, #E1E8EE); background: transparent; cursor: pointer; }
    .ptm-close:hover { background: var(--propia-bg-app, #F5F8FA); }

    .ptm-body { overflow-y: auto; padding: 18px 24px; display: flex; flex-direction: column; gap: 13px; }
    .ptm-field { display: flex; flex-direction: column; }
    .ptm-lbl { font-size: 11px; color: var(--propia-text-muted, #7C98B6); font-weight: 700; margin-bottom: 5px; }
    .ptm-req { color: var(--propia-error, #C0383C); }
    .ptm-input { border: 1px solid var(--propia-border-card, #E1E8EE); border-radius: 9px; padding: 10px 12px; font-size: 13.5px; color: var(--propia-text-body, #33475B); background: var(--propia-bg-card, #fff); outline: none; font-family: inherit; box-sizing: border-box; }
    .ptm-input:focus { border-color: var(--propia-brand, #6D4FE3); }
    .ptm-ta { resize: vertical; line-height: 1.5; }
    .ptm-mb { margin-bottom: 7px; }
    .ptm-row { display: flex; gap: 12px; }
    .ptm-grow { flex: 1; min-width: 0; }
    .ptm-w160 { width: 160px; }

    .ptm-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .ptm-chip { font-size: 11.5px; font-weight: 700; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--propia-border-card, #E1E8EE); color: var(--propia-text-secondary, #516F90); background: var(--propia-bg-card, #fff); cursor: pointer; }
    .ptm-chip:hover { border-color: var(--propia-brand, #6D4FE3); }
    .ptm-chip.on { border-color: var(--propia-brand, #6D4FE3); color: #fff; background: var(--propia-brand, #6D4FE3); }

    .ptm-tipos { display: flex; gap: 0; border: 1px solid var(--propia-border-card, #E1E8EE); border-radius: 9px; overflow: hidden; width: fit-content; }
    .ptm-tipo { font-size: 12px; font-weight: 700; padding: 8px 16px; border: 0; background: var(--propia-bg-card, #fff); color: var(--propia-text-secondary, #516F90); cursor: pointer; font-family: inherit; }
    .ptm-tipo.on { background: var(--propia-brand, #6D4FE3); color: #fff; }

    .ptm-cron { font-family: Consolas, "Courier New", monospace; letter-spacing: .5px; }
    .ptm-cron-presets { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 7px; }
    .ptm-preset { font-size: 10.5px; font-weight: 700; padding: 5px 9px; border-radius: 7px; border: 1px solid var(--propia-border-card, #E1E8EE); background: var(--propia-bg-app, #F5F8FA); color: var(--propia-text-secondary, #516F90); cursor: pointer; font-family: inherit; }
    .ptm-preset:hover { border-color: var(--propia-brand, #6D4FE3); color: var(--propia-brand, #6D4FE3); }

    .ptm-cron-box { border-radius: 10px; padding: 11px 13px; border: 1px solid; }
    .ptm-cron-box.ok { background: #F0FAF4; border-color: #C6E8D5; }
    .ptm-cron-box.bad { background: #FDF2F2; border-color: #F0C9C9; }
    .ptm-cron-t { font-size: 10.5px; font-weight: 800; letter-spacing: .4px; color: #15703F; margin-bottom: 5px; }
    .ptm-cron-list { margin: 0; padding-left: 17px; font-size: 12px; color: #33475B; line-height: 1.65; }
    .ptm-cron-err { font-size: 12px; color: #C0383C; font-weight: 600; }

    .ptm-check { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #33475B; cursor: pointer; }
