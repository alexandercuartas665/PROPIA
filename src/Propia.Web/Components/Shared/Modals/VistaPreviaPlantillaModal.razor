@* Vista previa de una plantilla de documentos (Configuracion > Plantillas): el documento compuesto (encabezado +
   cuerpo + pie, con el pie abajo de la hoja) y los datos {grupo.campo} reemplazados por los valores de EJEMPLO del
   catalogo, sobre una hoja blanca (blanca tambien en modo oscuro: es un documento a imprimir). Arriba se lee que
   encabezado y pie usa. Replica de vistaPrevia() en replica/js/mod-plantillas-doc.js. Tambien la usa el modal de
   encabezados y pies (Hint propio, sin la linea de membretes). Estilos en css/modules/plantillas.css. *@
@inherits ModalBase<bool>
@using Propia.Application.Plantillas
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared.Plantillas

<div class="pld-prev">
    <div class="gpl-head">
        <div class="gpl-eyebrow">VISTA PREVIA &middot; @((Nombre ?? "").ToUpper())</div>
        <button type="button" class="gpl-x" @onclick="() => Close(false)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
    </div>
    @if (Hint is not null)
    {
        <div class="pld-prev-hint"><i class="fi @(HintIcono ?? Cat.Icono)"></i> @Hint</div>
    }
    else
    {
        <div class="pld-prev-hint"><i class="fi @Cat.Icono"></i> Así se verá con datos de ejemplo. Al usarla en @Cat.UsadaEn, los datos {grupo.campo} se reemplazan por los reales.</div>
        <div class="pld-prev-mb">
            <span><i class="fi @PlantillaDoc.IconoTipo(TipoMembrete.Encabezado)"></i> Encabezado: <b>@PlantillaDoc.SelTexto(Membretes, Encabezado, TipoMembrete.Encabezado)</b></span>
            <span><i class="fi @PlantillaDoc.IconoTipo(TipoMembrete.Pie)"></i> Pie de página: <b>@PlantillaDoc.SelTexto(Membretes, Pie, TipoMembrete.Pie)</b></span>
        </div>
    }
    <div class="pld-prev-paper pld-doc">@((MarkupString)PlantillaDoc.Componer(CuerpoHtml, Categoria, Encabezado, Pie, CopropiedadNombre, Membretes))</div>
</div>

@code {
    [Parameter] public string? Nombre { get; set; }
    [Parameter] public string? Categoria { get; set; }
    [Parameter] public string? CuerpoHtml { get; set; }
    /// <summary>Eleccion de encabezado / pie ("pred" | "ninguno" | Id) y la biblioteca de membretes.</summary>
    [Parameter] public string? Encabezado { get; set; }
    [Parameter] public string? Pie { get; set; }
    [Parameter] public MembretesDto? Membretes { get; set; }
    /// <summary>Nombre de la copropiedad activa: valor de {copropiedad.nombre} (como la replica).</summary>
    [Parameter] public string? CopropiedadNombre { get; set; }
    /// <summary>Texto de ayuda propio (vista previa de un encabezado / pie); sin el, el de la plantilla.</summary>
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? HintIcono { get; set; }

    private PlantillaCategoriaDto Cat => PlantillasCatalogo.Categoria(Categoria);
}
