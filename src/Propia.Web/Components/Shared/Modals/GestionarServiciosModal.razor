@* GestionarServiciosModal - sec 5 Servicios y Contratos.
   Lista de contratos con proveedor, fechas, valor mensual y estado.
   Filtros por tipo + alerta de vencimiento. Form para crear contrato. *@

@inherits ModalBase<bool>
@using Propia.Web.Components.Shared.Modals
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums

@inject IHttpClientFactory HttpFactory

@* ====== HEADER ====== *@
<div class="gsv-header">
    <div class="gsv-header-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <path d="M14 2v6h6M9 13h6M9 17h6"/>
        </svg>
    </div>
    <div class="gsv-header-text">
        <div class="gsv-title">5. Servicios y contratos</div>
        <div class="gsv-subtitle">Aseo, seguridad, mantenimiento, ascensores y mas</div>
    </div>
    <button class="gsv-close" @onclick="Cerrar" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

@* ====== BODY ====== *@
<div class="gsv-body">

    @* Resumen *@
    <div class="gsv-summary">
        <span class="gsv-summary-strong">@_contratos.Count(c => c.Estado == EstadoContrato.Vigente) vigentes</span>
        <span class="gsv-summary-sep">·</span>
        <span>@_contratos.Count(c => c.Estado == EstadoContrato.EnRenovacion) en renovacion</span>
        <span class="gsv-summary-sep">·</span>
        <span>@_contratos.Count(c => c.Estado == EstadoContrato.Vencido) vencidos</span>
        @if (_contratos.Any(c => c.AlertaVencimiento))
        {
            <span class="gsv-summary-sep">·</span>
            <span class="gsv-alert-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 9v4M12 17h.01M4.93 19h14.14a2 2 0 0 0 1.73-3L13.73 4a2 2 0 0 0-3.46 0L3.2 16a2 2 0 0 0 1.73 3z"/></svg>
                @_contratos.Count(c => c.AlertaVencimiento) por vencer
            </span>
        }
    </div>

    @* Lista contratos *@
    @if (_contratos.Count == 0)
    {
        <div class="gsv-empty">Sin contratos registrados. Agrega el primero abajo.</div>
    }
    else
    {
        <div class="gsv-list">
            @foreach (var c in _contratos.OrderBy(x => x.Tipo).ThenBy(x => x.FechaFin))
            {
                <div class="gsv-card @(c.AlertaVencimiento ? "gsv-card--alert" : "")">
                    <div class="gsv-card-icon">
                        @TipoIcon(c.Tipo)
                    </div>
                    <div class="gsv-card-id">
                        <div class="gsv-card-line1">
                            <span class="gsv-card-name">@c.Proveedor</span>
                            <span class="gsv-card-type">@TipoLabel(c.Tipo)</span>
                        </div>
                        <div class="gsv-card-line2">
                            Desde @c.FechaInicio.ToString("yyyy-MM-dd")
                            @if (c.FechaFin.HasValue) { <span> · hasta @c.FechaFin.Value.ToString("yyyy-MM-dd")</span> }
                            @if (c.ValorMensual.HasValue) { <span> · $ @c.ValorMensual.Value.ToString("N0")/mes</span> }
                            @if (!string.IsNullOrEmpty(c.Contacto)) { <span> · @c.Contacto</span> }
                        </div>
                    </div>
                    <div class="gsv-card-state">
                        <span class="gsv-badge @EstadoClass(c.Estado)">@EstadoLabel(c.Estado)</span>
                        @if (c.AlertaVencimiento && c.DiasParaVencer.HasValue)
                        {
                            <span class="gsv-alert">Vence en @c.DiasParaVencer d</span>
                        }
                    </div>
                    @if (c.Estado != EstadoContrato.Vencido)
                    {
                        <select class="gsv-state-select" value="@c.Estado" @onchange="(e) => CambiarEstado(c.Id, e)">
                            <option value="@EstadoContrato.Vigente">Vigente</option>
                            <option value="@EstadoContrato.EnRenovacion">En renovacion</option>
                        </select>
                    }
                    <button class="gsv-del" type="button" @onclick="() => Eliminar(c.Id)" title="Eliminar">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                    </button>
                </div>
            }
        </div>
    }

    @* Form crear *@
    <div class="gsv-form">
        <div class="gsv-form-title">+ Crear nuevo contrato</div>
        <div class="gsv-form-row">
            <select class="gsv-input gsv-grow" @bind="_form.Tipo">
                @foreach (var t in Enum.GetValues<TipoServicio>())
                {
                    <option value="@t">@TipoLabel(t)</option>
                }
            </select>
            <input class="gsv-input gsv-grow" @bind="_form.Proveedor" @bind:event="oninput" placeholder="Proveedor *" />
            <input class="gsv-input gsv-grow" @bind="_form.NitProveedor" @bind:event="oninput" placeholder="NIT del proveedor" />
        </div>
        <div class="gsv-form-row">
            <input class="gsv-input gsv-grow" @bind="_form.Contacto" @bind:event="oninput" placeholder="Contacto (telefono/email)" />
            <input type="date" class="gsv-input" @bind="_form.FechaInicio" />
            <input type="date" class="gsv-input" @bind="_form.FechaFin" placeholder="Fecha fin" />
        </div>
        <div class="gsv-form-row">
            <input type="number" step="any" class="gsv-input gsv-grow" @bind="_form.ValorMensual" placeholder="Valor mensual (COP)" />
            <input type="number" class="gsv-input" style="width:160px" @bind="_form.DiasAnticipacionAlerta" placeholder="Dias alerta" />
            <button class="gsv-btn-brand" type="button" @onclick="Crear" disabled="@(_busy || !FormValido)">Crear contrato</button>
        </div>
        <textarea class="gsv-input" rows="2" @bind="_form.Observaciones" placeholder="Observaciones (opcional)"></textarea>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="gsv-msg @(_msgError ? "gsv-msg--err" : "gsv-msg--ok")">@_msg</div>
    }
</div>

<style>
    .gsv-header {
        display: flex; align-items: center; gap: 13px;
        padding: 18px 24px; border-bottom: 1px solid #EEF3F8; flex-shrink: 0;
    }
    .gsv-header-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: var(--propia-brand-soft, #F1ECFD);
        color: var(--propia-brand, #6D4FE3);
        display: flex; align-items: center; justify-content: center;
    }
    .gsv-header-text { flex: 1; }
    .gsv-title { font-size: 16px; font-weight: 800; letter-spacing: -0.3px; color: #1B2A3A; }
    .gsv-subtitle { font-size: 12.5px; color: #7C98B6; }
    .gsv-close {
        width: 34px; height: 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        color: #7C98B6; border: 1px solid #E1E8EE; background: #fff; cursor: pointer;
    }
    .gsv-close:hover { background: #F5F8FA; color: #33475B; }

    .gsv-body { padding: 20px 24px; overflow-y: auto; font-family: var(--propia-font-base, 'Lexend', sans-serif); }

    .gsv-summary {
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        margin-bottom: 14px;
        font-size: 13px; color: #516F90;
    }
    .gsv-summary-strong { color: #33475B; font-weight: 700; }
    .gsv-summary-sep { color: #A6B7C8; }
    .gsv-alert-pill {
        display: inline-flex; align-items: center; gap: 5px;
        background: #FEF3C7; color: #B45309;
        font-size: 11.5px; font-weight: 700;
        padding: 3px 10px; border-radius: 6px;
    }

    .gsv-empty {
        background: #F8FAFC; border: 1px dashed #D7E0EA; border-radius: 11px;
        padding: 20px; text-align: center; font-size: 13px; color: #A6B7C8; margin-bottom: 14px;
    }

    .gsv-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
    .gsv-card {
        display: flex; align-items: center; gap: 11px;
        border: 1px solid #E1E8EE; border-radius: 11px;
        padding: 12px 14px; background: #fff;
    }
    .gsv-card--alert { border-color: #FDE68A; background: #FFFBEB; }
    .gsv-card-icon {
        width: 36px; height: 36px; border-radius: 9px;
        background: var(--propia-brand-soft, #F1ECFD);
        color: var(--propia-brand, #6D4FE3);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .gsv-card-id { flex: 1; min-width: 0; }
    .gsv-card-line1 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .gsv-card-name { font-size: 13.5px; font-weight: 700; color: #33475B; }
    .gsv-card-type {
        font-size: 11px; font-weight: 700;
        color: #516F90; background: #F5F8FA;
        border: 1px solid #E1E8EE; padding: 2px 8px; border-radius: 6px;
    }
    .gsv-card-line2 { font-size: 11.5px; color: #7C98B6; margin-top: 2px; }
    .gsv-card-state {
        display: flex; flex-direction: column; align-items: flex-end; gap: 3px;
        flex-shrink: 0;
    }
    .gsv-badge {
        font-size: 10.5px; font-weight: 700;
        padding: 3px 8px; border-radius: 6px;
    }
    .gsv-badge--ok { color: #1A8754; background: #E6F6EE; }
    .gsv-badge--warn { color: #B45309; background: #FEF3C7; }
    .gsv-badge--err { color: #B91C1C; background: #FEE2E2; }
    .gsv-alert { font-size: 10px; color: #B45309; font-weight: 700; }
    .gsv-state-select {
        border: 1px solid #E1E8EE; border-radius: 8px;
        padding: 6px 8px; font-size: 11.5px; color: #33475B;
        background: #fff; outline: none; font-family: inherit;
    }
    .gsv-del {
        width: 28px; height: 28px; border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        color: #C3D0DD; border: 0; background: transparent;
        cursor: pointer; flex-shrink: 0;
    }
    .gsv-del:hover { background: #FDE7E7; color: #D7263D; }

    .gsv-form {
        background: #F8FAFC; border: 1px dashed #D7E0EA; border-radius: 12px;
        padding: 14px;
    }
    .gsv-form-title { font-size: 13px; font-weight: 700; color: #1B2A3A; margin-bottom: 10px; }
    .gsv-form-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
    .gsv-input {
        border: 1px solid #E1E8EE; border-radius: 9px;
        padding: 9px 11px; font-size: 13px; color: #33475B;
        background: #fff; outline: none; min-width: 0; font-family: inherit; box-sizing: border-box;
        width: 100%;
    }
    .gsv-input:focus { border-color: var(--propia-brand, #6D4FE3); }
    .gsv-grow { flex: 1; min-width: 140px; width: auto; }
    .gsv-btn-brand {
        padding: 9px 17px; border-radius: 9px;
        background: var(--propia-brand, #6D4FE3); color: #fff;
        font-size: 13px; font-weight: 700; border: 0; cursor: pointer;
        box-shadow: 0 4px 12px rgba(109,79,227,.30); white-space: nowrap;
    }
    .gsv-btn-brand:hover { background: var(--propia-brand-hover, #5838C9); }
    .gsv-btn-brand:disabled { opacity: .5; cursor: not-allowed; box-shadow: none; }

    .gsv-msg { margin-top: 12px; padding: 9px 12px; font-size: 12.5px; border-radius: 9px; border: 1px solid; }
    .gsv-msg--ok { color: #15703F; background: #E6F6EE; border-color: #B6E2C9; }
    .gsv-msg--err { color: #B91C1C; background: #FEE2E2; border-color: #FECACA; }

    [data-bs-theme="dark"] .gsv-title,
    [data-bs-theme="dark"] .gsv-card-name { color: #E5E7EB; }
    [data-bs-theme="dark"] .gsv-card,
    [data-bs-theme="dark"] .gsv-form { background: #232B40; border-color: #2D3650; }
</style>

@code {
    [Parameter] public string? Jwt { get; set; }

    private List<ContratoServicioDto> _contratos = new();
    private ContratoForm _form = new();
    private bool _busy;
    private string _msg = "";
    private bool _msgError;
    private bool _huboCambios;

    private class ContratoForm
    {
        public TipoServicio Tipo { get; set; } = TipoServicio.Aseo;
        public string Proveedor { get; set; } = "";
        public string NitProveedor { get; set; } = "";
        public string Contacto { get; set; } = "";
        public DateTime FechaInicio { get; set; } = DateTime.Today;
        public DateTime? FechaFin { get; set; }
        public decimal? ValorMensual { get; set; }
        public string Observaciones { get; set; } = "";
        public int DiasAnticipacionAlerta { get; set; } = 30;
    }

    private bool FormValido =>
        !string.IsNullOrWhiteSpace(_form.Proveedor) &&
        _form.DiasAnticipacionAlerta >= 0;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try { _contratos = await Auth().GetFromJsonAsync<List<ContratoServicioDto>>("/api/mi-copropiedad/contratos") ?? new(); }
        catch { _contratos = new(); }
    }

    private async Task Crear()
    {
        if (!FormValido) return;
        _busy = true;
        var req = new CrearContratoServicioRequest(
            _form.Tipo,
            _form.Proveedor.Trim(),
            string.IsNullOrWhiteSpace(_form.NitProveedor) ? null : _form.NitProveedor.Trim(),
            string.IsNullOrWhiteSpace(_form.Contacto) ? null : _form.Contacto.Trim(),
            DateOnly.FromDateTime(_form.FechaInicio),
            _form.FechaFin.HasValue ? DateOnly.FromDateTime(_form.FechaFin.Value) : null,
            _form.ValorMensual,
            string.IsNullOrWhiteSpace(_form.Observaciones) ? null : _form.Observaciones.Trim(),
            _form.DiasAnticipacionAlerta);
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/contratos", req);
        if (resp.IsSuccessStatusCode)
        {
            _form = new ContratoForm();
            _huboCambios = true;
            await CargarAsync();
            ShowMsg("Contrato creado.", false);
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
        _busy = false;
    }

    private async Task CambiarEstado(Guid id, ChangeEventArgs e)
    {
        if (!Enum.TryParse<EstadoContrato>(e.Value?.ToString(), out var nuevo)) return;
        var actual = _contratos.FirstOrDefault(c => c.Id == id);
        if (actual is null) return;
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/contratos/{id}",
            new ActualizarContratoRequest(nuevo, actual.DiasAnticipacionAlerta));
        if (resp.IsSuccessStatusCode) { _huboCambios = true; await CargarAsync(); }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
    }

    private async Task Eliminar(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/contratos/{id}");
        if (resp.IsSuccessStatusCode) { _huboCambios = true; await CargarAsync(); }
    }

    private void ShowMsg(string text, bool isError) { _msg = text; _msgError = isError; }
    private void Cerrar() => Close(_huboCambios);

    private static string TipoLabel(TipoServicio t) => t switch
    {
        TipoServicio.PiscinaMantenimiento => "Mantenimiento piscina",
        TipoServicio.InternetWifi => "Internet / WiFi",
        TipoServicio.SeguroPH => "Seguro PH",
        _ => t.ToString()
    };

    private static string EstadoLabel(EstadoContrato e) => e switch
    {
        EstadoContrato.Vigente => "Vigente",
        EstadoContrato.EnRenovacion => "En renovacion",
        EstadoContrato.Vencido => "Vencido",
        _ => e.ToString()
    };

    private static string EstadoClass(EstadoContrato e) => e switch
    {
        EstadoContrato.Vigente => "gsv-badge--ok",
        EstadoContrato.EnRenovacion => "gsv-badge--warn",
        _ => "gsv-badge--err"
    };

    private static MarkupString TipoIcon(TipoServicio t)
    {
        // Iconos contextuales por tipo - SVG inline simple
        var path = t switch
        {
            TipoServicio.Aseo => "<path d='M3 21l1.5-4.5L17 4l3 3L7.5 19.5 3 21z'/>",
            TipoServicio.Seguridad => "<path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/>",
            TipoServicio.Ascensores => "<path d='M6 2v20M18 2v20M9 7l3-3 3 3M9 17l3 3 3-3'/>",
            TipoServicio.SeguroPH => "<path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4'/>",
            TipoServicio.InternetWifi => "<path d='M5 12.55a11 11 0 0 1 14 0M8.5 16a6 6 0 0 1 7 0M2 8.82a15 15 0 0 1 20 0M12 20h.01'/>",
            TipoServicio.Energia => "<path d='M13 2L3 14h9l-1 8 10-12h-9l1-8z'/>",
            TipoServicio.Agua => "<path d='M12 3l7 10a7 7 0 1 1-14 0L12 3z'/>",
            TipoServicio.Plagas => "<path d='M9 4h6v6H9zM4 11h16v6H4zM7 17v4M17 17v4'/>",
            _ => "<path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/>"
        };
        return new MarkupString($"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>{path}</svg>");
    }
}
