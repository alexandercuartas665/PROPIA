@inherits ModalBase<bool>
@*
   Modal de confirmacion generico (reemplaza el confirm() nativo del navegador).
   Se abre con el helper Modals.ConfirmAsync(mensaje, ...) y devuelve true si el
   usuario confirma; false/null si cancela o cierra por backdrop. Colores por tokens.
*@
<div class="cfm">
    <div class="cfm-body">
        @if (!string.IsNullOrWhiteSpace(Titulo))
        {
            <div class="cfm-title">@Titulo</div>
        }
        <div class="cfm-msg">@Mensaje</div>
        @* Modo fuerte (doble confirmacion): un checkbox obligatorio gatea el boton Confirmar. *@
        @if (!string.IsNullOrWhiteSpace(ConfirmacionCheck))
        {
            <label class="cfm-chk">
                <input type="checkbox" checked="@_checked" @onchange="e => _checked = (bool)(e.Value ?? false)" />
                <span>@ConfirmacionCheck</span>
            </label>
        }
    </div>
    <div class="cfm-acts">
        <button type="button" class="cfm-btn cfm-cancel" @onclick="Cancel">@Cancelar</button>
        <button type="button" class="cfm-btn @(Peligro ? "cfm-danger" : "cfm-ok")"
                @onclick="() => Close(true)" disabled="@(!string.IsNullOrWhiteSpace(ConfirmacionCheck) && !_checked)">@Confirmar</button>
    </div>
</div>

@code {
    [Parameter] public string Mensaje { get; set; } = "";
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string Confirmar { get; set; } = "Si, continuar";
    [Parameter] public string Cancelar { get; set; } = "Cancelar";
    [Parameter] public bool Peligro { get; set; } = true;
    /// <summary>Si se setea, se muestra un checkbox obligatorio con este texto y el boton Confirmar
    /// queda deshabilitado hasta marcarlo (doble confirmacion para acciones destructivas).</summary>
    [Parameter] public string? ConfirmacionCheck { get; set; }

    private bool _checked;
}

<style>
    .cfm { display: flex; flex-direction: column; }
    .cfm-body { padding: 22px 22px 8px; }
    .cfm-title { font-size: 16px; font-weight: 700; color: var(--propia-text-strong); margin-bottom: 8px; }
    .cfm-msg { font-size: 13.5px; line-height: 1.5; color: var(--propia-text-muted); white-space: pre-line; }
    .cfm-chk { display: flex; align-items: flex-start; gap: 8px; margin-top: 14px; padding: 10px 12px; border-radius: 9px; background: var(--propia-danger-soft); border: 1px solid var(--propia-danger-border, var(--propia-border-card)); font-size: 12.5px; line-height: 1.45; color: var(--propia-text-body); cursor: pointer; }
    .cfm-chk input { margin-top: 2px; flex: 0 0 auto; cursor: pointer; }
    .cfm-acts { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 22px 20px; }
    .cfm-btn:disabled { opacity: .5; cursor: not-allowed; }
    .cfm-btn { font-size: 13px; font-weight: 600; padding: 8px 16px; border-radius: 9px; cursor: pointer; border: 1px solid transparent; }
    .cfm-cancel { background: var(--propia-bg-card); color: var(--propia-text-muted); border-color: var(--propia-border-card); }
    .cfm-cancel:hover { background: var(--propia-bg-hover); }
    .cfm-ok { background: var(--propia-brand); color: var(--propia-text-inverse); }
    .cfm-ok:hover { background: var(--propia-brand-hover); }
    .cfm-danger { background: var(--propia-danger); color: var(--propia-text-inverse); }
    .cfm-danger:hover { filter: brightness(0.96); }
</style>
