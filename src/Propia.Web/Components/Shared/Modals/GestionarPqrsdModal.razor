@* GestionarPqrsdModal - modal fullscreen para gestionar un expediente PQRSD.
   Layout 2 paneles: izq detalle + acciones, der historial + adjuntos. *@

@inherits ModalBase<bool>
@using Propia.Web.Components.Shared.Modals
@using Propia.Application.Pqrsd
@using Propia.Application.MiCopropiedad
@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

@* ====== MODAL (contenedor auto-acotado, estilo Tareas) ====== *@
<div class="gpq-modal">
@* ====== HEADER ====== *@
<div class="gpq-header">
    <div class="gpq-header-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6"/>
        </svg>
    </div>
    <div class="gpq-header-text">
        @if (_detalle is not null)
        {
            <div class="gpq-title gpq-title--num">@_detalle.NumeroRadicado</div>
            <div class="gpq-subtitle">@(_detalle.TipoNombre ?? TipoLabel(_detalle.Tipo)) &middot; @_detalle.CategoriaNombre &middot; radicada @_detalle.CreatedAt.ToString("dd MMM yyyy")</div>
        }
        else
        {
            <div class="gpq-title">Cargando expediente...</div>
        }
    </div>
    @if (_detalle is not null)
    {
        <span class="gpq-estado-pill @EstadoClass(_detalle.Estado)">@EstadoLabel(_detalle.Estado)</span>
        <span class="gpq-sem @SemaforoClass(_detalle.Semaforo)">@SemaforoLabel(_detalle.Semaforo)</span>
    }
    <button class="gpq-close" @onclick="Cerrar" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

@* ====== TABS (estilo Tareas) ====== *@
@if (_detalle is not null)
{
    <div class="gpq-tabs">
        <button type="button" class="gpq-tab @(_tab == "detalle" ? "active" : "")" @onclick='@(() => _tab = "detalle")'>Detalle</button>
        @if (_detalle.Estado != EstadoPqrsd.Cerrada && _detalle.Estado != EstadoPqrsd.ViaInternaAgotada)
        {
            <button type="button" class="gpq-tab @(_tab == "responder" ? "active" : "")" @onclick='@(() => _tab = "responder")'>Responder</button>
        }
        <button type="button" class="gpq-tab @(_tab == "tareas" ? "active" : "")" @onclick="AbrirTabTareas">Tareas@(_pqrTareas is not null && _pqrTareas.Tareas.Count > 0 ? $" ({_pqrTareas.Tareas.Count})" : "")</button>
        <button type="button" class="gpq-tab @(_tab == "historial" ? "active" : "")" @onclick='@(() => _tab = "historial")'>Historial@(_detalle.Historial.Count > 0 ? $" ({_detalle.Historial.Count})" : "")</button>
        <button type="button" class="gpq-tab @(_tab == "adjuntos" ? "active" : "")" @onclick='@(() => _tab = "adjuntos")'>Adjuntos@(_detalle.Adjuntos.Count > 0 ? $" ({_detalle.Adjuntos.Count})" : "")</button>
    </div>
}

@* ====== BODY (tabs) ====== *@
<div class="gpq-body">

    @* ===== Tab Detalle ===== *@
    <div class="gpq-pane gpq-pane-detalle" style="@(_detalle is null || _tab == "detalle" ? "" : "display:none")">
        @if (_detalle is null)
        {
            <div class="gpq-loading">Cargando...</div>
        }
        else
        {
            @* Pills de caracterizacion (estilo Tareas): tipo, categoria, edad y SLA *@
            <div class="gpq-pills">
                <span class="gpq-pill gpq-pill-tipo">@(_detalle.TipoNombre ?? TipoLabel(_detalle.Tipo))</span>
                <span class="gpq-pill gpq-pill-cat">@_detalle.CategoriaNombre</span>
                <span class="gpq-pill gpq-pill-age">Radicada hace @DiasDesde(_detalle.CreatedAt)</span>
                <span class="gpq-pill @PlazoPillClass()">@PlazoTexto()</span>
            </div>

            @* Flags arriba *@
            @if (_detalle.TutelaActiva || _detalle.Comite is not null)
            {
                <div class="gpq-flags">
                    @if (_detalle.TutelaActiva)
                    {
                        <span class="gpq-flag gpq-flag--tutela">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 9v4M12 17h.01M4.93 19h14.14a2 2 0 0 0 1.73-3L13.73 4a2 2 0 0 0-3.46 0L3.2 16a2 2 0 0 0 1.73 3z"/></svg>
                            Tutela activa @(_detalle.TutelaActivadaAt is null ? "" : $"desde {_detalle.TutelaActivadaAt:dd MMM}")
                        </span>
                    }
                    @if (_detalle.Comite is not null)
                    {
                        <span class="gpq-flag gpq-flag--comite">Comite de convivencia</span>
                    }
                </div>
            }

            @* ===== Layout 3 columnas (estilo Tareas) ===== *@
            <div class="gpq-cols">
            <div class="gpq-col">

            @* Descripcion del caso (arriba, antes de Unidad afectada) *@
            <div class="gpq-card">
                <div class="gpq-card-eyebrow">DESCRIPCION DEL CASO</div>
                <div class="gpq-desc">@_detalle.Descripcion</div>
            </div>

            @* Contexto unidad *@
            @if (_contexto?.Unidad.UnidadId.HasValue == true)
            {
                <div class="gpq-card gpq-card--unit">
                    <div class="gpq-card-eyebrow">UNIDAD AFECTADA</div>
                    <div class="gpq-unit-head">
                        <div class="gpq-unit-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-4h4v4"/></svg>
                        </div>
                        <div class="gpq-unit-id">
                            <div class="gpq-unit-num">@_contexto.Unidad.Tipo @_contexto.Unidad.UnidadNumero</div>
                            <div class="gpq-unit-meta">
                                @(_contexto.Unidad.TorreNombre ?? "Sin torre")
                                @(_contexto.Unidad.Piso.HasValue ? $" · Piso {_contexto.Unidad.Piso}" : "")
                                @(_contexto.Unidad.CoeficientePropiedad.HasValue ? $" · Coef {_contexto.Unidad.CoeficientePropiedad:0.##}%" : "")
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="gpq-card gpq-card--unit gpq-card--nounit">
                    <div class="gpq-card-eyebrow">UNIDAD AFECTADA</div>
                    <div class="gpq-noref">Radicador sin unidad asociada. PQR de uso general.</div>
                </div>
            }

            @* Contacto humano + cambiar solicitante (unificado: antes eran 2 cajas separadas) *@
            <div class="gpq-card">
                <div class="gpq-card-eyebrow">CONTACTO HUMANO@(_contexto is not null && _contexto.Personas.Count > 0 ? $" ({_contexto.Personas.Count})" : "")</div>
                @if (_contexto is not null && _contexto.Personas.Count > 0)
                {
                    <div class="gpq-people">
                        @foreach (var p in _contexto.Personas)
                        {
                            <div class="gpq-person @(p.EsRadicador ? "gpq-person--radicador" : "")">
                                <div class="gpq-person-avatar @PersonaAvatar(p.Rol)">@Iniciales(p.Nombre)</div>
                                <div class="gpq-person-id">
                                    <div class="gpq-person-name">
                                        @p.Nombre
                                        @if (p.EsRadicador) { <span class="gpq-radica-tag">RADICADOR</span> }
                                    </div>
                                    <div class="gpq-person-rol">@p.Rol · @p.Documento</div>
                                    @if (!string.IsNullOrEmpty(p.Email))
                                    {
                                        <a class="gpq-person-link" href="mailto:@p.Email">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/></svg>
                                            @p.Email
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(p.Telefono))
                                    {
                                        <a class="gpq-person-link" href="tel:@p.Telefono">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                                            @p.Telefono
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="gpq-noref" style="margin-bottom:8px;">Sin personas asociadas todavia.</div>
                }
                <label class="gpq-mini-lbl" style="margin-top:8px;">Cambiar solicitante (directorio - se puede crear)</label>
                <SelectorPersona Jwt="@Jwt" @bind-Seleccionada="_personaSel" Placeholder="Buscar o crear persona..." />
                <div class="gpq-mini-hint">Se guarda con "Guardar cambios" en Propiedad y gestion.</div>
            </div>

            @* CAMPOS DINAMICOS (movido a la col 1, debajo de Contacto humano) *@
            <div class="gpq-card">
                <div class="gpq-card-eyebrow">CAMPOS DINAMICOS</div>
                @if (_campos.Count > 0)
                {
                    @foreach (var c in _campos.OrderBy(c => c.Orden))
                    {
                        <label class="gpq-mini-lbl">@c.Label</label>
                        @if (c.Tipo == TipoCampoTablero.Seleccion)
                        {
                            <select class="gpq-input" value="@_campoValores.GetValueOrDefault(c.Id, "")" @onchange="(e) => SetCampo(c.Id, e.Value?.ToString())">
                                <option value="">- elegir -</option>
                                @foreach (var op in (c.Opciones ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <option value="@op">@op</option>
                                }
                            </select>
                        }
                        else if (c.Tipo == TipoCampoTablero.AreaTexto)
                        {
                            <textarea class="gpq-input" rows="2" value="@_campoValores.GetValueOrDefault(c.Id, "")" @onchange="(e) => SetCampo(c.Id, e.Value?.ToString())"></textarea>
                        }
                        else
                        {
                            <input class="gpq-input" type="@CampoInputType(c.Tipo)" value="@_campoValores.GetValueOrDefault(c.Id, "")" @onchange="(e) => SetCampo(c.Id, e.Value?.ToString())" />
                        }
                    }
                }
                else
                {
                    <div class="gpq-actividad-empty">Sin campos configurados. Se administran en Configurar PQRSD &gt; Campos dinamicos.</div>
                }
            </div>

            @* (col 1 + col 2 unidas en una sola columna) *@

            @* Plazo (SLA visual, estilo Tareas): barra de tiempo transcurrido + cuanto queda para responder *@
            <div class="gpq-card">
                <div class="gpq-sla-head">
                    <div class="gpq-card-eyebrow" style="margin:0;">PLAZO LEGAL (SLA)</div>
                    <div class="gpq-sla-actions">
                        @if (_detalle.Estado != EstadoPqrsd.Cerrada && _detalle.Estado != EstadoPqrsd.ViaInternaAgotada)
                        {
                            <button class="gpq-sla-add @(_prorrogaAbierta ? "gpq-sla-add--on" : "")" type="button" title="Agregar prorroga (ampliar el plazo)" @onclick="ToggleProrroga">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"/></svg>
                                Prorroga
                            </button>
                        }
                        @if (!_detalle.TutelaActiva && _detalle.Estado != EstadoPqrsd.Cerrada)
                        {
                            <button class="gpq-sla-add gpq-sla-add--tutela @(_tutelaAbierta ? "gpq-sla-add--on" : "")" type="button" title="Pasar a tutela (accion de tutela)" @onclick="ToggleTutela">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                Tutela
                            </button>
                        }
                    </div>
                </div>
                <div class="gpq-sla-big @PlazoPillClass()">@PlazoTexto()</div>
                <div class="gpq-sla-bar"><div class="gpq-sla-fill @PlazoPillClass()" style="width:@SlaPct()%"></div></div>
                <div class="gpq-sla-ends">
                    <span>Radicada @_detalle.CreatedAt.ToString("dd MMM")</span>
                    <span>Transcurrido @DiasDesde(_detalle.CreatedAt)</span>
                    <span>Vence @_detalle.FechaVencimiento.ToString("dd MMM yyyy")</span>
                </div>
                @if (_detalle.ProrrogaDias > 0)
                {
                    <div class="gpq-plazo-row" style="margin-top:9px;"><span>Prorroga aplicada</span><strong style="color:#B45309;">+@_detalle.ProrrogaDias dias habiles</strong></div>
                }
                <div class="gpq-plazo-row" style="margin-top:9px;"><span>Urgencia</span><strong>@_detalle.NivelUrgencia</strong></div>
                @if (_detalle.TutelaActiva)
                {
                    <div class="gpq-plazo-row" style="margin-top:9px;"><span>Estado legal</span><strong style="color:#DC2626;">EN TUTELA</strong></div>
                }

                @* Mini-menu de prorroga que se despliega (slot) sobre la tarjeta al pulsar "+ Prorroga" *@
                <div class="gpq-prorroga-pop @(_prorrogaAbierta ? "open" : "")">
                    <div class="gpq-prorroga-inner">
                        <label class="gpq-mini-lbl">Dias habiles a agregar</label>
                        <input class="gpq-input" type="number" min="1" max="60" @bind="_prorrogaDias" @bind:event="oninput" placeholder="Ej. 5" />
                        <label class="gpq-mini-lbl" style="margin-top:8px;">Motivo de la prorroga *</label>
                        <textarea class="gpq-input" rows="2" @bind="_prorrogaMotivo" @bind:event="oninput" placeholder="Ej. Se requiere practicar prueba tecnica antes de responder."></textarea>
                        <div class="gpq-prorroga-hint">Suma @(_prorrogaDias < 1 ? "N" : _prorrogaDias.ToString()) dia(s) habil(es) al vencimiento. El motivo queda en el historial.</div>
                        <div class="gpq-prorroga-foot">
                            <button class="gpq-btn-ghost gpq-btn-sm" type="button" @onclick="ToggleProrroga">Cancelar</button>
                            <button class="gpq-btn-brand gpq-btn-sm" type="button" @onclick="EjecutarProrroga" disabled="@(_busy || _prorrogaDias < 1 || string.IsNullOrWhiteSpace(_prorrogaMotivo))">Aplicar</button>
                        </div>
                    </div>
                </div>

                @* Mini-menu de tutela (slot) sobre la tarjeta al pulsar "Tutela" *@
                <div class="gpq-prorroga-pop @(_tutelaAbierta ? "open" : "")">
                    <div class="gpq-prorroga-inner">
                        <label class="gpq-mini-lbl">Justificacion de la tutela *</label>
                        <textarea class="gpq-input" rows="3" @bind="_tutelaMotivo" @bind:event="oninput" placeholder="Ej. Se recibio notificacion de accion de tutela."></textarea>
                        <div class="gpq-prorroga-hint">Marca el expediente EN TUTELA (prioridad critica). Queda en el historial.</div>
                        <div class="gpq-prorroga-foot">
                            <button class="gpq-btn-ghost gpq-btn-sm" type="button" @onclick="ToggleTutela">Cancelar</button>
                            <button class="gpq-btn-warn gpq-btn-sm" type="button" @onclick="EjecutarTutelaSlot" disabled="@(_busy || string.IsNullOrWhiteSpace(_tutelaMotivo))">Activar tutela</button>
                        </div>
                    </div>
                </div>
            </div>

            @* Propiedad + gestion (editable). El solicitante se cambia en la caja Contacto humano. *@
            <div class="gpq-card">
                <div class="gpq-card-eyebrow">PROPIEDAD Y GESTION</div>
                <label class="gpq-mini-lbl">Propiedad relacionada</label>
                <SelectorUnidadCascada Unidades="_unidades" UnidadId="_unidadSel"
                                       UnidadIdChanged="@(v => _unidadSel = v)"
                                       Class="gpq-input" MostrarLabels="false" />

                @* Progreso de gestion (slider, estilo Tareas) *@
                <label class="gpq-mini-lbl" style="margin-top:10px;">Progreso: <strong>@_progreso%</strong></label>
                <input type="range" min="0" max="100" step="5" class="gpq-range" @bind="_progreso" @bind:event="oninput" />
                <div class="gpq-progbar"><div class="gpq-progfill" style="width:@_progreso%"></div></div>

                @* Responsable / persona asignada *@
                <label class="gpq-mini-lbl" style="margin-top:10px;">Responsable asignado</label>
                <div class="gpq-asig-cur">
                    Actual: <strong>@(_detalle.AsignadoNombre ?? "sin asignar")</strong>
                    @if (!string.IsNullOrEmpty(_detalle.AsignadoNombre))
                    {
                        <button type="button" class="gpq-asig-quitar" @onclick="@(() => { _quitarAsignado = true; _asignadoSel = null; })">quitar</button>
                    }
                    @if (_quitarAsignado) { <span class="gpq-asig-quitando">(se quitara al guardar)</span> }
                </div>
                <SelectorPersona Jwt="@Jwt" @bind-Seleccionada="_asignadoSel" Placeholder="Asignar responsable..." />

                <button class="gpq-btn-brand" style="margin-top:10px;" type="button" @onclick="GuardarDatos" disabled="@_guardandoRel">
                    @(_guardandoRel ? "Guardando..." : "Guardar cambios")
                </button>
            </div>

            @* Crear tarea interna (2.10) desde el PQR *@
            <div class="gpq-card">
                <div class="gpq-card-eyebrow">TAREA INTERNA</div>
                @if (_detalle.TareaId is not null)
                {
                    <div class="gpq-plazo-row"><span>Este PQR ya tiene una tarea vinculada.</span><strong>Vinculada</strong></div>
                }
                else
                {
                    <button class="gpq-btn-brand" type="button" @onclick="CrearTareaDesdePqr" disabled="@_generandoTarea">
                        @(_generandoTarea ? "Creando..." : "Crear tarea desde este PQR")
                    </button>
                }
            </div>

            </div>@* fin col 2 *@
            <div class="gpq-col gpq-col--act">

            @* Actividad como CHAT: comentarios + adjuntos inline (burbujas dos tonos), @menciones y adjuntar con caption. *@
            <div class="gpq-card gpq-card--chat">
                <div class="gpq-card-eyebrow">ACTIVIDAD</div>
                <div class="gpqc-wrap">
                    @{ var timeline = ActTimeline(); }
                    <div class="gpqc-scroll">
                        @if (timeline.Count == 0)
                        {
                            <div class="gpqc-empty">Aun no hay actividad. Escribe un comentario o adjunta un archivo.</div>
                        }
                        else
                        {
                            @foreach (var it in timeline)
                            {
                                @if (it.EsSepDia)
                                {
                                    <div class="gpqc-daysep"><span>@it.SepTexto</span></div>
                                }
                                else
                                {
                                    var nombre = string.IsNullOrWhiteSpace(it.Autor) ? (it.EsMio ? "Tu" : "Usuario") : it.Autor;
                                    <div class="gpqc-msg @(it.EsMio ? "mine" : "")">
                                        <div class="gpqc-ava">@Iniciales(nombre)</div>
                                        <div class="gpqc-col">
                                            <div class="gpqc-meta"><span class="gpqc-au">@nombre</span><span class="gpqc-dt">@FechaSoloHora(it.Fecha)</span></div>
                                            <div class="gpqc-bubble @(it.Adj is not null ? "has-file" : "")">
                                                @if (it.Adj is PqrsdAdjuntoDto adj)
                                                {
                                                    @if (EsImg(adj.UrlStorage))
                                                    {
                                                        <div class="gpqc-img" @onclick="() => _lightbox = adj.UrlStorage" title="Clic para ampliar">
                                                            <img src="@adj.UrlStorage" alt="@adj.NombreArchivo" />
                                                        </div>
                                                    }
                                                    else if (EsPdf(adj.UrlStorage))
                                                    {
                                                        <a class="gpqc-pdf" href="@adj.UrlStorage" target="_blank" title="Abrir @adj.NombreArchivo">
                                                            <iframe class="gpqc-pdf-fr" src="@(adj.UrlStorage + "#toolbar=0&navpanes=0&view=FitH")" tabindex="-1" loading="lazy"></iframe>
                                                            <span class="gpqc-pdf-hint">Abrir</span>
                                                        </a>
                                                    }
                                                    <a class="gpqc-file" href="@adj.UrlStorage" target="_blank" title="@adj.NombreArchivo">
                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/></svg>
                                                        <span class="gpqc-fnm">@adj.NombreArchivo</span>
                                                    </a>
                                                    @if (!string.IsNullOrWhiteSpace(adj.Texto))
                                                    {
                                                        <div class="gpqc-tx gpqc-cap">@adj.Texto</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="gpqc-tx">@it.Texto</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                    <div class="gpqc-composerwrap">
                        @if (_mencionQuery is not null && _mencionMatches.Count > 0)
                        {
                            <div class="gpqc-menc-pop">
                                @foreach (var p in _mencionMatches)
                                {
                                    var per = p;
                                    <button type="button" class="gpqc-menc-it" @onclick="() => InsertarMencion(per)">
                                        <span class="gpqc-menc-ava">@Iniciales(per.Nombre)</span>
                                        <span class="gpqc-menc-nm">@per.Nombre</span>
                                    </button>
                                }
                            </div>
                        }
                        @if (_pendingFileName is not null)
                        {
                            <div class="gpqc-pend">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/></svg>
                                <span class="gpqc-pend-nm">@_pendingFileName</span>
                                <button type="button" class="gpqc-pend-x" @onclick="QuitarArchivoPendiente" title="Quitar archivo"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                            </div>
                        }
                        <div class="gpqc-composer">
                            <label class="gpqc-clip" title="Adjuntar archivo">
                                @if (_subiendo) { <span class="gpqc-clip-load">...</span> }
                                else { <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 0 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"/></svg> }
                                <InputFile OnChange="SeleccionarArchivo" style="display:none" />
                            </label>
                            <textarea class="gpqc-input2" rows="1" @bind="_nuevoComentario" @bind:event="oninput" @bind:after="DetectarMencion" placeholder="@(_pendingFileName is null ? "Escribe un comentario o @menciona..." : "Anade un comentario (opcional)...")"></textarea>
                            <button class="gpqc-send" @onclick="EnviarMensaje" disabled="@(_reportando || _subiendo || (_pendingFile is null && string.IsNullOrWhiteSpace(_nuevoComentario)))" title="Enviar">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* Respuesta admin si existe *@
            @if (!string.IsNullOrEmpty(_detalle.RespuestaAdmin))
            {
                <div class="gpq-card gpq-card--resp">
                    <div class="gpq-card-eyebrow">RESPUESTA ADMINISTRADOR</div>
                    <div class="gpq-desc">@_detalle.RespuestaAdmin</div>
                    @if (_detalle.RespuestaAdminAt.HasValue)
                    {
                        <div class="gpq-meta">Respondida @_detalle.RespuestaAdminAt.Value.ToString("dd MMM yyyy HH:mm")</div>
                    }
                </div>
            }

            @* Inconformidad si existe *@
            @if (!string.IsNullOrEmpty(_detalle.InconformidadTexto))
            {
                <div class="gpq-card gpq-card--inc">
                    <div class="gpq-card-eyebrow">INCONFORMIDAD MANIFESTADA</div>
                    <div class="gpq-desc">@_detalle.InconformidadTexto</div>
                    @if (_detalle.InconformidadAt.HasValue)
                    {
                        <div class="gpq-meta">@_detalle.InconformidadAt.Value.ToString("dd MMM yyyy HH:mm")</div>
                    }
                </div>
            }

            @* Respuesta definitiva si existe *@
            @if (!string.IsNullOrEmpty(_detalle.RespuestaDefinitiva))
            {
                <div class="gpq-card gpq-card--def">
                    <div class="gpq-card-eyebrow">RESPUESTA DEFINITIVA</div>
                    <div class="gpq-desc">@_detalle.RespuestaDefinitiva</div>
                    @if (_detalle.RespuestaDefinitivaAt.HasValue)
                    {
                        <div class="gpq-meta">@_detalle.RespuestaDefinitivaAt.Value.ToString("dd MMM yyyy HH:mm")</div>
                    }
                </div>
            }

            </div>@* fin col 3 *@
            </div>@* fin gpq-cols *@

            @* === ACCIONES segun estado === *@
            <div class="gpq-acciones">
                @if (_detalle.Estado == EstadoPqrsd.Recibida)
                {
                    <button class="gpq-btn-brand" type="button" @onclick="@(() => SetAccion("tomar"))">Tomar expediente</button>
                }
                @if (_detalle.Estado == EstadoPqrsd.EnGestion)
                {
                    <button class="gpq-btn-brand" type="button" @onclick="@(() => SetAccion("responder"))">Responder</button>
                }
                @if (_detalle.Estado == EstadoPqrsd.Respondida)
                {
                    <button class="gpq-btn-brand" type="button" @onclick="@(() => SetAccion("cerrar"))">Cerrar definitivamente</button>
                    <button class="gpq-btn-ghost" type="button" @onclick="@(() => SetAccion("inconformidad"))">Registrar inconformidad</button>
                }
            </div>

            @* === FORM accion seleccionada === *@
            @if (_accion is not null)
            {
                <div class="gpq-form">
                    @switch (_accion)
                    {
                        case "tomar":
                            <div class="gpq-form-title">Tomar expediente</div>
                            <input class="gpq-input" @bind="_textoAccion" @bind:event="oninput" placeholder="Nota (opcional)" />
                            <div class="gpq-form-foot">
                                <button class="gpq-btn-ghost" type="button" @onclick="CancelarAccion">Cancelar</button>
                                <button class="gpq-btn-brand" type="button" @onclick="EjecutarTomar" disabled="@_busy">Confirmar</button>
                            </div>
                            break;
                        case "responder":
                            <div class="gpq-form-title">Responder al expediente</div>
                            <textarea class="gpq-input" rows="4" @bind="_textoAccion" @bind:event="oninput" placeholder="Respuesta detallada *"></textarea>
                            <div class="gpq-form-foot">
                                <button class="gpq-btn-ghost" type="button" @onclick="CancelarAccion">Cancelar</button>
                                <button class="gpq-btn-brand" type="button" @onclick="EjecutarResponder" disabled="@(_busy || string.IsNullOrWhiteSpace(_textoAccion))">Enviar respuesta</button>
                            </div>
                            break;
                        case "cerrar":
                            <div class="gpq-form-title">Cerrar definitivamente</div>
                            <label class="gpq-form-lbl">Motivo de cierre *</label>
                            <select class="gpq-input" @bind="_motivoCierreId">
                                <option value="">Elige un motivo...</option>
                                @foreach (var m in _motivos)
                                {
                                    <option value="@m.Id">@m.Nombre (@ClasifTexto(m.Clasificacion))</option>
                                }
                            </select>
                            <textarea class="gpq-input" rows="4" @bind="_textoAccion" @bind:event="oninput" placeholder="Respuesta definitiva *"></textarea>
                            <div class="gpq-form-foot">
                                <button class="gpq-btn-ghost" type="button" @onclick="CancelarAccion">Cancelar</button>
                                <button class="gpq-btn-brand" type="button" @onclick="EjecutarCerrar" disabled="@(_busy || string.IsNullOrWhiteSpace(_textoAccion) || string.IsNullOrEmpty(_motivoCierreId))">Cerrar expediente</button>
                            </div>
                            <p class="gpq-form-hint">Al cerrar, el expediente pasa a la pestana "Cerrados" y desaparece del tablero activo.</p>
                            break;
                        case "inconformidad":
                            <div class="gpq-form-title">Registrar inconformidad</div>
                            <textarea class="gpq-input" rows="3" @bind="_textoAccion" @bind:event="oninput" placeholder="Texto de inconformidad *"></textarea>
                            <div class="gpq-form-foot">
                                <button class="gpq-btn-ghost" type="button" @onclick="CancelarAccion">Cancelar</button>
                                <button class="gpq-btn-brand" type="button" @onclick="EjecutarInconformidad" disabled="@(_busy || string.IsNullOrWhiteSpace(_textoAccion))">Registrar</button>
                            </div>
                            break;
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="gpq-msg @(_msgError ? "gpq-msg--err" : "gpq-msg--ok")">@_msg</div>
            }
        }
    </div>

    @* ===== Tab Responder ===== *@
    <div class="gpq-pane" style="@(_detalle is not null && _tab == "responder" ? "" : "display:none")">
        @if (_detalle is not null)
        {
            <div class="gpq-card">
                <div class="gpq-card-eyebrow">RESPONDER AL SOLICITANTE</div>
                <label class="gpq-mini-lbl">Respuesta *</label>
                <textarea class="gpq-input" rows="6" @bind="_respTexto" @bind:event="oninput" placeholder="Escribe la respuesta oficial al solicitante (minimo 20 caracteres)."></textarea>

                <label class="gpq-mini-lbl" style="margin-top:12px;">Canal de respuesta</label>
                <div class="gpq-resp-canales">
                    <label class="gpq-resp-chk"><input type="checkbox" @bind="_respCorreo" /><span>Correo@(string.IsNullOrEmpty(RadicadorEmail) ? " (el solicitante no tiene correo)" : $": {RadicadorEmail}")</span></label>
                    <label class="gpq-resp-chk"><input type="checkbox" @bind="_respCelular" /><span>Celular@(string.IsNullOrEmpty(RadicadorTel) ? " (el solicitante no tiene telefono)" : $": {RadicadorTel}")</span></label>
                </div>
                <div class="gpq-mini-hint">Marca correo, celular o ambos. La respuesta se envia al solicitante y queda registrada en el expediente.</div>

                <button class="gpq-btn-brand" style="margin-top:12px;" type="button" @onclick="EnviarRespuestaTab"
                        disabled="@(_respBusy || _respTexto.Trim().Length < 20 || (!_respCorreo && !_respCelular))">
                    @(_respBusy ? "Enviando..." : "Enviar respuesta")
                </button>
                @if (!string.IsNullOrEmpty(_respMsg)) { <div class="gpq-msg @(_respErr ? "gpq-msg--err" : "gpq-msg--ok")" style="margin-top:10px;">@_respMsg</div> }

                @if (!string.IsNullOrEmpty(_detalle.RespuestaAdmin))
                {
                    <div class="gpq-card gpq-card--resp" style="margin-top:16px;">
                        <div class="gpq-card-eyebrow">ULTIMA RESPUESTA REGISTRADA</div>
                        <div class="gpq-desc">@_detalle.RespuestaAdmin</div>
                        @if (_detalle.RespuestaAdminAt.HasValue) { <div class="gpq-meta">@_detalle.RespuestaAdminAt.Value.ToString("dd MMM yyyy HH:mm")</div> }
                    </div>
                }
            </div>
        }
    </div>

    @* ===== Tabs Adjuntos + Historial ===== *@
    <div class="gpq-pane" style="@(_detalle is not null && (_tab == "historial" || _tab == "adjuntos") ? "" : "display:none")">
        @if (_detalle is not null)
        {
            <div class="gpq-card" style="@(_tab == "historial" ? "" : "display:none")">
                <div class="gpq-card-eyebrow">HISTORIAL</div>
                @if (_detalle.Historial.Count == 0)
                {
                    <div class="gpq-empty">Sin eventos.</div>
                }
                else
                {
                    <div class="gpq-timeline">
                        @foreach (var h in _detalle.Historial.OrderByDescending(x => x.CreatedAt))
                        {
                            <div class="gpq-tl-item">
                                <div class="gpq-tl-dot @EstadoClass(h.EstadoNuevo)"></div>
                                <div class="gpq-tl-content">
                                    <div class="gpq-tl-title">
                                        @if (h.EstadoAnterior.HasValue)
                                        {
                                            <span>@EstadoLabel(h.EstadoAnterior.Value) → @EstadoLabel(h.EstadoNuevo)</span>
                                        }
                                        else
                                        {
                                            <span>@EstadoLabel(h.EstadoNuevo)</span>
                                        }
                                    </div>
                                    <div class="gpq-tl-meta">
                                        @h.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                        <span> · @h.Origen</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(h.Nota))
                                    {
                                        <div class="gpq-tl-nota">@h.Nota</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="gpq-card" style="@(_tab == "adjuntos" ? "" : "display:none")">
                <div class="gpq-card-eyebrow">ADJUNTOS (@_detalle.Adjuntos.Count)</div>
                @{ var selAdj = _detalle.Adjuntos.FirstOrDefault(x => x.Id == _adjSel) ?? _detalle.Adjuntos.FirstOrDefault(); }
                <div class="gpq-files">
                    @* Columna izquierda: lista de miniaturas + boton "Subir archivo" (estilo Tareas) *@
                    <div class="gpq-thumbs">
                        @foreach (var a in _detalle.Adjuntos)
                        {
                            var aa = a;
                            var hayImg = EsImagen(a.TipoMime, a.NombreArchivo) && !string.IsNullOrEmpty(a.UrlStorage) && !a.UrlStorage.StartsWith("/pendiente");
                            var titAdj = string.IsNullOrWhiteSpace(a.SubidoPorNombre) ? a.NombreArchivo : $"{a.NombreArchivo} - subido por {a.SubidoPorNombre}";
                            <div class="gpq-thumb @(selAdj is not null && selAdj.Id == a.Id ? "on" : "")" @onclick="@(() => _adjSel = aa.Id)" title="@titAdj">
                                <div class="gpq-thumb-ic @ThumbClass(a.TipoMime, a.NombreArchivo)">
                                    @if (hayImg) { <img src="@a.UrlStorage" alt="@a.NombreArchivo" /> }
                                    else { <span class="gpq-thumb-ext">@Extension(a.NombreArchivo)</span> }
                                </div>
                                <div class="gpq-thumb-meta">
                                    <span class="gpq-thumb-nm">@a.NombreArchivo</span>
                                    <span class="gpq-thumb-sz">@FormatSize(a.TamanioBytes)@(string.IsNullOrWhiteSpace(a.SubidoPorNombre) ? "" : " - " + a.SubidoPorNombre)</span>
                                </div>
                            </div>
                        }
                        <label class="gpq-thumb-up @(_subiendo ? "gpq-thumb-up--busy" : "")">
                            @if (_subiendo)
                            {
                                <span class="gpq-thumb-up-t">Subiendo @_subiendoNombre...</span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
                                <span class="gpq-thumb-up-t">Subir archivo</span>
                            }
                            <InputFile OnChange="OnArchivosSeleccionados" multiple style="display:none" />
                        </label>
                    </div>
                    @* Columna derecha: visor grande del adjunto seleccionado *@
                    <div class="gpq-viewer">
                        @if (selAdj is null)
                        {
                            <div class="gpq-viewer-empty">
                                <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M21 15l-5-5L5 21M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="8.5" cy="8.5" r="1.5"/></svg>
                                <p>Sin archivos adjuntos.</p>
                                <span>Sube imagenes o documentos con el boton "Subir archivo".</span>
                            </div>
                        }
                        else if (string.IsNullOrEmpty(selAdj.UrlStorage) || selAdj.UrlStorage.StartsWith("/pendiente"))
                        {
                            <div class="gpq-viewer-file">
                                <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h4"/></svg>
                                <p class="gpq-viewer-nm">@selAdj.NombreArchivo</p>
                                <p class="gpq-viewer-by">Archivo registrado sin contenido subido todavia.</p>
                            </div>
                        }
                        else if (EsImagen(selAdj.TipoMime, selAdj.NombreArchivo))
                        {
                            <div class="gpq-viewer-imgwrap" @onclick="@(() => _lightbox = selAdj.UrlStorage)" title="Clic para ampliar">
                                <img class="gpq-viewer-img" src="@selAdj.UrlStorage" alt="@selAdj.NombreArchivo" />
                                <span class="gpq-viewer-zoom"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg> Ampliar</span>
                            </div>
                            <div class="gpq-viewer-bar">
                                <div class="gpq-viewer-meta">
                                    <span class="gpq-viewer-nm">@selAdj.NombreArchivo</span>
                                    <span class="gpq-viewer-by">@FormatSize(selAdj.TamanioBytes)@(string.IsNullOrWhiteSpace(selAdj.SubidoPorNombre) ? "" : " - subido por " + selAdj.SubidoPorNombre)</span>
                                </div>
                                <a class="gpq-viewer-open" href="@selAdj.UrlStorage" target="_blank" rel="noopener">Abrir</a>
                            </div>
                        }
                        else if (EsPdf(selAdj.TipoMime, selAdj.NombreArchivo))
                        {
                            <div class="gpq-viewer-pdfwrap">
                                <iframe class="gpq-viewer-pdf" src="@selAdj.UrlStorage" title="@selAdj.NombreArchivo"></iframe>
                            </div>
                            <div class="gpq-viewer-bar">
                                <div class="gpq-viewer-meta">
                                    <span class="gpq-viewer-nm">@selAdj.NombreArchivo</span>
                                    <span class="gpq-viewer-by">@FormatSize(selAdj.TamanioBytes)</span>
                                </div>
                                <a class="gpq-viewer-open" href="@selAdj.UrlStorage" target="_blank" rel="noopener">Abrir en pestana</a>
                            </div>
                        }
                        else
                        {
                            <div class="gpq-viewer-file">
                                <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h4"/></svg>
                                <p class="gpq-viewer-nm">@selAdj.NombreArchivo</p>
                                <p class="gpq-viewer-by">@FormatSize(selAdj.TamanioBytes) - @selAdj.TipoMime</p>
                                <a class="gpq-viewer-open" href="@selAdj.UrlStorage" target="_blank" rel="noopener">Abrir / descargar</a>
                            </div>
                        }
                    </div>
                </div>

                @* Fallback: registrar metadata de un archivo por URL (link a Drive, R2, etc.). *@
                <details class="gpq-adj-url">
                    <summary>Agregar por URL (link a Drive, R2, etc.)</summary>
                    <div class="gpq-adj-add">
                        <input class="gpq-input" @bind="_nuevoAdjNombre" @bind:event="oninput" placeholder="Nombre del archivo (ej. evidencia.pdf)" />
                        <input class="gpq-input" @bind="_nuevoAdjUrl" @bind:event="oninput" placeholder="URL o ruta" />
                        <button class="gpq-btn-brand" type="button" @onclick="AgregarAdjunto" disabled="@(string.IsNullOrWhiteSpace(_nuevoAdjNombre))">
                            Agregar
                        </button>
                    </div>
                </details>
            </div>
        }
    </div>

    @* ===== Tab Tareas (enlazadas al PQR, tablero "PQRSD" del modulo Tareas) ===== *@
    <div class="gpq-pane" style="@(_detalle is not null && _tab == "tareas" ? "" : "display:none")">
        <div class="gpq-tk-new">
            <input class="gpq-input" placeholder="Nueva tarea para este PQR..." @bind="_nuevaTareaTitulo" @bind:event="oninput"
                   @onkeydown='@(async (e) => { if (e.Key == "Enter") await CrearPqrTareaAsync(); })' />
            @* Solo se puede asignar a usuarios ACTIVOS del modulo Usuarios (no a cualquier persona del directorio). *@
            <select class="gpq-input gpq-tk-asig" @bind="_nuevaTareaAsignado">
                <option value="">Sin asignar</option>
                @foreach (var u in _pqrUsuarios) { <option value="@u.PersonaId">@u.NombreCompleto</option> }
            </select>
            @* Crea la tarea y se queda AQUI (sin salir del modulo PQRSD); la tarjeta aparece abajo. *@
            <button class="gpq-btn-brand" type="button" @onclick="CrearPqrTareaAsync" disabled="@(_pqrBusy || string.IsNullOrWhiteSpace(_nuevaTareaTitulo))">
                + Agregar tarea
            </button>
            <div class="gpq-tk-vsw" role="tablist" aria-label="Vista de tareas">
                <button type="button" class="gpq-tk-vbtn @(_pqrVista == "tarjetas" ? "on" : "")" @onclick='() => _pqrVista = "tarjetas"'>Tablero</button>
                <button type="button" class="gpq-tk-vbtn @(_pqrVista == "lista" ? "on" : "")" @onclick='() => _pqrVista = "lista"'>Lista</button>
            </div>
        </div>

        @if (_pqrTareas is null)
        {
            <div class="gpq-tk-empty">Cargando tareas...</div>
        }
        else
        {
            <div class="gpq-tk-prog">
                <div class="gpq-tk-prog-top"><span>Avance</span><span class="gpq-tk-prog-pct">@_pqrTareas.Porcentaje%</span></div>
                <div class="gpq-tk-prog-bar"><div class="gpq-tk-prog-fill" style="width:@(_pqrTareas.Porcentaje)%"></div></div>
                <div class="gpq-tk-prog-sub">@_pqrTareas.Tareas.Count(t => t.EstadoEsTerminal) de @_pqrTareas.Tareas.Count completadas</div>
            </div>

            @if (_pqrTareas.Tareas.Count == 0)
            {
                <div class="gpq-tk-empty">Aun no hay tareas. Crea la primera arriba.</div>
            }
            else if (_pqrVista == "lista")
            {
                @* ---- Vista LISTA: tabla plana con el codigo como primer elemento ---- *@
                <div class="gpq-tk-table">
                    <div class="gpq-tk-tr gpq-tk-thead">
                        <span>CODIGO</span><span>TITULO</span><span>ETAPA</span><span>ASIGNADO</span><span>VENCE</span><span>%</span><span></span>
                    </div>
                    @foreach (var t in _pqrTareas.Tareas)
                    {
                        var tt = t;
                        <div class="gpq-tk-tr">
                            <span class="gpq-tk-num">@t.NumeroTarea</span>
                            <span class="gpq-tk-td-tit">@t.Titulo</span>
                            <span><span class="gpq-tk-etpill" style="background:@(t.EstadoColor ?? "#94A3B8")">@t.EstadoNombre</span></span>
                            <span class="gpq-tk-td-asig">
                                @if (!string.IsNullOrWhiteSpace(t.AsignadoNombre)) { <span class="gpq-tk-ava">@IniPqr(t.AsignadoNombre)</span> @t.AsignadoNombre }
                                else { <span class="gpq-tk-mut">Sin asignar</span> }
                            </span>
                            <span class="@(TareaVencida(t) ? "gpq-tk-venc" : "")">@(t.FechaVencimiento?.ToString("dd MMM") ?? "-")</span>
                            <span class="gpq-tk-td-pct">@t.Progreso%</span>
                            <button type="button" class="gpq-tk-exp" title="Abrir el modal completo en Tareas" @onclick="() => AbrirTareaCompleta(tt.Id)">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                @* ---- Vista TABLERO: mini-Kanban con tarjetas ricas (estilo modulo Tareas) ---- *@
                <div class="gpq-tk-kanban">
                    @foreach (var et in _pqrTareas.Etapas)
                    {
                        var enEt = _pqrTareas.Tareas.Where(t => t.EstadoId == et.Id).ToList();
                        <div class="gpq-tk-col">
                            <div class="gpq-tk-col-h">
                                <span class="gpq-tk-dot" style="background:@(et.Color ?? "#94A3B8")"></span>
                                <span class="gpq-tk-col-t">@et.Nombre</span>
                                <span class="gpq-tk-col-n">@enEt.Count</span>
                            </div>
                            <div class="gpq-tk-col-body">
                                @foreach (var t in enEt)
                                {
                                    var tt = t;
                                    <div class="gpq-tk-card" style="border-left:3px solid @(et.Color ?? "#94A3B8")">
                                        <div class="gpq-tk-card-top">
                                            <span class="gpq-tk-num">@t.NumeroTarea</span>
                                            <button type="button" class="gpq-tk-exp" title="Abrir el modal completo en Tareas" @onclick="() => AbrirTareaCompleta(tt.Id)">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                            </button>
                                        </div>
                                        <div class="gpq-tk-card-t">@t.Titulo</div>
                                        <div class="gpq-tk-card-m">
                                            <span class="gpq-tk-prio" style="color:@PrioPqrFg(t.Prioridad);background:@PrioPqrBg(t.Prioridad)">@t.Prioridad</span>
                                            @if (t.FechaVencimiento is not null)
                                            {
                                                <span class="gpq-tk-due @(TareaVencida(t) ? "gpq-tk-venc" : "")">@t.FechaVencimiento?.ToString("dd MMM")</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(t.AsignadoNombre))
                                        {
                                            <div class="gpq-tk-card-asig"><span class="gpq-tk-ava">@IniPqr(t.AsignadoNombre)</span><span class="gpq-tk-asig-n">@t.AsignadoNombre</span></div>
                                        }
                                        <div class="gpq-tk-card-prog">
                                            <div class="gpq-tk-cprog-bar"><div class="gpq-tk-cprog-fill" style="width:@(t.Progreso)%;background:@(t.Progreso >= 100 ? "#1A8754" : "#6D4FE3")"></div></div>
                                            <span class="gpq-tk-cprog-v">@t.Progreso%</span>
                                        </div>
                                    </div>
                                }
                                @if (enEt.Count == 0) { <div class="gpq-tk-col-empty">-</div> }
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="gpq-tk-foot">Las tareas se gestionan en el modulo <strong>Tareas</strong> (tablero "PQRSD"); el expander abre alli su modal completo.</div>
        }
    </div>
</div>
</div>

@* Lightbox de imagen del chat (clic en una imagen del feed la abre a pantalla completa) *@
@if (_lightbox is not null)
{
    <div class="gpqc-lb" @onclick="() => _lightbox = null">
        <img class="gpqc-lb-img" src="@_lightbox" @onclick:stopPropagation="true" alt="Adjunto" />
        <button type="button" class="gpqc-lb-x" @onclick="() => _lightbox = null" aria-label="Cerrar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
    </div>
}

<style>
    .gpq-modal {
