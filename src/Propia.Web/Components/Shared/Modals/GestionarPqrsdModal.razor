    .gpq-tab.active { color: var(--propia-brand, #6D4FE3); border-bottom-color: var(--propia-brand, #6D4FE3); }
    /* ---- Tab Tareas del PQR ---- */
    .gpq-tk-new { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .gpq-tk-new .gpq-input { flex: 1 1 220px; min-width: 160px; }
    .gpq-tk-asig { flex: 0 1 190px; cursor: pointer; }
    .gpq-tk-empty { text-align: center; color: #94A3B8; font-size: 13px; padding: 22px; background: #F8FAFC; border: 1px dashed #DCE4EC; border-radius: 12px; }
    .gpq-tk-prog { margin-bottom: 16px; }
    .gpq-tk-prog-top { display: flex; justify-content: space-between; align-items: baseline; font-size: 12px; font-weight: 700; color: #64748B; }
    .gpq-tk-prog-pct { font-size: 18px; font-weight: 800; color: #22C55E; }
    .gpq-tk-prog-bar { height: 9px; background: #EEF3F8; border-radius: 20px; overflow: hidden; margin: 6px 0 4px; }
    .gpq-tk-prog-fill { height: 100%; background: linear-gradient(90deg, #34C77B, #22C55E); border-radius: 20px; transition: width .3s; }
    .gpq-tk-prog-sub { font-size: 11.5px; color: #94A3B8; }
    .gpq-tk-kanban { display: flex; gap: 11px; overflow-x: auto; align-items: flex-start; padding-bottom: 6px; }
    .gpq-tk-col { flex: 0 0 210px; background: #F7F9FC; border: 1px solid #EDF1F6; border-radius: 12px; padding: 8px; }
    .gpq-tk-col-h { display: flex; align-items: center; gap: 6px; padding: 5px 6px 8px; }
    .gpq-tk-dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
    .gpq-tk-col-t { font-size: 12px; font-weight: 800; color: #33414F; flex: 1; }
    .gpq-tk-col-n { font-size: 10.5px; font-weight: 800; color: #7C8A9C; background: #E9EEF4; border-radius: 20px; padding: 1px 7px; }
    .gpq-tk-col-body { display: flex; flex-direction: column; gap: 7px; min-height: 40px; }
    .gpq-tk-card { background: #fff; border: 1px solid #E9EEF3; border-radius: 10px; padding: 9px 10px; box-shadow: 0 1px 2px rgba(45,62,80,.05); }
    .gpq-tk-card-t { font-size: 12.5px; font-weight: 600; color: #26303C; }
    .gpq-tk-card-m { display: flex; align-items: center; gap: 7px; margin-top: 5px; flex-wrap: wrap; }
    /* ---- Tarjetas ricas (estilo modulo Tareas) + expander + vista lista ---- */
    .gpq-tk-vsw { display: flex; gap: 0; border: 1px solid #E1E8EE; border-radius: 9px; overflow: hidden; margin-left: auto; }
    .gpq-tk-vbtn { border: 0; background: #fff; color: #607286; font-size: 12px; font-weight: 700; padding: 7px 14px; cursor: pointer; }
    .gpq-tk-vbtn.on { background: #6D4FE3; color: #fff; }
    .gpq-tk-card-top { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 3px; }
    .gpq-tk-exp { border: 0; background: #F1ECFD; color: #6D4FE3; width: 22px; height: 22px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex: 0 0 auto; }
    .gpq-tk-exp:hover { background: #E4DBFB; }
    .gpq-tk-prio { font-size: 10px; font-weight: 800; border-radius: 20px; padding: 2px 8px; }
    .gpq-tk-due { font-size: 10.5px; font-weight: 700; color: #607286; }
    .gpq-tk-venc { color: #C81E1E; }
    .gpq-tk-card-asig { display: flex; align-items: center; gap: 6px; margin-top: 6px; min-width: 0; }
    .gpq-tk-ava { width: 20px; height: 20px; flex: 0 0 20px; border-radius: 50%; background: #6D4FE3; color: #fff; font-size: 9px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; }
    .gpq-tk-asig-n { font-size: 11px; color: #33414F; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .gpq-tk-card-prog { display: flex; align-items: center; gap: 6px; margin-top: 7px; }
    .gpq-tk-cprog-bar { flex: 1; height: 5px; border-radius: 4px; background: #EEF3F8; overflow: hidden; }
    .gpq-tk-cprog-fill { height: 100%; border-radius: 4px; }
    .gpq-tk-cprog-v { font-size: 10px; font-weight: 800; color: #607286; }
    .gpq-tk-table { border: 1px solid #E9EEF3; border-radius: 12px; overflow: hidden; }
    .gpq-tk-tr { display: grid; grid-template-columns: 92px 1.6fr 120px 1.1fr 74px 44px 34px; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid #F1F4F8; font-size: 12px; color: #33414F; }
    .gpq-tk-tr:last-child { border-bottom: 0; }
    .gpq-tk-thead { background: #F7F9FC; font-size: 10px; font-weight: 800; letter-spacing: .03em; color: #7C8A9C; }
    .gpq-tk-td-tit { font-weight: 600; color: #26303C; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .gpq-tk-etpill { color: #fff; font-size: 10px; font-weight: 800; border-radius: 20px; padding: 2px 9px; white-space: nowrap; }
    .gpq-tk-td-asig { display: flex; align-items: center; gap: 6px; min-width: 0; overflow: hidden; }
    .gpq-tk-td-pct { font-weight: 800; color: #607286; }
    .gpq-tk-mut { color: #A5B2C1; font-style: italic; }
    .gpq-tk-num { font-size: 10.5px; font-weight: 700; color: #A6B2C1; }
    .gpq-tk-asig-b { font-size: 10.5px; font-weight: 700; color: #5838C9; background: #F1ECFD; border-radius: 20px; padding: 1px 8px; }
    .gpq-tk-col-empty { color: #C3CEDA; font-size: 11px; text-align: center; padding: 8px; }
    .gpq-tk-foot { margin-top: 14px; font-size: 11.5px; color: #94A3B8; }
    .gpq-pane { width: 100%; padding: 20px 24px; overflow-y: auto; flex: 1 1 auto; min-height: 0; }
    .gpq-close {
        width: 34px; height: 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        color: #7C98B6; border: 1px solid #E1E8EE; background: #fff; cursor: pointer;
    }
    .gpq-close:hover { background: #F5F8FA; color: #33475B; }

    .gpq-estado-pill {
        font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 6px;
    }
    .gpq-estado-recibida { color: var(--propia-brand, #6D4FE3); background: var(--propia-brand-soft, #F1ECFD); }
    .gpq-estado-engestion { color: #1E40AF; background: #DBEAFE; }
    .gpq-estado-respondida { color: #B45309; background: #FEF3C7; }
    .gpq-estado-cerrada { color: #15703F; background: #E6F6EE; }
    .gpq-estado-via { color: #fff; background: #6B7280; }

    .gpq-sem { font-size: 10.5px; font-weight: 700; padding: 3px 8px; border-radius: 5px; }
    .gpq-sem--verde { color: #15703F; background: #E6F6EE; }
    .gpq-sem--amarillo { color: #B45309; background: #FEF3C7; }
    .gpq-sem--rojo { color: #B91C1C; background: #FEE2E2; }
    .gpq-sem--negro { color: #fff; background: #111827; }
    .gpq-sem--tutela { color: #fff; background: #DC2626; }

    .gpq-body {
        flex: 1; min-height: 0;
        display: flex; flex-direction: column; align-items: stretch;
        font-family: var(--propia-font-base, 'Lexend', sans-serif);
    }

    .gpq-loading { color: #A6B7C8; padding: 40px; text-align: center; }

    .gpq-flags { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 14px; }
    .gpq-flag {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 10px; border-radius: 7px;
        font-size: 12px; font-weight: 700;
    }
    .gpq-flag--tutela { color: #fff; background: #DC2626; }
    .gpq-flag--comite { color: var(--propia-brand, #6D4FE3); background: var(--propia-brand-soft, #F1ECFD); }

    .gpq-card {
        background: #fff; border: 1px solid #E1E8EE;
        border-radius: 12px; padding: 14px 16px;
        margin-bottom: 12px;
    }
    .gpq-card--resp { border-color: #FED7AA; background: #FFFBF0; }
    .gpq-card--inc { border-color: #FECACA; background: #FEF7F7; }
    .gpq-card--def { border-color: #B6E2C9; background: #F0FDF4; }
    .gpq-card-eyebrow {
        font-size: 10px; letter-spacing: .5px; color: #A6B7C8;
        font-weight: 700; margin-bottom: 8px;
    }

    .gpq-radicador-line { font-size: 14px; color: #33475B; }
    .gpq-radicador-unit { color: #7C98B6; font-weight: 600; }
    .gpq-reservada { font-size: 13px; color: #DC2626; font-weight: 700; }

    /* Card unidad afectada */
    .gpq-card--unit { background: linear-gradient(135deg, #FAF8FF, #F1ECFD); border-color: #DCD2F8; }
    .gpq-card--nounit { background: #F8FAFC; border-color: #E1E8EE; }
    .gpq-noref { font-size: 12.5px; color: #A6B7C8; font-style: italic; }
    .gpq-unit-head { display: flex; align-items: center; gap: 12px; }
    .gpq-unit-icon {
        width: 46px; height: 46px; border-radius: 12px;
        background: linear-gradient(140deg, #8366F0, #5838C9);
        color: #fff; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .gpq-unit-id { flex: 1; min-width: 0; }
    .gpq-unit-num { font-size: 17px; font-weight: 800; color: #1B2A3A; letter-spacing: -0.3px; }
    .gpq-unit-meta { font-size: 12px; color: #7C5CE8; font-weight: 600; margin-top: 2px; }

    /* Personas - contacto humano */
    .gpq-people { display: flex; flex-direction: column; gap: 9px; }
    .gpq-person {
        display: flex; align-items: flex-start; gap: 11px;
        padding: 11px 12px;
        border: 1px solid #E1E8EE; border-radius: 10px;
        background: #FBFBFD;
    }
    .gpq-person--radicador { border-color: #DCD2F8; background: #FAF8FF; }
    .gpq-person-avatar {
        width: 34px; height: 34px; border-radius: 9px;
        color: #fff; font-size: 12px; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .gpq-person-avatar--owner { background: linear-gradient(135deg, #33475B, #1B2A3A); }
    .gpq-person-avatar--resident { background: linear-gradient(135deg, #2563EB, #1E40AF); }
    .gpq-person-avatar--family { background: linear-gradient(135deg, #22A565, #15703F); }
    .gpq-person-avatar--tenant { background: linear-gradient(135deg, #D97706, #92400E); }
    .gpq-person-avatar--proxy { background: linear-gradient(135deg, #6B7280, #374151); }
    .gpq-person-avatar--other { background: linear-gradient(135deg, #7C5CE8, #5838C9); }
    .gpq-person-id { flex: 1; min-width: 0; }
    .gpq-person-name {
        font-size: 13.5px; font-weight: 700; color: #33475B;
        display: flex; align-items: center; gap: 7px; flex-wrap: wrap;
    }
    .gpq-radica-tag {
        font-size: 9.5px; font-weight: 700; color: var(--propia-brand, #6D4FE3);
        background: var(--propia-brand-soft, #F1ECFD);
        padding: 2px 6px; border-radius: 5px; letter-spacing: .3px;
    }
    .gpq-person-rol { font-size: 11px; color: #7C98B6; font-weight: 600; margin-top: 1px; }
    .gpq-person-link {
        display: flex; align-items: center; gap: 5px;
        font-size: 11px; color: #516F90; font-weight: 600;
        margin-top: 4px; text-decoration: none;
    }
    .gpq-person-link:hover { color: var(--propia-brand, #6D4FE3); text-decoration: underline; }

    /* Form agregar adjunto */
    /* Grid de adjuntos (miniaturas) - prototipo: 2 columnas con thumb arriba + nombre/size */
    /* ===== Visor de adjuntos estilo Tareas: lista de miniaturas (izq) + panel de vista previa (der) ===== */
    .gpq-files { display: flex; gap: 14px; margin-top: 4px; min-height: 340px; }
    .gpq-thumbs { width: 210px; flex-shrink: 0; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; max-height: 470px; padding-right: 3px; }
    .gpq-thumb { position: relative; display: flex; align-items: center; gap: 9px; border: 1px solid #E1E8EE; border-radius: 10px; padding: 7px 9px; background: #fff; cursor: pointer; }
    .gpq-thumb:hover { border-color: #B9AEF3; background: #FBFAFE; }
    .gpq-thumb.on { border-color: #6D4FE3; background: #F5F1FE; box-shadow: 0 0 0 1px #6D4FE3; }
    .gpq-thumb-ic { width: 44px; height: 44px; border-radius: 8px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; background: linear-gradient(135deg,#F5F1FE,#E6DEFA); }
    .gpq-thumb-ic img { width: 100%; height: 100%; object-fit: cover; }
    .gpq-thumb-ext { font-size: 12px; font-weight: 800; letter-spacing: .5px; color: #fff; }
    .gpq-thumb-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    .gpq-thumb-nm { font-size: 11.5px; font-weight: 700; color: #33475B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gpq-thumb-sz { font-size: 10px; font-weight: 600; color: #A6B7C8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gpq-viewer { flex: 1; min-width: 0; min-height: 340px; max-height: 60vh; border: 1px solid #E1E8EE; border-radius: 12px; background: #FAFBFD; display: flex; flex-direction: column; overflow: hidden; }
    .gpq-viewer-imgwrap { flex: 1; min-height: 0; position: relative; display: flex; align-items: center; justify-content: center; padding: 14px; background: #F1F5F9; overflow: auto; cursor: zoom-in; }
    .gpq-viewer-img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 6px; box-shadow: 0 4px 16px rgba(27,42,58,.15); }
    .gpq-viewer-zoom { position: absolute; right: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 800; color: #fff; background: rgba(27,42,58,.72); border-radius: 20px; padding: 5px 11px; pointer-events: none; }
    .gpq-viewer-pdfwrap { flex: 1; min-height: 440px; display: flex; background: #525659; }
    .gpq-viewer-pdf { flex: 1; width: 100%; height: 100%; min-height: 440px; border: 0; }
    .gpq-viewer-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 14px; border-top: 1px solid #EEF3F8; background: #fff; }
    .gpq-viewer-meta { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
    .gpq-viewer-nm { font-size: 12px; font-weight: 700; color: #33475B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gpq-viewer-by { font-size: 10.5px; font-weight: 700; color: #7C98B6; }
    .gpq-viewer-open { font-size: 11.5px; font-weight: 700; color: #6D4FE3; text-decoration: none; border: 1px solid #DCD2F8; border-radius: 8px; padding: 6px 13px; background: #F1ECFD; flex-shrink: 0; }
    .gpq-viewer-open:hover { background: #E6DEFA; }
    .gpq-viewer-empty, .gpq-viewer-file { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; color: #A6B7C8; text-align: center; padding: 24px; }
    .gpq-viewer-empty p, .gpq-viewer-file p { font-size: 13.5px; font-weight: 700; color: #516F90; margin: 0; max-width: 320px; word-break: break-word; }
    .gpq-viewer-empty span { font-size: 11.5px; color: #A6B7C8; max-width: 300px; }
    .gpq-viewer-file { color: #6D4FE3; }
    .gpq-viewer-file .gpq-viewer-open { margin-top: 6px; }
    /* gradientes por tipo del icono de miniatura (ThumbClass) */
    .gpq-adj-thumb--img { background: linear-gradient(135deg, #60A5FA, #3B82F6); }
    .gpq-adj-thumb--pdf { background: linear-gradient(135deg, #F87171, #EF4444); }
    .gpq-adj-thumb--doc { background: linear-gradient(135deg, #60A5FA, #2563EB); }
    .gpq-adj-thumb--xls { background: linear-gradient(135deg, #34D399, #10B981); }
    .gpq-adj-thumb--generic { background: linear-gradient(135deg, #94A3B8, #64748B); }
    @@media (max-width: 760px) {
        .gpq-files { flex-direction: column; min-height: 0; }
        .gpq-thumbs { width: auto; flex-direction: row; flex-wrap: wrap; max-height: none; }
        .gpq-thumb { flex: 1 1 160px; }
        .gpq-viewer { min-height: 300px; }
    }

    /* Boton "Subir archivo" al final de la lista de miniaturas (estilo Tareas .tbc-thumb-up) */
    .gpq-thumb-up { display: flex; align-items: center; justify-content: center; gap: 7px; border: 1px dashed #D7E0EA; border-radius: 10px; padding: 12px; cursor: pointer; font-size: 11.5px; font-weight: 700; color: #6D4FE3; background: #FBFAFE; flex-shrink: 0; }
    .gpq-thumb-up:hover { border-color: #6D4FE3; background: #F5F1FE; }
    .gpq-thumb-up--busy { opacity: .7; pointer-events: none; }
    .gpq-thumb-up-t { font-size: 11.5px; }

    .gpq-adj-url { margin-top: 10px; }
    .gpq-adj-url summary { font-size: 11.5px; color: #7C98B6; cursor: pointer; font-weight: 600; padding: 4px 0; }
    .gpq-adj-url summary:hover { color: var(--propia-brand, #6D4FE3); }

    .gpq-adj-add {
        display: flex; gap: 6px; margin-top: 10px;
        padding-top: 10px; border-top: 1px dashed #E1E8EE;
    }
    .gpq-adj-add .gpq-input { margin-bottom: 0; padding: 7px 10px; font-size: 12px; }
    .gpq-adj-add .gpq-btn-brand {
        padding: 7px 12px; font-size: 12px; white-space: nowrap;
        display: inline-flex; align-items: center; gap: 5px;
    }

