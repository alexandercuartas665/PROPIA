                _respMsg = "Respuesta enviada al solicitante.";
                _respErr = false;
                _respTexto = ""; _respCorreo = false; _respCelular = false;
                _huboCambios = true;
                await CargarAsync();
            }
            else
            {
                _respErr = true;
                _respMsg = "No se pudo enviar: " + await resp.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex) { _respErr = true; _respMsg = ex.Message; }
        finally { _respBusy = false; }
    }

    private async Task EjecutarCerrar()
    {
        if (!Guid.TryParse(_motivoCierreId, out var motivoId)) { _msg = "Elige un motivo de cierre."; return; }
        _busy = true;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{ExpedienteId}/cerrar",
            new CerrarDefinitivoRequest(_textoAccion.Trim(), motivoId));
        await TrasAccion(resp, "Expediente cerrado.");
    }

    private async Task EjecutarInconformidad()
    {
        _busy = true;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{ExpedienteId}/inconformidad",
            new ManifestarInconformidadRequest(_textoAccion.Trim()));
        await TrasAccion(resp, "Inconformidad registrada.");
    }

    // Tutela como slot dentro de la tarjeta PLAZO LEGAL (antes era un boton en la barra de acciones).
    private void ToggleTutela()
    {
        _tutelaAbierta = !_tutelaAbierta;
        if (_tutelaAbierta) { _prorrogaAbierta = false; _accion = null; }
        else { _tutelaMotivo = ""; }
    }

    private async Task EjecutarTutelaSlot()
    {
        if (string.IsNullOrWhiteSpace(_tutelaMotivo)) return;
        _busy = true;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{ExpedienteId}/tutela",
            new ActivarTutelaRequest(_tutelaMotivo.Trim()));
        _tutelaAbierta = false; _tutelaMotivo = "";
        await TrasAccion(resp, "Tutela activada.");
    }

    private void ToggleProrroga()
    {
        _prorrogaAbierta = !_prorrogaAbierta;
        if (_prorrogaAbierta) { _tutelaAbierta = false; _accion = null; }   // cierra tutela y cualquier form de accion abierto abajo
        else { _prorrogaDias = 0; _prorrogaMotivo = ""; }
    }

    private async Task EjecutarProrroga()
    {
        if (_prorrogaDias < 1 || string.IsNullOrWhiteSpace(_prorrogaMotivo)) return;
        _busy = true;
        var dias = _prorrogaDias;
        var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{ExpedienteId}/prorroga",
            new AmpliarPlazoRequest(dias, _prorrogaMotivo.Trim()));
        if (resp.IsSuccessStatusCode)
        {
            _prorrogaAbierta = false;
            _prorrogaDias = 0;
            _prorrogaMotivo = "";
            _huboCambios = true;
            await CargarAsync();
            ShowMsg($"Prorroga aplicada (+{dias} dias habiles).", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    private async Task TrasAccion(HttpResponseMessage resp, string okMsg)
    {
        if (resp.IsSuccessStatusCode)
        {
            _accion = null;
            _textoAccion = "";
            _huboCambios = true;
            await CargarAsync();
            ShowMsg(okMsg, false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    private void SetAccion(string accion) { _accion = accion; _textoAccion = ""; }
    private void CancelarAccion() { _accion = null; _textoAccion = ""; }
    private void ShowMsg(string text, bool isError) { _msg = text; _msgError = isError; }
    private void Cerrar() => Close(_huboCambios);

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / 1024 / 1024:0.#} MB";
    }

    private static string Extension(string nombre)
    {
        var ext = System.IO.Path.GetExtension(nombre);
        return string.IsNullOrEmpty(ext) ? "FILE" : ext.TrimStart('.').ToUpperInvariant();
    }

    private static bool EsImagen(string mime, string nombre)
    {
        if (!string.IsNullOrEmpty(mime) && mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) return true;
        var ext = System.IO.Path.GetExtension(nombre).ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".svg";
    }

    private static bool EsPdf(string mime, string nombre)
    {
        if (!string.IsNullOrEmpty(mime) && mime.Equals("application/pdf", StringComparison.OrdinalIgnoreCase)) return true;
        return System.IO.Path.GetExtension(nombre).Equals(".pdf", StringComparison.OrdinalIgnoreCase);
    }

    private static string ThumbClass(string mime, string nombre)
    {
        if (EsImagen(mime, nombre)) return "gpq-adj-thumb--img";
        if (EsPdf(mime, nombre)) return "gpq-adj-thumb--pdf";
        var ext = System.IO.Path.GetExtension(nombre).ToLowerInvariant();
        if (ext is ".doc" or ".docx") return "gpq-adj-thumb--doc";
        if (ext is ".xls" or ".xlsx" or ".csv") return "gpq-adj-thumb--xls";
        return "gpq-adj-thumb--generic";
    }

