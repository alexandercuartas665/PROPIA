    {
        if (_respTexto.Trim().Length < 20 || (!_respCorreo && !_respCelular)) return;
        _respBusy = true; _respMsg = ""; _respErr = false;
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{ExpedienteId}/responder",
                new ResponderExpedienteRequest(_respTexto.Trim(), _respCorreo, _respCelular));
            if (resp.IsSuccessStatusCode)
