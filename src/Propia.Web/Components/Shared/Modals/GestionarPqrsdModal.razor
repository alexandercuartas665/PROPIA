    // Lee el claim user_id (o sub) del payload del JWT sin dependencias externas (para "los mios a la derecha").
    private static Guid LeerUsuarioIdDeJwt(string jwt)
    {
        try
        {
            var partes = jwt.Split('.');
            if (partes.Length < 2) return Guid.Empty;
            var payload = partes[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4) { case 2: payload += "=="; break; case 3: payload += "="; break; }
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("user_id", out var uid) && Guid.TryParse(uid.GetString(), out var g)) return g;
            if (root.TryGetProperty("sub", out var sub) && Guid.TryParse(sub.GetString(), out var gs)) return gs;
        }
        catch { }
        return Guid.Empty;
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    // ===================== Seguimiento publico (link compartible con el radicador) =====================
    private string? _shareLink;
    private bool _shareBusy;
    private bool _shareCopiado;

    private Guid? TenantIdDeJwt()
    {
        if (string.IsNullOrEmpty(Jwt)) return null;
        try
        {
            var parts = Jwt.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4) { case 2: payload += "=="; break; case 3: payload += "="; break; }
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("tenant_id", out var t) && Guid.TryParse(t.GetString(), out var g)) return g;
        }
        catch { }
        return null;
    }

    private async Task GenerarLinkSeguimiento()
    {
        _shareBusy = true; _shareCopiado = false;
        try
        {
            var resp = await Auth().PostAsync($"/api/pqrsd/{ExpedienteId}/compartir", null);
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<PqrsdShareLinkDto>();
                var tid = TenantIdDeJwt();
                if (dto is not null && tid is not null)
                    _shareLink = $"{Nav.BaseUri.TrimEnd('/')}/pqr-seguimiento/{tid}/{dto.Token}";
            }
            else { ShowMsg("No se pudo generar el link.", true); }
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _shareBusy = false; }
