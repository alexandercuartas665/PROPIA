    // ---- SLA visual: edad de la PQR, % de plazo consumido y clase de color por dias restantes ----
    private string DiasDesde(DateTimeOffset dt)
    {
        var d = (int)Math.Floor((DateTimeOffset.UtcNow - dt).TotalDays);
        return d <= 0 ? "hoy" : d == 1 ? "1 dia" : d + " dias";
    }
    private string PlazoTexto()
    {
        var r = _detalle?.DiasHastaVencimiento ?? 0;
        return r < 0 ? $"Vencida hace {Math.Abs(r)} dias" : r == 0 ? "Vence hoy" : $"Quedan {r} dias habiles";
    }
    private string PlazoPillClass()
    {
        var r = _detalle?.DiasHastaVencimiento ?? 0;
        return r < 0 ? "gpq-pill-venc" : r <= 3 ? "gpq-pill-warn" : "gpq-pill-ok";
    }
    private int SlaPct()
    {
        if (_detalle is null) return 0;
        var created = _detalle.CreatedAt.UtcDateTime.Date;
        var venc = _detalle.FechaVencimiento.ToDateTime(TimeOnly.MinValue).Date;
        var total = (venc - created).Days;
        if (total <= 0) return 100;
        var elapsed = (DateTime.UtcNow.Date - created).Days;
        return Math.Clamp((int)Math.Round(100.0 * elapsed / total), 0, 100);
    }

