@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public Guid ExpedienteId { get; set; }

    private PqrsdExpedienteDetalleDto? _detalle;
    private PqrsdContextoDto? _contexto;
    private string? _accion;
    private string _textoAccion = "";
    private bool _busy;
    private string _msg = "";
    private bool _msgError;
    private bool _huboCambios;
    private string _tab = "detalle";

    // Edicion de propiedad + solicitante + campos dinamicos
    private List<UnidadDto> _unidades = new();
    private List<PqrsdCampoDto> _campos = new();
    private string _unidadIdStr = "";
    private PersonaCandidatoDto? _personaSel;
    private readonly Dictionary<Guid, string> _campoValores = new();
    private bool _guardandoRel;

    // Form adjunto
    private string _nuevoAdjNombre = "";
    private string _nuevoAdjUrl = "";
    private bool _subiendo;
    private PqrsdAdjuntoDto? _visorAdj;
    private string _subiendoNombre = "";

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            _detalle = await Auth().GetFromJsonAsync<PqrsdExpedienteDetalleDto>($"/api/pqrsd/{ExpedienteId}");
        }
        catch (Exception ex) { ShowMsg("Error: " + ex.Message, true); }
        try
        {
            _contexto = await Auth().GetFromJsonAsync<PqrsdContextoDto>($"/api/pqrsd/{ExpedienteId}/contexto");
        }
        catch { _contexto = null; }

        try
        {
            var http = Auth();
            _unidades = (await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades")) ?? new();
            _campos = (await http.GetFromJsonAsync<List<PqrsdCampoDto>>("/api/pqrsd/campos")) ?? new();
        }
        catch { }

        if (_detalle is not null)
        {
            _unidadIdStr = _detalle.UnidadPrivadaId?.ToString() ?? "";
            _campoValores.Clear();
            if (_detalle.Campos is not null)
                foreach (var v in _detalle.Campos) _campoValores[v.CampoId] = v.Valor ?? "";
        }
    }

    private async Task AgregarAdjunto()
    {
        if (string.IsNullOrWhiteSpace(_nuevoAdjNombre)) return;
        var ext = System.IO.Path.GetExtension(_nuevoAdjNombre).ToLowerInvariant();
        var mime = ext switch
        {
            ".pdf" => "application/pdf",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".doc" or ".docx" => "application/msword",
            ".xls" or ".xlsx" => "application/vnd.ms-excel",
            _ => "application/octet-stream"
        };
        var req = new AgregarAdjuntoPqrsdRequest(_nuevoAdjNombre.Trim(), mime, 0,
            string.IsNullOrWhiteSpace(_nuevoAdjUrl) ? "/pendiente-upload" : _nuevoAdjUrl.Trim());
        var resp = await Auth().PostAsJsonAsync($"/api/pqrsd/{ExpedienteId}/adjuntos", req);
        if (resp.IsSuccessStatusCode)
        {
            _nuevoAdjNombre = "";
            _nuevoAdjUrl = "";
            _huboCambios = true;
            await CargarAsync();
            ShowMsg("Adjunto registrado.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
    }

    private void SetCampo(Guid id, string? valor) => _campoValores[id] = valor ?? "";

    private static string CampoInputType(TipoCampoTablero t) => t switch
    {
        TipoCampoTablero.Numero or TipoCampoTablero.Moneda => "number",
        TipoCampoTablero.Fecha => "date",
        TipoCampoTablero.Hora => "time",
        TipoCampoTablero.Email => "email",
        TipoCampoTablero.Url => "url",
        TipoCampoTablero.Telefono => "tel",
        _ => "text"
    };

    private async Task GuardarDatos()
    {
        _guardandoRel = true;
        Guid? unidadId = Guid.TryParse(_unidadIdStr, out var uid) ? uid : null;
        Guid? radId = _personaSel?.PersonaId;
        var campos = _campoValores.Select(kv => new PqrsdCampoValorDto(kv.Key, kv.Value)).ToList();
        var req = new ActualizarExpedienteRequest(unidadId, radId, null, campos);
        try
        {
            var resp = await Auth().PutAsJsonAsync($"/api/pqrsd/{ExpedienteId}/actualizar", req);
            if (resp.IsSuccessStatusCode)
            {
                _huboCambios = true;
                _personaSel = null;
                await CargarAsync();
                ShowMsg("Cambios guardados.", false);
            }
            else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        _guardandoRel = false;
    }

    // Sube el binario real de cada archivo al storage (endpoint multipart) y registra el adjunto.
    private async Task OnArchivosSeleccionados(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _subiendo = true;
        var subidos = 0;
        foreach (var archivo in e.GetMultipleFiles(maximumFileCount: 10))
        {
            _subiendoNombre = archivo.Name;
            StateHasChanged();
            try
            {
                using var content = new MultipartFormDataContent();
                var stream = archivo.OpenReadStream(10_000_000);
                var sc = new StreamContent(stream);
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrEmpty(archivo.ContentType) ? "application/octet-stream" : archivo.ContentType);
                content.Add(sc, "file", archivo.Name);
                var resp = await Auth().PostAsync($"/api/pqrsd/{ExpedienteId}/adjuntos/upload", content);
                if (resp.IsSuccessStatusCode) subidos++;
            }
            catch { }
        }
        _subiendo = false;
        _subiendoNombre = "";
        if (subidos > 0)
        {
            _huboCambios = true;
            await CargarAsync();
            ShowMsg($"{subidos} archivo(s) subido(s).", false);
        }
        else { ShowMsg("No se pudo subir ningun archivo.", true); }
    }

