    private async Task TrasAccion(HttpResponseMessage resp, string okMsg)
    {
        if (resp.IsSuccessStatusCode)
        {
            _accion = null;
            _textoAccion = "";
            _huboCambios = true;
            await CargarAsync();
            ShowMsg(okMsg, false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    private void SetAccion(string accion) { _accion = accion; _textoAccion = ""; }
    private void CancelarAccion() { _accion = null; _textoAccion = ""; }
    private void ShowMsg(string text, bool isError) { _msg = text; _msgError = isError; }
    private void Cerrar() => Close(_huboCambios);

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / 1024 / 1024:0.#} MB";
    }

