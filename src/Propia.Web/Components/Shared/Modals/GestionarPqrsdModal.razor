    // Fusiona comentarios + adjuntos en una linea de tiempo cronologica (mas antiguo arriba) con separadores por dia.
    private List<PqrActItem> ActTimeline()
    {
        var items = new List<PqrActItem>();
        if (_detalle?.Comentarios is not null)
            foreach (var c in _detalle.Comentarios)
                items.Add(new PqrActItem(c.CreatedAt, c.AutorUsuarioId is Guid g && g != Guid.Empty && g == _miUsuarioId, c.AutorNombre, c.Texto, null));
        if (_detalle?.Adjuntos is not null)
            foreach (var a in _detalle.Adjuntos)
                items.Add(new PqrActItem(a.CreatedAt, a.SubidoPorUsuarioId is Guid ag && ag != Guid.Empty && ag == _miUsuarioId, a.SubidoPorNombre, null, a));

        var ordenados = items.OrderBy(i => i.Fecha).ToList();
        var res = new List<PqrActItem>();
        DateTime? dia = null;
        foreach (var it in ordenados)
        {
            var d0 = it.Fecha.ToLocalTime().Date;
            if (dia != d0) { res.Add(new PqrActItem(it.Fecha, false, null, null, null, true, SepDia(it.Fecha))); dia = d0; }
            res.Add(it);
        }
        return res;
    }

    private static string SepDia(DateTimeOffset f)
    {
        var d = f.ToLocalTime().Date; var hoy = DateTime.Now.Date;
        if (d == hoy) return "Hoy";
        if (d == hoy.AddDays(-1)) return "Ayer";
        return f.ToLocalTime().ToString("dddd, d 'de' MMMM yyyy", Es);
    }
    private static string FechaSoloHora(DateTimeOffset f) => f.ToLocalTime().ToString("HH:mm");

