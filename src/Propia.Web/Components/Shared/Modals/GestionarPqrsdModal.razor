            if (personas is not null)
                _personas = personas.Select(p => new PersonaMini(p.Id, $"{p.Nombres} {p.Apellidos}".Trim())).ToList();
        }
        catch { }

        if (_detalle is not null)
        {
            _unidadIdStr = _detalle.UnidadPrivadaId?.ToString() ?? "";
            _progreso = _detalle.Progreso;
            _asignadoSel = null;
