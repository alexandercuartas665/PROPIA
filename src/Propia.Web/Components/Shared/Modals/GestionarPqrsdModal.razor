    }
    .gpq-header-text { flex: 1; min-width: 0; }
    .gpq-title { font-size: 16px; font-weight: 800; letter-spacing: -0.3px; color: #1B2A3A; }
    .gpq-title--num { font-size: 22px; letter-spacing: -0.5px; }
    .gpq-subtitle { font-size: 12.5px; color: #7C98B6; }

    .gpq-tabs { display: flex; gap: 2px; padding: 0 24px; border-bottom: 1px solid #EEF3F8; flex-shrink: 0; background: #fff; }
