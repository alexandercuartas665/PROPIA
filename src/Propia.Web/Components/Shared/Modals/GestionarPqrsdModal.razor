    private string _nuevoCampoOpciones = "";
    private bool _creandoCampo;
    private async Task CrearCampo()
    {
        if (string.IsNullOrWhiteSpace(_nuevoCampoLabel)) return;
        _creandoCampo = true;
        try
        {
            var opciones = _nuevoCampoTipo == TipoCampoTablero.Seleccion ? _nuevoCampoOpciones?.Trim() : null;
            var req = new GuardarCampoPqrsdRequest(_nuevoCampoLabel.Trim(), _nuevoCampoTipo, string.IsNullOrWhiteSpace(opciones) ? null : opciones, false, _campos.Count, null, false, null, false, null);
            var resp = await Auth().PostAsJsonAsync("/api/pqrsd/campos", req);
            if (resp.IsSuccessStatusCode)
            {
                _campos = (await Auth().GetFromJsonAsync<List<PqrsdCampoDto>>("/api/pqrsd/campos")) ?? _campos;
                _nuevoCampoOpen = false; _nuevoCampoLabel = ""; _nuevoCampoOpciones = "";
            }
        }
        catch { }
        _creandoCampo = false;
    }

    private async Task CargarAsync()
    {
