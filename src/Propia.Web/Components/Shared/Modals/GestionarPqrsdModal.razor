        _reportando = false;
    }

    // Detecta si se esta escribiendo una @mencion al final del texto y filtra el directorio (_personas).
    private void DetectarMencion()
    {
        var t = _nuevoComentario ?? "";
        var m = System.Text.RegularExpressions.Regex.Match(t, @"(?:^|\s)@([\p{L}0-9._-]*)$");
        if (!m.Success) { _mencionQuery = null; _mencionMatches.Clear(); return; }
        _mencionQuery = m.Groups[1].Value;
        var q = _mencionQuery.ToLowerInvariant().Replace(".", "");
        _mencionMatches = _personas
            .Where(p => string.IsNullOrEmpty(q)
                     || p.Nombre.ToLowerInvariant().Replace(" ", "").Contains(q)
                     || MencionToken(p.Nombre).Replace(".", "").Contains(q))
            .Take(6).ToList();
    }
    private void InsertarMencion(PersonaMini p)
    {
        var t = _nuevoComentario ?? "";
        t = System.Text.RegularExpressions.Regex.Replace(t, @"(^|\s)@([\p{L}0-9._-]*)$", $"$1@{MencionToken(p.Nombre)} ");
        _nuevoComentario = t;
        _mencionQuery = null; _mencionMatches.Clear();
    }
    // Formato que resuelve el backend (NotificarMencionesAsync): nombre en minusculas con espacios -> puntos.
    private static string MencionToken(string nombre) => nombre.Trim().ToLowerInvariant().Replace(" ", ".");

    // Crear tarea interna (2.10) desde el PQR y vincularla
    // Sube el binario real de cada archivo al storage (endpoint multipart) y registra el adjunto.
    private async Task OnArchivosSeleccionados(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _subiendo = true;
        var subidos = 0;
        foreach (var archivo in e.GetMultipleFiles(maximumFileCount: 10))
        {
            _subiendoNombre = archivo.Name;
            StateHasChanged();
            try
            {
                using var content = new MultipartFormDataContent();
                var stream = archivo.OpenReadStream(10_000_000);
                var sc = new StreamContent(stream);
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrEmpty(archivo.ContentType) ? "application/octet-stream" : archivo.ContentType);
                content.Add(sc, "file", archivo.Name);
                var resp = await Auth().PostAsync($"/api/pqrsd/{ExpedienteId}/adjuntos/upload", content);
                if (resp.IsSuccessStatusCode) subidos++;
            }
            catch { }
        }
        _subiendo = false;
        _subiendoNombre = "";
        if (subidos > 0)
        {
            _huboCambios = true;
            await CargarAsync();
            ShowMsg($"{subidos} archivo(s) subido(s).", false);
        }
        else { ShowMsg("No se pudo subir ningun archivo.", true); }
    }

