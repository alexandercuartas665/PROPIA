    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / 1024 / 1024:0.#} MB";
    }

    private static string Extension(string nombre)
    {
        var ext = System.IO.Path.GetExtension(nombre);
        return string.IsNullOrEmpty(ext) ? "FILE" : ext.TrimStart('.').ToUpperInvariant();
    }

    private static bool EsImagen(string mime, string nombre)
    {
        if (!string.IsNullOrEmpty(mime) && mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) return true;
        var ext = System.IO.Path.GetExtension(nombre).ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".svg";
    }

    private static bool EsPdf(string mime, string nombre)
    {
        if (!string.IsNullOrEmpty(mime) && mime.Equals("application/pdf", StringComparison.OrdinalIgnoreCase)) return true;
        return System.IO.Path.GetExtension(nombre).Equals(".pdf", StringComparison.OrdinalIgnoreCase);
    }

    private static string ThumbClass(string mime, string nombre)
    {
        if (EsImagen(mime, nombre)) return "gpq-adj-thumb--img";
        if (EsPdf(mime, nombre)) return "gpq-adj-thumb--pdf";
        var ext = System.IO.Path.GetExtension(nombre).ToLowerInvariant();
        if (ext is ".doc" or ".docx") return "gpq-adj-thumb--doc";
        if (ext is ".xls" or ".xlsx" or ".csv") return "gpq-adj-thumb--xls";
        return "gpq-adj-thumb--generic";
    }

