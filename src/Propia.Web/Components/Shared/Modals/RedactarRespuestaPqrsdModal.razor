@* Modal de respuesta PQRSD estilo "documento/carta": redactar con editor enriquecido (TinyMCE) o ver
   una respuesta guardada. Los adjuntos se manejan como una GALERIA en la parte de abajo: en redaccion
   se eligen y quedan pendientes (se suben al guardar); en vista se ven y se pueden agregar mas. El
   envio al radicador se construye despues (aqui solo se guardan borradores con trazabilidad). *@
@inherits ModalBase<bool>
@using Propia.Application.Pqrsd
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<div class="rrp">
    <div class="rrp-head">
        <div>
            <div class="rrp-eyebrow">@(_modo == "ver" ? "RESPUESTA" : "NUEVA RESPUESTA")</div>
            @if (_modo == "ver" && _dto is not null)
            {
                <div class="rrp-title">@(string.IsNullOrWhiteSpace(_dto.Asunto) ? "(sin asunto)" : _dto.Asunto)</div>
                <div class="rrp-meta">@(_dto.AutorNombre ?? "-") &middot; @_dto.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm") @(_dto.Enviada ? " · Enviada" : " · Borrador")</div>
            }
            else
            {
                <div class="rrp-title">Redactar respuesta</div>
            }
        </div>
        <button type="button" class="rrp-x" title="Cerrar" @onclick="Cerrar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
    </div>

    @if (_modo != "ver")
    {
        <input class="rrp-asunto" placeholder="Asunto (opcional)" @bind="_asunto" @bind:event="oninput" />

        @* Adjuntos ARRIBA (pendientes: se suben al guardar) *@
        <div class="rrp-adj rrp-adj--top">
            <div class="rrp-adj-h">ADJUNTOS (@_pendientes.Count)</div>
            <div class="rrp-gal">
                @for (int i = 0; i < _pendientes.Count; i++)
                {
                    var idx = i; var f = _pendientes[i];
                    <div class="rrp-gal-item">
                        <div class="rrp-gal-ic">@Ext(f.Name)</div>
                        <div class="rrp-gal-nm" title="@f.Name">@f.Name</div>
                        <button type="button" class="rrp-gal-x" title="Quitar" @onclick="() => QuitarPendiente(idx)">&times;</button>
                    </div>
                }
                <label class="rrp-gal-add rrp-gal-add--sm">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                    <span>Agregar</span>
                    <InputFile OnChange="OnElegirPendientes" multiple style="display:none" />
                </label>
            </div>
        </div>

        @* Editor (documento) + panel de plantillas al lado *@
        <div class="rrp-compose">
            <div class="rrp-doc">
                <textarea id="pqr-resp-ed"></textarea>
            </div>
            <div class="rrp-tpl">
                <div class="rrp-tpl-h">
                    <span>PLANTILLAS</span>
                    <button type="button" class="rrp-tpl-gear" title="Crear/editar plantillas" @onclick="GestionarPlantillas">Gestionar</button>
                </div>
                <div class="rrp-tpl-hint">Al usar una plantilla, los datos ({unidad}, {copropiedad}...) se reemplazan por los reales.</div>
                <div class="rrp-tpl-list">
                    @foreach (var p in _plantillas)
                    {
                        var pp = p;
                        <div class="rrp-tpl-item">
                            <span class="rrp-tpl-nm" title="@p.Nombre">@p.Nombre</span>
                            <button type="button" class="rrp-tpl-use" @onclick="() => UsarPlantilla(pp)" disabled="@_busy">Usar</button>
                        </div>
                    }
                    @if (_plantillas.Count == 0) { <div class="rrp-tpl-empty">Sin plantillas. Crea una con "Gestionar".</div> }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_msg)) { <div class="rrp-msg @(_err ? "err" : "ok")">@_msg</div> }
        <div class="rrp-foot">
            <span class="rrp-hint">Se guarda como borrador con trazabilidad. El envio al radicador se hara despues.</span>
            <div class="rrp-foot-btns">
                <button type="button" class="rrp-btn-ghost" @onclick="Cerrar">Cancelar</button>
                <button type="button" class="rrp-btn-brand" @onclick="GuardarAsync" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar respuesta")</button>
            </div>
        </div>
    }
    else if (_dto is not null)
    {
        <div class="rrp-doc rrp-doc--ver">
            <div class="rrp-page">@((MarkupString)_dto.CuerpoHtml)</div>
        </div>

        <div class="rrp-adj">
            <div class="rrp-adj-h">ADJUNTOS (@_dto.Adjuntos.Count)</div>
            <div class="rrp-gal">
                @foreach (var a in _dto.Adjuntos)
                {
                    <a class="rrp-gal-item rrp-gal-item--link" href="@a.UrlStorage" target="_blank" rel="noopener" title="@a.NombreArchivo">
                        @if (EsImagen(a.TipoMime, a.NombreArchivo))
                        {
                            <div class="rrp-gal-thumb"><img src="@a.UrlStorage" alt="@a.NombreArchivo" /></div>
                        }
                        else
                        {
                            <div class="rrp-gal-ic">@Ext(a.NombreArchivo)</div>
                        }
                        <div class="rrp-gal-nm">@a.NombreArchivo</div>
                    </a>
                }
                <label class="rrp-gal-add @(_subiendo ? "busy" : "")">
                    @if (_subiendo)
                    {
                        <span>Subiendo...</span>
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                        <span>Agregar</span>
                    }
                    <InputFile OnChange="OnSubirAdjunto" multiple style="display:none" />
                </label>
            </div>
            @if (!string.IsNullOrEmpty(_msg)) { <div class="rrp-msg @(_err ? "err" : "ok")">@_msg</div> }
        </div>

        <div class="rrp-foot">
            <span class="rrp-hint">El envio al radicador se construira despues.</span>
            <div class="rrp-foot-btns">
                <button type="button" class="rrp-btn-brand" @onclick="Cerrar">Listo</button>
            </div>
        </div>
    }
</div>

<style>
    .rrp { display: flex; flex-direction: column; gap: 12px; padding: 4px 2px; }
    .rrp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .rrp-eyebrow { font-size: 10.5px; font-weight: 800; letter-spacing: .06em; color: #7C98B6; }
    .rrp-title { font-size: 17px; font-weight: 800; color: #1B2A3A; margin-top: 2px; }
    .rrp-meta { font-size: 11.5px; color: #7C98B6; margin-top: 2px; }
    .rrp-x { width: 30px; height: 30px; border-radius: 8px; border: 1px solid #E1E8EE; background: #fff; color: #7C98B6; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
    .rrp-x:hover { color: #D7263D; border-color: #F0C9C9; }
    .rrp-asunto { border: 1px solid #E1E8EE; border-radius: 9px; padding: 11px 14px; font-size: 15px; color: #1B2A3A; outline: none; font-family: inherit; }
    .rrp-asunto:focus { border-color: var(--propia-brand, #6D4FE3); }
    .rrp-doc { border: 1px solid #E7EDF3; border-radius: 12px; overflow: hidden; background: #eceff3; }
    .rrp-doc--ver { max-height: 52vh; overflow-y: auto; padding: 22px 0; }
    .rrp-page { background: #fff; max-width: 760px; margin: 0 auto; padding: 56px 64px; box-shadow: 0 3px 16px rgba(27,42,58,.14); border-radius: 2px; font-family: Georgia, 'Times New Roman', serif; font-size: 15px; line-height: 1.6; color: #1B2A3A; }
    .rrp-page img { max-width: 100%; }
    .rrp-msg { font-size: 12px; font-weight: 600; }
    .rrp-msg.err { color: #C0383C; }
    .rrp-msg.ok { color: #15703F; }
    .rrp-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .rrp-hint { font-size: 11.5px; color: #94A3B8; }
    .rrp-foot-btns { display: flex; gap: 8px; }
    .rrp-btn-brand { padding: 10px 18px; border-radius: 9px; background: var(--propia-brand, #6D4FE3); color: #fff; font-size: 13px; font-weight: 700; border: 0; cursor: pointer; }
    .rrp-btn-brand:disabled { opacity: .5; cursor: default; }
    .rrp-btn-ghost { padding: 10px 16px; border-radius: 9px; background: #fff; border: 1px solid #E1E8EE; font-size: 13px; font-weight: 600; color: #516F90; cursor: pointer; }

    /* Galeria de adjuntos */
    .rrp-adj { border-top: 1px solid #EEF3F8; padding-top: 12px; }
    .rrp-adj-h { font-size: 10.5px; font-weight: 800; letter-spacing: .05em; color: #7C98B6; margin-bottom: 8px; }
    .rrp-gal { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; }
    .rrp-gal-item { position: relative; border: 1px solid #E7EDF3; border-radius: 10px; padding: 10px; background: #FAFBFD; display: flex; flex-direction: column; align-items: center; gap: 7px; text-decoration: none; color: #1B2A3A; }
    .rrp-gal-item--link:hover { background: #F1ECFD; border-color: #D8CCF7; }
    .rrp-gal-thumb { width: 100%; height: 70px; border-radius: 7px; overflow: hidden; background: #EEF3F8; }
    .rrp-gal-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .rrp-gal-ic { width: 100%; height: 70px; border-radius: 7px; background: #6D4FE3; color: #fff; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; text-transform: uppercase; }
    .rrp-gal-nm { font-size: 11.5px; font-weight: 600; width: 100%; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rrp-gal-x { position: absolute; top: -7px; right: -7px; width: 22px; height: 22px; border-radius: 50%; border: 1px solid #F0C9C9; background: #fff; color: #D7263D; font-size: 15px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .rrp-gal-add { border: 1px dashed #C3D0DD; border-radius: 10px; min-height: 108px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--propia-brand, #6D4FE3); cursor: pointer; background: transparent; }
    .rrp-gal-add:hover { border-color: var(--propia-brand, #6D4FE3); background: #F8F5FE; }
    .rrp-gal-add.busy { opacity: .6; }
    .rrp-adj--top { border-top: 0; padding-top: 0; }
    .rrp-adj--top .rrp-gal { grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); }
    .rrp-gal-add--sm { min-height: 70px; }

    /* Layout redaccion: editor + panel de plantillas al lado */
    .rrp-compose { display: grid; grid-template-columns: 1fr 260px; gap: 12px; align-items: start; }
    .rrp-tpl { border: 1px solid #E7EDF3; border-radius: 12px; padding: 12px; background: #FAFBFD; display: flex; flex-direction: column; gap: 8px; max-height: 62vh; overflow-y: auto; }
    .rrp-tpl-h { display: flex; align-items: center; justify-content: space-between; font-size: 10.5px; font-weight: 800; letter-spacing: .05em; color: #7C98B6; }
    .rrp-tpl-gear { font-size: 11px; font-weight: 700; color: var(--propia-brand, #6D4FE3); background: #EEF1FB; border: 1px solid #DCD2F8; border-radius: 6px; padding: 3px 8px; cursor: pointer; }
    .rrp-tpl-gear:hover { background: #E2E6FA; }
    .rrp-tpl-hint { font-size: 10.5px; color: #94A3B8; line-height: 1.35; }
    .rrp-tpl-list { display: flex; flex-direction: column; gap: 6px; }
    .rrp-tpl-item { display: flex; align-items: center; justify-content: space-between; gap: 6px; border: 1px solid #E7EDF3; border-radius: 8px; padding: 8px 9px; background: #fff; }
    .rrp-tpl-nm { font-size: 12.5px; font-weight: 700; color: #1B2A3A; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rrp-tpl-use { font-size: 11.5px; font-weight: 700; color: #fff; background: var(--propia-brand, #6D4FE3); border: 0; border-radius: 6px; padding: 5px 10px; cursor: pointer; flex: 0 0 auto; }
    .rrp-tpl-use:disabled { opacity: .5; }
    .rrp-tpl-empty { font-size: 11.5px; color: #94A3B8; }
</style>

@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public Guid ExpedienteId { get; set; }
    /// <summary>Si viene una respuesta, el modal abre en modo VER; si es null, abre en modo REDACTAR.</summary>
    [Parameter] public PqrsdRespuestaDto? Respuesta { get; set; }

    private string _modo = "redactar";        // "redactar" | "ver"
    private PqrsdRespuestaDto? _dto;
    private string _asunto = "";
    private bool _busy, _subiendo, _err;
    private string? _msg;
    private bool _editorListo;
    private const string EdSel = "#pqr-resp-ed";
    private readonly List<IBrowserFile> _pendientes = new();
    private List<PqrsdPlantillaDto> _plantillas = new();

    protected override async Task OnInitializedAsync()
    {
        if (Respuesta is not null) { _dto = Respuesta; _modo = "ver"; }
        else await CargarPlantillasAsync();
    }

    private async Task CargarPlantillasAsync()
    {
        try { _plantillas = (await Auth().GetFromJsonAsync<List<PqrsdPlantillaDto>>("/api/pqrsd/plantillas")) ?? new(); }
        catch { _plantillas = new(); }
    }

    private async Task UsarPlantilla(PqrsdPlantillaDto p)
    {
        try
        {
            var res = await Auth().GetFromJsonAsync<HtmlResp>($"/api/pqrsd/{ExpedienteId}/plantillas/{p.Id}/resuelta");
            if (res?.Html is not null) await Js.InvokeVoidAsync("propiaTiny.setContent", EdSel, res.Html);
        }
        catch (Exception ex) { _err = true; _msg = ex.Message; }
    }

    private async Task GestionarPlantillas()
    {
        var parameters = new ModalParameters().Set("Jwt", Jwt);
        var options = new ModalOptions { Width = "980px" };
        await Modals.OpenAsync<GestionarPlantillasPqrsdModal, bool>(parameters, options);
        await CargarPlantillasAsync();
    }

    private sealed record HtmlResp(string Html);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_modo == "redactar" && !_editorListo)
        {
            _editorListo = true;
            try { await Js.InvokeAsync<bool>("propiaTiny.init", EdSel, ""); } catch { }
        }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private void OnElegirPendientes(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(maximumFileCount: 20))
            _pendientes.Add(f);
    }

    private void QuitarPendiente(int idx)
    {
        if (idx >= 0 && idx < _pendientes.Count) _pendientes.RemoveAt(idx);
    }

    private async Task GuardarAsync()
    {
        _busy = true; _msg = null; _err = false;
        try
        {
            string cuerpo = "";
            try { cuerpo = await Js.InvokeAsync<string>("propiaTiny.getContent", EdSel); } catch { }
            if (string.IsNullOrWhiteSpace(System.Text.RegularExpressions.Regex.Replace(cuerpo ?? "", "<[^>]+>", "").Trim()))
            {
                _err = true; _msg = "Escribe el contenido de la respuesta."; _busy = false; return;
            }
            var resp = await Auth().PostAsJsonAsync($"/api/pqrsd/{ExpedienteId}/respuestas",
                new CrearRespuestaBorradorRequest(string.IsNullOrWhiteSpace(_asunto) ? null : _asunto.Trim(), cuerpo!));
            if (!resp.IsSuccessStatusCode) { _err = true; _msg = "No se pudo guardar: " + await resp.Content.ReadAsStringAsync(); return; }
            var creada = await resp.Content.ReadFromJsonAsync<PqrsdRespuestaDto>();
            try { await Js.InvokeVoidAsync("propiaTiny.destroy", EdSel); } catch { }
            _dto = creada;
            // Sube los adjuntos pendientes elegidos durante la redaccion.
            if (creada is not null && _pendientes.Count > 0)
            {
                _subiendo = true; StateHasChanged();
                foreach (var f in _pendientes) await SubirUnoAsync(creada.Id, f);
                _pendientes.Clear();
                _subiendo = false;
                await RecargarDtoAsync();
            }
            _modo = "ver";
            _msg = "Respuesta guardada."; _err = false;
        }
        catch (Exception ex) { _err = true; _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnSubirAdjunto(InputFileChangeEventArgs e)
    {
        if (_dto is null) return;
        _subiendo = true; _msg = null; _err = false;
        var subidos = 0;
        foreach (var archivo in e.GetMultipleFiles(maximumFileCount: 20))
        {
            if (await SubirUnoAsync(_dto.Id, archivo)) subidos++;
        }
        _subiendo = false;
        if (subidos > 0) { await RecargarDtoAsync(); _msg = $"{subidos} archivo(s) adjuntado(s)."; }
        else { _err = true; _msg = "No se pudo adjuntar."; }
    }

    private async Task<bool> SubirUnoAsync(Guid respuestaId, IBrowserFile archivo)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(archivo.OpenReadStream(20_000_000));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrEmpty(archivo.ContentType) ? "application/octet-stream" : archivo.ContentType);
            content.Add(sc, "file", archivo.Name);
            content.Add(new StringContent(respuestaId.ToString()), "respuestaId");
            var resp = await Auth().PostAsync($"/api/pqrsd/{ExpedienteId}/adjuntos/upload", content);
            return resp.IsSuccessStatusCode;
        }
        catch { return false; }
    }

    private async Task RecargarDtoAsync()
    {
        if (_dto is null) return;
        try
        {
            var lista = await Auth().GetFromJsonAsync<List<PqrsdRespuestaDto>>($"/api/pqrsd/{ExpedienteId}/respuestas");
            var actual = lista?.FirstOrDefault(r => r.Id == _dto.Id);
            if (actual is not null) _dto = actual;
        }
        catch { }
    }

    private async Task Cerrar()
    {
        try { await Js.InvokeVoidAsync("propiaTiny.destroy", EdSel); } catch { }
        Close(true);
    }

    private static string Ext(string nombre)
    {
        var e = System.IO.Path.GetExtension(nombre)?.TrimStart('.');
        return string.IsNullOrEmpty(e) ? "FILE" : e.ToUpperInvariant();
    }

    private static bool EsImagen(string mime, string nombre)
    {
        if (!string.IsNullOrEmpty(mime) && mime.StartsWith("image/")) return true;
        var ext = System.IO.Path.GetExtension(nombre)?.ToLowerInvariant();
        return ext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp";
    }
}
