    private async Task GuardarUnidad()
    {
        if (_nuevaUnidad) { await CrearUnidadDesdeFichaAsync(); return; }
        if (_selected is null) return;
        if (string.IsNullOrWhiteSpace(_edit.Numero)) { ShowMsg("Numero obligatorio.", true); return; }
        _busy = true;
        var req = new ActualizarUnidadRequest(
            _edit.Numero.Trim(), _edit.Tipo, _edit.TorreId, _edit.Piso,
            _edit.CoeficientePropiedad, _edit.AreaM2,
            _edit.Habitaciones, _edit.Banos, _edit.Parqueaderos,
            string.IsNullOrWhiteSpace(_edit.Estado) ? null : _edit.Estado,
            string.IsNullOrWhiteSpace(_edit.Observaciones) ? null : _edit.Observaciones,
            string.IsNullOrWhiteSpace(_edit.MatriculaInmobiliaria) ? null : _edit.MatriculaInmobiliaria,
            _edit.PagaAdministracion, _edit.CuotaMensual);
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}", req);
        if (resp.IsSuccessStatusCode)
        {
            var actualizada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
            if (actualizada is not null)
            {
                _selected = actualizada;
                var idx = _unidades.FindIndex(u => u.Id == actualizada.Id);
                if (idx >= 0) _unidades[idx] = actualizada;
            }
            _editMode = false;
            _huboCambios = true;
            ShowMsg($"Unidad {actualizada?.Numero} actualizada.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    // Crea la unidad desde la ficha (modo alta). El codigo mascara TORRE-APARTAMENTO (A1-202)
    // resuelve/crea la torre y el piso se infiere del numero; luego se crea con los campos de la ficha.
    private async Task CrearUnidadDesdeFichaAsync()
    {
        var raw = (_edit.Codigo ?? "").Trim();
        if (raw.Length == 0) { ShowMsg($"Escribe el codigo {AgrupacionLabelSingular.ToUpperInvariant()}-APARTAMENTO (ej. A1-202).", true); return; }

        var parts = raw.Split(new[] { '-', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2) { ShowMsg("Usa el formato TORRE-APARTAMENTO, por ejemplo A1-202.", true); return; }
        var torreToken = parts[0];
        var numero = string.Join("-", parts.Skip(1)).Trim();
        if (numero.Length == 0) { ShowMsg("Falta el numero del apartamento. Ejemplo: A1-202.", true); return; }
        // El piso se infiere del numero de apto (202 -> 2, 1502 -> 15) cuando es numerico de 3+ digitos.
        int? piso = (numero.Length >= 3 && numero.All(char.IsDigit) && int.TryParse(numero[..^2], out var f) && f > 0) ? f : (int?)null;

        _busy = true;
        // Resolver torre por nombre exacto, por "Torre X" o por la ultima palabra del nombre; si no existe, crearla.
        var existe = _torres.FirstOrDefault(t =>
            t.Nombre.Equals(torreToken, StringComparison.OrdinalIgnoreCase)
            || t.Nombre.Equals($"{AgrupacionLabelSingular} {torreToken}", StringComparison.OrdinalIgnoreCase)
            || string.Equals(t.Nombre.Split(' ').LastOrDefault(), torreToken, StringComparison.OrdinalIgnoreCase));
        Guid torreId;
        if (existe is not null) { torreId = existe.Id; }
        else
        {
            var nombreTorre = torreToken.Length <= 4 ? $"{AgrupacionLabelSingular} {torreToken}" : torreToken;
            var respTorre = await Auth().PostAsJsonAsync("/api/mi-copropiedad/torres", new CrearTorreRequest(nombreTorre, null, null));
            if (!respTorre.IsSuccessStatusCode) { ShowMsg($"Error al crear {AgrupacionLabelSingular.ToLower()}: " + await respTorre.Content.ReadAsStringAsync(), true); _busy = false; return; }
            var nuevaTorre = await respTorre.Content.ReadFromJsonAsync<TorreDto>();
            if (nuevaTorre is null) { ShowMsg($"Respuesta inesperada al crear {AgrupacionLabelSingular.ToLower()}.", true); _busy = false; return; }
            _torres.Add(nuevaTorre);
            torreId = nuevaTorre.Id;
            _huboCambios = true;
        }

        var req = new CrearUnidadRequest(
            numero, _edit.Tipo, torreId, piso,
            _edit.CoeficientePropiedad, _edit.AreaM2,
            null, null, null,
            string.IsNullOrWhiteSpace(_edit.Estado) ? null : _edit.Estado, null,
            string.IsNullOrWhiteSpace(_edit.MatriculaInmobiliaria) ? null : _edit.MatriculaInmobiliaria);
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
        if (!resp.IsSuccessStatusCode) { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); _busy = false; return; }
        var creada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
        _huboCambios = true;
        await CargarAsync();
        _busy = false;
        if (creada is not null)
        {
            await SeleccionarUnidad(creada);   // pasa a la ficha completa de la unidad creada
            ShowMsg($"Unidad {creada.Numero} creada.", false);
        }
    }

    // Alta por codigo unico TORRE-PISO-UNIDAD (ej. A-3-101). Si la torre no existe, se crea.
    private string _manCodigo = "";

    private async Task AgregarUnidadPorCodigoAsync()
    {
        var raw = (_manCodigo ?? "").Trim();
        if (raw.Length == 0) return;

        var parts = raw.Split(new[] { '-', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2)
        {
            ShowMsg("Usa el formato TORRE-APARTAMENTO, por ejemplo A1-202.", true);
            return;
        }
        var torreToken = parts[0];
        var numero = string.Join("-", parts.Skip(1)).Trim();
        if (numero.Length == 0) { ShowMsg("Falta el numero del apartamento. Ejemplo: A1-202.", true); return; }
        // El piso se infiere del numero de apto (202 -> 2, 1502 -> 15) cuando es numerico de 3+ digitos.
        int? piso = (numero.Length >= 3 && numero.All(char.IsDigit) && int.TryParse(numero[..^2], out var f) && f > 0) ? f : (int?)null;

        // Resolver torre por nombre exacto, por "Torre X" o por la ultima palabra del nombre.
        var existe = _torres.FirstOrDefault(t =>
            t.Nombre.Equals(torreToken, StringComparison.OrdinalIgnoreCase)
            || t.Nombre.Equals($"{AgrupacionLabelSingular} {torreToken}", StringComparison.OrdinalIgnoreCase)
            || string.Equals(t.Nombre.Split(' ').LastOrDefault(), torreToken, StringComparison.OrdinalIgnoreCase));
        if (existe is not null)
        {
            _manNuevaTorre = false;
            _manTorreId = existe.Id;
        }
        else
        {
            _manNuevaTorre = true;
            _manNuevaTorreNombre = torreToken.Length <= 4 ? $"{AgrupacionLabelSingular} {torreToken}" : torreToken;
        }
        _manPiso = piso;
        _manNumero = numero;

        if (await AgregarUnidadManualCore()) _manCodigo = "";
    }

    private async Task<bool> AgregarUnidadManualCore()
    {
        if (string.IsNullOrWhiteSpace(_manNumero)) return false;

        // Si el usuario eligio "+ Nueva torre...", la creamos primero y usamos su Id.
        if (_manNuevaTorre)
        {
            var nombre = _manNuevaTorreNombre.Trim();
            if (string.IsNullOrWhiteSpace(nombre))
            {
                ShowMsg($"Escribe el nombre de la nueva {AgrupacionLabelSingular.ToLower()}.", true);
                return false;
            }
            _busy = true;
            var existe = _torres.FirstOrDefault(t => t.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase));
            if (existe is not null)
            {
                _manTorreId = existe.Id;
            }
            else
            {
                var respTorre = await Auth().PostAsJsonAsync("/api/mi-copropiedad/torres", new CrearTorreRequest(nombre, null, null));
                if (!respTorre.IsSuccessStatusCode)
                {
                    ShowMsg($"Error al crear {AgrupacionLabelSingular.ToLower()}: " + await respTorre.Content.ReadAsStringAsync(), true);
                    _busy = false;
                    return false;
                }
                var nuevaTorre = await respTorre.Content.ReadFromJsonAsync<TorreDto>();
                if (nuevaTorre is null) { ShowMsg($"Respuesta inesperada al crear {AgrupacionLabelSingular.ToLower()}.", true); _busy = false; return false; }
                _torres.Add(nuevaTorre);
                _manTorreId = nuevaTorre.Id;
                _huboCambios = true;
            }
            _manNuevaTorre = false;
            _manNuevaTorreNombre = "";
            _busy = false;
        }

        if (_manTorreId == Guid.Empty) { ShowMsg($"Selecciona {AgrupacionLabelSingular.ToLower()}.", true); return false; }
        _busy = true;
        var req = new CrearUnidadRequest(_manNumero.Trim(), _manTipo, _manTorreId, _manPiso, 0m, null, null, null, null, null, null);
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
        var ok = resp.IsSuccessStatusCode;
        if (ok)
        {
            _manNumero = "";
            _huboCambios = true;
            await CargarAsync();
            ShowMsg("Unidad agregada", false);
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
        _busy = false;
        return ok;
    }

    private async Task EjecutarGenerador()
    {
        _busy = true;
        var http = Auth();
        // 1) crear torres
        var creadas = new List<TorreDto>();
        foreach (var nombre in _genNombres.Where(n => !string.IsNullOrWhiteSpace(n)))
        {
            var exist = _torres.FirstOrDefault(t => t.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase));
            if (exist is not null) { creadas.Add(exist); continue; }
            var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/torres", new CrearTorreRequest(nombre, _genPisos, null));
            if (resp.IsSuccessStatusCode)
            {
                var nueva = await resp.Content.ReadFromJsonAsync<TorreDto>();
                if (nueva is not null) creadas.Add(nueva);
            }
        }
        // 2) crear unidades por torre
        int totalCreadas = 0;
        foreach (var t in creadas)
        {
            for (int piso = 1; piso <= _genPisos; piso++)
            {
                for (int u = 1; u <= _genPorPiso; u++)
                {
                    var num = $"{piso}{u:00}";
                    if (_unidades.Any(x => x.TorreId == t.Id && x.Numero == num)) continue;
                    var req = new CrearUnidadRequest(num, TipoUnidad.Apartamento, t.Id, piso, 0m, null, null, null, null, null, null);
                    var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
                    if (resp.IsSuccessStatusCode) totalCreadas++;
                }
            }
        }
        _genToast = totalCreadas;
        _huboCambios = true;
        await CargarAsync();
        SetMode(null);
        _busy = false;
    }

    private bool _impBusy;
    private ImportarDistribucionResultado? _impResult;

    private async Task DescargarPlantilla()
    {
        _impBusy = true;
        try
        {
            var bytes = await Auth().GetByteArrayAsync("/api/mi-copropiedad/distribucion/plantilla");
            var b64 = Convert.ToBase64String(bytes);
            await Js.InvokeVoidAsync("propiaUI.downloadBase64", "plantilla-distribucion-propia.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
        }
        catch (Exception ex) { ShowMsg("No se pudo descargar la plantilla: " + ex.Message, true); }
        finally { _impBusy = false; }
    }

    private async Task OnArchivoImport(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _impBusy = true; _impResult = null; StateHasChanged();
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StreamContent(file.OpenReadStream(10 * 1024 * 1024)), "file", file.Name);
            var resp = await Auth().PostAsync("/api/mi-copropiedad/distribucion/importar", content);
            if (resp.IsSuccessStatusCode)
            {
                _impResult = await resp.Content.ReadFromJsonAsync<ImportarDistribucionResultado>();
                _huboCambios = true;
                await CargarAsync();
                ShowMsg($"Importacion completa: {_impResult?.UnidadesCreadas} unidades, {_impResult?.TorresCreadas} torres, {_impResult?.PersonasVinculadas} personas, {_impResult?.VinculosCreados} inmuebles vinculados.", false);
            }
            else
            {
                ShowMsg("Error al importar: " + await resp.Content.ReadAsStringAsync(), true);
            }
        }
        catch (Exception ex) { ShowMsg("Error al importar: " + ex.Message, true); }
        finally { _impBusy = false; StateHasChanged(); }
    }

    private async Task ImportarCsv()
    {
        if (CsvCount == 0) return;
        if (_torres.Count == 0) { ShowMsg($"Crea un {AgrupacionLabelSingular.ToLower()} primero.", true); return; }
        var torre = _torres[0];
        var lineas = _csv.Split('\n').Select(l => l.Trim()).Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
        int ok = 0;
        foreach (var num in lineas)
        {
            if (_unidades.Any(u => u.TorreId == torre.Id && u.Numero == num)) continue;
            var req = new CrearUnidadRequest(num, TipoUnidad.Apartamento, torre.Id, null, 0m, null, null, null, null, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
            if (resp.IsSuccessStatusCode) ok++;
        }
        _csv = "";
        _huboCambios = true;
        await CargarAsync();
        ShowMsg($"{ok} unidades importadas a {torre.Nombre}", false);
    }

