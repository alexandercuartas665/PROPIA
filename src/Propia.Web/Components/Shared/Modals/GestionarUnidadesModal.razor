    .gum-cta--active { border-color: var(--propia-brand, #6D4FE3); color: var(--propia-brand, #6D4FE3); background: #F5F1FE; }

    /* Cards de wizards */
    .gum-card-soft {
        background: #F8FAFC; border: 1px solid #E1E8EE;
