@* GestionarUnidadesModal - D.1 del catalogo (fullscreen).
   Replica literal del modal del prototipo PROPIA.dc.html L.584-720.
   Componente reutilizable: recibe Jwt + cargas las torres/unidades por su cuenta.
   Layout 2 paneles: izq lista torres/unidades, der ficha unidad seleccionada. *@

@inherits ModalBase<bool>
@using Propia.Web.Components.Shared
@using Propia.Web.Components.Shared.Modals
@using Propia.Application.MiCopropiedad
@using Propia.Application.Directorio
@using Propia.Application.Cartera
@using Propia.Application.Historial
@using Propia.Domain.Enums

@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

@* La cabecera del modal es la propia ficha (.cpe-head): identidad de la unidad + acciones + cerrar.
   La maqueta editor-ficha no lleva una barra "Gestionar unidades" separada encima. *@

@* ====== FICHA (panel unico) ======
   La creacion y la edicion usan la MISMA ficha: al crear, se abre en modo "nueva unidad"
   con el codigo mascara (A1-202) editable; al guardar se crea y se pasa a la ficha completa. *@
<div class="gum-body">

    @* ===== Panel DER - ficha unidad ===== *@
    <div class="gum-panel-right">
        @if (_nuevaUnidad)
        {
            @* --- Modo NUEVA UNIDAD: ficha .cpe-* vacia, con el codigo editable como titulo --- *@
            <div class="cpe-card">
                <div class="cpe-head">
                    <span class="cpe-ic">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-4h4v4"/></svg>
                    </span>
                    <div class="cpe-idwrap">
                        <input class="cpe-title" @bind="_edit.Codigo" @bind:event="oninput" placeholder="Ej. A1-202" />
                        <div class="cpe-sub">Nueva unidad - escribe su codigo (texto libre, ej. A1-202). Debe ser unico en la copropiedad.</div>
                    </div>
                    <div class="cpe-head-acts">
                        <button class="cpe-hact" type="button" @onclick="GuardarUnidad" disabled="@_busy" title="@(_busy ? "Creando..." : "Crear unidad")">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
                        </button>
                        <button class="cpe-hact" type="button" @onclick="CancelarEdicion" title="Cancelar">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5M4 9h11a5 5 0 0 1 5 5v2"/></svg>
                        </button>
                        <button class="cpe-hact" type="button" @onclick="Cerrar" title="Cerrar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        </button>
                    </div>
                </div>
                <div class="cpe-body">
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-apps"></i> @AliasCampo("tipo", "TIPO")</label>
                        <select class="cpe-fin" @bind="_edit.TipoKey">
                            @foreach (var t in TiposUnidadSel) { <option value="@($"e:{t}")">@TipoLabel(t)</option> }
                            @if (TiposCustomVisibles().Count > 0) { <optgroup label="Tipos propios">@foreach (var tc in TiposCustomVisibles()) { <option value="@($"c:{tc.Id}")">@tc.Nombre</option> }</optgroup> }
                        </select>
                    </div>
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-calculator"></i> @AliasCampo("coef", "COEFICIENTE")</label>
                        <input type="number" step="0.0001" class="cpe-fin" @bind="_edit.CoeficientePropiedad" />
                    </div>
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-ruler-combined"></i> @AliasCampo("area", "AREA")</label>
                        <input type="number" step="0.01" class="cpe-fin" @bind="_edit.AreaM2" />
                    </div>
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-flag"></i> @AliasCampo("estado", "ESTADO")</label>
                        <select class="cpe-fin" @bind="_edit.Estado">
                            <option value="">- Sin definir -</option>
                            @foreach (var eo in EstadosConVigente(_edit.Estado)) { <option value="@eo">@eo</option> }
                        </select>
                    </div>
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-document"></i> @AliasCampo("matricula", "MATRICULA")</label>
                        <input class="cpe-fin" @bind="_edit.MatriculaInmobiliaria" />
                    </div>
                    <div class="gum-fcustom-empty" style="margin-top:14px;">Guarda la unidad para agregar documentos y campos adicionales.</div>
                    @if (!string.IsNullOrEmpty(_msg))
                    {
                        <div class="gum-msg @(_msgError ? "gum-msg--err" : "gum-msg--ok")" style="margin-top:12px;">@_msg</div>
                    }
                </div>
            </div>
        }
        else if (_selected is null)
        {
            <div class="gum-empty">
                <div class="gum-empty-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M3 21h18M5 21V7l7-4 7 4v14M9 13h.01M15 13h.01M9 17h.01M15 17h.01"/>
                    </svg>
                </div>
                <div class="gum-empty-title">Selecciona una unidad</div>
                <div class="gum-empty-sub">Haz clic en cualquier unidad del arbol para ver y configurar su ficha completa.</div>
            </div>
        }
        else
        {
            @* Ficha estilo "editor-ficha" (.cpe-*): cabecera identidad + 4 pestanas + cuerpo con scroll interno. *@
            <div class="cpe-card">
                <div class="cpe-head">
                    <span class="cpe-ic">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-4h4v4"/></svg>
                    </span>
                    <div class="cpe-idwrap">
                        @* El codigo de la unidad (su Numero) no se edita desde la ficha: se muestra como titulo. *@
                        <input class="cpe-title" value="@IdUnidad" disabled title="@($"{LabelU(_selected)} {_selected.Numero}")" />
                        <div class="cpe-sub">
                            @(_selected.Piso.HasValue ? $"{PisoLabelSingular} {_selected.Piso} - " : "")@LabelU(_selected)@(_selected.AreaM2.HasValue ? $" - {_selected.AreaM2.Value:0.##} m2" : "")
                        </div>
                    </div>
                    <div class="cpe-head-acts">
                        @if (!_editMode)
                        {
                            <button class="cpe-hact" type="button" @onclick="EntrarEdicion" title="Editar ficha">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                        }
                        else
                        {
                            <button class="cpe-hact" type="button" @onclick="GuardarUnidad" disabled="@_busy" title="@(_busy ? "Guardando..." : "Guardar")">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
                            </button>
                            <button class="cpe-hact" type="button" @onclick="AbrirConfirmEliminar" disabled="@_busy" title="Eliminar unidad">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
                            </button>
                            <button class="cpe-hact" type="button" @onclick="CancelarEdicion" title="Cancelar edicion">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5M4 9h11a5 5 0 0 1 5 5v2"/></svg>
                            </button>
                        }
                        <button class="cpe-hact" type="button" @onclick="Cerrar" title="Cerrar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        </button>
                    </div>
                </div>

                <div class="cpe-tabs">
                    <button type="button" class="cpe-tab @(_fichaTab == "detalle" ? "on" : "")" @onclick='() => _fichaTab = "detalle"'>Detalle</button>
                    <button type="button" class="cpe-tab @(_fichaTab == "anexas" ? "on" : "")" @onclick='() => _fichaTab = "anexas"'>Unidades anexas</button>
                    <button type="button" class="cpe-tab @(_fichaTab == "historial" ? "on" : "")" @onclick='() => _fichaTab = "historial"'>Historial relacionado</button>
                    <button type="button" class="cpe-tab @(_fichaTab == "documentos" ? "on" : "")" @onclick='() => _fichaTab = "documentos"'>Documentos</button>
                </div>

                <div class="cpe-body">
                    @* ===== DETALLE: campos de la unidad, edicion inline (misma tabla Unidades Privadas) ===== *@
                    @if (_fichaTab == "detalle")
                    {
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-home"></i> @AliasCampo("num", "ID UNIDAD")</label>
                            <input class="cpe-fin" value="@IdUnidad" disabled />
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-apps"></i> @AliasCampo("tipo", "TIPO")</label>
                            @if (_editMode) { <select class="cpe-fin" @bind="_edit.TipoKey">@foreach (var t in TiposUnidadSel) { <option value="@($"e:{t}")">@TipoLabel(t)</option> }@if (TiposCustomVisibles().Count > 0) { <optgroup label="Tipos propios">@foreach (var tc in TiposCustomVisibles()) { <option value="@($"c:{tc.Id}")">@tc.Nombre</option> }</optgroup> }</select> } else { <input class="cpe-fin" value="@LabelU(_selected)" disabled /> }
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-calculator"></i> @AliasCampo("coef", "COEFICIENTE")</label>
                            @if (_editMode) { <input type="number" step="0.0001" class="cpe-fin" @bind="_edit.CoeficientePropiedad" /> } else { <input class="cpe-fin" value="@($"{_selected.CoeficientePropiedad.ToString("0.####")}%")" disabled /> }
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-ruler-combined"></i> @AliasCampo("area", "AREA")</label>
                            @if (_editMode) { <input type="number" step="0.01" class="cpe-fin" @bind="_edit.AreaM2" /> } else { <input class="cpe-fin" value="@(_selected.AreaM2.HasValue ? $"{_selected.AreaM2.Value:0.##} m2" : "-")" disabled /> }
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-flag"></i> @AliasCampo("estado", "ESTADO")</label>
                            @if (_editMode) { <select class="cpe-fin" @bind="_edit.Estado"><option value="">- Sin definir -</option>@foreach (var eo in EstadosConVigente(_edit.Estado)) { <option value="@eo">@eo</option> }</select> } else { <input class="cpe-fin" value="@(string.IsNullOrWhiteSpace(_selected.Estado) ? "-" : _selected.Estado)" disabled /> }
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-document"></i> @AliasCampo("matricula", "MATRICULA")</label>
                            @if (_editMode) { <input class="cpe-fin" @bind="_edit.MatriculaInmobiliaria" /> } else { <input class="cpe-fin" value="@(string.IsNullOrWhiteSpace(_selected.MatriculaInmobiliaria) ? "-" : _selected.MatriculaInmobiliaria)" disabled /> }
                        </div>
                        @foreach (var c in _campos)
                        {
                            var cc = c;
                            <div class="cpe-field">
                                <label class="cpe-flabel"><i class="fi fi-rr-settings-sliders"></i> @c.Label</label>
                                @if (_editMode)
                                {
                                    @switch (c.Tipo)
                                    {
                                        case TipoCampoTablero.Seleccion:
                                            <select class="cpe-fin" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())">
                                                <option value="">- elegir -</option>
                                                @foreach (var op in c.OpcionesLista) { <option value="@op">@op</option> }
                                            </select>
                                            break;
                                        case TipoCampoTablero.Numero:
                                        case TipoCampoTablero.Moneda:
                                            <input class="cpe-fin" type="number" step="any" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" placeholder="Sin dato" />
                                            break;
                                        case TipoCampoTablero.Fecha:
                                            <input class="cpe-fin" type="date" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" />
                                            break;
                                        case TipoCampoTablero.AreaTexto:
                                            <textarea class="cpe-fin" rows="2" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" placeholder="Sin dato">@c.Valor</textarea>
                                            break;
                                        case TipoCampoTablero.Booleano:
                                            <select class="cpe-fin" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())">
                                                <option value="">- elegir -</option>
                                                <option value="Si">Si</option>
                                                <option value="No">No</option>
                                            </select>
                                            break;
                                        default:
                                            <input class="cpe-fin" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" placeholder="Sin dato" />
                                            break;
                                    }
                                }
                                else
                                {
                                    <input class="cpe-fin" value="@(string.IsNullOrWhiteSpace(c.Valor) ? "-" : c.Valor)" disabled />
                                }
                            </div>
                        }
                        @if (_editMode && _cfOpen)
                        {
                            <div class="gum-cf-form" style="margin-top:12px;">
                                <input class="gum-input" @bind="_cfLabel" @bind:event="oninput" placeholder="Nombre del campo (ej. N de medidor)" />
                                <input class="gum-input" @bind="_cfValor" @bind:event="oninput" placeholder="Valor (opcional)" />
                                <button class="gum-btn-brand" type="button" @onclick="AgregarCampoPersonalizado" disabled="@(_busy || string.IsNullOrWhiteSpace(_cfLabel))">Crear campo</button>
                            </div>
                        }
                        else if (_editMode)
                        {
                            <button class="cpe-addfield" type="button" @onclick="() => _cfOpen = true"><i class="fi fi-rr-plus"></i> Agregar campo</button>
                        }

                    }

                    @* ===== UNIDADES ANEXAS: pestana propia (parqueaderos, depositos, etc. vinculados).
                           Cada anexa es un registro Unidad con los MISMOS campos; aqui se vincula, crea,
                           edita y mueve a otra unidad privada. Diseno .cpe-anx-* (maqueta editor-ficha). ===== *@
                    @if (_fichaTab == "anexas")
                    {
                        <div class="gum-unit-eyebrow">UNIDADES ANEXAS</div>
                        <p class="cpe-anx-help">Parqueaderos, depósitos y demás unidades vinculadas a esta unidad privada. Cada unidad anexa tiene los <b>mismos campos</b> de la tabla Unidades Privadas; desde aquí las vinculas, las creas, las <b>editas</b> o las <b>mueves</b> a otra unidad privada.</p>
                        @if (_vinculos.Count == 0)
                        {
                            <div class="gum-tab-empty">Sin unidades anexas vinculadas todavía.</div>
                        }
                        else
                        {
                            <div class="cpe-anx-list">
                                @foreach (var v in _vinculos)
                                {
                                    var vv = v;
                                    var au = AnexaUnidad(v.UnidadAsociadaId);
                                    <div class="cpe-anx-item">
                                        <span class="cpe-anx-ic"><i class="fi @AnexIcon(v.AsociadaTipo)"></i></span>
                                        <div class="cpe-anx-id">
                                            <div class="cpe-anx-nm">@TipoLabel(v.AsociadaTipo) @v.AsociadaNumero</div>
                                            <div class="cpe-anx-sub">@AnexSubtitulo(v, au)</div>
                                        </div>
                                        <button class="cpe-anx-x" type="button" title="Opciones" @onclick="() => ToggleAnxMenu(vv.Id)">
                                            <i class="fi fi-rr-menu-dots"></i>
                                        </button>
                                        @if (_anxMenu == v.Id)
                                        {
                                            <div class="cpe-anx-menu" @onclick:stopPropagation="true">
                                                @if (_anxMoveOpen)
                                                {
                                                    @if (AnexMoverDestinos().Count == 0)
                                                    {
                                                        <div class="cpe-anx-menu-empty">No hay otras unidades privadas</div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var dest in AnexMoverDestinos())
                                                        {
                                                            var dd = dest;
                                                            <button type="button" class="cpe-anx-menu-it" @onclick="() => MoverAnexa(vv, dd)"><i class="fi fi-rr-home"></i> @LabelU(dd) @dd.Numero</button>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <button type="button" class="cpe-anx-menu-it" @onclick="() => AbrirEditarAnexa(vv)"><i class="fi fi-rr-pencil"></i> Editar</button>
                                                    <button type="button" class="cpe-anx-menu-it" @onclick="() => _anxMoveOpen = true"><i class="fi fi-rr-exchange"></i> Mover a otra unidad privada</button>
                                                    <div class="cpe-anx-menu-sep"></div>
                                                    <button type="button" class="cpe-anx-menu-it cpe-anx-menu-it--danger" @onclick="() => AbrirEliminarAnexa(vv)"><i class="fi fi-rr-trash"></i> Eliminar</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (!_anxFormOpen)
                        {
                            <button class="cpe-addfield" type="button" @onclick="AbrirAltaAnexa"><i class="fi fi-rr-plus"></i> Agregar unidad anexa</button>
                        }
                        else
                        {
                            <div class="cpe-anx-form">
                                <div class="gum-unit-eyebrow" style="margin-top:0">@(_anxEditId is null ? "NUEVA UNIDAD ANEXA" : "EDITAR UNIDAD ANEXA")</div>
                                <div class="cpe-field">
                                    <label class="cpe-flabel"><i class="fi fi-rr-home"></i> Unidad</label>
                                    <input class="cpe-fin" @bind="_anx.Numero" placeholder="Ej. PQ-012" @ref="_anxFirstInput" />
                                </div>
                                <div class="cpe-field">
                                    <label class="cpe-flabel"><i class="fi fi-rr-apps"></i> Tipo</label>
                                    <select class="cpe-fin" @bind="_anx.TipoKey">
                                        @foreach (var t in TiposUnidadSel) { <option value="@($"e:{t}")">@TipoLabel(t)</option> }
                                        @if (TiposCustomVisibles().Count > 0) { <optgroup label="Tipos propios">@foreach (var tc in TiposCustomVisibles()) { <option value="@($"c:{tc.Id}")">@tc.Nombre</option> }</optgroup> }
                                    </select>
                                </div>
                                <div class="cpe-field">
                                    <label class="cpe-flabel"><i class="fi fi-rr-layers"></i> @PisoLabelSingular</label>
                                    <input type="number" class="cpe-fin" @bind="_anx.Piso" />
                                </div>
                                <div class="cpe-field">
                                    <label class="cpe-flabel"><i class="fi fi-rr-ruler-combined"></i> Área m2</label>
                                    <input type="number" step="0.01" class="cpe-fin" @bind="_anx.AreaM2" />
                                </div>
                                <div class="cpe-field">
                                    <label class="cpe-flabel"><i class="fi fi-rr-calculator"></i> Coeficiente</label>
                                    <input type="number" step="0.0001" class="cpe-fin" @bind="_anx.CoeficientePropiedad" />
                                </div>
                                <div class="cpe-anx-actions">
                                    <button class="gum-btn-ghost" type="button" @onclick="CerrarAnxForm" disabled="@_busy">Cancelar</button>
                                    <button class="gum-btn-brand" type="button" @onclick="GuardarAnexa" disabled="@(_busy || string.IsNullOrWhiteSpace(_anx.Numero))">
                                        <i class="fi @(_anxEditId is null ? "fi-rr-check" : "fi-rr-disk")"></i> @(_anxEditId is null ? "Crear y vincular" : "Guardar cambios")
                                    </button>
                                </div>
                            </div>
                        }
                    }


                @* === BITACORA DE CAMBIOS (RN-06): eventos automaticos de la unidad === *@
                @if (_fichaTab == "historial") {
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-unit-eyebrow">BITÁCORA DE CAMBIOS</div>
                    @if (_bitacora.Count == 0)
                    {
                        <div class="gum-hist-empty">Sin cambios registrados en la unidad todavia.</div>
                    }
                    else
                    {
                        <div class="gum-bit-list">
                            @foreach (var b in _bitacora)
                            {
                                <div class="gum-bit-item">
                                    <span class="gum-bit-dot"></span>
                                    <div class="gum-bit-body">
                                        <div class="gum-bit-txt">@b.Descripcion</div>
                                        <div class="gum-bit-meta">@b.Fecha.ToCo().ToString("dd MMM yyyy · HH:mm")@(string.IsNullOrWhiteSpace(b.Autor) ? "" : $" · {b.Autor}")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                }

                @* === DOCUMENTOS: pestana propia (movido desde Historial) === *@
                @if (_fichaTab == "documentos") {
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">DOCUMENTOS</div>
                    @if (_documentos.Count > 0)
                    {
                        <div class="gum-doc-list">
                            @foreach (var d in _documentos)
                            {
                                <div class="gum-doc-item">
                                    <a class="gum-doc-link" href="@d.Url" target="_blank" rel="noopener" title="@d.Nombre">
                                        @if (EsImagen(d.Nombre))
                                        {
                                            <span class="gum-doc-thumb" style="background-image:url('@d.Url')"></span>
                                        }
                                        else
                                        {
                                            <span class="gum-doc-ic">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                            </span>
                                        }
                                        <span class="gum-doc-meta">
                                            <span class="gum-doc-name">@d.Nombre</span>
                                            <span class="gum-doc-sub">@FmtTamano(d.Tamano) · ver</span>
                                        </span>
                                    </a>
                                    @if (_editMode)
                                    {
                                        <button class="gum-cf-del gum-doc-x" type="button" @onclick="() => EliminarDocumento(d.Id)" title="Quitar">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_editMode)
                    {
                        <label class="gum-doc-upload">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
                            @(_subiendoDoc ? "Subiendo..." : "Subir documentos")
                            <InputFile OnChange="SubirDocumento" accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx" multiple hidden disabled="@_subiendoDoc" />
                        </label>
                    }
                    @if (_documentos.Count == 0 && !_editMode)
                    {
                        <div class="gum-people-empty">Sin documentos. Entra a "Editar ficha" para adjuntar anexos.</div>
                    }
                </div>
                }

            </div>
            </div>
        }
    </div>
</div>

@* ====== CONFIRMACION DE BORRADO (doble comprobacion) ======
   Accion destructiva e irreversible: exige escribir el codigo EXACTO de la unidad para habilitar
   el boton final. Asi un clic accidental no basta para borrar. *@
@if (_confirmDel && _selected is not null)
{
    <div class="gum-cdel-overlay" @onclick="CerrarConfirmEliminar">
        <div class="gum-cdel-card" @onclick:stopPropagation="true">
            <div class="gum-cdel-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
            </div>
            <div class="gum-cdel-title">Eliminar unidad</div>
            <div class="gum-cdel-sub">
                Vas a eliminar <b>@LabelU(_selected) @_selected.Numero</b>.
                Esta accion es <b>permanente y no se puede deshacer</b>. Se perderan sus datos de ficha,
                registros y documentos de esta unidad.
            </div>
            <div class="gum-cdel-warn">
                Si la unidad tiene movimientos de cartera, PQRSD o reservas, el sistema NO la eliminara
                (primero hay que desvincular esos registros).
            </div>
            <div class="gum-cdel-confirm">
                <label class="gum-cdel-lbl">Para confirmar, escribe el código de la unidad: <b>@_selected.Numero</b></label>
                <input class="gum-cdel-inp" @bind="_confirmText" @bind:event="oninput"
                       placeholder="@_selected.Numero" autocomplete="off" disabled="@_busy" />
            </div>
            @if (!string.IsNullOrEmpty(_msg) && _msgError)
            {
                <div class="gum-cdel-err">@_msg</div>
            }
            <div class="gum-cdel-actions">
                <button class="gum-cdel-cancel" type="button" @onclick="CerrarConfirmEliminar" disabled="@_busy">Cancelar</button>
                <button class="gum-cdel-go" type="button" @onclick="ConfirmarEliminarUnidad"
                        disabled="@(_busy || !ConfirmCoincide)" title="@(ConfirmCoincide ? "Eliminar definitivamente" : "Escribe el codigo exacto para habilitar")">
                    @(_busy ? "Eliminando..." : "Eliminar definitivamente")
                </button>
            </div>
        </div>
    </div>
}

@* ====== CONFIRMACION: eliminar una UNIDAD ANEXA completa (no solo desvincular) ====== *@
@if (_anxConfirmDel && _anxDelVinculo is not null)
{
    <div class="gum-cdel-overlay" @onclick="() => { _anxConfirmDel = false; _anxDelVinculo = null; }">
        <div class="gum-cdel-card" @onclick:stopPropagation="true">
            <div class="gum-cdel-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
            </div>
            <div class="gum-cdel-title">Eliminar unidad anexa</div>
            <div class="gum-cdel-sub">
                Vas a eliminar <b>@TipoLabel(_anxDelVinculo.AsociadaTipo) @_anxDelVinculo.AsociadaNumero</b> de la copropiedad
                (no solo el vínculo). Esta acción es <b>permanente y no se puede deshacer</b>.
            </div>
            @if (!string.IsNullOrEmpty(_msg) && _msgError)
            {
                <div class="gum-cdel-err">@_msg</div>
            }
            <div class="gum-cdel-actions">
                <button class="gum-cdel-cancel" type="button" @onclick="() => { _anxConfirmDel = false; _anxDelVinculo = null; }" disabled="@_busy">Cancelar</button>
                <button class="gum-cdel-go" type="button" @onclick="EliminarAnexaConfirmada" disabled="@_busy">@(_busy ? "Eliminando..." : "Eliminar definitivamente")</button>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public string AgrupacionLabelSingular { get; set; } = "Torre";
    [Parameter] public string PisoLabelSingular { get; set; } = "Piso";
    /// <summary>Abre directamente la ficha de esta unidad (lo usa la tabla de Distribucion al
    /// hacer clic en una fila). Sin valor, el modal abre en el estado vacio de siempre.</summary>
    [Parameter] public Guid? UnidadInicialId { get; set; }

    /// <summary>
    /// Oculta el panel izquierdo (arbol de torres) al abrir, dejando la ficha a todo el ancho.
    /// Se usa cuando ya se eligio la unidad (clic en una fila de Unidades Privadas): el arbol es
    /// redundante. El usuario puede traerlo de vuelta con el boton de lista de la cabecera.
    /// </summary>
    [Parameter] public bool OcultarArbol { get; set; }

    private List<UnidadDto> _unidades = new();
    private UnidadDto? _selected;
    private List<UnidadVinculoDto> _vinculos = new();
    private CuotaConsolidadaDto? _cuota;
    private bool _editMode;
    private bool _nuevaUnidad;   // ficha en modo alta (crear = editar, misma ficha)
    private EditUnidadForm _edit = new();

    // Inmuebles vinculados - form para agregar
    private Guid _nuevoVinculoUnidadId;
    private bool _nuevoVinculoFactura;

    // Campos personalizados (Ficha tecnica)
    private List<CampoVM> _campos = new();  // definiciones (tenant) + valor de la unidad seleccionada
    private bool _cfOpen;
    private string _cfLabel = "";
    private string _cfValor = "";

    private List<UnidadDocumentoDto> _documentos = new();
    private bool _subiendoDoc;

    // Prototipo v3 - bloques nuevos de la ficha de inmueble
    private List<UnidadArriendoDto> _arriendos = new();
    private string _nuevoArrConcepto = "";
    private decimal? _nuevoArrValor;
    private string _nuevoArrRef = "";


    private class CampoVM
    {
        public Guid DefinicionId { get; set; }
        public string Label { get; set; } = "";
        public int Orden { get; set; }
        public string? Valor { get; set; }
        public TipoCampoTablero Tipo { get; set; } = TipoCampoTablero.Texto;
        public string? Opciones { get; set; }
        // Parser compartido (JSON nuevo {"K","Oculta","Color"} o texto-por-linea legado); solo visibles.
        public string[] OpcionesLista => OpcionCampo.VisiblesK(Opciones);
    }

    // Los estados posibles vienen de la config del tenant (EstadosConfig, semilla Habitada/Desocupada/Arrendada).

    // ===== Ficha por tabs =====
    private string _fichaTab = "detalle";
    // El codigo de la unidad ES su Numero (texto libre).
    private string IdUnidad => _selected?.Numero ?? "";

    private List<BitacoraEntradaDto> _bitacora = new();

    // ===== Unidades anexas (pestana propia). Un vinculo liga _selected (padre) a una Unidad anexa. =====
    private bool _anxFormOpen;
    private Guid? _anxEditId;              // null = alta; id de la Unidad anexa en edicion
    private EditUnidadForm _anx = new();
    private Guid? _anxMenu;                // vinculo con el menu ... abierto
    private bool _anxMoveOpen;             // submenu "Mover" abierto
    private ElementReference _anxFirstInput;
    private bool _anxFocusPending;
    private bool _anxConfirmDel;
    private UnidadVinculoDto? _anxDelVinculo;
    private class EditUnidadForm
    {
        public string Codigo { get; set; } = "";   // solo en modo "nueva unidad": mascara TORRE-APARTAMENTO (A1-202)
        public string Numero { get; set; } = "";
        public TipoUnidad Tipo { get; set; } = TipoUnidad.Apartamento;
        public Guid? TipoCustomId { get; set; }
        // Clave combinada para el <select> de tipo: "e:<enum>" (base) o "c:<guid>" (propio).
        public string TipoKey
        {
            get => TipoCustomId is { } g ? $"c:{g}" : $"e:{Tipo}";
            set
            {
                if (!string.IsNullOrEmpty(value) && value.StartsWith("c:") && Guid.TryParse(value[2..], out var g)) { TipoCustomId = g; }
                else { TipoCustomId = null; if (value?.StartsWith("e:") == true && Enum.TryParse<TipoUnidad>(value[2..], out var t)) Tipo = t; }
            }
        }
        public int? Piso { get; set; }
        public decimal CoeficientePropiedad { get; set; }
        public decimal? AreaM2 { get; set; }
        public int? Habitaciones { get; set; }
        public int? Banos { get; set; }
        public int? Parqueaderos { get; set; }
        public string? Estado { get; set; }
        public string? Observaciones { get; set; }
        public string? MatriculaInmobiliaria { get; set; }
        public bool PagaAdministracion { get; set; } = true;
        public decimal? CuotaMensual { get; set; }
    }
    private bool _huboCambios;
    private bool _busy;
    private string _msg = "";
    private bool _msgError;
    private bool _confirmDel;         // panel de confirmacion de borrado abierto (doble comprobacion)
    private string _confirmText = ""; // texto tecleado; debe coincidir con el numero de la unidad

    private string AgrupacionLabelPlural => AgrupacionLabelSingular + "s";

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        // Entrada desde la tabla de Distribucion: con UnidadInicialId abre la ficha de esa unidad;
        // sin ella (o si no se encuentra), abre en modo "nueva unidad" (misma ficha, vacia).
        if (UnidadInicialId is Guid id)
        {
            var u = _unidades.FirstOrDefault(x => x.Id == id);
            if (u is not null) await SeleccionarUnidad(u);
            else IniciarNuevaUnidad();
        }
        else
        {
            IniciarNuevaUnidad();
        }
    }

    private void IniciarNuevaUnidad()
    {
        _nuevaUnidad = true;
        _selected = null;
        _editMode = true;
        _edit = new EditUnidadForm();
        _msg = "";
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            try { _tiposCustom = await http.GetFromJsonAsync<List<TipoUnidadCustomDto>>("/api/mi-copropiedad/tipos-unidad") ?? new(); } catch { _tiposCustom = new(); }
            try { _camposConfig = (await http.GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config") ?? new()).ToDictionary(c => c.CampoClave); } catch { _camposConfig = new(); }
            AplicarOrdenTiposCustom();   // mismo orden de tipos propios que en la tabla (config del campo 'tipo')
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    private async Task SeleccionarUnidad(UnidadDto u)
    {
        _selected = u;
        _nuevaUnidad = false;
        _editMode = false;
        _vinculos.Clear();
        _cuota = null;
        _campos.Clear();
        _documentos.Clear();
        _subiendoDoc = false;
        _arriendos.Clear();
        _nuevoArrConcepto = ""; _nuevoArrValor = null; _nuevoArrRef = "";
        _cfLabel = ""; _cfValor = "";
        _cfOpen = false;
        _nuevoVinculoUnidadId = Guid.Empty;
        _nuevoVinculoFactura = false;
        try
        {
            _vinculos = await Auth().GetFromJsonAsync<List<UnidadVinculoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/vinculos") ?? new();
        }
        catch { /* sin vinculos */ }
        try
        {
            _cuota = await Auth().GetFromJsonAsync<CuotaConsolidadaDto>($"/api/mi-copropiedad/unidades/{u.Id}/cuota-consolidada");
        }
        catch { _cuota = null; }
        await CargarCamposAsync();
        try
        {
            _documentos = await Auth().GetFromJsonAsync<List<UnidadDocumentoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/documentos") ?? new();
        }
        catch { _documentos = new(); }
        try { _arriendos = await Auth().GetFromJsonAsync<List<UnidadArriendoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/arriendos") ?? new(); }
        catch { _arriendos = new(); }
        try { _bitacora = await Auth().GetFromJsonAsync<List<BitacoraEntradaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/bitacora") ?? new(); }
        catch { _bitacora = new(); }
    }

    // Recarga solo la bitacora (tras un cambio inline/edicion) para reflejar el nuevo evento.
    private async Task RecargarBitacoraAsync()
    {
        if (_selected is null) return;
        try { _bitacora = await Auth().GetFromJsonAsync<List<BitacoraEntradaDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/bitacora") ?? new(); }
        catch { }
    }

    private async Task CargarCamposAsync()
    {
        if (_selected is null) { _campos = new(); return; }
        try
        {
            var dtos = await Auth().GetFromJsonAsync<List<UnidadCampoDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/campos") ?? new();
            _campos = dtos.Select(d => new CampoVM { DefinicionId = d.DefinicionId, Label = d.Label, Orden = d.Orden, Valor = d.Valor, Tipo = d.Tipo, Opciones = d.Opciones }).ToList();
        }
        catch { _campos = new(); }
    }

    // ===== Prototipo v3: handlers de los bloques nuevos de la ficha de inmueble =====

    private async Task AgregarArriendo()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_nuevoArrConcepto) || _nuevoArrValor is not decimal val) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/arriendos",
                new CrearUnidadArriendoRequest(_nuevoArrConcepto.Trim(), val, string.IsNullOrWhiteSpace(_nuevoArrRef) ? null : _nuevoArrRef.Trim()));
            if (resp.IsSuccessStatusCode)
            {
                _arriendos = await Auth().GetFromJsonAsync<List<UnidadArriendoDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/arriendos") ?? _arriendos;
                _nuevoArrConcepto = ""; _nuevoArrValor = null; _nuevoArrRef = "";
            }
            else { ShowMsg(await resp.Content.ReadAsStringAsync(), true); }
        }
        finally { _busy = false; }
    }

    private async Task EliminarArriendo(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-arriendos/{id}");
        if (resp.IsSuccessStatusCode) _arriendos.RemoveAll(a => a.Id == id);
    }

    private void EntrarEdicion()
    {
        if (_selected is null) return;
        _edit = new EditUnidadForm
        {
            Numero = _selected.Numero,
            Tipo = _selected.Tipo,
            TipoCustomId = _selected.TipoCustomId,
            Piso = _selected.Piso,
            CoeficientePropiedad = _selected.CoeficientePropiedad,
            AreaM2 = _selected.AreaM2,
            Habitaciones = _selected.Habitaciones,
            Banos = _selected.Banos,
            Parqueaderos = _selected.Parqueaderos,
            Estado = _selected.Estado,
            Observaciones = _selected.Observaciones,
            MatriculaInmobiliaria = _selected.MatriculaInmobiliaria,
            PagaAdministracion = _selected.PagaAdministracion,
            CuotaMensual = _selected.CuotaMensual
        };
        _editMode = true;
    }

    private void CancelarEdicion()
    {
        // En modo alta, Cancelar cierra el modal (no hay ficha previa a la que volver).
        if (_nuevaUnidad) { Close(_huboCambios); return; }
        _editMode = false;
        _cfOpen = false;
    }

    private async Task GuardarUnidad()
    {
        if (_nuevaUnidad) { await CrearUnidadDesdeFichaAsync(); return; }
        if (_selected is null) return;
        if (string.IsNullOrWhiteSpace(_edit.Numero)) { ShowMsg("Número obligatorio.", true); return; }
        _busy = true;
        var req = new ActualizarUnidadRequest(
            _edit.Numero.Trim(), _edit.Tipo, _edit.Piso,
            _edit.CoeficientePropiedad, _edit.AreaM2,
            _edit.Habitaciones, _edit.Banos, _edit.Parqueaderos,
            string.IsNullOrWhiteSpace(_edit.Estado) ? null : _edit.Estado,
            string.IsNullOrWhiteSpace(_edit.Observaciones) ? null : _edit.Observaciones,
            string.IsNullOrWhiteSpace(_edit.MatriculaInmobiliaria) ? null : _edit.MatriculaInmobiliaria,
            _edit.PagaAdministracion, _edit.CuotaMensual, TipoCustomId: _edit.TipoCustomId);
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}", req);
        if (resp.IsSuccessStatusCode)
        {
            var actualizada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
            if (actualizada is not null)
            {
                _selected = actualizada;
                var idx = _unidades.FindIndex(u => u.Id == actualizada.Id);
                if (idx >= 0) _unidades[idx] = actualizada;
            }
            _editMode = false;
            _huboCambios = true;
            ShowMsg($"Unidad {actualizada?.Numero} actualizada.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    // Crea la unidad desde la ficha (modo alta). El codigo de la unidad ES su Numero (texto libre):
    // se guarda tal cual lo escribio el usuario, con la validacion de duplicados en el backend.
    private async Task CrearUnidadDesdeFichaAsync()
    {
        var numero = (_edit.Codigo ?? "").Trim();
        if (numero.Length == 0) { ShowMsg("Escribe el codigo de la unidad (ej. A1-202).", true); return; }

        _busy = true;
        var req = new CrearUnidadRequest(
            numero, _edit.Tipo, _edit.Piso,
            _edit.CoeficientePropiedad, _edit.AreaM2,
            null, null, null,
            string.IsNullOrWhiteSpace(_edit.Estado) ? null : _edit.Estado, null,
            string.IsNullOrWhiteSpace(_edit.MatriculaInmobiliaria) ? null : _edit.MatriculaInmobiliaria,
            TipoCustomId: _edit.TipoCustomId);
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
        if (!resp.IsSuccessStatusCode)
        {
            string msg;
            try { var e = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); msg = e != null && e.TryGetValue("error", out var m) ? m : "No se pudo crear."; }
            catch { msg = "No se pudo crear."; }
            ShowMsg(msg, true); _busy = false; return;
        }
        var creada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
        _huboCambios = true;
        await CargarAsync();
        _busy = false;
        if (creada is not null)
        {
            await SeleccionarUnidad(creada);   // pasa a la ficha completa de la unidad creada
            ShowMsg($"Unidad {creada.Numero} creada.", false);
        }
    }

    // Unidades que pueden vincularse como anexo de la actual: otra unidad, que no sea ya anexo de nadie
    // y que no este ya vinculada aqui.
    private IEnumerable<UnidadDto> AnexosCandidatos()
        => _selected is null
            ? Enumerable.Empty<UnidadDto>()
            : _unidades.Where(u => u.Id != _selected.Id && u.PrincipalId is null
                                   && !_vinculos.Any(v => v.UnidadAsociadaId == u.Id))
                       .OrderBy(u => u.Numero, StringComparer.OrdinalIgnoreCase);

    private async Task AgregarVinculo()
    {
        if (_selected is null || _nuevoVinculoUnidadId == Guid.Empty) return;
        var req = new CrearVinculoUnidadRequest(_nuevoVinculoUnidadId, _nuevoVinculoFactura);
        var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/vinculos", req);
        if (resp.IsSuccessStatusCode)
        {
            var v = await resp.Content.ReadFromJsonAsync<UnidadVinculoDto>();
            if (v is not null) _vinculos.Add(v);
            _nuevoVinculoUnidadId = Guid.Empty;
            _nuevoVinculoFactura = false;
            _huboCambios = true;
        }
        else
        {
            ShowMsg("No se pudo vincular: " + await resp.Content.ReadAsStringAsync(), true);
        }
    }

    private async Task EliminarVinculo(Guid vinculoId)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/vinculos/{vinculoId}");
        if (resp.IsSuccessStatusCode)
        {
            _vinculos.RemoveAll(v => v.Id == vinculoId);
            _huboCambios = true;
        }
    }

    // ===== Unidades anexas (pestana propia): helpers + CRUD (reusa vinculos + unidades) =====
    private UnidadDto? AnexaUnidad(Guid id) => _unidades.FirstOrDefault(u => u.Id == id);

    private static string AnexIcon(TipoUnidad t) => t switch
    {
        TipoUnidad.Parqueadero => "fi-rr-parking",
        TipoUnidad.Deposito => "fi-rr-box",
        TipoUnidad.Local => "fi-rr-shop",
        _ => "fi-rr-home",
    };

    private string AnexSubtitulo(UnidadVinculoDto v, UnidadDto? u)
    {
        var parts = new List<string> { TipoLabel(v.AsociadaTipo) };
        if (u?.Piso is int p) parts.Add($"{PisoLabelSingular.ToLower()} {p}");
        if (u?.AreaM2 is decimal a) parts.Add($"{a:0.##} m2");
        if (u is not null) parts.Add($"coef {u.CoeficientePropiedad:0.####}");
        return string.Join(" · ", parts);
    }

    private void ToggleAnxMenu(Guid vinculoId)
    {
        _anxMenu = _anxMenu == vinculoId ? (Guid?)null : vinculoId;
        _anxMoveOpen = false;
    }

    // Otras unidades privadas (principales) a las que se puede mover la anexa.
    private List<UnidadDto> AnexMoverDestinos()
        => _selected is null ? new()
           : _unidades.Where(u => u.Id != _selected.Id && u.PrincipalId is null)
                      .OrderBy(u => u.Numero, StringComparer.OrdinalIgnoreCase).Take(14).ToList();

    private void AbrirAltaAnexa()
    {
        _anxEditId = null;
        _anx = new EditUnidadForm { Tipo = TipoUnidad.Parqueadero, TipoKey = "e:Parqueadero" };
        _anxFormOpen = true; _anxMenu = null; _anxFocusPending = true;
    }

    private void AbrirEditarAnexa(UnidadVinculoDto v)
    {
        var u = AnexaUnidad(v.UnidadAsociadaId);
        _anxEditId = v.UnidadAsociadaId;
        _anx = new EditUnidadForm
        {
            Numero = u?.Numero ?? v.AsociadaNumero,
            Tipo = u?.Tipo ?? v.AsociadaTipo,
            TipoCustomId = u?.TipoCustomId,
            TipoKey = u?.TipoCustomId is Guid cg ? $"c:{cg}" : $"e:{(u?.Tipo ?? v.AsociadaTipo)}",
            Piso = u?.Piso,
            AreaM2 = u?.AreaM2,
            CoeficientePropiedad = u?.CoeficientePropiedad ?? 0m,
        };
        _anxFormOpen = true; _anxMenu = null; _anxFocusPending = true;
    }

    private void CerrarAnxForm() { _anxFormOpen = false; _anxEditId = null; }

    private async Task RefrescarFichaSelAsync()
    {
        await CargarAsync();
        if (_selected is not null)
        {
            var refreshed = _unidades.FirstOrDefault(x => x.Id == _selected.Id);
            if (refreshed is not null) await SeleccionarUnidad(refreshed);
        }
        _fichaTab = "anexas";
    }

    private async Task GuardarAnexa()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_anx.Numero)) return;
        _busy = true;
        try
        {
            var tipo = _anx.Tipo;
            var custom = _anx.TipoCustomId;
            if (_anxEditId is Guid editId)
            {
                var req = new ActualizarUnidadRequest(
                    _anx.Numero.Trim(), tipo, _anx.Piso,
                    _anx.CoeficientePropiedad, _anx.AreaM2,
                    null, null, null, null, null, null, true, null, null, custom);
                var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{editId}", req);
                if (!resp.IsSuccessStatusCode) { ShowMsg("No se pudo guardar: " + await resp.Content.ReadAsStringAsync(), true); return; }
                _huboCambios = true;
                await RefrescarFichaSelAsync();
                ShowMsg("Unidad anexa actualizada.", false);
            }
            else
            {
                var req = new CrearUnidadRequest(
                    _anx.Numero.Trim(), tipo, _anx.Piso,
                    _anx.CoeficientePropiedad, _anx.AreaM2,
                    null, null, null, null, null, null, TipoCustomId: custom);
                var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
                if (!resp.IsSuccessStatusCode) { ShowMsg("No se pudo crear: " + await resp.Content.ReadAsStringAsync(), true); return; }
                var creada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
                if (creada is not null)
                {
                    await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/vinculos",
                        new CrearVinculoUnidadRequest(creada.Id, false));
                }
                _huboCambios = true;
                await RefrescarFichaSelAsync();
                ShowMsg("Unidad anexa creada y vinculada.", false);
            }
            CerrarAnxForm();
        }
        finally { _busy = false; }
    }

    private async Task MoverAnexa(UnidadVinculoDto v, UnidadDto destino)
    {
        _anxMenu = null; _anxMoveOpen = false;
        _busy = true;
        try
        {
            var del = await Auth().DeleteAsync($"/api/mi-copropiedad/vinculos/{v.Id}");
            if (!del.IsSuccessStatusCode) { ShowMsg("No se pudo mover: " + await del.Content.ReadAsStringAsync(), true); return; }
            _vinculos.RemoveAll(x => x.Id == v.Id);
            await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{destino.Id}/vinculos",
                new CrearVinculoUnidadRequest(v.UnidadAsociadaId, v.IncluyeEnFacturacion));
            _huboCambios = true;
            ShowMsg($"Anexa {v.AsociadaNumero} movida a {destino.Numero}.", false);
        }
        finally { _busy = false; }
    }

    private void AbrirEliminarAnexa(UnidadVinculoDto v)
    {
        _anxMenu = null;
        _anxDelVinculo = v;
        _anxConfirmDel = true;
    }

    private async Task EliminarAnexaConfirmada()
    {
        if (_selected is null || _anxDelVinculo is null) return;
        _busy = true;
        try
        {
            var anexaId = _anxDelVinculo.UnidadAsociadaId;
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades/{anexaId}");
            if (!resp.IsSuccessStatusCode) { ShowMsg("No se pudo eliminar: " + await resp.Content.ReadAsStringAsync(), true); return; }
            _vinculos.RemoveAll(x => x.UnidadAsociadaId == anexaId);
            _huboCambios = true;
            await RefrescarFichaSelAsync();
            ShowMsg("Unidad anexa eliminada.", false);
        }
        finally { _busy = false; _anxConfirmDel = false; _anxDelVinculo = null; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_anxFocusPending)
        {
            _anxFocusPending = false;
            try { await _anxFirstInput.FocusAsync(); } catch { }
        }
    }

    private async Task AgregarCampoPersonalizado()
    {
        if (string.IsNullOrWhiteSpace(_cfLabel)) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades-campos",
                new CrearCampoDefinicionRequest(_cfLabel.Trim()));
            if (!resp.IsSuccessStatusCode) { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); return; }
            var def = await resp.Content.ReadFromJsonAsync<UnidadCampoDefinicionDto>();
            await CargarCamposAsync();  // recarga catalogo (incluye el nuevo) + valores de esta unidad
            // Si capturaron un valor inicial para esta unidad, lo guardamos
            if (def is not null && !string.IsNullOrWhiteSpace(_cfValor) && _selected is not null)
            {
                var valor = _cfValor.Trim();
                await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/campos/{def.Id}", new SetCampoValorRequest(valor));
                var vm = _campos.FirstOrDefault(x => x.DefinicionId == def.Id);
                if (vm is not null) vm.Valor = valor;
            }
            _cfLabel = ""; _cfValor = ""; _cfOpen = false;
            _huboCambios = true;
            ShowMsg("Campo creado. Aparece en todas las unidades.", false);
        }
        finally { _busy = false; }
    }

    private async Task GuardarValorCampo(CampoVM c, string? valor)
    {
        if (_selected is null) return;
        c.Valor = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
        await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/campos/{c.DefinicionId}",
            new SetCampoValorRequest(c.Valor));
        _huboCambios = true;
    }

    private async Task EliminarCampoDefinicion(CampoVM c)
    {
        var ok = await Modals.ConfirmAsync(
            $"Quitar el campo \"{c.Label}\" de TODAS las unidades? Se perderan los valores guardados en cada una.", "Quitar campo");
        if (!ok) return;
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-campos/{c.DefinicionId}");
        if (resp.IsSuccessStatusCode)
        {
            _campos.RemoveAll(x => x.DefinicionId == c.DefinicionId);
            _huboCambios = true;
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
    }

    private async Task SubirDocumento(InputFileChangeEventArgs e)
    {
        if (_selected is null) return;
        var files = e.GetMultipleFiles(20);
        if (files.Count == 0) return;
        _subiendoDoc = true;
        try
        {
            int ok = 0; string? err = null;
            foreach (var f in files)
            {
                if (f.Size > 10_000_000) { err = $"{f.Name}: supera 10 MB."; continue; }
                using var content = new MultipartFormDataContent();
                var sc = new StreamContent(f.OpenReadStream(10_000_000));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType);
                content.Add(sc, "file", f.Name);
                var resp = await Auth().PostAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/documentos", content);
                if (resp.IsSuccessStatusCode)
                {
                    var dto = await resp.Content.ReadFromJsonAsync<UnidadDocumentoDto>();
                    if (dto is not null) _documentos.Insert(0, dto);
                    ok++;
                }
                else { err = await resp.Content.ReadAsStringAsync(); }
            }
            if (ok > 0) _huboCambios = true;
            if (err is not null) ShowMsg("Error: " + err, true);
            else ShowMsg(ok == 1 ? "Documento adjuntado." : $"{ok} documentos adjuntados.", false);
        }
        finally { _subiendoDoc = false; }
    }

    private async Task EliminarDocumento(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-documentos/{id}");
        if (resp.IsSuccessStatusCode) { _documentos.RemoveAll(d => d.Id == id); _huboCambios = true; }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
    }

    private static bool EsImagen(string nombre)
    {
        var ext = System.IO.Path.GetExtension(nombre ?? "").ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".bmp";
    }

    private static string FmtTamano(long bytes)
    {
        if (bytes <= 0) return "archivo";
        var kb = bytes / 1024.0;
        return kb >= 1024 ? $"{kb / 1024.0:0.#} MB" : $"{Math.Max(1, (int)Math.Round(kb))} KB";
    }

    private async Task Rebalancear()
    {
        _busy = true;
        var resp = await Auth().PostAsync("/api/mi-copropiedad/unidades/rebalancear-coeficientes", null);
        if (resp.IsSuccessStatusCode)
        {
            var r = await resp.Content.ReadFromJsonAsync<RebalanceoCoeficientesDto>();
            _huboCambios = true;
            await CargarAsync();
            if (_selected is not null)
            {
                var fresh = _unidades.FirstOrDefault(u => u.Id == _selected.Id);
                if (fresh is not null) _selected = fresh;
                _cuota = null;
                try { _cuota = await Auth().GetFromJsonAsync<CuotaConsolidadaDto>($"/api/mi-copropiedad/unidades/{_selected!.Id}/cuota-consolidada"); } catch { }
            }
            ShowMsg($"Rebalanceado: {r?.Apartamentos} aptos a {r?.CoefPorApartamento}% c/u. Suma {r?.SumaAnterior:0.##}% -> {r?.SumaNueva:0.##}%.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    // El backend bloquea si la unidad tiene registros asociados (guarda) y devuelve el motivo.
    // --- Borrado con doble comprobacion ---
    // Paso 1: abre el panel de confirmacion (no borra nada todavia).
    private void AbrirConfirmEliminar()
    {
        if (_selected is null) return;
        _confirmText = "";
        _msg = ""; _msgError = false;
        _confirmDel = true;
    }

    private void CerrarConfirmEliminar()
    {
        _confirmDel = false;
        _confirmText = "";
        _msg = ""; _msgError = false;
    }

    // El boton final solo se habilita si lo escrito coincide EXACTO con el numero de la unidad.
    private bool ConfirmCoincide =>
        _selected is not null &&
        string.Equals(_confirmText?.Trim(), _selected.Numero?.Trim(), StringComparison.Ordinal);

    // Paso 2: ejecuta el borrado real. Requiere que la confirmacion coincida (defensa en el cliente;
    // el backend igual valida integridad y bloquea si la unidad tiene registros asociados).
    private async Task ConfirmarEliminarUnidad()
    {
        if (_selected is null || !ConfirmCoincide) return;
        _busy = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades/{_selected.Id}");
            if (resp.IsSuccessStatusCode)
            {
                // La unidad ya no existe: cierra el modal y deja que la tabla se refresque.
                _confirmDel = false;
                _huboCambios = true;
                Close(_huboCambios);
                return;
            }
            else
            {
                string msg;
                try { var e = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); msg = e != null && e.TryGetValue("error", out var m) ? m : "No se pudo eliminar."; }
                catch { msg = "No se pudo eliminar."; }
                ShowMsg(msg, true);
            }
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    private void ShowMsg(string text, bool isError) { _msg = text; _msgError = isError; }

    // Tipos propios del tenant (catalogo) para los selectores de tipo de unidad.
    private List<TipoUnidadCustomDto> _tiposCustom = new();

    // El orden de los tipos propios lo define la copropiedad en "Configurar" y se guarda como lista
    // de ids en Opciones del campo 'tipo'. Se replica aqui para que la ficha ofrezca el mismo orden.
    private void AplicarOrdenTiposCustom()
    {
        var ord = new List<Guid>();
        if (_camposConfig.TryGetValue("tipo", out var c) && !string.IsNullOrWhiteSpace(c.Opciones))
            foreach (var o in OpcionCampo.Parse(c.Opciones))
            {
                var k = o.K.StartsWith("c:") ? o.K[2..] : o.K;   // 'tipo' guarda K = "c:{guid}" para tipos propios
                if (Guid.TryParse(k, out var g)) ord.Add(g);
            }
        _tiposCustom = _tiposCustom
            .Select(t => (t, i: ord.IndexOf(t.Id)))
            .OrderBy(x => x.i < 0 ? int.MaxValue : x.i)
            .ThenBy(x => x.t.Nombre, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.t).ToList();
    }
    // Etiqueta de una unidad: nombre del tipo propio si lo tiene, si no el enum.
    private string LabelU(UnidadDto u) => u.TipoCustomNombre ?? TipoLabel(u.Tipo);

    // Configuracion de campos del sistema (alias + opciones de lista) definida en "Configurar unidades".
    private Dictionary<string, UnidadCampoConfigDto> _camposConfig = new();
    private string AliasCampo(string clave, string def) => _camposConfig.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias) ? c.Alias! : def;
    private static readonly string[] EstadoSemilla = { "Habitada", "Desocupada", "Arrendada" };

    // Las opciones de las listas del sistema se guardan como JSON [{K, Oculta}] (el orden del
    // arreglo es el orden de la lista). Se conserva la lectura del formato legado (una por linea).
    private sealed record OpcionLista(string K, bool Oculta = false);

    private List<OpcionLista> LeerOpcionesEstado()
    {
        var raw = _camposConfig.TryGetValue("estado", out var c) ? c.Opciones : null;
        if (string.IsNullOrWhiteSpace(raw)) return EstadoSemilla.Select(s => new OpcionLista(s)).ToList();
        if (raw!.TrimStart().StartsWith('['))
        {
            try
            {
                var l = System.Text.Json.JsonSerializer.Deserialize<List<OpcionLista>>(raw!);
                if (l is { Count: > 0 }) return l;
            }
            catch { }
        }
        return raw!.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => new OpcionLista(x)).ToList();
    }

    private IEnumerable<string> EstadosConfig() => LeerOpcionesEstado().Where(o => !o.Oculta).Select(o => o.K);

    /// <summary>Incluye el estado actual aunque este oculto, para no sobreescribirlo sin querer.</summary>
    private IEnumerable<string> EstadosConVigente(string? actual)
    {
        var vis = EstadosConfig().ToList();
        if (!string.IsNullOrWhiteSpace(actual) && !vis.Contains(actual!, StringComparer.OrdinalIgnoreCase))
            vis.Add(actual!);
        return vis;
    }

    /// <summary>Tipos propios que no esten ocultos (mas el vigente de la unidad si lo esta).</summary>
    private List<TipoUnidadCustomDto> TiposCustomVisibles(Guid? vigente = null)
    {
        var oc = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (_camposConfig.TryGetValue("tipo", out var c) && !string.IsNullOrWhiteSpace(c.Opciones)
            && c.Opciones!.TrimStart().StartsWith('['))
        {
            try
            {
                foreach (var o in System.Text.Json.JsonSerializer.Deserialize<List<OpcionLista>>(c.Opciones!) ?? new())
                    if (o.Oculta) oc.Add(o.K);
            }
            catch { }
        }
        var vis = _tiposCustom.Where(t => !oc.Contains("c:" + t.Id)).ToList();
        if (vigente is { } g && vis.All(t => t.Id != g))
        {
            var tc = _tiposCustom.FirstOrDefault(t => t.Id == g);
            if (tc is not null) vis.Add(tc);
        }
        return vis;
    }

    // Etiqueta legible del tipo de unidad (los nombres del enum son ASCII sin espacios).
    // Tipos ofrecidos en los selectores (se excluye ZonaComun; el valor del enum se conserva por datos historicos).
    private static IEnumerable<TipoUnidad> TiposUnidadSel => Enum.GetValues<TipoUnidad>().Where(t => t != TipoUnidad.ZonaComun);

    private static string TipoLabel(TipoUnidad t) => t switch
    {
        TipoUnidad.UtilCuarto => "Cuarto útil",
        TipoUnidad.ZonaComun => "Zona común",
        TipoUnidad.ParqueaderoDeposito => "Parqueadero + depósito",
        _ => t.ToString()
    };

    private void Cerrar() => Close(_huboCambios);
