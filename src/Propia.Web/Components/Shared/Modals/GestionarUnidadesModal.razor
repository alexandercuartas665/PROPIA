    // El boton final solo se habilita si lo escrito coincide EXACTO con el numero de la unidad.
    private bool ConfirmCoincide =>
        _selected is not null &&
        string.Equals(_confirmText?.Trim(), _selected.Numero?.Trim(), StringComparison.Ordinal);

    // Paso 2: ejecuta el borrado real. Requiere que la confirmacion coincida (defensa en el cliente;
    // el backend igual valida integridad y bloquea si la unidad tiene registros asociados).
    private async Task ConfirmarEliminarUnidad()
    {
        if (_selected is null || !ConfirmCoincide) return;
        _busy = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades/{_selected.Id}");
            if (resp.IsSuccessStatusCode)
            {
                // La unidad ya no existe: cierra el modal y deja que la tabla se refresque.
                _confirmDel = false;
                _huboCambios = true;
                Close(_huboCambios);
                return;
            }
            else
            {
                string msg;
                try { var e = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); msg = e != null && e.TryGetValue("error", out var m) ? m : "No se pudo eliminar."; }
                catch { msg = "No se pudo eliminar."; }
                ShowMsg(msg, true);
            }
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

