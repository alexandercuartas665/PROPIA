    private async Task AgregarCampoPersonalizado()
    {
        if (string.IsNullOrWhiteSpace(_cfLabel)) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades-campos",
                new CrearCampoDefinicionRequest(_cfLabel.Trim()));
            if (!resp.IsSuccessStatusCode) { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); return; }
            var def = await resp.Content.ReadFromJsonAsync<UnidadCampoDefinicionDto>();
            await CargarCamposAsync();  // recarga catalogo (incluye el nuevo) + valores de esta unidad
            // Si capturaron un valor inicial para esta unidad, lo guardamos
            if (def is not null && !string.IsNullOrWhiteSpace(_cfValor) && _selected is not null)
            {
                var valor = _cfValor.Trim();
                await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/campos/{def.Id}", new SetCampoValorRequest(valor));
                var vm = _campos.FirstOrDefault(x => x.DefinicionId == def.Id);
                if (vm is not null) vm.Valor = valor;
            }
            _cfLabel = ""; _cfValor = ""; _cfOpen = false;
            _huboCambios = true;
            ShowMsg("Campo creado. Aparece en todas las unidades.", false);
        }
        finally { _busy = false; }
    }

    private async Task GuardarValorCampo(CampoVM c, string? valor)
    {
        if (_selected is null) return;
        c.Valor = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
        await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/campos/{c.DefinicionId}",
            new SetCampoValorRequest(c.Valor));
        _huboCambios = true;
    }

    private async Task EliminarCampoDefinicion(CampoVM c)
    {
        var ok = await Js.InvokeAsync<bool>("confirm",
            $"Quitar el campo \"{c.Label}\" de TODAS las unidades? Se perderan los valores guardados en cada una.");
        if (!ok) return;
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-campos/{c.DefinicionId}");
        if (resp.IsSuccessStatusCode)
        {
            _campos.RemoveAll(x => x.DefinicionId == c.DefinicionId);
            _huboCambios = true;
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
    }

    private async Task SubirDocumento(InputFileChangeEventArgs e)
    {
        if (_selected is null) return;
        var files = e.GetMultipleFiles(20);
        if (files.Count == 0) return;
        _subiendoDoc = true;
        try
        {
            int ok = 0; string? err = null;
            foreach (var f in files)
            {
                if (f.Size > 10_000_000) { err = $"{f.Name}: supera 10 MB."; continue; }
                using var content = new MultipartFormDataContent();
                var sc = new StreamContent(f.OpenReadStream(10_000_000));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType);
                content.Add(sc, "file", f.Name);
                var resp = await Auth().PostAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/documentos", content);
                if (resp.IsSuccessStatusCode)
                {
                    var dto = await resp.Content.ReadFromJsonAsync<UnidadDocumentoDto>();
                    if (dto is not null) _documentos.Insert(0, dto);
                    ok++;
                }
                else { err = await resp.Content.ReadAsStringAsync(); }
            }
            if (ok > 0) _huboCambios = true;
            if (err is not null) ShowMsg("Error: " + err, true);
            else ShowMsg(ok == 1 ? "Documento adjuntado." : $"{ok} documentos adjuntados.", false);
        }
        finally { _subiendoDoc = false; }
    }

    private async Task EliminarDocumento(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-documentos/{id}");
        if (resp.IsSuccessStatusCode) { _documentos.RemoveAll(d => d.Id == id); _huboCambios = true; }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
    }

    private static bool EsImagen(string nombre)
    {
        var ext = System.IO.Path.GetExtension(nombre ?? "").ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".bmp";
    }

    private static string FmtTamano(long bytes)
    {
        if (bytes <= 0) return "archivo";
        var kb = bytes / 1024.0;
        return kb >= 1024 ? $"{kb / 1024.0:0.#} MB" : $"{Math.Max(1, (int)Math.Round(kb))} KB";
    }

    private async Task Rebalancear()
    {
        _busy = true;
        var resp = await Auth().PostAsync("/api/mi-copropiedad/unidades/rebalancear-coeficientes", null);
        if (resp.IsSuccessStatusCode)
        {
            var r = await resp.Content.ReadFromJsonAsync<RebalanceoCoeficientesDto>();
            _huboCambios = true;
            await CargarAsync();
            if (_selected is not null)
            {
                var fresh = _unidades.FirstOrDefault(u => u.Id == _selected.Id);
                if (fresh is not null) _selected = fresh;
                _cuota = null;
                try { _cuota = await Auth().GetFromJsonAsync<CuotaConsolidadaDto>($"/api/mi-copropiedad/unidades/{_selected!.Id}/cuota-consolidada"); } catch { }
            }
            ShowMsg($"Rebalanceado: {r?.Apartamentos} aptos a {r?.CoefPorApartamento}% c/u. Suma {r?.SumaAnterior:0.##}% -> {r?.SumaNueva:0.##}%.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    // El backend bloquea si la unidad tiene registros asociados (guarda) y devuelve el motivo.
    private async Task EliminarUnidad()
    {
        if (_selected is null) return;
        var ok = await Js.InvokeAsync<bool>("confirm",
            $"Eliminar {_selected.Tipo} {_selected.Numero}? Esta accion no se puede deshacer.");
        if (!ok) return;
        _busy = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades/{_selected.Id}");
            if (resp.IsSuccessStatusCode)
            {
                // La unidad ya no existe: cierra el modal y deja que la tabla se refresque.
                _huboCambios = true;
                Close(_huboCambios);
                return;
            }
            else
            {
                string msg;
                try { var e = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); msg = e != null && e.TryGetValue("error", out var m) ? m : "No se pudo eliminar."; }
                catch { msg = "No se pudo eliminar."; }
                ShowMsg(msg, true);
            }
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    // Elimina una torre/bloque. El backend bloquea si aun tiene unidades (guarda) y devuelve el motivo.
    private async Task EliminarTorre(TorreDto t)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", $"Eliminar {AgrupacionLabelSingular.ToLower()} \"{t.Nombre}\"?");
        if (!ok) return;
        _busy = true;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/torres/{t.Id}");
            if (resp.IsSuccessStatusCode)
            {
                _huboCambios = true;
                ShowMsg($"{AgrupacionLabelSingular} eliminada.", false);
                await CargarAsync();
            }
            else
            {
                string msg;
                try { var e = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); msg = e != null && e.TryGetValue("error", out var m) ? m : "No se pudo eliminar."; }
                catch { msg = "No se pudo eliminar."; }
                ShowMsg(msg, true);
            }
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        _busy = false;
    }

    private void ShowMsg(string text, bool isError) { _msg = text; _msgError = isError; }

    private void Cerrar() => Close(_huboCambios);
