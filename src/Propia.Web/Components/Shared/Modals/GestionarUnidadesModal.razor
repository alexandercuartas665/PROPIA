        display: inline-flex; align-items: center; gap: 7px;
        padding: 9px 14px; border-radius: 9px;
        border: 1px solid #E1E8EE;
        font-size: 12.5px; font-weight: 600; color: #516F90;
        background: #fff; cursor: pointer;
    }
    .gum-cta:hover { border-color: var(--propia-brand, #6D4FE3); color: var(--propia-brand, #6D4FE3); }
    .gum-cta--brand {
        border-color: #DCD2F8; color: var(--propia-brand, #6D4FE3); background: #F1ECFD; font-weight: 700;
    }
