    /// <summary>
    /// Guarda las listas de correos/telefonos/direcciones del formulario como contactos globales
    /// del contacto (persona o empresa), reemplazando los previos. Es lo que hace que al volver a
    /// abrir la ficha -aqui o en otra copropiedad- los datos vuelvan a aparecer. Best-effort: un
    /// fallo aqui no revierte el vinculo ya creado.
    /// </summary>
    private async Task GuardarContactosGlobalesAsync(UnidadPersonaDto dto)
    {
        var tipo = dto.EntidadTipo;
        var entId = tipo == EntidadDirectorio.Empresa ? (dto.EmpresaId ?? Guid.Empty) : dto.PersonaId;
        if (entId == Guid.Empty) return;

        var contactos = new List<ContactoRapidoDto>();
        var correos = _personaForm.Emails.Select(e => e?.Trim()).Where(e => !string.IsNullOrWhiteSpace(e)).ToList();
        for (int i = 0; i < correos.Count; i++)
            contactos.Add(new ContactoRapidoDto(TipoContacto.Email, correos[i]!, Principal: i == 0));

        var telIdx = 0;
        for (int i = 0; i < _personaForm.Telefonos.Count; i++)
        {
            var num = _personaForm.Telefonos[i]?.Trim();
            if (string.IsNullOrWhiteSpace(num)) continue;
            var cod = i < _personaForm.Codigos.Count ? _personaForm.Codigos[i] : "+57";
            contactos.Add(new ContactoRapidoDto(TipoContacto.Telefono, $"{cod} {num}".Trim(), Principal: telIdx == 0));
            telIdx++;
        }

        var dirs = _personaForm.Direcciones.Select(d => d?.Trim()).Where(d => !string.IsNullOrWhiteSpace(d)).ToList();
        for (int i = 0; i < dirs.Count; i++)
            contactos.Add(new ContactoRapidoDto(TipoContacto.Direccion, dirs[i]!, Principal: i == 0));

        try
        {
            var req = new ReemplazarContactosRequest(tipo, entId, contactos);
            await Auth().PutAsJsonAsync("/api/directorio/contactos-rapidos", req);
        }
        catch { /* best-effort */ }
    }

    private async Task GuardarPersona()
    {
        if (_selected is null || _formRol is null || !PersonaFormValido) return;
        _busy = true;
        // Al agregar, la identidad viaja como PersonaId (el selector ya la resolvio y vinculo);
        // los campos de texto van vacios porque el selector solo expone el documento
        // enmascarado. Al editar se manda todo como siempre.
        // En alta, la empresa (si aplica) viaja por EntidadTipo/EmpresaId; el resto de identidad
        // la resuelve el selector. En edicion el backend usa la entidad ya guardada.
        var esEmpresaAlta = _editPersonaId is null && _personaSel?.EntidadTipo == EntidadDirectorio.Empresa;
        var req = new AgregarPersonaUnidadRequest(
            _editPersonaId is null ? "" : _personaForm.Documento.Trim(),
            _editPersonaId is null ? "" : _personaForm.Nombres.Trim(),
            _editPersonaId is null ? "" : _personaForm.Apellidos.Trim(),
            _personaForm.PrimerEmail,
            _personaForm.PrimerTelefono,
            _formRol.Value,
            true,
            string.IsNullOrWhiteSpace(_personaForm.Parentesco) ? null : _personaForm.Parentesco.Trim(),
            _editPersonaId is null && !esEmpresaAlta ? _personaSel?.PersonaId : null,
            esEmpresaAlta ? EntidadDirectorio.Empresa : EntidadDirectorio.Persona,
            esEmpresaAlta ? _personaSel?.PersonaId : null);
        HttpResponseMessage resp;
        if (_editPersonaId is not null)
            resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-personas/{_editPersonaId}", req);
        else
            resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/personas", req);

        if (resp.IsSuccessStatusCode)
        {
            var dto = await resp.Content.ReadFromJsonAsync<UnidadPersonaDto>();
            if (dto is not null)
            {
                var idx = _personas.FindIndex(x => x.Id == dto.Id);
                if (idx >= 0) _personas[idx] = dto; else _personas.Add(dto);
                // Persiste correos/telefonos/direcciones como contactos GLOBALES del contacto.
                await GuardarContactosGlobalesAsync(dto);
            }
            ShowMsg(_editPersonaId is not null ? "Persona actualizada." : "Persona vinculada.", false);
            _formRol = null;
            _editPersonaId = null;
            _personaForm = new PersonaForm();
            _personaSel = null;
            _huboCambios = true;
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

