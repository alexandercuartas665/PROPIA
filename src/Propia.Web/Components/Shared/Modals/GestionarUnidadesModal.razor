    private string _manNuevaTorreNombre = "";

    // Binding del <select> de torre: ademas de las torres existentes soporta la opcion
    // "+ Nueva torre..." (sentinel), que activa el input inline para crearla al agregar.
    private string ManTorreSel
    {
        get => _manNuevaTorre ? "__nueva__" : (_manTorreId == Guid.Empty ? "" : _manTorreId.ToString());
        set
        {
            if (value == "__nueva__") _manNuevaTorre = true;
