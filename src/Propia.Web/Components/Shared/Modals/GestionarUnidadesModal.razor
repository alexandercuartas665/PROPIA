        _nuevaUnidad = false;
        _editMode = false;
        _vinculos.Clear();
        _personas.Clear();
        _cuota = null;
        _campos.Clear();
        _documentos.Clear();
        _subiendoDoc = false;
        _placas.Clear(); _arriendos.Clear(); _mascotas.Clear(); _empleadas.Clear();
        _titularidad.Clear(); _personaCampos.Clear();
        _contactTab = "actuales"; _campoPersonaTarget = null; _npcLabel = ""; _npcValor = "";
        _titNombre = ""; _titRol = "Propietario"; _titDesde = null; _titHasta = null;
        _nuevaPlaca = ""; _nuevaPlacaTipo = TipoVehiculo.Automovil;
        _nuevoArrConcepto = ""; _nuevoArrValor = null; _nuevoArrRef = "";
        _nuevaMascNombre = ""; _nuevaMascTipo = TipoMascota.Perro; _nuevaMascRaza = "";
        _nuevaEmpNombre = ""; _nuevaEmpDoc = ""; _nuevaEmpCel = ""; _nuevaEmpHorario = "";
        _cfLabel = ""; _cfValor = "";
        _cfOpen = false;
        _formRol = null;
        _editPersonaId = null;
        _personaForm = new PersonaForm();
        _nuevoVinculoUnidadId = Guid.Empty;
        _nuevoVinculoFactura = false;
        try
        {
            _vinculos = await Auth().GetFromJsonAsync<List<UnidadVinculoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/vinculos") ?? new();
        }
        catch { /* sin vinculos */ }
        try
        {
            _personas = await Auth().GetFromJsonAsync<List<UnidadPersonaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/personas") ?? new();
        }
        catch { /* sin personas */ }
        try
        {
