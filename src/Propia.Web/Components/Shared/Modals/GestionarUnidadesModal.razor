    // Tipos propios del tenant (catalogo) para los selectores de tipo de unidad.
    private List<TipoUnidadCustomDto> _tiposCustom = new();

    // El orden de los tipos propios lo define la copropiedad en "Configurar" y se guarda como lista
    // de ids en Opciones del campo 'tipo'. Se replica aqui para que la ficha ofrezca el mismo orden.
    private void AplicarOrdenTiposCustom()
    {
        var ord = new List<Guid>();
        if (_camposConfig.TryGetValue("tipo", out var c) && !string.IsNullOrWhiteSpace(c.Opciones))
            foreach (var o in OpcionCampo.Parse(c.Opciones))
            {
                var k = o.K.StartsWith("c:") ? o.K[2..] : o.K;   // 'tipo' guarda K = "c:{guid}" para tipos propios
                if (Guid.TryParse(k, out var g)) ord.Add(g);
            }
        _tiposCustom = _tiposCustom
            .Select(t => (t, i: ord.IndexOf(t.Id)))
            .OrderBy(x => x.i < 0 ? int.MaxValue : x.i)
            .ThenBy(x => x.t.Nombre, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.t).ToList();
    }
    // Etiqueta de una unidad: nombre del tipo propio si lo tiene, si no el enum.
    private string LabelU(UnidadDto u) => u.TipoCustomNombre ?? TipoLabel(u.Tipo);

    // Configuracion de campos del sistema (alias + opciones de lista) definida en "Configurar unidades".
    private Dictionary<string, UnidadCampoConfigDto> _camposConfig = new();
    private string AliasCampo(string clave, string def) => _camposConfig.TryGetValue(clave, out var c) && !string.IsNullOrWhiteSpace(c.Alias) ? c.Alias! : def;
    private static readonly string[] EstadoSemilla = { "Habitada", "Desocupada", "Arrendada" };

    // Las opciones de las listas del sistema se guardan como JSON [{K, Oculta}] (el orden del
    // arreglo es el orden de la lista). Se conserva la lectura del formato legado (una por linea).
    private sealed record OpcionLista(string K, bool Oculta = false);

    private List<OpcionLista> LeerOpcionesEstado()
    {
        var raw = _camposConfig.TryGetValue("estado", out var c) ? c.Opciones : null;
        if (string.IsNullOrWhiteSpace(raw)) return EstadoSemilla.Select(s => new OpcionLista(s)).ToList();
        if (raw!.TrimStart().StartsWith('['))
        {
            try
            {
                var l = System.Text.Json.JsonSerializer.Deserialize<List<OpcionLista>>(raw!);
                if (l is { Count: > 0 }) return l;
            }
            catch { }
        }
        return raw!.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => new OpcionLista(x)).ToList();
    }

    private IEnumerable<string> EstadosConfig() => LeerOpcionesEstado().Where(o => !o.Oculta).Select(o => o.K);

    /// <summary>Incluye el estado actual aunque este oculto, para no sobreescribirlo sin querer.</summary>
    private IEnumerable<string> EstadosConVigente(string? actual)
    {
        var vis = EstadosConfig().ToList();
        if (!string.IsNullOrWhiteSpace(actual) && !vis.Contains(actual!, StringComparer.OrdinalIgnoreCase))
            vis.Add(actual!);
        return vis;
    }

    /// <summary>Tipos propios que no esten ocultos (mas el vigente de la unidad si lo esta).</summary>
    private List<TipoUnidadCustomDto> TiposCustomVisibles(Guid? vigente = null)
    {
        var oc = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (_camposConfig.TryGetValue("tipo", out var c) && !string.IsNullOrWhiteSpace(c.Opciones)
            && c.Opciones!.TrimStart().StartsWith('['))
        {
            try
            {
                foreach (var o in System.Text.Json.JsonSerializer.Deserialize<List<OpcionLista>>(c.Opciones!) ?? new())
                    if (o.Oculta) oc.Add(o.K);
            }
            catch { }
        }
        var vis = _tiposCustom.Where(t => !oc.Contains("c:" + t.Id)).ToList();
        if (vigente is { } g && vis.All(t => t.Id != g))
        {
            var tc = _tiposCustom.FirstOrDefault(t => t.Id == g);
            if (tc is not null) vis.Add(tc);
        }
        return vis;
    }

    // Etiqueta legible del tipo de unidad (los nombres del enum son ASCII sin espacios).
    // Tipos ofrecidos en los selectores (se excluye ZonaComun; el valor del enum se conserva por datos historicos).
    private static IEnumerable<TipoUnidad> TiposUnidadSel => Enum.GetValues<TipoUnidad>().Where(t => t != TipoUnidad.ZonaComun);

    private static string TipoLabel(TipoUnidad t) => t switch
    {
        TipoUnidad.UtilCuarto => "Cuarto útil",
        TipoUnidad.ZonaComun => "Zona común",
        TipoUnidad.ParqueaderoDeposito => "Parqueadero + depósito",
        _ => t.ToString()
    };

    private void Cerrar() => Close(_huboCambios);
}
