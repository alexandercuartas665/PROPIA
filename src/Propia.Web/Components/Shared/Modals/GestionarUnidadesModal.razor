@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public string AgrupacionLabelSingular { get; set; } = "Torre";
    [Parameter] public string PisoLabelSingular { get; set; } = "Piso";

    private List<TorreDto> _torres = new();
    private List<UnidadDto> _unidades = new();
    private UnidadDto? _selected;
    private List<UnidadVinculoDto> _vinculos = new();
    private CuotaConsolidadaDto? _cuota;
    private HashSet<Guid> _torresAbiertas = new();
    private bool _editMode;
    private EditUnidadForm _edit = new();

    // Inmuebles vinculados - form para agregar
    private Guid _nuevoVinculoUnidadId;
    private bool _nuevoVinculoFactura;

    // Campos personalizados (Ficha tecnica)
    private Dictionary<string, string> _camposPersonalizados = new();
    private bool _cfOpen;
    private string _cfLabel = "";
    private string _cfValor = "";

    // Personas vinculadas a la unidad
    private List<UnidadPersonaDto> _personas = new();
    private RolUnidadPersona? _formRol;
    private PersonaForm _personaForm = new();

    private class PersonaForm
    {
        public string Documento { get; set; } = "";
        public string Nombres { get; set; } = "";
        public string Apellidos { get; set; } = "";
        public string Email { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Parentesco { get; set; } = "";
    }

    private bool PersonaFormValido =>
        !string.IsNullOrWhiteSpace(_personaForm.Documento) &&
        !string.IsNullOrWhiteSpace(_personaForm.Nombres) &&
        !string.IsNullOrWhiteSpace(_personaForm.Apellidos);

    private class EditUnidadForm
    {
        public string Numero { get; set; } = "";
        public TipoUnidad Tipo { get; set; } = TipoUnidad.Apartamento;
        public Guid? TorreId { get; set; }
        public int? Piso { get; set; }
        public decimal CoeficientePropiedad { get; set; }
        public decimal? AreaM2 { get; set; }
        public int? Habitaciones { get; set; }
        public int? Banos { get; set; }
        public int? Parqueaderos { get; set; }
        public string? Estado { get; set; }
        public string? Observaciones { get; set; }
        public string? MatriculaInmobiliaria { get; set; }
        public bool PagaAdministracion { get; set; } = true;
    }
    private bool _huboCambios;
    private bool _busy;
    private string _msg = "";
    private bool _msgError;

    private string AgrupacionLabelPlural => AgrupacionLabelSingular + "s";

    // Modes
    private string? _mode;

    // Manual
    private Guid _manTorreId;
    private int? _manPiso;
    private string _manNumero = "";
    private TipoUnidad _manTipo = TipoUnidad.Apartamento;

    // Generador
    private int _genN = 2;
    private List<string> _genNombres = new() { "Torre A", "Torre B" };
    private int _genPisos = 5;
    private int _genPorPiso = 4;
    private int GenTotal => _genN * _genPisos * _genPorPiso;
    private int _genToast;

    // Import
    private string _csv = "";
    private int CsvCount => string.IsNullOrWhiteSpace(_csv) ? 0 : _csv.Split('\n').Count(l => !string.IsNullOrWhiteSpace(l));

    private decimal CoefTotal => _unidades.Sum(u => u.CoeficientePropiedad);

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _torres = await http.GetFromJsonAsync<List<TorreDto>>("/api/mi-copropiedad/torres") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            if (_torres.Count > 0 && _torresAbiertas.Count == 0)
                _torresAbiertas.Add(_torres[0].Id);
            if (_manTorreId == Guid.Empty && _torres.Count > 0)
                _manTorreId = _torres[0].Id;
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    private void SetMode(string? m) { _mode = (_mode == m) ? null : m; _genToast = 0; }
    private void SetGenN(int n)
    {
        _genN = n;
        while (_genNombres.Count < n) _genNombres.Add($"{AgrupacionLabelSingular} {(char)('A' + _genNombres.Count)}");
        while (_genNombres.Count > n) _genNombres.RemoveAt(_genNombres.Count - 1);
    }

    private void ToggleTorre(Guid id)
    {
        if (!_torresAbiertas.Add(id)) _torresAbiertas.Remove(id);
    }
    private bool IsOpen(Guid id) => _torresAbiertas.Contains(id);

    private async Task SeleccionarUnidad(UnidadDto u)
    {
        _selected = u;
        _editMode = false;
        _vinculos.Clear();
        _personas.Clear();
        _cuota = null;
        _camposPersonalizados.Clear();
        _cfOpen = false;
        _formRol = null;
        _personaForm = new PersonaForm();
        _nuevoVinculoUnidadId = Guid.Empty;
        _nuevoVinculoFactura = false;
        try
        {
            _vinculos = await Auth().GetFromJsonAsync<List<UnidadVinculoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/vinculos") ?? new();
        }
        catch { /* sin vinculos */ }
        try
        {
            _personas = await Auth().GetFromJsonAsync<List<UnidadPersonaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/personas") ?? new();
        }
        catch { /* sin personas */ }
        try
        {
            _cuota = await Auth().GetFromJsonAsync<CuotaConsolidadaDto>($"/api/mi-copropiedad/unidades/{u.Id}/cuota-consolidada");
        }
        catch { _cuota = null; }
    }

    private void AbrirFormPersona(RolUnidadPersona rol)
    {
        if (_formRol == rol) { _formRol = null; return; }
        _formRol = rol;
        _personaForm = new PersonaForm();
    }

    private async Task GuardarPersona()
    {
        if (_selected is null || _formRol is null || !PersonaFormValido) return;
        _busy = true;
        var req = new AgregarPersonaUnidadRequest(
            _personaForm.Documento.Trim(),
            _personaForm.Nombres.Trim(),
            _personaForm.Apellidos.Trim(),
            string.IsNullOrWhiteSpace(_personaForm.Email) ? null : _personaForm.Email.Trim(),
            string.IsNullOrWhiteSpace(_personaForm.Telefono) ? null : _personaForm.Telefono.Trim(),
            _formRol.Value,
            true,
            string.IsNullOrWhiteSpace(_personaForm.Parentesco) ? null : _personaForm.Parentesco.Trim());
        var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/personas", req);
        if (resp.IsSuccessStatusCode)
        {
            var creada = await resp.Content.ReadFromJsonAsync<UnidadPersonaDto>();
            if (creada is not null) _personas.Add(creada);
            _formRol = null;
            _personaForm = new PersonaForm();
            _huboCambios = true;
            ShowMsg("Persona vinculada.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    private async Task EliminarPersona(Guid unidadPersonaId)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-personas/{unidadPersonaId}");
        if (resp.IsSuccessStatusCode)
        {
            _personas.RemoveAll(p => p.Id == unidadPersonaId);
            _huboCambios = true;
        }
    }

    private void EntrarEdicion()
    {
        if (_selected is null) return;
        _edit = new EditUnidadForm
        {
            Numero = _selected.Numero,
            Tipo = _selected.Tipo,
            TorreId = _selected.TorreId,
            Piso = _selected.Piso,
            CoeficientePropiedad = _selected.CoeficientePropiedad,
            AreaM2 = _selected.AreaM2,
            Habitaciones = _selected.Habitaciones,
            Banos = _selected.Banos,
            Parqueaderos = _selected.Parqueaderos,
            Estado = _selected.Estado,
            Observaciones = _selected.Observaciones,
            MatriculaInmobiliaria = _selected.MatriculaInmobiliaria,
            PagaAdministracion = _selected.PagaAdministracion
        };
        _editMode = true;
    }

    private void CancelarEdicion() => _editMode = false;

    private async Task GuardarUnidad()
    {
        if (_selected is null) return;
        if (string.IsNullOrWhiteSpace(_edit.Numero)) { ShowMsg("Numero obligatorio.", true); return; }
        _busy = true;
        var req = new ActualizarUnidadRequest(
            _edit.Numero.Trim(), _edit.Tipo, _edit.TorreId, _edit.Piso,
            _edit.CoeficientePropiedad, _edit.AreaM2,
            _edit.Habitaciones, _edit.Banos, _edit.Parqueaderos,
            string.IsNullOrWhiteSpace(_edit.Estado) ? null : _edit.Estado,
            string.IsNullOrWhiteSpace(_edit.Observaciones) ? null : _edit.Observaciones,
            string.IsNullOrWhiteSpace(_edit.MatriculaInmobiliaria) ? null : _edit.MatriculaInmobiliaria,
            _edit.PagaAdministracion);
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}", req);
        if (resp.IsSuccessStatusCode)
        {
            var actualizada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
            if (actualizada is not null)
            {
                _selected = actualizada;
                var idx = _unidades.FindIndex(u => u.Id == actualizada.Id);
                if (idx >= 0) _unidades[idx] = actualizada;
            }
            _editMode = false;
            _huboCambios = true;
            ShowMsg($"Unidad {actualizada?.Numero} actualizada.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    private async Task AgregarUnidadManual()
    {
        if (string.IsNullOrWhiteSpace(_manNumero)) return;
        if (_manTorreId == Guid.Empty) { ShowMsg($"Selecciona {AgrupacionLabelSingular.ToLower()}.", true); return; }
        _busy = true;
        var req = new CrearUnidadRequest(_manNumero.Trim(), _manTipo, _manTorreId, _manPiso, 0m, null, null, null, null, null, null);
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
        if (resp.IsSuccessStatusCode)
        {
            _manNumero = "";
            _huboCambios = true;
            await CargarAsync();
            ShowMsg("Unidad agregada", false);
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
        _busy = false;
    }

    private async Task EjecutarGenerador()
    {
        _busy = true;
        var http = Auth();
        // 1) crear torres
        var creadas = new List<TorreDto>();
        foreach (var nombre in _genNombres.Where(n => !string.IsNullOrWhiteSpace(n)))
        {
            var exist = _torres.FirstOrDefault(t => t.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase));
            if (exist is not null) { creadas.Add(exist); continue; }
            var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/torres", new CrearTorreRequest(nombre, _genPisos, null));
            if (resp.IsSuccessStatusCode)
            {
                var nueva = await resp.Content.ReadFromJsonAsync<TorreDto>();
                if (nueva is not null) creadas.Add(nueva);
            }
        }
        // 2) crear unidades por torre
        int totalCreadas = 0;
        foreach (var t in creadas)
        {
            for (int piso = 1; piso <= _genPisos; piso++)
            {
                for (int u = 1; u <= _genPorPiso; u++)
                {
                    var num = $"{piso}{u:00}";
                    if (_unidades.Any(x => x.TorreId == t.Id && x.Numero == num)) continue;
                    var req = new CrearUnidadRequest(num, TipoUnidad.Apartamento, t.Id, piso, 0m, null, null, null, null, null, null);
                    var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
                    if (resp.IsSuccessStatusCode) totalCreadas++;
                }
            }
        }
        _genToast = totalCreadas;
        _huboCambios = true;
        await CargarAsync();
        SetMode(null);
        _busy = false;
    }

    private async Task ImportarCsv()
    {
        if (CsvCount == 0) return;
        if (_torres.Count == 0) { ShowMsg($"Crea un {AgrupacionLabelSingular.ToLower()} primero.", true); return; }
        var torre = _torres[0];
        var lineas = _csv.Split('\n').Select(l => l.Trim()).Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
        int ok = 0;
        foreach (var num in lineas)
        {
            if (_unidades.Any(u => u.TorreId == torre.Id && u.Numero == num)) continue;
            var req = new CrearUnidadRequest(num, TipoUnidad.Apartamento, torre.Id, null, 0m, null, null, null, null, null, null);
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
            if (resp.IsSuccessStatusCode) ok++;
        }
        _csv = "";
        _huboCambios = true;
        await CargarAsync();
        ShowMsg($"{ok} unidades importadas a {torre.Nombre}", false);
    }

    private async Task AgregarVinculo()
    {
        if (_selected is null || _nuevoVinculoUnidadId == Guid.Empty) return;
        var req = new CrearVinculoUnidadRequest(_nuevoVinculoUnidadId, _nuevoVinculoFactura);
        var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/vinculos", req);
        if (resp.IsSuccessStatusCode)
        {
            var v = await resp.Content.ReadFromJsonAsync<UnidadVinculoDto>();
            if (v is not null) _vinculos.Add(v);
            _nuevoVinculoUnidadId = Guid.Empty;
            _nuevoVinculoFactura = false;
            _huboCambios = true;
        }
        else
        {
            ShowMsg("No se pudo vincular: " + await resp.Content.ReadAsStringAsync(), true);
        }
    }

    private async Task EliminarVinculo(Guid vinculoId)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/vinculos/{vinculoId}");
        if (resp.IsSuccessStatusCode)
        {
            _vinculos.RemoveAll(v => v.Id == vinculoId);
            _huboCambios = true;
        }
    }

    private void AgregarCampoPersonalizado()
    {
        if (string.IsNullOrWhiteSpace(_cfLabel) || string.IsNullOrWhiteSpace(_cfValor)) return;
        _camposPersonalizados[_cfLabel.Trim()] = _cfValor.Trim();
        _cfLabel = "";
        _cfValor = "";
        _cfOpen = false;
    }

    private async Task Rebalancear()
    {
        _busy = true;
        var resp = await Auth().PostAsync("/api/mi-copropiedad/unidades/rebalancear-coeficientes", null);
        if (resp.IsSuccessStatusCode)
        {
            var r = await resp.Content.ReadFromJsonAsync<RebalanceoCoeficientesDto>();
            _huboCambios = true;
            await CargarAsync();
            if (_selected is not null)
            {
                var fresh = _unidades.FirstOrDefault(u => u.Id == _selected.Id);
                if (fresh is not null) _selected = fresh;
                _cuota = null;
                try { _cuota = await Auth().GetFromJsonAsync<CuotaConsolidadaDto>($"/api/mi-copropiedad/unidades/{_selected!.Id}/cuota-consolidada"); } catch { }
            }
            ShowMsg($"Rebalanceado: {r?.Apartamentos} aptos a {r?.CoefPorApartamento}% c/u. Suma {r?.SumaAnterior:0.##}% -> {r?.SumaNueva:0.##}%.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    private async Task EliminarUnidad()
    {
        if (_selected is null) return;
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades/{_selected.Id}");
        if (resp.IsSuccessStatusCode)
        {
            _huboCambios = true;
            _selected = null;
            await CargarAsync();
        }
        else { ShowMsg("No se pudo eliminar", true); }
    }

    private void ShowMsg(string text, bool isError) { _msg = text; _msgError = isError; }

    private void Cerrar() => Close(_huboCambios);
}
