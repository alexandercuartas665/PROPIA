    // Entidad (persona o empresa) cuyos contactos edita el formulario, para poder recargarlos y
    // guardarlos globales. En alta sale del selector; en edicion, de la fila que se abre.
    private EntidadDirectorio _formEntidadTipo = EntidadDirectorio.Persona;
    private Guid _formEntidadId;

    /// <summary>El selector eligio persona/empresa: se guarda y se precargan sus contactos globales.</summary>
    private void OnPersonaSel(PersonaCandidatoDto? c)
    {
        _personaSel = c;
        _formEntidadTipo = c?.EntidadTipo ?? EntidadDirectorio.Persona;
        _formEntidadId = c?.PersonaId ?? Guid.Empty;
        if (c?.Contactos is { Count: > 0 })
            AplicarContactosAlForm(c.Contactos);
    }

    /// <summary>Vuelca los correos/telefonos/direcciones del contacto en las listas del formulario.</summary>
    private void AplicarContactosAlForm(IReadOnlyList<ContactoRapidoDto> contactos)
    {
        var correos = contactos.Where(x => x.Tipo == TipoContacto.Email && !string.IsNullOrWhiteSpace(x.Valor))
            .Select(x => x.Valor.Trim()).ToList();
        var tels = contactos.Where(x => x.Tipo == TipoContacto.Telefono && !string.IsNullOrWhiteSpace(x.Valor)).ToList();
        var dirs = contactos.Where(x => x.Tipo == TipoContacto.Direccion && !string.IsNullOrWhiteSpace(x.Valor))
            .Select(x => x.Valor.Trim()).ToList();

        _personaForm.Emails = correos.Count > 0 ? correos : new List<string> { "" };

        var numeros = new List<string>();
        var codigos = new List<string>();
        foreach (var t in tels)
        {
            var (cod, num) = PartirTelefono(t.Valor);
            codigos.Add(cod); numeros.Add(num);
        }
        _personaForm.Telefonos = numeros.Count > 0 ? numeros : new List<string> { "" };
        _personaForm.Codigos = codigos.Count > 0 ? codigos : new List<string> { "+57" };

        _personaForm.Direcciones = dirs.Count > 0 ? dirs : new List<string> { "" };
    }

    private static (string Codigo, string Numero) PartirTelefono(string valor)
    {
        var t = (valor ?? "").Trim();
        if (t.StartsWith("+") && t.Contains(' ')) { var sp = t.Split(' ', 2); return (sp[0], sp[1]); }
        return ("+57", t);
    }

    private async Task EditarPersona(UnidadPersonaDto p)
    {
        _formRol = p.Rol;
        _editPersonaId = p.Id;
        _formEntidadTipo = p.EntidadTipo;
        _formEntidadId = p.EntidadTipo == EntidadDirectorio.Empresa ? (p.EmpresaId ?? Guid.Empty) : p.PersonaId;

        _personaForm = new PersonaForm
        {
            Documento = p.PersonaDocumento,
            Nombres = p.PersonaNombres,
            Apellidos = p.PersonaApellidos,
            Parentesco = p.Parentesco ?? "",
        };

        // Carga la lista COMPLETA de contactos globales (no solo el principal denormalizado).
        try
        {
            var url = $"/api/directorio/contactos-rapidos?tipo={(int)_formEntidadTipo}&id={_formEntidadId}";
            var contactos = await Auth().GetFromJsonAsync<List<ContactoRapidoDto>>(url);
            if (contactos is { Count: > 0 }) AplicarContactosAlForm(contactos);
            else PrecargarContactoUnico(p);
        }
        catch { PrecargarContactoUnico(p); }
    }

    // Respaldo si no se pudieron traer los contactos globales: usa el principal del propio DTO.
    private void PrecargarContactoUnico(UnidadPersonaDto p)
    {
        var (cod, num) = PartirTelefono(p.PersonaTelefono ?? "");
        _personaForm.Emails = new List<string> { string.IsNullOrWhiteSpace(p.PersonaEmail) ? "" : p.PersonaEmail! };
        _personaForm.Telefonos = new List<string> { num };
        _personaForm.Codigos = new List<string> { cod };
        _personaForm.Direcciones = new List<string> { "" };
    }

