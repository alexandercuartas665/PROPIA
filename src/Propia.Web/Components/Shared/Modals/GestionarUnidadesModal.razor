        try { _bitacora = await Auth().GetFromJsonAsync<List<BitacoraEntradaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/bitacora") ?? new(); }
        catch { _bitacora = new(); }
        // Estado de cuenta real (2.7). 404 si la unidad aun no tiene cartera -> queda null.
