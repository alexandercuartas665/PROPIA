@* GestionarUnidadesModal - D.1 del catalogo (fullscreen).
   Replica literal del modal del prototipo PROPIA.dc.html L.584-720.
   Componente reutilizable: recibe Jwt + cargas las torres/unidades por su cuenta.
   Layout 2 paneles: izq lista torres/unidades, der ficha unidad seleccionada. *@

@inherits ModalBase<bool>
@using Propia.Web.Components.Shared
@using Propia.Web.Components.Shared.Modals
@using Propia.Application.MiCopropiedad
@using Propia.Application.Directorio
@using Propia.Application.Cartera
@using Propia.Application.Historial
@using Propia.Domain.Enums

@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

@* ====== HEADER ====== *@
<div class="gum-header">
    <div class="gum-header-text">
        @* Sin numeral: Distribucion dejo de ser la seccion 2 del acordeon y es su propio modulo. *@
        <div class="gum-title">Gestionar unidades</div>
        <div class="gum-subtitle">@AgrupacionLabelSingular@("s"), @PisoLabelSingular.ToLower()s y unidades</div>
    </div>
    <button class="gum-close" @onclick="Cerrar" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

@* ====== FICHA (panel unico) ======
   La creacion y la edicion usan la MISMA ficha: al crear, se abre en modo "nueva unidad"
   con el codigo mascara (A1-202) editable; al guardar se crea y se pasa a la ficha completa. *@
<div class="gum-body">

    @* ===== Panel DER - ficha unidad ===== *@
    <div class="gum-panel-right">
        @if (_nuevaUnidad)
        {
            @* --- Modo NUEVA UNIDAD: misma ficha, vacia, con el codigo editable --- *@
            <div class="gum-fhead">
                <div class="gum-fhead-main">
                    <div class="gum-unit-avatar">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-4h4v4"/></svg>
                    </div>
                    <div class="gum-unit-id">
                        <div class="gum-unit-title">Nueva unidad</div>
                        <div class="gum-unit-meta">Escribe el codigo <b>@AgrupacionLabelSingular.ToUpperInvariant()-APARTAMENTO</b> (ej. A1-202) y completa la ficha. La @(AgrupacionLabelSingular.ToLower()) sale del codigo y el @(PisoLabelSingular.ToLower()) se infiere del numero.</div>
                    </div>
                    <div class="gum-fhead-actions">
                        <button class="gum-unit-save" type="button" @onclick="GuardarUnidad" disabled="@_busy" title="Crear unidad">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
                            @(_busy ? "Creando..." : "Crear")
                        </button>
                        <button class="gum-unit-cancel" type="button" @onclick="CancelarEdicion">Cancelar</button>
                    </div>
                </div>
                <div class="gum-fmeta">
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">ID UNIDAD</div>
                        <input class="gum-fmeta-inp gum-code" @bind="_edit.Codigo" @bind:event="oninput" placeholder="A1-202" />
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">TIPO</div>
                        <select class="gum-fmeta-inp" @bind="_edit.Tipo">@foreach (var t in Enum.GetValues<TipoUnidad>()) { <option value="@t">@t</option> }</select>
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">COEFICIENTE</div>
                        <input type="number" step="0.0001" class="gum-fmeta-inp" @bind="_edit.CoeficientePropiedad" />
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">AREA</div>
                        <input type="number" step="0.01" class="gum-fmeta-inp" @bind="_edit.AreaM2" />
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">ESTADO</div>
                        <input class="gum-fmeta-inp" @bind="_edit.Estado" placeholder="Habitada / Vacia" />
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">MATRICULA</div>
                        <input class="gum-fmeta-inp" @bind="_edit.MatriculaInmobiliaria" />
                    </div>
                </div>
                <div class="gum-fcustom">
                    <div class="gum-fcustom-empty">Guarda la unidad para agregar personas, vehiculos, mascotas y documentos.</div>
                    @if (!string.IsNullOrEmpty(_msg))
                    {
                        <div class="gum-msg @(_msgError ? "gum-msg--err" : "gum-msg--ok")" style="margin-top:12px;">@_msg</div>
                    }
                </div>
            </div>
        }
        else if (_selected is null)
        {
            <div class="gum-empty">
                <div class="gum-empty-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M3 21h18M5 21V7l7-4 7 4v14M9 13h.01M15 13h.01M9 17h.01M15 17h.01"/>
                    </svg>
                </div>
                <div class="gum-empty-title">Selecciona una unidad</div>
                <div class="gum-empty-sub">Haz clic en cualquier unidad del arbol para ver y configurar su ficha completa.</div>
            </div>
        }
        else
        {
            @* Header estilo ficha: identidad + franja de metadatos + tabs (referencia del cliente). *@
            <div class="gum-fhead">
                <div class="gum-fhead-main">
                    <div class="gum-unit-avatar">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-4h4v4"/></svg>
                    </div>
                    <div class="gum-unit-id">
                        <div class="gum-unit-title">@_selected.Tipo @_selected.Numero</div>
                        <div class="gum-unit-meta">
                            @(_selected.TorreNombre ?? "Sin torre")
                            @(_selected.Piso.HasValue ? $" · {PisoLabelSingular} {_selected.Piso}" : "")
                            · @_selected.Tipo
                            @(_selected.AreaM2.HasValue ? $" · {_selected.AreaM2.Value:0.##} m2" : "")
                        </div>
                    </div>
                    <div class="gum-fhead-actions">
                        @if (!_editMode)
                        {
                            <button class="gum-unit-edit" type="button" @onclick="EntrarEdicion" title="Editar ficha">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Editar ficha
                            </button>
                        }
                        else
                        {
                            <button class="gum-unit-del" type="button" @onclick="EliminarUnidad" disabled="@_busy" title="Eliminar unidad">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
                                Eliminar
                            </button>
                            <button class="gum-unit-save" type="button" @onclick="GuardarUnidad" disabled="@_busy" title="Guardar">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
                                @(_busy ? "Guardando..." : "Guardar")
                            </button>
                            <button class="gum-unit-cancel" type="button" @onclick="CancelarEdicion">Cancelar</button>
                        }
                    </div>
                </div>
                @* Franja de datos de la unidad: informativa; se vuelve editable en el sitio con "Editar ficha". *@
                <div class="gum-fmeta">
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">ID UNIDAD</div><div class="gum-fmeta-val">@IdUnidad</div></div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">TIPO</div>
                        @if (_editMode) { <select class="gum-fmeta-inp" @bind="_edit.Tipo">@foreach (var t in Enum.GetValues<TipoUnidad>()) { <option value="@t">@t</option> }</select> } else { <div class="gum-fmeta-val">@_selected.Tipo</div> }
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">COEFICIENTE</div>
                        @if (_editMode) { <input type="number" step="0.0001" class="gum-fmeta-inp" @bind="_edit.CoeficientePropiedad" /> } else { <div class="gum-fmeta-val">@_selected.CoeficientePropiedad.ToString("0.####")%</div> }
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">AREA</div>
                        @if (_editMode) { <input type="number" step="0.01" class="gum-fmeta-inp" @bind="_edit.AreaM2" /> } else { <div class="gum-fmeta-val">@(_selected.AreaM2.HasValue ? $"{_selected.AreaM2.Value:0.##} m2" : "-")</div> }
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">ESTADO</div>
                        @if (_editMode) { <input class="gum-fmeta-inp" @bind="_edit.Estado" placeholder="Habitada / Vacia" /> } else { <div class="gum-fmeta-val">@(string.IsNullOrWhiteSpace(_selected.Estado) ? "-" : _selected.Estado)</div> }
                    </div>
                    <div class="gum-fmeta-f"><div class="gum-fmeta-lbl">MATRICULA</div>
                        @if (_editMode) { <input class="gum-fmeta-inp" @bind="_edit.MatriculaInmobiliaria" /> } else { <div class="gum-fmeta-val">@(string.IsNullOrWhiteSpace(_selected.MatriculaInmobiliaria) ? "-" : _selected.MatriculaInmobiliaria)</div> }
                    </div>
                </div>

                @* Campos personalizados (ficha tecnica) debajo de la franja: informativos, editables con "Editar ficha". *@
                <div class="gum-fcustom">
                    <div class="gum-fmeta-lbl" style="margin-bottom:8px;">CAMPOS PERSONALIZADOS</div>
                    @if (_campos.Count == 0)
                    {
                        <div class="gum-fcustom-empty">
                            Sin campos personalizados todavia.
                            @if (_editMode)
                            {
                                <button class="gum-cf-mini" type="button" @onclick="() => _cfOpen = !_cfOpen">+ Agregar campo</button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="gum-fcustom-grid">
                            @foreach (var c in _campos)
                            {
                                var cc = c;
                                <div class="gum-fmeta-f">
                                    <div class="gum-fmeta-lbl">@c.Label</div>
                                    @if (_editMode)
                                    {
                                        <input class="gum-fmeta-inp" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" placeholder="Sin dato" />
                                    }
                                    else
                                    {
                                        <div class="gum-fmeta-val">@(string.IsNullOrWhiteSpace(c.Valor) ? "-" : c.Valor)</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_editMode && _cfOpen)
                    {
                        <div class="gum-cf-form" style="margin-top:10px;">
                            <input class="gum-input" @bind="_cfLabel" @bind:event="oninput" placeholder="Nombre del campo (ej. N de medidor)" />
                            <input class="gum-input" @bind="_cfValor" @bind:event="oninput" placeholder="Valor (opcional)" />
                            <button class="gum-btn-brand" type="button" @onclick="AgregarCampoPersonalizado" disabled="@(_busy || string.IsNullOrWhiteSpace(_cfLabel))">Crear campo</button>
                        </div>
                    }
                    @if (_editMode && _campos.Count > 0 && !_cfOpen)
                    {
                        <button class="gum-cf-mini" type="button" style="margin-top:10px;" @onclick="() => _cfOpen = true">+ Agregar campo</button>
                    }
                </div>
            </div>

            <div class="gum-ftabs">
                <button type="button" class="gum-ftab @(_fichaTab == "personas" ? "on" : "")" @onclick='() => _fichaTab = "personas"'>Personas</button>
                <button type="button" class="gum-ftab @(_fichaTab == "vehiculos" ? "on" : "")" @onclick='() => _fichaTab = "vehiculos"'>Vehiculos</button>
                <button type="button" class="gum-ftab @(_fichaTab == "mascotas" ? "on" : "")" @onclick='() => _fichaTab = "mascotas"'>Mascotas</button>
                <button type="button" class="gum-ftab @(_fichaTab == "historial" ? "on" : "")" @onclick='() => _fichaTab = "historial"'>Historial relacionado</button>
                <button type="button" class="gum-ftab @(_fichaTab == "cuenta" ? "on" : "")" @onclick='() => _fichaTab = "cuenta"'>Estado de cuenta</button>
            </div>

            <div class="gum-unit-cards">
                @* === Personas vinculadas: tabla inline (referencia del cliente) === *@
                @if (_fichaTab == "personas")
                {
                <div class="gum-unit-card">
                    <div class="gum-people-head">
                        <div class="gum-unit-eyebrow gum-unit-eyebrow--lg">PERSONAS VINCULADAS (@_personas.Count)</div>
                        <div class="gum-people-sub">Propietarios, residentes, arrendatarios y contactos. Si el documento ya existe en el directorio del tenant, se vincula esa persona.</div>
                    </div>
                    <div class="gum-ptbl">
                        <div class="gum-ptbl-head">
                            <span>Nombre</span><span>Identificacion</span><span>Telefono</span><span>Email</span><span>Rol</span><span>Estado</span><span></span>
                        </div>
                        @foreach (var p in _personas)
                        {
                            var pp = p;
                            <div class="gum-ptbl-row @(p.Activo ? "" : "gum-ptbl-row--off")">
                                <div class="gum-ptbl-nom">
                                    <span class="gum-ptbl-ava">@Ini(p.PersonaNombre)</span>
                                    <div class="gum-ptbl-nom-t"><span class="gum-ptbl-nom-n">@p.PersonaNombre</span><span class="gum-ptbl-nom-r">@RolLabel(p.Rol)</span></div>
                                </div>
                                <div class="gum-ptbl-c">@(string.IsNullOrWhiteSpace(p.PersonaDocumento) ? "-" : p.PersonaDocumento)</div>
                                <div class="gum-ptbl-c">@(string.IsNullOrWhiteSpace(p.PersonaTelefono) ? "-" : p.PersonaTelefono)</div>
                                <div class="gum-ptbl-c gum-ptbl-c--email">@(string.IsNullOrWhiteSpace(p.PersonaEmail) ? "-" : p.PersonaEmail)</div>
                                <div class="gum-ptbl-c">
                                    <select class="gum-ptbl-sel" value="@p.Rol" @onchange="(e) => CambiarRolPersonaAsync(pp, e)">
                                        @foreach (var r in Enum.GetValues<RolUnidadPersona>()) { <option value="@r">@RolLabel(r)</option> }
                                    </select>
                                </div>
                                <div class="gum-ptbl-c">
                                    <select class="gum-ptbl-sel gum-ptbl-estado @(p.Activo ? "on" : "off")" value="@(p.Activo ? "1" : "0")" @onchange="(e) => CambiarEstadoPersonaAsync(pp, e)">
                                        <option value="1">Activa</option>
                                        <option value="0">Inactiva</option>
                                    </select>
                                </div>
                                <div class="gum-ptbl-c gum-ptbl-c--act">
                                    <button class="gum-ptbl-del" type="button" title="Quitar de la unidad" @onclick="() => EliminarPersona(pp.Id)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                                    </button>
                                </div>
                            </div>
                        }
                        @* Fila de trabajo (alta inline) *@
                        <div class="gum-ptbl-row gum-ptbl-row--new">
                            <div class="gum-ptbl-nom"><input class="gum-ptbl-inp" placeholder="Nombre y apellido" @bind="_ptNombre" @bind:event="oninput" /></div>
                            <div class="gum-ptbl-c"><input class="gum-ptbl-inp" placeholder="Identificacion" @bind="_ptDoc" @bind:event="oninput" /></div>
                            <div class="gum-ptbl-c"><input class="gum-ptbl-inp" placeholder="Telefono" @bind="_ptTel" @bind:event="oninput" /></div>
                            <div class="gum-ptbl-c"><input class="gum-ptbl-inp" placeholder="Email" @bind="_ptEmail" @bind:event="oninput" /></div>
                            <div class="gum-ptbl-c">
                                <select class="gum-ptbl-inp" @bind="_ptRol">
                                    @foreach (var r in Enum.GetValues<RolUnidadPersona>()) { <option value="@r">@RolLabel(r)</option> }
                                </select>
                            </div>
                            <div class="gum-ptbl-c">
                                <select class="gum-ptbl-inp" @bind="_ptActivo">
                                    <option value="true">Activa</option>
                                    <option value="false">Inactiva</option>
                                </select>
                            </div>
                            <div class="gum-ptbl-c gum-ptbl-c--act">
                                <button class="gum-ptbl-add" type="button" @onclick="AgregarPersonaTablaAsync" disabled="@(_agregandoPersona || string.IsNullOrWhiteSpace(_ptNombre) || string.IsNullOrWhiteSpace(_ptDoc))">@(_agregandoPersona ? "..." : "+ Agregar")</button>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_msg))
                    {
                        <div class="gum-msg @(_msgError ? "gum-msg--err" : "gum-msg--ok")" style="margin-top:10px;">@_msg</div>
                    }
                </div>
                }


                @* === Card PLACAS HABILITADAS PARA INGRESO (proto v3) === *@
                @if (_fichaTab == "vehiculos") {
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">PLACAS HABILITADAS PARA INGRESO</div>
                    @if (_placas.Count == 0)
                    {
                        <div class="gum-people-empty">Sin placas registradas para esta unidad.</div>
                    }
                    else
                    {
                        <div class="gum-inm-list">
                            @foreach (var p in _placas)
                            {
                                <div class="gum-inm">
                                    <div class="gum-inm-icon">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13l2-5h14l2 5M5 13h14v4H5zM7 17v1M17 17v1"/></svg>
                                    </div>
                                    <div class="gum-inm-text">
                                        <div class="gum-inm-name" style="font-family:ui-monospace,monospace;letter-spacing:.5px">@p.Placa</div>
                                        <div class="gum-inm-fact" style="color:#7C98B6">@PlacaTipoLabel(p.TipoVehiculo)</div>
                                    </div>
                                    @if (_editMode)
                                    {
                                        <button class="gum-inm-del" type="button" @onclick="() => EliminarPlaca(p.Id)" title="Quitar">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_editMode)
                    {
                        <div class="gum-inm-add">
                            <select class="gum-inm-input" @bind="_nuevaPlacaTipo">
                                <option value="@TipoVehiculo.Automovil">Carro</option>
                                <option value="@TipoVehiculo.Moto">Moto</option>
                            </select>
                            <input class="gum-inm-input" style="flex:1;min-width:0;text-transform:uppercase" @bind="_nuevaPlaca" @bind:event="oninput" placeholder="ABC123" />
                            <button class="gum-inm-add-btn" type="button" @onclick="AgregarPlaca" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaPlaca))">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                            </button>
                        </div>
                    }
                </div>
                }

                @* === Card ARRIENDOS Y COBROS MENSUALES (proto v3) === *@
                @if (_fichaTab == "cuenta") {
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">ARRIENDOS Y COBROS MENSUALES</div>
                    @if (_arriendos.Count == 0)
                    {
                        <div class="gum-people-empty">Esta unidad no tiene arriendos ni cobros mensuales adicionales.</div>
                    }
                    else
                    {
                        <div class="gum-inm-list">
                            @foreach (var a in _arriendos)
                            {
                                <div class="gum-inm">
                                    <div class="gum-inm-icon" style="background:#E6F6EE;color:#1A8754">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                                    </div>
                                    <div class="gum-inm-text">
                                        <div class="gum-inm-name">@a.Concepto</div>
                                        <div class="gum-inm-fact" style="color:#1A8754">$@a.ValorMensual.ToString("N0") / mes@(string.IsNullOrEmpty(a.Referencia) ? "" : $" - {a.Referencia}")</div>
                                    </div>
                                    @if (_editMode)
                                    {
                                        <button class="gum-inm-del" type="button" @onclick="() => EliminarArriendo(a.Id)" title="Quitar">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_editMode)
                    {
                        <div class="gum-inm-add" style="flex-direction:column;align-items:stretch">
                            <select class="gum-inm-input" @bind="_nuevoArrRef">
                                <option value="">Que arrienda? (opcional)</option>
                                @foreach (var v in _vinculos)
                                {
                                    <option value="@($"{v.AsociadaTipo} {v.AsociadaNumero}")">@v.AsociadaTipo @v.AsociadaNumero</option>
                                }
                            </select>
                            <div style="display:flex;gap:6px">
                                <input class="gum-inm-input" style="flex:1;min-width:0" @bind="_nuevoArrConcepto" @bind:event="oninput" placeholder="Concepto (ej. Arriendo mensual)" />
                                <input class="gum-inm-input" style="width:90px" type="number" step="1" @bind="_nuevoArrValor" placeholder="$ valor" />
                                <button class="gum-inm-add-btn" type="button" @onclick="AgregarArriendo" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoArrConcepto) || _nuevoArrValor is null)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
                }


                @* === Card MASCOTAS (proto v3) === *@
                @if (_fichaTab == "mascotas") {
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">MASCOTAS</div>
                    @if (_mascotas.Count == 0)
                    {
                        <div class="gum-people-empty">Sin mascotas registradas.</div>
                    }
                    else
                    {
                        <div class="gum-inm-list">
                            @foreach (var m in _mascotas)
                            {
                                <div class="gum-inm">
                                    <div class="gum-inm-icon" style="background:#FEF3DC;color:#B45309">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="4" cy="9" r="2"/><circle cx="8" cy="14" r="2"/><path d="M9 18c-2 0-3 1.5-3 3 1.5 0 2.5.5 4 .5s2.5-.5 4-.5c0-1.5-1-3-3-3z"/></svg>
                                    </div>
                                    <div class="gum-inm-text">
                                        <div class="gum-inm-name">@m.Nombre</div>
                                        <div class="gum-inm-fact" style="color:#7C98B6">@m.Tipo@(string.IsNullOrEmpty(m.Raza) ? "" : $" - {m.Raza}")</div>
                                    </div>
                                    @if (_editMode)
                                    {
                                        <button class="gum-inm-del" type="button" @onclick="() => EliminarMascota(m.Id)" title="Quitar">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_editMode)
                    {
                        <div class="gum-inm-add">
                            <input class="gum-inm-input" style="flex:1;min-width:0" @bind="_nuevaMascNombre" @bind:event="oninput" placeholder="Nombre" />
                            <select class="gum-inm-input" @bind="_nuevaMascTipo">
                                @foreach (var t in Enum.GetValues<TipoMascota>()) { <option value="@t">@t</option> }
                            </select>
                            <input class="gum-inm-input" style="width:74px" @bind="_nuevaMascRaza" @bind:event="oninput" placeholder="Raza" />
                            <button class="gum-inm-add-btn" type="button" @onclick="AgregarMascota" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaMascNombre))">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                            </button>
                        </div>
                    }
                </div>
                }



                @* === ESTADISTICA: deuda + estado de cuenta (2.7) + PQRSD (Ola 6) === *@
                @if (_fichaTab == "cuenta") {
                <div class="gum-unit-card--full gum-stats">
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">Deuda actual</div>
                        <div class="gum-stat-val @((_cartera?.SaldoTotal ?? 0) > 0 ? "gum-stat-val--err" : "gum-stat-val--ok")">$ @((_cartera?.SaldoTotal ?? 0).ToString("N0"))</div>
                    </div>
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">Estado de cuenta</div>
                        @if (_cartera is null)
                        {
                            <div class="gum-stat-val gum-stat-val--ok">Sin cartera</div>
                        }
                        else if (_cartera.DiasMora > 0)
                        {
                            <div class="gum-stat-val gum-stat-val--err">En mora · @_cartera.DiasMora d</div>
                        }
                        else
                        {
                            <div class="gum-stat-val gum-stat-val--ok">Al dia</div>
                        }
                    </div>
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">PQRSD</div>
                        <div class="gum-stat-val">@(_histResumen?.TotalPqrsd ?? 0)</div>
                    </div>
                </div>
                }

                @* === HISTORIAL RELACIONADO (Ola 2/3): tareas + PQRSD + mantenimientos de la unidad === *@
                @if (_fichaTab == "historial") {
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-unit-eyebrow">HISTORIAL RELACIONADO</div>
                    <HistorialRelacionadoPanel Jwt="@Jwt" Tipo="TipoEntidadHistorial.Unidad" EntidadId="@_selected.Id" />
                </div>
                }

                @* === BITACORA DE CAMBIOS (RN-06): eventos automaticos de la unidad === *@
                @if (_fichaTab == "historial") {
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-unit-eyebrow">BITACORA DE CAMBIOS</div>
                    @if (_bitacora.Count == 0)
                    {
                        <div class="gum-hist-empty">Sin cambios registrados en la unidad todavia.</div>
                    }
                    else
                    {
                        <div class="gum-bit-list">
                            @foreach (var b in _bitacora)
                            {
                                <div class="gum-bit-item">
                                    <span class="gum-bit-dot"></span>
                                    <div class="gum-bit-body">
                                        <div class="gum-bit-txt">@b.Descripcion</div>
                                        <div class="gum-bit-meta">@b.Fecha.ToLocalTime().ToString("dd MMM yyyy · HH:mm")@(string.IsNullOrWhiteSpace(b.Autor) ? "" : $" · {b.Autor}")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                }

                @* === DOCUMENTOS (proto L.785-792) === *@
                @if (_fichaTab == "historial") {
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">DOCUMENTOS</div>
                    @if (_documentos.Count > 0)
                    {
                        <div class="gum-doc-list">
                            @foreach (var d in _documentos)
                            {
                                <div class="gum-doc-item">
                                    <a class="gum-doc-link" href="@d.Url" target="_blank" rel="noopener" title="@d.Nombre">
                                        @if (EsImagen(d.Nombre))
                                        {
                                            <span class="gum-doc-thumb" style="background-image:url('@d.Url')"></span>
                                        }
                                        else
                                        {
                                            <span class="gum-doc-ic">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                            </span>
                                        }
                                        <span class="gum-doc-meta">
                                            <span class="gum-doc-name">@d.Nombre</span>
                                            <span class="gum-doc-sub">@FmtTamano(d.Tamano) · ver</span>
                                        </span>
                                    </a>
                                    @if (_editMode)
                                    {
                                        <button class="gum-cf-del gum-doc-x" type="button" @onclick="() => EliminarDocumento(d.Id)" title="Quitar">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_editMode)
                    {
                        <label class="gum-doc-upload">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
                            @(_subiendoDoc ? "Subiendo..." : "Subir documentos")
                            <InputFile OnChange="SubirDocumento" accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx" multiple hidden disabled="@_subiendoDoc" />
                        </label>
                    }
                    @if (_documentos.Count == 0 && !_editMode)
                    {
                        <div class="gum-people-empty">Sin documentos. Entra a "Editar ficha" para adjuntar anexos.</div>
                    }
                </div>
                }

                @* === ESTADO DE CUENTA (2.7 Cartera) - Ola 6: datos reales === *@
                @if (_fichaTab == "cuenta") {
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-unit-eyebrow">ESTADO DE CUENTA &middot; 2.7 CARTERA</div>
                    @if (_cartera is null)
                    {
                        <div class="gum-hist-empty">Sin movimientos de cartera para esta unidad (aun no hay liquidaciones del modulo 2.6).</div>
                    }
                    else
                    {
                        <div class="gum-cta-grid">
                            <div class="gum-cta-box"><span>Capital</span><b>$ @_cartera.SaldoCapital.ToString("N0")</b></div>
                            <div class="gum-cta-box"><span>Intereses</span><b>$ @_cartera.SaldoIntereses.ToString("N0")</b></div>
                            <div class="gum-cta-box"><span>Total</span><b class="@(_cartera.SaldoTotal > 0 ? "gum-cta-neg" : "")">$ @_cartera.SaldoTotal.ToString("N0")</b></div>
                            <div class="gum-cta-box"><span>Dias en mora</span><b>@_cartera.DiasMora</b></div>
                        </div>
                        @if (_cartera.TieneAcuerdoVigente)
                        {
                            <div class="gum-cta-badge">Con acuerdo de pago vigente</div>
                        }
                        @if (_cartera.Deudas.Count > 0)
                        {
                            <div class="gum-cta-deudas">
                                @foreach (var d in _cartera.Deudas.OrderByDescending(x => x.Periodo).Take(8))
                                {
                                    <div class="gum-cta-deuda">
                                        <div class="gum-cta-deuda-main">
                                            <span class="gum-cta-deuda-con">@d.Concepto</span>
                                            <span class="gum-cta-deuda-per">@d.Periodo.ToString("MMM yyyy")</span>
                                        </div>
                                        <span class="gum-cta-deuda-val">$ @((d.CapitalPendiente + d.InteresAcumulado).ToString("N0"))</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="gum-people-empty" style="margin-top:8px">La unidad esta al dia: sin deudas pendientes.</div>
                        }
                    }
                </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .gum-header {
        display: flex; align-items: center; gap: 13px;
        padding: 18px 24px;
        border-bottom: 1px solid #EEF3F8;
        flex-shrink: 0;
    }
    .gum-header-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: var(--propia-brand-soft, #F1ECFD);
        color: var(--propia-brand, #6D4FE3);
        display: flex; align-items: center; justify-content: center;
    }
    .gum-header-text { flex: 1; }
    .gum-title { font-size: 16px; font-weight: 800; letter-spacing: -0.3px; color: #1B2A3A; }
