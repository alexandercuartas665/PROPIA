@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public string AgrupacionLabelSingular { get; set; } = "Torre";
    [Parameter] public string PisoLabelSingular { get; set; } = "Piso";

    private List<TorreDto> _torres = new();
    private List<UnidadDto> _unidades = new();
    private UnidadDto? _selected;
    private List<UnidadVinculoDto> _vinculos = new();
    private CuotaConsolidadaDto? _cuota;
    private HashSet<Guid> _torresAbiertas = new();
    private bool _editMode;
    private EditUnidadForm _edit = new();

    // Inmuebles vinculados - form para agregar
    private Guid _nuevoVinculoUnidadId;
    private bool _nuevoVinculoFactura;

    // Campos personalizados (Ficha tecnica)
    private List<CampoVM> _campos = new();  // definiciones (tenant) + valor de la unidad seleccionada
    private bool _cfOpen;
    private string _cfLabel = "";
    private string _cfValor = "";

    private List<UnidadDocumentoDto> _documentos = new();
    private bool _subiendoDoc;

    // Prototipo v3 - bloques nuevos de la ficha de inmueble
    private List<UnidadPlacaDto> _placas = new();
    private string _nuevaPlaca = "";
    private TipoVehiculo _nuevaPlacaTipo = TipoVehiculo.Automovil;

    private List<UnidadArriendoDto> _arriendos = new();
    private string _nuevoArrConcepto = "";
    private decimal? _nuevoArrValor;
    private string _nuevoArrRef = "";

    private List<UnidadMascotaDto> _mascotas = new();
    private string _nuevaMascNombre = "";
    private TipoMascota _nuevaMascTipo = TipoMascota.Perro;
    private string _nuevaMascRaza = "";

    private List<UnidadEmpleadaDto> _empleadas = new();
    private string _nuevaEmpNombre = "";
    private string _nuevaEmpDoc = "";
    private string _nuevaEmpCel = "";
    private string _nuevaEmpHorario = "";

    private class CampoVM
    {
        public Guid DefinicionId { get; set; }
        public string Label { get; set; } = "";
        public int Orden { get; set; }
        public string? Valor { get; set; }
    }

    // Personas vinculadas a la unidad
    private List<UnidadPersonaDto> _personas = new();
    private RolUnidadPersona? _formRol;
    private PersonaForm _personaForm = new();
    private Guid? _editPersonaId;  // null = agregar; con valor = editando esa persona

    private class PersonaForm
    {
        public string Documento { get; set; } = "";
        public string Nombres { get; set; } = "";
        public string Apellidos { get; set; } = "";
        public List<string> Emails { get; set; } = new() { "" };
        public List<string> Telefonos { get; set; } = new() { "" };
        public List<string> Codigos { get; set; } = new() { "+57" };
        public string Parentesco { get; set; } = "";

        public string? PrimerEmail => Emails.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e))?.Trim();
        public string? PrimerTelefono
        {
            get
            {
                for (int i = 0; i < Telefonos.Count; i++)
                {
                    var t = Telefonos[i]?.Trim();
                    if (string.IsNullOrWhiteSpace(t)) continue;
                    var cod = i < Codigos.Count ? Codigos[i] : "";
                    return string.IsNullOrWhiteSpace(cod) ? t : $"{cod} {t}";
                }
                return null;
            }
        }
    }

    private readonly string[] _codigosPais = { "+57", "+1", "+34", "+52", "+54", "+55", "+56", "+58", "+593", "+503", "+507", "+591" };

    private void AddTel() { _personaForm.Telefonos.Add(""); _personaForm.Codigos.Add("+57"); }
    private void RemoveTel(int idx)
    {
        if (idx >= 0 && idx < _personaForm.Telefonos.Count) _personaForm.Telefonos.RemoveAt(idx);
        if (idx >= 0 && idx < _personaForm.Codigos.Count) _personaForm.Codigos.RemoveAt(idx);
    }

    private bool PersonaFormValido =>
        !string.IsNullOrWhiteSpace(_personaForm.Documento) &&
        !string.IsNullOrWhiteSpace(_personaForm.Nombres) &&
        !string.IsNullOrWhiteSpace(_personaForm.Apellidos);

    private class EditUnidadForm
    {
        public string Numero { get; set; } = "";
        public TipoUnidad Tipo { get; set; } = TipoUnidad.Apartamento;
        public Guid? TorreId { get; set; }
        public int? Piso { get; set; }
        public decimal CoeficientePropiedad { get; set; }
        public decimal? AreaM2 { get; set; }
        public int? Habitaciones { get; set; }
        public int? Banos { get; set; }
        public int? Parqueaderos { get; set; }
        public string? Estado { get; set; }
        public string? Observaciones { get; set; }
        public string? MatriculaInmobiliaria { get; set; }
        public bool PagaAdministracion { get; set; } = true;
        public decimal? CuotaMensual { get; set; }
    }
    private bool _huboCambios;
    private bool _busy;
    private string _msg = "";
    private bool _msgError;

    private string AgrupacionLabelPlural => AgrupacionLabelSingular + "s";

    // Modes
    private string? _mode;

    // Manual
    private Guid _manTorreId;
    private int? _manPiso;
    private string _manNumero = "";
    private TipoUnidad _manTipo = TipoUnidad.Apartamento;

    // Generador
    private int _genN = 2;
    private List<string> _genNombres = new() { "Torre A", "Torre B" };
    private int _genPisos = 5;
    private int _genPorPiso = 4;
    private int GenTotal => _genN * _genPisos * _genPorPiso;
    private int _genToast;

    // Import
    private string _csv = "";
    private int CsvCount => string.IsNullOrWhiteSpace(_csv) ? 0 : _csv.Split('\n').Count(l => !string.IsNullOrWhiteSpace(l));

    private decimal CoefTotal => _unidades.Sum(u => u.CoeficientePropiedad);

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _torres = await http.GetFromJsonAsync<List<TorreDto>>("/api/mi-copropiedad/torres") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            if (_torres.Count > 0 && _torresAbiertas.Count == 0)
                _torresAbiertas.Add(_torres[0].Id);
            if (_manTorreId == Guid.Empty && _torres.Count > 0)
                _manTorreId = _torres[0].Id;
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    private void SetMode(string? m) { _mode = (_mode == m) ? null : m; _genToast = 0; }
    private void SetGenN(int n)
    {
        _genN = n;
        while (_genNombres.Count < n) _genNombres.Add($"{AgrupacionLabelSingular} {(char)('A' + _genNombres.Count)}");
        while (_genNombres.Count > n) _genNombres.RemoveAt(_genNombres.Count - 1);
    }

    private void ToggleTorre(Guid id)
    {
        if (!_torresAbiertas.Add(id)) _torresAbiertas.Remove(id);
    }
    private bool IsOpen(Guid id) => _torresAbiertas.Contains(id);

    private async Task SeleccionarUnidad(UnidadDto u)
    {
        _selected = u;
        _editMode = false;
        _vinculos.Clear();
        _personas.Clear();
        _cuota = null;
        _campos.Clear();
        _documentos.Clear();
        _subiendoDoc = false;
        _placas.Clear(); _arriendos.Clear(); _mascotas.Clear(); _empleadas.Clear();
        _nuevaPlaca = ""; _nuevaPlacaTipo = TipoVehiculo.Automovil;
        _nuevoArrConcepto = ""; _nuevoArrValor = null; _nuevoArrRef = "";
        _nuevaMascNombre = ""; _nuevaMascTipo = TipoMascota.Perro; _nuevaMascRaza = "";
        _nuevaEmpNombre = ""; _nuevaEmpDoc = ""; _nuevaEmpCel = ""; _nuevaEmpHorario = "";
        _cfLabel = ""; _cfValor = "";
        _cfOpen = false;
        _formRol = null;
        _editPersonaId = null;
        _personaForm = new PersonaForm();
        _nuevoVinculoUnidadId = Guid.Empty;
        _nuevoVinculoFactura = false;
        try
        {
            _vinculos = await Auth().GetFromJsonAsync<List<UnidadVinculoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/vinculos") ?? new();
        }
        catch { /* sin vinculos */ }
        try
        {
            _personas = await Auth().GetFromJsonAsync<List<UnidadPersonaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/personas") ?? new();
        }
        catch { /* sin personas */ }
        try
        {
            _cuota = await Auth().GetFromJsonAsync<CuotaConsolidadaDto>($"/api/mi-copropiedad/unidades/{u.Id}/cuota-consolidada");
        }
        catch { _cuota = null; }
        await CargarCamposAsync();
        try
        {
            _documentos = await Auth().GetFromJsonAsync<List<UnidadDocumentoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/documentos") ?? new();
        }
        catch { _documentos = new(); }
        try { _placas = await Auth().GetFromJsonAsync<List<UnidadPlacaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/placas") ?? new(); }
        catch { _placas = new(); }
        try { _arriendos = await Auth().GetFromJsonAsync<List<UnidadArriendoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/arriendos") ?? new(); }
        catch { _arriendos = new(); }
        try { _mascotas = await Auth().GetFromJsonAsync<List<UnidadMascotaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/mascotas") ?? new(); }
        catch { _mascotas = new(); }
        try { _empleadas = await Auth().GetFromJsonAsync<List<UnidadEmpleadaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/empleadas") ?? new(); }
        catch { _empleadas = new(); }
    }

    private async Task CargarCamposAsync()
    {
        if (_selected is null) { _campos = new(); return; }
        try
        {
            var dtos = await Auth().GetFromJsonAsync<List<UnidadCampoDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/campos") ?? new();
            _campos = dtos.Select(d => new CampoVM { DefinicionId = d.DefinicionId, Label = d.Label, Orden = d.Orden, Valor = d.Valor }).ToList();
        }
        catch { _campos = new(); }
    }

    private void AbrirFormPersona(RolUnidadPersona rol)
    {
        _editPersonaId = null;
        if (_formRol == rol) { _formRol = null; return; }
        _formRol = rol;
        _personaForm = new PersonaForm();
    }

    private void EditarPersona(UnidadPersonaDto p)
    {
        _formRol = p.Rol;
        _editPersonaId = p.Id;
        string codigo = "+57", numero = "";
        if (!string.IsNullOrWhiteSpace(p.PersonaTelefono))
        {
            var t = p.PersonaTelefono.Trim();
            if (t.StartsWith("+") && t.Contains(' ')) { var sp = t.Split(' ', 2); codigo = sp[0]; numero = sp[1]; }
            else numero = t;
        }
        _personaForm = new PersonaForm
        {
            Documento = p.PersonaDocumento,
            Nombres = p.PersonaNombres,
            Apellidos = p.PersonaApellidos,
            Parentesco = p.Parentesco ?? "",
            Emails = new List<string> { string.IsNullOrWhiteSpace(p.PersonaEmail) ? "" : p.PersonaEmail! },
            Telefonos = new List<string> { numero },
            Codigos = new List<string> { codigo }
        };
    }

    private void CancelarFormPersona() { _formRol = null; _editPersonaId = null; }

    private async Task GuardarPersona()
    {
        if (_selected is null || _formRol is null || !PersonaFormValido) return;
        _busy = true;
        var req = new AgregarPersonaUnidadRequest(
            _personaForm.Documento.Trim(),
            _personaForm.Nombres.Trim(),
            _personaForm.Apellidos.Trim(),
            _personaForm.PrimerEmail,
            _personaForm.PrimerTelefono,
            _formRol.Value,
            true,
            string.IsNullOrWhiteSpace(_personaForm.Parentesco) ? null : _personaForm.Parentesco.Trim());
        HttpResponseMessage resp;
        if (_editPersonaId is not null)
            resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-personas/{_editPersonaId}", req);
        else
            resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/personas", req);

        if (resp.IsSuccessStatusCode)
        {
            var dto = await resp.Content.ReadFromJsonAsync<UnidadPersonaDto>();
            if (dto is not null)
            {
                var idx = _personas.FindIndex(x => x.Id == dto.Id);
                if (idx >= 0) _personas[idx] = dto; else _personas.Add(dto);
            }
            ShowMsg(_editPersonaId is not null ? "Persona actualizada." : "Persona vinculada.", false);
            _formRol = null;
            _editPersonaId = null;
            _personaForm = new PersonaForm();
            _huboCambios = true;
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    private async Task EliminarPersona(Guid unidadPersonaId)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-personas/{unidadPersonaId}");
        if (resp.IsSuccessStatusCode)
        {
            _personas.RemoveAll(p => p.Id == unidadPersonaId);
            _huboCambios = true;
        }
    }

    // ===== Prototipo v3: handlers de los bloques nuevos de la ficha de inmueble =====

    private async Task AgregarPlaca()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_nuevaPlaca)) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/placas",
                new CrearUnidadPlacaRequest(_nuevaPlaca.Trim().ToUpperInvariant(), _nuevaPlacaTipo));
            if (resp.IsSuccessStatusCode)
            {
                _placas = await Auth().GetFromJsonAsync<List<UnidadPlacaDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/placas") ?? _placas;
                _nuevaPlaca = ""; _nuevaPlacaTipo = TipoVehiculo.Automovil;
            }
            else { ShowMsg(await resp.Content.ReadAsStringAsync(), true); }
        }
        finally { _busy = false; }
    }

    private async Task EliminarPlaca(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-placas/{id}");
        if (resp.IsSuccessStatusCode) _placas.RemoveAll(p => p.Id == id);
    }

    private async Task AgregarArriendo()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_nuevoArrConcepto) || _nuevoArrValor is not decimal val) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/arriendos",
                new CrearUnidadArriendoRequest(_nuevoArrConcepto.Trim(), val, string.IsNullOrWhiteSpace(_nuevoArrRef) ? null : _nuevoArrRef.Trim()));
            if (resp.IsSuccessStatusCode)
            {
                _arriendos = await Auth().GetFromJsonAsync<List<UnidadArriendoDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/arriendos") ?? _arriendos;
                _nuevoArrConcepto = ""; _nuevoArrValor = null; _nuevoArrRef = "";
            }
            else { ShowMsg(await resp.Content.ReadAsStringAsync(), true); }
        }
        finally { _busy = false; }
    }

    private async Task EliminarArriendo(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-arriendos/{id}");
        if (resp.IsSuccessStatusCode) _arriendos.RemoveAll(a => a.Id == id);
    }

    private async Task AgregarMascota()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_nuevaMascNombre)) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/mascotas",
                new CrearUnidadMascotaRequest(_nuevaMascNombre.Trim(), _nuevaMascTipo, string.IsNullOrWhiteSpace(_nuevaMascRaza) ? null : _nuevaMascRaza.Trim()));
            if (resp.IsSuccessStatusCode)
            {
                _mascotas = await Auth().GetFromJsonAsync<List<UnidadMascotaDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/mascotas") ?? _mascotas;
                _nuevaMascNombre = ""; _nuevaMascTipo = TipoMascota.Perro; _nuevaMascRaza = "";
            }
            else { ShowMsg(await resp.Content.ReadAsStringAsync(), true); }
        }
        finally { _busy = false; }
    }

    private async Task EliminarMascota(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-mascotas/{id}");
        if (resp.IsSuccessStatusCode) _mascotas.RemoveAll(m => m.Id == id);
    }

    private async Task AgregarEmpleada()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_nuevaEmpNombre)) return;
        _busy = true;
        try
