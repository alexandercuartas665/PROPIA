    private async Task SubirDocumento(InputFileChangeEventArgs e)
    {
        if (_selected is null) return;
        var files = e.GetMultipleFiles(20);
        if (files.Count == 0) return;
        _subiendoDoc = true;
        try
        {
            int ok = 0; string? err = null;
            foreach (var f in files)
            {
                if (f.Size > 10_000_000) { err = $"{f.Name}: supera 10 MB."; continue; }
                using var content = new MultipartFormDataContent();
                var sc = new StreamContent(f.OpenReadStream(10_000_000));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType);
                content.Add(sc, "file", f.Name);
                var resp = await Auth().PostAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/documentos", content);
                if (resp.IsSuccessStatusCode)
                {
                    var dto = await resp.Content.ReadFromJsonAsync<UnidadDocumentoDto>();
                    if (dto is not null) _documentos.Insert(0, dto);
                    ok++;
                }
                else { err = await resp.Content.ReadAsStringAsync(); }
            }
            if (ok > 0) _huboCambios = true;
            if (err is not null) ShowMsg("Error: " + err, true);
            else ShowMsg(ok == 1 ? "Documento adjuntado." : $"{ok} documentos adjuntados.", false);
        }
        finally { _subiendoDoc = false; }
    }

    private async Task EliminarDocumento(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-documentos/{id}");
        if (resp.IsSuccessStatusCode) { _documentos.RemoveAll(d => d.Id == id); _huboCambios = true; }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
    }

    private static bool EsImagen(string nombre)
    {
        var ext = System.IO.Path.GetExtension(nombre ?? "").ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".bmp";
    }

    private static string FmtTamano(long bytes)
    {
        if (bytes <= 0) return "archivo";
        var kb = bytes / 1024.0;
        return kb >= 1024 ? $"{kb / 1024.0:0.#} MB" : $"{Math.Max(1, (int)Math.Round(kb))} KB";
    }

    private async Task Rebalancear()
    {
        _busy = true;
        var resp = await Auth().PostAsync("/api/mi-copropiedad/unidades/rebalancear-coeficientes", null);
        if (resp.IsSuccessStatusCode)
        {
            var r = await resp.Content.ReadFromJsonAsync<RebalanceoCoeficientesDto>();
            _huboCambios = true;
            await CargarAsync();
            if (_selected is not null)
            {
                var fresh = _unidades.FirstOrDefault(u => u.Id == _selected.Id);
                if (fresh is not null) _selected = fresh;
                _cuota = null;
                try { _cuota = await Auth().GetFromJsonAsync<CuotaConsolidadaDto>($"/api/mi-copropiedad/unidades/{_selected!.Id}/cuota-consolidada"); } catch { }
            }
            ShowMsg($"Rebalanceado: {r?.Apartamentos} aptos a {r?.CoefPorApartamento}% c/u. Suma {r?.SumaAnterior:0.##}% -> {r?.SumaNueva:0.##}%.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

