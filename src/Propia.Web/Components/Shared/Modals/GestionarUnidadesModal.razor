        height: 34px; padding: 0 12px; border-radius: 8px; gap: 6px;
        border: 1px solid #FCA5A5; background: #fff;
        color: #DC2626; font-size: 13px; font-weight: 600; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
    }
    .gum-unit-del:hover { background: #FEE2E2; }

    .gum-unit-cards { padding: 18px 22px; display: grid; grid-template-columns: 1fr; gap: 14px; }
    .gum-unit-card { background: #fff; border: 1px solid #E1E8EE; border-radius: 13px; padding: 14px; }
    .gum-unit-card--full { grid-column: 1 / -1; }
    .gum-unit-eyebrow { font-size: 10.5px; letter-spacing: .5px; color: #A6B7C8; font-weight: 700; margin-bottom: 11px; }
    .gum-unit-eyebrow--lg { margin-bottom: 2px; }
    .gum-unit-rows { display: flex; flex-direction: column; gap: 9px; }
    .gum-unit-row { display: flex; align-items: center; justify-content: space-between; font-size: 12.5px; }
    .gum-unit-row span:first-child { color: #7C98B6; }
    .gum-unit-row span:last-child { font-weight: 700; color: #33475B; }

    .gum-unit-edit {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 13px; border-radius: 8px;
        border: 1px solid #DCD2F8; background: #fff;
        font-size: 12.5px; font-weight: 700; color: var(--propia-brand, #6D4FE3);
        cursor: pointer; flex-shrink: 0;
    }
    .gum-unit-edit:hover { background: #F1ECFD; }
    .gum-unit-toggle {
        display: inline-flex; align-items: center; justify-content: center;
        width: 34px; height: 34px; border-radius: 8px; margin-right: 4px;
        border: 1px solid #E1E8EE; background: #fff; color: #516F90;
        cursor: pointer; flex-shrink: 0;
    }
    .gum-unit-toggle:hover { background: #F1ECFD; color: var(--propia-brand, #6D4FE3); border-color: #DCD2F8; }
    .gum-unit-save {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 8px;
        background: var(--propia-brand, #6D4FE3); color: #fff;
        font-size: 12.5px; font-weight: 700; border: 0; cursor: pointer;
        box-shadow: 0 4px 12px rgba(109,79,227,.30); flex-shrink: 0;
    }
    .gum-unit-save:hover { background: var(--propia-brand-hover, #5838C9); }
    .gum-unit-save:disabled { opacity: .6; cursor: not-allowed; box-shadow: none; }
    .gum-unit-cancel {
        padding: 8px 13px; border-radius: 8px;
        border: 1px solid #E1E8EE; background: #fff;
        font-size: 12.5px; font-weight: 600; color: #516F90;
        cursor: pointer; flex-shrink: 0;
    }
    .gum-unit-cancel:hover { background: #F5F8FA; }

    /* Edit grid */
    .gum-edit-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }
    .gum-edit-field { display: flex; flex-direction: column; min-width: 0; }
    .gum-edit-field--full { grid-column: 1 / -1; }
    .gum-check {
        display: flex; align-items: center; gap: 8px;
        font-size: 13px; color: #33475B; font-weight: 600;
        cursor: pointer;
    }
    .gum-check input[type="checkbox"] {
        width: 16px; height: 16px; accent-color: var(--propia-brand, #6D4FE3);
    }

    /* People (Propietario/Residente/Familiar) - proto L.696-715 */
    .gum-people-head { margin-bottom: 13px; }
    .gum-people-sub { font-size: 11px; color: #A6B7C8; margin-top: 2px; }
    .gum-people-group {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 8px;
    }
    .gum-people-group--top {
        margin-top: 10px; padding-top: 10px;
        border-top: 1px solid #F4F7FA;
    }
    .gum-people-tag {
        display: flex; align-items: center; gap: 6px;
        font-size: 11px; font-weight: 800; color: #33475B;
    }
    .gum-people-dot { width: 7px; height: 7px; border-radius: 50%; }
    .gum-people-dot--owner { background: var(--propia-brand, #6D4FE3); }
    .gum-people-dot--resident { background: #2563EB; }
    .gum-people-dot--family { background: #1A8754; }
    .gum-people-dot--tenant { background: #D97706; }
    .gum-people-dot--proxy { background: #6B7280; }
    .gum-people-add {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 11px; font-weight: 700;
        color: var(--propia-brand, #6D4FE3);
        background: #F1ECFD; border: 1px solid #DCD2F8;
        padding: 5px 10px; border-radius: 7px;
        cursor: pointer;
    }
    .gum-people-add:hover { background: #E6DEFA; }
    .gum-people-empty {
        font-size: 11.5px; color: #A6B7C8;
        padding: 4px 2px 10px;
    }
    .gum-persons-grid {
        display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;
        margin-bottom: 8px;
    }
    .gum-person-card {
        border: 1px solid #E1E8EE; border-radius: 11px;
        padding: 12px; background: #FBFBFD;
    }
    .gum-person-head { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
    .gum-person-avatar {
        width: 34px; height: 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 12px; font-weight: 700; flex-shrink: 0;
    }
    .gum-people-avatar--owner { background: linear-gradient(135deg, #33475B, #1B2A3A); }
    .gum-people-avatar--resident { background: linear-gradient(135deg, #2563EB, #1E40AF); }
    .gum-people-avatar--family { background: linear-gradient(135deg, #22A565, #15703F); }
    .gum-person-id { flex: 1; min-width: 0; }
    .gum-person-name { font-size: 13px; font-weight: 700; color: #33475B; }
    .gum-person-rol { font-size: 10.5px; color: #7C98B6; font-weight: 600; margin-top: 1px; }
    .gum-person-del {
        width: 24px; height: 24px; border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        color: #C3D0DD; border: 0; background: transparent; cursor: pointer; flex-shrink: 0;
    }
    .gum-person-del:hover { background: #FDE7E7; color: #D7263D; }
    .gum-person-edit {
        width: 24px; height: 24px; border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        color: #C3D0DD; border: 0; background: transparent; cursor: pointer; flex-shrink: 0;
    }
    .gum-person-edit:hover { background: var(--propia-brand-soft, #F1ECFD); color: var(--propia-brand, #6D4FE3); }
    .gum-person-contact {
        display: flex; align-items: center; gap: 6px;
        font-size: 11.5px; color: #516F90;
        padding: 1px 0;
    }
    .gum-person-form {
        background: #FBFAFE; border: 1px dashed #DCD2F8; border-radius: 10px;
        padding: 12px; margin-bottom: 8px;
        display: flex; flex-direction: column; gap: 8px;
    }
    .gum-person-form .gum-input { font-size: 12px; padding: 7px 10px; }

    /* Form persona estilo prototipo (multiples emails y telefonos) */
    /* Formulario de persona (propietario, residente, arrendatario, familiar, apoderado): es el
       mismo contenedor para todos los roles. Se limita a 6 de 12 columnas porque desde que la
       ficha ocupa todo el ancho, los campos estirados al 100% se veian desproporcionados. */
    .gum-pf {
        background: #FBFAFE; border: 1px dashed #DCD2F8; border-radius: 10px;
        padding: 12px; margin-bottom: 10px;
        max-width: 50%;
    }
    /* En pantallas angostas 50% deja los campos inservibles: vuelve a ancho completo. */
    @@media (max-width: 1100px) { .gum-pf { max-width: 100%; } }
    .gum-pf-row { display: flex; align-items: center; gap: 6px; margin-bottom: 7px; flex-wrap: wrap; }
    .gum-pf-input {
        border: 1px solid #E1E8EE; border-radius: 7px;
        padding: 7px 10px; font-size: 12px; color: #33475B;
        background: #fff; outline: none; font-family: inherit;
        width: 100%; box-sizing: border-box; min-width: 0;
    }
    .gum-pf-input:focus { border-color: var(--propia-brand, #6D4FE3); }
    .gum-pf-eyebrow {
        font-size: 9.5px; letter-spacing: .4px; color: #A6B7C8;
        font-weight: 700; margin: 10px 0 5px;
    }
    .gum-pf-item { display: flex; align-items: center; gap: 5px; margin-bottom: 5px; }
    .gum-pf-cod { max-width: 80px; flex-shrink: 0; padding: 7px 5px; font-size: 11px; }
    .gum-pf-x {
        width: 22px; height: 22px; border-radius: 6px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        color: #C3D0DD; border: 0; background: transparent; cursor: pointer;
    }
    .gum-pf-x:hover { background: #FDE7E7; color: #D7263D; }
    .gum-pf-add {
        font-size: 10.5px; font-weight: 700;
        color: var(--propia-brand, #6D4FE3);
        background: transparent; border: 0; cursor: pointer;
        padding: 2px 0; margin-top: 3px;
    }
    .gum-pf-add:hover { text-decoration: underline; }
    .gum-pf-footer {
        display: flex; justify-content: flex-end; gap: 8px;
        margin-top: 12px;
    }
    .gum-btn-ghost {
        padding: 8px 14px; border-radius: 9px;
        background: #fff; border: 1px solid #E1E8EE;
        font-size: 12.5px; font-weight: 600; color: #516F90; cursor: pointer;
    }
    .gum-btn-ghost:hover { background: #F5F8FA; }

    /* Inmuebles vinculados */
    .gum-inm-list { display: flex; flex-direction: column; gap: 8px; }
    .gum-inm { display: flex; align-items: center; gap: 9px; }
    .gum-inm-icon {
        width: 30px; height: 30px; border-radius: 8px;
        background: #EEF3F8; color: #516F90;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .gum-inm-text { flex: 1; min-width: 0; }
    .gum-inm-name { font-size: 12.5px; font-weight: 700; color: #33475B; }
    .gum-inm-fact { font-size: 10.5px; font-weight: 600; }
    .gum-inm-del {
        width: 22px; height: 22px; border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        color: #C3D0DD; border: 0; background: transparent; cursor: pointer; flex-shrink: 0;
    }
    .gum-inm-del:hover { background: #FDE7E7; color: #D7263D; }
    .gum-inm-add {
        display: flex; gap: 5px; margin-top: 9px;
    }
    .gum-inm-input {
        flex: 1; min-width: 0;
        border: 1px solid #E1E8EE; border-radius: 8px;
        padding: 7px 8px; font-size: 11.5px; color: #33475B;
        outline: none; background: #fff; font-family: inherit;
    }
    .gum-inm-input:focus { border-color: var(--propia-brand, #6D4FE3); }
    .gum-inm-add-btn {
        width: 30px; height: 30px; flex-shrink: 0;
        border-radius: 8px; background: var(--propia-brand, #6D4FE3);
        color: #fff; border: 0; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
    }
    .gum-inm-add-btn:hover { background: var(--propia-brand-hover, #5838C9); }
    .gum-inm-add-btn:disabled { opacity: .4; cursor: not-allowed; }

    /* Oleada 2 - tab Actuales/Historico + timeline titularidad + campos por persona */
    .gum-ctab-bar {
        display: inline-flex; gap: 4px; background: #F1F5F9; border: 1px solid #E1E8EE;
        border-radius: 9px; padding: 3px; margin-bottom: 14px;
    }
    .gum-ctab {
        display: flex; align-items: center; gap: 6px; padding: 6px 13px; border-radius: 7px;
        font-size: 11.5px; font-weight: 700; color: #7C98B6; background: transparent; border: none; cursor: pointer;
    }
    .gum-ctab.on { color: var(--propia-brand, #6D4FE3); background: #fff; box-shadow: 0 1px 2px rgba(45,62,80,.12); }
    .gum-tit-list { display: flex; flex-direction: column; }
    .gum-tit { display: flex; gap: 12px; }
    .gum-tit-dot {
        width: 11px; height: 11px; border-radius: 50%; background: #C3D0DD; margin-top: 5px; flex-shrink: 0;
        box-shadow: 0 0 0 3px #EEF3F8;
    }
    .gum-tit-dot--act { background: var(--propia-brand, #6D4FE3); box-shadow: 0 0 0 3px #EDE7FB; }
    .gum-tit-body { flex: 1; min-width: 0; border-left: 2px solid #EEF3F8; margin-left: -6px; padding: 0 0 16px 16px; }
    .gum-tit-top { display: flex; align-items: center; gap: 8px; }
    .gum-tit-name { font-size: 13px; font-weight: 700; color: #33475B; }
    .gum-tit-badge {
        font-size: 9.5px; font-weight: 800; color: #1A8754; background: #E6F6EE;
        padding: 2px 7px; border-radius: 5px;
    }
    .gum-tit-rol { font-size: 10.5px; color: var(--propia-brand, #6D4FE3); font-weight: 700; margin-top: 2px; }
    .gum-tit-dates { font-size: 11px; color: #7C98B6; font-weight: 600; margin-top: 4px; }
    .gum-pcampos { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 7px; }
    .gum-pcampo {
        display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; color: #516F90;
        background: #F1ECFD; border: 1px solid #DCD2F8; padding: 2px 8px; border-radius: 6px;
    }
    .gum-pcampo b { color: #33475B; font-weight: 700; }
    .gum-pcampo-x { border: none; background: none; color: #A6B7C8; cursor: pointer; font-size: 13px; line-height: 1; padding: 0 0 0 2px; }
    .gum-pcampo-x:hover { color: #D7263D; }

    /* Card head row (eyebrow + boton agregar campo) */
    .gum-card-head-row {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 11px;
    }
    .gum-card-head-row .gum-unit-eyebrow { margin-bottom: 0; }

    /* Campos personalizados */
    .gum-cf-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
        background: #EEF3F8; border: 1px solid #EEF3F8; border-radius: 10px;
        overflow: hidden; margin-bottom: 10px;
    }
    .gum-cf-cell {
        background: #fff; padding: 10px 12px; position: relative;
    }
    .gum-cf-lbl { font-size: 10.5px; color: #A6B7C8; font-weight: 600; }
    .gum-cf-val { font-size: 12.5px; font-weight: 600; color: #33475B; margin-top: 2px; padding-right: 16px; }
    .gum-cf-del {
        position: absolute; top: 8px; right: 7px;
        width: 18px; height: 18px; border-radius: 5px;
        display: flex; align-items: center; justify-content: center;
        color: #C3D0DD; border: 0; background: transparent; cursor: pointer;
    }
    .gum-cf-del:hover { background: #FDE7E7; color: #D7263D; }
    .gum-cf-input { margin-top: 4px; width: 100%; padding: 6px 8px; font-size: 12px; }
    .gum-cf-form {
        display: flex; gap: 7px; align-items: center;
        background: #FBFAFE; border: 1px dashed #DCD2F8; border-radius: 10px;
        padding: 11px;
    }
    .gum-cf-form .gum-input { flex: 1; padding: 8px 10px; font-size: 12px; }

    /* Estadistica */
    .gum-stats {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
    }
    .gum-stat {
        background: #fff; border: 1px solid #E1E8EE; border-radius: 12px;
        padding: 13px 14px;
    }
    .gum-stat-lbl { font-size: 11px; color: #A6B7C8; font-weight: 600; }
    .gum-stat-val {
        font-size: 18px; font-weight: 800; color: #1B2A3A; margin-top: 3px;
    }
    .gum-stat-val--ok { color: #1A8754; }
    .gum-stat-val--err { color: #C0383C; }

    /* Historial / Facturas vacios */
    .gum-hist-empty { font-size: 11.5px; color: #A6B7C8; padding: 4px 2px; }
    /* Bitacora de cambios de la unidad (RN-06): linea de tiempo compacta. */
    .gum-bit-list { display: flex; flex-direction: column; gap: 0; }
    .gum-bit-item { display: flex; gap: 10px; padding: 8px 0; border-bottom: 1px solid #F1F4F7; }
    .gum-bit-item:last-child { border-bottom: 0; }
    .gum-bit-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--propia-brand, #6D4FE3); margin-top: 5px; flex-shrink: 0; }
    .gum-bit-body { flex: 1; min-width: 0; }
    .gum-bit-txt { font-size: 12.5px; color: #33475B; }
    .gum-bit-meta { font-size: 10.5px; color: #A6B7C8; margin-top: 1px; }
    /* Estado de cuenta (2.7 Cartera) en la ficha de unidad. */
    .gum-cta-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .gum-cta-box { border: 1px solid #E1E8EE; border-radius: 9px; padding: 8px 10px; display: flex; flex-direction: column; gap: 2px; }
    .gum-cta-box span { font-size: 10.5px; color: #A6B7C8; font-weight: 600; }
    .gum-cta-box b { font-size: 13px; color: #33475B; }
    .gum-cta-neg { color: #C0383C !important; }
    .gum-cta-badge { display: inline-block; margin-top: 10px; font-size: 11px; font-weight: 700; color: #1A8754; background: #E6F6EE; padding: 4px 10px; border-radius: 7px; }
    .gum-cta-deudas { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
    .gum-cta-deuda { display: flex; align-items: center; justify-content: space-between; gap: 8px; border: 1px solid #EEF2F6; border-radius: 8px; padding: 7px 11px; }
    .gum-cta-deuda-main { display: flex; flex-direction: column; }
    .gum-cta-deuda-con { font-size: 12px; font-weight: 700; color: #33475B; }
    .gum-cta-deuda-per { font-size: 10.5px; color: #A6B7C8; text-transform: capitalize; }
    .gum-cta-deuda-val { font-size: 12.5px; font-weight: 700; color: #C0383C; }

    /* Documentos */
    .gum-doc-upload {
        display: flex; align-items: center; justify-content: center; gap: 7px;
        border: 1px dashed #DCD2F8; border-radius: 9px;
        padding: 10px; font-size: 12px; font-weight: 600;
        color: var(--propia-brand, #6D4FE3); background: #FBFAFE;
        cursor: pointer;
    }
    .gum-doc-upload:hover { background: #F5F1FE; border-color: var(--propia-brand, #6D4FE3); }
    .gum-doc-upload input[type="file"] { display: none; }
    .gum-doc-list { display: flex; flex-direction: column; gap: 7px; margin-bottom: 9px; }
    .gum-doc-item { display: flex; align-items: center; gap: 6px; }
    .gum-doc-link {
        flex: 1; min-width: 0; display: flex; align-items: center; gap: 9px;
        padding: 7px 9px; border: 1px solid #E1E8EE; border-radius: 9px;
        text-decoration: none; background: #fff;
    }
    .gum-doc-link:hover { border-color: var(--propia-brand, #6D4FE3); box-shadow: 0 6px 14px rgba(109,79,227,.12); }
    .gum-doc-thumb { width: 30px; height: 30px; border-radius: 7px; background-size: cover; background-position: center; flex-shrink: 0; border: 1px solid #E1E8EE; }
    .gum-doc-ic { width: 30px; height: 30px; border-radius: 7px; background: var(--propia-brand-soft, #F1ECFD); color: var(--propia-brand, #6D4FE3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .gum-doc-meta { min-width: 0; display: flex; flex-direction: column; }
    .gum-doc-name { font-size: 11.5px; font-weight: 600; color: #33475B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gum-doc-sub { font-size: 10px; color: #A6B7C8; }
    .gum-doc-x { position: static; }

    /* Dark mode minimal */
    [data-bs-theme="dark"] .gum-header,
    [data-bs-theme="dark"] .gum-panel-left { background: #1B2233; }
    [data-bs-theme="dark"] .gum-title,
    [data-bs-theme="dark"] .gum-unit-title { color: #E5E7EB; }
    [data-bs-theme="dark"] .gum-panel-right { background: #161B2D; }
    [data-bs-theme="dark"] .gum-unit-card,
    [data-bs-theme="dark"] .gum-card-soft { background: #232B40; border-color: #2D3650; }
    [data-bs-theme="dark"] .gum-torre,
    [data-bs-theme="dark"] .gum-unit { background: #232B40; border-color: #2D3650; }
    [data-bs-theme="dark"] .gum-torre-head { background: #1B2233; color: #B6C6DC; }
    [data-bs-theme="dark"] .gum-torre-head:hover { background: #232B40; }

    /* Movil: apilar master/detalle y colapsar grids internos a 1 columna (hasta 640px). */
    @@media (max-width: 640px) {
        .gum-header { padding: 12px 14px; gap: 10px; }
        .gum-title { font-size: 15px; }
        .gum-body { flex-direction: column; }
        .gum-panel-left { width: 100%; flex-shrink: 1; border-right: 0; padding: 16px 14px; }
        .gum-unit-head { padding: 14px 14px; }
        .gum-unit-cards { padding: 16px 14px; }
        .gum-grid3,
        .gum-grid2,
        .gum-unit-cards,
        .gum-edit-grid,
        .gum-persons-grid,
        .gum-cf-grid,
        .gum-stats { grid-template-columns: 1fr; }
    }
    /* ===== Ficha rediseno: header meta + tabs + tabla personas ===== */
    .gum-fhead { padding: 18px 22px 0; border-bottom: 1px solid #EEF3F8; }
    .gum-fhead-main { display: flex; align-items: center; gap: 14px; }
    .gum-fhead-main .gum-unit-avatar { width: 46px; height: 46px; border-radius: 13px; flex: 0 0 auto; }
