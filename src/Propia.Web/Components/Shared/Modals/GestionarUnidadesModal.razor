    .gum-card-sub { font-size: 11px; color: #A6B7C8; margin-bottom: 12px; }

    .gum-form-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 11px; }
    .gum-field { display: flex; flex-direction: column; min-width: 0; }
    .gum-grow { flex: 1; min-width: 0; }
    .gum-lbl { font-size: 11px; color: #7C98B6; font-weight: 700; margin-bottom: 5px; display: block; }
    .gum-input {
        border: 1px solid #DCD2F8; border-radius: 9px;
