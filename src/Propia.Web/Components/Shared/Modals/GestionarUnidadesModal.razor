        font-size: 12.5px; color: #15703F; font-weight: 600;
    }
    .gum-toast-icon { width:26px; height:26px; border-radius:7px; background:#1A8754; color:#fff; display:flex; align-items:center; justify-content:center; flex-shrink:0; }

    .gum-summary {
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
