@* GestionarUnidadesModal - D.1 del catalogo (fullscreen).
   Replica literal del modal del prototipo PROPIA.dc.html L.584-720.
   Componente reutilizable: recibe Jwt + cargas las torres/unidades por su cuenta.
   Layout 2 paneles: izq lista torres/unidades, der ficha unidad seleccionada. *@

@inherits ModalBase<bool>
@using Propia.Web.Components.Shared.Modals
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums

@inject IHttpClientFactory HttpFactory

@* ====== HEADER ====== *@
<div class="gum-header">
    <div class="gum-header-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
    </div>
    <div class="gum-header-text">
        <div class="gum-title">2. Distribucion</div>
        <div class="gum-subtitle">Como esta compuesto?</div>
    </div>
    <button class="gum-close" @onclick="Cerrar" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

@* ====== 2 PANELES ====== *@
<div class="gum-body">

    @* ===== Panel IZQ - arbol torres > pisos > unidades ===== *@
    <div class="gum-panel-left">
        @if (_genToast > 0)
        {
            <div class="gum-toast-ok">
                <div class="gum-toast-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5 9-11"/></svg></div>
                Estructura generada: <b>@_genToast unidades</b> creadas en el arbol.
            </div>
        }

        <div class="gum-summary">
            <span class="gum-summary-strong">@_torres.Count @AgrupacionLabelPlural</span>
            <span class="gum-summary-sep">-</span>
            <span>@_unidades.Count unidades</span>
            @if (_unidades.Count > 0)
            {
                var coefOk = Math.Abs(CoefTotal - 100m) < 0.01m;
                <span class="gum-chip @(coefOk ? "" : "gum-chip--warn")">
                    @if (coefOk)
                    {
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5 9-11"/></svg>
                    }
                    else
                    {
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 9v4M12 17h.01M4.93 19h14.14a2 2 0 0 0 1.73-3L13.73 4a2 2 0 0 0-3.46 0L3.2 16a2 2 0 0 0 1.73 3z"/></svg>
                    }
                    Coeficientes: @CoefTotal.ToString("0.##")%
                </span>
                @if (!coefOk)
                {
                    <button class="gum-rebal-btn" type="button" @onclick="Rebalancear" disabled="@_busy">
                        @(_busy ? "Rebalanceando..." : "Rebalancear a 100%")
                    </button>
                }
            }
        </div>

        @* CTAs *@
        <div class="gum-ctas">
            <button class="gum-cta @(_mode == "manual" ? "gum-cta--active" : "")" @onclick='() => SetMode("manual")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
                Agregar manual
            </button>
            <button class="gum-cta @(_mode == "import" ? "gum-cta--active" : "")" @onclick='() => SetMode("import")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
                Importar Excel
            </button>
            <button class="gum-cta gum-cta--brand @(_mode == "gen" ? "gum-cta--active" : "")" @onclick='() => SetMode("gen")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z"/></svg>
                Generar automatico
            </button>
        </div>

        @* Wizard inline segun modo *@
        @if (_mode == "manual")
        {
            <div class="gum-card-soft">
                <div class="gum-card-title">Agregar unidad manualmente</div>
                <div class="gum-card-sub">Indica la torre y el piso: la unidad se incorpora al arbol junto a las demas.</div>
                <div class="gum-form-row">
                    <div class="gum-field gum-grow">
                        <label class="gum-lbl">@AgrupacionLabelSingular</label>
                        <select class="gum-input" @bind="_manTorreId">
                            @foreach (var t in _torres) { <option value="@t.Id">@t.Nombre</option> }
                        </select>
                    </div>
                    <div class="gum-field" style="width:110px">
                        <label class="gum-lbl">@PisoLabelSingular</label>
                        <input type="number" min="1" class="gum-input" @bind="_manPiso" placeholder="1" />
                    </div>
                </div>
                <div class="gum-form-row">
                    <input class="gum-input gum-grow" @bind="_manNumero" @bind:event="oninput" placeholder="Identificador (ej. 1501)" />
                    <select class="gum-input" @bind="_manTipo">
                        @foreach (var t in Enum.GetValues<TipoUnidad>()) { <option value="@t">@t</option> }
                    </select>
                    <button class="gum-btn-brand" @onclick="AgregarUnidadManual" disabled="@(string.IsNullOrWhiteSpace(_manNumero))">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                        Agregar
                    </button>
                </div>
            </div>
        }

        @if (_mode == "gen")
        {
            <div class="gum-card-brand">
                <div class="gum-genhead">
                    <div class="gum-genicon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z"/></svg></div>
                    <div>
                        <div class="gum-gen-title">Generador inteligente</div>
                        <div class="gum-gen-sub">Configuralo una vez y crea toda la estructura</div>
                    </div>
                </div>
                <div class="gum-lbl">Cuantas @AgrupacionLabelPlural.ToLower() tiene tu conjunto?</div>
                <div class="gum-n-options">
                    @for (int n = 1; n <= 6; n++)
                    {
                        var i = n;
                        <button class="gum-n @(_genN == i ? "gum-n--active" : "")" @onclick="() => SetGenN(i)">@i</button>
                    }
                </div>
                <div class="gum-lbl">Nombre de cada @AgrupacionLabelSingular.ToLower()</div>
                <div class="gum-grid3">
                    @for (int i = 0; i < _genNombres.Count; i++)
                    {
                        var idx = i;
                        <input class="gum-input" @bind="_genNombres[idx]" @bind:event="oninput" />
                    }
                </div>
                <div class="gum-grid2">
                    <div class="gum-field"><label class="gum-lbl">@(PisoLabelSingular)s por @AgrupacionLabelSingular.ToLower()</label><input class="gum-input" type="number" min="1" @bind="_genPisos" /></div>
                    <div class="gum-field"><label class="gum-lbl">Unidades por @PisoLabelSingular.ToLower()</label><input class="gum-input" type="number" min="1" @bind="_genPorPiso" /></div>
                </div>
                <div class="gum-preview">
                    <div class="gum-preview-eyebrow">VISTA PREVIA</div>
                    <div class="gum-preview-chips">
                        @foreach (var n in _genNombres)
                        {
                            <span class="gum-preview-chip">@n - @(_genPisos * _genPorPiso) unidades</span>
                        }
                    </div>
                    <div class="gum-preview-total">Total: @GenTotal unidades a generar</div>
                </div>
                <div class="gum-gen-footer">
                    <button class="gum-btn-ghost" @onclick='() => SetMode(null)'>Cancelar</button>
                    <button class="gum-btn-brand" @onclick="EjecutarGenerador" disabled="@_busy">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z"/></svg>
                        Generar @GenTotal unidades
                    </button>
                </div>
            </div>
        }

        @if (_mode == "import")
        {
            <div class="gum-card-soft">
                <div class="gum-card-title">Importar desde Excel / CSV</div>
                <div class="gum-card-sub">Pega una columna de identificadores (uno por linea). Se validan antes de importar.</div>
                <textarea class="gum-input" rows="4" @bind="_csv" @bind:event="oninput" placeholder="1501&#10;1502&#10;1503"></textarea>
                <div class="gum-import-foot">
                    <span class="gum-import-count">@CsvCount unidades detectadas</span>
                    <button class="gum-btn-brand" @onclick="ImportarCsv" disabled="@(CsvCount == 0)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
                        Importar
                    </button>
                </div>
            </div>
        }

        @* Lista de torres *@
        @foreach (var t in _torres)
        {
            <div class="gum-torre">
                <button class="gum-torre-head" @onclick="() => ToggleTorre(t.Id)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                         style="@($"transform:rotate({(IsOpen(t.Id) ? 90 : 0)}deg);transition:transform .18s")">
                        <path d="M9 6l6 6-6 6"/>
                    </svg>
                    <span class="gum-torre-name">@t.Nombre</span>
                    <span class="gum-torre-meta">- @_unidades.Count(u => u.TorreId == t.Id) unidades</span>
                </button>
                @if (IsOpen(t.Id))
                {
                    <div class="gum-torre-body">
                        @foreach (var grupo in _unidades.Where(u => u.TorreId == t.Id).GroupBy(u => u.Piso ?? 0).OrderBy(g => g.Key))
                        {
                            <div class="gum-piso">
                                <span class="gum-piso-lbl">@PisoLabelSingular @grupo.Key</span>
                                <div class="gum-piso-units">
                                    @foreach (var u in grupo.OrderBy(x => x.Numero))
                                    {
                                        <button class="gum-unit @(_selected?.Id == u.Id ? "gum-unit--active" : "")" @onclick="() => SeleccionarUnidad(u)">@u.Numero</button>
                                    }
                                </div>
                            </div>
                        }
                        @if (!_unidades.Any(u => u.TorreId == t.Id))
                        {
                            <div class="gum-torre-empty">Sin unidades. Usa "Agregar manual" o "Generador automatico".</div>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="gum-msg @(_msgError ? "gum-msg--err" : "gum-msg--ok")">@_msg</div>
        }
    </div>

    @* ===== Panel DER - ficha unidad ===== *@
    <div class="gum-panel-right">
        @if (_selected is null)
        {
            <div class="gum-empty">
                <div class="gum-empty-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M3 21h18M5 21V7l7-4 7 4v14M9 13h.01M15 13h.01M9 17h.01M15 17h.01"/>
                    </svg>
                </div>
                <div class="gum-empty-title">Selecciona una unidad</div>
                <div class="gum-empty-sub">Haz clic en cualquier unidad del arbol para ver y configurar su ficha completa.</div>
            </div>
        }
        else
        {
            <div class="gum-unit-head">
                <div class="gum-unit-avatar">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-4h4v4"/></svg>
                </div>
                <div class="gum-unit-id">
                    <div class="gum-unit-title">@_selected.Tipo @_selected.Numero</div>
                    <div class="gum-unit-meta">
                        @(_selected.TorreNombre ?? "Sin torre")
                        @(_selected.Piso.HasValue ? $" · {PisoLabelSingular} {_selected.Piso}" : "")
                        · @_selected.Tipo
                        @(_selected.AreaM2.HasValue ? $" · {_selected.AreaM2.Value:0.##} m2" : "")
                    </div>
                </div>
                @if (!_editMode)
                {
                    <button class="gum-unit-edit" type="button" @onclick="EntrarEdicion" title="Editar ficha">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Editar ficha
                    </button>
                }
                else
                {
                    <button class="gum-unit-save" type="button" @onclick="GuardarUnidad" disabled="@_busy" title="Guardar">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
                        @(_busy ? "Guardando..." : "Guardar")
                    </button>
                    <button class="gum-unit-cancel" type="button" @onclick="CancelarEdicion">Cancelar</button>
                }
                <button class="gum-unit-del" @onclick="EliminarUnidad" title="Eliminar unidad">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="gum-unit-cards">
                @* === Card PROPIETARIO, RESIDENTE Y CONTACTOS (proto L.696-715) === *@
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-people-head">
                        <div class="gum-unit-eyebrow gum-unit-eyebrow--lg">PROPIETARIO, RESIDENTE Y CONTACTOS</div>
                        <div class="gum-people-sub">Cada miembro (propietario, residente, familiar) tiene su propio documento, email y telefono.</div>
                    </div>

                    @foreach (var grupo in new[] {
                        (Rol: RolUnidadPersona.Propietario, Label: "Propietario", DotClass: "gum-people-dot--owner", EmptyMsg: "Sin propietario registrado."),
                        (Rol: RolUnidadPersona.Residente, Label: "Residente", DotClass: "gum-people-dot--resident", EmptyMsg: "Sin residente registrado. Si el propietario habita la unidad, no es necesario."),
                        (Rol: RolUnidadPersona.Arrendatario, Label: "Arrendatario", DotClass: "gum-people-dot--tenant", EmptyMsg: "Sin arrendatario. Vincula uno si la unidad esta en alquiler."),
                        (Rol: RolUnidadPersona.Familiar, Label: "Grupo familiar", DotClass: "gum-people-dot--family", EmptyMsg: "Sin otros miembros del grupo familiar."),
                        (Rol: RolUnidadPersona.Apoderado, Label: "Apoderado", DotClass: "gum-people-dot--proxy", EmptyMsg: "Sin apoderado registrado.")
                    })
                    {
                        var personasRol = _personas.Where(p => p.Rol == grupo.Rol).ToList();
                        var rolLower = grupo.Rol.ToString().ToLower();
                        <div class="gum-people-group @(grupo.Rol == RolUnidadPersona.Propietario ? "" : "gum-people-group--top")">
                            <span class="gum-people-tag"><span class="gum-people-dot @grupo.DotClass"></span>@grupo.Label</span>
                            <button class="gum-people-add" type="button" @onclick="() => AbrirFormPersona(grupo.Rol)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                                Agregar @rolLower
                            </button>
                        </div>
                        @if (personasRol.Count > 0)
                        {
                            <div class="gum-persons-grid">
                                @foreach (var p in personasRol)
                                {
                                    var ini = (p.PersonaNombre.Length > 0 ? p.PersonaNombre[0].ToString() : "?")
                                            + (p.PersonaNombre.Contains(' ') ? p.PersonaNombre.Split(' ', 2)[1][0].ToString() : "");
                                    <div class="gum-person-card">
                                        <div class="gum-person-head">
                                            <div class="gum-person-avatar @grupo.DotClass.Replace("dot", "avatar")">@ini.ToUpper()</div>
                                            <div class="gum-person-id">
                                                <div class="gum-person-name">@p.PersonaNombre</div>
                                                <div class="gum-person-rol">@grupo.Label · @p.PersonaDocumento@(string.IsNullOrEmpty(p.Parentesco) ? "" : $" · {p.Parentesco}")</div>
                                            </div>
                                            <button class="gum-person-del" type="button" @onclick="() => EliminarPersona(p.Id)" title="Quitar">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrEmpty(p.PersonaEmail))
                                        {
                                            <div class="gum-person-contact">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#A6B7C8" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/></svg>
                                                @p.PersonaEmail
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(p.PersonaTelefono))
                                        {
                                            <div class="gum-person-contact">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#A6B7C8" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                                                @p.PersonaTelefono
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (_formRol != grupo.Rol)
                        {
                            <div class="gum-people-empty">@grupo.EmptyMsg</div>
                        }
                        @if (_formRol == grupo.Rol)
                        {
                            <div class="gum-person-form">
                                <div class="gum-form-row">
                                    <input class="gum-input gum-grow" @bind="_personaForm.Documento" @bind:event="oninput" placeholder="Documento *" />
                                    <input class="gum-input gum-grow" @bind="_personaForm.Nombres" @bind:event="oninput" placeholder="Nombres *" />
                                    <input class="gum-input gum-grow" @bind="_personaForm.Apellidos" @bind:event="oninput" placeholder="Apellidos *" />
                                </div>
                                <div class="gum-form-row">
                                    <input class="gum-input gum-grow" @bind="_personaForm.Email" @bind:event="oninput" placeholder="Email (opcional)" />
                                    <input class="gum-input gum-grow" @bind="_personaForm.Telefono" @bind:event="oninput" placeholder="Telefono (opcional)" />
                                    @if (grupo.Rol == RolUnidadPersona.Familiar)
                                    {
                                        <input class="gum-input gum-grow" @bind="_personaForm.Parentesco" @bind:event="oninput" placeholder="Parentesco (ej. hijo)" />
                                    }
                                    <button class="gum-btn-brand" type="button" @onclick="GuardarPersona" disabled="@(_busy || !PersonaFormValido)">Guardar</button>
                                    <button class="gum-btn-ghost" type="button" @onclick="() => _formRol = null">Cancelar</button>
                                </div>
                            </div>
                        }
                    }
                </div>

                @* === Card INMUEBLES VINCULADOS (proto L.717-721) === *@
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">INMUEBLES VINCULADOS</div>
                    @if (_vinculos.Count == 0)
                    {
                        <div class="gum-people-empty">Sin inmuebles vinculados (parqueaderos, depositos).</div>
                    }
                    else
                    {
                        <div class="gum-inm-list">
                            @foreach (var v in _vinculos)
                            {
                                <div class="gum-inm">
                                    <div class="gum-inm-icon">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                                    </div>
                                    <div class="gum-inm-text">
                                        <div class="gum-inm-name">@v.AsociadaTipo @v.AsociadaNumero</div>
                                        <div class="gum-inm-fact" style="@(v.IncluyeEnFacturacion ? "color:#1A8754" : "color:#7C98B6")">
                                            @(v.IncluyeEnFacturacion ? "Incluye en facturacion" : "No factura")
                                        </div>
                                    </div>
                                    <button class="gum-inm-del" type="button" @onclick="() => EliminarVinculo(v.Id)" title="Quitar">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    @* Form para agregar inmueble vinculado (proto L.720) *@
                    <div class="gum-inm-add">
                        <select class="gum-inm-input" @bind="_nuevoVinculoUnidadId">
                            <option value="">- Selecciona unidad -</option>
                            @foreach (var u in _unidades.Where(u => u.Id != _selected.Id && (u.Tipo == TipoUnidad.Parqueadero || u.Tipo == TipoUnidad.UtilCuarto || u.Tipo == TipoUnidad.Bodega)))
                            {
                                <option value="@u.Id">@u.Tipo @u.Numero</option>
                            }
                        </select>
                        <select class="gum-inm-input" @bind="_nuevoVinculoFactura">
                            <option value="false">No factura</option>
                            <option value="true">Si factura</option>
                        </select>
                        <button class="gum-inm-add-btn" type="button" @onclick="AgregarVinculo" disabled="@(_nuevoVinculoUnidadId == Guid.Empty)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                        </button>
                    </div>
                </div>

                @* === Card VALORES DE ADMINISTRACION (proto L.722-730) === *@
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">VALORES DE ADMINISTRACION</div>
                    @if (!_editMode)
                    {
                        <div class="gum-unit-rows">
                            <div class="gum-unit-row"><span>Numero</span><span>@_selected.Numero</span></div>
                            <div class="gum-unit-row"><span>Tipo</span><span>@_selected.Tipo</span></div>
                            <div class="gum-unit-row"><span>@AgrupacionLabelSingular</span><span>@(_selected.TorreNombre ?? "-")</span></div>
                            <div class="gum-unit-row"><span>@PisoLabelSingular</span><span>@(_selected.Piso?.ToString() ?? "-")</span></div>
                            <div class="gum-unit-row"><span>Coeficiente</span><span>@_selected.CoeficientePropiedad.ToString("0.####")%</span></div>
                            @if (_cuota is not null && _cuota.CantidadAsociadasFactura > 0)
                            {
                                <div class="gum-unit-row"><span>+ Asociadas en facturacion</span><span>@_cuota.CoefAsociadasFactura.ToString("0.####")% (@_cuota.CantidadAsociadasFactura)</span></div>
                                <div class="gum-unit-row" style="border-top:1px dashed #DCD2F8;padding-top:8px"><span><b>Coef consolidado</b></span><span style="color:var(--propia-brand,#6D4FE3)"><b>@_cuota.CoefTotal.ToString("0.####")%</b></span></div>
                            }
                            <div class="gum-unit-row"><span>Area</span><span>@(_selected.AreaM2.HasValue ? _selected.AreaM2.Value.ToString("0.##") + " m2" : "-")</span></div>
                            <div class="gum-unit-row"><span>Habitaciones</span><span>@(_selected.Habitaciones?.ToString() ?? "-")</span></div>
                            <div class="gum-unit-row"><span>Banos</span><span>@(_selected.Banos?.ToString() ?? "-")</span></div>
                            <div class="gum-unit-row"><span>Parqueaderos</span><span>@(_selected.Parqueaderos?.ToString() ?? "-")</span></div>
                            <div class="gum-unit-row"><span>Estado</span><span>@(_selected.Estado ?? "-")</span></div>
                            <div class="gum-unit-row"><span>Paga administracion</span><span>@(_selected.PagaAdministracion ? "Si" : "No")</span></div>
                            @if (!string.IsNullOrEmpty(_selected.MatriculaInmobiliaria))
                            {
                                <div class="gum-unit-row"><span>Matricula</span><span>@_selected.MatriculaInmobiliaria</span></div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="gum-edit-grid">
                            <div class="gum-edit-field"><label class="gum-lbl">Numero</label><input class="gum-input" @bind="_edit.Numero" /></div>
                            <div class="gum-edit-field">
                                <label class="gum-lbl">Tipo</label>
                                <select class="gum-input" @bind="_edit.Tipo">
                                    @foreach (var t in Enum.GetValues<TipoUnidad>()) { <option value="@t">@t</option> }
                                </select>
                            </div>
                            <div class="gum-edit-field">
                                <label class="gum-lbl">@AgrupacionLabelSingular</label>
                                <select class="gum-input" @bind="_edit.TorreId">
                                    <option value="">- Sin @AgrupacionLabelSingular.ToLower() -</option>
                                    @foreach (var t in _torres) { <option value="@t.Id">@t.Nombre</option> }
                                </select>
                            </div>
                            <div class="gum-edit-field"><label class="gum-lbl">@PisoLabelSingular</label><input type="number" class="gum-input" @bind="_edit.Piso" /></div>
                            <div class="gum-edit-field"><label class="gum-lbl">Coeficiente (%)</label><input type="number" step="0.0001" class="gum-input" @bind="_edit.CoeficientePropiedad" /></div>
                            <div class="gum-edit-field"><label class="gum-lbl">Area (m2)</label><input type="number" step="0.01" class="gum-input" @bind="_edit.AreaM2" /></div>
                            <div class="gum-edit-field"><label class="gum-lbl">Habitaciones</label><input type="number" class="gum-input" @bind="_edit.Habitaciones" /></div>
                            <div class="gum-edit-field"><label class="gum-lbl">Banos</label><input type="number" class="gum-input" @bind="_edit.Banos" /></div>
                            <div class="gum-edit-field"><label class="gum-lbl">Parqueaderos</label><input type="number" class="gum-input" @bind="_edit.Parqueaderos" /></div>
                            <div class="gum-edit-field"><label class="gum-lbl">Estado</label><input class="gum-input" @bind="_edit.Estado" placeholder="Habitada / Vacia / En obra" /></div>
                            <div class="gum-edit-field gum-edit-field--full"><label class="gum-lbl">Matricula inmobiliaria</label><input class="gum-input" @bind="_edit.MatriculaInmobiliaria" placeholder="370-..." /></div>
                            <div class="gum-edit-field gum-edit-field--full">
                                <label class="gum-check">
                                    <input type="checkbox" @bind="_edit.PagaAdministracion" />
                                    <span>Paga administracion</span>
                                </label>
                            </div>
                            <div class="gum-edit-field gum-edit-field--full"><label class="gum-lbl">Observaciones</label><textarea class="gum-input" rows="2" @bind="_edit.Observaciones"></textarea></div>
                        </div>
                    }
                </div>

                @* === Card FICHA TECNICA - CAMPOS PERSONALIZADOS (proto L.742-754) === *@
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-card-head-row">
                        <div class="gum-unit-eyebrow">FICHA TECNICA - CAMPOS PERSONALIZADOS</div>
                        <button class="gum-people-add" type="button" @onclick="() => _cfOpen = !_cfOpen">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                            Agregar campo
                        </button>
                    </div>
                    @if (_camposPersonalizados.Count > 0)
                    {
                        <div class="gum-cf-grid">
                            @foreach (var (k, v) in _camposPersonalizados)
                            {
                                <div class="gum-cf-cell">
                                    <div class="gum-cf-lbl">@k</div>
                                    <div class="gum-cf-val">@v</div>
                                    <button class="gum-cf-del" type="button" @onclick="() => _camposPersonalizados.Remove(k)" title="Quitar">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    @if (_cfOpen)
                    {
                        <div class="gum-cf-form">
                            <input class="gum-input" @bind="_cfLabel" @bind:event="oninput" placeholder="Nombre del campo (ej. N de medidor)" />
                            <input class="gum-input" @bind="_cfValor" @bind:event="oninput" placeholder="Valor" />
                            <button class="gum-btn-brand" type="button" @onclick="AgregarCampoPersonalizado" disabled="@(string.IsNullOrWhiteSpace(_cfLabel) || string.IsNullOrWhiteSpace(_cfValor))">Guardar</button>
                        </div>
                    }
                    @if (_camposPersonalizados.Count == 0 && !_cfOpen)
                    {
                        <div class="gum-people-empty">Aun no hay campos personalizados. Usa "Agregar campo" para extender la ficha tecnica (ej. medidor de agua, marca de cerradura, color de fachada...).</div>
                    }
                </div>

                @* === ESTADISTICA (proto L.755-760) === *@
                <div class="gum-unit-card--full gum-stats">
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">Deuda actual</div>
                        <div class="gum-stat-val gum-stat-val--ok">$ 0</div>
                    </div>
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">PQRS</div>
                        <div class="gum-stat-val">0</div>
                    </div>
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">Pagos del ano</div>
                        <div class="gum-stat-val">0</div>
                    </div>
                </div>

                @* === HISTORIAL (proto L.761-766) === *@
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">HISTORIAL</div>
                    <div class="gum-hist-empty">Sin eventos registrados en la unidad.</div>
                </div>

                @* === DOCUMENTOS (proto L.785-792) === *@
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">DOCUMENTOS</div>
                    <label class="gum-doc-upload">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
                        Subir documento
                        <input type="file" accept="image/*,application/pdf" />
                    </label>
                </div>

                @* === FACTURAS - HISTORIAL DE PAGOS (proto L.767-783) === *@
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-unit-eyebrow">FACTURAS - HISTORIAL DE PAGOS</div>
                    <div class="gum-hist-empty">Sin facturas emitidas a la unidad.</div>
                </div>
            </div>
        }
    </div>
</div>

<style>
