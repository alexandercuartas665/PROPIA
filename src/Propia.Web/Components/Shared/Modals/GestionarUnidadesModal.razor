@* GestionarUnidadesModal - D.1 del catalogo (fullscreen).
   Replica literal del modal del prototipo PROPIA.dc.html L.584-720.
   Componente reutilizable: recibe Jwt + cargas las torres/unidades por su cuenta.
   Layout 2 paneles: izq lista torres/unidades, der ficha unidad seleccionada. *@

@inherits ModalBase<bool>
@using Propia.Web.Components.Shared
@using Propia.Web.Components.Shared.Modals
@using Propia.Application.MiCopropiedad
@using Propia.Application.Directorio
@using Propia.Application.Cartera
@using Propia.Application.Historial
@using Propia.Domain.Enums

@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

@* La cabecera del modal es la propia ficha (.cpe-head): identidad de la unidad + acciones + cerrar.
   La maqueta editor-ficha no lleva una barra "Gestionar unidades" separada encima. *@

@* ====== FICHA (panel unico) ======
   La creacion y la edicion usan la MISMA ficha: al crear, se abre en modo "nueva unidad"
   con el codigo mascara (A1-202) editable; al guardar se crea y se pasa a la ficha completa. *@
<div class="gum-body">

    @* ===== Panel DER - ficha unidad ===== *@
    <div class="gum-panel-right">
        @if (_nuevaUnidad)
        {
            @* --- Modo NUEVA UNIDAD: ficha .cpe-* vacia, con el codigo editable como titulo --- *@
            <div class="cpe-card">
                <div class="cpe-head">
                    <span class="cpe-ic">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-4h4v4"/></svg>
                    </span>
                    <div class="cpe-idwrap">
                        <input class="cpe-title" @bind="_edit.Codigo" @bind:event="oninput" placeholder="Ej. A1-202" />
                        <div class="cpe-sub">Nueva unidad - la @(AgrupacionLabelSingular.ToLower()) sale del codigo y el @(PisoLabelSingular.ToLower()) se infiere del numero</div>
                    </div>
                    <div class="cpe-head-acts">
                        <button class="cpe-hact" type="button" @onclick="GuardarUnidad" disabled="@_busy" title="@(_busy ? "Creando..." : "Crear unidad")">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
                        </button>
                        <button class="cpe-hact" type="button" @onclick="CancelarEdicion" title="Cancelar">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5M4 9h11a5 5 0 0 1 5 5v2"/></svg>
                        </button>
                        <button class="cpe-hact" type="button" @onclick="Cerrar" title="Cerrar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        </button>
                    </div>
                </div>
                <div class="cpe-body">
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-apps"></i> @AliasCampo("tipo", "TIPO")</label>
                        <select class="cpe-fin" @bind="_edit.TipoKey">
                            @foreach (var t in TiposUnidadSel) { <option value="@($"e:{t}")">@TipoLabel(t)</option> }
                            @if (TiposCustomVisibles().Count > 0) { <optgroup label="Tipos propios">@foreach (var tc in TiposCustomVisibles()) { <option value="@($"c:{tc.Id}")">@tc.Nombre</option> }</optgroup> }
                        </select>
                    </div>
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-calculator"></i> @AliasCampo("coef", "COEFICIENTE")</label>
                        <input type="number" step="0.0001" class="cpe-fin" @bind="_edit.CoeficientePropiedad" />
                    </div>
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-ruler-combined"></i> @AliasCampo("area", "AREA")</label>
                        <input type="number" step="0.01" class="cpe-fin" @bind="_edit.AreaM2" />
                    </div>
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-flag"></i> @AliasCampo("estado", "ESTADO")</label>
                        <select class="cpe-fin" @bind="_edit.Estado">
                            <option value="">- Sin definir -</option>
                            @foreach (var eo in EstadosConVigente(_edit.Estado)) { <option value="@eo">@eo</option> }
                        </select>
                    </div>
                    <div class="cpe-field">
                        <label class="cpe-flabel"><i class="fi fi-rr-document"></i> @AliasCampo("matricula", "MATRICULA")</label>
                        <input class="cpe-fin" @bind="_edit.MatriculaInmobiliaria" />
                    </div>
                    <div class="gum-fcustom-empty" style="margin-top:14px;">Guarda la unidad para agregar documentos y campos adicionales.</div>
                    @if (!string.IsNullOrEmpty(_msg))
                    {
                        <div class="gum-msg @(_msgError ? "gum-msg--err" : "gum-msg--ok")" style="margin-top:12px;">@_msg</div>
                    }
                </div>
            </div>
        }
        else if (_selected is null)
        {
            <div class="gum-empty">
                <div class="gum-empty-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M3 21h18M5 21V7l7-4 7 4v14M9 13h.01M15 13h.01M9 17h.01M15 17h.01"/>
                    </svg>
                </div>
                <div class="gum-empty-title">Selecciona una unidad</div>
                <div class="gum-empty-sub">Haz clic en cualquier unidad del arbol para ver y configurar su ficha completa.</div>
            </div>
        }
        else
        {
            @* Ficha estilo "editor-ficha" (.cpe-*): cabecera identidad + 4 pestanas + cuerpo con scroll interno. *@
            <div class="cpe-card">
                <div class="cpe-head">
                    <span class="cpe-ic">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-4h4v4"/></svg>
                    </span>
                    <div class="cpe-idwrap">
                        @* El codigo (TORRE-NUMERO) de una unidad existente no se edita desde la ficha: se muestra como titulo. *@
                        <input class="cpe-title" value="@IdUnidad" disabled title="@($"{LabelU(_selected)} {_selected.Numero}")" />
                        <div class="cpe-sub">
                            @(_selected.TorreNombre ?? "Sin torre")@(_selected.Piso.HasValue ? $" - {PisoLabelSingular} {_selected.Piso}" : "") - @LabelU(_selected)@(_selected.AreaM2.HasValue ? $" - {_selected.AreaM2.Value:0.##} m2" : "")
                        </div>
                    </div>
                    <div class="cpe-head-acts">
                        @if (!_editMode)
                        {
                            <button class="cpe-hact" type="button" @onclick="EntrarEdicion" title="Editar ficha">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                        }
                        else
                        {
                            <button class="cpe-hact" type="button" @onclick="GuardarUnidad" disabled="@_busy" title="@(_busy ? "Guardando..." : "Guardar")">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
                            </button>
                            <button class="cpe-hact" type="button" @onclick="AbrirConfirmEliminar" disabled="@_busy" title="Eliminar unidad">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
                            </button>
                            <button class="cpe-hact" type="button" @onclick="CancelarEdicion" title="Cancelar edicion">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5M4 9h11a5 5 0 0 1 5 5v2"/></svg>
                            </button>
                        }
                        <button class="cpe-hact" type="button" @onclick="Cerrar" title="Cerrar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        </button>
                    </div>
                </div>

                <div class="cpe-tabs">
                    <button type="button" class="cpe-tab @(_fichaTab == "detalle" ? "on" : "")" @onclick='() => _fichaTab = "detalle"'>Detalle</button>
                    <button type="button" class="cpe-tab @(_fichaTab == "historial" ? "on" : "")" @onclick='() => _fichaTab = "historial"'>Historial relacionado</button>
                    <button type="button" class="cpe-tab @(_fichaTab == "cuenta" ? "on" : "")" @onclick='() => _fichaTab = "cuenta"'>Estado de cuenta</button>
                    <button type="button" class="cpe-tab @(_fichaTab == "documentos" ? "on" : "")" @onclick='() => _fichaTab = "documentos"'>Documentos</button>
                </div>

                <div class="cpe-body">
                    @* ===== DETALLE: campos de la unidad, edicion inline (misma tabla Unidades Privadas) ===== *@
                    @if (_fichaTab == "detalle")
                    {
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-home"></i> @AliasCampo("num", "ID UNIDAD")</label>
                            <input class="cpe-fin" value="@IdUnidad" disabled />
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-apps"></i> @AliasCampo("tipo", "TIPO")</label>
                            @if (_editMode) { <select class="cpe-fin" @bind="_edit.TipoKey">@foreach (var t in TiposUnidadSel) { <option value="@($"e:{t}")">@TipoLabel(t)</option> }@if (TiposCustomVisibles().Count > 0) { <optgroup label="Tipos propios">@foreach (var tc in TiposCustomVisibles()) { <option value="@($"c:{tc.Id}")">@tc.Nombre</option> }</optgroup> }</select> } else { <input class="cpe-fin" value="@LabelU(_selected)" disabled /> }
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-calculator"></i> @AliasCampo("coef", "COEFICIENTE")</label>
                            @if (_editMode) { <input type="number" step="0.0001" class="cpe-fin" @bind="_edit.CoeficientePropiedad" /> } else { <input class="cpe-fin" value="@($"{_selected.CoeficientePropiedad.ToString("0.####")}%")" disabled /> }
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-ruler-combined"></i> @AliasCampo("area", "AREA")</label>
                            @if (_editMode) { <input type="number" step="0.01" class="cpe-fin" @bind="_edit.AreaM2" /> } else { <input class="cpe-fin" value="@(_selected.AreaM2.HasValue ? $"{_selected.AreaM2.Value:0.##} m2" : "-")" disabled /> }
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-flag"></i> @AliasCampo("estado", "ESTADO")</label>
                            @if (_editMode) { <select class="cpe-fin" @bind="_edit.Estado"><option value="">- Sin definir -</option>@foreach (var eo in EstadosConVigente(_edit.Estado)) { <option value="@eo">@eo</option> }</select> } else { <input class="cpe-fin" value="@(string.IsNullOrWhiteSpace(_selected.Estado) ? "-" : _selected.Estado)" disabled /> }
                        </div>
                        <div class="cpe-field">
                            <label class="cpe-flabel"><i class="fi fi-rr-document"></i> @AliasCampo("matricula", "MATRICULA")</label>
                            @if (_editMode) { <input class="cpe-fin" @bind="_edit.MatriculaInmobiliaria" /> } else { <input class="cpe-fin" value="@(string.IsNullOrWhiteSpace(_selected.MatriculaInmobiliaria) ? "-" : _selected.MatriculaInmobiliaria)" disabled /> }
                        </div>
                        @foreach (var c in _campos)
                        {
                            var cc = c;
                            <div class="cpe-field">
                                <label class="cpe-flabel"><i class="fi fi-rr-settings-sliders"></i> @c.Label</label>
                                @if (_editMode)
                                {
                                    @switch (c.Tipo)
                                    {
                                        case TipoCampoTablero.Seleccion:
                                            <select class="cpe-fin" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())">
                                                <option value="">- elegir -</option>
                                                @foreach (var op in c.OpcionesLista) { <option value="@op">@op</option> }
                                            </select>
                                            break;
                                        case TipoCampoTablero.Numero:
                                        case TipoCampoTablero.Moneda:
                                            <input class="cpe-fin" type="number" step="any" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" placeholder="Sin dato" />
                                            break;
                                        case TipoCampoTablero.Fecha:
                                            <input class="cpe-fin" type="date" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" />
                                            break;
                                        case TipoCampoTablero.AreaTexto:
                                            <textarea class="cpe-fin" rows="2" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" placeholder="Sin dato">@c.Valor</textarea>
                                            break;
                                        case TipoCampoTablero.Booleano:
                                            <select class="cpe-fin" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())">
                                                <option value="">- elegir -</option>
                                                <option value="Si">Si</option>
                                                <option value="No">No</option>
                                            </select>
                                            break;
                                        default:
                                            <input class="cpe-fin" value="@c.Valor" @onchange="(e) => GuardarValorCampo(cc, e.Value?.ToString())" placeholder="Sin dato" />
                                            break;
                                    }
                                }
                                else
                                {
                                    <input class="cpe-fin" value="@(string.IsNullOrWhiteSpace(c.Valor) ? "-" : c.Valor)" disabled />
                                }
                            </div>
                        }
                        @if (_editMode && _cfOpen)
                        {
                            <div class="gum-cf-form" style="margin-top:12px;">
                                <input class="gum-input" @bind="_cfLabel" @bind:event="oninput" placeholder="Nombre del campo (ej. N de medidor)" />
                                <input class="gum-input" @bind="_cfValor" @bind:event="oninput" placeholder="Valor (opcional)" />
                                <button class="gum-btn-brand" type="button" @onclick="AgregarCampoPersonalizado" disabled="@(_busy || string.IsNullOrWhiteSpace(_cfLabel))">Crear campo</button>
                            </div>
                        }
                        else if (_editMode)
                        {
                            <button class="cpe-addfield" type="button" @onclick="() => _cfOpen = true"><i class="fi fi-rr-plus"></i> Agregar campo</button>
                        }
                    }

                @* === Card ARRIENDOS Y COBROS MENSUALES (proto v3) === *@
                @if (_fichaTab == "cuenta") {
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">ARRIENDOS Y COBROS MENSUALES</div>
                    @if (_arriendos.Count == 0)
                    {
                        <div class="gum-people-empty">Esta unidad no tiene arriendos ni cobros mensuales adicionales.</div>
                    }
                    else
                    {
                        <div class="gum-inm-list">
                            @foreach (var a in _arriendos)
                            {
                                <div class="gum-inm">
                                    <div class="gum-inm-icon" style="background:var(--propia-ok-soft);color:var(--propia-success)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                                    </div>
                                    <div class="gum-inm-text">
                                        <div class="gum-inm-name">@a.Concepto</div>
                                        <div class="gum-inm-fact" style="color:var(--propia-success)">$@a.ValorMensual.ToString("N0") / mes@(string.IsNullOrEmpty(a.Referencia) ? "" : $" - {a.Referencia}")</div>
                                    </div>
                                    @if (_editMode)
                                    {
                                        <button class="gum-inm-del" type="button" @onclick="() => EliminarArriendo(a.Id)" title="Quitar">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_editMode)
                    {
                        <div class="gum-inm-add" style="flex-direction:column;align-items:stretch">
                            <select class="gum-inm-input" @bind="_nuevoArrRef">
                                <option value="">Que arrienda? (opcional)</option>
                                @foreach (var v in _vinculos)
                                {
                                    <option value="@($"{v.AsociadaTipo} {v.AsociadaNumero}")">@v.AsociadaTipo @v.AsociadaNumero</option>
                                }
                            </select>
                            <div style="display:flex;gap:6px">
                                <input class="gum-inm-input" style="flex:1;min-width:0" @bind="_nuevoArrConcepto" @bind:event="oninput" placeholder="Concepto (ej. Arriendo mensual)" />
                                <input class="gum-inm-input" style="width:90px" type="number" step="1" @bind="_nuevoArrValor" placeholder="$ valor" />
                                <button class="gum-inm-add-btn" type="button" @onclick="AgregarArriendo" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoArrConcepto) || _nuevoArrValor is null)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
                }

                @* === ESTADISTICA: deuda + estado de cuenta (2.7) + PQRSD (Ola 6) === *@
                @if (_fichaTab == "cuenta") {
                <div class="gum-unit-card--full gum-stats">
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">Deuda actual</div>
                        <div class="gum-stat-val @((_cartera?.SaldoTotal ?? 0) > 0 ? "gum-stat-val--err" : "gum-stat-val--ok")">$ @((_cartera?.SaldoTotal ?? 0).ToString("N0"))</div>
                    </div>
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">Estado de cuenta</div>
                        @if (_cartera is null)
                        {
                            <div class="gum-stat-val gum-stat-val--ok">Sin cartera</div>
                        }
                        else if (_cartera.DiasMora > 0)
                        {
                            <div class="gum-stat-val gum-stat-val--err">En mora · @_cartera.DiasMora d</div>
                        }
                        else
                        {
                            <div class="gum-stat-val gum-stat-val--ok">Al día</div>
                        }
                    </div>
                    <div class="gum-stat">
                        <div class="gum-stat-lbl">PQRSD</div>
                        <div class="gum-stat-val">@(_histResumen?.TotalPqrsd ?? 0)</div>
                    </div>
                </div>
                }

                @* === HISTORIAL RELACIONADO (Ola 2/3): tareas + PQRSD + mantenimientos de la unidad === *@
                @if (_fichaTab == "historial") {
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-unit-eyebrow">HISTORIAL RELACIONADO</div>
                    <HistorialRelacionadoPanel Jwt="@Jwt" Tipo="TipoEntidadHistorial.Unidad" EntidadId="@_selected.Id" />
                </div>
                }

                @* === BITACORA DE CAMBIOS (RN-06): eventos automaticos de la unidad === *@
                @if (_fichaTab == "historial") {
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-unit-eyebrow">BITÁCORA DE CAMBIOS</div>
                    @if (_bitacora.Count == 0)
                    {
                        <div class="gum-hist-empty">Sin cambios registrados en la unidad todavia.</div>
                    }
                    else
                    {
                        <div class="gum-bit-list">
                            @foreach (var b in _bitacora)
                            {
                                <div class="gum-bit-item">
                                    <span class="gum-bit-dot"></span>
                                    <div class="gum-bit-body">
                                        <div class="gum-bit-txt">@b.Descripcion</div>
                                        <div class="gum-bit-meta">@b.Fecha.ToCo().ToString("dd MMM yyyy · HH:mm")@(string.IsNullOrWhiteSpace(b.Autor) ? "" : $" · {b.Autor}")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                }

                @* === DOCUMENTOS: pestana propia (movido desde Historial) === *@
                @if (_fichaTab == "documentos") {
                <div class="gum-unit-card">
                    <div class="gum-unit-eyebrow">DOCUMENTOS</div>
                    @if (_documentos.Count > 0)
                    {
                        <div class="gum-doc-list">
                            @foreach (var d in _documentos)
                            {
                                <div class="gum-doc-item">
                                    <a class="gum-doc-link" href="@d.Url" target="_blank" rel="noopener" title="@d.Nombre">
                                        @if (EsImagen(d.Nombre))
                                        {
                                            <span class="gum-doc-thumb" style="background-image:url('@d.Url')"></span>
                                        }
                                        else
                                        {
                                            <span class="gum-doc-ic">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                            </span>
                                        }
                                        <span class="gum-doc-meta">
                                            <span class="gum-doc-name">@d.Nombre</span>
                                            <span class="gum-doc-sub">@FmtTamano(d.Tamano) · ver</span>
                                        </span>
                                    </a>
                                    @if (_editMode)
                                    {
                                        <button class="gum-cf-del gum-doc-x" type="button" @onclick="() => EliminarDocumento(d.Id)" title="Quitar">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_editMode)
                    {
                        <label class="gum-doc-upload">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
                            @(_subiendoDoc ? "Subiendo..." : "Subir documentos")
                            <InputFile OnChange="SubirDocumento" accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx" multiple hidden disabled="@_subiendoDoc" />
                        </label>
                    }
                    @if (_documentos.Count == 0 && !_editMode)
                    {
                        <div class="gum-people-empty">Sin documentos. Entra a "Editar ficha" para adjuntar anexos.</div>
                    }
                </div>
                }

                @* === ESTADO DE CUENTA (2.7 Cartera) - Ola 6: datos reales === *@
                @if (_fichaTab == "cuenta") {
                <div class="gum-unit-card gum-unit-card--full">
                    <div class="gum-unit-eyebrow">ESTADO DE CUENTA &middot; 2.7 CARTERA</div>
                    @if (_cartera is null)
                    {
                        <div class="gum-hist-empty">Sin movimientos de cartera para esta unidad (aun no hay liquidaciones del módulo 2.6).</div>
                    }
                    else
                    {
                        <div class="gum-cta-grid">
                            <div class="gum-cta-box"><span>Capital</span><b>$ @_cartera.SaldoCapital.ToString("N0")</b></div>
                            <div class="gum-cta-box"><span>Intereses</span><b>$ @_cartera.SaldoIntereses.ToString("N0")</b></div>
                            <div class="gum-cta-box"><span>Total</span><b class="@(_cartera.SaldoTotal > 0 ? "gum-cta-neg" : "")">$ @_cartera.SaldoTotal.ToString("N0")</b></div>
                            <div class="gum-cta-box"><span>Días en mora</span><b>@_cartera.DiasMora</b></div>
                        </div>
                        @if (_cartera.TieneAcuerdoVigente)
                        {
                            <div class="gum-cta-badge">Con acuerdo de pago vigente</div>
                        }
                        @if (_cartera.Deudas.Count > 0)
                        {
                            <div class="gum-cta-deudas">
                                @foreach (var d in _cartera.Deudas.OrderByDescending(x => x.Periodo).Take(8))
                                {
                                    <div class="gum-cta-deuda">
                                        <div class="gum-cta-deuda-main">
                                            <span class="gum-cta-deuda-con">@d.Concepto</span>
                                            <span class="gum-cta-deuda-per">@d.Periodo.ToString("MMM yyyy")</span>
                                        </div>
                                        <span class="gum-cta-deuda-val">$ @((d.CapitalPendiente + d.InteresAcumulado).ToString("N0"))</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="gum-people-empty" style="margin-top:8px">La unidad esta al día: sin deudas pendientes.</div>
                        }
                    }
                </div>
                }
            </div>
            </div>
        }
    </div>
</div>

@* ====== CONFIRMACION DE BORRADO (doble comprobacion) ======
   Accion destructiva e irreversible: exige escribir el codigo EXACTO de la unidad para habilitar
   el boton final. Asi un clic accidental no basta para borrar. *@
@if (_confirmDel && _selected is not null)
{
    <div class="gum-cdel-overlay" @onclick="CerrarConfirmEliminar">
        <div class="gum-cdel-card" @onclick:stopPropagation="true">
            <div class="gum-cdel-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
            </div>
            <div class="gum-cdel-title">Eliminar unidad</div>
            <div class="gum-cdel-sub">
                Vas a eliminar <b>@LabelU(_selected) @_selected.Numero</b>@(string.IsNullOrWhiteSpace(_selected.TorreNombre) ? "" : $" ({_selected.TorreNombre})").
                Esta accion es <b>permanente y no se puede deshacer</b>. Se perderan sus datos de ficha,
                registros y documentos de esta unidad.
            </div>
            <div class="gum-cdel-warn">
                Si la unidad tiene movimientos de cartera, PQRSD o reservas, el sistema NO la eliminara
                (primero hay que desvincular esos registros).
            </div>
            <div class="gum-cdel-confirm">
                <label class="gum-cdel-lbl">Para confirmar, escribe el código de la unidad: <b>@_selected.Numero</b></label>
                <input class="gum-cdel-inp" @bind="_confirmText" @bind:event="oninput"
                       placeholder="@_selected.Numero" autocomplete="off" disabled="@_busy" />
            </div>
            @if (!string.IsNullOrEmpty(_msg) && _msgError)
            {
                <div class="gum-cdel-err">@_msg</div>
            }
            <div class="gum-cdel-actions">
                <button class="gum-cdel-cancel" type="button" @onclick="CerrarConfirmEliminar" disabled="@_busy">Cancelar</button>
                <button class="gum-cdel-go" type="button" @onclick="ConfirmarEliminarUnidad"
                        disabled="@(_busy || !ConfirmCoincide)" title="@(ConfirmCoincide ? "Eliminar definitivamente" : "Escribe el codigo exacto para habilitar")">
                    @(_busy ? "Eliminando..." : "Eliminar definitivamente")
                </button>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public string AgrupacionLabelSingular { get; set; } = "Torre";
    [Parameter] public string PisoLabelSingular { get; set; } = "Piso";
    /// <summary>Abre directamente la ficha de esta unidad (lo usa la tabla de Distribucion al
    /// hacer clic en una fila). Sin valor, el modal abre en el estado vacio de siempre.</summary>
    [Parameter] public Guid? UnidadInicialId { get; set; }

    /// <summary>
    /// Oculta el panel izquierdo (arbol de torres) al abrir, dejando la ficha a todo el ancho.
    /// Se usa cuando ya se eligio la unidad (clic en una fila de Unidades Privadas): el arbol es
    /// redundante. El usuario puede traerlo de vuelta con el boton de lista de la cabecera.
    /// </summary>
    [Parameter] public bool OcultarArbol { get; set; }

    private List<TorreDto> _torres = new();
    private List<UnidadDto> _unidades = new();
    private UnidadDto? _selected;
    private List<UnidadVinculoDto> _vinculos = new();
    private CuotaConsolidadaDto? _cuota;
    private HashSet<Guid> _torresAbiertas = new();
    private bool _editMode;
    private bool _nuevaUnidad;   // ficha en modo alta (crear = editar, misma ficha)
    private EditUnidadForm _edit = new();

    // Inmuebles vinculados - form para agregar
    private Guid _nuevoVinculoUnidadId;
    private bool _nuevoVinculoFactura;

    // Campos personalizados (Ficha tecnica)
    private List<CampoVM> _campos = new();  // definiciones (tenant) + valor de la unidad seleccionada
    private bool _cfOpen;
    private string _cfLabel = "";
    private string _cfValor = "";

    private List<UnidadDocumentoDto> _documentos = new();
    private bool _subiendoDoc;

    // Prototipo v3 - bloques nuevos de la ficha de inmueble
    private List<UnidadArriendoDto> _arriendos = new();
    private string _nuevoArrConcepto = "";
    private decimal? _nuevoArrValor;
    private string _nuevoArrRef = "";


    private class CampoVM
    {
        public Guid DefinicionId { get; set; }
        public string Label { get; set; } = "";
        public int Orden { get; set; }
        public string? Valor { get; set; }
        public TipoCampoTablero Tipo { get; set; } = TipoCampoTablero.Texto;
        public string? Opciones { get; set; }
        // Parser compartido (JSON nuevo {"K","Oculta","Color"} o texto-por-linea legado); solo visibles.
        public string[] OpcionesLista => OpcionCampo.VisiblesK(Opciones);
    }

    // Los estados posibles vienen de la config del tenant (EstadosConfig, semilla Habitada/Desocupada/Arrendada).

    // ===== Ficha por tabs =====
    private string _fichaTab = "detalle";
    private string IdUnidad => _selected is null ? "" :
        ((_selected.TorreNombre is { Length: > 0 } tn ? tn.Split(' ').Last() + "-" : "") + _selected.Numero);

    private List<BitacoraEntradaDto> _bitacora = new();
    private CarteraUnidadDetalleDto? _cartera;        // estado de cuenta real (2.7), null si la unidad no tiene cartera
    private HistorialRelacionadoDto? _histResumen;    // solo para el contador de PQRSD en la estadistica
    private class EditUnidadForm
    {
        public string Codigo { get; set; } = "";   // solo en modo "nueva unidad": mascara TORRE-APARTAMENTO (A1-202)
        public string Numero { get; set; } = "";
        public TipoUnidad Tipo { get; set; } = TipoUnidad.Apartamento;
        public Guid? TipoCustomId { get; set; }
        // Clave combinada para el <select> de tipo: "e:<enum>" (base) o "c:<guid>" (propio).
        public string TipoKey
        {
            get => TipoCustomId is { } g ? $"c:{g}" : $"e:{Tipo}";
            set
            {
                if (!string.IsNullOrEmpty(value) && value.StartsWith("c:") && Guid.TryParse(value[2..], out var g)) { TipoCustomId = g; }
                else { TipoCustomId = null; if (value?.StartsWith("e:") == true && Enum.TryParse<TipoUnidad>(value[2..], out var t)) Tipo = t; }
            }
        }
        public Guid? TorreId { get; set; }
        public int? Piso { get; set; }
        public decimal CoeficientePropiedad { get; set; }
        public decimal? AreaM2 { get; set; }
        public int? Habitaciones { get; set; }
        public int? Banos { get; set; }
        public int? Parqueaderos { get; set; }
        public string? Estado { get; set; }
        public string? Observaciones { get; set; }
        public string? MatriculaInmobiliaria { get; set; }
        public bool PagaAdministracion { get; set; } = true;
        public decimal? CuotaMensual { get; set; }
    }
    private bool _huboCambios;
    private bool _busy;
    private string _msg = "";
    private bool _msgError;
    private bool _confirmDel;         // panel de confirmacion de borrado abierto (doble comprobacion)
    private string _confirmText = ""; // texto tecleado; debe coincidir con el numero de la unidad

    private string AgrupacionLabelPlural => AgrupacionLabelSingular + "s";

    // Modes
    private string? _mode;

    // Manual
    private Guid _manTorreId;
    private int? _manPiso;
    private string _manNumero = "";
    private TipoUnidad _manTipo = TipoUnidad.Apartamento;
    private bool _manNuevaTorre;              // modo "crear torre nueva" desde el mismo selector
    private string _manNuevaTorreNombre = "";

    // Binding del <select> de torre: ademas de las torres existentes soporta la opcion
    // "+ Nueva torre..." (sentinel), que activa el input inline para crearla al agregar.
    private string ManTorreSel
    {
        get => _manNuevaTorre ? "__nueva__" : (_manTorreId == Guid.Empty ? "" : _manTorreId.ToString());
        set
        {
            if (value == "__nueva__") _manNuevaTorre = true;
            else if (Guid.TryParse(value, out var g)) { _manNuevaTorre = false; _manTorreId = g; }
            else { _manNuevaTorre = false; _manTorreId = Guid.Empty; }
        }
    }

    // Generador
    private int _genN = 2;
    private List<string> _genNombres = new() { "Torre A", "Torre B" };
    private int _genPisos = 5;
    private int _genPorPiso = 4;
    private int GenTotal => _genN * _genPisos * _genPorPiso;
    private int _genToast;

    // Import
    private string _csv = "";
    private int CsvCount => string.IsNullOrWhiteSpace(_csv) ? 0 : _csv.Split('\n').Count(l => !string.IsNullOrWhiteSpace(l));

    private decimal CoefTotal => _unidades.Sum(u => u.CoeficientePropiedad);

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        // Entrada desde la tabla de Distribucion: con UnidadInicialId abre la ficha de esa unidad;
        // sin ella (o si no se encuentra), abre en modo "nueva unidad" (misma ficha, vacia).
        if (UnidadInicialId is Guid id)
        {
            var u = _unidades.FirstOrDefault(x => x.Id == id);
            if (u is not null) await SeleccionarUnidad(u);
            else IniciarNuevaUnidad();
        }
        else
        {
            IniciarNuevaUnidad();
        }
    }

    private void IniciarNuevaUnidad()
    {
        _nuevaUnidad = true;
        _selected = null;
        _editMode = true;
        _edit = new EditUnidadForm();
        _msg = "";
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            var http = Auth();
            _torres = await http.GetFromJsonAsync<List<TorreDto>>("/api/mi-copropiedad/torres") ?? new();
            _unidades = await http.GetFromJsonAsync<List<UnidadDto>>("/api/mi-copropiedad/unidades") ?? new();
            try { _tiposCustom = await http.GetFromJsonAsync<List<TipoUnidadCustomDto>>("/api/mi-copropiedad/tipos-unidad") ?? new(); } catch { _tiposCustom = new(); }
            try { _camposConfig = (await http.GetFromJsonAsync<List<UnidadCampoConfigDto>>("/api/mi-copropiedad/unidades-config") ?? new()).ToDictionary(c => c.CampoClave); } catch { _camposConfig = new(); }
            AplicarOrdenTiposCustom();   // mismo orden de tipos propios que en la tabla (config del campo 'tipo')
            if (_torres.Count > 0 && _torresAbiertas.Count == 0)
                _torresAbiertas.Add(_torres[0].Id);
            if (_manTorreId == Guid.Empty && _torres.Count > 0)
                _manTorreId = _torres[0].Id;
            // Sin torres: el selector arranca en "+ Nueva torre..." para no dejar al usuario atascado.
            if (_torres.Count == 0) _manNuevaTorre = true;
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    private void SetMode(string? m) { _mode = (_mode == m) ? null : m; _genToast = 0; }
    // Tope 26: los nombres de la secuencia van de la A a la Z.
    private const int GenTopeAgrupaciones = 26;
    private int GenMaxChip => Math.Max(6, _genN);

    private void SetGenN(int n)
    {
        _genN = Math.Clamp(n, 1, GenTopeAgrupaciones);
        while (_genNombres.Count < _genN) _genNombres.Add($"{AgrupacionLabelSingular} {(char)('A' + _genNombres.Count)}");
        while (_genNombres.Count > _genN) _genNombres.RemoveAt(_genNombres.Count - 1);
    }

    private void ToggleTorre(Guid id)
    {
        if (!_torresAbiertas.Add(id)) _torresAbiertas.Remove(id);
    }
    private bool IsOpen(Guid id) => _torresAbiertas.Contains(id);

    private async Task SeleccionarUnidad(UnidadDto u)
    {
        _selected = u;
        _nuevaUnidad = false;
        _editMode = false;
        _vinculos.Clear();
        _cuota = null;
        _campos.Clear();
        _documentos.Clear();
        _subiendoDoc = false;
        _arriendos.Clear();
        _nuevoArrConcepto = ""; _nuevoArrValor = null; _nuevoArrRef = "";
        _cfLabel = ""; _cfValor = "";
        _cfOpen = false;
        _nuevoVinculoUnidadId = Guid.Empty;
        _nuevoVinculoFactura = false;
        try
        {
            _vinculos = await Auth().GetFromJsonAsync<List<UnidadVinculoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/vinculos") ?? new();
        }
        catch { /* sin vinculos */ }
        try
        {
            _cuota = await Auth().GetFromJsonAsync<CuotaConsolidadaDto>($"/api/mi-copropiedad/unidades/{u.Id}/cuota-consolidada");
        }
        catch { _cuota = null; }
        await CargarCamposAsync();
        try
        {
            _documentos = await Auth().GetFromJsonAsync<List<UnidadDocumentoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/documentos") ?? new();
        }
        catch { _documentos = new(); }
        try { _arriendos = await Auth().GetFromJsonAsync<List<UnidadArriendoDto>>($"/api/mi-copropiedad/unidades/{u.Id}/arriendos") ?? new(); }
        catch { _arriendos = new(); }
        try { _bitacora = await Auth().GetFromJsonAsync<List<BitacoraEntradaDto>>($"/api/mi-copropiedad/unidades/{u.Id}/bitacora") ?? new(); }
        catch { _bitacora = new(); }
        // Estado de cuenta real (2.7). 404 si la unidad aun no tiene cartera -> queda null.
        try
        {
            var cResp = await Auth().GetAsync($"/api/cartera/unidades/{u.Id}");
            _cartera = cResp.IsSuccessStatusCode ? await cResp.Content.ReadFromJsonAsync<CarteraUnidadDetalleDto>() : null;
        }
        catch { _cartera = null; }
        // Contador de PQRSD (reusa el motor de Historial de Ola 2).
        try { _histResumen = await Auth().GetFromJsonAsync<HistorialRelacionadoDto>($"/api/historial/1/{u.Id}"); }
        catch { _histResumen = null; }
    }

    // Recarga solo la bitacora (tras un cambio inline/edicion) para reflejar el nuevo evento.
    private async Task RecargarBitacoraAsync()
    {
        if (_selected is null) return;
        try { _bitacora = await Auth().GetFromJsonAsync<List<BitacoraEntradaDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/bitacora") ?? new(); }
        catch { }
    }

    private async Task CargarCamposAsync()
    {
        if (_selected is null) { _campos = new(); return; }
        try
        {
            var dtos = await Auth().GetFromJsonAsync<List<UnidadCampoDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/campos") ?? new();
            _campos = dtos.Select(d => new CampoVM { DefinicionId = d.DefinicionId, Label = d.Label, Orden = d.Orden, Valor = d.Valor, Tipo = d.Tipo, Opciones = d.Opciones }).ToList();
        }
        catch { _campos = new(); }
    }

    // ===== Prototipo v3: handlers de los bloques nuevos de la ficha de inmueble =====

    private async Task AgregarArriendo()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_nuevoArrConcepto) || _nuevoArrValor is not decimal val) return;
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/arriendos",
                new CrearUnidadArriendoRequest(_nuevoArrConcepto.Trim(), val, string.IsNullOrWhiteSpace(_nuevoArrRef) ? null : _nuevoArrRef.Trim()));
            if (resp.IsSuccessStatusCode)
            {
                _arriendos = await Auth().GetFromJsonAsync<List<UnidadArriendoDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/arriendos") ?? _arriendos;
                _nuevoArrConcepto = ""; _nuevoArrValor = null; _nuevoArrRef = "";
            }
            else { ShowMsg(await resp.Content.ReadAsStringAsync(), true); }
        }
        finally { _busy = false; }
    }

    private async Task EliminarArriendo(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/unidades-arriendos/{id}");
        if (resp.IsSuccessStatusCode) _arriendos.RemoveAll(a => a.Id == id);
    }

    private void EntrarEdicion()
    {
        if (_selected is null) return;
        _edit = new EditUnidadForm
        {
            Numero = _selected.Numero,
            Tipo = _selected.Tipo,
            TipoCustomId = _selected.TipoCustomId,
            TorreId = _selected.TorreId,
            Piso = _selected.Piso,
            CoeficientePropiedad = _selected.CoeficientePropiedad,
            AreaM2 = _selected.AreaM2,
            Habitaciones = _selected.Habitaciones,
            Banos = _selected.Banos,
            Parqueaderos = _selected.Parqueaderos,
            Estado = _selected.Estado,
            Observaciones = _selected.Observaciones,
            MatriculaInmobiliaria = _selected.MatriculaInmobiliaria,
            PagaAdministracion = _selected.PagaAdministracion,
            CuotaMensual = _selected.CuotaMensual
        };
        _editMode = true;
    }

    private void CancelarEdicion()
    {
        // En modo alta, Cancelar cierra el modal (no hay ficha previa a la que volver).
        if (_nuevaUnidad) { Close(_huboCambios); return; }
        _editMode = false;
        _cfOpen = false;
    }

    private async Task GuardarUnidad()
    {
        if (_nuevaUnidad) { await CrearUnidadDesdeFichaAsync(); return; }
        if (_selected is null) return;
        if (string.IsNullOrWhiteSpace(_edit.Numero)) { ShowMsg("Número obligatorio.", true); return; }
        _busy = true;
        var req = new ActualizarUnidadRequest(
            _edit.Numero.Trim(), _edit.Tipo, _edit.TorreId, _edit.Piso,
            _edit.CoeficientePropiedad, _edit.AreaM2,
            _edit.Habitaciones, _edit.Banos, _edit.Parqueaderos,
            string.IsNullOrWhiteSpace(_edit.Estado) ? null : _edit.Estado,
            string.IsNullOrWhiteSpace(_edit.Observaciones) ? null : _edit.Observaciones,
            string.IsNullOrWhiteSpace(_edit.MatriculaInmobiliaria) ? null : _edit.MatriculaInmobiliaria,
            _edit.PagaAdministracion, _edit.CuotaMensual, TipoCustomId: _edit.TipoCustomId);
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}", req);
        if (resp.IsSuccessStatusCode)
        {
            var actualizada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
            if (actualizada is not null)
            {
                _selected = actualizada;
                var idx = _unidades.FindIndex(u => u.Id == actualizada.Id);
                if (idx >= 0) _unidades[idx] = actualizada;
            }
            _editMode = false;
            _huboCambios = true;
            ShowMsg($"Unidad {actualizada?.Numero} actualizada.", false);
        }
        else
        {
            ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true);
        }
        _busy = false;
    }

    // Crea la unidad desde la ficha (modo alta). El codigo mascara TORRE-APARTAMENTO (A1-202)
    // resuelve/crea la torre y el piso se infiere del numero; luego se crea con los campos de la ficha.
    private async Task CrearUnidadDesdeFichaAsync()
    {
        var raw = (_edit.Codigo ?? "").Trim();
        if (raw.Length == 0) { ShowMsg($"Escribe el codigo {AgrupacionLabelSingular.ToUpperInvariant()}-APARTAMENTO (ej. A1-202).", true); return; }

        var parts = raw.Split(new[] { '-', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2) { ShowMsg("Usa el formato TORRE-APARTAMENTO, por ejemplo A1-202.", true); return; }
        var torreToken = parts[0];
        var numero = string.Join("-", parts.Skip(1)).Trim();
        if (numero.Length == 0) { ShowMsg("Falta el número del apartamento. Ejemplo: A1-202.", true); return; }
        // El piso se infiere del numero de apto (202 -> 2, 1502 -> 15) cuando es numerico de 3+ digitos.
        int? piso = (numero.Length >= 3 && numero.All(char.IsDigit) && int.TryParse(numero[..^2], out var f) && f > 0) ? f : (int?)null;

        _busy = true;
        // Resolver torre por nombre exacto, por "Torre X" o por la ultima palabra del nombre; si no existe, crearla.
        var existe = _torres.FirstOrDefault(t =>
            t.Nombre.Equals(torreToken, StringComparison.OrdinalIgnoreCase)
            || t.Nombre.Equals($"{AgrupacionLabelSingular} {torreToken}", StringComparison.OrdinalIgnoreCase)
            || string.Equals(t.Nombre.Split(' ').LastOrDefault(), torreToken, StringComparison.OrdinalIgnoreCase));
        Guid torreId;
        if (existe is not null) { torreId = existe.Id; }
        else
        {
            var nombreTorre = torreToken.Length <= 4 ? $"{AgrupacionLabelSingular} {torreToken}" : torreToken;
            var respTorre = await Auth().PostAsJsonAsync("/api/mi-copropiedad/torres", new CrearTorreRequest(nombreTorre, null, null));
            if (!respTorre.IsSuccessStatusCode) { ShowMsg($"Error al crear {AgrupacionLabelSingular.ToLower()}: " + await respTorre.Content.ReadAsStringAsync(), true); _busy = false; return; }
            var nuevaTorre = await respTorre.Content.ReadFromJsonAsync<TorreDto>();
            if (nuevaTorre is null) { ShowMsg($"Respuesta inesperada al crear {AgrupacionLabelSingular.ToLower()}.", true); _busy = false; return; }
            _torres.Add(nuevaTorre);
            torreId = nuevaTorre.Id;
            _huboCambios = true;
        }

        var req = new CrearUnidadRequest(
            numero, _edit.Tipo, torreId, piso,
            _edit.CoeficientePropiedad, _edit.AreaM2,
            null, null, null,
            string.IsNullOrWhiteSpace(_edit.Estado) ? null : _edit.Estado, null,
            string.IsNullOrWhiteSpace(_edit.MatriculaInmobiliaria) ? null : _edit.MatriculaInmobiliaria,
            TipoCustomId: _edit.TipoCustomId);
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
        if (!resp.IsSuccessStatusCode) { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); _busy = false; return; }
        var creada = await resp.Content.ReadFromJsonAsync<UnidadDto>();
        _huboCambios = true;
        await CargarAsync();
        _busy = false;
        if (creada is not null)
        {
            await SeleccionarUnidad(creada);   // pasa a la ficha completa de la unidad creada
            ShowMsg($"Unidad {creada.Numero} creada.", false);
        }
    }

    // Alta por codigo unico TORRE-PISO-UNIDAD (ej. A-3-101). Si la torre no existe, se crea.
    private string _manCodigo = "";

    private async Task AgregarUnidadPorCodigoAsync()
    {
        var raw = (_manCodigo ?? "").Trim();
        if (raw.Length == 0) return;

        var parts = raw.Split(new[] { '-', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2)
        {
            ShowMsg("Usa el formato TORRE-APARTAMENTO, por ejemplo A1-202.", true);
            return;
        }
        var torreToken = parts[0];
        var numero = string.Join("-", parts.Skip(1)).Trim();
        if (numero.Length == 0) { ShowMsg("Falta el número del apartamento. Ejemplo: A1-202.", true); return; }
        // El piso se infiere del numero de apto (202 -> 2, 1502 -> 15) cuando es numerico de 3+ digitos.
        int? piso = (numero.Length >= 3 && numero.All(char.IsDigit) && int.TryParse(numero[..^2], out var f) && f > 0) ? f : (int?)null;

        // Resolver torre por nombre exacto, por "Torre X" o por la ultima palabra del nombre.
        var existe = _torres.FirstOrDefault(t =>
            t.Nombre.Equals(torreToken, StringComparison.OrdinalIgnoreCase)
            || t.Nombre.Equals($"{AgrupacionLabelSingular} {torreToken}", StringComparison.OrdinalIgnoreCase)
            || string.Equals(t.Nombre.Split(' ').LastOrDefault(), torreToken, StringComparison.OrdinalIgnoreCase));
        if (existe is not null)
        {
            _manNuevaTorre = false;
            _manTorreId = existe.Id;
        }
        else
        {
            _manNuevaTorre = true;
            _manNuevaTorreNombre = torreToken.Length <= 4 ? $"{AgrupacionLabelSingular} {torreToken}" : torreToken;
        }
        _manPiso = piso;
        _manNumero = numero;

        if (await AgregarUnidadManualCore()) _manCodigo = "";
    }

    private async Task<bool> AgregarUnidadManualCore()
    {
        if (string.IsNullOrWhiteSpace(_manNumero)) return false;

        // Si el usuario eligio "+ Nueva torre...", la creamos primero y usamos su Id.
        if (_manNuevaTorre)
        {
            var nombre = _manNuevaTorreNombre.Trim();
            if (string.IsNullOrWhiteSpace(nombre))
            {
                ShowMsg($"Escribe el nombre de la nueva {AgrupacionLabelSingular.ToLower()}.", true);
                return false;
            }
            _busy = true;
            var existe = _torres.FirstOrDefault(t => t.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase));
            if (existe is not null)
            {
                _manTorreId = existe.Id;
            }
            else
            {
                var respTorre = await Auth().PostAsJsonAsync("/api/mi-copropiedad/torres", new CrearTorreRequest(nombre, null, null));
                if (!respTorre.IsSuccessStatusCode)
                {
                    ShowMsg($"Error al crear {AgrupacionLabelSingular.ToLower()}: " + await respTorre.Content.ReadAsStringAsync(), true);
                    _busy = false;
                    return false;
                }
                var nuevaTorre = await respTorre.Content.ReadFromJsonAsync<TorreDto>();
                if (nuevaTorre is null) { ShowMsg($"Respuesta inesperada al crear {AgrupacionLabelSingular.ToLower()}.", true); _busy = false; return false; }
                _torres.Add(nuevaTorre);
                _manTorreId = nuevaTorre.Id;
                _huboCambios = true;
            }
            _manNuevaTorre = false;
            _manNuevaTorreNombre = "";
            _busy = false;
        }

        if (_manTorreId == Guid.Empty) { ShowMsg($"Selecciona {AgrupacionLabelSingular.ToLower()}.", true); return false; }
        _busy = true;
        var req = new CrearUnidadRequest(_manNumero.Trim(), _manTipo, _manTorreId, _manPiso, 0m, null, null, null, null, null, null);
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
        var ok = resp.IsSuccessStatusCode;
        if (ok)
        {
            _manNumero = "";
            _huboCambios = true;
            await CargarAsync();
            ShowMsg("Unidad agregada", false);
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
        _busy = false;
        return ok;
    }

    private async Task EjecutarGenerador()
    {
        _busy = true;
        var http = Auth();
        // 1) crear torres
        var creadas = new List<TorreDto>();
        foreach (var nombre in _genNombres.Where(n => !string.IsNullOrWhiteSpace(n)))
        {
            var exist = _torres.FirstOrDefault(t => t.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase));
            if (exist is not null) { creadas.Add(exist); continue; }
            var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/torres", new CrearTorreRequest(nombre, _genPisos, null));
            if (resp.IsSuccessStatusCode)
            {
                var nueva = await resp.Content.ReadFromJsonAsync<TorreDto>();
                if (nueva is not null) creadas.Add(nueva);
            }
        }
        // 2) crear unidades por torre
        int totalCreadas = 0;
        foreach (var t in creadas)
        {
            for (int piso = 1; piso <= _genPisos; piso++)
            {
                for (int u = 1; u <= _genPorPiso; u++)
                {
                    var num = $"{piso}{u:00}";
                    if (_unidades.Any(x => x.TorreId == t.Id && x.Numero == num)) continue;
                    var req = new CrearUnidadRequest(num, TipoUnidad.Apartamento, t.Id, piso, 0m, null, null, null, null, null, null);
                    var resp = await http.PostAsJsonAsync("/api/mi-copropiedad/unidades", req);
                    if (resp.IsSuccessStatusCode) totalCreadas++;
                }
            }
        }
        _genToast = totalCreadas;
        _huboCambios = true;
        await CargarAsync();
        SetMode(null);
        _busy = false;
    }

