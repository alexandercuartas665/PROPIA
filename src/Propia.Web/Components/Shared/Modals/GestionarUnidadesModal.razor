    // ===== Ficha por tabs + tabla de personas (rediseno referencia cliente) =====
    private string _fichaTab = "personas";
    private string IdUnidad => _selected is null ? "" :
        ((_selected.TorreNombre is { Length: > 0 } tn ? tn.Split(' ').Last() + "-" : "") + _selected.Numero);

    // Fila de trabajo (alta inline) de la tabla de personas.
    private string _ptNombre = "", _ptDoc = "", _ptTel = "", _ptEmail = "";
    private RolUnidadPersona _ptRol = RolUnidadPersona.Propietario;
    private bool _ptActivo = true;
    private bool _agregandoPersona;

    private static string Ini(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var parts = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return (parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : parts[0][..Math.Min(2, parts[0].Length)]).ToUpperInvariant();
    }

    private static string RolLabel(RolUnidadPersona r) => r switch
    {
        RolUnidadPersona.Propietario => "Propietario",
        RolUnidadPersona.Residente => "Residente",
        RolUnidadPersona.Arrendatario => "Arrendatario",
        RolUnidadPersona.Familiar => "Familiar",
        RolUnidadPersona.Apoderado => "Apoderado",
        _ => r.ToString()
    };

    private async Task RecargarPersonasAsync()
    {
        if (_selected is null) return;
        try { _personas = await Auth().GetFromJsonAsync<List<UnidadPersonaDto>>($"/api/mi-copropiedad/unidades/{_selected.Id}/personas") ?? new(); }
        catch { }
        StateHasChanged();
    }

    private async Task AgregarPersonaTablaAsync()
    {
        if (_selected is null || _agregandoPersona) return;
        var nombre = (_ptNombre ?? "").Trim();
        if (nombre.Length == 0 || string.IsNullOrWhiteSpace(_ptDoc)) return;
        var parts = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2) { ShowMsg("Escribe nombre y apellido.", true); return; }
        var apellidos = parts[^1];
        var nombres = string.Join(" ", parts[..^1]);
        _agregandoPersona = true;
        try
        {
            var req = new AgregarPersonaUnidadRequest(_ptDoc.Trim(), nombres, apellidos,
                string.IsNullOrWhiteSpace(_ptEmail) ? null : _ptEmail.Trim(),
                string.IsNullOrWhiteSpace(_ptTel) ? null : _ptTel.Trim(),
                _ptRol, Activo: _ptActivo);
            var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/unidades/{_selected.Id}/personas", req);
            if (resp.IsSuccessStatusCode)
            {
                _ptNombre = _ptDoc = _ptTel = _ptEmail = ""; _ptRol = RolUnidadPersona.Propietario; _ptActivo = true;
                _huboCambios = true;
                await RecargarPersonasAsync();
                ShowMsg("Persona vinculada.", false);
            }
            else { ShowMsg("No se pudo agregar: " + await resp.Content.ReadAsStringAsync(), true); }
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _agregandoPersona = false; }
    }

    private async Task CambiarRolPersonaAsync(UnidadPersonaDto p, ChangeEventArgs e)
    {
        if (!Enum.TryParse<RolUnidadPersona>(e.Value?.ToString(), out var rol) || rol == p.Rol) return;
        await EditarVinculoPersonaAsync(p, rol, p.Activo);
    }

    private async Task CambiarEstadoPersonaAsync(UnidadPersonaDto p, ChangeEventArgs e)
    {
        var activo = e.Value?.ToString() == "1";
        if (activo == p.Activo) return;
        await EditarVinculoPersonaAsync(p, p.Rol, activo);
    }

    private async Task EditarVinculoPersonaAsync(UnidadPersonaDto p, RolUnidadPersona rol, bool activo)
    {
        try
        {
            var req = new AgregarPersonaUnidadRequest(
                p.PersonaDocumento, p.PersonaNombres, p.PersonaApellidos, p.PersonaEmail, p.PersonaTelefono,
                rol, Habita: p.Habita, Parentesco: p.Parentesco,
                PersonaId: p.EntidadTipo == EntidadDirectorio.Persona ? p.PersonaId : null,
                EntidadTipo: p.EntidadTipo, EmpresaId: p.EmpresaId, Activo: activo);
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades-personas/{p.Id}", req);
            if (resp.IsSuccessStatusCode) { _huboCambios = true; await RecargarPersonasAsync(); }
            else ShowMsg("No se pudo actualizar: " + await resp.Content.ReadAsStringAsync(), true);
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    // Oleada 2 - historico de propietarios + campos dinamicos por persona
    private string _contactTab = "actuales"; // actuales | historico
    private List<UnidadTitularidadDto> _titularidad = new();
    private List<BitacoraEntradaDto> _bitacora = new();
    private CarteraUnidadDetalleDto? _cartera;        // estado de cuenta real (2.7), null si la unidad no tiene cartera
    private HistorialRelacionadoDto? _histResumen;    // solo para el contador de PQRSD en la estadistica
    private string _titNombre = "";
    private string _titRol = "Propietario";
    private DateOnly? _titDesde;
    private DateOnly? _titHasta;
    private Dictionary<Guid, List<UnidadPersonaCampoDto>> _personaCampos = new();
    private Guid? _campoPersonaTarget; // persona con el form de "agregar campo" abierto
    private string _npcLabel = "";
    private string _npcValor = "";
    private PersonaForm _personaForm = new();
    private Guid? _editPersonaId;  // null = agregar; con valor = editando esa persona

    private class PersonaForm
    {
        public string Documento { get; set; } = "";
        public string Nombres { get; set; } = "";
        public string Apellidos { get; set; } = "";
        public List<string> Emails { get; set; } = new() { "" };
        public List<string> Telefonos { get; set; } = new() { "" };
        public List<string> Codigos { get; set; } = new() { "+57" };
        public List<string> Direcciones { get; set; } = new() { "" };
        public string Parentesco { get; set; } = "";

        public string? PrimerEmail => Emails.FirstOrDefault(e => !string.IsNullOrWhiteSpace(e))?.Trim();
        public string? PrimerTelefono
        {
            get
            {
                for (int i = 0; i < Telefonos.Count; i++)
                {
                    var t = Telefonos[i]?.Trim();
                    if (string.IsNullOrWhiteSpace(t)) continue;
                    var cod = i < Codigos.Count ? Codigos[i] : "";
                    return string.IsNullOrWhiteSpace(cod) ? t : $"{cod} {t}";
                }
                return null;
            }
        }
    }

    private readonly string[] _codigosPais = { "+57", "+1", "+34", "+52", "+54", "+55", "+56", "+58", "+593", "+503", "+507", "+591" };

    private void AddTel() { _personaForm.Telefonos.Add(""); _personaForm.Codigos.Add("+57"); }
    private void RemoveTel(int idx)
    {
        if (idx >= 0 && idx < _personaForm.Telefonos.Count) _personaForm.Telefonos.RemoveAt(idx);
        if (idx >= 0 && idx < _personaForm.Codigos.Count) _personaForm.Codigos.RemoveAt(idx);
    }

    /// <summary>Persona elegida con el SelectorPersona al agregar (null en modo edicion).</summary>
    private Propia.Application.Directorio.PersonaCandidatoDto? _personaSel;

    private bool PersonaFormValido =>
        _editPersonaId is not null
            // Editando: se corrigen los datos de la persona ya vinculada.
            ? !string.IsNullOrWhiteSpace(_personaForm.Documento) &&
              !string.IsNullOrWhiteSpace(_personaForm.Nombres) &&
              !string.IsNullOrWhiteSpace(_personaForm.Apellidos)
            // Agregando: basta con haber elegido a alguien en el selector.
            : _personaSel is not null;

    private class EditUnidadForm
    {
        public string Codigo { get; set; } = "";   // solo en modo "nueva unidad": mascara TORRE-APARTAMENTO (A1-202)
        public string Numero { get; set; } = "";
