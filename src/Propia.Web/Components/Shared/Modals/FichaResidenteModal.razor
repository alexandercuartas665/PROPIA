@* FichaResidenteModal - ficha de una PERSONA y su relacion con una unidad (modulo Residentes).
   Frame estandar de ficha (1056px x 86vh fijo, is-fixedh): cabecera con navegacion entre registros,
   titulo editable, acciones (guardar / cerrar) y cuerpo en 2 columnas (foto + chips / datos +
   documentos). Reutiliza los endpoints globales de Directorio (personas + adjuntos).
   Calca de la maqueta D:\DesarrolloIA\Maqueta\modal-residente.html (clases .pm-* / .fr-*). *@

@inherits ModalBase<FichaResidenteModal.Resultado>
@using Propia.Application.Directorio
@using Propia.Application.UsuariosAccesos
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory

@if (_cargando)
{
    <div class="fr-loading"><div class="spinner-border" style="color:var(--propia-brand)"></div></div>
}
else
{
<div class="pm-head">
    @if (ListaPersonaIds is { Count: > 1 } && _idx >= 0)
    {
        <div class="pm-nav">
            <button class="pm-nav-btn" type="button" title="Registro anterior" disabled="@(_idx <= 0)" @onclick="Anterior">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <span class="pm-nav-pos">@(_idx + 1) / @ListaPersonaIds.Count</span>
            <button class="pm-nav-btn" type="button" title="Registro siguiente" disabled="@(_idx >= ListaPersonaIds.Count - 1)" @onclick="Siguiente">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
            </button>
        </div>
    }
    <div class="pm-head-ic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
    </div>
    <div class="pm-head-tt">
        <input class="pm-head-h-edit" @bind="TituloNombre" @bind:event="oninput" readonly="@(!_editMode)" title="Nombre del residente (editable en modo edicion)" />
        <div class="pm-head-s">@SubtituloRelacion</div>
    </div>
    <div class="pm-head-acts">
        <ModalHeaderActions EnEdicion="@(_editMode && (_tab == "perfil" || _tab == "acceso"))" MostrarEditar="@(_tab == "perfil" || _tab == "acceso")"
                            MostrarEliminar="@(_tab == "perfil" && UnidadPersonaId != Guid.Empty)" MostrarCancelar="true"
                            Guardando="_guardando" TituloEditar="Editar" TituloGuardar="Guardar cambios"
                            TituloEliminar="Quitar de la unidad"
                            OnEntrarEdicion="IniciarEdicion" OnGuardar="GuardarAsync"
                            OnEliminar="AbrirConfirmEliminar" OnCancelarEdicion="CancelarEdicion" OnCerrar="Cerrar" />
    </div>
</div>

@* Pestanas (canon Terceros): Perfil / Documentos / Comentarios / Acceso. *@
<div class="fr-tabs">
    <button class="fr-tab @(_tab == "perfil" ? "fr-tab--on" : "")" type="button" @onclick='() => _tab = "perfil"'>Perfil</button>
    <button class="fr-tab @(_tab == "documentos" ? "fr-tab--on" : "")" type="button" @onclick='() => _tab = "documentos"'>Documentos@(_adjuntos.Count > 0 ? $" ({_adjuntos.Count})" : "")</button>
    <button class="fr-tab @(_tab == "comentarios" ? "fr-tab--on" : "")" type="button" @onclick='() => _tab = "comentarios"'>Comentarios@(_comentarios.Count > 0 ? $" ({_comentarios.Count})" : "")</button>
    <button class="fr-tab @(_tab == "acceso" ? "fr-tab--on" : "")" type="button" @onclick='() => _tab = "acceso"'>Acceso</button>
</div>

@if (_tab == "perfil")
{
<div class="pm-body">
    <div class="fr-body">
        @* ---------- Columna izquierda: foto + chips ---------- *@
        <div class="fr-left">
            <div class="fr-sectlbl">FOTO DE LA PERSONA</div>
            @if (!string.IsNullOrWhiteSpace(_fotoUrl))
            {
                <div class="fr-avatar" style="background-image:url('@_fotoUrl')" role="button" title="Ver foto completa" @onclick="() => _verImagen = _fotoUrl"></div>
            }
            else
            {
                <div class="fr-avatar-ini">@Iniciales</div>
            }
            @if (_editMode)
            {
                <label class="fr-img-change">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>@(_subiendoFoto ? "Subiendo..." : "Cambiar foto")
                    <InputFile OnChange="SubirFoto" accept="image/png,image/jpeg,image/webp" hidden disabled="@_subiendoFoto" />
                </label>
            }
            @* Chips: relacion con la unidad + roles de acceso (maqueta). La unidad va en la grilla DATOS, no como chip. *@
            <div class="fr-tags">
                @if (!string.IsNullOrWhiteSpace(Relacion)) { <span class="chip chip--rel">@Relacion</span> }
                @foreach (var rid in _rolIdsAsignados) { <span class="chip chip--rol">@RolNombre(rid)</span> }
            </div>
        </div>

        @* ---------- Columna derecha: datos + documentos ---------- *@
        <div class="fr-right">
            <div class="fr-sectlbl">DATOS DE LA PERSONA</div>
            <div class="fr-grid">
                <div class="fr-fld">
                    <label>Nombres</label>
                    <input class="fr-in @(_editMode ? "" : "fr-in--ro")" readonly="@(!_editMode)" @bind="_nombres" @bind:event="oninput" />
                </div>
                <div class="fr-fld">
                    <label>Apellidos</label>
                    <input class="fr-in @(_editMode ? "" : "fr-in--ro")" readonly="@(!_editMode)" @bind="_apellidos" @bind:event="oninput" />
                </div>
                <div class="fr-fld">
                    <label>Correo</label>
                    <input class="fr-in @(_editMode ? "" : "fr-in--ro")" readonly="@(!_editMode)" type="email" @bind="_email" placeholder="correo@ejemplo.com" />
                </div>
                <div class="fr-fld">
                    <label>Teléfono</label>
                    <input class="fr-in @(_editMode ? "" : "fr-in--ro")" readonly="@(!_editMode)" @bind="_telefono" placeholder="Opcional" />
                </div>
                <div class="fr-fld">
                    <label>Fecha de nacimiento</label>
                    <input class="fr-in @(_editMode ? "" : "fr-in--ro")" readonly="@(!_editMode)" type="date" value="@(_fechaNac?.ToString("yyyy-MM-dd"))" @onchange="OnFechaNac" />
                </div>
                <div class="fr-fld">
                    <label>Genero</label>
                    <select class="fr-in @(_editMode ? "" : "fr-in--ro")" disabled="@(!_editMode)" @bind="_genero">
                        <option value="">Sin especificar</option>
                        <option value="@GeneroPersona.Masculino">Masculino</option>
                        <option value="@GeneroPersona.Femenino">Femenino</option>
                        <option value="@GeneroPersona.NoBinario">No binario</option>
                        <option value="@GeneroPersona.NoIdentificado">Prefiere no decir</option>
                    </select>
                </div>
                <div class="fr-fld">
                    <label>Documento</label>
                    <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@($"{DocLabel(_tipoDoc)} {_documento}")" title="La identidad se edita en el Directorio" />
                </div>
                <div class="fr-fld">
                    <label>Unidad</label>
                    <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@UnidadCodigo" />
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_msg))
    {
        <div class="fr-msg @(_msgError ? "err" : "ok")">@_msg</div>
    }
</div>
}
else if (_tab == "documentos")
{
    @* Canon de documentos compartido (miniaturas + visor inline + lightbox). Fill="true": ocupa el
       alto del contenedor flex del modal, igual que la pestana Documentos de Zonas. *@
    <DocumentosPanel Fill="true"
                     Documentos="@DocItems()"
                     Subiendo="_subiendoDoc"
                     EmptyHint="Sube la cedula, el RUT u otros documentos de identidad con el boton Subir archivo."
                     OnSubir="SubirDocumento" OnEliminar="EliminarAdjunto" />
    @if (!string.IsNullOrWhiteSpace(_msg))
    {
        <div class="fr-msg @(_msgError ? "err" : "ok")" style="margin:0 22px 14px">@_msg</div>
    }
}
else if (_tab == "comentarios")
{
<div class="pm-body">
    <div class="fr-sectlbl">COMENTARIOS</div>
    @if (_comentarios.Count > 0)
    {
        <div class="fr-com-list">
            @foreach (var c in _comentarios)
            {
                <div class="fr-com-item">
                    <span class="fr-com-av">@InicialesAutor(c.AutorNombre)</span>
                    <div class="fr-com-b">
                        <div class="fr-com-hd"><b>@(string.IsNullOrWhiteSpace(c.AutorNombre) ? "Usuario" : c.AutorNombre)</b><span class="fr-com-time">@c.CreatedAt.ToCo().ToString("dd/MM/yyyy HH:mm")</span></div>
                        <div class="fr-com-txt">@c.Texto</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="fr-empty">Aun no hay comentarios en este registro.</div>
    }
    <div class="fr-com-new">
        <textarea class="fr-in fr-com-ta" @bind="_nuevoComentario" @bind:event="oninput" placeholder="Escribe un comentario..." rows="2"></textarea>
        <div class="fr-com-foot">
            <button class="fr-btn fr-btn-primary fr-btn-sm" type="button" @onclick="PublicarComentario" disabled="@(_publicando || string.IsNullOrWhiteSpace(_nuevoComentario))">@(_publicando ? "Publicando..." : "Publicar")</button>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_msg))
    {
        <div class="fr-msg @(_msgError ? "err" : "ok")">@_msg</div>
    }
</div>
}
else if (_tab == "acceso")
{
<div class="pm-body">
    @* Acceso al sistema (Rol): asignar rol = invitar a la persona como usuario (reusa Usuarios/RBAC).
       Se guarda junto con los datos al presionar Guardar (checkmark del header). *@
    <div class="fr-sectlbl">ACCESO AL SISTEMA (ROL)</div>
    <p class="fr-roles-hint">El rol otorga acceso al sistema (p. ej. Portal Residente) y referencia la bandeja Roles y permisos; el detalle de permisos se edita alli. El cargo es descriptivo y no da permisos.</p>
    @if (_rolesCargando)
    {
        <div class="fr-empty">Cargando roles...</div>
    }
    else
    {
        <div class="fr-chips">
            @if (_rolIdsAsignados.Count == 0)
            {
                <span class="fr-chip-empty">Sin rol de acceso asignado.</span>
            }
            else
            {
                @foreach (var rid in _rolIdsAsignados)
                {
                    var id = rid;
                    <span class="fr-rolchip">@RolNombre(id)@if (_editMode) { <button type="button" class="fr-rolchip-x" title="Quitar rol" @onclick="() => QuitarRol(id)">&times;</button>}</span>
                }
            }
        </div>
        @if (_editMode && RolesDisponibles() is { Count: > 0 } disp)
        {
            <div class="fr-roles-disp">
                <span class="fr-disp-lbl">Clic para asignar:</span>
                @foreach (var r in disp)
                {
                    var rr = r;
                    <button type="button" class="fr-rolchip-add" @onclick="() => AgregarRol(rr.Id)">+ @rr.Nombre</button>
                }
            </div>
        }
        @if (_editMode && _usuarioTenantId is null && _rolIdsAsignados.Count > 0)
        {
            <div class="fr-roles-note">Al guardar se invitara a esta persona como usuario (Invitacion pendiente) con el/los rol(es) seleccionado(s).</div>
        }
    }
    @if (!string.IsNullOrWhiteSpace(_msg))
    {
        <div class="fr-msg @(_msgError ? "err" : "ok")">@_msg</div>
    }
</div>
}

@* Confirmacion de "Quitar de la unidad" (type-to-confirm, patron compartido mha-cdel-*). *@
@if (_confirmDel)
{
    <div class="mha-cdel-overlay" @onclick="CerrarConfirmEliminar">
        <div class="mha-cdel-card" @onclick:stopPropagation="true">
            <div class="mha-cdel-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
            </div>
            <div class="mha-cdel-title">Quitar de la unidad</div>
            <div class="mha-cdel-sub">
                Vas a quitar a <b>@TituloNombre</b> de la unidad <b>@UnidadCodigo</b>. La persona <b>permanece en el Directorio</b>;
                solo se elimina su vinculo con esta unidad. Si tiene cartera, PQRSD o reservas, el sistema puede bloquear la accion.
            </div>
            <div class="mha-cdel-confirm">
                <label class="mha-cdel-lbl">Para confirmar, escribe el nombre: <b>@TituloNombre</b></label>
                <input class="mha-cdel-inp" @bind="_confirmText" @bind:event="oninput" placeholder="@TituloNombre" autocomplete="off" disabled="@_guardando" />
            </div>
            @if (!string.IsNullOrEmpty(_delError)) { <div class="mha-cdel-err">@_delError</div> }
            <div class="mha-cdel-actions">
                <button class="mha-cdel-cancel" type="button" @onclick="CerrarConfirmEliminar" disabled="@_guardando">Cancelar</button>
                <button class="mha-cdel-go" type="button" @onclick="ConfirmarEliminar"
                        disabled="@(_guardando || !ConfirmCoincide)">@(_guardando ? "Quitando..." : "Quitar de la unidad")</button>
            </div>
        </div>
    </div>
}

@* Lightbox de la foto completa (sin recorte). *@
@if (!string.IsNullOrWhiteSpace(_verImagen))
{
    <div class="fr-lb" @onclick="() => _verImagen = null">
        <button class="fr-lb-x" type="button" title="Cerrar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        <img src="@_verImagen" alt="Foto de la persona" />
    </div>
}
}

<style>
    .fr-loading { min-height: 220px; display: flex; align-items: center; justify-content: center; }

    /* ===== Cabecera Vista Ficha (calca maqueta .pm-*) ===== */
    .pm-head { display: flex; align-items: center; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--propia-border-divider); flex-shrink: 0; }

    /* Pestanas (mismos valores que .fz-tabs de Zonas / .fem-tabs de Equipos). */
    .fr-tabs { display: flex; gap: 2px; padding: 0 20px; border-bottom: 1px solid var(--propia-border-divider); flex-shrink: 0; }
    .fr-tab { background: transparent; border: 0; padding: 11px 14px; font-size: 13px; font-weight: 700; color: var(--propia-text-muted); cursor: pointer; border-bottom: 2px solid transparent; font-family: inherit; }
    .fr-tab--on { color: var(--propia-brand); border-bottom-color: var(--propia-brand); }
    .pm-head-ic { width: 40px; height: 40px; border-radius: 11px; background: var(--propia-brand-soft); color: var(--propia-brand); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pm-head-tt { flex: 1; min-width: 0; }
    .pm-head-h-edit { width: 100%; border: 1px solid transparent; background: transparent; border-radius: 8px; padding: 4px 8px; font-size: 16px; font-weight: 800; color: var(--propia-text-h1); font-family: inherit; line-height: normal; }
    .pm-head-h-edit:hover { border-color: var(--propia-border-card); }
    .pm-head-h-edit:focus { outline: none; border-color: var(--propia-brand); box-shadow: 0 0 0 2px rgba(109,79,227,.12); background: var(--propia-bg-card); }
    .pm-head-s { font-size: 12.5px; color: var(--propia-text-muted); margin-top: 2px; line-height: normal; }
    .pm-nav { display: inline-flex; align-items: center; gap: 2px; flex-shrink: 0; }
    .pm-nav-btn { width: 28px; height: 28px; border-radius: 8px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .pm-nav-btn:hover:not(:disabled) { border-color: var(--propia-brand); color: var(--propia-brand); }
    .pm-nav-btn:disabled { opacity: .4; cursor: default; }
    .pm-nav-pos { font-size: 11px; font-weight: 700; color: var(--propia-text-faint); padding: 0 5px; white-space: nowrap; }
    .pm-head-acts { display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0; }
    .pm-head-act { width: 30px; height: 30px; border-radius: 8px; border: 0; background: transparent; color: var(--propia-text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .pm-head-act:hover { background: var(--propia-bg-hover); color: var(--propia-brand); }
    .pm-x { border: 0; background: transparent; color: var(--propia-text-muted); cursor: pointer; width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pm-x:hover { background: var(--propia-bg-hover); color: var(--propia-text-body); }
    .fr-menu-wrap { position: relative; display: inline-flex; }
    .fr-menu { position: absolute; top: 34px; right: 0; z-index: 20; min-width: 210px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 11px; box-shadow: 0 12px 34px rgba(27,42,58,.18); padding: 5px; display: flex; flex-direction: column; gap: 1px; }
    .fr-menu-it { display: flex; align-items: center; gap: 9px; width: 100%; border: 0; background: transparent; color: var(--propia-text-body); font-size: 12.5px; font-weight: 600; text-align: left; padding: 8px 10px; border-radius: 8px; cursor: pointer; font-family: inherit; }
    .fr-menu-it:hover { background: var(--propia-bg-hover); color: var(--propia-brand); }

    /* ===== Cuerpo 2 columnas (calca maqueta .fr-*) ===== */
    .pm-body { padding: 16px 20px; overflow: auto; flex: 1 1 auto; min-height: 0; }
    .fr-body { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 18px; padding: 18px 20px; }
    .fr-left { display: flex; flex-direction: column; align-items: center; gap: 9px; }
    .fr-left .fr-sectlbl { align-self: stretch; }
    .fr-right { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    .fr-sectlbl { font-size: 11px; letter-spacing: .5px; color: var(--propia-text-faint); font-weight: 700; }

    .fr-avatar { width: 150px; height: 150px; border-radius: 50%; background-size: cover; background-position: center; background-repeat: no-repeat; background-color: var(--propia-border-divider); border: 3px solid var(--propia-bg-card); box-shadow: 0 2px 10px rgba(27,42,58,.14), 0 0 0 1px var(--propia-border-card); cursor: zoom-in; margin-top: 4px; }
    .fr-avatar-ini { width: 150px; height: 150px; border-radius: 50%; background: var(--propia-brand-soft); color: var(--propia-brand); display: flex; align-items: center; justify-content: center; font-size: 44px; font-weight: 800; border: 3px solid var(--propia-bg-card); box-shadow: 0 2px 10px rgba(27,42,58,.14), 0 0 0 1px var(--propia-border-card); margin-top: 4px; }
    .fr-img-change { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11.5px; font-weight: 700; color: var(--propia-brand); cursor: pointer; }
    .fr-tags { display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; margin-top: 2px; }
    .chip { display: inline-flex; align-items: center; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: var(--propia-bg-card-soft); color: var(--propia-text-secondary); border: 1px solid var(--propia-border-card); }
    .chip--rel { background: var(--propia-brand-soft); color: var(--propia-brand); border-color: var(--propia-brand-border); }
    .chip--rol { background: var(--propia-ok-soft); color: #1B7A44; border-color: transparent; }

    .fr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .fr-fld { display: flex; flex-direction: column; gap: 4px; }
    .fr-fld label { font-size: 11px; color: var(--propia-text-muted); font-weight: 700; }
    .fr-in { width: 100%; border: 1px solid var(--propia-border-card); border-radius: 9px; padding: 8px 10px; font-size: 12.5px; color: var(--propia-text-body); outline: none; background: var(--propia-bg-card); box-sizing: border-box; }
    .fr-in:focus { border-color: var(--propia-brand); box-shadow: 0 0 0 2px rgba(109,79,227,.12); }
    .fr-in--ro { background: var(--propia-bg-card-soft); color: var(--propia-text-body); min-height: 36px; }

    .fr-empty { font-size: 12px; color: var(--propia-text-muted); padding: 6px 0; }

    /* ===== Acceso al sistema (Rol) ===== */
    .fr-roles-hint { font-size: 11.5px; color: var(--propia-text-muted); margin: 6px 0 10px; line-height: 1.5; }
    .fr-chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .fr-chip-empty { font-size: 12px; color: var(--propia-text-faint); font-style: italic; }
    .fr-rolchip { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 700; padding: 4px 6px 4px 10px; border-radius: 999px; background: var(--propia-brand-soft); color: var(--propia-brand); border: 1px solid var(--propia-brand-border); }
    .fr-rolchip-x { border: 0; background: transparent; color: var(--propia-brand); font-size: 16px; line-height: 1; cursor: pointer; padding: 0 2px; border-radius: 50%; }
    .fr-rolchip-x:hover { background: rgba(109,79,227,.16); }
    .fr-roles-disp { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 10px; }
    .fr-disp-lbl { font-size: 11px; font-weight: 700; color: var(--propia-text-faint); }
    .fr-rolchip-add { display: inline-flex; align-items: center; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: var(--propia-bg-card); color: var(--propia-text-secondary); border: 1px dashed var(--propia-border-card-2); cursor: pointer; }
    .fr-rolchip-add:hover { border-color: var(--propia-brand); color: var(--propia-brand); border-style: solid; }
    .fr-roles-note { font-size: 11.5px; color: var(--propia-text-muted); background: var(--propia-brand-soft); border: 1px solid var(--propia-brand-border); border-radius: 9px; padding: 8px 11px; margin-top: 10px; line-height: 1.45; }

    /* ===== Comentarios ===== */
    .fr-com-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 10px; }
    .fr-com-item { display: flex; gap: 9px; }
