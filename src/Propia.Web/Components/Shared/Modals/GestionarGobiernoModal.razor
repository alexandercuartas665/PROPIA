@* GestionarGobiernoModal - seccion 4 Gobierno con 3 tabs (Consejo, Comites, Revisor Fiscal).
   Replica el patron del prototipo PROPIA.dc.html L.845+ con tabs internos para no
   sobrecargar el modal. Cada tab tiene su lista + form de agregar. Reusa
   VincularPersonaPorDocumentoAsync. *@

@inherits ModalBase<bool>
@using Propia.Web.Components.Shared.Modals
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums

@inject IHttpClientFactory HttpFactory

@* ====== HEADER ====== *@
<div class="ggov-header">
    <div class="ggov-header-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6"/>
        </svg>
    </div>
    <div class="ggov-header-text">
        <div class="ggov-title">4. Gobierno</div>
        <div class="ggov-subtitle">Consejo, comites y revisor fiscal</div>
    </div>
    <button class="ggov-close" @onclick="Cerrar" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

@* ====== TABS ====== *@
<div class="ggov-tabs">
    <button class="ggov-tab @(_tab == "consejo" ? "ggov-tab--active" : "")" type="button" @onclick='() => _tab = "consejo"'>
        Consejo
        @if (_consejo.Count(c => c.Activo) > 0) { <span class="ggov-tab-count">@_consejo.Count(c => c.Activo)</span> }
    </button>
    <button class="ggov-tab @(_tab == "comites" ? "ggov-tab--active" : "")" type="button" @onclick='() => _tab = "comites"'>
        Comites
        @if (_comites.Count(c => c.Activo) > 0) { <span class="ggov-tab-count">@_comites.Count(c => c.Activo)</span> }
    </button>
    <button class="ggov-tab @(_tab == "revisor" ? "ggov-tab--active" : "")" type="button" @onclick='() => _tab = "revisor"'>
        Revisor fiscal
        @if (_revisor is not null && _revisor.Activo) { <span class="ggov-tab-dot">·</span> }
    </button>
</div>

@* ====== BODY ====== *@
<div class="ggov-body">
    @if (_tab == "consejo")
    {
        @* Consejo de administracion *@
        @if (_consejo.Count == 0)
        {
            <div class="ggov-empty">Sin miembros en el consejo.</div>
        }
        else
        {
            <div class="ggov-grid">
                @foreach (var m in _consejo.Where(x => x.Activo))
                {
                    <div class="ggov-card">
                        <div class="ggov-avatar ggov-avatar--owner">@Iniciales(m.PersonaNombre)</div>
                        <div class="ggov-card-id">
                            <div class="ggov-card-name">@m.PersonaNombre</div>
                            <div class="ggov-card-meta">@m.Cargo · desde @m.FechaInicio.ToString("yyyy-MM-dd")</div>
                        </div>
                        <button class="ggov-del" type="button" @onclick="() => DesactivarConsejo(m.Id)" title="Desactivar">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                        </button>
                    </div>
                }
            </div>
        }

        <div class="ggov-form">
            <div class="ggov-form-title">+ Agregar miembro al consejo</div>
            @* Selector compartido: busca en toda la organizacion, trae de otra copropiedad
               o crea. Reemplaza el trio documento+nombres+apellidos escrito a mano. *@
            <SelectorPersona Jwt="@Jwt" @bind-Seleccionada="_consejoSel"
                             Placeholder="Buscar quien entra al consejo..." />
            <div class="ggov-form-row">
                <select class="ggov-input ggov-grow" @bind="_consejoForm.Cargo">
                    @foreach (var c in Enum.GetValues<CargoConsejo>()) { <option value="@c">@c</option> }
                </select>
                <input type="date" class="ggov-input" @bind="_consejoForm.FechaInicio" />
                <button class="ggov-btn-brand" type="button" @onclick="AgregarMiembroConsejo" disabled="@(_busy || !ConsejoFormValido)">Agregar</button>
            </div>
        </div>
    }

    @if (_tab == "comites")
    {
        @* Comites *@
        @if (_comites.Count == 0)
        {
            <div class="ggov-empty">Sin comites conformados.</div>
        }
        else
        {
            <div class="ggov-comites">
                @foreach (var c in _comites.Where(x => x.Activo))
                {
                    <div class="ggov-comite">
                        <div class="ggov-comite-head">
                            <div class="ggov-comite-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/></svg>
                            </div>
                            <div class="ggov-comite-id">
                                <div class="ggov-comite-name">@c.Nombre</div>
                                <div class="ggov-comite-meta">@c.CantidadMiembros miembros · desde @c.FechaConformacion.ToString("yyyy-MM-dd")</div>
                            </div>
                            <button class="ggov-del" type="button" @onclick="() => DesactivarComite(c.Id)" title="Desactivar">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(c.Descripcion))
                        {
                            <div class="ggov-comite-desc">@c.Descripcion</div>
                        }
                    </div>
                }
            </div>
        }

        <div class="ggov-form">
            <div class="ggov-form-title">+ Crear nuevo comite</div>
            <div class="ggov-form-row">
                <input class="ggov-input ggov-grow" @bind="_comiteForm.Nombre" @bind:event="oninput" placeholder="Nombre (Convivencia, Obras...) *" />
                <input class="ggov-input ggov-grow" @bind="_comiteForm.Descripcion" @bind:event="oninput" placeholder="Descripcion (opcional)" />
                <input type="date" class="ggov-input" @bind="_comiteForm.FechaConformacion" />
                <button class="ggov-btn-brand" type="button" @onclick="CrearComite" disabled="@(_busy || string.IsNullOrWhiteSpace(_comiteForm.Nombre))">Crear</button>
            </div>
        </div>
    }

    @if (_tab == "revisor")
    {
        @* Revisor Fiscal *@
        @if (_revisor is not null && _revisor.Activo)
        {
            <div class="ggov-card ggov-card--revisor">
                <div class="ggov-avatar ggov-avatar--owner">@Iniciales(_revisor.PersonaNombre)</div>
                <div class="ggov-card-id">
                    <div class="ggov-card-name">@_revisor.PersonaNombre</div>
                    <div class="ggov-card-meta">
                        @(string.IsNullOrEmpty(_revisor.NumeroTarjetaProfesional) ? "Sin TP registrada" : $"TP {_revisor.NumeroTarjetaProfesional}")
                        · posesion @_revisor.FechaPosesion.ToString("yyyy-MM-dd")
                    </div>
                </div>
                <button class="ggov-btn-ghost" type="button" @onclick="() => RetirarRevisor(_revisor!.Id)">Retirar</button>
            </div>
        }
        else
        {
            <div class="ggov-empty">Sin revisor fiscal designado.</div>
            <div class="ggov-form">
                <div class="ggov-form-title">+ Designar revisor fiscal</div>
                <SelectorPersona Jwt="@Jwt" @bind-Seleccionada="_revisorSel"
                                 Placeholder="Buscar al revisor fiscal..." />
                <div class="ggov-form-row">
                    <input class="ggov-input ggov-grow" @bind="_revisorForm.TarjetaProfesional" @bind:event="oninput" placeholder="TP (opcional)" />
                    <input type="date" class="ggov-input" @bind="_revisorForm.FechaPosesion" />
                    <button class="ggov-btn-brand" type="button" @onclick="DesignarRevisor" disabled="@(_busy || !RevisorFormValido)">Designar</button>
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="ggov-msg @(_msgError ? "ggov-msg--err" : "ggov-msg--ok")">@_msg</div>
    }
</div>

<style>
