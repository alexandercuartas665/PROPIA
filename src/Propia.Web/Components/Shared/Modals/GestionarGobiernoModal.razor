    /* Dark mode */
    [data-bs-theme="dark"] .ggov-title,
    [data-bs-theme="dark"] .ggov-card-name,
    [data-bs-theme="dark"] .ggov-comite-name { color: #E5E7EB; }
    [data-bs-theme="dark"] .ggov-tabs { background: #1B2233; }
    [data-bs-theme="dark"] .ggov-card,
    [data-bs-theme="dark"] .ggov-comite,
    [data-bs-theme="dark"] .ggov-form { background: #232B40; border-color: #2D3650; }
    [data-bs-theme="dark"] .ggov-empty { background: #1B2233; border-color: #2D3650; color: #8696B5; }
</style>

@code {
    [Parameter] public string? Jwt { get; set; }

    private string _tab = "consejo";
    private List<MiembroConsejoDto> _consejo = new();
    private List<ComiteDto> _comites = new();
    private RevisorFiscalDto? _revisor;
    private bool _busy;
    private string _msg = "";
    private bool _msgError;
    private bool _huboCambios;

    private ConsejoForm _consejoForm = new();
    private ComiteForm _comiteForm = new();
    private RevisorForm _revisorForm = new();

    private class ConsejoForm
    {
        public string Documento { get; set; } = "";
        public string Nombres { get; set; } = "";
        public CargoConsejo Cargo { get; set; } = CargoConsejo.Presidente;
        public DateTime FechaInicio { get; set; } = DateTime.Today;
    }

    private class ComiteForm
    {
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public DateTime FechaConformacion { get; set; } = DateTime.Today;
    }

    private class RevisorForm
    {
        public string Documento { get; set; } = "";
        public string Nombres { get; set; } = "";
        public string Apellidos { get; set; } = "";
        public string TarjetaProfesional { get; set; } = "";
        public DateTime FechaPosesion { get; set; } = DateTime.Today;
    }

    // Personas elegidas con el SelectorPersona (ya resueltas y vinculadas a la copropiedad).
    private Propia.Application.Directorio.PersonaCandidatoDto? _consejoSel;
    private Propia.Application.Directorio.PersonaCandidatoDto? _revisorSel;

    private bool ConsejoFormValido => _consejoSel is not null;
    private bool RevisorFormValido => _revisorSel is not null;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            _consejo = await Auth().GetFromJsonAsync<List<MiembroConsejoDto>>("/api/mi-copropiedad/consejo") ?? new();
        }
        catch { _consejo = new(); }
        try
        {
            _comites = await Auth().GetFromJsonAsync<List<ComiteDto>>("/api/mi-copropiedad/comites") ?? new();
        }
        catch { _comites = new(); }
        try
        {
            var resp = await Auth().GetAsync("/api/mi-copropiedad/revisor-fiscal");
            _revisor = resp.IsSuccessStatusCode && resp.Content.Headers.ContentLength > 0
                ? await resp.Content.ReadFromJsonAsync<RevisorFiscalDto>()
                : null;
        }
        catch { _revisor = null; }
    }


    private record VincularResp(Guid PersonaId);

    private async Task AgregarMiembroConsejo()
    {
        if (!ConsejoFormValido) return;
        _busy = true;
        var personaId = _consejoSel!.PersonaId;
        var req = new AgregarMiembroConsejoRequest(personaId, _consejoForm.Cargo, DateOnly.FromDateTime(_consejoForm.FechaInicio), null);
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/consejo", req);
        if (resp.IsSuccessStatusCode)
        {
            _consejoForm = new ConsejoForm();
            _consejoSel = null;
            _huboCambios = true;
            await CargarAsync();
            ShowMsg("Miembro agregado al consejo.", false);
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
        _busy = false;
    }

    private async Task DesactivarConsejo(Guid id)
    {
        var resp = await Auth().PutAsync($"/api/mi-copropiedad/consejo/{id}/desactivar", null);
        if (resp.IsSuccessStatusCode) { _huboCambios = true; await CargarAsync(); }
    }

    private async Task CrearComite()
    {
        if (string.IsNullOrWhiteSpace(_comiteForm.Nombre)) return;
        _busy = true;
        var req = new CrearComiteRequest(_comiteForm.Nombre.Trim(),
            string.IsNullOrWhiteSpace(_comiteForm.Descripcion) ? null : _comiteForm.Descripcion.Trim(),
            DateOnly.FromDateTime(_comiteForm.FechaConformacion));
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/comites", req);
        if (resp.IsSuccessStatusCode)
        {
            _comiteForm = new ComiteForm();
            _huboCambios = true;
            await CargarAsync();
            ShowMsg("Comite creado.", false);
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
        _busy = false;
    }

    private async Task DesactivarComite(Guid id)
    {
        var resp = await Auth().PutAsync($"/api/mi-copropiedad/comites/{id}/desactivar", null);
        if (resp.IsSuccessStatusCode) { _huboCambios = true; await CargarAsync(); }
    }

    private async Task DesignarRevisor()
    {
        if (!RevisorFormValido) return;
        _busy = true;
        var req = new DesignarRevisorFiscalRequest(
            _revisorSel!.PersonaId,
            string.IsNullOrWhiteSpace(_revisorForm.TarjetaProfesional) ? null : _revisorForm.TarjetaProfesional.Trim(),
            DateOnly.FromDateTime(_revisorForm.FechaPosesion));
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/revisor-fiscal", req);
        if (resp.IsSuccessStatusCode)
        {
            _revisorForm = new RevisorForm();
            _revisorSel = null;
            _huboCambios = true;
            await CargarAsync();
            ShowMsg("Revisor fiscal designado.", false);
        }
        else { ShowMsg("Error: " + await resp.Content.ReadAsStringAsync(), true); }
        _busy = false;
    }

    private async Task RetirarRevisor(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/revisor-fiscal/{id}");
        if (resp.IsSuccessStatusCode) { _huboCambios = true; await CargarAsync(); }
    }

    private void ShowMsg(string text, bool isError) { _msg = text; _msgError = isError; }
    private void Cerrar() => Close(_huboCambios);

    private static string Iniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var parts = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][0].ToString().ToUpper()
            : (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }
}
