        padding: 8px 14px; border-radius: 8px;
        background: #fff; border: 1px solid #E1E8EE;
        font-size: 12.5px; font-weight: 600; color: #516F90; cursor: pointer;
    }
    .ggov-btn-ghost:hover { border-color: #D7263D; color: #D7263D; background: #FDE7E7; }

