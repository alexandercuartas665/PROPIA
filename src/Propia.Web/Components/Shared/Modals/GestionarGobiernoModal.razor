    }
    .ggov-tab:hover { color: #33475B; }
    .ggov-tab--active { color: var(--propia-brand, #6D4FE3); border-bottom-color: var(--propia-brand, #6D4FE3); }
    .ggov-tab-count {
        background: var(--propia-brand-soft, #F1ECFD); color: var(--propia-brand, #6D4FE3);
