@* ============================================================================================
   Cluster CANONICO de acciones del header de un modal (homogeneo en TODO el sistema).
   Referencia: GestionarUnidadesModal. Botones-ICONO en la esquina superior derecha:
     - Editar (lapiz)  -> en modo VISTA (si MostrarEditar y !EnEdicion)
     - Guardar (check) -> en modo EDICION
     - Eliminar (bote) -> en modo EDICION (si MostrarEliminar)
     - Cancelar edicion (flecha-undo) -> en modo EDICION (si MostrarCancelar)
     - Cerrar (x) -> SIEMPRE
   Es PRESENTACIONAL: decide que botones se ven segun los flags; la LOGICA la cablea cada modal
   en los callbacks (p.ej. OnEliminar abre la confirmacion propia del modal). Estilos .mha-* en
   css/modules/modales.css.
   Fichas SIEMPRE editables (sin modo vista): pasar MostrarEditar=false y EnEdicion=true.
   ============================================================================================ *@

<div class="mha-acts">
    @if (MostrarEditar && !EnEdicion)
    {
        <button type="button" class="mha-btn" @onclick="OnEntrarEdicion" title="@TituloEditar">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
    }
    else if (EnEdicion)
    {
        <button type="button" class="mha-btn" @onclick="OnGuardar" disabled="@(Guardando || !PuedeGuardar)" title="@(Guardando ? "Guardando..." : TituloGuardar)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
        </button>
        @if (MostrarEliminar)
        {
            <button type="button" class="mha-btn" @onclick="OnEliminar" disabled="@Guardando" title="@TituloEliminar">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>
            </button>
        }
        @if (MostrarCancelar)
        {
            <button type="button" class="mha-btn" @onclick="OnCancelarEdicion" title="@TituloCancelar">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5M4 9h11a5 5 0 0 1 5 5v2"/></svg>
            </button>
        }
    }
    <button type="button" class="mha-btn" @onclick="OnCerrar" title="Cerrar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

@code {
    /// <summary>true = el modal esta en modo EDICION (muestra Guardar/Eliminar/Cancelar); false = modo VISTA (muestra Editar).</summary>
    [Parameter] public bool EnEdicion { get; set; }
    /// <summary>¿Hay modo VISTA con lapiz? false = ficha siempre editable (sin lapiz); pasar junto con EnEdicion=true.</summary>
    [Parameter] public bool MostrarEditar { get; set; } = true;
    /// <summary>¿Mostrar la papelera en edicion? false para altas puras o campos que no se borran.</summary>
    [Parameter] public bool MostrarEliminar { get; set; } = true;
    /// <summary>¿Mostrar la flecha "Cancelar edicion"? false si no aplica.</summary>
    [Parameter] public bool MostrarCancelar { get; set; } = true;
    /// <summary>Deshabilita Guardar si el formulario no es valido.</summary>
    [Parameter] public bool PuedeGuardar { get; set; } = true;
    /// <summary>Deshabilita Guardar/Eliminar mientras persiste.</summary>
    [Parameter] public bool Guardando { get; set; }

    [Parameter] public string TituloEditar { get; set; } = "Editar";
    [Parameter] public string TituloGuardar { get; set; } = "Guardar";
    [Parameter] public string TituloEliminar { get; set; } = "Eliminar";
    [Parameter] public string TituloCancelar { get; set; } = "Cancelar edicion";

    [Parameter] public EventCallback OnEntrarEdicion { get; set; }
    [Parameter] public EventCallback OnGuardar { get; set; }
    [Parameter] public EventCallback OnEliminar { get; set; }
    [Parameter] public EventCallback OnCancelarEdicion { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
}
