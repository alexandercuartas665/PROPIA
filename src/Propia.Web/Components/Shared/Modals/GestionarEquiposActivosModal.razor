@* GestionarEquiposActivosModal - replica del prototipo PROPIA.dc.html L.948+ ("6. Equipos").
   Activos fisicos de la copropiedad (ascensores, bombas, plantas electricas, CCTV,
   gimnasio, etc.). Grid 2-col con cards (icono + nombre + categoria + badge estado) +
   formulario inline al final para agregar uno nuevo. *@

@inherits ModalBase<bool>
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums

@inject IHttpClientFactory HttpFactory

<div class="gea-header">
    <div class="gea-header-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h6M9 11h6M10 16h4"/>
        </svg>
    </div>
    <div class="gea-header-text">
        <div class="gea-title">5. Equipos y Activos</div>
        <div class="gea-subtitle">Que activos fisicos tiene?</div>
    </div>
    <button class="gea-close" @onclick="@(() => Close(_dirty))" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

<div class="gea-body">
    @if (_equipos.Count == 0)
    {
        <div class="gea-empty">
            <strong>Sin equipos registrados.</strong>
            <span>Usa el formulario de abajo para registrar el primero (ascensor, bomba, planta electrica, CCTV, etc.).</span>
        </div>
    }
    else
    {
        <div class="gea-grid">
            @foreach (var e in _equipos)
            {
                var eid = e.Id;
                <div class="gea-card">
                    <div class="gea-card-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h6M9 11h6M10 16h4"/></svg>
                    </div>
                    <div class="gea-card-body">
                        <div class="gea-card-name">@e.Nombre</div>
                        <div class="gea-card-meta">@CategoriaTxt(e.Categoria)@(string.IsNullOrEmpty(e.Marca) ? "" : $" - {e.Marca}")</div>
                    </div>
                    <span class="gea-badge gea-badge--@(BadgeClass(e.Estado))">@EstadoTxt(e.Estado)</span>
                    <select class="gea-estado-select" @onchange="(ev) => CambiarEstadoAsync(eid, ev)">
                        @foreach (var s in (EstadoEquipoActivo[])System.Enum.GetValues(typeof(EstadoEquipoActivo)))
                        {
                            <option value="@s" selected="@(e.Estado == s)">@EstadoTxt(s)</option>
                        }
                    </select>
                    <button class="gea-del" type="button" title="Eliminar" @onclick="@(() => EliminarAsync(eid))">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                    </button>
                </div>
            }
        </div>
    }

    <div class="gea-form">
        <div class="gea-form-row">
            <label class="gea-label">Nombre</label>
            <input class="gea-input gea-grow" @bind="_nuevo.Nombre" placeholder="Ej. Ascensor Torre A, Sillas salon social..." />
        </div>
        <div class="gea-form-row">
            <label class="gea-label">Tipo</label>
            <div class="gea-pills">
                <button type="button" class="gea-pill @(_nuevo.Tipo == TipoElemento.Equipo ? "gea-pill--on" : "")" @onclick="@(() => { _nuevo.Tipo = TipoElemento.Equipo; _nuevo.Cantidad = 1; })">
                    Equipo <span class="gea-pill-hint">(pieza unica)</span>
                </button>
                <button type="button" class="gea-pill @(_nuevo.Tipo == TipoElemento.Activo ? "gea-pill--on" : "")" @onclick="@(() => _nuevo.Tipo = TipoElemento.Activo)">
                    Activo <span class="gea-pill-hint">(se agrupa en cantidad)</span>
                </button>
            </div>
        </div>
        <div class="gea-form-row">
            <label class="gea-label">Categoria</label>
            <select class="gea-input" @bind="_nuevo.Categoria">
                @foreach (var c in (CategoriaEquipo[])System.Enum.GetValues(typeof(CategoriaEquipo)))
                {
                    <option value="@c">@CategoriaTxt(c)</option>
                }
            </select>
            @if (_nuevo.Tipo == TipoElemento.Activo)
            {
                <label class="gea-label gea-label--inline">Cantidad</label>
                <input type="number" min="1" class="gea-input gea-input--mini" @bind="_nuevo.Cantidad" />
            }
        </div>
        <div class="gea-form-row">
            <label class="gea-check-row">
                <input type="checkbox" @bind="_nuevo.EsReservable" />
                <span>Es reservable</span>
                <span class="gea-pill-hint">(ascensores y bombas NO se reservan; salones, gimnasio, piscina SI)</span>
            </label>
            <button class="gea-btn-brand" type="button" @onclick="AgregarAsync" disabled="@_busy">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                Agregar
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="gea-toast @(_msgError ? "gea-toast--err" : "gea-toast--ok")">@_msg</div>
}

<style>
    .gea-header { display: flex; align-items: center; gap: 12px; padding: 16px 22px; border-bottom: 1px solid #EEF3F8; }
    .gea-header-icon { width: 36px; height: 36px; border-radius: 10px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .gea-header-text { flex: 1; }
    .gea-title { font-size: 15px; font-weight: 800; letter-spacing: -.3px; color: #1B2A3A; }
    .gea-subtitle { font-size: 12px; color: #7C98B6; margin-top: 1px; }
    .gea-close { background: transparent; border: 1px solid #E1E8EE; width: 32px; height: 32px; border-radius: 8px; color: #7C98B6; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .gea-close:hover { background: #F5F8FA; color: #33475B; }

    .gea-body { padding: 18px 22px; max-height: 70vh; overflow-y: auto; }
    .gea-empty { background: #F8FAFC; border: 1px dashed #D7E0EA; border-radius: 11px; padding: 22px; text-align: center; color: #7C98B6; font-size: 13px; display: flex; flex-direction: column; gap: 4px; margin-bottom: 14px; }
    .gea-empty strong { color: #1B2A3A; font-weight: 700; font-size: 13.5px; }

    .gea-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 14px; }
    .gea-card { display: flex; align-items: center; gap: 11px; border: 1px solid #E1E8EE; border-radius: 11px; padding: 12px 14px; background: #fff; }
    .gea-card:hover { border-color: var(--propia-brand, #6D4FE3); background: #FBFAFE; }
    .gea-card-icon { width: 36px; height: 36px; border-radius: 9px; background: #EEF3F8; color: #516F90; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .gea-card-body { flex: 1; min-width: 0; }
    .gea-card-name { font-size: 13px; font-weight: 700; color: #33475B; }
    .gea-card-meta { font-size: 11px; color: #A6B7C8; margin-top: 1px; }
    .gea-badge { font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 6px; white-space: nowrap; text-transform: uppercase; letter-spacing: .3px; }
    .gea-badge--ok { color: #1A8754; background: #E6F6EE; }
    .gea-badge--mant { color: #B45309; background: #FEF3DC; }
    .gea-badge--fuera { color: #C0383C; background: #FDE7E7; }
    .gea-estado-select { display: none; }
    .gea-card:hover .gea-estado-select { display: inline-block; border: 1px solid #E1E8EE; border-radius: 7px; padding: 4px 7px; font-size: 11px; color: #516F90; background: #fff; outline: none; font-family: inherit; }
    .gea-del { width: 28px; height: 28px; border-radius: 7px; background: transparent; border: 0; color: #C3D0DD; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .gea-del:hover { background: #FDE7E7; color: #D7263D; }

    .gea-form { display: flex; flex-direction: column; gap: 10px; padding: 14px; background: #F8FAFC; border: 1px dashed #D7E0EA; border-radius: 11px; }
    .gea-form-row { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
    .gea-label { font-size: 11.5px; color: #7C98B6; font-weight: 700; min-width: 78px; }
    .gea-label--inline { margin-left: 8px; min-width: 0; }
    .gea-input { border: 1px solid #E1E8EE; border-radius: 9px; padding: 9px 11px; font-size: 13px; color: #33475B; outline: none; background: #fff; font-family: inherit; }
    .gea-input:focus { border-color: var(--propia-brand, #6D4FE3); }
    .gea-input--mini { width: 80px; }
    .gea-grow { flex: 1; min-width: 160px; }
    .gea-pills { display: flex; gap: 6px; flex: 1; }
    .gea-pill { background: #fff; border: 1.5px solid #E1E8EE; border-radius: 9px; padding: 8px 12px; font-size: 13px; font-weight: 700; color: #516F90; cursor: pointer; font-family: inherit; flex: 1; text-align: left; }
    .gea-pill:hover { border-color: #C3D0DD; }
    .gea-pill--on { border-color: var(--propia-brand, #6D4FE3); background: #F1ECFD; color: var(--propia-brand, #6D4FE3); }
    .gea-pill-hint { font-size: 11px; color: #A6B7C8; font-weight: 500; margin-left: 4px; }
    .gea-check-row { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: #33475B; cursor: pointer; flex: 1; }
    .gea-check-row input { accent-color: var(--propia-brand, #6D4FE3); }
    .gea-btn-brand { display: inline-flex; align-items: center; gap: 6px; padding: 9px 15px; border-radius: 9px; border: 0; background: var(--propia-brand, #6D4FE3); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .gea-btn-brand:hover { background: var(--propia-brand-hover, #5838C9); }
    .gea-btn-brand:disabled { opacity: .55; cursor: not-allowed; }

    .gea-toast { position: fixed; bottom: 24px; right: 28px; padding: 11px 16px; border-radius: 9px; font-size: 12.5px; font-weight: 700; box-shadow: 0 8px 24px rgba(45,62,80,.18); z-index: 1500; }
    .gea-toast--ok { background: #1A8754; color: #fff; }
    .gea-toast--err { background: #DC2626; color: #fff; }
</style>

@code {
    [Parameter] public string? Jwt { get; set; }

    private List<EquipoActivoDto> _equipos = new();
    private NuevoEquipoForm _nuevo = new();
    private bool _busy;
    private bool _dirty;
    private string? _msg;
    private bool _msgError;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try { _equipos = await Auth().GetFromJsonAsync<List<EquipoActivoDto>>("/api/mi-copropiedad/equipos") ?? new(); }
        catch (Exception ex) { Toast(ex.Message, true); }
    }

    private async Task AgregarAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevo.Nombre)) { Toast("El nombre es obligatorio.", true); return; }
        _busy = true;
        try
        {
            var req = new CrearEquipoActivoRequest(_nuevo.Nombre.Trim(), _nuevo.Categoria, _nuevo.Tipo, _nuevo.Cantidad, _nuevo.EsReservable);
            var r = await Auth().PostAsJsonAsync("/api/mi-copropiedad/equipos", req);
            if (r.IsSuccessStatusCode)
            {
                _dirty = true;
                _nuevo = new NuevoEquipoForm();
                await CargarAsync();
                Toast("Equipo agregado.", false);
            }
            else Toast($"Error: {(int)r.StatusCode}", true);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

    private async Task CambiarEstadoAsync(Guid id, ChangeEventArgs e)
    {
        if (!Enum.TryParse<EstadoEquipoActivo>(e.Value?.ToString(), out var nuevo)) return;
        try
        {
            var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{id}/estado", new CambiarEstadoEquipoRequest(nuevo));
            if (r.IsSuccessStatusCode) { _dirty = true; await CargarAsync(); Toast("Estado actualizado.", false); }
            else Toast($"Error: {(int)r.StatusCode}", true);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
    }

    private async Task EliminarAsync(Guid id)
    {
        try
        {
            var r = await Auth().DeleteAsync($"/api/mi-copropiedad/equipos/{id}");
            if (r.IsSuccessStatusCode) { _dirty = true; _equipos.RemoveAll(x => x.Id == id); Toast("Equipo eliminado.", false); }
            else Toast($"Error: {(int)r.StatusCode}", true);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
    }

    private void Toast(string m, bool err) { _msg = m; _msgError = err; }

    private static string CategoriaTxt(CategoriaEquipo c) => c switch
    {
        CategoriaEquipo.Bombeo => "Bombeo",
        CategoriaEquipo.Electricidad => "Electricidad",
        CategoriaEquipo.Ascensores => "Ascensores",
        CategoriaEquipo.Seguridad => "Seguridad",
        CategoriaEquipo.Comunicaciones => "Comunicaciones",
        CategoriaEquipo.Climatizacion => "Climatizacion",
        CategoriaEquipo.Recreacion => "Recreacion",
        CategoriaEquipo.Otros => "Otros",
        _ => c.ToString()
    };

    private static string EstadoTxt(EstadoEquipoActivo s) => s switch
    {
        EstadoEquipoActivo.Operativo => "Operativo",
        EstadoEquipoActivo.EnMantenimiento => "Mantenimiento",
        EstadoEquipoActivo.FueraDeServicio => "Fuera",
        _ => s.ToString()
    };

    private static string BadgeClass(EstadoEquipoActivo s) => s switch
    {
        EstadoEquipoActivo.Operativo => "ok",
        EstadoEquipoActivo.EnMantenimiento => "mant",
        EstadoEquipoActivo.FueraDeServicio => "fuera",
        _ => "ok"
    };

    private class NuevoEquipoForm
    {
        public string Nombre { get; set; } = "";
        public CategoriaEquipo Categoria { get; set; } = CategoriaEquipo.Ascensores;
        public TipoElemento Tipo { get; set; } = TipoElemento.Equipo;
        public int Cantidad { get; set; } = 1;
        public bool EsReservable { get; set; }
    }
}
