@* FichaTerceroModal - ficha de un TERCERO (proveedor / contratista externo; modulo Terceros, antes
   Directorio). Un tercero es una PERSONA o una EMPRESA del Directorio marcada como proveedor; aqui se
   mapea sobre esas entidades (sin tabla nueva). Frame estandar de ficha (1056 x 86vh fijo, is-fixedh):
   cabecera con navegacion ‹ ›, titulo editable y acciones; pestanas (Perfil / Documentos / Comentarios /
   Vinculos / Acceso / Historial); perfil en 2 columnas; pie "Cerrar / Invitar al sistema".
   Calca de la maqueta D:\DesarrolloIA\Maqueta\modal-tercero.html (P.fichaTercero; clases .pm-* / .fr-* /
   .gpq-tabs). "Servicio que presta" = etiquetas del vinculo (opciones de la lista catalogo tercero.servicio). *@

@inherits ModalBase<FichaTerceroModal.Resultado>
@using Propia.Application.Directorio
@using Propia.Application.UsuariosAccesos
@using Propia.Application.Catalogos
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

@if (_cargando)
{
    <div class="fr-loading"><div class="spinner-border" style="color:var(--propia-brand)"></div></div>
}
else
{
<div class="pm-head">
    @if (ListaIds is { Count: > 1 } && _idx >= 0)
    {
        <div class="pm-nav">
            <button class="pm-nav-btn" type="button" title="Registro anterior" disabled="@(_idx <= 0)" @onclick="Anterior">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <span class="pm-nav-pos">@(_idx + 1) / @ListaIds.Count</span>
            <button class="pm-nav-btn" type="button" title="Registro siguiente" disabled="@(_idx >= ListaIds.Count - 1)" @onclick="Siguiente">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
            </button>
        </div>
    }
    <div class="pm-head-ic" title="Tercero (proveedor / contratista)">
        @* fi-rr-users-gear equivalente: personas + engranaje *@
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c0-3.3 2.6-5 5.5-5 1.1 0 2.1.25 3 .7"/><circle cx="17.5" cy="16.5" r="2.4"/><path d="M17.5 13.4v-1.3M17.5 20.9v-1.3M20.6 16.5h-1.3M15.7 16.5h-1.3M19.7 14.3l-.9.9M16.2 17.8l-.9.9M19.7 18.7l-.9-.9M16.2 15.2l-.9-.9"/></svg>
    </div>
    <div class="pm-head-tt">
        <input class="pm-head-h-edit" @bind="_titulo" @bind:event="oninput" title="@(EsEmpresa ? "Razón social (editable)" : "Nombre del tercero (editable)")" />
        <div class="pm-head-s">@Subtitulo</div>
    </div>
    <div class="pm-head-acts">
        <button class="pm-head-act" type="button" title="Copiar enlace al registro" @onclick="CopiarEnlace">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.07 0l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.07 0l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
        </button>
        <div class="fr-menu-wrap">
            <button class="pm-head-act" type="button" title="Más acciones" @onclick="() => _menu = !_menu">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg>
            </button>
            @if (_menu)
            {
                <div class="fr-menu" tabindex="-1">
                    <button class="fr-menu-it" type="button" @onclick="CopiarEnlace">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.07 0l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.07 0l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                        Copiar enlace al registro
                    </button>
                </div>
            }
        </div>
        <button class="pm-x" type="button" title="Cerrar" @onclick="Cerrar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
    </div>
</div>

<div class="pm-body">
    @* CTA Editar (solo en Perfil) + pestanas *@
    <div class="tc-topbar">
        @if (_tab == "Perfil")
        {
            @if (!_editando)
            {
                <button class="fr-btn fr-btn-sm" type="button" @onclick="Editar"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/></svg> Editar</button>
            }
            else
            {
                <button class="fr-btn fr-btn-sm" type="button" @onclick="CancelarEdicion" disabled="@_guardando">Cancelar</button>
                <button class="fr-btn fr-btn-primary fr-btn-sm" type="button" @onclick="GuardarAsync" disabled="@_guardando">@(_guardando ? "Guardando..." : "Guardar cambios")</button>
            }
        }
    </div>
    <div class="gpq-tabs">
        @foreach (var t in Tabs)
        {
            var tt = t;
            <button class="gpq-tab @(_tab == tt ? "active" : "")" type="button" @onclick="() => _tab = tt">@tt</button>
        }
    </div>

    @if (_tab == "Perfil")
    {
        <div class="fr-body">
            @* ---------- Columna izquierda: logo/foto + chips de servicio ---------- *@
            <div class="fr-left">
                <div class="fr-sectlbl">@(EsEmpresa ? "LOGO" : "FOTO")</div>
                @if (!string.IsNullOrWhiteSpace(_imagenUrl))
                {
                    <div class="fr-avatar" style="background-image:url('@_imagenUrl')" role="button" title="Ver imagen completa" @onclick="() => _verImagen = _imagenUrl"></div>
                }
                else
                {
                    <div class="fr-avatar-ini">@Iniciales</div>
                }
                <label class="fr-img-change">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>@(_subiendoImg ? "Subiendo..." : (EsEmpresa ? "Cambiar logo" : "Cambiar foto"))
                    <InputFile OnChange="SubirImagen" accept="image/png,image/jpeg,image/webp" hidden disabled="@_subiendoImg" />
                </label>

                <div class="fr-tags">
                    @if (_servicios.Count == 0)
                    {
                        <span class="chip">Sin servicio</span>
                    }
                    else
                    {
                        @foreach (var s in _servicios)
                        {
                            var sv = s;
                            <span class="chip">
                                @sv.Valor
                                @if (_editando) { <button type="button" class="chip-x" title="Quitar servicio" @onclick="() => QuitarServicio(sv)">&times;</button> }
                            </span>
                        }
                    }
                </div>
                @if (_editando && _vinculoId is not null)
                {
                    <div class="fr-roles-disp" style="justify-content:center">
                        @foreach (var op in ServiciosDisponibles())
                        {
                            var o = op;
                            <button type="button" class="fr-rolchip-add" @onclick="() => AgregarServicio(o)">+ @o</button>
                        }
                    </div>
                }
            </div>

            @* ---------- Columna derecha: datos ---------- *@
            <div class="fr-right">
                <div class="fr-sectlbl">DATOS DEL TERCERO</div>
                <div class="fr-grid">
                    <div class="fr-fld">
                        <label>@(EsEmpresa ? "Razón social" : "Nombre")</label>
                        <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@_titulo" title="Se edita en el título" />
                    </div>
                    <div class="fr-fld">
                        <label>Tipo de tercero</label>
                        <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@(EsEmpresa ? "Empresa" : "Persona natural")" />
                    </div>
                    <div class="fr-fld">
                        <label>Tipo de documento</label>
                        <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@DocLabel" />
                    </div>
                    <div class="fr-fld">
                        <label>Número de documento</label>
                        <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@_documento" title="La identidad se edita en el Directorio" />
                    </div>
                    <div class="fr-fld">
                        <label>Correo</label>
                        <input class="fr-in @(_editando ? "" : "fr-in--ro")" type="email" readonly="@(!_editando)" tabindex="@(_editando ? 0 : -1)" @bind="_email" @bind:event="oninput" placeholder="correo@ejemplo.com" />
                    </div>
                    <div class="fr-fld">
                        <label>Celular</label>
                        <input class="fr-in @(_editando ? "" : "fr-in--ro")" readonly="@(!_editando)" tabindex="@(_editando ? 0 : -1)" @bind="_telefono" @bind:event="oninput" placeholder="@(_editando ? "Opcional" : "-")" />
                    </div>
                    <div class="fr-fld">
                        <label>Empresa</label>
                        <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@(string.IsNullOrWhiteSpace(_empresa) ? "-" : _empresa)" />
                    </div>
                    <div class="fr-fld">
                        <label>Servicio que presta</label>
                        <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@(_servicios.Count == 0 ? "-" : string.Join(", ", _servicios.Select(s => s.Valor)))" title="Se edita con los chips de la izquierda" />
                    </div>
                    <div class="fr-fld">
                        <label>Estado</label>
                        <input class="fr-in fr-in--ro" readonly tabindex="-1" value="@(_estado == EstadoDirectorio.Activo ? "Activo" : "Inactivo")" />
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_tab == "Documentos")
    {
        <div class="tc-tab">
            <div class="fr-sectlbl">DOCUMENTOS (RUT, CÁMARA DE COMERCIO, CERTIFICADOS, ETC.)</div>
            @if (_adjuntos.Count == 0)
            {
                <div class="fr-empty">Sin documentos adjuntos.</div>
            }
            else
            {
                <div class="fr-doclist">
                    @foreach (var a in _adjuntos)
                    {
                        var adj = a;
                        <div class="fr-doc">
                            <div class="fr-doc-ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/></svg></div>
                            <div class="fr-doc-txt">
                                <a class="fr-doc-nom" href="@adj.Url" target="_blank" rel="noopener" title="Abrir">@adj.Nombre</a>
                                <div class="fr-doc-meta">@FmtTam(adj.TamanoBytes) &middot; @adj.CreatedAt.ToCo().ToString("dd/MM/yyyy")</div>
                            </div>
                            <button class="fr-doc-del" type="button" title="Quitar" @onclick="() => EliminarAdjunto(adj.Id)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                        </div>
                    }
                </div>
            }
            <label class="fr-doc-add">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>@(_subiendoDoc ? "Subiendo..." : "Adjuntar documento")
                <InputFile OnChange="SubirDocumento" accept=".pdf,.png,.jpg,.jpeg,.webp" hidden disabled="@_subiendoDoc" />
            </label>
        </div>
    }
    else if (_tab == "Comentarios")
    {
        <div class="tc-tab">
            <div class="fr-sectlbl">COMENTARIOS</div>
            @if (EsEmpresa)
            {
                <div class="fr-empty">Los comentarios están disponibles para terceros tipo persona.</div>
            }
            else
            {
                @if (_comentarios.Count > 0)
                {
                    <div class="fr-com-list">
                        @foreach (var c in _comentarios)
                        {
                            <div class="fr-com-item">
                                <span class="fr-com-av">@InicialesAutor(c.AutorNombre)</span>
                                <div class="fr-com-b">
                                    <div class="fr-com-hd"><b>@(string.IsNullOrWhiteSpace(c.AutorNombre) ? "Usuario" : c.AutorNombre)</b><span class="fr-com-time">@c.CreatedAt.ToCo().ToString("dd/MM/yyyy HH:mm")</span></div>
                                    <div class="fr-com-txt">@c.Texto</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="fr-empty">Aún no hay comentarios en este registro.</div>
                }
                <div class="fr-com-new">
                    <textarea class="fr-in fr-com-ta" @bind="_nuevoComentario" @bind:event="oninput" placeholder="Escribe un comentario..." rows="2"></textarea>
                    <div class="fr-com-foot">
                        <button class="fr-btn fr-btn-primary fr-btn-sm" type="button" @onclick="PublicarComentario" disabled="@(_publicando || string.IsNullOrWhiteSpace(_nuevoComentario))">@(_publicando ? "Publicando..." : "Publicar")</button>
                    </div>
                </div>
            }
        </div>
    }
    else if (_tab == "Vínculos")
    {
        <div class="tc-tab"><div class="gum-tab-empty">Sin vínculos con unidades / equipos.</div></div>
    }
    else if (_tab == "Acceso")
    {
        <div class="tc-tab">
            <div class="fr-sectlbl">ACCESO AL SISTEMA (ROL)</div>
            @if (_accesoPersonaId is null)
            {
                <div class="gum-tab-empty">Para invitar a este tercero empresa al sistema, primero registra su representante legal (persona) en el Directorio.</div>
            }
            else
            {
                <p class="fr-roles-hint">El rol otorga acceso al sistema (p. ej. rol Terceros) y referencia la bandeja Roles y permisos; el detalle de permisos se edita allí.</p>
                @if (_rolesCargando)
                {
                    <div class="fr-empty">Cargando roles...</div>
                }
                else
                {
                    <div class="fr-chips">
                        @if (_rolIdsAsignados.Count == 0)
                        {
                            <span class="fr-chip-empty">Sin rol de acceso asignado.</span>
                        }
                        else
                        {
                            @foreach (var rid in _rolIdsAsignados)
                            {
                                var id = rid;
                                <span class="fr-rolchip">@RolNombre(id)<button type="button" class="fr-rolchip-x" title="Quitar rol" @onclick="() => QuitarRol(id)">&times;</button></span>
                            }
                        }
                    </div>
                    @if (RolesDisponibles() is { Count: > 0 } disp)
                    {
                        <div class="fr-roles-disp">
                            <span class="fr-disp-lbl">Clic para asignar:</span>
                            @foreach (var r in disp)
                            {
                                var rr = r;
                                <button type="button" class="fr-rolchip-add" @onclick="() => AgregarRol(rr.Id)">+ @rr.Nombre</button>
                            }
                        </div>
                    }
                    <div class="fr-com-foot" style="justify-content:flex-start;margin-top:12px">
                        <button class="fr-btn fr-btn-primary fr-btn-sm" type="button" @onclick="GuardarAccesoAsync" disabled="@_guardandoAcceso">@(_guardandoAcceso ? "Guardando..." : (_usuarioTenantId is null ? "Invitar con el rol" : "Actualizar rol"))</button>
                    </div>
                }
            }
        </div>
    }
    else if (_tab == "Historial")
    {
        <div class="tc-tab"><div class="gum-tab-empty">Sin movimientos.</div></div>
    }

    @if (!string.IsNullOrWhiteSpace(_msg))
    {
        <div class="fr-msg @(_msgError ? "err" : "ok")">@_msg</div>
    }
</div>

<div class="pm-foot">
    <button class="fr-btn" type="button" @onclick="Cerrar">Cerrar</button>
    <button class="fr-btn fr-btn-primary" type="button" @onclick="InvitarAlSistema">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"/></svg>
        Invitar al sistema
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_verImagen))
{
    <div class="fr-lb" @onclick="() => _verImagen = null">
        <button class="fr-lb-x" type="button" title="Cerrar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        <img src="@_verImagen" alt="Imagen del tercero" />
    </div>
}
}

<style>
    .fr-loading { min-height: 220px; display: flex; align-items: center; justify-content: center; }

    /* ===== Cabecera (calca .pm-*) ===== */
    .pm-head { display: flex; align-items: center; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--propia-border-divider); }
    .pm-head-ic { width: 40px; height: 40px; border-radius: 11px; background: var(--propia-brand-soft); color: var(--propia-brand); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pm-head-tt { flex: 1; min-width: 0; }
    .pm-head-h-edit { width: 100%; border: 1px solid transparent; background: transparent; border-radius: 8px; padding: 4px 8px; font-size: 16px; font-weight: 800; color: var(--propia-text-h1); font-family: inherit; line-height: normal; }
    .pm-head-h-edit:hover { border-color: var(--propia-border-card); }
    .pm-head-h-edit:focus { outline: none; border-color: var(--propia-brand); box-shadow: 0 0 0 2px rgba(109,79,227,.12); background: var(--propia-bg-card); }
    .pm-head-s { font-size: 12.5px; color: var(--propia-text-muted); margin-top: 2px; line-height: normal; }
    .pm-nav { display: inline-flex; align-items: center; gap: 2px; flex-shrink: 0; }
    .pm-nav-btn { width: 28px; height: 28px; border-radius: 8px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); color: var(--propia-text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .pm-nav-btn:hover:not(:disabled) { border-color: var(--propia-brand); color: var(--propia-brand); }
    .pm-nav-btn:disabled { opacity: .4; cursor: default; }
    .pm-nav-pos { font-size: 11px; font-weight: 700; color: var(--propia-text-faint); padding: 0 5px; white-space: nowrap; }
    .pm-head-acts { display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0; }
    .pm-head-act { width: 30px; height: 30px; border-radius: 8px; border: 0; background: transparent; color: var(--propia-text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .pm-head-act:hover { background: var(--propia-bg-hover); color: var(--propia-brand); }
    .pm-x { border: 0; background: transparent; color: var(--propia-text-muted); cursor: pointer; width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pm-x:hover { background: var(--propia-bg-hover); color: var(--propia-text-body); }
    .fr-menu-wrap { position: relative; display: inline-flex; }
    .fr-menu { position: absolute; top: 34px; right: 0; z-index: 20; min-width: 210px; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 11px; box-shadow: 0 12px 34px rgba(27,42,58,.18); padding: 5px; display: flex; flex-direction: column; gap: 1px; }
    .fr-menu-it { display: flex; align-items: center; gap: 9px; width: 100%; border: 0; background: transparent; color: var(--propia-text-body); font-size: 12.5px; font-weight: 600; text-align: left; padding: 8px 10px; border-radius: 8px; cursor: pointer; font-family: inherit; }
    .fr-menu-it:hover { background: var(--propia-bg-hover); color: var(--propia-brand); }

    /* ===== Cuerpo + pestanas ===== */
    .pm-body { padding: 16px 20px; overflow: auto; flex: 1 1 auto; min-height: 0; }
    .tc-topbar { display: flex; justify-content: flex-end; gap: 8px; min-height: 30px; margin-bottom: 8px; }
    .gpq-tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--propia-border-divider); margin-bottom: 14px; flex-wrap: wrap; }
    .gpq-tab { border: 0; background: transparent; color: var(--propia-text-muted); font-size: 13px; font-weight: 700; font-family: inherit; padding: 11px 16px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .gpq-tab:hover { color: var(--propia-text-body); }
    .gpq-tab.active { color: var(--propia-brand); border-bottom-color: var(--propia-brand); }
    .tc-tab { padding: 4px 2px 8px; display: flex; flex-direction: column; gap: 10px; }
    .gum-tab-empty { font-size: 12.5px; color: var(--propia-text-muted); padding: 24px 0; text-align: center; }

    .fr-body { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 18px; padding: 6px 2px 8px; }
    .fr-left { display: flex; flex-direction: column; align-items: center; gap: 9px; }
    .fr-left .fr-sectlbl { align-self: stretch; }
    .fr-right { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    .fr-sectlbl { font-size: 11px; letter-spacing: .5px; color: var(--propia-text-faint); font-weight: 700; }
    .fr-sectlbl--sep { margin-top: 8px; padding-top: 12px; border-top: 1px dashed var(--propia-border-card); }

    .fr-avatar { width: 150px; height: 150px; border-radius: 50%; background-size: cover; background-position: center; background-repeat: no-repeat; background-color: var(--propia-border-divider); border: 3px solid var(--propia-bg-card); box-shadow: 0 2px 10px rgba(27,42,58,.14), 0 0 0 1px var(--propia-border-card); cursor: zoom-in; margin-top: 4px; }
    .fr-avatar-ini { width: 150px; height: 150px; border-radius: 50%; background: var(--propia-brand-soft); color: var(--propia-brand); display: flex; align-items: center; justify-content: center; font-size: 44px; font-weight: 800; border: 3px solid var(--propia-bg-card); box-shadow: 0 2px 10px rgba(27,42,58,.14), 0 0 0 1px var(--propia-border-card); margin-top: 4px; }
    .fr-img-change { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11.5px; font-weight: 700; color: var(--propia-brand); cursor: pointer; }
    .fr-tags { display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; margin-top: 2px; }
    /* Chip de servicio = calca maqueta: pill neutro, fondo transparente, texto cuerpo, sin borde. */
