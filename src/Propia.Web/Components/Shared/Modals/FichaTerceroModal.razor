@code {
    [Parameter] public string? Jwt { get; set; }
    /// <summary>Tipo de entidad sobre la que se mapea el tercero (Persona | Empresa).</summary>
    [Parameter] public EntidadDirectorio EntidadTipo { get; set; } = EntidadDirectorio.Persona;
    [Parameter] public Guid EntidadId { get; set; }
    [Parameter] public string? NombreInicial { get; set; }
    /// <summary>Ids visibles (del MISMO tipo) para la navegacion entre registros.</summary>
    [Parameter] public List<Guid>? ListaIds { get; set; }

    public record Resultado(bool Cambio, Guid? IrA);

    private static readonly string[] Tabs = { "Perfil", "Documentos", "Comentarios", "Vínculos", "Acceso", "Historial" };
    private string _tab = "Perfil";

    private bool _cargando = true;
    private bool _guardando;
    private bool _guardandoAcceso;
    private bool _subiendoImg;
    private bool _subiendoDoc;
    private bool _menu;
    private bool _editando;
    private string? _msg;
    private bool _msgError;
    private bool _dirty;
    private int _idx = -1;

    private bool EsEmpresa => EntidadTipo == EntidadDirectorio.Empresa;

    // ----- Datos comunes -----
    private string _titulo = "";          // nombre completo (persona) o razon social (empresa)
    private string _documento = "";
    private string? _email;
    private string? _telefono;
    private string? _imagenUrl;           // foto (persona) o logo (empresa)
    private string? _empresa;             // empresa a la que pertenece (persona); "-" por defecto
    private EstadoDirectorio _estado = EstadoDirectorio.Activo;

    // Persona
    private TipoDocumento _tipoDoc = TipoDocumento.CC;
    // Empresa (campos a preservar en el PUT)
    private string? _nombreComercial, _direccion, _tipoEmpresa, _sector, _regimen, _sitioWeb;
    private Guid? _repLegalPersonaId;

    private string? _verImagen;

    // ----- Servicio que presta (etiquetas del vinculo + opciones de catalogo tercero.servicio) -----
    private Guid? _vinculoId;
    private readonly List<EtiquetaAsignadaDto> _servicios = new();
    private List<string> _servOpciones = new();

    private List<DirectorioAdjuntoDto> _adjuntos = new();

    // ----- Comentarios (solo persona) -----
    private List<PersonaComentarioDto> _comentarios = new();
    private string? _nuevoComentario;
    private bool _publicando;

    // ----- Acceso al sistema (sobre la persona, o el representante legal de la empresa) -----
    private Guid? _accesoPersonaId;
    private bool _rolesCargando = true;
    private List<RolDto> _roles = new();
    private readonly List<Guid> _rolIdsAsignados = new();
    private Guid? _usuarioTenantId;

    private string DocLabel => EsEmpresa ? "NIT" : _tipoDoc switch
    {
        TipoDocumento.CC => "Cédula de ciudadanía",
        TipoDocumento.CE => "Cédula de extranjería",
        TipoDocumento.PA => "Pasaporte",
        TipoDocumento.TI => "Tarjeta de identidad",
        TipoDocumento.NIT => "NIT",
        _ => "Documento"
    };

    private string Subtitulo
    {
        get
        {
            var doc = string.IsNullOrWhiteSpace(_documento) ? "" : _documento;
            var mail = string.IsNullOrWhiteSpace(_email) ? "" : _email!;
            return string.Join(" · ", new[] { doc, mail }.Where(x => !string.IsNullOrWhiteSpace(x)));
        }
    }

    private string Iniciales
    {
        get
        {
            var ini = string.Concat((_titulo ?? "").Trim()
                .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
            return string.IsNullOrWhiteSpace(ini) ? "#" : ini.ToUpperInvariant();
        }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    protected override async Task OnInitializedAsync()
    {
        _idx = ListaIds?.IndexOf(EntidadId) ?? -1;
        try
        {
            if (EsEmpresa)
            {
                var dto = await Auth().GetFromJsonAsync<Empresa360Dto>($"/api/directorio/empresas/{EntidadId}");
                if (dto is not null)
                {
                    var e = dto.Empresa;
                    _titulo = string.IsNullOrWhiteSpace(e.NombreComercial) ? e.RazonSocial : e.NombreComercial!;
                    _documento = string.IsNullOrWhiteSpace(e.DigitoVerificacion) ? e.Nit : $"{e.Nit}-{e.DigitoVerificacion}";
                    _email = e.Email; _telefono = e.Telefono; _imagenUrl = e.LogoUrl; _estado = e.Estado;
                    _nombreComercial = e.NombreComercial; _direccion = e.Direccion;
                    _tipoEmpresa = e.TipoEmpresa; _sector = e.SectorEconomico; _regimen = e.RegimenTributario; _sitioWeb = e.SitioWeb;
                    _repLegalPersonaId = e.RepresentanteLegalPersonaId;
                    // la "razon social" real se conserva aparte del titulo mostrado
                    _razonSocial = e.RazonSocial;
                    _accesoPersonaId = e.RepresentanteLegalPersonaId;
                    TomarServicios(dto.VinculosEnCopropiedad);
                }
            }
            else
            {
                var dto = await Auth().GetFromJsonAsync<Persona360Dto>($"/api/directorio/personas/{EntidadId}");
                if (dto is not null)
                {
                    var p = dto.Persona;
                    _titulo = $"{p.Nombres} {p.Apellidos}".Trim();
                    _tipoDoc = p.TipoDocumento; _documento = p.Documento;
                    _email = p.Email; _telefono = p.Telefono; _imagenUrl = p.FotoUrl; _estado = p.Estado;
                    _accesoPersonaId = p.Id;
                    TomarServicios(dto.VinculosEnCopropiedad);
                }
            }
            await CargarAdjuntosAsync();
            await CargarServOpcionesAsync();
            if (!EsEmpresa) await CargarComentariosAsync();
            await CargarRolesAsync();
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
        finally { _cargando = false; }
    }

    private string _razonSocial = "";

    private void TomarServicios(IReadOnlyList<VinculoDto> vinculos)
    {
        var v = vinculos.FirstOrDefault(x => x.Estado == EstadoVinculo.Activo) ?? vinculos.FirstOrDefault();
        if (v is null) return;
        _vinculoId = v.Id;
        _servicios.Clear();
        _servicios.AddRange(v.Etiquetas.Select(e => new EtiquetaAsignadaDto(e.Id, e.Valor)));
    }

    private async Task CargarServOpcionesAsync()
    {
        try
        {
            var ops = await Auth().GetFromJsonAsync<List<CatalogoOpcionDto>>("/api/catalogos?lista=tercero.servicio") ?? new();
            _servOpciones = ops.Where(o => o.Activo).Select(o => o.Label).ToList();
        }
        catch { _servOpciones = new(); }
    }

    private List<string> ServiciosDisponibles()
        => _servOpciones.Where(o => !_servicios.Any(s => string.Equals(s.Valor, o, StringComparison.OrdinalIgnoreCase))).ToList();

    private async Task AgregarServicio(string valor)
    {
        if (_vinculoId is null || _servicios.Any(s => string.Equals(s.Valor, valor, StringComparison.OrdinalIgnoreCase))) return;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/directorio/vinculos/etiquetas", new AsignarEtiquetaRequest(_vinculoId.Value, valor));
            if (resp.IsSuccessStatusCode)
            {
                // El endpoint devuelve el VinculoDto con las etiquetas actualizadas (con sus ids reales).
                var v = await resp.Content.ReadFromJsonAsync<VinculoDto>();
                if (v is not null) { _servicios.Clear(); _servicios.AddRange(v.Etiquetas.Select(e => new EtiquetaAsignadaDto(e.Id, e.Valor))); }
                else { _servicios.Add(new EtiquetaAsignadaDto(Guid.Empty, valor)); }
                _dirty = true;
            }
            else { _msg = "No se pudo agregar el servicio: " + await resp.Content.ReadAsStringAsync(); _msgError = true; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
    }

    private async Task QuitarServicio(EtiquetaAsignadaDto s)
    {
        try
        {
            if (s.Id != Guid.Empty)
            {
                var resp = await Auth().DeleteAsync($"/api/directorio/vinculos/etiquetas/{s.Id}");
                if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgError = true; return; }
            }
            _servicios.RemoveAll(x => x.Id == s.Id && x.Valor == s.Valor);
            _dirty = true;
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
    }

    private async Task CargarAdjuntosAsync()
    {
        var tipo = EsEmpresa ? "Empresa" : "Persona";
        try { _adjuntos = await Auth().GetFromJsonAsync<List<DirectorioAdjuntoDto>>($"/api/directorio/adjuntos/{tipo}/{EntidadId}") ?? new(); }
        catch { _adjuntos = new(); }
    }

    private async Task CargarComentariosAsync()
    {
        try { _comentarios = await Auth().GetFromJsonAsync<List<PersonaComentarioDto>>($"/api/directorio/personas/{EntidadId}/comentarios") ?? new(); }
        catch { _comentarios = new(); }
    }

    private async Task CargarRolesAsync()
    {
        if (_accesoPersonaId is null) { _rolesCargando = false; return; }
        try
        {
            _roles = await Auth().GetFromJsonAsync<List<RolDto>>("/api/roles") ?? new();
            var resp = await Auth().GetAsync($"/api/usuarios/por-persona/{_accesoPersonaId.Value}");
            if (resp.StatusCode == System.Net.HttpStatusCode.OK)
            {
                var u = await resp.Content.ReadFromJsonAsync<UsuarioPorPersonaDto>();
                if (u is not null) { _usuarioTenantId = u.UsuarioTenantId; _rolIdsAsignados.Clear(); _rolIdsAsignados.AddRange(u.RolIds); }
            }
        }
        catch { }
        finally { _rolesCargando = false; }
    }

    private void Editar() { _editando = true; _msg = ""; }
    private async Task CancelarEdicion() { _editando = false; _msg = ""; await RecargarAsync(); }

    private async Task RecargarAsync()
    {
        _cargando = true; StateHasChanged();
        _servicios.Clear(); _rolIdsAsignados.Clear(); _usuarioTenantId = null; _rolesCargando = true;
        await OnInitializedAsync();
        StateHasChanged();
    }

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(_titulo)) { _msg = EsEmpresa ? "La razón social es obligatoria." : "El nombre es obligatorio."; _msgError = true; return; }
        _guardando = true; _msg = "";
        try
        {
            HttpResponseMessage resp;
            if (EsEmpresa)
            {
                // El titulo edita la razon social (o el nombre comercial si existia). Conservamos el resto.
                var razon = string.IsNullOrWhiteSpace(_razonSocial) ? _titulo.Trim() : _razonSocial;
                var nomCom = string.IsNullOrWhiteSpace(_nombreComercial) ? null : _titulo.Trim();
                if (string.IsNullOrWhiteSpace(_nombreComercial)) razon = _titulo.Trim();
                var req = new ActualizarEmpresaRequest(razon, nomCom,
                    string.IsNullOrWhiteSpace(_email) ? null : _email!.Trim(),
                    string.IsNullOrWhiteSpace(_telefono) ? null : _telefono!.Trim(),
                    _direccion, _tipoEmpresa, _sector, _regimen, _sitioWeb, _imagenUrl, _repLegalPersonaId);
                resp = await Auth().PutAsJsonAsync($"/api/directorio/empresas/{EntidadId}", req);
            }
            else
            {
                var parts = _titulo.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
                var nombres = parts.Length > 0 ? parts[0] : "";
                var apellidos = parts.Length > 1 ? parts[1] : "";
                var req = new ActualizarPersonaRequest(nombres, apellidos,
                    string.IsNullOrWhiteSpace(_email) ? null : _email!.Trim(),
                    string.IsNullOrWhiteSpace(_telefono) ? null : _telefono!.Trim(),
                    _imagenUrl, null, null);
                resp = await Auth().PutAsJsonAsync($"/api/directorio/personas/{EntidadId}", req);
            }
            if (!resp.IsSuccessStatusCode) { _msg = await resp.Content.ReadAsStringAsync(); _msgError = true; return; }
            _dirty = true; _editando = false; _msg = "Datos guardados."; _msgError = false;
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
        finally { _guardando = false; }
    }

    // ----- Comentarios -----
    private async Task PublicarComentario()
    {
        if (EsEmpresa || string.IsNullOrWhiteSpace(_nuevoComentario)) return;
        _publicando = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync($"/api/directorio/personas/{EntidadId}/comentarios", new CrearPersonaComentarioRequest(_nuevoComentario!.Trim()));
            if (resp.IsSuccessStatusCode)
            {
                var c = await resp.Content.ReadFromJsonAsync<PersonaComentarioDto>();
                if (c is not null) { _comentarios.Add(c); _dirty = true; }
                _nuevoComentario = "";
            }
            else { _msg = "No se pudo publicar: " + await resp.Content.ReadAsStringAsync(); _msgError = true; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
        finally { _publicando = false; }
    }

    private static string InicialesAutor(string? n)
    {
        if (string.IsNullOrWhiteSpace(n)) return "?";
        var parts = n.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => p[0])).ToUpperInvariant();
    }

    // ----- Acceso / roles -----
    private List<RolDto> RolesDisponibles() => _roles.Where(r => r.Activo && !_rolIdsAsignados.Contains(r.Id)).ToList();
    private string RolNombre(Guid id) => _roles.FirstOrDefault(r => r.Id == id)?.Nombre ?? "Rol";
    private void AgregarRol(Guid id) { if (!_rolIdsAsignados.Contains(id)) _rolIdsAsignados.Add(id); }
    private void QuitarRol(Guid id) => _rolIdsAsignados.Remove(id);

    private async Task GuardarAccesoAsync()
    {
        if (_accesoPersonaId is null) return;
        _guardandoAcceso = true; _msg = "";
        try
        {
            if (_usuarioTenantId is Guid utid)
            {
                var r = await Auth().PutAsJsonAsync($"/api/usuarios/{utid}/roles", new ActualizarRolesUsuarioRequest(_rolIdsAsignados));
                if (!r.IsSuccessStatusCode) { _msg = "No se pudo actualizar el rol: " + await r.Content.ReadAsStringAsync(); _msgError = true; return; }
                _msg = "Rol actualizado."; _msgError = false; _dirty = true;
            }
            else if (_rolIdsAsignados.Count > 0)
            {
                var r = await Auth().PostAsJsonAsync("/api/usuarios/alta", new CrearUsuarioAltaRequest(_accesoPersonaId.Value, _rolIdsAsignados, new List<string>()));
                if (!r.IsSuccessStatusCode) { _msg = "No se pudo invitar: " + await r.Content.ReadAsStringAsync(); _msgError = true; return; }
                var creado = await r.Content.ReadFromJsonAsync<AltaResp>();
                if (creado is not null) _usuarioTenantId = creado.id;
                _msg = "Invitado al sistema con el rol."; _msgError = false; _dirty = true;
            }
            else { _msg = "Selecciona al menos un rol."; _msgError = true; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
        finally { _guardandoAcceso = false; }
    }

    private void InvitarAlSistema()
    {
        _tab = "Acceso";
        if (_accesoPersonaId is not null && _usuarioTenantId is null && _rolIdsAsignados.Count == 0)
        {
            // Preseleccionar el rol "Terceros" si existe, para que el usuario solo confirme.
            var terceros = _roles.FirstOrDefault(r => r.Activo && r.Nombre.Contains("Tercero", StringComparison.OrdinalIgnoreCase));
            if (terceros is not null) _rolIdsAsignados.Add(terceros.Id);
        }
    }

    // ----- Imagen (foto persona / logo empresa) -----
    private async Task SubirImagen(InputFileChangeEventArgs e)
    {
        if (e.File is null) return;
        _subiendoImg = true; _msg = "";
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(5_500_000).CopyToAsync(ms);
            ms.Position = 0;
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(ms);
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(e.File.ContentType);
            content.Add(sc, "file", e.File.Name);
            // Persona: endpoint de foto. Empresa: adjunto como logo no existe endpoint dedicado -> se omite por ahora.
            if (!EsEmpresa)
            {
                var resp = await Auth().PostAsync($"/api/directorio/personas/{EntidadId}/foto", content);
                if (resp.IsSuccessStatusCode)
                {
                    var dto = await resp.Content.ReadFromJsonAsync<UrlResp>();
                    _imagenUrl = dto?.url; _dirty = true; _msg = "Foto actualizada."; _msgError = false;
                }
                else { _msg = await resp.Content.ReadAsStringAsync(); _msgError = true; }
            }
            else { _msg = "La carga de logo de empresa se gestiona desde el Directorio."; _msgError = true; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
        finally { _subiendoImg = false; }
    }

    private async Task SubirDocumento(InputFileChangeEventArgs e)
    {
        if (e.File is null) return;
        _subiendoDoc = true; _msg = "";
        var tipo = EsEmpresa ? "Empresa" : "Persona";
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(10_500_000).CopyToAsync(ms);
            ms.Position = 0;
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(ms);
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrWhiteSpace(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType);
            content.Add(sc, "file", e.File.Name);
            var resp = await Auth().PostAsync($"/api/directorio/adjuntos/{tipo}/{EntidadId}", content);
            if (resp.IsSuccessStatusCode) { _dirty = true; _msg = "Documento adjuntado."; _msgError = false; await CargarAdjuntosAsync(); }
            else { _msg = await resp.Content.ReadAsStringAsync(); _msgError = true; }
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
        finally { _subiendoDoc = false; }
    }

    private async Task EliminarAdjunto(Guid id)
    {
        try
        {
            var resp = await Auth().DeleteAsync($"/api/directorio/adjuntos/{id}");
            if (resp.IsSuccessStatusCode) { _dirty = true; _adjuntos.RemoveAll(a => a.Id == id); }
        }
        catch (Exception ex) { _msg = ex.Message; _msgError = true; }
    }

    private async Task CopiarEnlace()
    {
        _menu = false;
        var url = $"{Nav.BaseUri.TrimEnd('/')}/directorio";
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", url); _msg = "Enlace al registro copiado."; _msgError = false; }
        catch { _msg = "No se pudo copiar el enlace."; _msgError = true; }
    }

    private void Anterior() { if (ListaIds is not null && _idx > 0) Close(new Resultado(_dirty, ListaIds[_idx - 1])); }
    private void Siguiente() { if (ListaIds is not null && _idx >= 0 && _idx < ListaIds.Count - 1) Close(new Resultado(_dirty, ListaIds[_idx + 1])); }
    private void Cerrar() => Close(new Resultado(_dirty, null));

    private static string FmtTam(long b) => b >= 1_048_576 ? $"{b / 1_048_576.0:0.0} MB" : $"{b / 1024.0:0} KB";

    private record UrlResp(string? url);
    private record AltaResp(Guid id);
}
