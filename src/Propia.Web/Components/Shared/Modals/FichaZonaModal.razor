@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public ZonaComunDto? Zona { get; set; }

    private Guid ZonaId => Zona?.Id ?? Guid.Empty;

    private ZonaFichaDto? _ficha;
    private bool _busy;
    private bool _subiendoImg;
    private bool _subiendoDoc;
    private bool _dirty;
    private string _msg = "";

    // estado editable de config
    private string? _imagenUrl;
    // Programa de mantenimiento antiguo de la zona: ya no se edita desde la ficha (la
    // frecuencia la define ahora la regla del programador), pero se sigue leyendo y
    // guardando tal cual para no borrar el dato de las zonas que ya lo tenian.
    private string _mantTipo = "Interno";
    private string? _mantContrato;
    private string _mantFrec = "Mensual";
    private int? _mantDia;
    private bool _reservable;
    private int? _aforo;

    // forms
    private string _facConcepto = "";
    private decimal? _facValor;
    private string _campoLabel = "";
    private string _campoValor = "";

    private DisponibilidadHorariosEditor? _horariosEditor;

    private string _tab = "ficha";
    private readonly ZonaDatosForm _form = new();

    // Cuando se abre recien creada (ojito), arranca en "Editar datos" para completar y guardar.
    [Parameter] public bool AbrirEnEdicion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        if (AbrirEnEdicion && _ficha is not null) { IniciarEdicion(); }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        if (Zona is null) return;
        try
        {
            _ficha = await Auth().GetFromJsonAsync<ZonaFichaDto>($"/api/mi-copropiedad/zonas/{Zona.Id}/ficha");
            if (_ficha is not null)
            {
                _imagenUrl = _ficha.ImagenUrl;
                _mantTipo = _ficha.MantenimientoTipo;
                _mantContrato = _ficha.MantenimientoContrato;
                _mantFrec = _ficha.MantenimientoFrecuencia;
                _mantDia = _ficha.MantenimientoDiaMes;
                _reservable = _ficha.Zona.EsReservable;
                _aforo = _ficha.Zona.CapacidadPersonas;
            }
        }
        catch (Exception ex) { _msg = ex.Message; }
    }

    private async Task Recargar() => await CargarAsync();

    private async Task SubirImagen(InputFileChangeEventArgs e)
    {
        if (Zona is null || e.File is null) return;
        _subiendoImg = true; _msg = "";
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(e.File.OpenReadStream(5_000_000));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(e.File.ContentType);
            content.Add(sc, "file", e.File.Name);
            var resp = await Auth().PostAsync($"/api/mi-copropiedad/zonas/{Zona.Id}/imagen", content);
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<UrlResp>();
                _imagenUrl = dto?.url; _dirty = true;
            }
            else { _msg = await resp.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _subiendoImg = false; }
    }

    private async Task AgregarFactura()
    {
        if (Zona is null || string.IsNullOrWhiteSpace(_facConcepto)) return;
        var req = new AgregarZonaFacturaRequest(_facConcepto.Trim(), _facValor, null);
        var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/zonas/{Zona.Id}/facturas", req);
        if (resp.IsSuccessStatusCode) { _facConcepto = ""; _facValor = null; _dirty = true; await Recargar(); }
    }
    private async Task EliminarFactura(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/zonas/facturas/{id}");
        if (resp.IsSuccessStatusCode) { _dirty = true; await Recargar(); }
    }

    private async Task SubirDocumento(InputFileChangeEventArgs e)
    {
        if (Zona is null || e.File is null) return;
        _subiendoDoc = true; _msg = "";
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(e.File.OpenReadStream(10_000_000));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType);
            content.Add(sc, "file", e.File.Name);
            var resp = await Auth().PostAsync($"/api/mi-copropiedad/zonas/{Zona.Id}/documentos", content);
            if (resp.IsSuccessStatusCode) { _dirty = true; await Recargar(); }
            else { _msg = await resp.Content.ReadAsStringAsync(); }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _subiendoDoc = false; }
    }
    private async Task EliminarDocumento(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/zonas/documentos/{id}");
        if (resp.IsSuccessStatusCode) { _dirty = true; await Recargar(); }
    }

    private async Task AgregarCampo()
    {
        if (Zona is null || string.IsNullOrWhiteSpace(_campoLabel)) return;
        var req = new AgregarZonaCampoRequest(_campoLabel.Trim(), string.IsNullOrWhiteSpace(_campoValor) ? null : _campoValor.Trim());
        var resp = await Auth().PostAsJsonAsync($"/api/mi-copropiedad/zonas/{Zona.Id}/campos", req);
        if (resp.IsSuccessStatusCode) { _campoLabel = ""; _campoValor = ""; _dirty = true; await Recargar(); }
    }
    private async Task EliminarCampo(Guid id)
    {
        var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/zonas/campos/{id}");
        if (resp.IsSuccessStatusCode) { _dirty = true; await Recargar(); }
    }

    private async Task GuardarConfig()
    {
        if (Zona is null) return;
        _busy = true; _msg = "";
        try
        {
            var req = new GuardarZonaFichaRequest(_imagenUrl, _mantTipo, _mantContrato, _mantFrec, _mantDia, _reservable, _aforo);
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/zonas/{Zona.Id}/ficha", req);
            if (!resp.IsSuccessStatusCode) { _msg = "Error: " + await resp.Content.ReadAsStringAsync(); return; }

            // Horarios (solo si reservable y el editor esta montado)
            if (_reservable && _horariosEditor is not null)
            {
                var ventanas = _horariosEditor.Snapshot();
                var vreq = new GuardarVentanasRequest(TipoEntidadDisponibilidad.ZonaComun, Zona.Id, ventanas);
                await Auth().PutAsJsonAsync("/api/mi-copropiedad/disponibilidad", vreq);
            }
            _dirty = true;
            _msg = "Cambios guardados.";
            await Recargar();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private void IniciarEdicion()
    {
        if (_ficha is null) return;
        var z = _ficha.Zona;
        _form.Nombre = z.Nombre;
        _form.Categoria = z.Categoria;
        _form.Estado = z.Estado;
        _form.Descripcion = z.Descripcion;
        _form.TarifaReserva = z.TarifaReserva;
        _form.ReglasUso = z.ReglasUso;
        _msg = "";
        _tab = "editar";
    }

    private async Task GuardarDatosAsync()
    {
        if (Zona is null) return;
        if (string.IsNullOrWhiteSpace(_form.Nombre)) { _msg = "El nombre es obligatorio."; return; }
        _busy = true; _msg = "";
        try
        {
            var req = new ActualizarZonaComunRequest(
                _form.Nombre.Trim(), _form.Categoria,
                string.IsNullOrWhiteSpace(_form.Descripcion) ? null : _form.Descripcion.Trim(),
                _form.TarifaReserva,
                string.IsNullOrWhiteSpace(_form.ReglasUso) ? null : _form.ReglasUso.Trim(),
                _form.Estado);
            var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/zonas/{Zona.Id}", req);
            if (!resp.IsSuccessStatusCode) { _msg = "Error: " + await resp.Content.ReadAsStringAsync(); return; }
            _dirty = true;
            await Recargar();
            _tab = "ficha";
            _msg = "Datos guardados.";
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private void Cerrar() => Close(_dirty);

    private sealed class ZonaDatosForm
    {
        public string Nombre = "";
        public CategoriaZonaComun Categoria;
        public EstadoZonaComunMantenimiento Estado;
        public string? Descripcion;
        public decimal? TarifaReserva;
        public string? ReglasUso;
    }

    private sealed class UrlResp { public string? url { get; set; } }
}
