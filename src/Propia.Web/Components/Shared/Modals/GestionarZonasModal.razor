@* GestionarZonasModal - sec 4 Zonas Comunes: creacion RAPIDA de una zona.
   Solo lo basico (nombre, categoria, capacidad si es social, reservable + tarifa).
   El detalle (imagen, horarios, mantenimiento, novedades) se hace en la ficha, que
   el padre abre automaticamente tras crear. La lista de zonas ya vive en la seccion 4. *@

@inherits ModalBase<ZonaComunDto?>
@using Propia.Web.Components.Shared.Modals
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums

@inject IHttpClientFactory HttpFactory

@* ====== HEADER ====== *@
<div class="gzn-header">
    <div class="gzn-header-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2"/>
            <path d="M2 17h20M8 21h8"/>
        </svg>
    </div>
    <div class="gzn-header-text">
        <div class="gzn-title">Nueva zona comun</div>
        <div class="gzn-subtitle">Salones, gimnasio, BBQ, parqueaderos, etc</div>
    </div>
    <button class="gzn-close" @onclick="Cerrar" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

@* ====== BODY ====== *@
<div class="gzn-body">
    <div class="gzn-form">
        <div class="gzn-form-hint">Registra lo basico. Al crear se abre la ficha donde configuras imagen, horarios, mantenimiento y novedades.</div>

        <label class="gzn-lbl">Nombre *</label>
        <input class="gzn-input gzn-block" @bind="_form.Nombre" @bind:event="oninput" placeholder="Ej. Salon social, Gimnasio, BBQ" />

        <label class="gzn-lbl">Categoria</label>
        <select class="gzn-input gzn-block" @bind="_form.Categoria">
            @foreach (var c in Enum.GetValues<CategoriaZonaComun>())
            {
                <option value="@c">@CategoriaLabel(c)</option>
            }
        </select>

        @if (_form.Categoria == CategoriaZonaComun.Social)
        {
            <label class="gzn-lbl">Capacidad (personas)</label>
            <input type="number" min="0" class="gzn-input gzn-block" @bind="_form.CapacidadPersonas" placeholder="Ej. 40" />
        }

        <div class="gzn-res-row">
            <label class="gzn-check">
                <input type="checkbox" @bind="_form.EsReservable" />
                <span>Es reservable</span>
            </label>
            @if (_form.EsReservable)
            {
                <input type="number" step="any" min="0" class="gzn-input" style="width:180px" @bind="_form.TarifaReserva" placeholder="Tarifa reserva ($)" />
            }
        </div>

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="gzn-msg gzn-msg--err">@_msg</div>
        }

        <div class="gzn-actions">
            <button class="gzn-btn-ghost" type="button" @onclick="Cerrar">Cancelar</button>
            <button class="gzn-btn-brand" type="button" @onclick="Crear" disabled="@(_busy || !FormValido)">
                @(_busy ? "Creando..." : "Crear y configurar")
            </button>
        </div>
    </div>
</div>

<style>
    .gzn-header {
        display: flex; align-items: center; gap: 13px;
        padding: 18px 24px; border-bottom: 1px solid var(--propia-border-divider); flex-shrink: 0;
    }
    .gzn-header-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: var(--propia-brand-soft, var(--propia-brand-soft));
        color: var(--propia-brand, var(--propia-brand));
        display: flex; align-items: center; justify-content: center;
    }
    .gzn-header-text { flex: 1; }
    .gzn-title { font-size: 16px; font-weight: 800; letter-spacing: -0.3px; color: var(--propia-text-h1); }
    .gzn-subtitle { font-size: 12.5px; color: var(--propia-text-muted); }
    .gzn-close {
        width: 34px; height: 34px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        color: var(--propia-text-muted); border: 1px solid var(--propia-border-card); background: var(--propia-bg-card); cursor: pointer;
    }
    .gzn-close:hover { background: var(--propia-bg-app); color: var(--propia-text-body); }

    /* max-height igual al de .gea-body: los dos modales de "agregar" se comportan igual. */
    .gzn-body { padding: 20px 24px; max-height: 70vh; overflow-y: auto; font-family: var(--propia-font-base, 'Lexend', sans-serif); }

    .gzn-form { display: flex; flex-direction: column; }
    .gzn-form-hint {
        font-size: 12px; color: var(--propia-text-muted); line-height: 1.45;
        background: var(--propia-brand-soft, var(--propia-brand-soft-2)); border: 1px solid var(--propia-brand-border, var(--propia-brand-border));
        border-radius: 10px; padding: 10px 12px; margin-bottom: 14px;
    }
    .gzn-lbl { font-size: 11.5px; color: var(--propia-text-muted); font-weight: 700; margin: 10px 0 5px; }
    .gzn-lbl:first-of-type { margin-top: 0; }
    .gzn-input {
        border: 1px solid var(--propia-border-card); border-radius: 9px;
        padding: 10px 12px; font-size: 13px; color: var(--propia-text-body);
        background: var(--propia-bg-card); outline: none; min-width: 0; font-family: inherit; box-sizing: border-box;
    }
    .gzn-input:focus { border-color: var(--propia-brand, var(--propia-brand)); }
    .gzn-block { width: 100%; }

    .gzn-res-row { display: flex; align-items: center; gap: 14px; margin-top: 16px; flex-wrap: wrap; }
    .gzn-check {
        display: flex; align-items: center; gap: 8px;
        font-size: 13px; color: var(--propia-text-body); font-weight: 600; cursor: pointer;
    }
    .gzn-check input[type="checkbox"] { width: 17px; height: 17px; accent-color: var(--propia-brand, var(--propia-brand)); }

    .gzn-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 22px; }
    .gzn-btn-brand {
        padding: 9px 18px; border-radius: 9px;
        background: var(--propia-brand, var(--propia-brand)); color: var(--propia-bg-card);
        font-size: 13px; font-weight: 700; border: 0; cursor: pointer;
        box-shadow: 0 4px 12px rgba(109,79,227,.30); white-space: nowrap;
    }
    .gzn-btn-brand:hover { background: var(--propia-brand-hover, var(--propia-brand-hover)); }
    .gzn-btn-brand:disabled { opacity: .5; cursor: not-allowed; box-shadow: none; }
    .gzn-btn-ghost {
        padding: 9px 16px; border-radius: 9px; border: 1px solid var(--propia-border-card);
        background: var(--propia-bg-card); font-size: 13px; font-weight: 600; color: var(--propia-text-secondary); cursor: pointer;
    }
    .gzn-btn-ghost:hover { border-color: var(--propia-text-faint); }

    .gzn-msg { margin-top: 14px; padding: 9px 12px; font-size: 12.5px; border-radius: 9px; border: 1px solid; }
    .gzn-msg--err { color: #B91C1C; background: #FEE2E2; border-color: #FECACA; }

    [data-bs-theme="dark"] .gzn-title { color: var(--propia-text-body); }
    [data-bs-theme="dark"] .gzn-input { background: var(--propia-bg-card-soft); border-color: var(--propia-border-card); color: var(--propia-text-body); }
    [data-bs-theme="dark"] .gzn-form-hint { background: #2A2050; border-color: #3A2F6A; color: #B8B0D8; }

    /* Movil (hasta 640px): full-width, tarifa e inputs full y botones apilados. */
    @@media (max-width: 640px) {
        .gzn-header { padding: 12px 14px; gap: 10px; }
        .gzn-header-text { flex: 1 1 auto; min-width: 0; }
        .gzn-title { font-size: 15px; }
        .gzn-body { padding: 16px 14px; flex: 1; min-height: 0; max-height: none; }
        .gzn-res-row { gap: 10px; }
        .gzn-res-row .gzn-input { width: 100% !important; }
        .gzn-actions { flex-direction: column-reverse; }
        .gzn-actions .gzn-btn-brand,
        .gzn-actions .gzn-btn-ghost { width: 100%; text-align: center; }
    }
</style>

@code {
    [Parameter] public string? Jwt { get; set; }

    private ZonaForm _form = new();
    private bool _busy;
    private string _msg = "";

    private class ZonaForm
    {
        public string Nombre { get; set; } = "";
        public CategoriaZonaComun Categoria { get; set; } = CategoriaZonaComun.Social;
        public bool EsReservable { get; set; }
        public decimal? TarifaReserva { get; set; }
        public int? CapacidadPersonas { get; set; }
    }

    private bool FormValido => !string.IsNullOrWhiteSpace(_form.Nombre);

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task Crear()
    {
        if (!FormValido) return;
        _busy = true; _msg = "";
        var req = new CrearZonaComunRequest(
            _form.Nombre.Trim(),
            _form.Categoria,
            null,                                                              // descripcion -> ficha
            _form.EsReservable,
            _form.EsReservable ? _form.TarifaReserva : null,
            _form.Categoria == CategoriaZonaComun.Social ? _form.CapacidadPersonas : null,
            null,                                                              // horarios -> disponibilidad en la ficha
            null);                                                             // reglas -> ficha
        var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/zonas", req);
        if (resp.IsSuccessStatusCode)
        {
            var creada = await resp.Content.ReadFromJsonAsync<ZonaComunDto>();
            Close(creada);
            return;
        }
        _msg = "Error: " + await resp.Content.ReadAsStringAsync();
        _busy = false;
    }

    private void Cerrar() => Close(null);

    private static string CategoriaLabel(CategoriaZonaComun c) => c switch
    {
        CategoriaZonaComun.Social => "Social",
        CategoriaZonaComun.Deportiva => "Deportiva",
        CategoriaZonaComun.Servicios => "Servicios",
        CategoriaZonaComun.Circulacion => "Circulacion",
        CategoriaZonaComun.Recreativa => "Recreativa",
        _ => "Otros"
    };
}
