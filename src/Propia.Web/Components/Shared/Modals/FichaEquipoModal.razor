@* Ficha tecnica completa de un equipo/activo - replica del modal grande del prototipo
   PROPIA.dc.html (activoDet, L.2277+). Layout 2 columnas:
   IZQUIERDA: fotos + datos + valor y depreciacion (vida util ajustable).
   DERECHA: facturas (compra + mejoras), contratos vinculados, activos vinculados,
            tareas asociadas, mantenimientos.
   Si el activo es reservable, un segundo tab muestra los horarios de disponibilidad. *@

@inherits ModalBase<bool>
@using Microsoft.AspNetCore.Components.Forms
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@inject IHttpClientFactory HttpFactory

@if (_ficha is null)
{
    <div class="fem-header">
        <div class="fem-header-text"><div class="fem-title">Cargando ficha...</div></div>
        <button class="fem-close" @onclick="@(() => Close(_dirty))" type="button"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="fem-body"><div class="fem-empty">Cargando...</div></div>
}
else
{
    var eq = _ficha.Equipo;
    var dep = _ficha.Depreciacion;

    <div class="fem-header">
        <div class="fem-header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h6M9 11h6M10 16h4"/></svg>
        </div>
        <div class="fem-header-text">
            <div class="fem-title">@eq.Nombre</div>
            <div class="fem-subtitle">
                @TipoTxt(eq.Tipo) · @eq.Categoria
                @(string.IsNullOrEmpty(eq.NumeroSerie) ? "" : $" · Serie {eq.NumeroSerie}")
                @(string.IsNullOrEmpty(eq.Ubicacion) ? "" : $" · {eq.Ubicacion}")
                @if (eq.Tipo == TipoElemento.Activo && eq.Cantidad > 1) { <text> · x@(eq.Cantidad)</text> }
            </div>
        </div>
        <span class="fem-estado fem-estado--@EstadoBadge(eq.Estado)">@EstadoTxt(eq.Estado)</span>
        <button class="fem-close" @onclick="@(() => Close(_dirty))" type="button" aria-label="Cerrar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
    </div>

    <div class="fem-tabs">
        @* Solo dos pestanas, como en zonas: los horarios se editan dentro de la ficha. *@
        <button class="fem-tab @(_tab == "ficha" ? "fem-tab--on" : "")" type="button" @onclick='() => _tab = "ficha"'>Ficha del activo</button>
        <button class="fem-tab @(_tab == "editar" ? "fem-tab--on" : "")" type="button" @onclick="IniciarEdicion">Editar datos</button>
    </div>

    @if (_tab == "ficha")
    {
        <div class="fem-grid">
            @* ===== IZQUIERDA ===== *@
            <div class="fem-left">
                @* Imagen: mismo tratamiento que el modal de zonas comunes (una imagen grande
                   + zona de carga). El backend sigue soportando varias fotos; aqui se muestra
                   la principal (la primera) y al cargar una nueva pasa a ser la principal. *@
                <div class="fem-sectlbl">IMAGEN DEL ACTIVO</div>
                @{ var fotoPrincipal = _ficha.Fotos.FirstOrDefault(); }
                @if (fotoPrincipal is not null)
                {
                    <div class="fem-img" style="background-image:url('@fotoPrincipal.Url')">
                        <button class="fem-img-del" type="button" title="Quitar imagen" @onclick="@(() => EliminarFotoAsync(fotoPrincipal.Id))">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        </button>
                    </div>
                    <label class="fem-img-change">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>Cambiar imagen
                        <InputFile OnChange="OnFotoSeleccionada" accept="image/png,image/jpeg,image/webp" hidden />
                    </label>
                }
                else
                {
                    <label class="fem-img-drop">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 17l-5-5-9 7"/></svg>
                        <span>Cargar imagen</span>
                        <InputFile OnChange="OnFotoSeleccionada" accept="image/png,image/jpeg,image/webp" hidden />
                    </label>
                }

                @* Reservable: se cambia aqui, en la ficha, junto a la imagen (igual que zonas).
                   Lee y persiste directo sobre el equipo (sin estado local que se desincronice). *@
                <div class="fem-resv">
                    <button class="fem-toggle @(eq.EsReservable ? "on" : "")" type="button" @onclick="ToggleReservableAsync" disabled="@_busy">
                        <span class="fem-toggle-track"><span class="fem-toggle-knob"></span></span>
                        @(eq.EsReservable ? "Reservable" : "No reservable")
                    </button>
                </div>

                @* Mantenimiento y horarios viven en esta columna, igual que en la ficha de
                   zonas comunes. Una sola entrada: el programador compartido, cuyas reglas
                   cuelgan de este activo y las materializa el job. *@
                <div class="fem-prog fem-sectlbl--sep">
                    <ProgramacionesPanel Jwt="@Jwt"
                                         ModuloOrigenCodigo="equipo"
                                         EntidadOrigenId="@EqId"
                                         OrigenReferencia="@($"Activo: {eq.Nombre}")"
                                         PrefillTitulo="@($"Mantenimiento: {eq.Nombre}")"
                                         Titulo="PROGRAMA DE MANTENIMIENTO" />
                </div>

                @if (eq.EsReservable)
                {
                    <div class="fem-sectlbl fem-sectlbl--sep">PRESTAMOS Y TRAZABILIDAD</div>
                    <PrestamosEquipoPanel Jwt="@Jwt" EquipoId="@EqId" />
                }

                @* Condiciones de uso: aparece cuando el activo es reservable, igual que en zonas
                   comunes. Redaccion a mano o generada con el Auxiliar Administrativo (IA). *@
                @if (eq.EsReservable)
                {
                    <div class="fem-sectlbl fem-sectlbl--sep">CONDICIONES DE USO</div>
                    <textarea class="fem-input fem-cond-ta" rows="4" @bind="_condiciones"
                              placeholder="Ej: El activo se presta por 24 horas. Prohibido sacarlo de la copropiedad. El usuario responde por danos o perdida."></textarea>
                    <input class="fem-input fem-cond-hint" @bind="_iaHint" @bind:event="oninput"
                           placeholder="Puntos clave para la IA (ej: deposito, 24h, no sacar del conjunto)" />
                    @if (_iaError is not null) { <div class="fem-cond-err">@_iaError</div> }
                    <div class="fem-cond-acts">
                        <button class="fem-ia-btn" type="button" @onclick="GenerarCondicionesAsync" disabled="@_iaBusy">
                            <i class="fi fi-rr-sparkles"></i> @(_iaBusy ? "Generando..." : "Generar con IA")
                        </button>
                        <button class="fem-btn-brand" type="button" @onclick="GuardarCondicionesAsync" disabled="@_busy">Guardar condiciones</button>
                    </div>
                }

                @if (eq.EsReservable)
                {
                    <div class="fem-sectlbl fem-sectlbl--sep">HORARIOS DE SERVICIO</div>
                    <DisponibilidadHorariosEditor @ref="_editor" Iniciales="_ventanasIniciales" />
                    <button class="fem-btn-brand fem-btn-block" type="button" @onclick="GuardarHorariosAsync" disabled="@_busy">Guardar horarios</button>
                }

                <div class="fem-sectlbl fem-sectlbl--sep">DATOS DEL ACTIVO</div>
                <div class="fem-datos">
                    <div class="fem-dato"><span>Ubicacion</span><b>@(string.IsNullOrEmpty(eq.Ubicacion) ? "—" : eq.Ubicacion)</b></div>
                    <div class="fem-dato"><span>Fecha de compra</span><b>@(eq.FechaAdquisicion?.ToString("dd MMM yyyy") ?? "—")</b></div>
                    <div class="fem-dato"><span>Proximo manten.</span><b>@ProximoMantenimiento()</b></div>
                    @* Los campos dinamicos se consultan aqui; se agregan y quitan en la
                       pestana "Editar datos" (misma UI que zonas comunes). *@
                    @foreach (var c in _ficha.CamposPersonalizados)
                    {
                        <div class="fem-dato fem-dato--custom">
                            <span>@c.Label</span>
                            <b>@(string.IsNullOrEmpty(c.Valor) ? "—" : c.Valor)</b>
                        </div>
                    }
                </div>

                <div class="fem-sectlbl">VALOR Y DEPRECIACION</div>
                <div class="fem-dep">
                    <div class="fem-dep-top">
                        <span>Valor en libros hoy</span>
                        <b>$ @dep.ValorEnLibros.ToString("N0")</b>
                    </div>
                    <div class="fem-bar"><div class="fem-bar-fill" style="width:@(dep.PctDepreciado)%"></div></div>
                    <div class="fem-dep-pct">@dep.PctDepreciado% depreciado · @dep.AniosUso de @dep.VidaUtilAnios anios de vida util</div>

                    <div class="fem-vida">
                        <div>
                            <div class="fem-vida-t">Vida util del activo</div>
                            <div class="fem-vida-s">Ajusta para recalcular la depreciacion</div>
                        </div>
                        <div class="fem-vida-step">
                            <button type="button" @onclick="@(() => AjustarVidaAsync(-1))" disabled="@_busy">−</button>
                            <span>@dep.VidaUtilAnios anios</span>
                            <button type="button" @onclick="@(() => AjustarVidaAsync(1))" disabled="@_busy">+</button>
                        </div>
                    </div>

                    <div class="fem-dep-rows">
                        <div><span>Costo de adquisicion</span><b>$ @dep.CostoAdquisicion.ToString("N0")</b></div>
                        <div><span>Mejoras capitalizadas</span><b class="fem-pos">+ $ @dep.MejorasCapitalizadas.ToString("N0")</b></div>
                        <div><span>Depreciacion anual</span><b>$ @dep.DepreciacionAnual.ToString("N0")</b></div>
                        <div><span>Depreciacion acumulada</span><b class="fem-neg">− $ @dep.DepreciacionAcumulada.ToString("N0")</b></div>
                    </div>
                </div>
            </div>

            @* ===== DERECHA: solo el muro =====
               Facturas, contratos, activos vinculados, tareas y mantenimientos viven en
               "Editar datos". Esta columna es exclusivamente el muro de novedades, igual
               que en la ficha de zonas comunes. *@
            <div class="fem-right">
                <MuroNovedadesPanel Jwt="@Jwt"
                                    EntidadTipo="TipoEntidadNovedad.EquipoActivo"
                                    EntidadId="@EqId"
                                    Titulo="NOVEDADES DEL ACTIVO"
                                    PlaceholderTitulo="Titulo (ej. Cambio de rodamientos)" />
            </div>
        </div>
    }
    else if (_tab == "editar")
    {
        <div class="fem-body">
            <div class="fem-section">Identificacion</div>
            <div class="fem-egrid">
                <div><label class="fem-lbl">Nombre</label><input class="fem-input" @bind="_form.Nombre" /></div>
                <div><label class="fem-lbl">Categoria</label>
                    <select class="fem-input" @bind="_form.Categoria">@foreach (var c in (CategoriaEquipo[])System.Enum.GetValues(typeof(CategoriaEquipo))) { <option value="@c">@c</option> }</select>
                </div>
                <div><label class="fem-lbl">Tipo</label>
                    <select class="fem-input" @bind="_form.Tipo">
                        <option value="@TipoElemento.Equipo">Equipo (unitario)</option>
                        <option value="@TipoElemento.Activo">Activo (agrupado)</option>
                    </select>
                </div>
                <div><label class="fem-lbl">Cantidad</label><input type="number" min="1" class="fem-input" @bind="_form.Cantidad" disabled="@(_form.Tipo == TipoElemento.Equipo)" /></div>
                <div><label class="fem-lbl">Marca</label><input class="fem-input" @bind="_form.Marca" /></div>
                <div><label class="fem-lbl">Modelo</label><input class="fem-input" @bind="_form.Modelo" /></div>
                <div><label class="fem-lbl">Numero de serie</label><input class="fem-input" @bind="_form.NumeroSerie" /></div>
                <div><label class="fem-lbl">Codigo de barra</label><input class="fem-input" @bind="_form.CodigoBarra" placeholder="Etiqueta de inventario del activo" /></div>
                <div><label class="fem-lbl">Ubicacion</label><input class="fem-input" @bind="_form.Ubicacion" placeholder="Ej. Cuarto tecnico nivel -1" /></div>
                @* "Es reservable" salio de aqui: se cambia en la ficha, junto a la imagen.
                   _form.EsReservable conserva el valor actual, asi que guardar no lo pisa. *@
            </div>

            <div class="fem-section">Vida util y costos</div>
            <div class="fem-egrid">
                <div><label class="fem-lbl">Vida util (anios)</label><input type="number" min="0" class="fem-input" @bind="_form.VidaUtilAnios" /></div>
                <div><label class="fem-lbl">Fecha de adquisicion</label><input type="date" class="fem-input" @bind="_form.FechaAdquisicion" /></div>
                <div><label class="fem-lbl">Fecha de instalacion</label><input type="date" class="fem-input" @bind="_form.FechaInstalacion" /></div>
                <div><label class="fem-lbl">Garantia hasta</label><input type="date" class="fem-input" @bind="_form.GarantiaHasta" /></div>
                <div><label class="fem-lbl">Valor de adquisicion</label><input type="number" min="0" step="0.01" class="fem-input" @bind="_form.ValorAdquisicion" /></div>
                <div><label class="fem-lbl">Proveedor</label><input class="fem-input" @bind="_form.Proveedor" /></div>
                <div><label class="fem-lbl">Numero de factura</label><input class="fem-input" @bind="_form.NumeroFactura" /></div>
                <div class="fem-col-2"><label class="fem-lbl">Observaciones</label><textarea class="fem-input" rows="2" @bind="_form.Observaciones"></textarea></div>
            </div>

            @* Campos dinamicos con la misma UI que zonas comunes (fila + alta inline).
               Se guardan al instante con su boton, no con "Guardar cambios". *@
            <div class="fem-section">Campos dinamicos</div>
            <div class="fem-campos">
                @foreach (var c in _ficha.CamposPersonalizados)
                {
                    var cid = c.Id;
                    <div class="fem-campo-row">
                        <div class="fem-campo-main"><div class="fem-campo-nom">@c.Label</div><div class="fem-campo-val">@c.Valor</div></div>
                        <button class="fem-mini-del" type="button" title="Quitar campo" @onclick="@(() => EliminarCampoAsync(cid))"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                    </div>
                }
                <div class="fem-campo-addrow">
                    <input class="fem-input" style="width:42%" @bind="_campoLabel" placeholder="Campo" />
                    <input class="fem-input fem-grow" @bind="_campoValor" placeholder="Valor" />
                    <button class="fem-add" type="button" @onclick="AgregarCampoAsync" disabled="@_busy"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg></button>
                </div>
            </div>

            @* Facturas: la de compra sale de los datos de arriba; las demas son mejoras
               capitalizadas, que suman al valor en libros. *@
            <div class="fem-section">Facturas</div>
            @if (!string.IsNullOrEmpty(eq.NumeroFactura) || dep.CostoAdquisicion > 0)
            {
                <div class="fem-doc">
                    <div class="fem-doc-icon fem-doc-icon--compra"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/></svg></div>
                    <div class="fem-doc-body">
                        <div class="fem-doc-name">@(string.IsNullOrEmpty(eq.NumeroFactura) ? "Factura de compra" : eq.NumeroFactura)</div>
                        <div class="fem-doc-meta">Factura de compra · $ @dep.CostoAdquisicion.ToString("N0") @(string.IsNullOrEmpty(eq.Proveedor) ? "" : $" · {eq.Proveedor}")</div>
                    </div>
                    <span class="fem-tag fem-tag--compra">COMPRA</span>
                </div>
            }
            @foreach (var m in _ficha.Mejoras)
            {
                var mid = m.Id;
                <div class="fem-doc">
                    <div class="fem-doc-icon fem-doc-icon--mejora"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/></svg></div>
                    <div class="fem-doc-body">
                        <div class="fem-doc-name">@m.Descripcion</div>
                        <div class="fem-doc-meta">Mejora · $ @m.Valor.ToString("N0") · @m.Fecha.ToString("dd MMM yyyy")</div>
                    </div>
                    <span class="fem-tag fem-tag--mejora">MEJORA</span>
                    <button class="fem-mini-del" type="button" title="Eliminar" @onclick="@(() => EliminarMejoraAsync(mid))"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
                </div>
            }
            <div class="fem-mejora-form">
                <input class="fem-input fem-grow" @bind="_mejoraDesc" placeholder="Mejora (ej. Cambio de motor)" />
                <input type="number" min="0" class="fem-input fem-mini" @bind="_mejoraValor" placeholder="Valor" />
                <button class="fem-btn-brand" type="button" @onclick="AgregarMejoraAsync" disabled="@_busy">Anadir factura</button>
            </div>

            @* Contratos: antes se listaban TODOS los del modulo de Servicios, que en una
               copropiedad real son decenas. Ahora se buscan y se agregan de a uno. *@
            <div class="fem-section">Contratos vinculados</div>
            @foreach (var c in _ficha.ContratosVinculados)
            {
                var cid = c.Id;
                <div class="fem-link fem-link--on">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6D4FE3" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg>
                    <div class="fem-link-body"><div class="fem-link-name">@c.Nombre</div><div class="fem-link-meta">@c.Meta</div></div>
                    <button type="button" class="fem-mini-del" title="Quitar" @onclick="@(() => ToggleContratoAsync(cid, false))"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                </div>
            }
            @if (_ficha.ContratosVinculados.Count == 0)
            {
                <div class="fem-mini-empty">Este activo no tiene contratos vinculados.</div>
            }

            @{ var encontrados = ContratosFiltrados().ToList(); }
            @if (_ficha.ContratosDisponibles.Count == 0)
            {
                <div class="fem-mini-empty" style="margin-top:8px">No hay mas contratos disponibles en Servicios.</div>
            }
            else
            {
                @* Sin value= a proposito: en Blazor Server reafirmarlo en cada re-render
                   se come pulsaciones mientras se escribe. *@
                <input class="fem-input fem-buscar" placeholder="Buscar contrato por nombre..."
                       @oninput="@(e => _buscarContrato = e.Value?.ToString() ?? string.Empty)" />
                @if (encontrados.Count == 0)
                {
                    <div class="fem-mini-empty">Ningun contrato coincide con "@_buscarContrato".</div>
                }
                else
                {
                    <div class="fem-picklist">
                        @foreach (var c in encontrados)
                        {
                            var cid = c.Id;
                            <button type="button" class="fem-pick" @onclick="@(() => ToggleContratoAsync(cid, true))" disabled="@_busy">
                                <span>@c.Nombre</span>
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                            </button>
                        }
                    </div>
                    @if (_contratosOcultos > 0)
                    {
                        <div class="fem-mini-empty">y @_contratosOcultos mas. Escribe para filtrar.</div>
                    }
                }
            }

            @* Vinculos y consultas del activo. Viven aqui y no en la ficha porque esa
               columna quedo dedicada al muro de novedades. *@
            <div class="fem-section">Activos vinculados</div>
            <div class="fem-block">
                @foreach (var v in _ficha.ActivosVinculados)
                {
                    var vid = v.Id;
                    <div class="fem-link">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#516F90" stroke-width="2"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
                        <div class="fem-link-body"><div class="fem-link-name">@v.Nombre</div></div>
                        <button type="button" class="fem-mini-del" title="Quitar" @onclick="@(() => ToggleActivoAsync(vid, false))"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
                    </div>
                }
                <div class="fem-disp-lbl">OTROS ACTIVOS</div>
                @foreach (var v in _ficha.ActivosDisponibles)
                {
                    var vid = v.Id;
                    <button type="button" class="fem-pick" @onclick="@(() => ToggleActivoAsync(vid, true))">
                        <span>@v.Nombre</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                    </button>
                }
                @if (_ficha.ActivosDisponibles.Count == 0 && _ficha.ActivosVinculados.Count == 0)
                {
                    <div class="fem-mini-empty">No hay otros activos registrados.</div>
                }
            </div>

            @* TAREAS ASOCIADAS *@
            <div class="fem-section">Tareas asociadas</div>
            <div class="fem-block">
                @if (_ficha.Tareas.Count == 0)
                {
                    <div class="fem-mini-empty">Sin tareas asociadas. Las intervenciones de mantenimiento generan tareas en 2.10.</div>
                }
                else
                {
                    @foreach (var t in _ficha.Tareas)
                    {
                        <div class="fem-tarea">
                            <div class="fem-tarea-body"><div class="fem-tarea-t">@t.Titulo</div><div class="fem-tarea-board">@t.Tablero</div></div>
                            <span class="fem-tarea-estado">@t.Estado</span>
                        </div>
                    }
                }
            </div>

            @* MANTENIMIENTOS *@
            <div class="fem-section">Mantenimientos</div>
            <div class="fem-block">
                @if (_ficha.Mantenimientos.Count == 0)
                {
                    <div class="fem-mini-empty">Sin mantenimientos registrados. Programalos desde el modulo 2.11 Mantenimiento.</div>
                }
                else
                {
                    @foreach (var m in _ficha.Mantenimientos)
                    {
                        <div class="fem-mant">
                            <span class="fem-mant-tipo">@m.Tipo</span>
                            <div class="fem-mant-body"><div class="fem-mant-t">@m.Titulo</div></div>
                            <span class="fem-mant-fecha">@(m.Fecha?.ToString("dd MMM yyyy") ?? "")</span>
                            <span class="fem-mant-estado">@m.Estado</span>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="fem-footer">
            <button class="fem-btn-ghost" type="button" @onclick="@(() => _tab = "ficha")">Cancelar</button>
            <button class="fem-btn-brand" type="button" @onclick="GuardarDatosAsync" disabled="@_busy">Guardar cambios</button>
        </div>
    }
}

@if (!string.IsNullOrEmpty(_msg))
