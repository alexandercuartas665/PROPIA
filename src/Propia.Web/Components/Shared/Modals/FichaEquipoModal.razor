    private string ProximoMantenimiento()
    {
        var prox = _ficha?.Mantenimientos
            .Where(m => m.Fecha.HasValue && m.Estado != "Cerrada" && m.Estado != "Cancelada")
            .OrderBy(m => m.Fecha).FirstOrDefault();
        return prox?.Fecha?.ToString("dd MMM yyyy") ?? "Sin programar";
    }

    private void Toast(string m, bool err) { _msg = m; _msgError = err; StateHasChanged(); }

    private static string TipoTxt(TipoElemento t) => t == TipoElemento.Activo ? "Activo" : "Equipo";
    private static string EstadoTxt(EstadoEquipoActivo s) => s switch
    {
        EstadoEquipoActivo.Operativo => "Operativo",
        EstadoEquipoActivo.EnMantenimiento => "En mantenimiento",
        EstadoEquipoActivo.FueraDeServicio => "Fuera de servicio",
        _ => s.ToString()
    };
    private static string EstadoBadge(EstadoEquipoActivo s) => s switch
    {
        EstadoEquipoActivo.Operativo => "ok",
        EstadoEquipoActivo.EnMantenimiento => "mant",
        EstadoEquipoActivo.FueraDeServicio => "fuera",
        _ => "ok"
    };

    private class FormState
    {
        public string Nombre { get; set; } = "";
        public CategoriaEquipo Categoria { get; set; }
        public TipoElemento Tipo { get; set; }
        public int Cantidad { get; set; } = 1;
        public bool EsReservable { get; set; }
        public string? Marca { get; set; }
        public string? Modelo { get; set; }
        public string? NumeroSerie { get; set; }
        public string? CodigoBarra { get; set; }
        public string? CondicionesUso { get; set; }
        public DateOnly? FechaInstalacion { get; set; }
        public DateOnly? GarantiaHasta { get; set; }
        public string? Ubicacion { get; set; }
        public string? Observaciones { get; set; }
        public int? VidaUtilAnios { get; set; }
        public DateOnly? FechaAdquisicion { get; set; }
        public decimal? ValorAdquisicion { get; set; }
        public string? Proveedor { get; set; }
        public string? NumeroFactura { get; set; }

        public static FormState From(EquipoActivoDto e) => new()
        {
            Nombre = e.Nombre, Categoria = e.Categoria, Tipo = e.Tipo, Cantidad = e.Cantidad, EsReservable = e.EsReservable,
            Marca = e.Marca, Modelo = e.Modelo, NumeroSerie = e.NumeroSerie, CodigoBarra = e.CodigoBarra, CondicionesUso = e.CondicionesUso, FechaInstalacion = e.FechaInstalacion, GarantiaHasta = e.GarantiaHasta,
            Ubicacion = e.Ubicacion, Observaciones = e.Observaciones,
            VidaUtilAnios = e.VidaUtilAnios, FechaAdquisicion = e.FechaAdquisicion, ValorAdquisicion = e.ValorAdquisicion,
            Proveedor = e.Proveedor, NumeroFactura = e.NumeroFactura
        };

        public ActualizarEquipoActivoRequest ToRequest() => new(
            Nombre, Categoria, Tipo, Tipo == TipoElemento.Activo ? Math.Max(1, Cantidad) : 1, EsReservable,
            Modelo, NumeroSerie, FechaInstalacion, GarantiaHasta, Ubicacion, Observaciones,
            VidaUtilAnios, FechaAdquisicion, ValorAdquisicion, Proveedor, NumeroFactura, CodigoBarra, CondicionesUso);
    }
