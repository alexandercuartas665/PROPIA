    // Guarda las condiciones de uso reenviando la ficha completa del activo (mismo patron que el
    // toggle de reservable): se conservan todos los campos y solo cambia CondicionesUso.
    private async Task GuardarCondicionesAsync()
    {
        if (_ficha is null) return;
        _busy = true;
        try
        {
            var e = _ficha.Equipo;
            var req = new ActualizarEquipoActivoRequest(e.Nombre, e.Categoria, e.Tipo, e.Cantidad, e.EsReservable,
                e.Modelo, e.NumeroSerie, e.FechaInstalacion, e.GarantiaHasta, e.Ubicacion, e.Observaciones,
                _ficha.Depreciacion.VidaUtilAnios, e.FechaAdquisicion, e.ValorAdquisicion, e.Proveedor, e.NumeroFactura, e.CodigoBarra,
                string.IsNullOrWhiteSpace(_condiciones) ? null : _condiciones.Trim());
            var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{EqId}", req);
            if (r.IsSuccessStatusCode) { _dirty = true; await CargarAsync(); Toast("Condiciones guardadas.", false); }
            else Toast("No se pudieron guardar las condiciones.", true);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

    // Genera las condiciones de uso con el Auxiliar Administrativo (IA) a partir de puntos clave + contexto.
    private async Task GenerarCondicionesAsync()
    {
        if (_ficha is null) return;
        _iaBusy = true; _iaError = null;
        try
        {
            var eq = _ficha.Equipo;
            var ctx = $"Activo: {eq.Nombre}. Categoria: {eq.Categoria}. Tipo: {eq.Tipo}."
                    + (string.IsNullOrWhiteSpace(eq.Ubicacion) ? "" : $" Ubicacion: {eq.Ubicacion}.");
            var body = new
            {
                proposito = "Condiciones de uso de un activo/equipo de una copropiedad que se presta a los residentes: reglas sobre horario de prestamo, cuidado, prohibiciones y responsabilidad por danos o perdida.",
                contexto = ctx,
                puntosClave = string.IsNullOrWhiteSpace(_iaHint) ? null : _iaHint.Trim(),
                maxPalabras = 120
            };
            var resp = await Auth().PostAsJsonAsync("/api/ia/completar-campo", body);
            if (!resp.IsSuccessStatusCode) { _iaError = "No se pudo generar (" + (int)resp.StatusCode + ")."; return; }
            var r = await resp.Content.ReadFromJsonAsync<AsistenteCampoResp>();
            if (r is { Ok: true } && !string.IsNullOrWhiteSpace(r.Texto)) _condiciones = r.Texto;
            else _iaError = r?.Error ?? "El asistente de IA no esta disponible.";
        }
        catch (Exception ex) { _iaError = ex.Message; }
        finally { _iaBusy = false; }
    }

    private sealed record AsistenteCampoResp(bool Ok, string? Texto, string? Error);

    private async Task AjustarVidaAsync(int delta)
    {
        if (_ficha is null) return;
        var nueva = Math.Max(0, _ficha.Depreciacion.VidaUtilAnios + delta);
        _busy = true;
        try
        {
            var e = _ficha.Equipo;
            var req = new ActualizarEquipoActivoRequest(e.Nombre, e.Categoria, e.Tipo, e.Cantidad, e.EsReservable,
                e.Modelo, e.NumeroSerie, e.FechaInstalacion, e.GarantiaHasta, e.Ubicacion, e.Observaciones,
                nueva, e.FechaAdquisicion, e.ValorAdquisicion, e.Proveedor, e.NumeroFactura, e.CodigoBarra, e.CondicionesUso);
            var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{EqId}", req);
            if (r.IsSuccessStatusCode) { _dirty = true; await CargarAsync(); }
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

