@* Ficha tecnica completa de un equipo/activo: identificacion, ubicacion, garantia,
   vida util, adquisicion y, si EsReservable, horarios de disponibilidad
   (DisponibilidadHorariosEditor reutilizable). *@

@inherits ModalBase<bool>
@using Propia.Application.MiCopropiedad
@using Propia.Domain.Enums
@using Propia.Web.Components.Shared
@inject IHttpClientFactory HttpFactory

<div class="fem-header">
    <div class="fem-header-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h6M9 11h6M10 16h4"/></svg>
    </div>
    <div class="fem-header-text">
        <div class="fem-title">@_form.Nombre</div>
        <div class="fem-subtitle">@_form.Tipo · @_form.Categoria @(_form.EsReservable ? " · Reservable" : "")</div>
    </div>
    <button class="fem-close" @onclick="@(() => Close(_dirty))" type="button" aria-label="Cerrar">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
</div>

<div class="fem-tabs">
    <button class="fem-tab @(_tab == "ficha" ? "fem-tab--on" : "")" type="button" @onclick='() => _tab = "ficha"'>Ficha tecnica</button>
    @if (_form.EsReservable)
    {
        <button class="fem-tab @(_tab == "horarios" ? "fem-tab--on" : "")" type="button" @onclick='() => _tab = "horarios"'>Horarios disponibilidad</button>
    }
</div>

<div class="fem-body">
    @if (_tab == "ficha")
    {
        <div class="fem-section">Identificacion</div>
        <div class="fem-grid2">
            <div>
                <label class="fem-lbl">Nombre</label>
                <input class="fem-input" @bind="_form.Nombre" />
            </div>
            <div>
                <label class="fem-lbl">Categoria</label>
                <select class="fem-input" @bind="_form.Categoria">
                    @foreach (var c in (CategoriaEquipo[])System.Enum.GetValues(typeof(CategoriaEquipo))) { <option value="@c">@c</option> }
                </select>
            </div>
            <div>
                <label class="fem-lbl">Tipo</label>
                <select class="fem-input" @bind="_form.Tipo">
                    <option value="@TipoElemento.Equipo">Equipo (unitario)</option>
                    <option value="@TipoElemento.Activo">Activo (agrupado)</option>
                </select>
            </div>
            <div>
                <label class="fem-lbl">Cantidad</label>
                <input type="number" min="1" class="fem-input" @bind="_form.Cantidad" disabled="@(_form.Tipo == TipoElemento.Equipo)" />
            </div>
            <div>
                <label class="fem-lbl">Modelo</label>
                <input class="fem-input" @bind="_form.Modelo" />
            </div>
            <div>
                <label class="fem-lbl">Numero de serie</label>
                <input class="fem-input" @bind="_form.NumeroSerie" />
            </div>
            <div class="fem-col-span-2">
                <label class="fem-check">
                    <input type="checkbox" @bind="_form.EsReservable" />
                    <span>Es reservable (zonas comunes, gimnasio, salones)</span>
                </label>
            </div>
        </div>

        <div class="fem-section">Vida util y costos</div>
        <div class="fem-grid2">
            <div>
                <label class="fem-lbl">Vida util (anios)</label>
                <input type="number" min="0" class="fem-input" @bind="_form.VidaUtilAnios" />
            </div>
            <div>
                <label class="fem-lbl">Fecha de adquisicion</label>
                <input type="date" class="fem-input" @bind="_form.FechaAdquisicion" />
            </div>
            <div>
                <label class="fem-lbl">Fecha de instalacion</label>
                <input type="date" class="fem-input" @bind="_form.FechaInstalacion" />
            </div>
            <div>
                <label class="fem-lbl">Garantia hasta</label>
                <input type="date" class="fem-input" @bind="_form.GarantiaHasta" />
            </div>
            <div>
                <label class="fem-lbl">Valor de adquisicion</label>
                <input type="number" min="0" step="0.01" class="fem-input" @bind="_form.ValorAdquisicion" />
            </div>
            <div>
                <label class="fem-lbl">Ubicacion</label>
                <input class="fem-input" @bind="_form.Ubicacion" placeholder="Ej. Cuarto tecnico nivel -1" />
            </div>
            <div>
                <label class="fem-lbl">Proveedor</label>
                <input class="fem-input" @bind="_form.Proveedor" />
            </div>
            <div>
                <label class="fem-lbl">Numero de factura</label>
                <input class="fem-input" @bind="_form.NumeroFactura" />
            </div>
            <div class="fem-col-span-2">
                <label class="fem-lbl">Observaciones</label>
                <textarea class="fem-input" rows="2" @bind="_form.Observaciones"></textarea>
            </div>
        </div>
    }
    else if (_tab == "horarios")
    {
        <DisponibilidadHorariosEditor @ref="_editor" Iniciales="_ventanasIniciales" />
    }
</div>

<div class="fem-footer">
    <button class="fem-btn-ghost" type="button" @onclick="@(() => Close(_dirty))">Cancelar</button>
    <button class="fem-btn-brand" type="button" @onclick="GuardarAsync" disabled="@_busy">
        @(_busy ? "Guardando..." : "Guardar cambios")
    </button>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="fem-toast @(_msgError ? "fem-toast--err" : "fem-toast--ok")">@_msg</div>
}

<style>
    .fem-header { display: flex; align-items: center; gap: 12px; padding: 16px 22px; border-bottom: 1px solid #EEF3F8; }
    .fem-header-icon { width: 36px; height: 36px; border-radius: 10px; background: #F1ECFD; color: #6D4FE3; display: flex; align-items: center; justify-content: center; }
    .fem-header-text { flex: 1; }
    .fem-title { font-size: 15px; font-weight: 800; color: #1B2A3A; }
    .fem-subtitle { font-size: 12px; color: #7C98B6; margin-top: 1px; }
    .fem-close { background: transparent; border: 1px solid #E1E8EE; width: 32px; height: 32px; border-radius: 8px; color: #7C98B6; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }

    .fem-tabs { display: flex; gap: 2px; padding: 0 22px; border-bottom: 1px solid #EEF3F8; }
    .fem-tab { background: transparent; border: 0; padding: 11px 14px; font-size: 13px; font-weight: 700; color: #7C98B6; cursor: pointer; border-bottom: 2px solid transparent; font-family: inherit; }
    .fem-tab--on { color: var(--propia-brand, #6D4FE3); border-bottom-color: var(--propia-brand, #6D4FE3); }

    .fem-body { padding: 16px 22px; max-height: 60vh; overflow-y: auto; }
    .fem-section { font-size: 11.5px; text-transform: uppercase; letter-spacing: .4px; color: var(--propia-brand, #6D4FE3); font-weight: 800; margin: 12px 0 6px; }
    .fem-section:first-child { margin-top: 0; }
    .fem-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; }
    .fem-col-span-2 { grid-column: 1 / -1; }
    .fem-lbl { display: block; font-size: 11.5px; font-weight: 700; color: #7C98B6; margin-bottom: 3px; }
    .fem-input { width: 100%; border: 1px solid #E1E8EE; border-radius: 8px; padding: 8px 10px; font-size: 13px; color: #33475B; outline: none; font-family: inherit; background: #fff; }
    .fem-input:focus { border-color: var(--propia-brand, #6D4FE3); }
    .fem-input:disabled { background: #F8FAFC; color: #A6B7C8; }
    .fem-check { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: #33475B; cursor: pointer; }
    .fem-check input { accent-color: var(--propia-brand, #6D4FE3); }

    .fem-footer { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 22px; border-top: 1px solid #EEF3F8; }
    .fem-btn-ghost { padding: 9px 16px; border-radius: 8px; border: 1px solid #E1E8EE; background: #fff; font-size: 13px; font-weight: 700; color: #516F90; cursor: pointer; font-family: inherit; }
    .fem-btn-brand { padding: 9px 16px; border-radius: 8px; border: 0; background: var(--propia-brand, #6D4FE3); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; box-shadow: 0 4px 12px rgba(109,79,227,.25); }
    .fem-btn-brand:disabled { opacity: .55; cursor: not-allowed; }

    .fem-toast { position: fixed; bottom: 24px; right: 28px; padding: 11px 16px; border-radius: 9px; font-size: 12.5px; font-weight: 700; box-shadow: 0 8px 24px rgba(45,62,80,.18); z-index: 1500; }
    .fem-toast--ok { background: #1A8754; color: #fff; }
    .fem-toast--err { background: #DC2626; color: #fff; }
</style>

@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public EquipoActivoDto? Equipo { get; set; }

    private string _tab = "ficha";
    private bool _busy;
    private bool _dirty;
    private string? _msg;
    private bool _msgError;
    private DisponibilidadHorariosEditor? _editor;
    private FormState _form = new();
    private List<VentanaDisponibilidadDto>? _ventanasIniciales;

    protected override async Task OnInitializedAsync()
    {
        if (Equipo is null) return;
        _form = FormState.From(Equipo);
        if (Equipo.EsReservable)
        {
            try { _ventanasIniciales = await Auth().GetFromJsonAsync<List<VentanaDisponibilidadDto>>($"/api/mi-copropiedad/disponibilidad?tipo=EquipoActivo&entidadId={Equipo.Id}"); }
            catch { _ventanasIniciales = new(); }
        }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task GuardarAsync()
    {
        if (Equipo is null) return;
        _busy = true;
        try
        {
            var req = _form.ToRequest();
            var r = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{Equipo.Id}", req);
            if (!r.IsSuccessStatusCode) { Toast($"Error al guardar ficha: {(int)r.StatusCode}", true); _busy = false; return; }
            _dirty = true;

            if (_form.EsReservable && _editor is not null)
            {
                var ventanas = _editor.Snapshot();
                var vreq = new GuardarVentanasRequest(TipoEntidadDisponibilidad.EquipoActivo, Equipo.Id, ventanas);
                var r2 = await Auth().PutAsJsonAsync("/api/mi-copropiedad/disponibilidad", vreq);
                if (!r2.IsSuccessStatusCode) { Toast("Ficha guardada, pero hubo error en horarios.", true); _busy = false; return; }
            }
            Toast("Cambios guardados.", false);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

    private void Toast(string m, bool err) { _msg = m; _msgError = err; }

    private class FormState
    {
        public string Nombre { get; set; } = "";
        public CategoriaEquipo Categoria { get; set; }
        public TipoElemento Tipo { get; set; }
        public int Cantidad { get; set; } = 1;
        public bool EsReservable { get; set; }
        public string? Modelo { get; set; }
        public string? NumeroSerie { get; set; }
        public DateOnly? FechaInstalacion { get; set; }
        public DateOnly? GarantiaHasta { get; set; }
        public string? Ubicacion { get; set; }
        public string? Observaciones { get; set; }
        public int? VidaUtilAnios { get; set; }
        public DateOnly? FechaAdquisicion { get; set; }
        public decimal? ValorAdquisicion { get; set; }
        public string? Proveedor { get; set; }
        public string? NumeroFactura { get; set; }

        public static FormState From(EquipoActivoDto e) => new()
        {
            Nombre = e.Nombre, Categoria = e.Categoria, Tipo = e.Tipo, Cantidad = e.Cantidad, EsReservable = e.EsReservable,
            Modelo = e.Modelo, NumeroSerie = e.NumeroSerie, FechaInstalacion = e.FechaInstalacion, GarantiaHasta = e.GarantiaHasta,
            Ubicacion = e.Ubicacion, Observaciones = e.Observaciones,
            VidaUtilAnios = e.VidaUtilAnios, FechaAdquisicion = e.FechaAdquisicion, ValorAdquisicion = e.ValorAdquisicion,
            Proveedor = e.Proveedor, NumeroFactura = e.NumeroFactura
        };

        public ActualizarEquipoActivoRequest ToRequest() => new(
            Nombre, Categoria, Tipo, Cantidad, EsReservable,
            Modelo, NumeroSerie, FechaInstalacion, GarantiaHasta,
            Ubicacion, Observaciones,
            VidaUtilAnios, FechaAdquisicion, ValorAdquisicion,
            Proveedor, NumeroFactura);
    }
}
