@code {
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public EquipoActivoDto? Equipo { get; set; }

    private string _tab = "ficha";
    private bool _busy;
    private bool _dirty;
    private string? _msg;
    private bool _msgError;
    private EquipoFichaDto? _ficha;
    private DisponibilidadHorariosEditor? _editor;
    private List<VentanaDisponibilidadDto>? _ventanasIniciales;

    private string _mejoraDesc = "";
    private decimal? _mejoraValor;

    private string _campoLabel = "";
    private string _campoValor = "";

    private string _buscarContrato = "";
    private int _contratosOcultos;

    /// <summary>
    /// Contratos que se pueden vincular, filtrados por el texto de busqueda y recortados a
    /// unos pocos: en una copropiedad real la lista completa son decenas y llenaba la ficha.
    /// </summary>
    private IEnumerable<EquipoRefDto> ContratosFiltrados()
    {
        const int tope = 8;
        var todos = _ficha?.ContratosDisponibles ?? (IReadOnlyList<EquipoRefDto>)Array.Empty<EquipoRefDto>();
        var filtrados = string.IsNullOrWhiteSpace(_buscarContrato)
            ? todos
            : todos.Where(c => c.Nombre.Contains(_buscarContrato.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        _contratosOcultos = Math.Max(0, filtrados.Count - tope);
        return filtrados.Take(tope);
    }

    private FormState _form = new();

    // Condiciones de uso (solo activos reservables): texto + generacion con IA.
    private string? _condiciones;
    private string _iaHint = "";
    private bool _iaBusy;
    private string? _iaError;

    private Guid EqId => Equipo?.Id ?? Guid.Empty;

    // Cuando se abre recien creado (ojito), arranca en "Editar datos" para completar y guardar.
    [Parameter] public bool AbrirEnEdicion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        if (AbrirEnEdicion && _ficha is not null) { IniciarEdicion(); }
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    private async Task CargarAsync()
    {
        try
        {
            _ficha = await Auth().GetFromJsonAsync<EquipoFichaDto>($"/api/mi-copropiedad/equipos/{EqId}/ficha");
            if (_ficha is not null) _condiciones = _ficha.Equipo.CondicionesUso;
            if (_ficha is not null && _ficha.Equipo.EsReservable && _ventanasIniciales is null)
            {
                try { _ventanasIniciales = await Auth().GetFromJsonAsync<List<VentanaDisponibilidadDto>>($"/api/mi-copropiedad/disponibilidad?tipo=EquipoActivo&entidadId={EqId}"); }
                catch { _ventanasIniciales = new(); }
            }
        }
        catch (Exception ex) { Toast(ex.Message, true); }
    }

