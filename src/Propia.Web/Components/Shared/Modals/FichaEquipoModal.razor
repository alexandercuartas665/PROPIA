    private async Task OnFotoSeleccionada(InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (f is null) return;
        if (f.Size > 5_000_000) { Toast("Maximo 5 MB.", true); return; }
        _busy = true;
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(f.OpenReadStream(5_000_000));
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(f.ContentType) ? "image/jpeg" : f.ContentType);
            content.Add(sc, "file", f.Name);
            var r = await Auth().PostAsync($"/api/mi-copropiedad/equipos/{EqId}/fotos", content);
            if (r.IsSuccessStatusCode) { _dirty = true; await CargarAsync(); Toast("Foto agregada.", false); }
            else Toast($"Error al subir foto: {(int)r.StatusCode}", true);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        _busy = false;
    }

