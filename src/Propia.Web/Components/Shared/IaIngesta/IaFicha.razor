@* Miniatura del documento en su tarjeta: mientras la IA lo lee lleva el barrido (.iai-fic-scan). Se repinta SOLA
   (suscrita a IaLectura.Cambio), igual que IaRail. Css = las clases propias del modulo (srv-dr-fic / seg-dr-fic). *@
@implements IDisposable

<div class="@Css @(Lectura?.Estado == IaEstado.Leyendo ? "iai-fic-scan" : "")">@ChildContent</div>

@code {
    [Parameter] public IaLectura? Lectura { get; set; }
    [Parameter] public string Css { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private IaLectura? _sub;
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_sub, Lectura)) return;
        if (_sub is not null) _sub.Cambio -= OnCambio;
        _sub = Lectura;
        if (_sub is not null) _sub.Cambio += OnCambio;
    }
    private void OnCambio() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { if (_sub is not null) _sub.Cambio -= OnCambio; }
}
