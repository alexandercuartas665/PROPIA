@* Zona de carga de PDF para la IA (replica: RP.iaIngesta.dropHtml). Horizontal y compacta (~84px): icono que flota,
   "Arrastra <que> aqui o toca para elegirlos" + que llena la IA, y la pildora "PDF · max. 20" (oculta en celular).
   Compacto = ya hay documentos ("Agregar mas PDF") o edicion ("Actualizar desde un PDF"). El input lleva
   data-iai-input: el velo de propiaIai.wireDrop le pasa los archivos que se sueltan en cualquier parte del modal. *@
@using Microsoft.AspNetCore.Components.Forms

@if (Compacto)
{
    <label class="iai-drop iai-drop--sm"><i class="fi fi-rr-cloud-upload"></i><span><b>@TituloCompacto</b> · @RestoCompacto</span>
        <InputFile OnChange="OnChange" accept=".pdf,image/*" multiple="@Multiple" data-iai-input="" />
    </label>
}
else
{
    <label class="iai-drop"><span class="iai-drop-ic"><i class="fi fi-rr-sparkles"></i></span><span class="iai-drop-txt"><span class="iai-drop-t"><b>Arrastra @Que aquí</b> o toca para elegirlos</span><span class="iai-drop-s">@Sub</span></span><span class="iai-drop-f">@Formato</span>
        <InputFile OnChange="OnChange" accept=".pdf,image/*" multiple="@Multiple" data-iai-input="" />
    </label>
}

@code {
    [Parameter] public bool Compacto { get; set; }
    [Parameter] public bool Multiple { get; set; } = true;
    /// <summary>"los contratos" | "las pólizas".</summary>
    [Parameter] public string Que { get; set; } = "los documentos";
    [Parameter] public string Sub { get; set; } = "La IA lee cada PDF y llena el formulario por ti. Puedes subir varios: cada uno queda como borrador para revisar.";
    [Parameter] public string TituloCompacto { get; set; } = "Agregar más PDF";
    [Parameter] public string RestoCompacto { get; set; } = "arrástralos aquí o toca para elegir";
    /// <summary>Pildora de formatos ("PDF · máx. 20"; recibos: "PDF o foto · máx. 20").</summary>
    [Parameter] public string Formato { get; set; } = "PDF · máx. 20";
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
}
