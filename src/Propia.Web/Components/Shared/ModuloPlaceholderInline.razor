@* Mini card que resume un modulo - usado en grid de Capa 0 info *@

<div>
    <div class="d-flex justify-content-between align-items-start mb-1">
        <code class="text-muted small">@Codigo</code>
        <span class="badge @BadgeClass">@Estado</span>
    </div>
    <div class="fw-semibold mb-0">@Nombre</div>
</div>

@code {
    [Parameter, EditorRequired] public string Codigo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Nombre { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Estado { get; set; } = string.Empty;

    private string BadgeClass => Estado switch
    {
        "MVP" => "bg-success",
        "En diseno" => "bg-secondary",
        "Futuro" => "bg-light text-dark border",
        _ => "bg-light text-dark"
    };
}
