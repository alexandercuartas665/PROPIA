@* ============================================================================================
   Editor FOCALIZADO de las OPCIONES de una lista del sistema POR COPROPIEDAD. Dos modos segun la lista:

   - LISTA LIBRE (MetaSchema == null): edita label / color / ocultar (reusa <OpcionesLista>), como en Ola 4b-2.
   - LISTA CON-LOGICA (MetaSchema != null, Ola 4c): ademas de label/color/ocultar, edita la METADATA DE NEGOCIO
     de cada opcion (p.ej. en que columna del tablero cae un tipo de visitante) con un input por campo del
     schema, y permite AGREGAR opciones propias con su Meta. El schema lo declara CatalogoListasRegistro.

   La copia vive por-tenant en lista_opciones; el resolver (IOpcionesEfectivas) la lee y este modal la escribe
   via /api/campos/opciones (guarda al cambiar). Autocontenido (gol-* + z-index alto) para abrirse DESDE otros
   modales. "Restablecer desde A&D" realinea bases no-overrideadas (visual y Meta) con el catalogo global.
   ============================================================================================ *@
@inject IHttpClientFactory HttpFactory
@using System.Text.Json
@using Propia.Application.Catalogos

<div class="gol-back" @onclick="Cerrar">
    <div class="gol-shell @(_schema is not null ? "gol-wide" : "")" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
        <div class="gol-head">
            <div class="gol-head-ic"><i class="fi fi-rr-list"></i></div>
            <div class="gol-head-tt">
                <div class="gol-head-h">Opciones de la lista</div>
                <div class="gol-head-s">@Titulo</div>
            </div>
            <button class="gol-x" type="button" @onclick="Cerrar" aria-label="Cerrar"><i class="fi fi-rr-cross-small"></i></button>
        </div>

        <div class="gol-body">
            @if (_cargando)
            {
                <div class="gol-hint">Cargando...</div>
            }
            else if (_schema is null)
            {
                @* ---- Lista libre (Ola 4b-2): label/color/ocultar ---- *@
                <div class="gol-fld">
                    <label>Opciones de esta copropiedad</label>
                    <OpcionesLista Opciones="_opcs" OpcionesChanged="GuardarLibreAsync"
                                   SemillaKeys="@_semillaKeys"
                                   PermitirAgregar="@PermiteAgregar" PermitirRenombrar="true"
                                   PermitirOcultar="@PermitirOcultar" PermitirQuitar="false" />
                    <span class="gol-hint">Renombrar, colorear u ocultar aplica solo a esta copropiedad. Las opciones base no se pueden quitar, solo ocultar.</span>
                </div>
            }
            else
            {
                @* ---- Lista con-logica (Ola 4c): label/ocultar + campos Meta por opcion ---- *@
                <div class="gol-fld">
                    <label>Opciones de esta copropiedad</label>
                    <div class="gol-mt">
                        <div class="gol-mt-hd">
                            <span class="gol-mt-c-lbl">Opción</span>
                            @foreach (var f in _schema)
                            {
                                <span class="gol-mt-c-meta" title="@f.Ayuda">@f.Label</span>
                            }
                            <span class="gol-mt-c-vis">Visible</span>
                        </div>
                        @foreach (var r in _rows)
                        {
                            <div class="gol-mt-row @(r.Oculta ? "is-off" : "")">
                                <span class="gol-mt-c-lbl">
                                    <input class="gol-in" value="@r.Label"
                                           @onchange="e => OnLabel(r, e.Value?.ToString())"
                                           placeholder="Nombre de la opción" />
                                    @if (!r.EsBase) { <span class="gol-tag">propia</span> }
                                </span>
                                @foreach (var f in _schema)
                                {
                                    <span class="gol-mt-c-meta">
                                        @switch (f.Tipo)
                                        {
                                            case CatalogoListasRegistro.MetaTipo.Seleccion:
                                                <select class="gol-in" value="@Val(r, f.Clave)"
                                                        @onchange="e => OnMeta(r, f.Clave, e.Value?.ToString())">
                                                    @foreach (var o in f.Opciones ?? new List<CatalogoListasRegistro.MetaOpcionDef>())
                                                    {
                                                        <option value="@o.Valor">@o.Label</option>
                                                    }
                                                </select>
                                                break;
                                            case CatalogoListasRegistro.MetaTipo.Bool:
                                                <input type="checkbox" class="gol-ck" checked="@IsOn(r, f.Clave)"
                                                       @onchange="e => OnMetaBool(r, f.Clave, (bool)e.Value!)" />
                                                break;
                                            default:
                                                <input type="number" class="gol-in gol-in-num" value="@Val(r, f.Clave)"
                                                       @onchange="e => OnMeta(r, f.Clave, e.Value?.ToString())" />
                                                break;
                                        }
                                    </span>
                                }
                                <span class="gol-mt-c-vis">
                                    <input type="checkbox" class="gol-ck" checked="@(!r.Oculta)"
                                           @onchange="e => OnVisible(r, (bool)e.Value!)"
                                           title="@(r.EsBase ? "Ocultar/mostrar (las base no se borran)" : "Ocultar/mostrar")" />
                                </span>
                            </div>
                        }
                    </div>
                    <button type="button" class="gol-btn-ghost gol-add" @onclick="AgregarFila" disabled="@_busy">
                        <i class="fi fi-rr-plus-small"></i> Agregar opción
                    </button>
                    <span class="gol-hint">Cada opción cae donde diga su metadata. Las opciones base no se borran, solo se ocultan; las propias aplican solo a esta copropiedad.</span>
                </div>
            }

            @if (!_cargando)
            {
                <div class="gol-adv">
                    <button type="button" class="gol-btn-ghost" @onclick="ReaplicarBasesAsync" disabled="@_busy"
                            title="Trae las opciones base desde el catalogo A&D, respetando lo que esta copropiedad edito">
                        <i class="fi fi-rr-refresh"></i> Restablecer desde A&D</button>
                </div>
                @if (!string.IsNullOrEmpty(_msg)) { <div class="gol-msg">@_msg</div> }
            }
        </div>

        <div class="gol-foot">
            <span class="gol-spacer"></span>
            <button type="button" class="gol-btn-brand" @onclick="Cerrar" disabled="@_busy">
                <i class="fi fi-rr-check"></i> Listo
            </button>
        </div>
    </div>
</div>

<style>
    .gol-back { position: fixed; inset: 0; background: rgba(20,28,45,.72); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; z-index: 4000; padding: 24px; }
    .gol-shell { width: 480px; max-width: 96vw; max-height: 94vh; background: var(--propia-bg-card); border-radius: var(--propia-radius-modal, 18px); box-shadow: var(--propia-shadow-modal); overflow: hidden; display: flex; flex-direction: column; font-family: var(--propia-font-base, inherit); }
    .gol-shell.gol-wide { width: 620px; }
    .gol-head { display: flex; align-items: center; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--propia-border-divider); }
    .gol-head-ic { width: 40px; height: 40px; flex-shrink: 0; border-radius: 11px; background: var(--propia-brand-soft); color: var(--propia-brand); display: flex; align-items: center; justify-content: center; font-size: 17px; }
    .gol-head-tt { flex: 1; min-width: 0; }
    .gol-head-h { font-size: 16px; font-weight: 800; color: var(--propia-text-h1); }
    .gol-head-s { font-size: 12.5px; color: var(--propia-text-muted); margin-top: 2px; }
    .gol-x { border: 0; background: transparent; color: var(--propia-text-muted); cursor: pointer; width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
    .gol-x:hover { background: var(--propia-bg-hover); color: var(--propia-text-body); }
    .gol-body { padding: 16px 20px; overflow: auto; display: flex; flex-direction: column; gap: 14px; }
    .gol-foot { display: flex; align-items: center; justify-content: flex-end; gap: 9px; padding: 14px 20px; border-top: 1px solid var(--propia-border-divider); }
    .gol-spacer { flex: 1; }
    .gol-fld { display: flex; flex-direction: column; gap: 4px; }
    .gol-fld label { font-size: 11px; color: var(--propia-text-muted); font-weight: 700; }
    .gol-hint { font-size: 11px; color: var(--propia-text-muted); }
    .gol-msg { font-size: 12.5px; font-weight: 600; color: var(--propia-danger); }
    .gol-adv { margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; }
    .gol-btn-brand { display: inline-flex; align-items: center; gap: 7px; padding: 9px 15px; border-radius: 9px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; border: 0; background: var(--propia-brand); color: #fff; box-shadow: var(--propia-glow-brand-sm); }
    .gol-btn-brand:hover:not(:disabled) { background: var(--propia-brand-hover); }
    .gol-btn-brand:disabled { opacity: .55; cursor: default; }
    .gol-btn-ghost { display: inline-flex; align-items: center; gap: 7px; padding: 8px 13px; border-radius: 9px; font-size: 12.5px; font-weight: 600; cursor: pointer; font-family: inherit; background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); color: var(--propia-text-secondary); }
    .gol-btn-ghost:hover:not(:disabled) { border-color: var(--propia-brand); color: var(--propia-brand); }
    /* ---- Tabla Meta (Ola 4c) ---- */
    .gol-mt { display: flex; flex-direction: column; gap: 6px; }
    .gol-mt-hd, .gol-mt-row { display: flex; align-items: center; gap: 10px; }
    .gol-mt-hd { font-size: 10.5px; font-weight: 700; color: var(--propia-text-muted); text-transform: uppercase; letter-spacing: .03em; padding: 0 2px 4px; border-bottom: 1px solid var(--propia-border-divider); }
    .gol-mt-row { padding: 2px; }
    .gol-mt-row.is-off { opacity: .5; }
    .gol-mt-c-lbl { flex: 1 1 42%; min-width: 0; display: flex; align-items: center; gap: 6px; }
    .gol-mt-c-meta { flex: 1 1 32%; min-width: 0; display: flex; justify-content: center; }
    .gol-mt-c-vis { flex: 0 0 54px; display: flex; justify-content: center; }
    .gol-in { width: 100%; padding: 7px 9px; border-radius: 8px; border: 1px solid var(--propia-border-card); background: var(--propia-bg-input, var(--propia-bg-card)); color: var(--propia-text-body); font-size: 12.5px; font-family: inherit; }
    .gol-in:focus { outline: none; border-color: var(--propia-brand); }
    .gol-in-num { max-width: 80px; }
    .gol-ck { width: 16px; height: 16px; accent-color: var(--propia-brand); cursor: pointer; }
    .gol-tag { font-size: 9.5px; font-weight: 700; color: var(--propia-brand); background: var(--propia-brand-soft); border-radius: 5px; padding: 1px 5px; flex-shrink: 0; }
    .gol-add { align-self: flex-start; margin-top: 2px; }
</style>

@code {
    /// <summary>Clave de la lista (discriminador en lista_opciones / catalogo_opciones), ej. "porteria.tipovisitante".</summary>
    [Parameter, EditorRequired] public string Lista { get; set; } = "";
    /// <summary>Titulo amigable que se muestra en la cabecera del modal.</summary>
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string? Jwt { get; set; }
    /// <summary>Permite ocultar opciones (default true). Para listas enum-universo siempre true (ocultar, no borrar).</summary>
    [Parameter] public bool PermitirOcultar { get; set; } = true;
    /// <summary>Permite agregar opciones propias (texto libre). false para listas enum-universo SIN logica (el valor
    /// es el enum). En listas con-logica el agregar lo gobierna el modo Meta (siempre se puede agregar propia).</summary>
    [Parameter] public bool PermiteAgregar { get; set; } = false;
    [Parameter] public EventCallback Cerrado { get; set; }
    /// <summary>Se invoca tras guardar/restablecer para que el padre recargue sus opciones efectivas.</summary>
    [Parameter] public EventCallback Guardado { get; set; }

    // ---- Lista libre ----
    private List<OpcionCampo> _opcs = new();
    private HashSet<string> _semillaKeys = new(StringComparer.OrdinalIgnoreCase);  // labels base (A&D): solo-ocultar

    // ---- Lista con-logica (Ola 4c) ----
    private IReadOnlyList<CatalogoListasRegistro.MetaCampoDef>? _schema;
    private List<MetaRow> _rows = new();

    private bool _cargando = true;
    private bool _busy;
    private string? _msg;

    private sealed class MetaRow
    {
        public string? Clave;                 // null = fila nueva aun sin persistir
        public string Label = "";
        public string? Color;
        public bool Oculta;
        public bool EsBase;
        public Dictionary<string, string?> Meta = new(StringComparer.OrdinalIgnoreCase);
    }

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    protected override async Task OnInitializedAsync()
    {
        _schema = CatalogoListasRegistro.Info(Lista).MetaSchema;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        try
        {
            var rows = await Auth().GetFromJsonAsync<List<OpcionEfectivaDto>>(
                $"/api/campos/opciones?lista={Uri.EscapeDataString(Lista)}&incluirOcultas=true") ?? new();

            if (_schema is null)
            {
                _opcs = rows.Select(r => new OpcionCampo(r.Label, !r.Activo, r.Color)).ToList();
                _semillaKeys = rows.Where(r => r.EsBase).Select(r => (r.Label ?? "").Trim())
                                   .Where(s => s.Length > 0).ToHashSet(StringComparer.OrdinalIgnoreCase);
            }
            else
            {
                _rows = rows.Select(r => new MetaRow
                {
                    Clave = r.Clave,
                    Label = r.Label,
                    Color = r.Color,
                    Oculta = !r.Activo,
                    EsBase = r.EsBase,
                    Meta = ParseMeta(r.Meta, _schema),
                }).ToList();
            }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _cargando = false; }
    }

    // Lee los valores del schema del JSON Meta a un dict (string). Rellena faltantes con el default del campo.
    private static Dictionary<string, string?> ParseMeta(string? meta, IReadOnlyList<CatalogoListasRegistro.MetaCampoDef> schema)
    {
        var d = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(meta))
        {
            try
            {
                using var doc = JsonDocument.Parse(meta!);
                foreach (var f in schema)
                    if (doc.RootElement.TryGetProperty(f.Clave, out var el))
                        d[f.Clave] = el.ValueKind == JsonValueKind.String ? el.GetString()
                                   : el.ValueKind == JsonValueKind.True ? "true"
                                   : el.ValueKind == JsonValueKind.False ? "false"
                                   : el.ToString();
            }
            catch { /* Meta corrupto: se cae a defaults */ }
        }
        foreach (var f in schema)
            if (!d.ContainsKey(f.Clave))
                d[f.Clave] = f.Tipo == CatalogoListasRegistro.MetaTipo.Bool ? "false" : f.Opciones?.FirstOrDefault()?.Valor ?? "0";
        return d;
    }

    private string? Val(MetaRow r, string clave) => r.Meta.TryGetValue(clave, out var v) ? v : null;
    private bool IsOn(MetaRow r, string clave) => string.Equals(Val(r, clave), "true", StringComparison.OrdinalIgnoreCase);

    private Task OnLabel(MetaRow r, string? v) { r.Label = (v ?? "").Trim(); return GuardarAsync(); }
    private Task OnMeta(MetaRow r, string clave, string? v) { r.Meta[clave] = v; return GuardarAsync(); }
    private Task OnMetaBool(MetaRow r, string clave, bool v) { r.Meta[clave] = v ? "true" : "false"; return GuardarAsync(); }
    private Task OnVisible(MetaRow r, bool visible) { r.Oculta = !visible; return GuardarAsync(); }

    private void AgregarFila()
    {
        var r = new MetaRow { EsBase = false, Label = "" };
        if (_schema is not null)
            foreach (var f in _schema)
                r.Meta[f.Clave] = f.Tipo == CatalogoListasRegistro.MetaTipo.Bool ? "false" : f.Opciones?.FirstOrDefault()?.Valor ?? "0";
        _rows.Add(r);
    }

    // Serializa la Meta de una fila como JSON tipado segun el schema (numero para Entero/Seleccion numerica,
    // booleano para Bool, string para Seleccion no numerica).
    private string? SerializeMeta(MetaRow r)
    {
        if (_schema is null || _schema.Count == 0) return null;
        var obj = new Dictionary<string, object?>();
        foreach (var f in _schema)
        {
            r.Meta.TryGetValue(f.Clave, out var v);
            obj[f.Clave] = f.Tipo switch
            {
                CatalogoListasRegistro.MetaTipo.Bool => string.Equals(v, "true", StringComparison.OrdinalIgnoreCase),
                CatalogoListasRegistro.MetaTipo.Entero => int.TryParse(v, out var n) ? n : (object?)null,
                _ => int.TryParse(v, out var n2) ? n2 : (object?)v,   // Seleccion: numero si parsea, si no string
            };
        }
        return JsonSerializer.Serialize(obj);
    }

    // Guardado del modo con-logica: envia TODAS las filas (con label no vacio) en orden, cada una con su Meta.
    private async Task GuardarAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var payload = _rows.Where(r => !string.IsNullOrWhiteSpace(r.Label))
                .Select(r => new OpcionGuardarDto(r.Label.Trim(), r.Color, r.Oculta, SerializeMeta(r))).ToList();
            var ok = await PostAsync(payload);
            if (ok) { await CargarAsync(); await Guardado.InvokeAsync(); }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    // Guardado del modo libre (reutiliza el contrato de OpcionesLista): label/color/ocultar, sin Meta.
    private async Task GuardarLibreAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var payload = _opcs.Where(o => !string.IsNullOrWhiteSpace(o.K))
                .Select(o => new OpcionGuardarDto(o.K, o.Color, o.Oculta)).ToList();
            var ok = await PostAsync(payload);
            if (ok) { await CargarAsync(); await Guardado.InvokeAsync(); }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task<bool> PostAsync(List<OpcionGuardarDto> payload)
    {
        var r = await Auth().PostAsJsonAsync($"/api/campos/opciones?lista={Uri.EscapeDataString(Lista)}", payload);
        if (r.IsSuccessStatusCode) return true;
        _msg = "No se pudo guardar la lista.";
        return false;
    }

    private async Task ReaplicarBasesAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var r = await Auth().PostAsync($"/api/campos/reaplicar-bases?lista={Uri.EscapeDataString(Lista)}", null);
            if (r.IsSuccessStatusCode) { await CargarAsync(); await Guardado.InvokeAsync(); }
            else { _msg = "No se pudo restablecer."; }
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Cerrar() => await Cerrado.InvokeAsync();
}
