    // Si la pagina inyecto un catalogo (Unidades/Seguros/PQRSD) se usa ese; si no, el diccionario
    // interno por prefijo (entidades vinculadas a la unidad).
    private CampoSis[] CamposSistema => Catalogo is { Count: > 0 }
        ? Catalogo.Select(c => new CampoSis(c.Clave, c.Label, c.Tipo, c.VisibleDefault, c.Fija,
              c.OpcionesEditables, c.Semilla, c.Entero, c.Ayuda, c.TiposIntercambiables, c.ListaExterna, c.SinFormato)).ToArray()
        : (Sistema.TryGetValue(Prefijo, out var c2) ? c2 : Array.Empty<CampoSis>());

    /// <summary>Opciones de las listas del sistema de SOLO LECTURA (valores fijos, no se editan).
    /// SOLICITUD_SELLO_05: cuando la pagina inyecta el catalogo, las opciones salen de la Semilla del
    /// CampoSistemaDef, de modo que el componente NO necesita conocer el enum del dominio de cada modulo
    /// (antes un switch hardcodeado dejaba en "0 opciones" toda lista de solo lectura de un catalogo
    /// inyectado, p.ej. Contratos). Fallback (diccionario interno de entidades vinculadas a la unidad):
    /// los valores del enum del dominio.</summary>
    private string[] OpcionesSistema(string clave)
    {
        var s = CamposSistema.FirstOrDefault(x => x.Clave == clave);
        if (s?.Semilla is { Length: > 0 }) return s.Semilla;
        return (Prefijo, clave) switch
        {
            ("personas", "rol") => Enum.GetNames<RolUnidadPersona>(),
            ("vehiculos", "tipovehiculo") => Enum.GetNames<TipoVehiculo>(),
            ("mascotas", "tipo") => Enum.GetNames<TipoMascota>(),
            _ => Array.Empty<string>()
        };
    }

    /// <summary>Opciones EFECTIVAS de una lista de sistema EDITABLE (OpcionesEditables): las que edito
    /// la copropiedad (en la config) o, si aun no, la semilla de fabrica. Incluyen color y 'oculta'.</summary>
    private List<OpcionCampo> OpcionesSistemaDetalle(CampoSis s)
    {
        if (_cfg.TryGetValue(s.Clave, out var c) && !string.IsNullOrWhiteSpace(c.Opciones))
            return OpcionCampo.Parse(c.Opciones);
        return (s.Semilla ?? Array.Empty<string>()).Select(x => new OpcionCampo(x)).ToList();
    }

