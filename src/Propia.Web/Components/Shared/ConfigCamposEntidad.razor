    // Con el gate OFF devuelve exactamente TiposPorCategoria -> los demas consumidores no ven cambios.
    private IEnumerable<(string Categoria, TipoCampoTablero[] Tipos)> CategoriasTipos
        => TiposAvanzados
            ? TiposPorCategoria.Append(("Avanzados", new[] { TipoCampoTablero.Formula, TipoCampoTablero.Usuario, TipoCampoTablero.Directorio }))
            : TiposPorCategoria;

    // Candidatos a FUENTE de una formula: campos Numero/Moneda del catalogo de sistema + campos propios
    // Numero/Moneda. Key = clave de sistema o "cd:{id}"; Label = alias/etiqueta. Excluye por tipo cualquier
    // Formula/Usuario/Directorio (sin anidamiento). Generico -> sirve en las 8 superficies.
    private IEnumerable<(string Key, string Label)> FuentesFormula()
    {
        foreach (var s in CamposSistema)
            if (CampoFormulaConfig.EsFuenteValida(s.Tipo))
                yield return (s.Clave, string.IsNullOrWhiteSpace(AliasConfig(s.Clave)) ? s.DefLabel : AliasConfig(s.Clave));
        foreach (var d in _defs)
            if (CampoFormulaConfig.EsFuenteValida(d.Tipo))
                yield return ("cd:" + d.Id, d.Label);
    }
