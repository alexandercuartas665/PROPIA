@* ============================================================================================
   Grilla de configuracion de campos de una entidad vinculada a la unidad (Personas, Vehiculos,
   Mascotas, Terceros). Es el MISMO panel para las cuatro: solo cambia el prefijo.

   Lista, en una sola grilla ordenable, los campos del SISTEMA de esa ficha (los que ya trae de
   fabrica: nombre, documento, rol, placa, raza...) y los campos PROPIOS de la copropiedad. De
   cada uno se puede cambiar el alias, la visibilidad, la ubicacion y -donde tiene sentido- el
   tipo y el formato. Es la misma forma que la pestana "Unidad".

   El alias/visibilidad/orden viven en unidad_campos_config discriminados por 'entidad'; los
   campos propios ademas tienen su definicion en {prefijo}-campos.

   Reusa las clases cga-* que define la pagina de Unidades (el CSS del proyecto es global).
   ============================================================================================ *@
@inject IHttpClientFactory HttpFactory
@using Propia.Domain.Enums

<div class="cga-grid cga-head-row">
    <div></div>
    <div>Label</div>
    <div>Tipo de Dato</div>
    <div>Configuracion especifica</div>
    <div></div>
</div>

@if (_cargando)
{
    <div class="cga-vacio">Cargando campos...</div>
}
else if (_errorCarga is not null)
{
    @* Un fallo de carga NO puede parecer "no hay campos": se distingue explicitamente. *@
    <div class="cga-error">
        No se pudieron cargar los campos de @TituloPlural.ToLowerInvariant(). @_errorCarga
        <button class="dst-btn-soft" type="button" style="margin-left:8px;" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else
{
    @foreach (var it in ItemsOrdenados())
    {
        var item = it;
        var clave = item.Clave;
        var vis = VisibleDe(clave);
        var tefe = TipoEfectivo(item);
        var permitidos = item.EsCustom ? TiposOfrecidos : TiposPermitidos(item);
        var fmt = FormatoDe(clave);

        <div class="cga-grid cga-row @(_dragClave == clave ? "cga-row--drag" : "")"
             @ondragover:preventDefault="true" @ondrop="() => OnDrop(clave)">
            <div class="cga-ctrl">
                @* Orden y visibilidad persisten en la config del tenant; en SinConfigSistema (Tareas) no
                   existe esa config -el orden es per-usuario desde el tablero-, asi que se ocultan. *@
                @if (!SinConfigSistema)
                {
                    <span class="cga-grip" draggable="true" title="Arrastra para reubicar el campo"
                          @ondragstart="() => _dragClave = clave" @ondragend="() => _dragClave = null">
                        <svg width="12" height="16" viewBox="0 0 12 16" fill="currentColor"><circle cx="3" cy="3" r="1.4"/><circle cx="9" cy="3" r="1.4"/><circle cx="3" cy="8" r="1.4"/><circle cx="9" cy="8" r="1.4"/><circle cx="3" cy="13" r="1.4"/><circle cx="9" cy="13" r="1.4"/></svg>
                    </span>
                    <button type="button" class="cga-mini" title="Subir" @onclick="() => MoverAsync(clave, -1)" disabled="@_busy">&#9650;</button>
                    <button type="button" class="cga-mini" title="Bajar" @onclick="() => MoverAsync(clave, 1)" disabled="@_busy">&#9660;</button>
                    <button type="button" class="cga-eye @(vis ? "on" : "")" title="@(vis ? "Visible en la ficha" : "Oculto")"
                            @onclick="() => SetVisibleAsync(clave, !vis)" disabled="@(_busy || !PuedeOcultar(item))">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                }
            </div>
            <div>
                @if (item.EsCustom)
                {
                    <input class="cga-inp" value="@item.Campo!.Label" title="Renombrar el campo"
                           @onchange="@(e => RenombrarCustomAsync(item.Campo!, e.Value?.ToString()))" disabled="@_busy" />
                }
                else
                {
                    <input class="cga-inp" placeholder="@item.Sis!.DefLabel" value="@AliasConfig(clave)" title="Alias del campo del sistema"
                           @onchange="@(e => SetAliasAsync(clave, e.Value?.ToString()))" disabled="@_busy" />
                }
            </div>
            <div class="cga-tipo">
                @if (permitidos.Length > 0)
                {
                    <select class="cga-inp cga-tipo-sel" value="@tefe" @onchange="@(e => SetTipoAsync(item, e.Value?.ToString()))" disabled="@_busy">
                        @foreach (var t in permitidos) { <option value="@t" selected="@(t == tefe)">@TipoLabel(t)</option> }
                    </select>
                }
                else
                {
                    <span class="cga-tipo-badge">@TipoLabel(tefe)</span>
                    <svg class="cga-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" title="Tipo fijo del sistema"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                    <span class="cga-fija">FIJA</span>
                }
            </div>
            <div class="cga-cfg">
                @if (!item.EsCustom && tefe == TipoCampoTablero.Seleccion && item.Sis!.OpcionesEditables && item.Sis!.ListaExterna)
                {
                    @* Lista administrada por la PAGINA (p.ej. Tipo de unidad: enum + tipos propios). *@
                    <button class="dst-btn-soft" type="button" @onclick="() => OnGestionarLista.InvokeAsync(clave)">Gestionar lista</button>
                    @if (ContarOpcionesExterna is { } contar)
                    {
                        var cnt = contar(clave);
                        <span class="cga-cfg-hint" style="margin-left:6px;">
                            @cnt.Visibles opciones@(cnt.Ocultas > 0 ? $" ({cnt.Ocultas} ocultas)" : "")
                        </span>
                    }
                }
                else if (!item.EsCustom && tefe == TipoCampoTablero.Seleccion && item.Sis!.OpcionesEditables)
                {
                    @* Lista de sistema EDITABLE con el editor interno (Estado): opciones/semilla/color. *@
                    var opsis = OpcionesSistemaDetalle(item.Sis!);
                    <button class="dst-btn-soft" type="button" @onclick="() => ToggleOpcionesSistema(clave)">
                        @(_opcSisClave == clave ? "Ocultar lista" : "Gestionar lista")
                    </button>
                    <span class="cga-cfg-hint" style="margin-left:6px;">
                        @opsis.Count(o => !o.Oculta) opciones@(opsis.Any(o => o.Oculta) ? $" ({opsis.Count(o => o.Oculta)} ocultas)" : "")
                    </span>
                }
                else if (!item.EsCustom && tefe == TipoCampoTablero.Seleccion)
                {
                    @* Lista de solo lectura: sus opciones son valores de un enum del sistema. *@
                    <span class="cga-cfg-hint" title="@string.Join(", ", OpcionesSistema(clave))">
                        Lista del sistema (@OpcionesSistema(clave).Length opciones)
                    </span>
                }
                else if (item.EsCustom && tefe == TipoCampoTablero.Seleccion)
                {
                    <button class="dst-btn-soft" type="button" @onclick="() => ToggleOpciones(item.Campo!.Id)">
                        @(_opcExpand == item.Campo!.Id ? "Ocultar lista" : "Gestionar lista")
                    </button>
                    <span class="cga-cfg-hint" style="margin-left:6px;">@item.Campo!.OpcionesArray().Length opciones</span>
                }
                else if (!item.EsCustom && item.Sis!.SinFormato)
                {
                    @* Campo estructural (identificador, derivado...): sin editor de formato; solo la pista. *@
                    @if (!string.IsNullOrWhiteSpace(item.Sis!.Ayuda)) { <span class="cga-cfg-hint">@item.Sis!.Ayuda</span> }
                }
                else if (!item.EsCustom && item.Sis!.Entero)
                {
                    <span class="cga-cfg-hint">Entero (sin decimales)</span>
                }
                else if (tefe is TipoCampoTablero.Numero or TipoCampoTablero.Moneda or TipoCampoTablero.Porcentaje)
                {
                    <div class="cga-fmt">
                        <label class="cga-fmt-lbl">Decimales</label>
                        <select class="cga-inp cga-fmt-dec" value="@(fmt.Dec ?? 2)" @onchange="@(e => SetFormatoDecAsync(clave, e.Value?.ToString()))" disabled="@_busy">
                            @foreach (var d in new[] { 0, 1, 2, 3, 4 }) { <option value="@d" selected="@((fmt.Dec ?? 2) == d)">@d</option> }
                        </select>
                        <label class="cga-fmt-chk" title="Separador de miles (se aplica en las vistas de solo lectura)">
                            <input type="checkbox" checked="@fmt.Miles" @onchange="@(e => SetFormatoMilesAsync(clave, (bool)(e.Value ?? false)))" disabled="@_busy" />
                            <span>Miles</span>
                        </label>
                        @if (tefe == TipoCampoTablero.Moneda) { <span class="cga-fmt-tag">COP</span> }
                        else if (tefe == TipoCampoTablero.Porcentaje) { <span class="cga-fmt-tag">%</span> }
                    </div>
                }
                else if (tefe is TipoCampoTablero.Texto or TipoCampoTablero.AreaTexto or TipoCampoTablero.Telefono or TipoCampoTablero.Email or TipoCampoTablero.Url)
                {
                    <div class="cga-fmt">
                        <label class="cga-fmt-lbl">Max. caracteres</label>
                        <input class="cga-inp cga-fmt-max" type="number" min="1" max="4000" placeholder="sin limite"
                               value="@(fmt.Max?.ToString() ?? "")" @onchange="@(e => SetFormatoMaxAsync(clave, e.Value?.ToString()))" disabled="@_busy" />
                    </div>
                }
                else if (tefe == TipoCampoTablero.Booleano) { <span class="cga-cfg-hint">Si / No</span> }
                else if (tefe == TipoCampoTablero.Fecha) { <span class="cga-cfg-hint">dd/mm/aaaa</span> }
                else if (!item.EsCustom && !string.IsNullOrWhiteSpace(item.Sis!.Ayuda)) { <span class="cga-cfg-hint">@item.Sis!.Ayuda</span> }
            </div>
            <div class="cga-row-act">
                @if (item.EsCustom)
                {
                    var dd = item.Campo!;
                    <button class="dst-btn-soft" type="button" @onclick="() => EliminarCustomAsync(dd)" disabled="@_busy">Eliminar</button>
                }
                else { <span class="cga-cfg-hint">del sistema</span> }
            </div>
        </div>

        @if (item.EsCustom && _opcExpand == item.Campo!.Id && tefe == TipoCampoTablero.Seleccion)
        {
            var dd2 = item.Campo!;
            <div class="cga-opts">
                <div class="cga-opts-list">
                    @for (var i = 0; i < _opcs.Count; i++)
                    {
                        var idx = i;
                        var op = _opcs[idx];
                        <div class="cga-opt-row">
                            <div class="cga-opt-move">
                                <button type="button" class="cga-mini" title="Subir" disabled="@(idx == 0 || _busy)" @onclick="() => MoverOpcionAsync(dd2, idx, -1)">&#9650;</button>
                                <button type="button" class="cga-mini" title="Bajar" disabled="@(idx == _opcs.Count - 1 || _busy)" @onclick="() => MoverOpcionAsync(dd2, idx, 1)">&#9660;</button>
                            </div>
                            @* Chip: muestra la opcion con su color (asi se ve igual que en la tabla/ficha). *@
                            <span class="cga-chip" style="background:@(op.Color ?? PaletaChips.Neutro);color:@PaletaChips.TextoSobre(op.Color)">@(string.IsNullOrWhiteSpace(op.K) ? "-" : op.K)</span>
                            <input class="cga-inp cga-opt-inp" value="@op.K" title="Renombrar la opcion"
                                   @onchange="@(e => RenombrarOpcionAsync(dd2, idx, e.Value?.ToString()))" disabled="@_busy" />
                            <div class="cga-opt-colors">
                                @foreach (var c in PaletaChips.Colores)
                                {
                                    var cc = c;
                                    <button type="button" class="cga-sw @(string.Equals(op.Color, cc, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                            style="background:@cc" title="Color" disabled="@_busy" @onclick="() => SetColorOpcionAsync(dd2, idx, cc)"></button>
                                }
                                <button type="button" class="cga-sw cga-sw-none @(op.Color is null ? "on" : "")" title="Sin color"
                                        disabled="@_busy" @onclick="() => SetColorOpcionAsync(dd2, idx, null)">&times;</button>
                            </div>
                            <button type="button" class="cga-eye @(op.Oculta ? "" : "on")" title="@(op.Oculta ? "Oculta (no se ofrece)" : "Visible")"
                                    @onclick="() => ToggleOcultaOpcionAsync(dd2, idx)" disabled="@_busy">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                            <button type="button" class="cga-opt-x" title="Quitar" @onclick="() => QuitarOpcionAsync(dd2, idx)" disabled="@_busy">&times;</button>
                        </div>
                    }
                    <div class="cga-opt-add">
                        <input class="cga-inp" placeholder="Anadir nueva opcion..." @bind="_nuevaOpc" @bind:event="oninput" />
                        <button class="cga-add-btn" type="button" @onclick="() => AgregarOpcionAsync(dd2)" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaOpc))">Anadir</button>
                    </div>
                </div>
            </div>
        }

        @* Lista de sistema EDITABLE abierta (Estado, Tipo de unidad...): mismas acciones que un campo
           propio, salvo que las opciones SEMILLA no se pueden renombrar ni eliminar (solo ocultar). *@
        @if (!item.EsCustom && _opcSisClave == clave && tefe == TipoCampoTablero.Seleccion && item.Sis!.OpcionesEditables && !item.Sis!.ListaExterna)
        {
            var semillas = item.Sis!.Semilla ?? Array.Empty<string>();
            <div class="cga-opts">
                <div class="cga-opts-list">
                    @for (var i = 0; i < _opcs.Count; i++)
                    {
                        var idx = i;
                        var op = _opcs[idx];
                        var esSemilla = semillas.Contains(op.K, StringComparer.OrdinalIgnoreCase);
                        <div class="cga-opt-row @(op.Oculta ? "cga-opt-row--oculta" : "")">
                            <div class="cga-opt-move">
                                <button type="button" class="cga-mini" title="Subir" disabled="@(idx == 0 || _busy)" @onclick="() => MoverOpcionAsync(null, idx, -1)">&#9650;</button>
                                <button type="button" class="cga-mini" title="Bajar" disabled="@(idx == _opcs.Count - 1 || _busy)" @onclick="() => MoverOpcionAsync(null, idx, 1)">&#9660;</button>
                            </div>
                            <span class="cga-chip" style="background:@(op.Color ?? PaletaChips.Neutro);color:@PaletaChips.TextoSobre(op.Color)">@(string.IsNullOrWhiteSpace(op.K) ? "-" : op.K)</span>
                            @if (esSemilla)
                            {
                                <svg class="cga-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" title="Opcion de fabrica: se puede ocultar, no eliminar"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                                <span class="cga-opt-name">@op.K</span>
                            }
                            else
                            {
                                <input class="cga-inp cga-opt-inp" value="@op.K" title="Renombrar la opcion"
                                       @onchange="@(e => RenombrarOpcionAsync(null, idx, e.Value?.ToString()))" disabled="@_busy" />
                            }
                            <div class="cga-opt-colors">
                                @foreach (var c in PaletaChips.Colores)
                                {
                                    var cc = c;
                                    <button type="button" class="cga-sw @(string.Equals(op.Color, cc, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                            style="background:@cc" title="Color" disabled="@_busy" @onclick="() => SetColorOpcionAsync(null, idx, cc)"></button>
                                }
                                <button type="button" class="cga-sw cga-sw-none @(op.Color is null ? "on" : "")" title="Sin color"
                                        disabled="@_busy" @onclick="() => SetColorOpcionAsync(null, idx, null)">&times;</button>
                            </div>
                            <button type="button" class="cga-eye @(op.Oculta ? "" : "on")" title="@(op.Oculta ? "Oculta (no se ofrece)" : "Visible")"
                                    @onclick="() => ToggleOcultaOpcionAsync(null, idx)" disabled="@_busy">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                            @if (!esSemilla)
                            {
                                <button type="button" class="cga-opt-x" title="Quitar" @onclick="() => QuitarOpcionAsync(null, idx)" disabled="@_busy">&times;</button>
                            }
                        </div>
                    }
                    <div class="cga-opt-add">
                        <input class="cga-inp" placeholder="Anadir nueva opcion..." @bind="_nuevaOpc" @bind:event="oninput" />
                        <button class="cga-add-btn" type="button" @onclick="() => AgregarOpcionAsync(null)" disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevaOpc))">Anadir</button>
                    </div>
                </div>
            </div>
        }
    }

    @* Alta de campos PROPIOS: se oculta cuando la entidad no tiene EAV (SinCamposPropios). *@
    @if (!SinCamposPropios)
    {
    <div class="dst-cfg-sep"></div>

    <div class="dst-cfg-form">
        <div class="dst-cfg-form-title">Nuevo campo de @TituloSingular.ToLowerInvariant()</div>
        <div class="dst-cfg-form-grid">
            <div>
                <label class="dst-nfc-lbl">Nombre</label>
                <input class="dst-nf-inp" @bind="_nvLabel" @bind:event="oninput" placeholder="@Ejemplo" />
            </div>
            <div>
                <label class="dst-nfc-lbl">Tipo</label>
                @* 0.3: tipos agrupados por categoria. El <select> nativo no admite iconos SVG en las
                   opciones; se agrupa con optgroup (accesible). El icono por categoria queda para un
                   dropdown custom si se decide despues. *@
                <select class="dst-nf-inp" @bind="_nvTipo">
                    @foreach (var (cat, tipos) in CategoriasTipos)
                    {
                        <optgroup label="@cat">
                            @foreach (var t in tipos) { <option value="@t">@TipoLabel(t)</option> }
                        </optgroup>
                    }
                </select>
            </div>
        </div>
        @if (_nvTipo == TipoCampoTablero.Seleccion)
        {
            <div style="margin-top:8px;">
                <label class="dst-nfc-lbl">Opciones (una por linea)</label>
                <textarea class="dst-nf-inp" rows="4" @bind="_nvOpciones" @bind:event="oninput"></textarea>
            </div>
        }
        else if (_nvTipo == TipoCampoTablero.Formula)
        {
            @* Formula (Fase 2): operacion + campos fuente Numero/Moneda. El valor se calcula en lectura. *@
            <div style="margin-top:8px;">
                <label class="dst-nfc-lbl">Operacion</label>
                <select class="dst-nf-inp" @bind="_nvOperacion">
                    @foreach (var op in Enum.GetValues<OperacionFormula>())
                    {
                        <option value="@op">@OperacionLabel(op)</option>
                    }
                </select>
            </div>
            <div style="margin-top:8px;">
                <label class="dst-nfc-lbl">Campos a calcular (Numero / Moneda)</label>
                @{ var fuentes = FuentesFormula().ToList(); }
                @if (fuentes.Count == 0)
                {
                    <div class="cga-cfg-hint">No hay campos Numero o Moneda para calcular. Crea primero un campo numerico.</div>
                }
                else
                {
                    <div class="cga-formula-fuentes">
                        @foreach (var f in fuentes)
                        {
                            <label class="cga-formula-fuente">
                                <input type="checkbox" checked="@_nvFuentes.Contains(f.Key)"
                                       @onchange="e => ToggleFuenteNueva(f.Key, (bool)(e.Value ?? false))" />
                                <span>@f.Label</span>
                            </label>
                        }
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(_msg)) { <div class="dst-cfg-msg">@_msg</div> }
        <div class="dst-cfg-form-foot">
            <button class="propia-btn-brand" type="button" @onclick="CrearAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_nvLabel))">
                @(_busy ? "Guardando..." : "Crear campo")
            </button>
        </div>
    </div>
    }
}

@* Los estilos del gestor (.cga-*) viven en wwwroot/css/modules/config-campos.css (global), para que
   TODA adopcion del componente los herede; antes estaban en el <style> de Distribucion y no viajaban. *@

@code {
    /// <summary>Prefijo/entidad del catalogo: personas | vehiculos | mascotas | terceros.</summary>
    [Parameter, EditorRequired] public string Prefijo { get; set; } = "";
    [Parameter] public string TituloSingular { get; set; } = "registro";
    [Parameter] public string TituloPlural { get; set; } = "registros";
    [Parameter] public string Ejemplo { get; set; } = "";
    [Parameter] public string? Jwt { get; set; }
    [Parameter] public EventCallback Cambiado { get; set; }

    // ===== Rutas base parametrizables (P-1) =====
    // El catalogo de campos propios vive en {prefijo}-campos por defecto; RutaCatalogo lo sobreescribe
    // cuando el nombre del controlador no coincide con el prefijo. La CONFIG de campos del sistema
    // (alias/oculto/orden/tipo/formato) vive por defecto en 'unidades-config' (config COMPARTIDA del
    // ecosistema de la unidad: unidad + personas + vehiculos + mascotas + terceros, discriminada por
    // 'entidad'). Seguros/PQRSD pasaran su propia RutaConfig para reusar este mismo componente.
    /// <summary>Ruta base del catalogo de campos propios (sin /api/mi-copropiedad/). Null = "{Prefijo}-campos".</summary>
    [Parameter] public string? RutaCatalogo { get; set; }
    /// <summary>Ruta base del endpoint de config de campos del sistema. Por defecto "unidades-config".</summary>
    [Parameter] public string RutaConfig { get; set; } = "unidades-config";
    /// <summary>Valor del discriminador 'entidad' en la config del tenant. Por defecto = Prefijo, pero la
    /// unidad usa "unidad" (singular, historico) aunque su catalogo viva en "unidades-campos".</summary>
    [Parameter] public string? EntidadConfig { get; set; }
    /// <summary>Catalogo de campos del sistema inyectado por la pagina (P-3). Si es null, se usa el
    /// diccionario interno por prefijo (personas/vehiculos/mascotas/terceros).</summary>
    [Parameter] public IReadOnlyList<CampoSistemaDef>? Catalogo { get; set; }
    /// <summary>Se dispara con la clave cuando el usuario pulsa "Gestionar lista" en un campo de sistema
    /// marcado como ListaExterna (la pagina abre su propio editor; p.ej. Tipo de unidad).</summary>
    [Parameter] public EventCallback<string> OnGestionarLista { get; set; }
    /// <summary>Para campos con ListaExterna: cuenta de opciones (visibles, ocultas) que provee la pagina
    /// para la pista de la grilla. Si es null, no se muestra conteo.</summary>
    [Parameter] public Func<string, (int Visibles, int Ocultas)>? ContarOpcionesExterna { get; set; }
    /// <summary>true = la entidad NO tiene config de sistema en BD (no hay tabla *-config). El componente
    /// solo gestiona DEFINICIONES de campos propios (crear/editar/eliminar/listar); no lee ni escribe
    /// alias/visibilidad/orden/tipo/formato de sistema, y oculta los controles de orden y visibilidad
    /// (que persistirian en config). Lo usa Tareas (opcion A: columnas per-usuario, no por copropiedad).</summary>
    [Parameter] public bool SinConfigSistema { get; set; }

    /// <summary>true = la entidad NO tiene campos PROPIOS (EAV): no expone {Prefijo}-campos. El componente
    /// omite el GET al catalogo (evita el 404 que dejaria la grilla en error) y oculta el alta "Crear campo";
    /// solo gestiona campos de SISTEMA. Aditivo (default false = comportamiento actual). Lo usa PROGRAMACION
    /// (Mantenimiento). Es el inverso de <see cref="SinConfigSistema"/>: aquel quita config, este quita EAV.</summary>
    [Parameter] public bool SinCamposPropios { get; set; }

    /// <summary>true = ofrece los tipos AVANZADOS (Fase 2): Formula, Usuario y Directorio. Default false,
    /// asi que los consumidores que NO lo pasan (las otras superficies) siguen viendo EXACTAMENTE los tipos
    /// de antes (sin regresion). Unidades lo pasa true (superficie de referencia); replicar = pasar el flag.</summary>
    [Parameter] public bool TiposAvanzados { get; set; }

    /// <summary>Ruta efectiva del catalogo (RutaCatalogo o el derivado del prefijo).</summary>
    private string CatBase => string.IsNullOrWhiteSpace(RutaCatalogo) ? $"{Prefijo}-campos" : RutaCatalogo;
    /// <summary>Valor efectivo del discriminador 'entidad' (EntidadConfig o el prefijo).</summary>
    private string EntCfg => string.IsNullOrWhiteSpace(EntidadConfig) ? Prefijo : EntidadConfig;

    // Resuelve una ruta base: si ya es absoluta (/api/...) se usa tal cual (modulos fuera de
    // mi-copropiedad, p.ej. /api/pqrsd/pqrsd-campos, /api/seguros/polizas-campos); si no, se antepone
    // /api/mi-copropiedad/ como siempre (retrocompatible con Unidades/Vehiculos/Mascotas/Terceros).
    private static string ResolverRuta(string baseRuta)
        => baseRuta.StartsWith("/api/", StringComparison.OrdinalIgnoreCase) ? baseRuta : $"/api/mi-copropiedad/{baseRuta}";
    private string CatUrl => ResolverRuta(CatBase);
    private string CfgUrl => ResolverRuta(RutaConfig);

