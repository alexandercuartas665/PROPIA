@* Trazabilidad de entrega/devolucion con foto, reutilizable por reservas de zona ("reserva")
   y prestamos de equipo ("prestamo"). Sube la foto en base64 al endpoint {BasePath}/{Id}/entregar|devolver
   y lista las fotos desde {BasePath}/{Id}/fotos. *@
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js

<div class="tz-wrap">
    <div class="tz-steps">
        <div class="tz-step @(EntregadoAt.HasValue ? "done" : "")">
            <div class="tz-step-h"><span class="tz-step-t">Entrega</span>
                @if (EntregadoAt.HasValue) { <span class="tz-when">@EntregadoAt.Value.ToLocalTime().ToString("dd MMM, HH:mm")</span> }
            </div>
            @if (EntregadoAt.HasValue)
            {
                @if (!string.IsNullOrEmpty(EntregaObs)) { <div class="tz-obs">@EntregaObs</div> }
            }
            else
            {
                <button class="tz-btn tz-btn-primary" @onclick='() => Abrir(MomentoEntrega.Entrega)' disabled="@_busy">Registrar entrega</button>
            }
        </div>
        <div class="tz-step @(DevueltoAt.HasValue ? "done" : "")">
            <div class="tz-step-h"><span class="tz-step-t">Devolucion</span>
                @if (DevueltoAt.HasValue) { <span class="tz-when">@DevueltoAt.Value.ToLocalTime().ToString("dd MMM, HH:mm")</span> }
            </div>
            @if (DevueltoAt.HasValue)
            {
                @if (!string.IsNullOrEmpty(DevolucionObs)) { <div class="tz-obs">@DevolucionObs</div> }
            }
            else if (EntregadoAt.HasValue)
            {
                <button class="tz-btn" @onclick='() => Abrir(MomentoEntrega.Devolucion)' disabled="@_busy">Registrar devolucion</button>
            }
            else { <span class="tz-mut">Registra primero la entrega.</span> }
        </div>
    </div>

    @if (_fotos.Count > 0)
    {
        <div class="tz-fotos">
            @foreach (var f in _fotos)
            {
                var url = f.Url;
                <button type="button" class="tz-foto" title="@(f.Momento == MomentoEntrega.Entrega ? "Entrega" : "Devolucion")" @onclick="() => _visor = url">
                    <img src="@f.Url" alt="foto" />
                    <span class="tz-foto-tag @(f.Momento == MomentoEntrega.Devolucion ? "dev" : "")">@(f.Momento == MomentoEntrega.Entrega ? "entrega" : "devolucion")</span>
                </button>
            }
        </div>
    }
</div>

@if (_capturaOpen)
{
    <div class="tz-ov" @onclick="() => _capturaOpen = false"></div>
    <div class="tz-modal" @onclick:stopPropagation="true">
        <div class="tz-modal-h">Registrar @(_momento == MomentoEntrega.Entrega ? "entrega" : "devolucion")</div>
        <label class="tz-drop">
            @if (string.IsNullOrEmpty(_fotoBase64)) { <span><i class="fi fi-rr-camera"></i> Toma o elige una foto de como se @(_momento == MomentoEntrega.Entrega ? "entrega" : "devuelve")</span> }
            else { <img src="data:@_fotoMime;base64,@_fotoBase64" class="tz-preview" /> }
            <InputFile OnChange="OnFoto" accept="image/*" style="display:none" />
        </label>
        <textarea class="tz-input" rows="2" placeholder="Observacion (opcional)" @bind="_obs" @bind:event="oninput"></textarea>
        @if (_error != null) { <div class="tz-err">@_error</div> }
        <div class="tz-modal-foot">
            <button class="tz-btn" @onclick="() => _capturaOpen = false">Cancelar</button>
            <button class="tz-btn tz-btn-primary" @onclick="Guardar" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar")</button>
        </div>
    </div>
}

@if (_visor != null)
{
    <div class="tz-visor-ov" @onclick="() => _visor = null"><img src="@_visor" class="tz-visor-img" /></div>
}

@code {
    [Parameter] public string Jwt { get; set; } = "";
    [Parameter] public string BasePath { get; set; } = "";      // ej. /api/prestamos-equipo o /api/reservas
    [Parameter] public Guid Id { get; set; }
    [Parameter] public DateTimeOffset? EntregadoAt { get; set; }
    [Parameter] public DateTimeOffset? DevueltoAt { get; set; }
    [Parameter] public string? EntregaObs { get; set; }
    [Parameter] public string? DevolucionObs { get; set; }
    [Parameter] public EventCallback OnCambio { get; set; }

    private List<FotoDto> _fotos = new();
    private bool _capturaOpen, _busy;
    private MomentoEntrega _momento = MomentoEntrega.Entrega;
    private string? _fotoBase64, _fotoMime, _obs, _error, _visor;

    private HttpClient Auth()
    {
        var c = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt)) c.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return c;
    }

    protected override async Task OnParametersSetAsync() => await CargarFotos();

    private async Task CargarFotos()
    {
        if (Id == Guid.Empty) return;
        try { _fotos = await Auth().GetFromJsonAsync<List<FotoDto>>($"{BasePath}/{Id}/fotos") ?? new(); } catch { _fotos = new(); }
    }

    private void Abrir(MomentoEntrega m) { _momento = m; _fotoBase64 = _fotoMime = _obs = _error = null; _capturaOpen = true; }

    private async Task OnFoto(InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (f.Size > 6_000_000) { _error = "La foto excede 6MB"; return; }
        _fotoMime = string.IsNullOrEmpty(f.ContentType) ? "image/jpeg" : f.ContentType;
        using var ms = new MemoryStream();
        await f.OpenReadStream(6_000_000).CopyToAsync(ms);
        _fotoBase64 = Convert.ToBase64String(ms.ToArray());
        _error = null;
    }

    private async Task Guardar()
    {
        _busy = true; _error = null;
        try
        {
            var accion = _momento == MomentoEntrega.Entrega ? "entregar" : "devolver";
            var body = new { observacion = _obs, fotoNombre = "foto", fotoTipoMime = _fotoMime, fotoBase64 = _fotoBase64 };
            var resp = await Auth().PostAsJsonAsync($"{BasePath}/{Id}/{accion}", body);
            if (!resp.IsSuccessStatusCode) { _error = await resp.Content.ReadAsStringAsync(); return; }
            _capturaOpen = false;
            await CargarFotos();
            await OnCambio.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    public record FotoDto(Guid Id, string Url, MomentoEntrega Momento, DateTimeOffset CreadoAt);
}

<style>
    .tz-wrap { display: flex; flex-direction: column; gap: 10px; }
    .tz-steps { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .tz-step { border: 1px solid #E1E8EE; border-radius: 10px; padding: 10px 12px; background: #fff; }
    .tz-step.done { border-color: #1A8754; background: #F2FBF6; }
    .tz-step-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .tz-step-t { font-size: 12px; font-weight: 800; color: #33475B; }
    .tz-when { font-size: 10.5px; font-weight: 700; color: #1A8754; }
    .tz-obs { font-size: 11.5px; color: #516F90; margin-top: 4px; }
    .tz-mut { font-size: 11px; color: #A6B7C8; }
    .tz-btn { border: 1px solid #E1E8EE; background: #fff; border-radius: 8px; padding: 6px 11px; font-size: 12px; font-weight: 700; color: #516F90; cursor: pointer; margin-top: 6px; font-family: inherit; }
    .tz-btn:hover { border-color: #6D4FE3; color: #6D4FE3; }
    .tz-btn-primary { background: var(--propia-brand, #6D4FE3); border-color: var(--propia-brand, #6D4FE3); color: #fff; }
    .tz-btn-primary:hover { color: #fff; opacity: .92; }
    .tz-fotos { display: flex; flex-wrap: wrap; gap: 8px; }
    .tz-foto { position: relative; width: 84px; height: 84px; border: 1px solid #E1E8EE; border-radius: 9px; overflow: hidden; padding: 0; cursor: pointer; background: #f5f7fa; }
    .tz-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .tz-foto-tag { position: absolute; left: 0; bottom: 0; right: 0; font-size: 8.5px; font-weight: 800; text-transform: uppercase; color: #fff; background: rgba(26,135,84,.85); padding: 2px; }
    .tz-foto-tag.dev { background: rgba(109,79,227,.85); }
    .tz-ov { position: fixed; inset: 0; background: rgba(20,30,45,.45); z-index: 2200; }
    .tz-modal { position: fixed; z-index: 2210; top: 50%; left: 50%; transform: translate(-50%,-50%); width: min(420px,94vw); background: #fff; border-radius: 14px; padding: 18px; box-shadow: 0 20px 60px rgba(20,40,70,.3); display: flex; flex-direction: column; gap: 10px; }
    .tz-modal-h { font-size: 15px; font-weight: 800; color: #1B2A3A; }
    .tz-drop { display: flex; align-items: center; justify-content: center; min-height: 120px; border: 2px dashed #DCD2F8; border-radius: 10px; background: #FAF8FF; color: #6D4FE3; font-size: 12.5px; font-weight: 600; cursor: pointer; text-align: center; padding: 10px; }
    .tz-drop i { margin-right: 6px; }
    .tz-preview { max-width: 100%; max-height: 200px; border-radius: 8px; }
    .tz-input { border: 1px solid #E1E8EE; border-radius: 8px; padding: 8px 10px; font-size: 12.5px; color: #33475B; outline: none; resize: vertical; font-family: inherit; }
    .tz-input:focus { border-color: #6D4FE3; }
    .tz-err { color: #D7263D; font-size: 12px; }
    .tz-modal-foot { display: flex; justify-content: flex-end; gap: 8px; }
    .tz-visor-ov { position: fixed; inset: 0; background: rgba(10,15,25,.85); z-index: 2300; display: flex; align-items: center; justify-content: center; padding: 24px; cursor: zoom-out; }
    .tz-visor-img { max-width: 92vw; max-height: 92vh; border-radius: 8px; }
    [data-bs-theme="dark"] .tz-step { background: #1B2233; border-color: #2D3650; }
    [data-bs-theme="dark"] .tz-step.done { background: #12261c; border-color: #1A8754; }
    [data-bs-theme="dark"] .tz-modal { background: #1B2233; }
    [data-bs-theme="dark"] .tz-input, [data-bs-theme="dark"] .tz-btn { background: #232342; border-color: #3a3a5a; color: #C7C7D6; }
</style>
