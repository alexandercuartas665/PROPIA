@* Tarjeta de identidad de un activo (equipo o zona comun), misma familia visual que la foto del
   Directorio (FichaResidenteModal .fr-avatar): imagen cuadrada de 150px con esquinas redondeadas,
   "Cambiar imagen" debajo, chips (categoria / estado) y los datos clave en solo lectura. Sin imagen
   muestra las iniciales en tonos de la marca en vez de un recuadro vacio. La subida y el borrado los
   hace el modal (OnSubir / OnQuitar); aqui solo se pinta y se abre el lightbox. *@
@using Microsoft.AspNetCore.Components.Forms

<div class="fid">
    @if (!string.IsNullOrWhiteSpace(Seccion)) { <div class="fid-sectlbl">@Seccion</div> }

    @if (!string.IsNullOrWhiteSpace(ImagenUrl))
    {
        <div class="fid-img" style="background-image:url('@ImagenUrl')" role="button" title="Ver imagen completa" @onclick="() => _ver = true">
            @if (OnQuitar.HasDelegate)
            {
                <button class="fid-img-del" type="button" title="Quitar imagen" @onclick="OnQuitar" @onclick:stopPropagation="true">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            }
        </div>
    }
    else
    {
        <label class="fid-ini" title="Cargar imagen">
            @Iniciales
            <InputFile OnChange="OnSubir" accept="image/png,image/jpeg,image/webp" hidden disabled="@Subiendo" />
        </label>
    }

    <label class="fid-change">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>@(Subiendo ? "Subiendo..." : string.IsNullOrWhiteSpace(ImagenUrl) ? "Cargar imagen" : "Cambiar imagen")
        <InputFile OnChange="OnSubir" accept="image/png,image/jpeg,image/webp" hidden disabled="@Subiendo" />
    </label>

    @if (Chips.Count > 0)
    {
        <div class="fid-chips">
            @foreach (var c in Chips) { <span class="fid-chip fid-chip--@c.Tono">@c.Texto</span> }
        </div>
    }

    @ChildContent

    @if (Datos.Count > 0)
    {
        <div class="fid-datos">
            @foreach (var d in Datos)
            {
                <div class="fid-dato"><span>@d.Etiqueta</span><b>@(string.IsNullOrWhiteSpace(d.Valor) ? "—" : d.Valor)</b></div>
            }
        </div>
    }

    @* Lightbox: la imagen ORIGINAL completa (contain, sin recorte) centrada sobre un velo. *@
    @if (_ver && !string.IsNullOrWhiteSpace(ImagenUrl))
    {
        <div class="fid-lb" @onclick="() => _ver = false">
            <button class="fid-lb-x" type="button" title="Cerrar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            <img src="@ImagenUrl" alt="@Iniciales" />
        </div>
    }
</div>

<style>
    .fid { display: flex; flex-direction: column; align-items: center; gap: 9px; }
    .fid-sectlbl { align-self: stretch; font-size: 11px; letter-spacing: .5px; color: var(--propia-text-faint); font-weight: 700; }
    /* Mismo marco que la foto del Directorio (.fr-avatar), pero cuadrado redondeado: es un objeto, no una persona. */
    .fid-img, .fid-ini { width: 150px; height: 150px; border-radius: 22px; border: 3px solid var(--propia-bg-card); box-shadow: 0 2px 10px rgba(27,42,58,.14), 0 0 0 1px var(--propia-border-card); margin-top: 4px; flex-shrink: 0; }
    .fid-img { background-size: cover; background-position: center; background-repeat: no-repeat; background-color: var(--propia-border-divider); cursor: zoom-in; position: relative; }
    .fid-ini { background: var(--propia-brand-soft); color: var(--propia-brand); display: flex; align-items: center; justify-content: center; font-size: 44px; font-weight: 800; cursor: pointer; }
    .fid-ini:hover { background: var(--propia-brand-soft-2); }
    .fid-img-del { position: absolute; top: 7px; right: 7px; width: 26px; height: 26px; border-radius: 8px; border: 0; background: rgba(27,42,58,.55); color: var(--propia-text-inverse); cursor: pointer; display: none; align-items: center; justify-content: center; }
    .fid-img:hover .fid-img-del { display: flex; }
    .fid-img-del:hover { background: var(--propia-danger); }
    .fid-change { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11.5px; font-weight: 700; color: var(--propia-brand); cursor: pointer; }
    .fid-chips { display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; margin-top: 2px; }
    .fid-chip { display: inline-flex; align-items: center; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: var(--propia-bg-card-soft); color: var(--propia-text-secondary); border: 1px solid var(--propia-border-card); }
    .fid-chip--brand { background: var(--propia-brand-soft); color: var(--propia-brand); border-color: var(--propia-brand-border); }
    .fid-chip--ok { background: var(--propia-ok-soft); color: var(--propia-ok); border-color: transparent; }
    .fid-chip--warn { background: var(--propia-warn-soft); color: var(--propia-warn); border-color: transparent; }
    .fid-chip--danger { background: var(--propia-danger-soft); color: var(--propia-danger); border-color: transparent; }
    .fid-datos { align-self: stretch; display: flex; flex-direction: column; gap: 1px; background: var(--propia-border-divider); border: 1px solid var(--propia-border-divider); border-radius: 11px; overflow: hidden; margin-top: 6px; }
    .fid-dato { background: var(--propia-bg-card); padding: 9px 13px; display: flex; justify-content: space-between; gap: 8px; align-items: center; }
    .fid-dato span { font-size: 11.5px; color: var(--propia-text-faint); font-weight: 600; white-space: nowrap; }
    .fid-dato b { font-size: 12px; font-weight: 700; color: var(--propia-text-body); text-align: right; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fid-lb { position: fixed; inset: 0; z-index: 5000; background: rgba(12,20,32,.82); display: flex; align-items: center; justify-content: center; padding: 32px; cursor: zoom-out; }
    .fid-lb img { max-width: 92vw; max-height: 92vh; object-fit: contain; border-radius: 10px; box-shadow: 0 12px 48px rgba(0,0,0,.5); }
    .fid-lb-x { position: absolute; top: 18px; right: 22px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255,255,255,.16); color: var(--propia-text-inverse); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .fid-lb-x:hover { background: rgba(255,255,255,.28); }
    /* Movil / tactil: sin hover, el boton de quitar queda siempre visible. */
    @@media (hover: none) { .fid-img-del { display: flex; } }
</style>

@code {
    [Parameter] public string? Seccion { get; set; }
    [Parameter] public string? ImagenUrl { get; set; }
    [Parameter] public string Iniciales { get; set; } = "";
    [Parameter] public bool Subiendo { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnSubir { get; set; }
    /// <summary>Opcional: si no se cablea, no aparece la X de quitar imagen.</summary>
    [Parameter] public EventCallback OnQuitar { get; set; }
    [Parameter] public IReadOnlyList<Chip> Chips { get; set; } = Array.Empty<Chip>();
    [Parameter] public IReadOnlyList<Dato> Datos { get; set; } = Array.Empty<Dato>();
    /// <summary>Contenido entre los chips y los datos (ej. el interruptor de reservable).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _ver;

    /// <summary>Tono: brand | ok | warn | danger | neutral.</summary>
    public record Chip(string Texto, string Tono = "neutral");
    public record Dato(string Etiqueta, string? Valor);

    /// <summary>Hasta 2 iniciales del nombre (ej. "Bomba Demo" -> "BD").</summary>
    public static string InicialesDe(string? nombre)
    {
        var partes = (nombre ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (partes.Length == 0) return "?";
        var s = partes.Length == 1 ? partes[0][..Math.Min(2, partes[0].Length)] : $"{partes[0][0]}{partes[1][0]}";
        return s.ToUpperInvariant();
    }
}
