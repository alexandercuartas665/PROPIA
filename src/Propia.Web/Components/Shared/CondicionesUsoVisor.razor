@* Enlace "Ver condiciones de uso" + visor flotante (texto + archivo PDF/imagen) de una zona o activo
   reservable. Lo usan Reservas (Nueva reserva) y el prestamo del activo. Si no hay ni texto ni archivo,
   no pinta nada. Solo lectura: el archivo se carga en la ficha (CondicionesArchivoAdjunto).
   Estilos en css/modules/condiciones-uso.css (prefijo cuv-). *@

@if (Hay)
{
    <button type="button" class="cuv-link" @onclick="() => _open = true" @onclick:stopPropagation="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
        @LinkTexto
    </button>
}

@if (_open && Hay)
{
    <div class="cuv-bd" @onclick="Cerrar" @onclick:stopPropagation="true">
        <div class="cuv-box" @onclick:stopPropagation="true" role="dialog" aria-label="Condiciones de uso">
            <div class="cuv-head">
                <div class="cuv-tt">
                    <div class="cuv-h">Condiciones de uso</div>
                    @if (!string.IsNullOrWhiteSpace(Titulo)) { <div class="cuv-s">@Titulo</div> }
                </div>
                <button type="button" class="cuv-x" title="Cerrar" @onclick="Cerrar">&times;</button>
            </div>
            <div class="cuv-body">
                @if (!string.IsNullOrWhiteSpace(Texto))
                {
                    <div class="cuv-txt">@Texto</div>
                }
                @if (!string.IsNullOrWhiteSpace(ArchivoUrl))
                {
                    <div class="cuv-file-h">
                        <span class="cuv-file-nom">@(ArchivoNombre ?? "Archivo de condiciones")</span>
                        <a class="cuv-open" href="@ArchivoUrl" target="_blank" rel="noopener">Abrir en pestaña</a>
                    </div>
                    @if (CondicionesArchivoAdjunto.EsPdf(ArchivoUrl, ArchivoNombre))
                    {
                        <iframe class="cuv-pdf" src="@ArchivoUrl" title="@(ArchivoNombre ?? "Condiciones de uso")"></iframe>
                    }
                    else
                    {
                        <img class="cuv-img" src="@ArchivoUrl" alt="@(ArchivoNombre ?? "Condiciones de uso")" />
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string? Texto { get; set; }
    [Parameter] public string? ArchivoUrl { get; set; }
    [Parameter] public string? ArchivoNombre { get; set; }
    [Parameter] public string LinkTexto { get; set; } = "Ver condiciones de uso";

    private bool _open;
    private bool Hay => !string.IsNullOrWhiteSpace(Texto) || !string.IsNullOrWhiteSpace(ArchivoUrl);
    private void Cerrar() => _open = false;
}
