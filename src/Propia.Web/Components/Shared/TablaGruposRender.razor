@typeparam T
@* Render recursivo COMPARTIDO del arbol de agrupacion (NodoGrupo<T> de TablaAgrupador). Pinta los
   encabezados de grupo por nivel (indent + contador por (sub)grupo); el modulo aporta SOLO el
   template de la fila hoja via FilaTemplate. Asi el anidamiento se ve IDENTICO en todos los modulos
   de la vista tabla (motor unico TablaAgrupador + render unico TablaGruposRender). Filas div-based. *@

@foreach (var nodo in Nodos)
{
    @* Cabecera de grupo. Por defecto: un banner flex a todo el ancho. Si el modulo aporta CabeceraTemplate
       (p. ej. para totales por columna alineados a su grid), ese template emite el encabezado completo y
       manda; los consumidores que no lo pasan siguen con el banner clasico. *@
    @if (CabeceraTemplate is not null)
    {
        @CabeceraTemplate(nodo)
    }
    else
    {
        <div class="tgr-hd tgr-l@(nodo.Nivel > 2 ? 2 : nodo.Nivel)" style="padding-left:@(12 + nodo.Nivel * 18)px;">
            <span class="tgr-tit">@nodo.Titulo</span>
            <span class="tgr-cnt">@nodo.Conteo</span>
        </div>
    }
    @if (nodo.EsHoja)
    {
        @foreach (var fila in nodo.Filas)
        {
            @FilaTemplate(fila)
        }
    }
    else
    {
        <TablaGruposRender T="T" Nodos="nodo.Subgrupos" FilaTemplate="FilaTemplate" CabeceraTemplate="CabeceraTemplate" />
    }
}

@code {
    /// <summary>Arbol de grupos ya construido por TablaAgrupador.Agrupar.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<NodoGrupo<T>> Nodos { get; set; } = System.Array.Empty<NodoGrupo<T>>();
    /// <summary>Template de la fila hoja (lo pinta el modulo: su fila de tabla habitual).</summary>
    [Parameter, EditorRequired] public RenderFragment<T> FilaTemplate { get; set; } = default!;
    /// <summary>Opcional: el modulo pinta el encabezado de grupo completo (totales por columna alineados a su
    /// grid). Si es null, se usa el banner clasico de una sola franja.</summary>
    [Parameter] public RenderFragment<NodoGrupo<T>>? CabeceraTemplate { get; set; }
}

<style>
    /* Encabezado de (sub)grupo: mas prominente en el 1er nivel, mas tenue al anidar (como .tbl-grp/.tbl-grp2 de la maqueta). */
    .tgr-hd { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-bottom: 1px solid var(--propia-border-divider); }
    .tgr-l0 { background: var(--propia-brand-soft-2, var(--propia-brand-soft)); }
    .tgr-l1 { background: var(--propia-bg-card-soft); }
    .tgr-l2 { background: var(--propia-bg-card); }
    .tgr-tit { font-size: 11.5px; font-weight: 800; letter-spacing: .3px; color: var(--propia-text-h1); }
    .tgr-cnt { font-size: 10.5px; font-weight: 700; color: var(--propia-text-faint); background: var(--propia-bg-card); border: 1px solid var(--propia-border-card); border-radius: 999px; padding: 1px 8px; }
</style>
