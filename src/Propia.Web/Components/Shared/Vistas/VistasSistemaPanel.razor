@* ================= Explorador "Vistas del sistema" (Mi Copropiedad, modulo 2.3) =================
   Arma tableros (widgets) sobre 8 datasets reales de la copropiedad. Las vistas se guardan COMPARTIDAS
   por copropiedad (/api/mi-copropiedad/vistas). Render client-side con VistasEngine. Ola 1: 4 tipos de
   vista (tarjetas / tabla / tabla pivote / grafico SVG), filtros, pivote, ancho + reorden, 8 semillas. *@
@using System.Text.Json
@using Propia.Application.Cartera
@using Propia.Application.Pqrsd
@using Propia.Application.Tareas
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime Js

<section class="pv-section">
    <div class="pv-topbar">
        <div>
            <div class="pv-title">Vistas del sistema</div>
            <div class="pv-sub">Explora y arma tableros a partir de los datos de tu copropiedad.</div>
        </div>
        <div class="pv-topbar-acts">
            <button class="pv-btn" @onclick="Restablecer" disabled="@_busy">Restablecer ejemplos</button>
            <button class="pv-btn pv-btn--primary" @onclick="NuevaVista" disabled="@_busy">+ Nueva vista</button>
        </div>
    </div>

    @if (_err is not null)
    {
        <div class="pv-section-err">@_err</div>
    }

    @if (_builderOpen)
    {
        var ds = Resolved(_draft.DsKey);
        <div class="pv-sum-card pv-build">
            <div class="pv-row">
                <span class="pv-lbl">Fuente</span>
                <div class="pv-src">
                    @foreach (var d in Datasets.Values)
                    {
                        <button class="pv-src-btn @(d.Key == _draft.DsKey ? "is-on" : null)" @onclick="() => CambiarFuente(d.Key)">@d.Label</button>
                    }
                </div>
            </div>
            <div class="pv-row">
                <span class="pv-lbl">Tipo</span>
                <div class="pv-seg">
                    @foreach (var (k, lbl) in Tipos)
                    {
                        <button class="pv-seg-b @(k == _draft.Kind ? "is-on" : null)" @onclick="() => CambiarTipo(k)">@lbl</button>
                    }
                </div>
            </div>
            <div class="pv-row">
                <span class="pv-lbl">Titulo</span>
                <input class="pv-in" style="flex:1;min-width:220px" placeholder="@TituloAuto(_draft)"
                       value="@_draft.Title" @oninput="e => _draft.Title = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="pv-row">
                <span class="pv-lbl">Filtros</span>
                @foreach (var f in _draft.Filters)
                {
                    <div class="pv-filter">
                        <select class="pv-in" @onchange="e => CambiarFiltroCampo(f, e.Value?.ToString())">
                            @foreach (var c in ds.Fields)
                            {
                                <option value="@c.Key" selected="@(c.Key == f.Field)">@c.Label</option>
                            }
                        </select>
                        <span class="pv-filter-eq">=</span>
                        <select class="pv-in" @onchange="e => f.Value = e.Value?.ToString() ?? string.Empty">
                            <option value="" selected="@(string.IsNullOrEmpty(f.Value))">(cualquiera)</option>
                            @foreach (var val in ValoresDe(ds, f.Field))
                            {
                                <option value="@val" selected="@(val == f.Value)">@val</option>
                            }
                        </select>
                        <button class="pv-filter-x" @onclick="() => _draft.Filters.Remove(f)">&times;</button>
                    </div>
                }
                <button class="pv-addf" @onclick="() => AgregarFiltro(ds)">+ Filtro</button>
            </div>

            @if (_draft.Kind == "pivot" || _draft.Kind == "chart")
            {
                <div class="pv-editgrid">
                    <div class="pv-field">
                        <span class="pv-field-l">Filas (agrupar por)</span>
                        <select class="pv-in" @onchange="e => _draft.RowDim = e.Value?.ToString() ?? string.Empty">
                            @foreach (var dim in ds.Dims)
                            {
                                <option value="@dim.Key" selected="@(dim.Key == _draft.RowDim)">@dim.Label</option>
                            }
                        </select>
                    </div>
                    <div class="pv-field">
                        <span class="pv-field-l">Columnas (opcional)</span>
                        <select class="pv-in" @onchange="e => _draft.ColDim = e.Value?.ToString() ?? string.Empty">
                            <option value="" selected="@(string.IsNullOrEmpty(_draft.ColDim))">&mdash; ninguna &mdash;</option>
                            @foreach (var dim in ds.Dims)
                            {
                                <option value="@dim.Key" selected="@(dim.Key == _draft.ColDim)">@dim.Label</option>
                            }
                        </select>
                    </div>
                    <div class="pv-field">
                        <span class="pv-field-l">Metrica</span>
                        @{ var opts = VistasEngine.MeasureOptions(ds); }
                        <select class="pv-in" @onchange="e => SetMetrica(ds, e.Value?.ToString())">
                            @for (int i = 0; i < opts.Count; i++)
                            {
                                <option value="@i" selected="@(VistasEngine.SameM(opts[i].M, _draft.Measure))">@opts[i].L</option>
                            }
                        </select>
                    </div>
                    @if (_draft.Kind == "chart")
                    {
                        <div class="pv-field">
                            <span class="pv-field-l">Grafico</span>
                            <div class="pv-seg">
                                @foreach (var (k, lbl) in Graficos)
                                {
                                    <button class="pv-seg-b @(k == _draft.Chart ? "is-on" : null)" @onclick="() => _draft.Chart = k">@lbl</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="pv-row" style="align-items:flex-start">
                    <span class="pv-lbl">Campos</span>
                    <div style="flex:1;min-width:240px">
                        <div class="pv-fieldgrid">
                            @foreach (var c in ds.Fields)
                            {
                                var on = EffectiveFields(_draft, ds).Contains(c.Key);
                                <div class="pv-fitem @(on ? "is-on" : null)" @onclick="() => ToggleCampo(ds, c.Key)">
                                    <span class="pv-fcb">&check;</span>
                                    <span class="pv-fitem-l">@c.Label</span>
                                </div>
                            }
                        </div>
                        <div class="pv-fieldhint">El primer campo (@CampoLabel(ds, ds.TitleField)) encabeza cada tarjeta.</div>
                    </div>
                </div>
            }

            <div class="pv-row">
                <span class="pv-lbl">Ancho</span>
                <div class="pv-seg">
                    @foreach (var (k, lbl) in VistasEngine.Anchos)
                    {
                        <button class="pv-seg-b @(k == _draft.Width ? "is-on" : null)" @onclick="() => _draft.Width = k">@lbl</button>
                    }
                </div>
            </div>

            <div class="pv-prev">
                <div class="pv-prev-l">Vista previa</div>
                @RenderBody(_draft)
            </div>

            <div class="pv-acts">
                <button class="pv-btn pv-btn--ghost" @onclick="CerrarBuilder">Cancelar</button>
                <button class="pv-btn pv-btn--primary" @onclick="GuardarDraft" disabled="@_busy">
                    @(_draftId is null ? "Crear vista" : "Guardar cambios")
                </button>
            </div>
        </div>
    }

    @if (!_ready)
    {
        <div class="pv-sum-empty">Cargando vistas&hellip;</div>
    }
    else if (_vistas.Count == 0 && !_builderOpen)
    {
        <div class="pv-sum-empty">Aun no hay vistas. Crea una con &ldquo;Nueva vista&rdquo; o restablece los ejemplos.</div>
    }
    else
    {
        <div class="pv-sum-grid">
            @foreach (var v in _vistas.OrderBy(x => x.Orden).ToList())
            {
                var d = v.Def;
                <div class="pv-sum-card pv-w-@d.Width" @key="v.Id">
                    <div class="pv-sum-top">
                        <div class="pv-sum-t">
                            <div class="pv-sum-tt">@Titulo(d)</div>
                            <div class="pv-sum-meta">@Meta(d)</div>
                        </div>
                        <button class="pv-icbtn" title="Subir" disabled="@(EsPrimera(v))" @onclick="() => Mover(v, -1)">&uarr;</button>
                        <button class="pv-icbtn" title="Bajar" disabled="@(EsUltima(v))" @onclick="() => Mover(v, 1)">&darr;</button>
                        <button class="pv-icbtn" title="Editar" @onclick="() => EditarVista(v)">&#9998;</button>
                        <button class="pv-icbtn pv-icbtn--x" title="Eliminar" @onclick="() => EliminarVista(v)">&times;</button>
                    </div>
                    @RenderBody(d)
                </div>
            }
        </div>
    }

    @* Modal de edicion de un registro (nativos + campos personalizados). Solo tarjetas/tabla. *@
    @if (_editOpen)
    {
        var flds = EditFieldsDe(_editDsKey);
        <div class="pv-modal-ov" @onclick="CerrarEdicion">
            <div class="pv-modal" @onclick:stopPropagation="true">
                <div class="pv-modal-hd"><div class="pv-title">Editar @_editTitulo</div></div>
                <div class="pv-modal-bd">
                    @if (_editErr is not null) { <div class="pv-section-err">@_editErr</div> }
                    <div class="pv-editgrid">
                        @foreach (var f in flds)
                        {
                            <label class="pv-field">
                                <span class="pv-field-l">@f.Label</span>
                                @if (f.Input == "bool")
                                {
                                    <select class="pv-in pv-in-full" @onchange="e => _editVals[f.Key] = e.Value?.ToString()">
                                        <option value="" selected="@(string.IsNullOrEmpty(_editVals.GetValueOrDefault(f.Key)))">(sin valor)</option>
                                        <option value="true" selected="@(_editVals.GetValueOrDefault(f.Key) == "true")">Si</option>
                                        <option value="false" selected="@(_editVals.GetValueOrDefault(f.Key) == "false")">No</option>
                                    </select>
                                }
                                else if (f.Input == "select" && f.Options is not null)
                                {
                                    <select class="pv-in pv-in-full" @onchange="e => _editVals[f.Key] = e.Value?.ToString()">
                                        <option value="" selected="@(string.IsNullOrEmpty(_editVals.GetValueOrDefault(f.Key)))">(sin valor)</option>
                                        @foreach (var op in f.Options)
                                        {
                                            <option value="@op" selected="@(_editVals.GetValueOrDefault(f.Key) == op)">@op</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="pv-in pv-in-full"
                                           type="@(f.Input is "number" or "money" ? "number" : f.Input == "date" ? "date" : "text")"
                                           value="@_editVals.GetValueOrDefault(f.Key)"
                                           @oninput="e => _editVals[f.Key] = e.Value?.ToString()" />
                                }
                            </label>
                        }
                    </div>
                </div>
                <div class="pv-modal-ft">
                    <button class="pv-btn pv-btn--ghost" @onclick="CerrarEdicion">Cancelar</button>
                    <button class="pv-btn pv-btn--primary" @onclick="GuardarEdicion" disabled="@_busy">Guardar cambios</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    // ----------------- Catalogo de datasets (dims para pivotar/filtrar, meas numericas, fields mostrables) -----------------
    private static readonly Dictionary<string, Dataset> Datasets = new()
    {
        ["residentes"] = new Dataset("residentes", "Residentes", "",
            Dims: new[] { new Campo("relacion", "Relacion"), new Campo("estado", "Estado"), new Campo("rol", "Rol") },
            Meas: Array.Empty<Medida>(),
            TitleField: "nombre",
            Fields: new[] { new Campo("nombre", "Nombre"), new Campo("documento", "Documento"), new Campo("relacion", "Relacion"), new Campo("unidad", "Unidad"), new Campo("rol", "Rol"), new Campo("celular", "Celular"), new Campo("email", "Correo"), new Campo("estado", "Estado") },
            DefFields: new[] { "relacion", "unidad", "celular", "email", "estado" }),

        ["unidades"] = new Dataset("unidades", "Unidades", "",
            Dims: new[] { new Campo("tipo", "Tipo"), new Campo("estado", "Estado"), new Campo("piso", "Piso") },
            Meas: new[] { new Medida("area", "Area (m2)", "num"), new Medida("coef", "Coeficiente", "num") },
            TitleField: "numero",
            Fields: new[] { new Campo("numero", "Numero"), new Campo("tipo", "Tipo"), new Campo("estado", "Estado"), new Campo("piso", "Piso"), new Campo("area", "Area (m2)"), new Campo("coef", "Coeficiente") },
            DefFields: new[] { "tipo", "estado", "piso", "area" }),

        ["cartera"] = new Dataset("cartera", "Cartera", "",
            Dims: new[] { new Campo("estado", "Estado de gestion") },
            Meas: new[] { new Medida("saldo", "Saldo total", "money"), new Medida("diasMora", "Dias de mora", "num") },
            TitleField: "unidad",
            Fields: new[] { new Campo("unidad", "Unidad"), new Campo("propietario", "Propietario"), new Campo("estado", "Estado de gestion"), new Campo("saldo", "Saldo total"), new Campo("diasMora", "Dias de mora") },
            DefFields: new[] { "unidad", "propietario", "saldo", "diasMora" }),

        ["pqrsd"] = new Dataset("pqrsd", "PQRSD", "",
            Dims: new[] { new Campo("tipo", "Tipo"), new Campo("estado", "Estado"), new Campo("categoria", "Categoria") },
            Meas: new[] { new Medida("dias", "Dias para vencer", "num") },
            TitleField: "radicado",
            Fields: new[] { new Campo("radicado", "Radicado"), new Campo("tipo", "Tipo"), new Campo("categoria", "Categoria"), new Campo("estado", "Estado"), new Campo("asunto", "Asunto"), new Campo("dias", "Dias para vencer") },
            DefFields: new[] { "radicado", "tipo", "estado", "asunto" }),

        ["tareas"] = new Dataset("tareas", "Tareas", "",
            Dims: new[] { new Campo("etapa", "Etapa"), new Campo("prioridad", "Prioridad") },
            Meas: new[] { new Medida("valor", "Valor", "money"), new Medida("progreso", "Progreso", "pct") },
            TitleField: "titulo",
            Fields: new[] { new Campo("numero", "Numero"), new Campo("titulo", "Titulo"), new Campo("etapa", "Etapa"), new Campo("prioridad", "Prioridad"), new Campo("valor", "Valor"), new Campo("progreso", "Progreso") },
            DefFields: new[] { "etapa", "prioridad", "progreso" }),

        ["contratos"] = new Dataset("contratos", "Contratos", "",
            Dims: new[] { new Campo("tipocontrato", "Tipo de contrato"), new Campo("categoria", "Categoria"), new Campo("estado", "Estado") },
            Meas: new[] { new Medida("valortotal", "Valor total", "money"), new Medida("valormensual", "Valor mensual", "money") },
            TitleField: "proveedor",
            Fields: new[] { new Campo("numero", "Numero"), new Campo("proveedor", "Proveedor"), new Campo("tipocontrato", "Tipo"), new Campo("categoria", "Categoria"), new Campo("estado", "Estado"), new Campo("valormensual", "Valor mensual"), new Campo("valortotal", "Valor total") },
            DefFields: new[] { "proveedor", "categoria", "estado", "valormensual" }),

        ["zonas"] = new Dataset("zonas", "Zonas comunes", "",
            Dims: new[] { new Campo("tipo", "Categoria"), new Campo("estado", "Estado"), new Campo("reservable", "Reservable") },
            Meas: new[] { new Medida("aforo", "Aforo", "num") },
            TitleField: "nombre",
            Fields: new[] { new Campo("nombre", "Nombre"), new Campo("tipo", "Categoria"), new Campo("estado", "Estado"), new Campo("reservable", "Reservable"), new Campo("aforo", "Aforo") },
            DefFields: new[] { "tipo", "estado", "aforo" }),

        ["equipos"] = new Dataset("equipos", "Equipos y activos", "",
            Dims: new[] { new Campo("tipo", "Categoria"), new Campo("estado", "Estado"), new Campo("marca", "Marca") },
            Meas: new[] { new Medida("valoradq", "Valor de adquisicion", "money") },
            TitleField: "nombre",
            Fields: new[] { new Campo("nombre", "Nombre"), new Campo("tipo", "Categoria"), new Campo("estado", "Estado"), new Campo("marca", "Marca"), new Campo("ubicacion", "Ubicacion"), new Campo("valoradq", "Valor de adquisicion") },
            DefFields: new[] { "tipo", "estado", "ubicacion" }),
    };

    private static readonly (string, string)[] Tipos = { ("cards", "Tarjetas"), ("table", "Tabla"), ("pivot", "Tabla pivote"), ("chart", "Grafico") };
    private static readonly (string, string)[] Graficos = { ("bars", "Barras"), ("lines", "Lineas"), ("donut", "Dona") };
    private static readonly JsonSerializerOptions JsonWeb = new(JsonSerializerDefaults.Web);

    private sealed class VistaItem { public Guid Id; public string Nombre = ""; public int Orden; public VistaDef Def = new(); }

    private string? _jwt;
    private bool _ready, _busy;
    private string? _err;
    private readonly List<VistaItem> _vistas = new();
    private readonly Dictionary<string, List<Dictionary<string, object?>>> _cache = new();

    // ----------------- Campos dinamicos (EAV) -----------------
    // Un registro-fila lleva claves fijas + "cd:{defId}" por cada campo personalizado. _id = id de la entidad
    // (edicion nativa); _eavId = id del registro para valores EAV (= _id salvo residentes, que usa UnidadPersonaId).
    private sealed record EavDef(Guid Id, string Label, int Orden, TipoCampoTablero Tipo, string? Opciones, string? Descripcion = null);
    private sealed record EavConfig(string DefsUrl, string ValuesUrl, string RecordIdKey);

    // Datasets con EAV por endpoints planos (MiCopropiedad). RecordIdKey = prop camelCase del id en el flat DTO.
    private static readonly Dictionary<string, EavConfig> Eav = new()
    {
        ["unidades"] = new("/api/mi-copropiedad/unidades-campos", "/api/mi-copropiedad/unidades-campos-valores", "unidadId"),
        ["zonas"] = new("/api/mi-copropiedad/zonas-campos", "/api/mi-copropiedad/zonas-campos-valores", "zonaComunId"),
        ["equipos"] = new("/api/mi-copropiedad/equipos-campos", "/api/mi-copropiedad/equipos-campos-valores", "equipoActivoId"),
        ["contratos"] = new("/api/mi-copropiedad/contratos-campos", "/api/mi-copropiedad/contratos-campos-valores", "contratoId"),
        ["residentes"] = new("/api/mi-copropiedad/personas-campos", "/api/mi-copropiedad/personas-campos-valores", "unidadPersonaId"),
    };

    private readonly Dictionary<string, List<EavDef>> _eavDefs = new();
    private readonly Dictionary<string, Dictionary<Guid, Dictionary<Guid, string?>>> _eavVals = new();
    private readonly Dictionary<string, Dataset> _resolved = new();

    private static bool EsNumerico(TipoCampoTablero t) =>
        t is TipoCampoTablero.Numero or TipoCampoTablero.Moneda or TipoCampoTablero.Porcentaje or TipoCampoTablero.Total;
    private static bool EsDimension(TipoCampoTablero t) =>
        t is TipoCampoTablero.Seleccion or TipoCampoTablero.Booleano;

    // Dataset "resuelto": fijo + campos EAV mezclados (dims/meas/fields). La maquina de pivote/grafico lo usa igual.
    private Dataset Resolved(string key)
    {
        if (_resolved.TryGetValue(key, out var cached)) return cached;
        var ds = Datasets[key];
        if (!_eavDefs.TryGetValue(key, out var defs) || defs.Count == 0) { _resolved[key] = ds; return ds; }
        var dims = ds.Dims.ToList();
        var meas = ds.Meas.ToList();
        var fields = ds.Fields.ToList();
        foreach (var d in defs.OrderBy(x => x.Orden))
        {
            if (d.Tipo == TipoCampoTablero.Separador) continue;
            var campo = new Campo("cd:" + d.Id, d.Label);
            fields.Add(campo);
            if (EsDimension(d.Tipo)) dims.Add(campo);
            if (EsNumerico(d.Tipo)) meas.Add(new Medida("cd:" + d.Id, d.Label,
                d.Tipo == TipoCampoTablero.Moneda ? "money" : d.Tipo == TipoCampoTablero.Porcentaje ? "pct" : "num"));
        }
        var res = ds with { Dims = dims, Meas = meas, Fields = fields };
        _resolved[key] = res;
        return res;
    }

    private bool _builderOpen;
    private Guid? _draftId;
    private VistaDef _draft = new();

    // ----------------- Ciclo de vida / carga -----------------
    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(_jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt);
        return http;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var stored = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (string.IsNullOrWhiteSpace(stored)) { _ready = true; StateHasChanged(); return; }
            _jwt = stored;
            await CargarVistasAsync();
            await CargarDatosNecesariosAsync();
            _ready = true;
            StateHasChanged();
        }
        catch { /* prerender */ }
    }

    private async Task<T?> GetJsonAsync<T>(string url)
    {
        try
        {
            var resp = await Auth().GetAsync(url);
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var nuevo = await Propia.Web.Services.SessionHelper.HandleUnauthorizedAsync(Js, Nav);
                if (nuevo is null) return default;
                _jwt = nuevo;
                resp = await Auth().GetAsync(url);
            }
            if (!resp.IsSuccessStatusCode) return default;
            return await resp.Content.ReadFromJsonAsync<T>();
        }
        catch { return default; }
    }

    private async Task CargarVistasAsync()
    {
        var dtos = await GetJsonAsync<List<VistaSistemaDto>>("/api/mi-copropiedad/vistas") ?? new();
        if (dtos.Count == 0)
        {
            // Primer arranque: sembrar los 8 ejemplos (reemplazar=false es atomico: solo si esta vacio).
            try
            {
                var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/vistas/sembrar?reemplazar=false", SemillasReq());
                if (resp.IsSuccessStatusCode) dtos = await resp.Content.ReadFromJsonAsync<List<VistaSistemaDto>>() ?? new();
            }
            catch { }
        }
        _vistas.Clear();
        foreach (var dto in dtos) _vistas.Add(FromDto(dto));
    }

    private async Task CargarDatosNecesariosAsync()
    {
        foreach (var k in _vistas.Select(v => v.Def.DsKey).Distinct().ToList())
            await AsegurarDatos(k);
    }

    private async Task AsegurarDatos(string ds)
    {
        if (_cache.ContainsKey(ds)) return;
        _cache[ds] = await CargarDataset(ds);
    }

    private static VistaItem FromDto(VistaSistemaDto dto) => new()
    {
        Id = dto.Id,
        Nombre = dto.Nombre,
        Orden = dto.Orden,
        Def = (string.IsNullOrWhiteSpace(dto.Definicion) ? null : JsonSerializer.Deserialize<VistaDef>(dto.Definicion, JsonWeb)) ?? new VistaDef()
    };

    // ----------------- Loaders: proyectan los DTOs reales a filas (dict). Enums -> ToString(). -----------------
    private async Task<List<Dictionary<string, object?>>> CargarDataset(string ds)
    {
        await AsegurarEav(ds);
        var rows = await CargarRows(ds);
        AttachEav(ds, rows);
        return rows;
    }

    // Carga definiciones + valores planos de campos personalizados del tenant para el dataset (una vez).
    private async Task AsegurarEav(string ds)
    {
        if (!Eav.TryGetValue(ds, out var cfg) || _eavDefs.ContainsKey(ds)) return;
        _eavDefs[ds] = await GetJsonAsync<List<EavDef>>(cfg.DefsUrl) ?? new();
        _resolved.Remove(ds); // forzar recomputo del dataset resuelto con los campos nuevos
        var map = new Dictionary<Guid, Dictionary<Guid, string?>>();
        try
        {
            var arr = await GetJsonAsync<List<Dictionary<string, JsonElement>>>(cfg.ValuesUrl) ?? new();
            foreach (var row in arr)
            {
                if (!row.TryGetValue(cfg.RecordIdKey, out var ridEl) || !row.TryGetValue("definicionId", out var didEl)) continue;
                if (!Guid.TryParse(ridEl.ValueKind == JsonValueKind.String ? ridEl.GetString() : ridEl.ToString(), out var rid)) continue;
                if (!Guid.TryParse(didEl.ValueKind == JsonValueKind.String ? didEl.GetString() : didEl.ToString(), out var did)) continue;
                string? val = row.TryGetValue("valor", out var vEl) && vEl.ValueKind == JsonValueKind.String ? vEl.GetString() : null;
                if (!map.TryGetValue(rid, out var inner)) { inner = new(); map[rid] = inner; }
                inner[did] = val;
            }
        }
        catch { }
        _eavVals[ds] = map;
    }

    // Pega los valores EAV en cada fila bajo "cd:{defId}" (numericos -> double para poder agregar).
    private void AttachEav(string ds, List<Dictionary<string, object?>> rows)
    {
        if (!_eavDefs.TryGetValue(ds, out var defs) || defs.Count == 0) return;
        _eavVals.TryGetValue(ds, out var map);
        foreach (var row in rows)
        {
            Dictionary<Guid, string?>? vals = null;
            if (map is not null && row.TryGetValue("_eavId", out var idObj) && idObj is Guid rid) map.TryGetValue(rid, out vals);
            foreach (var d in defs)
            {
                if (d.Tipo == TipoCampoTablero.Separador) continue;
                string? v = vals is not null && vals.TryGetValue(d.Id, out var vv) ? vv : null;
                object? stored = v;
                if (EsNumerico(d.Tipo) && v is not null &&
                    double.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var num))
                    stored = num;
                row["cd:" + d.Id] = stored;
            }
        }
    }

