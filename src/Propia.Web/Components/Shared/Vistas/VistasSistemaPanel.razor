    // ----------------- Helpers de render -----------------
    private List<Dictionary<string, object?>> Filtered(VistaDef d) =>
        _cache.TryGetValue(d.DsKey, out var rows) ? VistasEngine.ApplyFilters(rows, d.Filters) : new();

    private static List<string> EffectiveFields(VistaDef d, Dataset ds) =>
        d.Fields is { Count: > 0 } ? d.Fields : ds.DefFields.ToList();

    private static string CampoLabel(Dataset ds, string key) =>
        ds.Fields.FirstOrDefault(f => f.Key == key)?.Label ?? ds.Dims.FirstOrDefault(f => f.Key == key)?.Label ?? key;

    private static bool IsNum(Dataset ds, string key) => ds.Meas.Any(m => m.Key == key);

    private static string DisplayField(Dataset ds, IDictionary<string, object?> row, string key)
    {
        var med = ds.Meas.FirstOrDefault(m => m.Key == key);
        if (med is not null) return VistasEngine.FmtField(row.TryGetValue(key, out var x) ? x : null, med.Fmt);
        return VistasEngine.KeyVal(row, key);
    }

    private static string Inicial(string s) => string.IsNullOrWhiteSpace(s) || s == "(vacío)" ? "?" : s.Trim().Substring(0, 1).ToUpper();

    private string TituloAuto(VistaDef d)
    {
        var ds = Resolved(d.DsKey);
        return d.Kind is "pivot" or "chart" ? VistasEngine.AutoTitle(ds, d.RowDim, d.ColDim, d.Measure) : ds.Label;
    }
    private string Titulo(VistaDef d) => string.IsNullOrWhiteSpace(d.Title) ? TituloAuto(d) : d.Title.Trim();

    private string Meta(VistaDef d)
    {
        var ds = Resolved(d.DsKey);
        return d.Kind switch
        {
            "cards" => ds.Label + " · tarjetas",
            "table" => ds.Label + " · tabla",
            "pivot" => VistasEngine.MeasureLabel(d.Measure) + " por " + VistasEngine.DimLabel(ds, d.RowDim) + (string.IsNullOrEmpty(d.ColDim) ? "" : " y " + VistasEngine.DimLabel(ds, d.ColDim)),
            "chart" => (d.Chart == "donut" ? "Dona" : d.Chart == "lines" ? "Líneas" : "Barras") + " · " + ds.Label,
            _ => ds.Label
        };
    }

    private RenderFragment RenderBody(VistaDef d) => __builder =>
    {
        var ds = Resolved(d.DsKey);
        if (!_cache.ContainsKey(d.DsKey))
        {
            __builder.OpenElement(0, "div");
            __builder.AddAttribute(1, "class", "pv-empty");
            __builder.AddContent(2, "Cargando datos…");
            __builder.CloseElement();
            return;
        }
        var data = Filtered(d);
        if (d.Kind is "pivot")
        {
            __builder.AddMarkupContent(10, VistasEngine.PivotTable(ds, data, d.RowDim, d.ColDim, d.Measure));
        }
        else if (d.Kind is "chart")
        {
            __builder.AddMarkupContent(11, VistasEngine.ChartSvg(ds, data, d.RowDim, d.ColDim, d.Measure, d.Chart));
        }
        else if (data.Count == 0)
        {
            __builder.OpenElement(12, "div");
            __builder.AddAttribute(13, "class", "pv-empty");
            __builder.AddContent(14, "Sin registros para los filtros seleccionados.");
            __builder.CloseElement();
        }
        else
        {
            var fields = EffectiveFields(d, ds);
            var editable = EdicionDe(d.DsKey) is not null && EditFieldsDe(d.DsKey).Count > 0;
            if (d.Kind is "cards")
                RenderCards(__builder, ds, data, fields, editable);
            else
                RenderTable(__builder, ds, data, fields, editable);
        }
    };

    private void RenderCards(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, Dataset ds, List<Dictionary<string, object?>> data, List<string> fields, bool editable)
    {
        b.OpenElement(0, "div"); b.AddAttribute(1, "class", "pv-cards");
        int seq = 2;
        foreach (var row in data.Take(60))
        {
            b.OpenElement(seq++, "div"); b.AddAttribute(seq++, "class", "pv-pcard");
            b.OpenElement(seq++, "div"); b.AddAttribute(seq++, "class", "pv-pc-top");
            b.OpenElement(seq++, "div"); b.AddAttribute(seq++, "class", "pv-pc-av"); b.AddContent(seq++, Inicial(VistasEngine.KeyVal(row, ds.TitleField))); b.CloseElement();
            b.OpenElement(seq++, "div"); b.AddAttribute(seq++, "class", "pv-pc-id");
            b.OpenElement(seq++, "div"); b.AddAttribute(seq++, "class", "pv-pc-nm"); b.AddContent(seq++, VistasEngine.KeyVal(row, ds.TitleField)); b.CloseElement();
            b.CloseElement(); // id
            b.CloseElement(); // top
            b.OpenElement(seq++, "div"); b.AddAttribute(seq++, "class", "pv-pc-lines");
            foreach (var f in fields.Where(f => f != ds.TitleField))
            {
                b.OpenElement(seq++, "div"); b.AddAttribute(seq++, "class", "pv-pc-line");
                b.OpenElement(seq++, "span"); b.AddAttribute(seq++, "class", "pv-pc-ll"); b.AddContent(seq++, CampoLabel(ds, f)); b.CloseElement();
                b.OpenElement(seq++, "span"); b.AddAttribute(seq++, "class", "pv-pc-lv"); b.AddContent(seq++, DisplayField(ds, row, f)); b.CloseElement();
                b.CloseElement();
            }
            b.CloseElement(); // lines
            if (editable)
            {
                var rowRef = row;
                b.OpenElement(seq++, "div"); b.AddAttribute(seq++, "class", "pv-pc-acts");
                b.OpenElement(seq++, "button"); b.AddAttribute(seq++, "class", "pv-rowbtn");
                b.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => AbrirEdicion(ds.Key, rowRef)));
                b.AddContent(seq++, "✎ Editar");
                b.CloseElement();
                b.CloseElement();
            }
            b.CloseElement(); // pcard
        }
        b.CloseElement(); // cards
    }

    private void RenderTable(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, Dataset ds, List<Dictionary<string, object?>> data, List<string> fields, bool editable)
    {
        b.OpenElement(0, "div"); b.AddAttribute(1, "class", "pv-tablewrap");
        b.OpenElement(2, "table"); b.AddAttribute(3, "class", "pv-table");
        b.OpenElement(4, "thead"); b.OpenElement(5, "tr");
        int seq = 6;
        foreach (var f in fields)
        {
            b.OpenElement(seq++, "th");
            if (IsNum(ds, f)) b.AddAttribute(seq++, "class", "pv-num");
            b.AddContent(seq++, CampoLabel(ds, f));
            b.CloseElement();
        }
        if (editable) { b.OpenElement(seq++, "th"); b.AddAttribute(seq++, "class", "pv-rowact"); b.CloseElement(); }
        b.CloseElement(); b.CloseElement(); // tr thead
        b.OpenElement(seq++, "tbody");
        foreach (var row in data.Take(200))
        {
            b.OpenElement(seq++, "tr");
            foreach (var f in fields)
            {
                b.OpenElement(seq++, "td");
                if (IsNum(ds, f)) b.AddAttribute(seq++, "class", "pv-num");
                b.AddContent(seq++, DisplayField(ds, row, f));
                b.CloseElement();
            }
            if (editable)
            {
                var rowRef = row;
                b.OpenElement(seq++, "td"); b.AddAttribute(seq++, "class", "pv-rowact");
                b.OpenElement(seq++, "button"); b.AddAttribute(seq++, "class", "pv-rowbtn"); b.AddAttribute(seq++, "title", "Editar");
                b.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => AbrirEdicion(ds.Key, rowRef)));
                b.AddContent(seq++, "✎");
                b.CloseElement();
                b.CloseElement();
            }
            b.CloseElement();
        }
        b.CloseElement(); // tbody
        b.CloseElement(); // table
        b.CloseElement(); // wrap
    }

    private List<string> ValoresDe(Dataset ds, string field) =>
        _cache.TryGetValue(ds.Key, out var rows) ? VistasEngine.Distinct(rows, field) : new();

    // ----------------- Builder -----------------
    private void NuevaVista()
    {
        _err = null;
        _draftId = null;
        _draft = new VistaDef { Kind = "table" };
        AplicarFuente("residentes");
        _builderOpen = true;
        _ = AsegurarDatosYRefrescar("residentes");
    }

    private async Task AsegurarDatosYRefrescar(string ds)
    {
        await AsegurarDatos(ds);
        StateHasChanged();
    }

    private void CambiarFuente(string key)
    {
        AplicarFuente(key);
        _ = AsegurarDatosYRefrescar(key);
    }

    private void AplicarFuente(string key)
    {
        var ds = Resolved(key);
        _draft.DsKey = key;
        _draft.Filters.Clear();
        _draft.RowDim = ds.Dims.FirstOrDefault()?.Key ?? "";
        _draft.ColDim = "";
        _draft.Measure = new Metrica("count");
        _draft.Fields = ds.DefFields.ToList();
        // Si el dataset no tiene dimensiones utiles para pivote/grafico (no deberia pasar), cae a tabla.
        if (_draft.Kind is "pivot" or "chart" && ds.Dims.Count == 0) _draft.Kind = "table";
    }

    private void CambiarTipo(string kind)
    {
        _draft.Kind = kind;
        var ds = Resolved(_draft.DsKey);
        if (kind is "pivot" or "chart" && string.IsNullOrEmpty(_draft.RowDim))
            _draft.RowDim = ds.Dims.FirstOrDefault()?.Key ?? "";
    }

    private void CambiarFiltroCampo(Filtro f, string? field)
    {
        f.Field = field ?? "";
        f.Value = "";
    }

    private void AgregarFiltro(Dataset ds)
    {
        var first = ds.Fields.FirstOrDefault()?.Key ?? "";
        _draft.Filters.Add(new Filtro { Field = first, Value = "" });
    }

    private void SetMetrica(Dataset ds, string? idxStr)
    {
        if (int.TryParse(idxStr, out var i))
        {
            var opts = VistasEngine.MeasureOptions(ds);
            if (i >= 0 && i < opts.Count) _draft.Measure = opts[i].M;
        }
    }

    private void ToggleCampo(Dataset ds, string key)
    {
        _draft.Fields ??= new();
        if (_draft.Fields.Count == 0) _draft.Fields = ds.DefFields.ToList();
        if (_draft.Fields.Contains(key)) _draft.Fields.Remove(key);
        else _draft.Fields.Add(key);
    }

    private void CerrarBuilder()
    {
        _builderOpen = false;
        _draftId = null;
        _err = null;
    }

    private void EditarVista(VistaItem v)
    {
        _err = null;
        _draftId = v.Id;
        _draft = JsonSerializer.Deserialize<VistaDef>(JsonSerializer.Serialize(v.Def, JsonWeb), JsonWeb) ?? new VistaDef();
        _builderOpen = true;
        _ = AsegurarDatosYRefrescar(_draft.DsKey);
    }

    private async Task GuardarDraft()
    {
        _busy = true; _err = null;
        try
        {
            var json = JsonSerializer.Serialize(_draft, JsonWeb);
            if (_draftId is null)
            {
                var orden = _vistas.Count == 0 ? 0 : _vistas.Max(v => v.Orden) + 1;
                var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/vistas", new GuardarVistaRequest(TituloGuardar(_draft), orden, json));
                if (!resp.IsSuccessStatusCode) { _err = "No se pudo crear la vista. Verifica que tengas permiso de edicion de Mi Copropiedad."; return; }
                var dto = await resp.Content.ReadFromJsonAsync<VistaSistemaDto>();
                if (dto is not null) _vistas.Add(FromDto(dto));
            }
            else
            {
                var item = _vistas.FirstOrDefault(v => v.Id == _draftId);
                if (item is null) { CerrarBuilder(); return; }
                var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/vistas/{_draftId}", new GuardarVistaRequest(TituloGuardar(_draft), item.Orden, json));
                if (!resp.IsSuccessStatusCode) { _err = "No se pudo guardar la vista. Verifica que tengas permiso de edicion de Mi Copropiedad."; return; }
                item.Nombre = TituloGuardar(_draft);
                item.Def = _draft;
            }
            await AsegurarDatos(_draft.DsKey);
            CerrarBuilder();
        }
        catch (Exception ex) { _err = "Error al guardar: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarVista(VistaItem v)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Eliminar la vista \"{Titulo(v.Def)}\"?")) return;
        _busy = true; _err = null;
        try
        {
            var resp = await Auth().DeleteAsync($"/api/mi-copropiedad/vistas/{v.Id}");
            if (resp.IsSuccessStatusCode) _vistas.Remove(v);
            else _err = "No se pudo eliminar la vista (permiso de edicion requerido).";
        }
        catch (Exception ex) { _err = "Error al eliminar: " + ex.Message; }
        finally { _busy = false; }
    }

    private bool EsPrimera(VistaItem v) => _vistas.OrderBy(x => x.Orden).FirstOrDefault() == v;
    private bool EsUltima(VistaItem v) => _vistas.OrderBy(x => x.Orden).LastOrDefault() == v;

    private async Task Mover(VistaItem v, int dir)
    {
        var ord = _vistas.OrderBy(x => x.Orden).ToList();
        var i = ord.IndexOf(v);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= ord.Count) return;
        (ord[i], ord[j]) = (ord[j], ord[i]);
        for (int k = 0; k < ord.Count; k++) ord[k].Orden = k;
        try { await Auth().PutAsJsonAsync("/api/mi-copropiedad/vistas/orden", new ReordenarVistasRequest(ord.Select(x => x.Id).ToList())); }
        catch { }
    }

    private async Task Restablecer()
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Esto reemplaza las vistas actuales por los 8 ejemplos. Continuar?")) return;
        _busy = true; _err = null;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/api/mi-copropiedad/vistas/sembrar?reemplazar=true", SemillasReq());
            if (!resp.IsSuccessStatusCode) { _err = "No se pudo restablecer (permiso de edicion requerido)."; return; }
            var dtos = await resp.Content.ReadFromJsonAsync<List<VistaSistemaDto>>() ?? new();
            _vistas.Clear();
            foreach (var dto in dtos) _vistas.Add(FromDto(dto));
            CerrarBuilder();
            await CargarDatosNecesariosAsync();
        }
        catch (Exception ex) { _err = "Error al restablecer: " + ex.Message; }
        finally { _busy = false; }
    }

    private string TituloGuardar(VistaDef d) => string.IsNullOrWhiteSpace(d.Title) ? TituloAuto(d) : d.Title.Trim();

