    private sealed record DsEdit(
        List<EditField> Natives,
        Func<Dictionary<string, object?>, Dictionary<string, string?>, Task<bool>> SaveNatives,
        Func<Guid, Guid, string?, Task<bool>> SaveEav);

    private bool _editOpen;
    private string _editDsKey = "", _editTitulo = "";
    private Dictionary<string, object?>? _editRowRef;
    private string? _editErr;
    private readonly Dictionary<string, string?> _editVals = new();
    private readonly Dictionary<string, string?> _editOrig = new();

    private static readonly string[] EstadosContrato = Enum.GetNames<EstadoContrato>();
    private static readonly string[] EstadosZona = Enum.GetNames<EstadoZonaComunMantenimiento>();

    // Campos nativos editables por dataset (solo los que ya cargamos en la fila; el resto se preserva via _dto).
