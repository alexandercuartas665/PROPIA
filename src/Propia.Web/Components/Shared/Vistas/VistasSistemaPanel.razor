    };

    private DsEdit? EdicionDe(string ds) => ds switch
    {
        "equipos" => new(EquipoNativos, GuardarEquipoNativos, (id, def, val) => SetEavMiCopropiedad("equipos", id, def, val)),
        "unidades" => new(UnidadNativos, GuardarUnidadNativos, (id, def, val) => SetEavMiCopropiedad("unidades", id, def, val)),
        "zonas" => new(ZonaNativos, GuardarZonaNativos, (id, def, val) => SetEavMiCopropiedad("zonas", id, def, val)),
        "contratos" => new(ContratoNativos, GuardarContratoNativos, SetEavContrato),
        // Residentes: solo campos personalizados. Los datos de la persona (nombre, foto, nacimiento...) no
        // vienen completos en el listado, asi que se editan en el Directorio para no perder informacion.
        "residentes" => new(new List<EditField>(), (_, _) => Task.FromResult(true), SetEavPersonas),
        _ => null
    };

    // Campos editables del modal: nativos del dataset + personalizados (EAV) editables (se omiten computados).
    private List<EditField> EditFieldsDe(string ds)
    {
        var list = new List<EditField>();
        var cfg = EdicionDe(ds);
        if (cfg is not null) list.AddRange(cfg.Natives);
        if (_eavDefs.TryGetValue(ds, out var defs))
            foreach (var d in defs.OrderBy(x => x.Orden))
            {
                if (d.Tipo is TipoCampoTablero.Separador or TipoCampoTablero.Total or TipoCampoTablero.Formula) continue;
                list.Add(new EditField("cd:" + d.Id, d.Label, EavInput(d.Tipo), null));
            }
        return list;
    }

    private static string EavInput(TipoCampoTablero t) => t switch
    {
        TipoCampoTablero.Numero or TipoCampoTablero.Moneda or TipoCampoTablero.Porcentaje => "number",
        TipoCampoTablero.Booleano => "bool",
        TipoCampoTablero.Fecha => "date",
        _ => "text"
    };

    private static string? CurrentEditVal(Dictionary<string, object?> row, EditField f)
    {
        var v = row.TryGetValue(f.Key, out var x) ? x : null;
        return v switch
        {
            null => null,
            bool b => b ? "true" : "false",
            double dd => dd.ToString(System.Globalization.CultureInfo.InvariantCulture),
            decimal de => de.ToString(System.Globalization.CultureInfo.InvariantCulture),
            _ => v.ToString()
        };
    }

    private void AbrirEdicion(string dsKey, Dictionary<string, object?> row)
    {
        _editDsKey = dsKey; _editRowRef = row; _editErr = null;
        _editTitulo = VistasEngine.KeyVal(row, Resolved(dsKey).TitleField);
        _editVals.Clear(); _editOrig.Clear();
        foreach (var f in EditFieldsDe(dsKey))
        {
            var cur = CurrentEditVal(row, f);
            _editVals[f.Key] = cur;
            _editOrig[f.Key] = cur;
        }
        _editOpen = true;
    }

    private void CerrarEdicion() { _editOpen = false; _editRowRef = null; _editErr = null; }

    private async Task GuardarEdicion()
    {
        if (_editRowRef is null) return;
        var cfg = EdicionDe(_editDsKey);
        if (cfg is null) { CerrarEdicion(); return; }
        _busy = true; _editErr = null;
        try
        {
            var nativeKeys = cfg.Natives.Select(n => n.Key).ToHashSet();
            if (nativeKeys.Any(k => _editVals.GetValueOrDefault(k) != _editOrig.GetValueOrDefault(k)))
            {
                var natEdits = nativeKeys.ToDictionary(k => k, k => _editVals.GetValueOrDefault(k));
                if (!await cfg.SaveNatives(_editRowRef, natEdits))
                { _editErr = "No se pudieron guardar los campos del registro (se requiere permiso de edicion)."; return; }
            }
            if (_editRowRef.TryGetValue("_eavId", out var eidObj) && eidObj is Guid eid && _eavDefs.TryGetValue(_editDsKey, out var defs))
            {
                foreach (var d in defs)
                {
                    var key = "cd:" + d.Id;
                    if (!_editVals.ContainsKey(key) || _editVals[key] == _editOrig.GetValueOrDefault(key)) continue;
                    var val = string.IsNullOrEmpty(_editVals[key]) ? null : _editVals[key];
                    if (!await cfg.SaveEav(eid, d.Id, val))
                    { _editErr = "No se pudo guardar un campo personalizado (se requiere permiso de edicion)."; return; }
                }
            }
            _cache.Remove(_editDsKey);
            _eavDefs.Remove(_editDsKey); _eavVals.Remove(_editDsKey); _resolved.Remove(_editDsKey);
            await AsegurarDatos(_editDsKey);
            CerrarEdicion();
        }
        catch (Exception ex) { _editErr = "Error al guardar: " + ex.Message; }
        finally { _busy = false; }
    }

    private static string? NzNull(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    private static decimal? ParseDec(string? s) =>
        decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;
    private static int? ParseInt(string? s) =>
        int.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;

    // EAV set-value para entidades MiCopropiedad con ruta /{prefijo}/{id}/campos/{defId} (equipos, unidades, zonas).
    private async Task<bool> SetEavMiCopropiedad(string prefix, Guid id, Guid defId, string? val)
    {
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/{prefix}/{id}/campos/{defId}",
            new Propia.Application.MiCopropiedad.SetCampoValorRequest(val));
        return resp.IsSuccessStatusCode;
    }

    // Reconstruye el request completo desde el DTO cargado + ediciones (sin perder campos no mostrados).
    private async Task<bool> GuardarEquipoNativos(Dictionary<string, object?> row, Dictionary<string, string?> edits)
    {
        if (row["_dto"] is not EquipoActivoDto e) return false;
        var req = new ActualizarEquipoActivoRequest(
            Nombre: string.IsNullOrWhiteSpace(edits.GetValueOrDefault("nombre")) ? e.Nombre : edits["nombre"]!.Trim(),
            Categoria: e.Categoria, Tipo: e.Tipo, Cantidad: e.Cantidad, EsReservable: e.EsReservable,
            Modelo: e.Modelo, NumeroSerie: e.NumeroSerie, FechaInstalacion: e.FechaInstalacion, GarantiaHasta: e.GarantiaHasta,
            Ubicacion: edits.ContainsKey("ubicacion") ? NzNull(edits["ubicacion"]) : e.Ubicacion,
            Observaciones: e.Observaciones, VidaUtilAnios: e.VidaUtilAnios, FechaAdquisicion: e.FechaAdquisicion,
            ValorAdquisicion: edits.ContainsKey("valoradq") ? ParseDec(edits["valoradq"]) : e.ValorAdquisicion,
            Proveedor: e.Proveedor, NumeroFactura: e.NumeroFactura,
            CodigoBarra: e.CodigoBarra, CondicionesUso: e.CondicionesUso,
            Marca: edits.ContainsKey("marca") ? NzNull(edits["marca"]) : e.Marca);
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/equipos/{e.Id}", req);
        return resp.IsSuccessStatusCode;
    }

    private async Task<bool> GuardarUnidadNativos(Dictionary<string, object?> row, Dictionary<string, string?> edits)
    {
        if (row["_dto"] is not UnidadDto u) return false;
        var req = new ActualizarUnidadRequest(
            Numero: u.Numero, Tipo: u.Tipo,
            Piso: edits.ContainsKey("piso") ? ParseInt(edits["piso"]) : u.Piso,
            CoeficientePropiedad: u.CoeficientePropiedad,
            AreaM2: edits.ContainsKey("area") ? ParseDec(edits["area"]) : u.AreaM2,
            Habitaciones: u.Habitaciones, Banos: u.Banos, Parqueaderos: u.Parqueaderos,
            Estado: edits.ContainsKey("estado") ? NzNull(edits["estado"]) : u.Estado,
            Observaciones: u.Observaciones, MatriculaInmobiliaria: u.MatriculaInmobiliaria,
            PagaAdministracion: u.PagaAdministracion, CuotaMensual: u.CuotaMensual,
            ReferenciaPago: u.ReferenciaPago, TipoCustomId: u.TipoCustomId,
            ModuloContributivo1: u.ModuloContributivo1, ModuloContributivo2: u.ModuloContributivo2,
            ModuloContributivo3: u.ModuloContributivo3, ModuloContributivo4: u.ModuloContributivo4,
            ModuloContributivo5: u.ModuloContributivo5);
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/unidades/{u.Id}", req);
        return resp.IsSuccessStatusCode;
    }

    private async Task<bool> GuardarZonaNativos(Dictionary<string, object?> row, Dictionary<string, string?> edits)
    {
        if (row["_dto"] is not ZonaComunDto z) return false;
        var estado = edits.ContainsKey("estado") && Enum.TryParse<EstadoZonaComunMantenimiento>(edits["estado"], out var es) ? es : z.Estado;
        bool? reservable = z.EsReservable;
        if (edits.TryGetValue("reservable", out var rv)) reservable = rv == "true" ? true : rv == "false" ? false : z.EsReservable;
        var req = new ActualizarZonaComunRequest(
            Nombre: string.IsNullOrWhiteSpace(edits.GetValueOrDefault("nombre")) ? z.Nombre : edits["nombre"]!.Trim(),
            Categoria: z.Categoria, Descripcion: z.Descripcion,
            TarifaReserva: z.TarifaReserva, ReglasUso: z.ReglasUso, Estado: estado,
            EsReservable: reservable,
            CapacidadPersonas: edits.ContainsKey("aforo") ? ParseInt(edits["aforo"]) : z.CapacidadPersonas);
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/zonas/{z.Id}", req);
        return resp.IsSuccessStatusCode;
    }

    private async Task<bool> GuardarContratoNativos(Dictionary<string, object?> row, Dictionary<string, string?> edits)
    {
        if (row["_dto"] is not ContratoServicioDto k) return false;
        var estado = edits.ContainsKey("estado") && Enum.TryParse<EstadoContrato>(edits["estado"], out var es) ? es : k.Estado;
        var req = new ActualizarContratoRequest(
            Estado: estado, DiasAnticipacionAlerta: k.DiasAnticipacionAlerta,
            Proveedor: edits.ContainsKey("proveedor") ? NzNull(edits["proveedor"]) : k.Proveedor,
            ValorMensual: edits.ContainsKey("valormensual") ? ParseDec(edits["valormensual"]) : k.ValorMensual,
            NumeroContrato: k.NumeroContrato,
            TipoContrato: edits.ContainsKey("tipocontrato") ? NzNull(edits["tipocontrato"]) : k.TipoContrato,
            Categoria: edits.ContainsKey("categoria") ? NzNull(edits["categoria"]) : k.Categoria,
            ValorTotal: edits.ContainsKey("valortotal") ? ParseDec(edits["valortotal"]) : k.ValorTotal);
        var resp = await Auth().PutAsJsonAsync($"/api/mi-copropiedad/contratos/{k.Id}", req);
        return resp.IsSuccessStatusCode;
    }

