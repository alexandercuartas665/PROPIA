@* Selector de vista COMPARTIDO de la vista tabla: Tarjetas · Tabla · Calendario · Gantt (las que el modulo
   ofrezca, en su orden). Fuente UNICA del diseno: calca el .dst-viewtoggle de Unidades (pildora segmentada,
   37px de alto), milimetrico a la maqueta. Antes cada modulo tenia su propia copia y habia 4 tamanos distintos
   (30/31/34/37px). Va al FINAL de la barra (tras Columnas/Campos), como en el resto de modulos.
   Mismo patron que TablaOrdenarMenu / TablaAgruparMenu / TablaColumnasMenu: el componente solo pinta; el
   modulo guarda la vista, la persiste y recarga en OnCambiar.
   Uso:
     <TablaVistaToggle Opciones="@(new[] { TablaVistaToggle.Tarjetas("cards"), TablaVistaToggle.Tabla("list") })"
                       Valor="@_view" OnCambiar="SetVista" /> *@

<div class="tvt">
    @foreach (var o in Opciones)
    {
        var key = o.Key;
        <button type="button" class="tvt-btn @(string.Equals(Valor, key, StringComparison.Ordinal) ? "on" : "")" title="@o.Label" @onclick="() => Cambiar(key)">
            @switch (o.Icono)
            {
                case "tarjetas":
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    break;
                case "tabla":
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                    break;
                case "calendario":
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    break;
                case "gantt":
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h10M3 12h14M3 18h7"/></svg>
                    break;
            }
            <span>@o.Label</span>
        </button>
    }
</div>

@code {
    /// <summary>Una vista ofrecida: clave del modulo (la que guarda/persiste), etiqueta visible e icono canonico
    /// ("tarjetas" | "tabla" | "calendario" | "gantt").</summary>
    public sealed record Opcion(string Key, string Label, string Icono);

    /// <summary>Opciones canonicas: el modulo solo indica SU clave interna (p.ej. "cards", "lista", "tablero").</summary>
    public static Opcion Tarjetas(string key = "tarjetas") => new(key, "Tarjetas", "tarjetas");
    public static Opcion Tabla(string key = "tabla") => new(key, "Tabla", "tabla");
    public static Opcion Calendario(string key = "calendario") => new(key, "Calendario", "calendario");
    public static Opcion Gantt(string key = "gantt") => new(key, "Gantt", "gantt");

    /// <summary>Vistas a ofrecer, en orden (canon: Tarjetas, Tabla, Calendario, Gantt).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Opcion> Opciones { get; set; } = Array.Empty<Opcion>();
    /// <summary>Clave de la vista activa.</summary>
    [Parameter] public string? Valor { get; set; }
    /// <summary>Se dispara con la clave elegida; el modulo cambia de vista y la persiste.</summary>
    [Parameter] public EventCallback<string> OnCambiar { get; set; }

    private Task Cambiar(string key) => OnCambiar.InvokeAsync(key);
}

<style>
    /* Pildora segmentada canon (= .dst-viewtoggle de Unidades). margin-left:auto: queda a la derecha de la
       barra y, si la barra se parte en pantallas angostas, baja alineado a la derecha. Relleno lateral 12px
       (Unidades usaba 15) para que barras con "Campos" o 4 vistas quepan en una fila a 1440px. */
    .tvt { display: inline-flex; gap: 3px; background: var(--propia-bg-app); border: 1px solid var(--propia-border-card); border-radius: 11px; padding: 4px; margin-left: auto; flex-shrink: 0; }
    .tvt-btn { display: inline-flex; align-items: center; gap: 7px; border: 0; background: transparent; color: var(--propia-text-secondary); font-size: 13px; font-weight: 600; padding: 8px 12px; border-radius: 8px; cursor: pointer; font-family: inherit; white-space: nowrap; transition: background .14s, color .14s, box-shadow .14s; }
    .tvt-btn svg { opacity: .9; flex-shrink: 0; }
    .tvt-btn:hover { color: var(--propia-text-body); background: var(--propia-bg-hover); }
    .tvt-btn.on { background: var(--propia-bg-card); color: var(--propia-brand); box-shadow: var(--propia-shadow-card); }
    .tvt-btn.on svg { opacity: 1; }
    @@media (max-width: 640px) {
        .tvt { margin-left: 0; }
        .tvt-btn { padding: 8px 10px; }
    }
</style>
