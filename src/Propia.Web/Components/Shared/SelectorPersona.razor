@* SelectorPersona - control reutilizable para vincular una persona en cualquier ficha.

   Tres fases, en este orden:
     1. AUTOCOMPLETADO sobre TODAS las copropiedades de la organizacion (min. 3 letras).
     2. Si el candidato ya esta en esta copropiedad -> se asigna directo.
        Si existe pero en OTRA copropiedad -> al elegirlo se le crea el vinculo con la
        actual. La persona NO se duplica: es una fila global identificada por documento.
     3. Si no existe en ningun lado -> se crea desde la misma lista, sin salir del formulario.

   Reemplaza los formularios sueltos de documento+nombres+apellidos repartidos por las
   fichas, que creaban personas invisibles para el resto del sistema.

   No maneja sesion: recibe el Jwt del contenedor, como los demas componentes compartidos. *@

@using Propia.Application.Directorio
@using Propia.Domain.Enums
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS

<div class="sp">
    @if (Seleccionada is not null)
    {
        @* Ya hay persona elegida: se muestra como chip con opcion de cambiarla. *@
        <div class="sp-chip">
            <span class="sp-chip-ava">@Iniciales(Seleccionada.NombreCompleto)</span>
            <div class="sp-chip-body">
                <div class="sp-chip-nom">@Seleccionada.NombreCompleto</div>
                <div class="sp-chip-doc">@Seleccionada.TipoDocumento @Seleccionada.DocumentoEnmascarado</div>
            </div>
            <button type="button" class="sp-chip-x" title="Cambiar persona" @onclick="Limpiar">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
        </div>
    }
    else
    {
        <div class="sp-search" @ref="_anchorRef">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            @* Sin value=: en Blazor Server reafirmarlo en cada re-render se come pulsaciones. *@
            <input class="sp-search-inp" placeholder="@Placeholder" @oninput="OnBuscarInput" @onkeydown="OnKeydown" />
            @if (_buscando) { <span class="sp-spin"></span> }
        </div>

        @if (_q.Length > 0)
        {
        <div class="sp-pop @(Flotante ? "sp-pop--float" : "")" style="@(Flotante ? _popStyle : null)" @ref="_popRef">
        @if (_q.Length < 3)
        {
            <div class="sp-hint">Escribe al menos 3 letras del nombre o del documento.</div>
        }
        else
        {
            <div class="sp-list">
                @foreach (var c in _candidatos)
                {
                    var cand = c;
                    <button type="button" class="sp-item" @onclick="() => ElegirAsync(cand)" disabled="@_busy">
                        <span class="sp-item-ava">@Iniciales(c.NombreCompleto)</span>
                        <span class="sp-item-body">
                            <span class="sp-item-nom">@c.NombreCompleto</span>
                            <span class="sp-item-meta">
                                @c.TipoDocumento @c.DocumentoEnmascarado
                                @if (!c.EnEstaCopropiedad && c.Copropiedades.Count > 0)
                                {
                                    <span class="sp-item-otra">&middot; en @string.Join(", ", c.Copropiedades)</span>
                                }
                            </span>
                        </span>
                        @if (c.EnEstaCopropiedad)
                        {
                            <span class="sp-badge sp-badge--aqui">Aqui</span>
                        }
                        else
                        {
                            <span class="sp-badge sp-badge--traer">Traer</span>
                        }
                    </button>
                }

                @if (!_buscando && _candidatos.Count == 0)
                {
                    <div class="sp-vacio">Nadie coincide con "@_q" en tus copropiedades.</div>
                }

                @* Fase 3: crear sin salir del formulario. *@
                @if (!_creando)
                {
                    <button type="button" class="sp-nueva" @onclick="AbrirCrear">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
                        Crear @(PermiteEmpresa ? "contacto" : "persona") nuevo
                    </button>
                }
                else
                {
                    <div class="sp-form">
                        @* Persona natural o empresa (tercero juridico). El toggle solo aparece donde el
                           contenedor lo habilita: en un propietario, un residente o un proveedor tiene
                           sentido una empresa; en otros contextos no. *@
                        @if (PermiteEmpresa)
                        {
                            <div class="sp-tipos">
                                <button type="button" class="sp-tipo @(_nuevoEsEmpresa ? "" : "on")" @onclick="() => _nuevoEsEmpresa = false">Persona natural</button>
                                <button type="button" class="sp-tipo @(_nuevoEsEmpresa ? "on" : "")" @onclick="() => _nuevoEsEmpresa = true">Empresa</button>
                            </div>
                        }

                        @if (!_nuevoEsEmpresa)
                        {
                            <div class="sp-form-row">
                                <select class="sp-inp sp-inp-tipo" @bind="_nuevoTipoDoc">
                                    @foreach (var t in Enum.GetValues<TipoDocumento>().Where(t => t != TipoDocumento.NIT)) { <option value="@t">@t</option> }
                                </select>
                                <input class="sp-inp sp-grow" placeholder="Documento"
                                       @bind="_nuevoDoc" @bind:event="oninput" />
                            </div>
                            <div class="sp-form-row">
                                <input class="sp-inp sp-grow" placeholder="Nombres"
                                       @bind="_nuevoNombres" @bind:event="oninput" />
                                <input class="sp-inp sp-grow" placeholder="Apellidos"
                                       @bind="_nuevoApellidos" @bind:event="oninput" />
                            </div>
                        }
                        else
                        {
                            <div class="sp-form-row">
                                <input class="sp-inp sp-inp-tipo" placeholder="NIT" style="width:120px;"
                                       @bind="_nuevoDoc" @bind:event="oninput" />
                                <input class="sp-inp sp-grow" placeholder="Razon social"
                                       @bind="_nuevoNombres" @bind:event="oninput" />
                            </div>
                        }

                        <div class="sp-form-row">
                            <input class="sp-inp sp-grow" placeholder="Email (opcional)"
                                   @bind="_nuevoEmail" @bind:event="oninput" />
                            <input class="sp-inp sp-grow" placeholder="Telefono (opcional)"
                                   @bind="_nuevoTel" @bind:event="oninput" />
                        </div>
                        <div class="sp-hint">Los demas correos, telefonos y direcciones se completan en la ficha.</div>
                        <div class="sp-form-foot">
                            <button type="button" class="sp-cancel" @onclick="() => _creando = false">Cancelar</button>
                            <button type="button" class="sp-ok" @onclick="CrearAsync" disabled="@(_busy || !CrearValido)">
                                @(_busy ? "Creando..." : "Crear y asignar")
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        </div>
        }
    }

    @if (!string.IsNullOrEmpty(_msg)) { <div class="sp-msg">@_msg</div> }
</div>

@code {
    [Parameter] public string? Jwt { get; set; }
    /// <summary>Persona/empresa elegida. Enlazar con @bind-Seleccionada desde el contenedor.</summary>
    [Parameter] public PersonaCandidatoDto? Seleccionada { get; set; }
    [Parameter] public EventCallback<PersonaCandidatoDto?> SeleccionadaChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Buscar por nombre o documento...";

    /// <summary>Habilita el toggle Persona/Empresa al crear. Se activa donde un tercero juridico
    /// tiene sentido (propietario, residente, proveedor). Por defecto false = solo personas.</summary>
    [Parameter] public bool PermiteEmpresa { get; set; }

    /// <summary>Si es true, el panel de resultados FLOTA (position:fixed anclado al input) en vez de
    /// quedar dentro del flujo. Usar cuando el control vive dentro de un contenedor con overflow que
    /// lo recorta (ej. una fila de tabla). Por defecto false = comportamiento en flujo de siempre.</summary>
    [Parameter] public bool Flotante { get; set; }

    /// <summary>Valores ya tecleados en la fila del contenedor (ej. telefono/email del residente).
    /// Al crear un contacto nuevo se precargan en el popover para no pedir dos veces lo mismo.</summary>
    [Parameter] public string? EmailInicial { get; set; }
    [Parameter] public string? TelefonoInicial { get; set; }

    private ElementReference _anchorRef;
    private ElementReference _popRef;
    private string? _popStyle;
    private bool _floatHelperReady;

    private string _q = "";
    private List<PersonaCandidatoDto> _candidatos = new();
    private bool _buscando, _busy, _creando;
    private string _msg = "";

    private TipoDocumento _nuevoTipoDoc = TipoDocumento.CC;
    private bool _nuevoEsEmpresa;
    private string _nuevoDoc = "", _nuevoNombres = "", _nuevoApellidos = "", _nuevoEmail = "", _nuevoTel = "";

    private bool CrearValido => _nuevoEsEmpresa
        // Empresa: NIT + razon social.
        ? !string.IsNullOrWhiteSpace(_nuevoDoc) && !string.IsNullOrWhiteSpace(_nuevoNombres)
        // Persona: documento + nombres + apellidos.
        : !string.IsNullOrWhiteSpace(_nuevoDoc) &&
          !string.IsNullOrWhiteSpace(_nuevoNombres) &&
          !string.IsNullOrWhiteSpace(_nuevoApellidos);

    // Un token por pulsacion: si llega tarde la respuesta de una busqueda vieja se descarta,
    // si no el listado parpadea con resultados de lo que el usuario ya borro.
    private int _busquedaToken;

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        if (!string.IsNullOrEmpty(Jwt))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);
        return http;
    }

    // Modo flotante: posiciona el panel de resultados (position:fixed) justo debajo del input,
    // para que escape del overflow del contenedor (ej. la fila de la tabla). Se recalcula tras
    // cada render mientras hay busqueda visible; se estabiliza porque el top depende solo del input.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Flotante) return;
        if (!_floatHelperReady)
        {
            try
            {
                // Calcula posicion fixed anclada al input, con FLIP hacia arriba si no cabe abajo,
                // clamp horizontal al viewport y max-height para nunca salirse de pantalla.
                await JS.InvokeVoidAsync("eval",
                    "window.propiaFloatPos = window.propiaFloatPos || function(a, p){ if(!a) return null; var r = a.getBoundingClientRect(); var vw = window.innerWidth, vh = window.innerHeight, m = 8, gap = 4; var w = Math.max(r.width, 300); var left = r.left; if (left + w > vw - m) left = Math.max(m, vw - w - m); var ph = p ? p.scrollHeight : 0; var below = vh - r.bottom - m, above = r.top - m; var up = ph > below && above > below; var top, maxH; if (up) { maxH = above; top = Math.max(m, r.top - gap - Math.min(ph, maxH)); } else { maxH = below; top = r.bottom + gap; } return [Math.round(top), Math.round(left), Math.round(w), Math.round(maxH)]; };");
                _floatHelperReady = true;
            }
            catch { return; }
        }

        if (Seleccionada is null && _q.Length > 0)
        {
            try
            {
                var r = await JS.InvokeAsync<double[]?>("propiaFloatPos", _anchorRef, _popRef);
                if (r is { Length: 4 })
                {
                    var s = $"position:fixed; top:{r[0]}px; left:{r[1]}px; width:{r[2]}px; max-height:{r[3]}px; overflow-y:auto; z-index:4000;";
                    if (s != _popStyle) { _popStyle = s; StateHasChanged(); }
                }
            }
            catch { }
        }
        else if (_popStyle is not null)
        {
            _popStyle = null;
            StateHasChanged();
        }
    }

    private async Task OnBuscarInput(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? string.Empty;
        _msg = "";
        if (_q.Trim().Length < 3) { _candidatos.Clear(); return; }
        await BuscarAsync();
    }

    private async Task OnKeydown(KeyboardEventArgs e)
    {
        // Enter con un unico candidato: atajo para no obligar a soltar el teclado.
        if (e.Key == "Enter" && _candidatos.Count == 1) await ElegirAsync(_candidatos[0]);
    }

    private async Task BuscarAsync()
    {
        var token = ++_busquedaToken;
        _buscando = true;
        try
        {
            var url = $"/api/directorio/personas/candidatos?q={Uri.EscapeDataString(_q.Trim())}";
            var res = await Auth().GetFromJsonAsync<List<PersonaCandidatoDto>>(url);
            if (token != _busquedaToken) return;   // llego tarde: la descartamos
            _candidatos = res ?? new();
        }
        catch (Exception ex) { if (token == _busquedaToken) _msg = ex.Message; }
        if (token == _busquedaToken) _buscando = false;
    }

    private async Task ElegirAsync(PersonaCandidatoDto c)
    {
        _busy = true; _msg = "";
        try
        {
            // Fase 2: si viene de otra copropiedad, se trae a esta antes de asignarla. El endpoint
            // depende de si es persona o empresa.
            if (!c.EnEstaCopropiedad)
            {
                var url = c.EntidadTipo == EntidadDirectorio.Empresa
                    ? $"/api/directorio/empresas/{c.PersonaId}/vincular"
                    : $"/api/directorio/personas/{c.PersonaId}/vincular";
                var r = await Auth().PostAsync(url, null);
                if (!r.IsSuccessStatusCode)
                {
                    _msg = await MensajeDeError(r, "No se pudo vincular a esta copropiedad.");
                    _busy = false;
                    return;
                }
                c = c with { EnEstaCopropiedad = true };
            }
            // Trae los contactos globales del elegido para que el formulario los precargue.
            c = c with { Contactos = await CargarContactosAsync(c.EntidadTipo, c.PersonaId) };
            Seleccionada = c;
            await SeleccionadaChanged.InvokeAsync(c);
            _q = ""; _candidatos.Clear(); _creando = false;
        }
        catch (Exception ex) { _msg = ex.Message; }
        _busy = false;
    }

    private async Task<IReadOnlyList<ContactoRapidoDto>?> CargarContactosAsync(EntidadDirectorio tipo, Guid id)
    {
        try
        {
            var url = $"/api/directorio/contactos-rapidos?tipo={(int)tipo}&id={id}";
            return await Auth().GetFromJsonAsync<List<ContactoRapidoDto>>(url);
        }
        catch { return null; }   // best-effort: sin contactos el formulario simplemente queda vacio
    }

    private void AbrirCrear()
    {
        _creando = true;
        // Si lo escrito parece un documento se precarga ahi; si no, en nombres/razon social.
        if (_q.All(char.IsDigit)) _nuevoDoc = _q.Trim();
        else _nuevoNombres = _q.Trim();
        // Traslada lo ya tecleado en la fila del contenedor para no volver a pedirlo.
        if (string.IsNullOrWhiteSpace(_nuevoEmail) && !string.IsNullOrWhiteSpace(EmailInicial)) _nuevoEmail = EmailInicial.Trim();
        if (string.IsNullOrWhiteSpace(_nuevoTel) && !string.IsNullOrWhiteSpace(TelefonoInicial)) _nuevoTel = TelefonoInicial.Trim();
    }

    private async Task CrearAsync()
    {
        if (!CrearValido) return;
        _busy = true; _msg = "";
        try
        {
            // El email/telefono capturados aqui se guardan como contactos globales (principal),
            // de modo que despues se recargan en la ficha. El resto se completa en el formulario.
            var contactos = new List<object>();
            if (!string.IsNullOrWhiteSpace(_nuevoEmail))
                contactos.Add(new { Tipo = TipoContacto.Email, Valor = _nuevoEmail.Trim(), Principal = true });
            if (!string.IsNullOrWhiteSpace(_nuevoTel))
                contactos.Add(new { Tipo = TipoContacto.Telefono, Valor = _nuevoTel.Trim(), Principal = true });

            PersonaCandidatoDto? c;
            if (_nuevoEsEmpresa)
            {
                var req = new
                {
                    Nit = _nuevoDoc.Trim(),
                    RazonSocial = _nuevoNombres.Trim(),
                    Email = string.IsNullOrWhiteSpace(_nuevoEmail) ? null : _nuevoEmail.Trim(),
                    Telefono = string.IsNullOrWhiteSpace(_nuevoTel) ? null : _nuevoTel.Trim(),
                    Contactos = contactos
                };
                var r = await Auth().PostAsJsonAsync("/api/directorio/empresas", req);
                if (!r.IsSuccessStatusCode) { _msg = await MensajeDeError(r, "No se pudo crear la empresa."); _busy = false; return; }
                var creada = await r.Content.ReadFromJsonAsync<EmpresaCreadaApi>();
                c = creada is null ? null : new PersonaCandidatoDto(
                    creada.Id, creada.RazonSocial, TipoDocumento.NIT, Enmascarar(creada.Nit),
                    true, Array.Empty<string>(), EntidadDirectorio.Empresa,
                    await CargarContactosAsync(EntidadDirectorio.Empresa, creada.Id));
            }
            else
            {
                var req = new
                {
                    TipoDocumento = _nuevoTipoDoc,
                    Documento = _nuevoDoc.Trim(),
                    Nombres = _nuevoNombres.Trim(),
                    Apellidos = _nuevoApellidos.Trim(),
                    Email = string.IsNullOrWhiteSpace(_nuevoEmail) ? null : _nuevoEmail.Trim(),
                    Telefono = string.IsNullOrWhiteSpace(_nuevoTel) ? null : _nuevoTel.Trim(),
                    Contactos = contactos
                };
                // El alta ya deja el vinculo con la copropiedad activa (DirectorioService).
                var r = await Auth().PostAsJsonAsync("/api/directorio/personas", req);
                if (!r.IsSuccessStatusCode) { _msg = await MensajeDeError(r, "No se pudo crear la persona."); _busy = false; return; }
                var creada = await r.Content.ReadFromJsonAsync<PersonaCreadaApi>();
                c = creada is null ? null : new PersonaCandidatoDto(
                    creada.Id, $"{creada.Nombres} {creada.Apellidos}".Trim(),
                    creada.TipoDocumento, Enmascarar(creada.Documento), true, Array.Empty<string>(),
                    EntidadDirectorio.Persona, await CargarContactosAsync(EntidadDirectorio.Persona, creada.Id));
            }

            if (c is not null)
            {
                Seleccionada = c;
                await SeleccionadaChanged.InvokeAsync(c);
            }
            _q = ""; _candidatos.Clear(); _creando = false;
            LimpiarFormulario();
        }
        catch (Exception ex) { _msg = ex.Message; }
        _busy = false;
    }

    private async Task Limpiar()
    {
        Seleccionada = null;
        await SeleccionadaChanged.InvokeAsync(null);
        _q = ""; _candidatos.Clear(); _msg = "";
    }

    private void LimpiarFormulario()
    {
        _nuevoTipoDoc = TipoDocumento.CC;
        _nuevoEsEmpresa = false;
        _nuevoDoc = ""; _nuevoNombres = ""; _nuevoApellidos = ""; _nuevoEmail = ""; _nuevoTel = "";
    }

    private static string Iniciales(string? nombre)
    {
        var parts = (nombre ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return ("" + parts[0][0] + parts[1][0]).ToUpperInvariant();
    }

    private static string Enmascarar(string? doc)
    {
        var d = (doc ?? "").Trim();
        if (d.Length <= 4) return d;
        return new string('*', Math.Min(4, d.Length - 4)) + d[^4..];
    }

    private static async Task<string> MensajeDeError(HttpResponseMessage resp, string porDefecto)
    {
        try
        {
            var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (err is not null && err.TryGetValue("error", out var m) && !string.IsNullOrWhiteSpace(m)) return m;
        }
        catch { }
        return porDefecto;
    }

    /// <summary>Forma minima de lo que devuelve POST /api/directorio/personas.</summary>
    private sealed record PersonaCreadaApi(Guid Id, string Nombres, string Apellidos, TipoDocumento TipoDocumento, string Documento);

    /// <summary>Forma minima de lo que devuelve POST /api/directorio/empresas.</summary>
    private sealed record EmpresaCreadaApi(Guid Id, string RazonSocial, string Nit);
}

<style>
    .sp { display: flex; flex-direction: column; gap: 7px; }

    .sp-search { display: flex; align-items: center; gap: 8px; border: 1px solid #E1E8EE; border-radius: 9px; padding: 0 11px; background: #fff; }
    .sp-search svg { color: #A6B7C8; flex-shrink: 0; }
    .sp-search:focus-within { border-color: var(--propia-brand, #6D4FE3); }
    .sp-search-inp { flex: 1; border: 0; outline: none; padding: 9px 0; font-size: 13px; color: #33475B; font-family: inherit; background: transparent; }
    .sp-spin { width: 13px; height: 13px; border: 2px solid #E1E8EE; border-top-color: var(--propia-brand, #6D4FE3); border-radius: 50%; animation: sp-rot .6s linear infinite; }
    @@keyframes sp-rot { to { transform: rotate(360deg); } }

    .sp-hint { font-size: 11.5px; color: #A6B7C8; padding-left: 2px; }

    /* Panel de resultados. En modo flotante (Flotante=true) se posiciona fixed via _popStyle y se
       presenta como tarjeta que flota por fuera del contenedor (escapa overflow de la tabla). */
    .sp-pop { display: flex; flex-direction: column; gap: 7px; }
    .sp-pop--float { background: #fff; border: 1px solid #E1E8EE; border-radius: 12px; padding: 7px; box-shadow: 0 14px 38px rgba(27,42,58,.22); }
    .sp-pop--float .sp-list { border: 0; padding: 0; max-height: none; overflow: visible; }

    .sp-list { display: flex; flex-direction: column; gap: 3px; border: 1px solid #E1E8EE; border-radius: 10px; padding: 6px; background: #fff; max-height: 290px; overflow-y: auto; }
    .sp-item { display: flex; align-items: center; gap: 9px; padding: 8px 9px; border: 0; border-radius: 8px; background: transparent; cursor: pointer; text-align: left; font-family: inherit; width: 100%; }
    .sp-item:hover { background: #F5F1FE; }
    .sp-item:disabled { opacity: .5; cursor: default; }
    .sp-item-ava { width: 30px; height: 30px; border-radius: 50%; background: #EEF3F8; color: #516F90; font-size: 10.5px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .sp-item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .sp-item-nom { font-size: 13px; font-weight: 700; color: #33475B; }
    .sp-item-meta { font-size: 10.5px; color: #A6B7C8; }
    .sp-item-otra { color: #9A6A00; }
    .sp-badge { font-size: 9.5px; font-weight: 800; border-radius: 5px; padding: 3px 7px; letter-spacing: .3px; flex-shrink: 0; }
    .sp-badge--aqui { color: #15703F; background: #E7F6EE; }
    .sp-badge--traer { color: #9A6A00; background: #FFF8E6; }
    .sp-vacio { font-size: 11.5px; color: #A6B7C8; padding: 9px; }

    .sp-nueva { display: flex; align-items: center; gap: 6px; width: 100%; padding: 9px; border: 1px dashed #C3D0DD; border-radius: 8px; background: transparent; color: var(--propia-brand, #6D4FE3); font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; justify-content: center; }
    .sp-nueva:hover { border-color: var(--propia-brand, #6D4FE3); background: #F8F5FE; }

    .sp-form { display: flex; flex-direction: column; gap: 6px; padding: 9px; border: 1px solid #DCD2F8; border-radius: 9px; background: #FBFAFE; }
