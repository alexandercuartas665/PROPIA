@* Contenido del disparador de ListaBuscable que muestra el valor elegido como chip pastel de la paleta unica
   (piloto Tareas replicado a Unidades / Equipos / Zonas, Alex 2026-11-26). Sin valor: texto de vacio en gris.
   Sin color (Chip=false): texto plano. Uso: <TriggerContent><ChipValor Texto="..." Color="..." /></TriggerContent> *@
<span class="lbx-trg-tx lbx-chips">
    @if (string.IsNullOrWhiteSpace(Texto))
    {
        <span class="lbx-chips-ph">@Vacio</span>
    }
    else if (Chip)
    {
        <span class="lbx-chip" style="@PaletaChips.ChipEstilo(Color ?? PaletaChips.Neutro)">@Texto</span>
    }
    else
    {
        <span>@Texto</span>
    }
</span>

@code {
    [Parameter] public string? Texto { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public string Vacio { get; set; } = "-";
    [Parameter] public bool Chip { get; set; } = true;
}
