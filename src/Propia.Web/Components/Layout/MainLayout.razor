@inherits LayoutComponentBase
@inject IJSRuntime Js
@inject IHttpClientFactory HttpFactory

@* Layout principal del cliente final (Web). Estilo NexLink:
   - app-header arriba (con search + theme toggle + perfil)
   - app-menubar-tabs a la izquierda (rail 80px + panel 200px)
   - app-wrapper con el contenido @Body *@

<div class="page-layout">

    @* === HEADER === *@
    <header class="app-header">
        <div class="app-header-inner">
            @* Toggler "<<" para colapsar el panel textual del sidebar (igual que en NexLink original). *@
            <button class="app-toggler" type="button" aria-label="app toggler">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.66699 12.6668L3.66699 8.00016L7.66699 3.3335" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                    <path opacity="0.5" d="M12.667 12.6668L8.66699 8.00016L12.667 3.3335" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>

            <div class="app-header-start d-none d-md-flex">
                <small class="text-muted">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</small>
            </div>

            <div class="app-header-end">
                @* Theme toggle (logica en propia-ui.js para que funcione en SSR y server-side) *@
                <div class="px-lg-3 px-2 d-flex align-items-center">
                    <a href="javascript:void(0);" class="theme-btn" title="Cambiar tema claro/oscuro">
                        <svg class="icon-light" width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M14.1663 10.5002C14.1663 12.8013 12.3008 14.6668 9.99967 14.6668C7.69849 14.6668 5.83301 12.8013 5.83301 10.5002C5.83301 8.19898 7.69849 6.3335 9.99967 6.3335C12.3008 6.3335 14.1663 8.19898 14.1663 10.5002Z" fill="var(--bs-heading-color)" />
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.0003 1.5415C10.3455 1.5415 10.6253 1.82133 10.6253 2.1665V3.83317C10.6253 4.17834 10.3455 4.45817 10.0003 4.45817C9.65516 4.45817 9.37532 4.17834 9.37532 3.83317V2.1665C9.37532 1.82133 9.65516 1.5415 10.0003 1.5415ZM1.04199 10.4998C1.04199 10.1547 1.32182 9.87484 1.66699 9.87484H3.33366C3.67883 9.87484 3.95866 10.1547 3.95866 10.4998C3.95866 10.845 3.67883 11.1248 3.33366 11.1248H1.66699C1.32182 11.1248 1.04199 10.845 1.04199 10.4998ZM16.042 10.4998C16.042 10.1547 16.3218 9.87484 16.667 9.87484H18.3337C18.6788 9.87484 18.9587 10.1547 18.9587 10.4998C18.9587 10.845 18.6788 11.1248 18.3337 11.1248H16.667C16.3218 11.1248 16.042 10.845 16.042 10.4998ZM10.0003 16.5415C10.3455 16.5415 10.6253 16.8213 10.6253 17.1665V18.8332C10.6253 19.1783 10.3455 19.4582 10.0003 19.4582C9.65516 19.4582 9.37532 19.1783 9.37532 18.8332V17.1665C9.37532 16.8213 9.65516 16.5415 10.0003 16.5415Z" fill="var(--bs-heading-color)" />
                        </svg>
                        <div class="theme-toggle"></div>
                        <svg class="icon-dark" width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.5" d="M10.0003 18.8332C14.6027 18.8332 18.3337 15.1022 18.3337 10.4998C18.3337 10.1143 17.7557 10.0505 17.5563 10.3805C16.6077 11.9503 14.8849 12.9998 12.917 12.9998C9.92541 12.9998 7.50032 10.5748 7.50032 7.58317C7.50032 5.61521 8.54982 3.89238 10.1197 2.9438C10.4497 2.7444 10.3859 2.1665 10.0003 2.1665C5.39795 2.1665 1.66699 5.89746 1.66699 10.4998C1.66699 15.1022 5.39795 18.8332 10.0003 18.8332Z" fill="var(--bs-heading-color)" />
                        </svg>
                    </a>
                </div>

                <div class="vr my-3"></div>

                @* CTA condicional render-mode-agnostic: ambos bloques en el DOM; propia-ui.js
                   esconde el que no aplica leyendo sessionStorage en cada navegacion. Esto evita
                   depender de hidratacion Blazor del MainLayout (que es SSR puro). *@
                <div class="ms-3 ms-lg-4 d-flex align-items-center gap-2" data-propia-cta>
                    <a href="/login" class="btn btn-primary btn-sm waves-effect waves-light" data-propia-cta-login>
                        <i class="fi fi-rr-sign-in-alt me-1"></i>
                        Ingresar
                    </a>
                    <a href="javascript:void(0);" class="btn btn-outline-secondary btn-sm waves-effect" data-propia-cta-logout style="display:none;">
                        <i class="fi fi-rr-sign-out-alt me-1"></i>
                        Salir
                    </a>
                </div>
            </div>
        </div>
    </header>

    @* === SIDEBAR (rail + tabs) === *@
    @* Logo unico: vive en NavMenu (app-side-brands). Se quito el del rail para no duplicarlo. *@
    <aside class="app-menubar-tabs" id="appMenubar">
        <NavMenu />
    </aside>

    @* === CONTENIDO === *@
    <div class="app-wrapper">
        @Body
    </div>
</div>

@* === MODALES GLOBALES === *@
@* NOTA: el <ModalHost /> NO vive aqui. Cada pagina que necesite modales
   debe declarar <ModalHost /> al final de su markup. Razon: Blazor Web App
   crea boundaries de render mode separados entre MainLayout (SSR) y las
   paginas (Interactive). Como IModalService es Scoped por circuit, si
   MainLayout y la pagina viven en circuits diferentes, no comparten la
   lista de modales. Manteniendo ModalHost DENTRO de la pagina garantizamos
   que ambos consumen la misma instancia Scoped. *@

<div id="blazor-error-ui" data-nosnippet>
    Error inesperado. <a href="." class="reload">Recargar</a>
    <span class="dismiss">X</span>
</div>

<style>
    /* === Personalizaciones PROPIA sobre el tema NexLink === */

    :root {
        --propia-primary: #5955D1;
        --propia-primary-light: #7A77E0;
    }

    /* Marca cuadrada en el rail - ahora el icono de marca (favicon PropIA) */
    .propia-brand-mark {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        object-fit: contain;
    }

    /* Theme toggle visual */
    .theme-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 10px;
        background: rgba(89, 85, 209, 0.08);
        transition: background 0.2s;
        text-decoration: none;
    }
    .theme-btn:hover {
        background: rgba(89, 85, 209, 0.15);
    }
    .theme-btn .theme-toggle {
        width: 30px;
        height: 16px;
        background: #c7c7d1;
        border-radius: 12px;
        position: relative;
        transition: background 0.2s;
    }
    .theme-btn .theme-toggle::before {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        width: 12px;
        height: 12px;
        background: white;
        border-radius: 50%;
        transition: transform 0.2s;
    }
    .theme-btn.active .theme-toggle {
        background: var(--propia-primary);
    }
    .theme-btn.active .theme-toggle::before {
        transform: translateX(14px);
    }
    .theme-btn .icon-dark { opacity: 0.4; }
    .theme-btn .icon-light { opacity: 1; }
    .theme-btn.active .icon-dark { opacity: 1; }
    .theme-btn.active .icon-light { opacity: 0.4; }

    /* Rail: ajustes finos identicos a NexLink original.
       - active state: fondo gris suave (--bs-light), NO el morado PROPIA.
       - icono 18px (heredado del CSS de NexLink) + boton 40x40 centrado. */
    .app-navbar-tabs .nav-item .menu-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        padding: 0;
        margin: 0 auto;
    }
    .app-navbar-tabs .nav-item .menu-link i,
    .app-navbar-tabs .nav-item .menu-link i::before {
        font-size: 18px;
    }
    /* Sutil: separadores hr exactos a NexLink (24px wide, gris sutil) */
    .app-navbar-tabs .nav-item-hr {
        width: 24px;
        margin: 12px auto;
    }

    /* Submenu activo con color PROPIA */
    .app-menubar-tabs .side-menubar .menu-item .menu-link.active {
        color: var(--propia-primary);
        font-weight: 600;
    }
    .app-menubar-tabs .side-menubar .menu-item .menu-link.active i {
        color: var(--propia-primary);
    }
    .app-menubar-tabs .side-menubar .menu-item .menu-link:hover {
        color: var(--propia-primary);
    }

    /* Override NexLink: mostrar siempre el panel textual del sidebar en pantallas >= 1200px.
       La plantilla original lo oculta entre 1199-1480px y obliga al usuario a abrir con
       toggler. Para PROPIA preferimos mostrarlo siempre que haya espacio razonable. */
    @@media (min-width: 1200px) {
        html:not([data-app-sidebar=mini]) {
            --app-menubar-tabs: 280px !important;
        }
        html:not([data-app-sidebar=mini]) .app-menubar-tabs .app-tab-content {
            left: 80px !important;
            width: 200px !important;
        }
        html:not([data-app-sidebar=mini]) :has(.app-menubar-tabs) .app-wrapper {
            margin-left: 280px !important;
        }
        html:not([data-app-sidebar=mini]) :has(.app-menubar-tabs) .app-header {
            padding-left: 280px !important;
        }

        /* Modo "mini": toggler colapsa el panel textual y deja solo el rail iconico (80px). */
        html[data-app-sidebar=mini] {
            --app-menubar-tabs: 80px !important;
        }
        html[data-app-sidebar=mini] .app-menubar-tabs .app-tab-content {
            display: none !important;
        }
        html[data-app-sidebar=mini] :has(.app-menubar-tabs) .app-wrapper {
            margin-left: 80px !important;
        }
        html[data-app-sidebar=mini] :has(.app-menubar-tabs) .app-header {
            padding-left: 80px !important;
        }
        /* Desactivar el backdrop oscuro que la plantilla original aplica en desktop */
        html:not([data-app-sidebar=mini]) :has(.app-menubar-tabs) .app-toggler::after,
        html[data-app-sidebar=mini] :has(.app-menubar-tabs) .app-toggler::after {
            display: none !important;
        }
        /* Rotar el chevron al estar minimizado */
        html[data-app-sidebar=mini] .app-toggler svg {
            transform: rotate(180deg);
            transition: transform 0.2s;
        }
        .app-toggler svg { transition: transform 0.2s; }
    }

    /* Marco visual del sidebar para que se distinga del fondo en theme light */
    .app-menubar-tabs {
        border-right: 1px solid var(--bs-border-color);
    }

    /* Error UI inferior - sutil */
    #blazor-error-ui {
        background: #fff3cd;
        bottom: 0;
        box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2);
        display: none;
        left: 0;
        padding: 0.6rem 1.25rem 0.7rem 1.25rem;
        position: fixed;
        width: 100%;
        z-index: 1000;
    }
    #blazor-error-ui .dismiss {
        cursor: pointer;
        position: absolute;
        right: 0.75rem;
        top: 0.5rem;
    }
</style>

@code {
    private bool _themeSyncIntentado;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Rebind eventos JS (sidebar toggle, rail tabs, etc.) en cada render
        try { await Js.InvokeVoidAsync("propiaUI.rebind"); } catch { }

        // Una sola vez al cargar: sincronizar tema con preferencia guardada del usuario (si hay sesion)
        if (firstRender && !_themeSyncIntentado)
        {
            _themeSyncIntentado = true;
            await SincronizarThemeServidorAsync();
        }
    }

    private async Task SincronizarThemeServidorAsync()
    {
        try
        {
            var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (string.IsNullOrWhiteSpace(jwt)) return;  // sin sesion: solo localStorage

            var http = HttpFactory.CreateClient("PropiaApi");
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", jwt);
            var resp = await http.GetAsync("/api/preferencias/ui-theme");
            if (!resp.IsSuccessStatusCode) return;
            var doc = await resp.Content.ReadFromJsonAsync<UiThemeDto>();
            if (doc?.Theme is "light" or "dark")
            {
                await Js.InvokeVoidAsync("propiaUI.setTheme", doc.Theme);
            }
        }
        catch { /* ignorar - el theme local sigue funcionando */ }
    }

    private async Task ToggleThemeAsync()
    {
        var nuevo = await Js.InvokeAsync<string>("propiaUI.toggleTheme");
        // Persistir en servidor si hay sesion (no bloqueante)
        _ = Task.Run(async () =>
        {
            try
            {
                var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
                if (string.IsNullOrWhiteSpace(jwt)) return;
                var http = HttpFactory.CreateClient("PropiaApi");
                http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", jwt);
                await http.PutAsJsonAsync("/api/preferencias/ui-theme", new { theme = nuevo });
            }
            catch { /* ignorar */ }
        });
    }

    private record UiThemeDto(string? Theme);
}
