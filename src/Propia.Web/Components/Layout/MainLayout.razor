@inherits LayoutComponentBase

@* Layout principal del cliente final (Web). Sidebar con menu completo de los 25 modulos
   agrupado por las 3 capas de PROPIA. Estilo cubot/NexLink. *@

<div class="propia-app">
    <aside class="propia-sidebar">
        <div class="propia-brand">
            <div class="propia-logo">P</div>
            <div class="propia-brand-text">
                <strong>PROPIA</strong>
                <small>Plataforma de Copropiedades</small>
            </div>
        </div>
        <NavMenu />
    </aside>

    <div class="propia-main">
        <header class="propia-topbar">
            <div class="propia-topbar-left">
                <small class="text-muted">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</small>
            </div>
            <div class="propia-topbar-right">
                <a href="/login" class="btn btn-sm" style="background: var(--propia-primary); color: white;">Ingresar</a>
            </div>
        </header>

        <main class="propia-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Error inesperado. <a href="." class="reload">Recargar</a>
    <span class="dismiss">X</span>
</div>

<style>
    :root {
        --propia-primary: #5955D1;
        --propia-primary-light: #7A77E0;
        --propia-sidebar-bg: #1a1a2e;
        --propia-bg: #f5f6fa;
    }

    body {
        font-family: 'Instrument Sans', sans-serif;
        background: var(--propia-bg);
        margin: 0;
    }

    .propia-app { display: flex; min-height: 100vh; }

    .propia-sidebar {
        width: 260px;
        flex-shrink: 0;
        background: var(--propia-sidebar-bg);
        color: white;
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 0;
        height: 100vh;
    }

    .propia-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.25rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .propia-logo {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--propia-primary), var(--propia-primary-light));
        color: white;
        font-weight: 700;
        font-size: 1.3rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .propia-brand-text strong { display: block; line-height: 1.1; font-size: 1.1rem; }
    .propia-brand-text small { color: #a0a0b0; font-size: 0.72rem; }

    .propia-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }

    .propia-topbar {
        background: white;
        border-bottom: 1px solid #e6e6ee;
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .propia-content { flex: 1; padding: 1.5rem; }

    @@media (max-width: 768px) {
        .propia-sidebar { width: 60px; position: fixed; height: 100vh; z-index: 100; }
        .propia-brand-text { display: none; }
    }
</style>
