@inherits LayoutComponentBase

@* Layout publico minimo para enlaces que reciben residentes via WhatsApp/email
   (ej. /c/{token} del modulo 2.14 Comunicaciones). Sin sidebar, sin header de
   admin, sin acciones de la app. Solo el contenido enviado por el administrador. *@

<div class="public-wrapper min-vh-100" style="background-color: var(--propia-bg-app);">
    <header class="py-3" style="background: var(--propia-bg-card); border-bottom: 1px solid var(--propia-border-card);">
        <div class="container text-center" style="max-width: 720px;">
            <h1 class="h5 mb-0" style="font-family: 'Instrument Sans', sans-serif; font-weight: 600; color: var(--propia-brand);">PROPIA</h1>
        </div>
    </header>
    <main class="py-4">
        @Body
    </main>
    <footer class="py-3 text-center text-muted" style="font-size: 0.8rem;">
        &copy; A&D GROUP S.A.S - PROPIA 2026
    </footer>
</div>
