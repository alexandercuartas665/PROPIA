@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime Js

@* Isla interactiva del header: notificaciones del sistema.
   Por ahora solo el icono (placeholder); el panel de notificaciones se cablea luego. *@

@if (_jwt is not null)
{
    <div class="ht-wrap">
        <button class="ht-icon-btn" type="button" title="Notificaciones" aria-label="Notificaciones">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
        </button>
    </div>
}

@code {
    private string? _jwt;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (string.IsNullOrWhiteSpace(jwt)) return;
            _jwt = jwt;
            StateHasChanged();
        }
        catch { /* sin sesion / API caida: no renderiza las herramientas */ }
    }
}

<style>
    .ht-wrap { display: flex; align-items: center; gap: 8px; }

    /* Boton de icono (notificaciones) */
    .ht-icon-btn {
        position: relative;
        width: 38px; height: 38px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        background: var(--bs-body-bg);
        color: var(--bs-heading-color);
        cursor: pointer;
        transition: border-color .15s, background .15s, color .15s;
    }
    .ht-icon-btn:hover { border-color: var(--propia-primary, var(--propia-brand)); color: var(--propia-primary, var(--propia-brand)); background: rgba(109,79,227,.06); }
</style>
