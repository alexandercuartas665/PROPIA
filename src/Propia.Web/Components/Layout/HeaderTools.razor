@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Application.Auth
@using Propia.Application.Tareas
@using Propia.Application.Porteria
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

@* Isla interactiva con las herramientas del header (dentro del MainLayout que es SSR puro,
   mismo patron que CopropiedadSwitcher):
   1) "Mis tareas": indicador con conteo de tareas abiertas asignadas al usuario + dropdown.
      Datos: PersonaId desde /connect/me -> GET /api/tareas?asignadoPersonaId=...&soloRaiz=true.
   2) "Reportar novedad": accion rapida que abre un modal y persiste una novedad de porteria.
      Requiere un turno abierto (GET /api/porteria/panel); si no hay, degrada con CTA a Porteria. *@

@if (_jwt is not null)
{
    <div class="ht-wrap">

        @* ----- Mis tareas ----- *@
        <div class="ht-item">
            <button class="ht-icon-btn" type="button" @onclick="ToggleTareasAsync"
                    title="Mis tareas asignadas" aria-label="Mis tareas asignadas">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                    <rect x="9" y="3" width="6" height="4" rx="1" />
                    <path d="M9 13l2 2 4-4" />
                </svg>
                @if (_tareasCount > 0)
                {
                    <span class="ht-badge">@(_tareasCount > 99 ? "99+" : _tareasCount.ToString())</span>
                }
            </button>

            @if (_tareasOpen)
            {
                <div class="ht-pop" @onclick:stopPropagation="true">
                    <div class="ht-pop-head">
                        <span class="ht-pop-title">Mis tareas</span>
                        <span class="ht-pop-count">@_tareasCount abierta@(_tareasCount == 1 ? "" : "s")</span>
                    </div>

                    @if (_cargandoTareas)
                    {
                        <div class="ht-pop-empty">Cargando...</div>
                    }
                    else if (_misTareas.Count == 0)
                    {
                        <div class="ht-pop-empty">No tienes tareas abiertas asignadas.</div>
                    }
                    else
                    {
                        <div class="ht-pop-list">
                            @foreach (var t in _misTareas.Take(6))
                            {
                                var tid = t.Id;
                                <button class="ht-task" type="button" @onclick="() => IrATarea(tid)">
                                    <span class="ht-prio" style="background:@PrioColor(t.Prioridad)"></span>
                                    <span class="ht-task-body">
                                        <span class="ht-task-title">@t.Titulo</span>
                                        <span class="ht-task-meta">
                                            <span class="ht-task-num">@t.NumeroTarea</span>
                                            <span class="ht-task-estado" style="border-color:@(t.EstadoColor ?? "#cdd6e0")">@t.EstadoNombre</span>
                                            @if (t.FechaVencimiento is not null)
                                            {
                                                <span class="@(t.Vencida ? "ht-venc ht-venc--late" : "ht-venc")">
                                                    @(t.Vencida ? "Vencida " : "Vence ")@t.FechaVencimiento.Value.ToString("dd MMM")
                                                </span>
                                            }
                                        </span>
                                    </span>
                                </button>
                            }
                        </div>
                        @if (_misTareas.Count > 6)
                        {
                            <div class="ht-pop-more">y @(_misTareas.Count - 6) mas...</div>
                        }
                    }

                    <a class="ht-pop-foot" href="/tareas">Ver todas mis tareas</a>
                </div>
            }
        </div>

        @* ----- Reportar novedad ----- *@
        <button class="ht-report" type="button" @onclick="AbrirNovedadAsync"
                title="Reportar una novedad de porteria">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
            <span class="ht-report-txt">Reportar novedad</span>
        </button>
    </div>

    @* Captura de clic-afuera para cerrar el dropdown *@
    @if (_tareasOpen)
    {
        <div class="ht-clickaway" @onclick="CerrarTareas"></div>
    }

    @* ----- Modal Reportar novedad ----- *@
    @if (_novedadOpen)
    {
        <div class="ht-backdrop" @onclick="CerrarNovedad">
            <div class="ht-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                <div class="ht-modal-head">
                    <div>
                        <div class="ht-modal-title">Reportar novedad</div>
                        <div class="ht-modal-sub">Queda registrada en la minuta de porteria</div>
                    </div>
                    <button class="ht-close" type="button" @onclick="CerrarNovedad" aria-label="Cerrar">&times;</button>
                </div>

                <div class="ht-modal-body">
                    @if (_cargandoTurno)
                    {
                        <div class="ht-pop-empty">Verificando turno de porteria...</div>
                    }
                    else if (_turno is null)
                    {
                        <div class="ht-warn">
                            <strong>No hay un turno de porteria abierto.</strong>
                            <p>Las novedades se registran dentro de un turno. Abre uno en el modulo de Porteria (vista Operacion) y vuelve a intentarlo.</p>
                            <a class="ht-btn-brand" href="/porteria">Ir a Porteria</a>
                        </div>
                    }
                    else
                    {
                        <div class="ht-turno-chip">
                            Turno abierto: <strong>@_turno.PuntoAcceso</strong> &middot; @_turno.GuardaNombre
                        </div>

                        <label class="ht-label">Tipo de novedad</label>
                        <select class="ht-input" @bind="_nvTipo">
                            @foreach (var t in Enum.GetValues<TipoNovedadPorteria>())
                            {
                                <option value="@t">@TipoLabel(t)</option>
                            }
                        </select>

                        <label class="ht-label">Descripcion</label>
                        <textarea class="ht-input ht-textarea" rows="4" placeholder="Describe lo ocurrido..."
                                  @bind="_nvDescripcion" @bind:event="oninput"></textarea>

                        <div class="ht-check @(_nvGeneraTarea ? "ht-check--on" : "")" role="checkbox"
                             aria-checked="@(_nvGeneraTarea ? "true" : "false")" tabindex="0"
                             @onclick="() => _nvGeneraTarea = !_nvGeneraTarea">
                            <span class="ht-check-box"></span>
                            <span>Generar tarea de seguimiento</span>
                        </div>

                        @if (!string.IsNullOrEmpty(_nvMsg))
                        {
                            <div class="ht-msg @(_nvMsgOk ? "ht-msg--ok" : "ht-msg--err")">@_nvMsg</div>
                        }
                    }
                </div>

                <div class="ht-modal-foot">
                    <button class="ht-btn-ghost" type="button" @onclick="CerrarNovedad">Cancelar</button>
                    @if (_turno is not null)
                    {
                        <button class="ht-btn-brand" type="button" @onclick="RegistrarNovedadAsync"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_nvDescripcion))">
                            @(_busy ? "Registrando..." : "Registrar novedad")
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @* Toast de confirmacion (tras cerrar el modal) *@
    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="ht-toast">@_toast</div>
    }
}

@code {
    private string? _jwt;
    private Guid? _personaId;

    // Mis tareas
    private bool _tareasOpen;
    private bool _cargandoTareas;
    private int _tareasCount;
    private List<TareaListaDto> _misTareas = new();

    // Novedad
    private bool _novedadOpen;
    private bool _cargandoTurno;
    private TurnoDto? _turno;
    private TipoNovedadPorteria _nvTipo = TipoNovedadPorteria.General;
    private string _nvDescripcion = "";
    private bool _nvGeneraTarea;
    private bool _busy;
    private string? _nvMsg;
    private bool _nvMsgOk;
    private string? _toast;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (string.IsNullOrWhiteSpace(jwt)) return;
            _jwt = jwt;
            await CargarTareasAsync();
            StateHasChanged();
        }
        catch { /* sin sesion / API caida: no renderiza las herramientas */ }
    }

    private async Task CargarTareasAsync()
    {
        _cargandoTareas = true;
        try
        {
            if (_personaId is null)
            {
                var me = await Auth().GetFromJsonAsync<MeResponse>("/connect/me");
                _personaId = me?.PersonaId;
            }
            if (_personaId is null) { _misTareas = new(); _tareasCount = 0; return; }

            var url = $"/api/tareas?asignadoPersonaId={_personaId}&soloRaiz=true";
            var todas = await Auth().GetFromJsonAsync<List<TareaListaDto>>(url) ?? new();
            _misTareas = todas.Where(t => !t.EstadoEsTerminal)
                              .OrderByDescending(t => t.Vencida)
                              .ThenBy(t => t.FechaVencimiento ?? DateOnly.MaxValue)
                              .ToList();
            _tareasCount = _misTareas.Count;
        }
        catch { _misTareas = new(); _tareasCount = 0; }
        finally { _cargandoTareas = false; }
    }

    private async Task ToggleTareasAsync()
    {
        _tareasOpen = !_tareasOpen;
        if (_tareasOpen) await CargarTareasAsync();
    }

    private void CerrarTareas() => _tareasOpen = false;

    private void IrATarea(Guid id)
    {
        _tareasOpen = false;
        Nav.NavigateTo($"/tareas/{id}");
    }

    private async Task AbrirNovedadAsync()
    {
        _tareasOpen = false;
        _novedadOpen = true;
        _nvTipo = TipoNovedadPorteria.General;
        _nvDescripcion = "";
        _nvGeneraTarea = false;
        _nvMsg = null;
        _turno = null;
        _cargandoTurno = true;
        StateHasChanged();
        try
        {
            var panel = await Auth().GetFromJsonAsync<PanelMonitoreoDto>("/api/porteria/panel");
            _turno = panel?.TurnoActivo;
        }
        catch { _turno = null; }
        finally { _cargandoTurno = false; StateHasChanged(); }
    }

    private void CerrarNovedad() => _novedadOpen = false;

    private async Task RegistrarNovedadAsync()
    {
        if (_turno is null || string.IsNullOrWhiteSpace(_nvDescripcion)) return;
        _busy = true;
        _nvMsg = null;
        try
        {
            var req = new CrearNovedadRequest(_nvDescripcion.Trim(), _nvGeneraTarea, _nvTipo);
            var resp = await Auth().PostAsJsonAsync($"/api/porteria/turnos/{_turno.Id}/novedades", req);
            if (resp.IsSuccessStatusCode)
            {
                _novedadOpen = false;
                await MostrarToastAsync("Novedad registrada en la minuta.");
                if (_nvGeneraTarea) await CargarTareasAsync(); // pudo crear una tarea asignada
            }
            else
            {
                _nvMsg = "No se pudo registrar: " + await resp.Content.ReadAsStringAsync();
                _nvMsgOk = false;
            }
        }
        catch (Exception ex) { _nvMsg = ex.Message; _nvMsgOk = false; }
        finally { _busy = false; }
    }

    private async Task MostrarToastAsync(string msg)
    {
        _toast = msg;
        StateHasChanged();
        await Task.Delay(3200);
        _toast = null;
        StateHasChanged();
    }

    private static string PrioColor(PrioridadTarea p) => p switch
    {
        PrioridadTarea.Urgente => "#ef4444",
        PrioridadTarea.Alta => "#f59e0b",
        PrioridadTarea.Normal => "#3b82f6",
        _ => "#9aa7b5"
    };

    private static string TipoLabel(TipoNovedadPorteria t) => t switch
    {
        TipoNovedadPorteria.General => "General",
        TipoNovedadPorteria.Dano => "Dano",
        TipoNovedadPorteria.Reclamo => "Reclamo",
        TipoNovedadPorteria.Seguridad => "Seguridad",
        TipoNovedadPorteria.Mantenimiento => "Mantenimiento",
        _ => t.ToString()
    };

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}

<style>
    .ht-wrap { display: flex; align-items: center; gap: 8px; }
    .ht-item { position: relative; display: flex; }

    /* Boton de icono (mis tareas) */
    .ht-icon-btn {
        position: relative;
        width: 38px; height: 38px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        background: var(--bs-body-bg);
        color: var(--bs-heading-color);
        cursor: pointer;
        transition: border-color .15s, background .15s, color .15s;
    }
    .ht-icon-btn:hover { border-color: var(--propia-primary); color: var(--propia-primary); background: rgba(89,85,209,.06); }
    .ht-badge {
        position: absolute; top: -6px; right: -6px;
        min-width: 18px; height: 18px; padding: 0 4px;
        border-radius: 9px; background: #ef4444; color: #fff;
        font-size: .66rem; font-weight: 700; line-height: 18px; text-align: center;
        box-shadow: 0 0 0 2px var(--bs-body-bg);
    }

    /* Boton reportar novedad */
    .ht-report {
        display: inline-flex; align-items: center; gap: 7px;
        height: 38px; padding: 0 14px;
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        background: var(--bs-body-bg);
        color: var(--bs-heading-color);
        font-size: .82rem; font-weight: 600; cursor: pointer;
        transition: border-color .15s, background .15s, color .15s;
    }
    .ht-report:hover { border-color: #f59e0b; color: #b45309; background: rgba(245,158,11,.08); }
    .ht-report svg { color: #f59e0b; }
    @@media (max-width: 991px) { .ht-report-txt { display: none; } .ht-report { padding: 0 11px; } }

    /* Dropdown mis tareas */
    .ht-clickaway { position: fixed; inset: 0; z-index: 1090; background: transparent; }
    .ht-pop {
        position: absolute; top: calc(100% + 10px); right: 0; z-index: 1095;
        width: 360px; max-width: calc(100vw - 24px);
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 14px;
        box-shadow: 0 18px 48px rgba(0,0,0,.22);
        overflow: hidden;
        animation: ht-fade .12s ease-out;
    }
    @@keyframes ht-fade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
    .ht-pop-head {
        display: flex; align-items: baseline; justify-content: space-between;
        padding: 12px 15px; border-bottom: 1px solid var(--bs-border-color);
    }
    .ht-pop-title { font-weight: 700; color: var(--bs-heading-color); }
    .ht-pop-count { font-size: .72rem; color: var(--bs-secondary-color); }
    .ht-pop-empty { padding: 22px 15px; text-align: center; color: var(--bs-secondary-color); font-size: .85rem; }
    .ht-pop-list { max-height: 50vh; overflow-y: auto; }
    .ht-task {
        display: flex; gap: 10px; width: 100%; text-align: left;
        padding: 11px 15px; border: 0; border-bottom: 1px solid var(--bs-border-color);
        background: transparent; cursor: pointer; transition: background .12s;
    }
    .ht-task:hover { background: rgba(89,85,209,.06); }
    .ht-prio { width: 4px; border-radius: 3px; flex: 0 0 4px; margin-top: 2px; }
    .ht-task-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .ht-task-title {
        font-size: .85rem; font-weight: 600; color: var(--bs-heading-color);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px;
    }
    .ht-task-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
    .ht-task-num { font-size: .7rem; color: var(--bs-secondary-color); }
    .ht-task-estado {
        font-size: .68rem; color: var(--bs-secondary-color);
        border: 1px solid var(--bs-border-color); border-radius: 5px; padding: 1px 6px;
    }
    .ht-venc { font-size: .68rem; color: var(--bs-secondary-color); }
    .ht-venc--late { color: #dc2626; font-weight: 700; }
    .ht-pop-more { padding: 7px 15px; font-size: .72rem; color: var(--bs-secondary-color); }
    .ht-pop-foot {
        display: block; padding: 11px 15px; text-align: center;
        border-top: 1px solid var(--bs-border-color);
        font-size: .82rem; font-weight: 600; color: var(--propia-primary);
        text-decoration: none;
    }
    .ht-pop-foot:hover { background: rgba(89,85,209,.06); }

    /* Modal novedad */
    .ht-backdrop {
        position: fixed; inset: 0; z-index: 1100;
        background: rgba(15,15,30,.45);
        display: flex; align-items: flex-start; justify-content: center;
        padding-top: 11vh; animation: ht-fade .12s ease-out;
    }
    .ht-modal {
        width: 480px; max-width: calc(100vw - 32px);
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 16px; box-shadow: 0 18px 48px rgba(0,0,0,.28);
        overflow: hidden;
    }
    .ht-modal-head {
        display: flex; align-items: flex-start; justify-content: space-between;
        padding: 16px 18px; border-bottom: 1px solid var(--bs-border-color);
    }
    .ht-modal-title { font-weight: 700; color: var(--bs-heading-color); }
    .ht-modal-sub { font-size: .8rem; color: var(--bs-secondary-color); }
    .ht-close { background: none; border: 0; font-size: 1.5rem; line-height: 1; color: var(--bs-secondary-color); cursor: pointer; padding: 0 4px; }
    .ht-close:hover { color: var(--bs-heading-color); }
    .ht-modal-body { padding: 16px 18px; }
    .ht-modal-foot {
        display: flex; justify-content: flex-end; gap: 9px;
        padding: 13px 18px; border-top: 1px solid var(--bs-border-color);
    }
    .ht-label { display: block; font-size: .76rem; font-weight: 600; color: var(--bs-secondary-color); margin: 12px 0 5px; }
    .ht-input {
        width: 100%; border: 1px solid var(--bs-border-color); border-radius: 9px;
        padding: 9px 11px; font-size: .88rem; color: var(--bs-heading-color);
        background: var(--bs-body-bg); outline: none;
    }
    .ht-input:focus { border-color: var(--propia-primary); }
    .ht-textarea { resize: vertical; min-height: 84px; font-family: inherit; }
    .ht-check { display: flex; align-items: center; gap: 9px; margin-top: 14px; font-size: .85rem; color: var(--bs-heading-color); cursor: pointer; user-select: none; }
    .ht-check-box {
        width: 18px; height: 18px; flex: 0 0 18px; position: relative;
        border: 1.5px solid var(--bs-border-color); border-radius: 5px; background: var(--bs-body-bg);
        transition: background .12s, border-color .12s;
    }
    .ht-check--on .ht-check-box { background: var(--propia-primary); border-color: var(--propia-primary); }
    .ht-check--on .ht-check-box::after {
        content: ""; position: absolute; left: 5px; top: 1px;
        width: 5px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg);
    }
    .ht-turno-chip {
        font-size: .78rem; color: var(--bs-secondary-color);
        background: var(--bs-secondary-bg); border-radius: 8px; padding: 7px 10px;
    }
    .ht-warn { text-align: center; padding: 8px 4px; }
    .ht-warn strong { color: var(--bs-heading-color); }
    .ht-warn p { font-size: .82rem; color: var(--bs-secondary-color); margin: 8px 0 14px; }
    .ht-msg { margin-top: 12px; padding: 9px 12px; border-radius: 8px; font-size: .8rem; font-weight: 600; }
    .ht-msg--ok { background: #e6f6ee; color: #15703f; }
    .ht-msg--err { background: #fee2e2; color: #b91c1c; }

    .ht-btn-brand {
        display: inline-flex; align-items: center; justify-content: center;
        border: 0; border-radius: 9px; padding: 9px 16px;
        background: var(--propia-primary); color: #fff;
        font-size: .84rem; font-weight: 600; cursor: pointer; text-decoration: none;
    }
    .ht-btn-brand:hover { filter: brightness(1.05); color: #fff; }
    .ht-btn-brand:disabled { opacity: .55; cursor: not-allowed; }
    .ht-btn-ghost {
        border: 1px solid var(--bs-border-color); border-radius: 9px; padding: 9px 16px;
        background: var(--bs-body-bg); color: var(--bs-heading-color);
        font-size: .84rem; font-weight: 600; cursor: pointer;
    }
    .ht-btn-ghost:hover { background: var(--bs-secondary-bg); }

    /* Toast */
    .ht-toast {
        position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 1200;
        background: #15703f; color: #fff; padding: 11px 18px; border-radius: 10px;
        font-size: .85rem; font-weight: 600; box-shadow: 0 8px 24px rgba(0,0,0,.25);
        animation: ht-fade .15s ease-out;
    }
</style>
