@* Sidebar de navegacion del Web cliente - estilo NexLink (rail + tab-content).
   DATA-DRIVEN: el arbol (secciones + items) sale de IMenuConfigService (menu base en
   MenuCatalog + overrides globales de nombre/orden/ubicacion editables por el Super Admin
   en /admin/configuracion-menu). Concepto portado de ECOREX.tareas. Si el servicio falla,
   cae al menu base para no dejar al usuario sin navegacion.

   BUG FIX (validacion MCP 16/05/2026): el tab activo se calcula server-side desde Nav.Uri
   (no con clases hardcoded) para que el menu siempre coincida con la ruta. Ahora el mapa
   ruta->seccion es data-driven, asi el resaltado sigue a los items aunque se muevan de seccion. *@
@using Propia.Application.Navegacion
@inject NavigationManager Nav
@inject IMenuConfigService MenuSvc
@implements IDisposable

@* === Rail (iconos verticales, 80px ancho) === *@
<div class="app-navbar-tabs" data-simplebar>
    <ul class="nav" id="appMenubarTabs" role="tablist" aria-orientation="vertical">
        @if (_menu is not null)
        {
            @foreach (var s in _menu.Sections)
            {
                @if (s.SeparatorBefore)
                {
                    <li class="nav-item-hr"></li>
                }
                <li class="nav-item">
                    <a class="@RailClass(s.Key)" href="javascript:void(0)" data-tab-target="@s.Key"
                       data-tip-title="@s.Label" data-tip-desc="@s.TooltipDesc">
                        <i class="fi @s.Icon"></i>
                    </a>
                </li>
            }
        }
    </ul>
</div>

@* === Panel textual (200px ancho) - tabs con submenu === *@
<div class="app-tab-content">
    <div class="app-side-brands">
        <a class="navbar-brand-text" href="/mi-copropiedad" aria-label="PropIA">
            <img src="img/brand/logo-normal.png" alt="PropIA" class="propia-side-logo" data-brand-logo />
        </a>
    </div>
    @* Selector de copropiedad activa (isla interactiva): el admin multi-PH ve aqui sobre
       que propiedad trabaja y la cambia con un clic (modal). Pendiente #9 convalidacion 2.3. *@
    <CopropiedadSwitcher />
    <div class="app-content-inner">
        <div class="tab-content" id="appMenubarTabsContent">
            @if (_menu is not null)
            {
                @foreach (var s in _menu.Sections)
                {
                    <div class="@TabClass(s.Key)" id="@s.Key" role="tabpanel">
                        <nav class="app-navbar" data-simplebar>
                            <ul class="side-menubar">
                                <li class="menu-heading"><span class="menu-label">@s.Label</span></li>
                                @foreach (var g in s.Groups)
                                {
                                    @if (g.Heading is not null)
                                    {
                                        @if (g.DividerBefore)
                                        {
                                            <li><div class="menu-divider"></div></li>
                                        }
                                        <li class="menu-heading"><span class="menu-label">@g.Heading</span></li>
                                    }
                                    @foreach (var it in g.Items)
                                    {
                                        <li class="menu-item">
                                            <NavLink class="menu-link" href="@it.Href">
                                                <i class="fi @it.Icon"></i>
                                                <span class="menu-label">@it.Label</span>
                                            </NavLink>
                                        </li>
                                    }
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
    @* Version desplegada (SHA + fecha de build), anclada al pie del panel lateral para saber
       que build esta arriba tras un deploy. En modo "mini" el panel se oculta y esta con el. *@
    <div class="app-side-version" title="Version desplegada @Propia.Web.PlatformVersion.Label">@Propia.Web.PlatformVersion.Label</div>
</div>

<style>
    /* Version al pie del panel textual del sidebar: discreta, anclada abajo, con borde superior
       para leerse como pie. El panel (.app-tab-content) es position:fixed, asi que absolute
       se ancla a el. */
    .app-side-version {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 9px 16px 11px;
        font-size: 10.5px;
        letter-spacing: .3px;
        text-align: center;
        color: var(--bs-secondary-color, #8a94a6);
        background: var(--bs-body-bg, #fff);
        border-top: 1px solid var(--bs-border-color, #E1E8EE);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    /* Dejar aire al final del menu para que el ultimo item no quede tapado por el pie. */
    .app-tab-content .app-content-inner {
        padding-bottom: 40px;
    }
</style>

<style>
    /* Tooltip del rail. El elemento lo crea propia-ui.js colgado del documento (el rail
       tiene scroll y lo recortaria), por eso estas reglas son globales y no descendientes
       del nav. Los data-tip-title/-desc de cada icono son los que lo alimentan. */
    .propia-railtip {
        position: fixed;
        z-index: 1080;
        width: 268px;
        padding: 12px 14px;
        border-radius: 12px;
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #E1E8EE);
        box-shadow: 0 12px 32px rgba(27, 42, 58, .16);
        opacity: 0;
        pointer-events: none;               /* no debe robarle el hover al icono */
        transform: translateX(-6px);
        transition: opacity .14s ease, transform .14s ease;
    }
    .propia-railtip.is-on { opacity: 1; transform: translateX(0); }
    /* Flechita hacia el icono */
    .propia-railtip::before {
        content: "";
        position: absolute;
        left: -5px; top: 50%; margin-top: -5px;
        width: 10px; height: 10px;
        background: inherit;
        border-left: 1px solid var(--bs-border-color, #E1E8EE);
        border-bottom: 1px solid var(--bs-border-color, #E1E8EE);
        transform: rotate(45deg);
    }
    .propia-railtip-t {
        font-size: 13px; font-weight: 700; line-height: 1.25;
        color: var(--bs-heading-color, #1B2A3A);
    }
    .propia-railtip-d {
        margin-top: 4px;
        font-size: 11.5px; line-height: 1.5;
        color: var(--bs-secondary-color, #7C98B6);
    }

    .propia-side-logo { height: 58px; width: auto; max-width: 150px; object-fit: contain; display: block; }
    /* Logo unico del panel: centrado en su header (80px de alto). */
    .app-side-brands { display: flex; align-items: center; justify-content: center; }
    /* Bajar el riel de iconos ~la altura del header del logo, para que el primer icono
       arranque alineado con el contenido del panel (antes lo empujaba el logo del rail). */
    .app-navbar-tabs { padding-top: 68px; }
</style>

@code {
    private ResolvedMenu? _menu;
    private Dictionary<string, string> _hrefToSection = new(StringComparer.OrdinalIgnoreCase);
    private string _activeTab = "tabInicio";

    protected override async Task OnInitializedAsync()
    {
        try { _menu = await MenuSvc.GetResolvedMenuAsync(); }
        catch { _menu = MenuCatalog.Resolve(Array.Empty<MenuOverrideData>()); } // fallback: menu base

        _hrefToSection = _menu.Sections
            .SelectMany(s => s.Items.Select(i => (i.Href, s.Key)))
            .GroupBy(x => x.Href, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().Key, StringComparer.OrdinalIgnoreCase);

        _activeTab = ResolveTab(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var nuevo = ResolveTab(e.Location);
        if (nuevo != _activeTab)
        {
            _activeTab = nuevo;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Mapea la ruta actual al tab del rail que debe quedar activo. Primero data-driven (match exacto
    /// y por prefijo del href de cada item, asi el resaltado sigue a los items movidos de seccion);
    /// luego fallbacks por prefijo para rutas que no tienen item propio (subrutas, /gobierno, etc).
    /// </summary>
    private string ResolveTab(string uri)
    {
        string path;
        try { path = new Uri(uri).AbsolutePath.ToLowerInvariant(); }
        catch { path = uri.ToLowerInvariant(); }

        if (_hrefToSection.TryGetValue(path, out var exact)) { return exact; }

        string? best = null; var bestLen = 0;
        foreach (var kv in _hrefToSection)
        {
            if (kv.Key.Length > 1 && path.StartsWith(kv.Key + "/", StringComparison.OrdinalIgnoreCase) && kv.Key.Length > bestLen)
            {
                best = kv.Value; bestLen = kv.Key.Length;
            }
        }
        if (best is not null) { return best; }

        // Fallbacks para rutas sin item propio (mantienen el comportamiento historico).
        if (path.StartsWith("/org/") || path.StartsWith("/operador/")) return "tabOrg";
        if (path.StartsWith("/cuenta/") || path == "/login" || path == "/onboarding" || path.StartsWith("/invitacion/")) return "tabCuenta";
        if (path.StartsWith("/mi-copropiedad") || path.StartsWith("/directorio")
            || path.StartsWith("/configuracion/") || path == "/gobierno" || path == "/usuarios"
            || path == "/distribucion" || path == "/zonas-comunes" || path == "/equipos-activos") return "tabMiPH";
        if (path.StartsWith("/presupuesto") || path.StartsWith("/cartera")
            || path.StartsWith("/servicios") || path.StartsWith("/finanzas")) return "tabFinanzas";
        if (path.StartsWith("/asambleas") || path == "/pqrs" || path == "/pqrsd" || path.StartsWith("/pqrsd/")) return "tabGobierno";
        if (path == "/tareas" || path.StartsWith("/tareas/") || path == "/mantenimiento"
            || path == "/porteria" || path == "/reservas") return "tabOperacion";
        if (path == "/comunicaciones" || path == "/documentos" || path == "/reportes" || path.StartsWith("/ia/")) return "tabComunicacion";
        return "tabInicio"; // /, /dashboard, /dashboard-ph y otros
    }

    private string TabClass(string id) =>
        _activeTab == id ? "tab-pane fade show active" : "tab-pane fade";

    private string RailClass(string id) =>
        _activeTab == id ? "menu-link active" : "menu-link";
}
