@* Sidebar de navegacion del Web cliente - MENU VERTICAL AGRUPADO (estilo "grupos expandibles").
   Reemplaza el rail-de-iconos + panel de tabs anterior (que dependia de JS del template para
   cambiar de grupo y confundia). Ahora es UNA sola columna:
     - Grupos colapsables con <details>/<summary> NATIVOS (0 JS, funciona en SSR, accesible).
     - Linea guia punteada (color PROPIA) que ata los items a su grupo.
     - Selector de copropiedad activa al pie (CopropiedadSwitcher, tarjeta tipo "cuenta").
   DATA-DRIVEN: el arbol sale de IMenuConfigService (MenuCatalog + overrides del Super Admin).
   El grupo de la ruta activa arranca expandido; el item activo se resalta con NavLink. *@
@using Propia.Application.Navegacion
@inject NavigationManager Nav
@inject IMenuConfigService MenuSvc
@implements IDisposable

<div class="pnav">

    @* Marca *@
    <div class="pnav-brand">
        <a href="/mi-copropiedad" aria-label="PropIA">
            <img src="img/brand/logo-normal.png" alt="PropIA" class="pnav-logo" data-brand-logo />
        </a>
    </div>

    @* Cuerpo scrolleable con los grupos *@
    <nav class="pnav-body">
        @if (_menu is not null)
        {
            @* Las secciones/items marcados como ocultos por el Super Admin no se pintan;
               una seccion cuyos items visibles quedan en cero tampoco. *@
            @foreach (var s in _menu.Sections.Where(x => !x.Hidden && x.Items.Any(i => !i.Hidden)))
            {
                @if (s.SeparatorBefore)
                {
                    <div class="pnav-sep"></div>
                }

                @if (EsPlano(s))
                {
                    @* Seccion de un solo item: enlace directo (sin acordeon) *@
                    var it0 = s.Items[0];
                    <NavLink class="pnav-flat" href="@it0.Href" Match="NavLinkMatch.Prefix" title="@s.Label">
                        <span class="pnav-ico"><i class="fi @s.Icon"></i></span>
                        <span class="pnav-lbl">@s.Label</span>
                    </NavLink>
                }
                else
                {
                    <details class="pnav-group" open="@EstaActiva(s.Key)">
                        <summary class="pnav-head" title="@s.Label">
                            <span class="pnav-ico"><i class="fi @s.Icon"></i></span>
                            <span class="pnav-lbl">@s.Label</span>
                            <i class="fi fi-rr-angle-small-down pnav-chev"></i>
                        </summary>
                        <div class="pnav-sub">
                            @* Cabecera del flyout en modo mini (oculta en el menu expandido). *@
                            <div class="pnav-flyout-title">@s.Label</div>
                            @foreach (var g in s.Groups)
                            {
                                @if (g.Heading is not null)
                                {
                                    @if (g.DividerBefore)
                                    {
                                        <div class="pnav-subdiv"></div>
                                    }
                                    <div class="pnav-subhead">@g.Heading</div>
                                }
                                @foreach (var it in g.Items.Where(x => !x.Hidden))
                                {
                                    var hijos = it.Children?.Where(c => !c.Hidden).ToList();
                                    @if (hijos is { Count: > 0 })
                                    {
                                        @* Item con SUB-ITEMS (3er nivel): despliega sus hijos. *@
                                        <details class="pnav-subgroup" open="@HijoActivo(hijos)">
                                            <summary class="pnav-item pnav-item--parent" title="@it.Label">
                                                <span class="pnav-item-ico"><i class="fi @it.Icon"></i></span>
                                                <span class="pnav-item-lbl">@it.Label</span>
                                                <i class="fi fi-rr-angle-small-down pnav-subchev"></i>
                                            </summary>
                                            <div class="pnav-children">
                                                @foreach (var ch in hijos)
                                                {
                                                    <NavLink class="pnav-item pnav-item--child" href="@ch.Href" Match="NavLinkMatch.Prefix" title="@ch.Label">
                                                        <span class="pnav-item-ico"><i class="fi @ch.Icon"></i></span>
                                                        <span class="pnav-item-lbl">@ch.Label</span>
                                                    </NavLink>
                                                }
                                            </div>
                                        </details>
                                    }
                                    else
                                    {
                                        <NavLink class="pnav-item" href="@it.Href" Match="NavLinkMatch.Prefix" title="@it.Label">
                                            <span class="pnav-item-ico"><i class="fi @it.Icon"></i></span>
                                            <span class="pnav-item-lbl">@it.Label</span>
                                        </NavLink>
                                    }
                                }
                            }
                        </div>
                    </details>
                }
            }
        }
    </nav>

    @* Pie: version. El selector de copropiedad se movio al centro de la barra superior (MainLayout). *@
    <div class="pnav-foot">
        <div class="pnav-ver" title="Version @Propia.Web.PlatformVersion.Label (build @Propia.Web.PlatformVersion.Build)">@Propia.Web.PlatformVersion.Label</div>
    </div>
</div>

<style>
    /* ===== Menu vertical agrupado de PROPIA ===== */
    .pnav {
        --pnav-guide: rgba(89, 85, 209, .26);      /* linea guia: morado PROPIA suave (mas tenue) */
        --pnav-guide-on: var(--propia-primary, var(--propia-brand));
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100%;
    }

    /* Marca */
    .pnav-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 74px;
        flex: 0 0 auto;
        border-bottom: 1px solid var(--bs-border-color);
    }
    .pnav-logo { height: 46px; width: auto; max-width: 170px; object-fit: contain; display: block; }

    /* Cuerpo scrolleable */
    .pnav-body {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 10px 10px 16px;
        min-height: 0;
    }
    .pnav-body::-webkit-scrollbar { width: 7px; }
    .pnav-body::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 6px; }

    .pnav-sep { height: 1px; background: var(--bs-border-color); margin: 10px 8px; }

    /* Icono cuadrado (grupo e item plano) */
    .pnav-ico {
        width: 30px; height: 30px; flex: 0 0 30px;
        display: inline-flex; align-items: center; justify-content: center;
        color: var(--bs-secondary-color, var(--propia-text-muted));
    }
    .pnav-ico i, .pnav-ico i::before { font-size: 17px; line-height: 1; }

    /* Enlace plano (seccion de un item, ej. Inicio) */
    .pnav-flat {
        display: flex; align-items: center; gap: 11px;
        padding: 9px 12px; margin: 2px 0;
        border-radius: 11px;
        color: var(--bs-heading-color, var(--propia-text-h1));
        text-decoration: none;
        font-weight: 500; font-size: .92rem;
        transition: background .14s, color .14s;
    }
    .pnav-flat:hover { background: rgba(89, 85, 209, .07); }
    .pnav-flat.active { background: var(--propia-brand-soft); color: var(--propia-brand); font-weight: 600; }
    .pnav-flat.active .pnav-ico { color: var(--propia-primary); }

    /* ===== Grupo colapsable (details/summary) ===== */
    .pnav-group { margin: 2px 0; }
    .pnav-group > summary { list-style: none; }
    .pnav-group > summary::-webkit-details-marker { display: none; }   /* quita el triangulo nativo */

    .pnav-head {
        display: flex; align-items: center; gap: 11px;
        padding: 9px 12px;
        border-radius: 11px;
        cursor: pointer;
        color: var(--bs-heading-color, var(--propia-text-h1));
        font-weight: 600; font-size: .92rem;
        user-select: none;
        transition: background .14s;
    }
    .pnav-head:hover { background: rgba(89, 85, 209, .07); }
    .pnav-lbl { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pnav-chev {
        font-size: 15px; color: var(--bs-secondary-color, #9aa4b2);
        transition: transform .18s ease; flex: 0 0 auto;
    }
    .pnav-group[open] > .pnav-head .pnav-chev { transform: rotate(180deg); }
    /* Grupo con la ruta activa dentro: icono en morado para ubicarse rapido */
    .pnav-group[open] > .pnav-head .pnav-ico { color: var(--propia-primary); }

    /* ===== Sub-items con linea guia punteada ===== */
    .pnav-sub {
        position: relative;
        margin: 2px 0 6px;
        padding: 2px 0 2px 0;
    }
    /* Cabecera del flyout: solo visible en modo mini (riel de iconos). */
    .pnav-flyout-title { display: none; font-size: 11px; font-weight: 800; letter-spacing: .4px; color: var(--propia-text-faint); text-transform: uppercase; padding: 4px 10px 8px; border-bottom: 1px solid var(--bs-border-color); margin-bottom: 6px; }
    /* Linea vertical punteada, alineada bajo el centro del icono del grupo (12px pad + 15 medio icono = 27px).
       Gradiente repetido (no border dashed) para controlar el espaciado: punto de 3px + hueco de 6px. */
    .pnav-sub::before {
        content: "";
        position: absolute;
        left: 27px; top: 0; bottom: 14px;
        width: 1.5px;
        background: repeating-linear-gradient(to bottom, var(--pnav-guide) 0 3px, transparent 3px 13px);
    }

    .pnav-subhead {
        padding: 8px 12px 4px 44px;
        font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
        color: var(--bs-secondary-color, #9aa4b2);
    }
    .pnav-subdiv { height: 1px; background: var(--bs-border-color); margin: 6px 12px 6px 44px; }

    .pnav-item {
        position: relative;
        display: flex; align-items: center; gap: 9px;
        margin: 1px 0 1px 27px;
        padding: 7px 10px 7px 17px;
        border-radius: 9px;
        color: var(--bs-body-color, #55677D);
        text-decoration: none;
        font-size: .875rem; font-weight: 500;
        transition: background .14s, color .14s;
    }
    /* Conector horizontal hacia el item: unos 3 guiones cortos (punto 3px + hueco 2px sobre 15px). */
    .pnav-item::before {
        content: "";
        position: absolute;
        left: 0; top: 50%;
        width: 15px; height: 1.5px;
        background: repeating-linear-gradient(to right, var(--pnav-guide) 0 3px, transparent 3px 5px);
    }
    .pnav-item-ico {
        width: 20px; height: 20px; flex: 0 0 20px;
        display: inline-flex; align-items: center; justify-content: center;
        color: var(--bs-secondary-color, var(--propia-text-muted));
    }
    .pnav-item-ico i, .pnav-item-ico i::before { font-size: 14px; line-height: 1; }
    .pnav-item-lbl { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .pnav-item:hover { background: rgba(89, 85, 209, .07); color: var(--propia-primary); }
    .pnav-item:hover .pnav-item-ico { color: var(--propia-primary); }

    /* Item activo: solo la pastilla + el nombre en morado/negrita. El conector del item activo
       se queda punteado (2 guiones cortos, que NUNCA se lea como una linea solida). */
    .pnav-item.active {
        background: var(--propia-brand-soft);
        color: var(--propia-primary);
        font-weight: 600;
    }
    .pnav-item.active .pnav-item-ico { color: var(--propia-primary); }
    .pnav-item.active::before {
        background: repeating-linear-gradient(to right, var(--pnav-guide) 0 4px, transparent 4px 10px);
    }

    /* ===== Pie: selector de copropiedad + version ===== */
    .pnav-foot {
        flex: 0 0 auto;
        border-top: 1px solid var(--bs-border-color);
        background: var(--app-sidebar-bg, var(--bs-body-bg));
    }
    /* El CopropiedadSwitcher trae su propio .cs-wrap con padding; solo ajustamos el pie. */
    .pnav-foot .cs-wrap { padding: 12px 12px 4px; }
    .pnav-ver {
        padding: 2px 14px 10px;
        font-size: 10.5px; letter-spacing: .3px; text-align: center;
        color: var(--bs-secondary-color, #9aa4b2);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        opacity: .85;
    }

    /* ===== Sub-items (3er nivel): un item que despliega hijos ===== */
    .pnav-subgroup { margin: 0; }
    .pnav-subgroup > summary { list-style: none; cursor: pointer; }
    .pnav-subgroup > summary::-webkit-details-marker { display: none; }
    .pnav-item--parent { user-select: none; }
    .pnav-subchev { font-size: 12px; color: var(--bs-secondary-color, #9aa4b2); transition: transform .18s; margin-left: 2px; }
    .pnav-subgroup[open] > .pnav-item--parent .pnav-subchev { transform: rotate(180deg); }
    .pnav-children { margin: 1px 0 3px; }
    /* El hijo va mas indentado que el item de primer nivel; la guia vertical se corre a la derecha. */
    .pnav-item--child { padding-left: 46px; }
    .pnav-item--child .pnav-item-lbl { font-size: 12.5px; }
    .pnav-children .pnav-item--child::before { left: 30px; }
</style>

@code {
    private ResolvedMenu? _menu;
    private string _activeTab = "tabInicio";
    private Dictionary<string, string> _hrefToSection = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try { _menu = await MenuSvc.GetResolvedMenuAsync(); }
        catch { _menu = MenuCatalog.Resolve(Array.Empty<MenuOverrideData>()); } // fallback: menu base

        _hrefToSection = _menu.Sections
            .SelectMany(s => s.Items.Select(i => (i.Href, s.Key)))
            .GroupBy(x => x.Href, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().Key, StringComparer.OrdinalIgnoreCase);

        _activeTab = ResolveTab(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var nuevo = ResolveTab(e.Location);
        if (nuevo != _activeTab)
        {
            _activeTab = nuevo;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Una seccion es "plana" (enlace directo, sin acordeon) si tiene exactamente un item.</summary>
    private static bool EsPlano(ResolvedMenuSection s) => s.Items.Count == 1;

    /// <summary>La seccion cuya ruta esta activa arranca expandida.</summary>
    private bool EstaActiva(string key) => string.Equals(key, _activeTab, StringComparison.Ordinal);

    /// <summary>Un item con sub-items arranca abierto si alguna de sus sub-rutas esta activa.</summary>
    private bool HijoActivo(IEnumerable<ResolvedMenuItem> hijos)
    {
        string path;
        try { path = new Uri(Nav.Uri).AbsolutePath.ToLowerInvariant(); }
        catch { path = Nav.Uri.ToLowerInvariant(); }
        return hijos.Any(c => !string.IsNullOrEmpty(c.Href)
            && (string.Equals(path, c.Href.ToLowerInvariant(), StringComparison.Ordinal)
                || path.StartsWith(c.Href.ToLowerInvariant() + "/", StringComparison.Ordinal)));
    }

    /// <summary>
    /// Mapea la ruta actual a la seccion que debe quedar activa/expandida. Data-driven (match exacto
    /// y por prefijo del href de cada item) + fallbacks por prefijo para subrutas sin item propio.
    /// </summary>
    private string ResolveTab(string uri)
    {
        string path;
        try { path = new Uri(uri).AbsolutePath.ToLowerInvariant(); }
        catch { path = uri.ToLowerInvariant(); }

        if (_hrefToSection.TryGetValue(path, out var exact)) { return exact; }

        string? best = null; var bestLen = 0;
        foreach (var kv in _hrefToSection)
        {
            if (kv.Key.Length > 1 && path.StartsWith(kv.Key + "/", StringComparison.OrdinalIgnoreCase) && kv.Key.Length > bestLen)
            {
                best = kv.Value; bestLen = kv.Key.Length;
            }
        }
        if (best is not null) { return best; }

        if (path.StartsWith("/org/") || path.StartsWith("/operador/")) return "tabOrg";
        if (path.StartsWith("/cuenta/") || path == "/login" || path == "/onboarding" || path.StartsWith("/invitacion/")) return "tabCuenta";
        if (path.StartsWith("/mi-copropiedad") || path.StartsWith("/directorio")
            || path.StartsWith("/configuracion/") || path == "/gobierno" || path == "/usuarios"
            || path == "/distribucion" || path == "/zonas-comunes" || path == "/equipos-activos") return "tabMiPH";
        if (path.StartsWith("/presupuesto") || path.StartsWith("/cartera")
            || path.StartsWith("/servicios") || path.StartsWith("/finanzas") || path.StartsWith("/contratos")) return "tabFinanzas";
        if (path.StartsWith("/asambleas") || path == "/pqrs" || path == "/pqrsd" || path.StartsWith("/pqrsd/")) return "tabGobierno";
        if (path == "/tareas" || path.StartsWith("/tareas/") || path == "/mantenimiento"
            || path == "/porteria" || path == "/reservas") return "tabOperacion";
        if (path == "/comunicaciones" || path == "/documentos" || path == "/reportes"
            || path == "/informes" || path.StartsWith("/ia/")) return "tabComunicacion";
        return "tabInicio";
    }
}
