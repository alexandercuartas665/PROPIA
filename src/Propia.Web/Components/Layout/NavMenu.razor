@code {
    private string _activeTab = "tabInicio";

    protected override void OnInitialized()
    {
        _activeTab = ResolveTab(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var nuevo = ResolveTab(e.Location);
        if (nuevo != _activeTab)
        {
            _activeTab = nuevo;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Mapea la ruta actual al tab del rail que debe quedar activo.</summary>
    private static string ResolveTab(string uri)
    {
        string path;
        try { path = new Uri(uri).AbsolutePath.ToLowerInvariant(); }
        catch { path = uri.ToLowerInvariant(); }

        if (path.StartsWith("/org/") || path.StartsWith("/operador/")) return "tabOrg";
        if (path.StartsWith("/cuenta/") || path == "/login" || path == "/onboarding"
            || path.StartsWith("/invitacion/")) return "tabCuenta";
        if (path == "/mi-copropiedad" || path.StartsWith("/mi-copropiedad/")
            || path == "/directorio" || path.StartsWith("/directorio/")
            || path == "/usuarios" || path.StartsWith("/configuracion/")
            || path == "/gobierno" || path == "/servicios")
            return "tabMiPH";
        if (path == "/presupuesto" || path.StartsWith("/presupuesto/")
            || path == "/cartera" || path.StartsWith("/cartera/")
            || path == "/finanzas")
            return "tabFinanzas";
        if (path == "/asambleas" || path.StartsWith("/asambleas/")
            || path == "/pqrs" || path == "/pqrsd" || path.StartsWith("/pqrsd/"))
            return "tabGobierno";
        if (path == "/tareas" || path.StartsWith("/tareas/")
            || path == "/mantenimiento" || path == "/porteria" || path == "/reservas")
            return "tabOperacion";
        if (path == "/comunicaciones" || path == "/documentos" || path == "/reportes")
            return "tabComunicacion";
        return "tabInicio"; // /, /dashboard, /dashboard-ph y otros
    }

    private string TabClass(string id) =>
        _activeTab == id ? "tab-pane fade show active" : "tab-pane fade";

    private string RailClass(string id) =>
        _activeTab == id ? "menu-link active" : "menu-link";
}
