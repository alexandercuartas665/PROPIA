        <li class="nav-item">
            <a class="@RailClass("tabComunicacion")" href="javascript:void(0)" data-tab-target="tabComunicacion"
               data-tip-title="Comunicacion y documentos" data-tip-desc="Comunicados, documentos, reportes e indicadores, y el stack de WhatsApp con los agentes de IA.">
                <i class="fi fi-rr-megaphone"></i>
            </a>
        </li>

        <li class="nav-item-hr"></li>

        <li class="nav-item">
            <a class="@RailClass("tabOrg")" href="javascript:void(0)" data-tab-target="tabOrg"
               data-tip-title="Organizacion (Capa 1)" data-tip-desc="Vista de todas tus copropiedades: panel consolidado, calendario multi-PH, equipo de trabajo y reportes cruzados.">
                <i class="fi fi-rr-network"></i>
            </a>
        </li>

        <li class="nav-item">
            <a class="@RailClass("tabCuenta")" href="javascript:void(0)" data-tab-target="tabCuenta"
