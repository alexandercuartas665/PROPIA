@inherits LayoutComponentBase

@* Layout especial para el wizard de Onboarding (modulo 2.1). Sin sidebar - el wizard ocupa toda la pantalla. *@

<div class="wizard-container">
    <header class="wizard-header">
        <div class="wizard-brand">
            <div class="wizard-logo">P</div>
            <strong>PROPIA</strong>
        </div>
        <a href="/" class="wizard-exit text-muted small">Salir</a>
    </header>

    <main class="wizard-body">
        @Body
    </main>
</div>

<style>
    :root {
        --propia-primary: var(--propia-brand);
        --propia-primary-light: var(--propia-brand-hover);
        --propia-bg: #f5f6fa;
    }

    body { font-family: 'Instrument Sans', sans-serif; background: var(--propia-bg); margin: 0; }

    .wizard-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .wizard-header {
        background: var(--propia-bg-card);
        border-bottom: 1px solid #e6e6ee;
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .wizard-brand { display: flex; align-items: center; gap: 0.6rem; font-size: 1.1rem; }
    .wizard-logo {
        width: 36px; height: 36px; border-radius: 8px;
        background: linear-gradient(135deg, var(--propia-primary), var(--propia-primary-light));
        color: white; font-weight: 700; font-size: 1.1rem;
        display: flex; align-items: center; justify-content: center;
    }

    .wizard-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
    }
</style>
