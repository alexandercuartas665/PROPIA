@inherits LayoutComponentBase

@* Layout para paginas de autenticacion (login, registro, forgot-password).
   Sin sidebar, sin header - solo el contenido centrado. Estilo NexLink. *@

<div class="auth-wrapper d-flex align-items-center justify-content-center min-vh-100" style="background-color: #f5f5f9;">
    <div class="auth-container" style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <h1 class="h3 mb-1" style="font-family: 'Instrument Sans', sans-serif; font-weight: 600; color: #5955D1;">PROPIA</h1>
            <p class="text-muted mb-0">Plataforma de gestion de copropiedades</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5">
                @Body
            </div>
        </div>

        <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.85rem;">
            &copy; A&D GROUP S.A.S - PROPIA 2026
        </p>
    </div>
</div>
