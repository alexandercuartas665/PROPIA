@inherits LayoutComponentBase

@* Layout split-screen estilo NexLink (tono claro) para paginas de autenticacion
   (login, registro, recuperar contrasena). Ilustracion a la izquierda en desktop;
   en mobile solo se ve el card del form. Cada pagina pone su propio titulo + form
   dentro de @Body. *@

<div class="auth-wrapper min-vh-100">
    <div class="row g-0 min-vh-100">

        @* Columna izquierda: ilustracion (desktop only, >=lg) *@
        <div class="col-xl-6 col-lg-6 d-none d-lg-flex align-items-center justify-content-center auth-left">
            <div class="auth-illustration text-center p-4">
                <img src="assets/images/auth/vector2.svg" alt="" class="img-fluid mb-4" style="max-height: 360px;" />
                <h2 class="h3 fw-semibold mb-2 auth-illustration-title">PropIA</h2>
                <p class="text-muted mb-0 auth-illustration-sub">La plataforma para administrar tu copropiedad con todas las herramientas en un solo lugar.</p>
            </div>
        </div>

        @* Columna derecha: card + form *@
        <div class="col-xl-6 col-lg-6 d-flex flex-column align-items-center justify-content-center py-4 px-3">

            <div class="auth-card card border-0 shadow-sm rounded-4 p-4 p-sm-5">

                @* Logo / marca *@
                <div class="mb-4 text-center">
                    <a href="/" aria-label="PropIA" class="text-decoration-none">
                        <img src="img/brand/logo-normal.png" alt="PropIA" class="auth-logo-img" data-brand-logo />
                    </a>
                </div>

                @Body
            </div>

            <p class="text-center text-muted mt-3 mb-0 auth-footer">
                &copy; A&D GROUP S.A.S &middot; PROPIA 2026
            </p>
        </div>

    </div>
</div>

<style>
    .auth-wrapper {
        background: var(--propia-bg-app);
    }
    .auth-left {
        background: var(--propia-brand-soft);
    }
    .auth-illustration { max-width: 540px; }
    .auth-illustration-title { color: var(--propia-text-h1); letter-spacing: 0.5px; font-weight: 700; }
    .auth-illustration-sub { font-size: 14px; }

    .auth-card {
        width: 100%;
        max-width: 450px;
        background: var(--propia-bg-card);
        color: var(--propia-text-body);
        box-shadow: var(--propia-shadow-card-hover);
    }

    .auth-logo-img { height: 90px; width: auto; object-fit: contain; }

    .auth-footer { font-size: 12.5px; }

    /* Inputs / buttons con estilo NexLink para auth */
    .auth-card .form-label { font-size: 13px; font-weight: 600; color: var(--propia-text-secondary); margin-bottom: 6px; }
    .auth-card .form-control { padding: 10px 12px; border-radius: 8px; border: 1px solid var(--propia-border-input); background: var(--propia-bg-input); color: var(--propia-text-body); }
    .auth-card .form-control:focus { border-color: var(--propia-border-focus); box-shadow: 0 0 0 3px rgba(139, 120, 240, 0.18); }
    .auth-card .btn-primary,
    .auth-card .btn-auth-primary {
        background: linear-gradient(135deg, var(--propia-brand), var(--propia-brand-hover));
        border: 0; border-radius: 8px; padding: 10px 14px; font-weight: 600;
        transition: filter .15s, transform .05s;
    }
    .auth-card .btn-auth-primary:hover { filter: brightness(1.05); color: var(--propia-text-inverse); }
    .auth-card .btn-auth-primary:active { transform: translateY(1px); }

    /* Password input con toggle de visibilidad (ojo) */
    .password-wrapper { position: relative; }
    .password-wrapper .form-control { padding-right: 40px; }
    .password-toggle {
        position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
        background: transparent; border: 0; padding: 6px 8px; color: var(--propia-text-muted); cursor: pointer; border-radius: 6px;
    }
    .password-toggle:hover { color: var(--propia-brand); background: rgba(89,85,209,0.08); }

    /* Indicador de fortaleza de contrasena */
    .pwd-strength { margin-top: 6px; display: flex; align-items: center; gap: 8px; }
    .pwd-strength-bar { flex: 1; height: 5px; border-radius: 3px; background: #eef0f5; overflow: hidden; }
    .pwd-strength-bar > div { height: 100%; width: 0; transition: width .2s, background .2s; border-radius: 3px; }
    .pwd-strength-label { font-size: 11.5px; font-weight: 600; min-width: 56px; text-align: right; }
    .pwd-strength-weak   .pwd-strength-bar > div { width: 33%; background: #e74c3c; }
    .pwd-strength-weak   .pwd-strength-label { color: #e74c3c; }
    .pwd-strength-medium .pwd-strength-bar > div { width: 66%; background: #f39c12; }
    .pwd-strength-medium .pwd-strength-label { color: #f39c12; }
    .pwd-strength-strong .pwd-strength-bar > div { width: 100%; background: #2ecc71; }
    .pwd-strength-strong .pwd-strength-label { color: #2ecc71; }

    /* Link "Olvidaste tu contrasena" / "Recordarme" line */
    .auth-card a { color: var(--propia-brand); text-decoration: none; font-weight: 500; }
    .auth-card a:hover { text-decoration: underline; }

    /* Divisor horizontal con texto centrado (separa Google del formulario manual) */
    .auth-divider {
        display: flex; align-items: center; gap: 10px;
        color: var(--propia-text-faint); font-size: 12px; font-weight: 500;
    }
    .auth-divider::before,
    .auth-divider::after { content: ""; flex: 1; height: 1px; background: var(--propia-border-input); }
    .auth-divider span { white-space: nowrap; }
</style>
