                    <ul class="side-menubar">
                        <li class="menu-heading"><span class="menu-label">Plataforma A&D GROUP</span></li>
                        <li class="menu-item">
                            <NavLink class="menu-link" href="/panel-plataforma" Match="NavLinkMatch.All">
