                        <li class="menu-item"><NavLink class="menu-link" href="/admin/monitoria" Match="NavLinkMatch.All"><i class="fi fi-rr-chart-histogram"></i><span class="menu-label">Dashboard</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/monitoria/logs"><i class="fi fi-rr-list"></i><span class="menu-label">Logs</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/monitoria/incidentes"><i class="fi fi-rr-triangle-warning"></i><span class="menu-label">Incidentes</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/monitoria/jobs"><i class="fi fi-rr-time-fast"></i><span class="menu-label">Jobs</span></NavLink></li>
                    </ul>
                </nav>
            </div>

        </div>
    </div>
</div>

@code {
    private string _activeTab = "tabPanel";

    protected override void OnInitialized()
    {
        _activeTab = ResolveTab(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var nuevo = ResolveTab(e.Location);
        if (nuevo != _activeTab) { _activeTab = nuevo; InvokeAsync(StateHasChanged); }
    }

    private static string ResolveTab(string uri)
    {
        string path;
        try { path = new Uri(uri).AbsolutePath.ToLowerInvariant(); }
        catch { path = uri.ToLowerInvariant(); }

        if (path.StartsWith("/admin/integraciones") || path.StartsWith("/admin/plantillas")) return "tabIntegraciones";
        if (path is "/admin/organizaciones" or "/admin/copropiedades" or "/admin/equipo" or "/admin/configuracion-menu") return "tabPlataforma";
        if (path.StartsWith("/admin/billing")) return "tabBilling";
        if (path.StartsWith("/admin/monitoria")) return "tabMonitoria";
        return "tabPanel";
    }

    private string TabClass(string id) => _activeTab == id ? "tab-pane fade show active" : "tab-pane fade";
    private string RailClass(string id) => _activeTab == id ? "menu-link active" : "menu-link";
}
