                </nav>
            </div>

            <div class="@TabClass("tabIntegraciones")" id="tabIntegraciones" role="tabpanel">
                <nav class="app-navbar" data-simplebar>
                    <ul class="side-menubar">
                        <li class="menu-heading"><span class="menu-label">Integraciones</span></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/integraciones/ia"><i class="fi fi-rr-brain"></i><span class="menu-label">Servidores de IA</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/integraciones/ocr"><i class="fi fi-rr-document"></i><span class="menu-label">OCR / Documentos</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/integraciones/evolution"><i class="fi fi-rr-comment-alt"></i><span class="menu-label">Servidor Evolution</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/integraciones/correo"><i class="fi fi-rr-envelope"></i><span class="menu-label">Servidor de Correo</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/integraciones/marca"><i class="fi fi-rr-palette"></i><span class="menu-label">Marca</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/integraciones/wompi"><i class="fi fi-rr-credit-card"></i><span class="menu-label">Wompi</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/integraciones/google"><i class="fi fi-rr-key"></i><span class="menu-label">Login con Google</span></NavLink></li>
                        <li class="menu-heading mt-3"><span class="menu-label">Plantillas</span></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/plantillas/agentes-ia"><i class="fi fi-rr-robot"></i><span class="menu-label">Agentes IA</span></NavLink></li>
                    </ul>
                </nav>
            </div>

            <div class="@TabClass("tabPlataforma")" id="tabPlataforma" role="tabpanel">
                <nav class="app-navbar" data-simplebar>
                    <ul class="side-menubar">
                        <li class="menu-heading"><span class="menu-label">Plataforma</span></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/organizaciones"><i class="fi fi-rr-building"></i><span class="menu-label">Organizaciones</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/copropiedades"><i class="fi fi-rr-apartment"></i><span class="menu-label">Copropiedades</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/equipo"><i class="fi fi-rr-users"></i><span class="menu-label">Equipo A&D GROUP</span></NavLink></li>
                        <li class="menu-item"><NavLink class="menu-link" href="/admin/configuracion-menu"><i class="fi fi-rr-menu-burger"></i><span class="menu-label">Menu del sistema</span></NavLink></li>
                    </ul>
                </nav>
