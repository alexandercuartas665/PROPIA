@* Sidebar de PLATAFORMA (A&D GROUP) - misma estructura NexLink que el NavMenu del cliente
   (riel de iconos + panel textual con tabs). El tab activo se calcula server-side desde la ruta
   /admin/* para que coincida siempre, igual que el menu del cliente. *@
@inject NavigationManager Nav
@implements IDisposable

@* === Rail (iconos verticales, 80px) === *@
<div class="app-navbar-tabs" data-simplebar>
    <ul class="nav" id="appMenubarTabs" role="tablist" aria-orientation="vertical">
        <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Panel">
            <a class="@RailClass("tabPanel")" href="javascript:void(0)" data-tab-target="tabPanel"><i class="fi fi-rr-apps"></i></a>
        </li>
        <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Integraciones">
            <a class="@RailClass("tabIntegraciones")" href="javascript:void(0)" data-tab-target="tabIntegraciones"><i class="fi fi-rr-plug"></i></a>
        </li>
        <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Plataforma">
            <a class="@RailClass("tabPlataforma")" href="javascript:void(0)" data-tab-target="tabPlataforma"><i class="fi fi-rr-network"></i></a>
        </li>
        <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Billing">
            <a class="@RailClass("tabBilling")" href="javascript:void(0)" data-tab-target="tabBilling"><i class="fi fi-rr-usd-circle"></i></a>
        </li>
        <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Monitoria">
            <a class="@RailClass("tabMonitoria")" href="javascript:void(0)" data-tab-target="tabMonitoria"><i class="fi fi-rr-chart-histogram"></i></a>
        </li>
    </ul>
</div>

@* === Panel textual (200px) === *@
