@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Shared.Auth
@using Propia.Domain.Enums
@using Propia.Web.Services
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

@* Selector de copropiedad activa para el admin multi-PH (pendiente #9 de la convalidacion 2.3).
   Isla interactiva dentro del MainLayout (SSR): muestra la PH activa en el header y, al hacer
   clic, abre un modal con todas las copropiedades del usuario para cambiar (switch-tenant).
   Backend reusado: GET /connect/me + POST /connect/switch-tenant. Lean v1: avatar de inicial
   (sin imagen real ni unidades/ciudad todavia). *@

@if (_jwt is not null && _activa is not null)
{
    <div class="cs-wrap">
        <button class="cs-trigger @(_tenants.Count > 1 ? "" : "cs-single")" type="button"
                @onclick="Abrir" title="@(_tenants.Count > 1 ? "Cambiar de copropiedad" : _activa.Nombre)">
            @if (!string.IsNullOrWhiteSpace(_activa.LogoUrl))
            {
                <img class="cs-logo" src="@_activa.LogoUrl" alt="" aria-hidden="true" />
            }
            else
            {
                <span class="cs-avatar" aria-hidden="true">@Inicial(_activa.Nombre)</span>
            }
            <span class="cs-meta">
                <span class="cs-label">Copropiedad activa</span>
                <span class="cs-nombre">@_activa.Nombre</span>
            </span>
            @if (_tenants.Count > 1)
            {
                <i class="fi fi-rr-angle-small-down cs-caret"></i>
            }
        </button>
    </div>

    @if (_open)
    {
        <div class="cs-backdrop" @onclick="Cerrar">
            <div class="cs-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                <div class="cs-modal-head">
                    <div>
                        <div class="cs-modal-title">Mis copropiedades</div>
                        <div class="cs-modal-sub">Elige sobre cual quieres trabajar</div>
                    </div>
                    <button class="cs-close" type="button" @onclick="Cerrar" aria-label="Cerrar">&times;</button>
                </div>
                <div class="cs-gallery">
                    @foreach (var t in _tenants)
                    {
                        var esActiva = t.TenantId == _activa.TenantId;
                        <button class="cs-card @(esActiva ? "active" : "")" type="button"
                                @onclick="() => SeleccionarAsync(t)" disabled="@_busy">
                            @if (esActiva)
                            {
                                <span class="cs-card-badge">Activa</span>
                            }
                            <span class="cs-card-thumb">
                                @if (!string.IsNullOrWhiteSpace(t.LogoUrl))
                                {
                                    <img src="@t.LogoUrl" alt="" aria-hidden="true" />
                                }
                                else
                                {
                                    <span class="cs-avatar xl" aria-hidden="true">@Inicial(t.Nombre)</span>
                                }
                            </span>
                            <span class="cs-card-nombre">@t.Nombre</span>
                            <span class="cs-card-rol">@t.Rol</span>
                        </button>
                    }
                    @if (PuedeCrear)
                    {
                        <button class="cs-card cs-card--nueva" type="button" @onclick="AbrirWizard" disabled="@_busy">
                            <span class="cs-card-thumb cs-thumb--nueva">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                            </span>
                            <span class="cs-card-nombre">Nueva copropiedad</span>
                            <span class="cs-card-rol">Agregar a tu organizacion</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @* ---------- Wizard de alta (solo identidad; el resto se completa despues en Mi Copropiedad) ---------- *@
    @if (_wizard)
    {
        <div class="cs-backdrop">
            <div class="cs-modal cs-wiz" role="dialog" aria-modal="true">
                <div class="cs-modal-head">
                    <div>
                        <div class="cs-modal-title">Nueva copropiedad</div>
                        <div class="cs-modal-sub">Paso @_paso de 2 &middot; @(_paso == 1 ? "Datos basicos" : "Ubicacion")</div>
                    </div>
                    <button class="cs-close" type="button" @onclick="CerrarWizard" aria-label="Cerrar">&times;</button>
                </div>

                <div class="cs-wiz-steps">
                    <span class="cs-step @(_paso >= 1 ? "on" : "")"></span>
                    <span class="cs-step @(_paso >= 2 ? "on" : "")"></span>
                </div>

                <div class="cs-wiz-body">
                    @if (_paso == 1)
                    {
                        <label class="cs-lbl">Nombre de la copropiedad *</label>
                        <input class="cs-in" @bind="_form.Nombre" @bind:event="oninput" placeholder="Ej. Conjunto Altos del Bosque" />

                        <label class="cs-lbl">Tipo</label>
                        <select class="cs-in" @bind="_form.Tipo">
                            @foreach (var t in (TipoCopropiedad[])Enum.GetValues(typeof(TipoCopropiedad)))
                            {
                                <option value="@t">@t</option>
                            }
                        </select>

                        <div class="cs-grid2">
                            <div>
                                <label class="cs-lbl">NIT</label>
                                <input class="cs-in" @bind="_form.Nit" placeholder="900123456" />
                            </div>
                            <div>
                                <label class="cs-lbl">Digito de verificacion</label>
                                <input class="cs-in" @bind="_form.Dv" maxlength="1" placeholder="7" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cs-grid2">
                            <div>
                                <label class="cs-lbl">Departamento</label>
                                <select class="cs-in" @bind="_form.Departamento" @bind:after="OnDeptoCambio">
                                    <option value="">Seleccionar...</option>
                                    @foreach (var d in ColombiaCatalogo.DepartamentosColombia)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="cs-lbl">Ciudad</label>
                                <select class="cs-in" @bind="_form.Ciudad" disabled="@string.IsNullOrWhiteSpace(_form.Departamento)">
                                    <option value="">Seleccionar...</option>
                                    @foreach (var c in ColombiaCatalogo.CiudadesDelDepartamento(_form.Departamento))
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <label class="cs-lbl">Direccion</label>
                        <input class="cs-in" @bind="_form.Direccion" placeholder="Cra 45 # 100-20" />

                        <label class="cs-lbl">Estrato</label>
                        <select class="cs-in" @bind="_form.Estrato">
                            @foreach (var e in (Estrato[])Enum.GetValues(typeof(Estrato)))
                            {
                                <option value="@e">@((int)e)</option>
                            }
                        </select>

                        <div class="cs-wiz-note">
                            Se creara dentro de tu organizacion y quedaras como <b>Administrador</b>.
                            La distribucion, zonas y equipos los cargas despues en Mi Copropiedad.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="cs-wiz-error">@_error</div>
                    }
                </div>

                <div class="cs-wiz-foot">
                    @if (_paso == 1)
                    {
                        <button class="cs-btn-ghost" type="button" @onclick="CerrarWizard">Cancelar</button>
                        <button class="cs-btn-brand" type="button" @onclick="() => _paso = 2"
                                disabled="@string.IsNullOrWhiteSpace(_form.Nombre)">Siguiente</button>
                    }
                    else
                    {
                        <button class="cs-btn-ghost" type="button" @onclick="() => _paso = 1">Atras</button>
                        <button class="cs-btn-brand" type="button" @onclick="CrearAsync" disabled="@_busy">
                            @(_busy ? "Creando..." : "Crear copropiedad")
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private string? _jwt;
    private bool _open;
    private bool _busy;
    private List<TenantInfoDto> _tenants = new();
    private TenantInfoDto? _activa;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jwt is not null) return;
        try
        {
            var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
            if (string.IsNullOrWhiteSpace(jwt)) return;
            _jwt = jwt;
            await CargarAsync();
            StateHasChanged();
        }
        catch { /* sin sesion o API no disponible: no renderiza el selector */ }
    }

    private async Task CargarAsync()
    {
        var me = await Auth().GetFromJsonAsync<MeResponseDto>("/connect/me");
        if (me is null) return;
        _tenants = me.AvailableTenants?.ToList() ?? new();
        _activa = _tenants.FirstOrDefault(t => t.TenantId == me.ActiveTenantId) ?? _tenants.FirstOrDefault();
    }

    // Se abre si hay algo que elegir O si el usuario puede crear una copropiedad nueva
    // (con una sola PH el modal sigue siendo la unica puerta al wizard).
    private void Abrir()
    {
        if (_tenants.Count > 1 || PuedeCrear) _open = true;
    }

    private void Cerrar() => _open = false;

    /// <summary>Solo un Administrador de la copropiedad activa da de alta otras (el backend lo revalida).</summary>
    private bool PuedeCrear =>
        _activa is not null && string.Equals(_activa.Rol, "Administrador", StringComparison.OrdinalIgnoreCase);

    private bool _wizard;
    private int _paso = 1;
    private string? _error;
    private NuevaCopropiedadForm _form = new();

    private void AbrirWizard()
    {
        _form = new NuevaCopropiedadForm();
        _paso = 1;
        _error = null;
        _open = false;
        _wizard = true;
    }

    private void CerrarWizard()
    {
        _wizard = false;
        _error = null;
    }

    private void OnDeptoCambio() => _form.Ciudad = "";

    private async Task CrearAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Nombre)) { _paso = 1; _error = "El nombre es obligatorio."; return; }
        _busy = true; _error = null;
        try
        {
            var req = new CrearCopropiedadDto(
                _form.Nombre.Trim(),
                string.IsNullOrWhiteSpace(_form.Nit) ? null : _form.Nit.Trim(),
                string.IsNullOrWhiteSpace(_form.Dv) ? null : _form.Dv.Trim(),
                (int)_form.Tipo,
                (int)_form.Estrato,
                string.IsNullOrWhiteSpace(_form.Direccion) ? null : _form.Direccion.Trim(),
                string.IsNullOrWhiteSpace(_form.Departamento) ? null : _form.Departamento,
                string.IsNullOrWhiteSpace(_form.Ciudad) ? null : _form.Ciudad);

            var resp = await Auth().PostAsJsonAsync("/api/mis-copropiedades", req);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                _error = err is not null && err.TryGetValue("error", out var m) ? m : "No se pudo crear la copropiedad.";
                return;
            }

            var creada = await resp.Content.ReadFromJsonAsync<CopropiedadCreadaResp>();
            if (creada is null) { _error = "Respuesta inesperada del servidor."; return; }

            // Queda parado en la copropiedad recien creada (switch-tenant + recarga).
            await SeleccionarAsync(new TenantInfoDto(creada.TenantId, creada.Nombre, "Administrador"));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private sealed class NuevaCopropiedadForm
    {
        public string Nombre = "";
        public string? Nit;
        public string? Dv;
        public TipoCopropiedad Tipo = TipoCopropiedad.Residencial;
        public Estrato Estrato = Estrato.Tres;
        public string? Direccion;
        public string? Departamento;
        public string? Ciudad;
    }

    private record CrearCopropiedadDto(
        string Nombre, string? Nit, string? DigitoVerificacion,
        int Tipo, int Estrato, string? Direccion, string? Departamento, string? Ciudad);

    private record CopropiedadCreadaResp(Guid TenantId, string Nombre);

    private async Task SeleccionarAsync(TenantInfoDto t)
    {
        if (_activa is not null && t.TenantId == _activa.TenantId) { _open = false; return; }
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/connect/switch-tenant", new SwitchTenantRequestDto(t.TenantId));
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<LoginResponseDto>();
                if (dto is not null)
                {
                    // Persistir el nuevo contexto y recargar para que TODOS los modulos
                    // se re-scopeen al nuevo tenant_id (mismo patron que Panel Consolidado).
                    await Js.InvokeVoidAsync("propiaAuth.save", dto.AccessToken, t.TenantId.ToString(), t.Nombre);
                    Nav.NavigateTo("/mi-copropiedad", forceLoad: true);
                    return;
                }
            }
        }
        catch { /* error de red: dejamos el modal abierto para reintentar */ }
        finally { _busy = false; }
    }

    private static string Inicial(string? n)
        => string.IsNullOrWhiteSpace(n) ? "?" : n.Trim()[..1].ToUpperInvariant();

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}

<style>
    /* ====== Selector de copropiedad (tarjeta en el panel del sidebar) ====== */
    .cs-wrap { padding: 10px 14px 6px; }
    .cs-trigger {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 7px 9px;
        border: 1px solid var(--bs-border-color);
        border-radius: 12px;
        background: var(--bs-body-bg);
        cursor: pointer;
        transition: border-color .15s, box-shadow .15s, background .15s;
        text-align: left;
    }
    .cs-trigger:hover { border-color: var(--propia-primary); background: rgba(89,85,209,.06); }
    .cs-trigger.cs-single { cursor: default; }
    .cs-trigger.cs-single:hover { border-color: var(--bs-border-color); background: var(--bs-body-bg); }

    .cs-avatar {
        width: 30px; height: 30px; flex: 0 0 30px;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--propia-primary), var(--propia-primary-light));
        color: #fff; font-weight: 700; font-size: .95rem;
        display: flex; align-items: center; justify-content: center;
    }
    .cs-avatar.lg { width: 40px; height: 40px; flex-basis: 40px; border-radius: 10px; font-size: 1.1rem; }
    .cs-avatar.xl { width: 64px; height: 64px; flex-basis: 64px; border-radius: 14px; font-size: 1.6rem; }

    /* Logo real de la copropiedad (mismo gabarito que el avatar) */
    .cs-logo {
        width: 30px; height: 30px; flex: 0 0 30px;
        border-radius: 8px; object-fit: cover;
        background: var(--bs-secondary-bg);
        border: 1px solid var(--bs-border-color);
    }
    .cs-logo.lg { width: 40px; height: 40px; flex-basis: 40px; border-radius: 10px; }

    .cs-meta { display: flex; flex-direction: column; line-height: 1.1; min-width: 0; }
    .cs-label { font-size: .66rem; text-transform: uppercase; letter-spacing: .03em; color: var(--bs-secondary-color); }
    .cs-nombre {
        font-size: .85rem; font-weight: 600; color: var(--bs-heading-color);
        max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .cs-caret { color: var(--bs-secondary-color); font-size: 14px; margin-left: 2px; }

    /* ====== Modal ====== */
    .cs-backdrop {
        position: fixed; inset: 0; z-index: 1080;
        background: rgba(15, 15, 30, .45);
        display: flex; align-items: flex-start; justify-content: center;
        padding-top: 12vh;
        animation: cs-fade .12s ease-out;
    }
    @@keyframes cs-fade { from { opacity: 0; } to { opacity: 1; } }
    .cs-modal {
        width: 560px; max-width: calc(100vw - 32px);
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 16px;
        box-shadow: 0 18px 48px rgba(0,0,0,.28);
        overflow: hidden;
    }
    .cs-modal-head {
        display: flex; align-items: flex-start; justify-content: space-between;
        padding: 16px 18px; border-bottom: 1px solid var(--bs-border-color);
    }
    .cs-modal-title { font-weight: 700; color: var(--bs-heading-color); }
    .cs-modal-sub { font-size: .8rem; color: var(--bs-secondary-color); }
    .cs-close {
        background: none; border: none; font-size: 1.5rem; line-height: 1;
        color: var(--bs-secondary-color); cursor: pointer; padding: 0 4px;
    }
    .cs-close:hover { color: var(--bs-heading-color); }
    /* ====== Galeria de copropiedades (cuadricula de tarjetas) ====== */
    .cs-gallery {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        padding: 16px;
        max-height: 64vh; overflow-y: auto;
    }
    @@media (max-width: 560px) { .cs-gallery { grid-template-columns: repeat(2, 1fr); } }

    .cs-card {
        position: relative;
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        padding: 18px 10px 14px;
        border: 1px solid var(--bs-border-color); border-radius: 14px;
        background: var(--bs-body-bg); cursor: pointer; text-align: center;
        transition: background .12s, border-color .12s, box-shadow .12s, transform .08s;
    }
    .cs-card:hover:not(:disabled) {
        border-color: var(--propia-primary);
        box-shadow: 0 6px 18px rgba(89,85,209,.15);
        transform: translateY(-2px);
    }
    .cs-card.active { border-color: var(--propia-primary); background: rgba(89,85,209,.07); }
    .cs-card:disabled { opacity: .6; cursor: default; }

    .cs-card-thumb { display: flex; align-items: center; justify-content: center; }
    .cs-card-thumb img {
        width: 64px; height: 64px; border-radius: 14px; object-fit: cover;
        background: var(--bs-secondary-bg); border: 1px solid var(--bs-border-color);
    }
    .cs-card-nombre {
        font-weight: 600; font-size: .86rem; color: var(--bs-heading-color);
        line-height: 1.15;
    }
    .cs-card-rol { font-size: .76rem; color: var(--bs-secondary-color); }

    /* Tarjeta "Nueva copropiedad": punteada para leerse como una accion, no como una PH mas. */
    .cs-card--nueva { border-style: dashed; }
    .cs-thumb--nueva {
        width: 64px; height: 64px; border-radius: 14px;
        background: rgba(89,85,209,.08); color: var(--propia-primary);
        border: 1px solid var(--bs-border-color);
    }

    .cs-wiz { width: 520px; max-width: 96vw; }
    .cs-wiz-steps { display: flex; gap: 6px; padding: 0 20px 4px; }
    .cs-step { flex: 1; height: 4px; border-radius: 3px; background: var(--bs-border-color); }
    .cs-step.on { background: var(--propia-primary); }

    .cs-wiz-body { padding: 16px 20px; max-height: 60vh; overflow-y: auto; }
    .cs-lbl {
        display: block; font-size: .74rem; font-weight: 600;
        color: var(--bs-secondary-color); margin: 10px 0 4px;
    }
    .cs-in {
        width: 100%; height: 40px; padding: 0 12px;
        border: 1px solid var(--bs-border-color); border-radius: 10px;
        background: var(--bs-body-bg); color: var(--bs-body-color);
        font-size: .88rem; font-family: inherit; box-sizing: border-box;
    }
    .cs-in:focus { outline: none; border-color: var(--propia-primary); }
    .cs-in:disabled { opacity: .6; }
    .cs-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .cs-wiz-note {
        margin-top: 14px; padding: 10px 12px; border-radius: 10px;
        font-size: .78rem; line-height: 1.45;
        background: rgba(89,85,209,.07); color: var(--bs-secondary-color);
        border: 1px solid rgba(89,85,209,.2);
    }
    .cs-wiz-error {
        margin-top: 12px; padding: 10px 12px; border-radius: 10px;
        font-size: .8rem; color: #B91C1C; background: #FEE2E2; border: 1px solid #FCA5A5;
    }

    .cs-wiz-foot {
        display: flex; justify-content: flex-end; gap: 8px;
        padding: 14px 20px; border-top: 1px solid var(--bs-border-color);
    }
    .cs-btn-ghost, .cs-btn-brand {
        height: 38px; padding: 0 16px; border-radius: 10px;
        font-size: .85rem; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .cs-btn-ghost { background: var(--bs-body-bg); border: 1px solid var(--bs-border-color); color: var(--bs-body-color); }
    .cs-btn-brand { background: var(--propia-primary); border: 1px solid var(--propia-primary); color: #fff; }
    .cs-btn-brand:disabled { opacity: .55; cursor: default; }

    .cs-card-badge {
        position: absolute; top: 8px; right: 8px;
        font-size: .66rem; font-weight: 600; color: #fff;
        background: var(--propia-primary); border-radius: 20px; padding: 2px 8px;
    }
</style>
