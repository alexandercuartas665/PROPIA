@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Propia.Shared.Auth
@using Propia.Domain.Enums
@using Propia.Web.Services
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime Js
@inject NavigationManager Nav

@* Selector de copropiedad activa para el admin multi-PH (pendiente #9 de la convalidacion 2.3).
   Isla interactiva dentro del MainLayout (SSR): muestra la PH activa en el header y, al hacer
   clic, abre un modal con todas las copropiedades del usuario para cambiar (switch-tenant).
   Backend reusado: GET /connect/me + POST /connect/switch-tenant. El modal (prefijo .cs-*) calca
   la maqueta modal-copropiedad.html: selector "Mis copropiedades" con buscador + toggle
   Galeria/Tabla, y "Nueva copropiedad" en un unico formulario (Datos basicos + Ubicacion). *@

@if (_jwt is not null && _activa is not null)
{
    <div class="cs-wrap @(Compact ? "cs-wrap--header" : "")">
        <button class="cs-trigger @(Compact ? "cs-trigger--compact" : "") @(_tenants.Count > 1 ? "" : "cs-single")" type="button"
                @onclick="Abrir" title="@(_tenants.Count > 1 ? "Cambiar de copropiedad" : _activa.Nombre)">
            @if (!string.IsNullOrWhiteSpace(_activa.LogoUrl))
            {
                <img class="cs-logo" src="@_activa.LogoUrl" alt="" aria-hidden="true" />
            }
            else
            {
                <span class="cs-avatar" aria-hidden="true">@Inicial(_activa.Nombre)</span>
            }
            <span class="cs-meta">
                <span class="cs-label">Copropiedad activa</span>
                <span class="cs-nombre">@_activa.Nombre</span>
                @if (!string.IsNullOrWhiteSpace(_activa.CodigoCorto))
                {
                    <span class="cs-cod" title="Código de la copropiedad">@_activa.CodigoCorto</span>
                }
            </span>
            @if (_tenants.Count > 1)
            {
                <i class="fi fi-rr-angle-small-down cs-caret"></i>
            }
        </button>
    </div>

    @if (_open)
    {
        <div class="cs-backdrop" @onclick="Cerrar" @onkeydown="OnKeyDown">
            <div class="cs-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" tabindex="-1">
                @if (!_crear)
                {
                    @* ---------- Selector: "Mis copropiedades" (galeria o tabla + buscador) ---------- *@
                    <div class="cs-modal-head">
                        <div>
                            <div class="cs-modal-title">Mis copropiedades</div>
                            <div class="cs-modal-sub">Elige sobre cual quieres trabajar</div>
                        </div>
                        <button class="cs-close" type="button" @onclick="Cerrar" aria-label="Cerrar" title="Cerrar">
                            <i class="fi fi-rr-cross-small"></i>
                        </button>
                    </div>

                    <div class="cs-toolbar">
                        <div class="cs-search">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
                            <input class="cs-search-inp" @ref="_searchRef" @bind="_q" @bind:event="oninput"
                                   placeholder="Buscar copropiedad, codigo o rol..." />
                        </div>
                        <div class="cs-viewtoggle">
                            <button class="cs-vt @(_selVista == "galeria" ? "on" : "")" type="button" @onclick='() => _selVista = "galeria"'>
                                <i class="fi fi-rr-apps"></i> Galeria
                            </button>
                            <button class="cs-vt @(_selVista == "tabla" ? "on" : "")" type="button" @onclick='() => _selVista = "tabla"'>
                                <i class="fi fi-rr-table-columns"></i> Tabla
                            </button>
                        </div>
                    </div>

                    <div class="cs-selbody">
                        @if (_selVista == "tabla")
                        {
                            @if (PuedeCrear)
                            {
                                <div class="cs-crea-bar">
                                    <button class="cs-btn-ghost" type="button" @onclick="AbrirCrear" disabled="@_busy"><i class="fi fi-rr-plus"></i> Nueva copropiedad</button>
                                    <button class="cs-btn-ghost" type="button" @onclick="IrAlAsistente" disabled="@_busy"><i class="fi fi-rr-sparkles"></i> Crear con el asistente</button>
                                </div>
                            }
                            <div class="cs-tblwrap">
                                <table class="cs-tbl">
                                    <thead>
                                        <tr><th>Copropiedad</th><th>Codigo</th><th>Rol</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var listaTabla = Filtradas();
                                        }
                                        @if (listaTabla.Count == 0)
                                        {
                                            <tr><td colspan="4" class="cs-td-empty">Sin resultados para la busqueda.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var t in listaTabla)
                                            {
                                                var esActiva = t.TenantId == _activa.TenantId;
                                                <tr class="cs-trow @(esActiva ? "active" : "")" @onclick="() => SeleccionarAsync(t)">
                                                    <td class="cs-td-nom">
                                                        <span class="cs-avatar cs-avatar--sm" aria-hidden="true">@Inicial(t.Nombre)</span>
                                                        <span class="cs-td-nomtx">@t.Nombre@if (esActiva){<span class="cs-badge-inline">Activa</span>}</span>
                                                    </td>
                                                    <td class="cs-td-cod">@t.CodigoCorto</td>
                                                    <td>@t.Rol</td>
                                                    <td class="cs-td-go"><i class="fi fi-rr-angle-small-right"></i></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="cs-gallery">
                                @if (PuedeCrear)
                                {
                                    <button class="cs-card cs-card--nueva" type="button" @onclick="AbrirCrear" disabled="@_busy">
                                        <span class="cs-card-thumb cs-thumb--nueva"><i class="fi fi-rr-plus"></i></span>
                                        <span class="cs-card-nombre">Nueva copropiedad</span>
                                        <span class="cs-card-rol">Crear a mano (solo identidad)</span>
                                    </button>
                                    <button class="cs-card cs-card--nueva" type="button" @onclick="IrAlAsistente" disabled="@_busy">
                                        <span class="cs-card-thumb cs-thumb--nueva"><i class="fi fi-rr-sparkles"></i></span>
                                        <span class="cs-card-nombre">Crear con el asistente</span>
                                        <span class="cs-card-rol">Ficha completa + cargas por Excel</span>
                                    </button>
                                }
                                @foreach (var t in Filtradas())
                                {
                                    var esActiva = t.TenantId == _activa.TenantId;
                                    <button class="cs-card @(esActiva ? "active" : "")" type="button" @onclick="() => SeleccionarAsync(t)" disabled="@_busy">
                                        @if (esActiva)
                                        {
                                            <span class="cs-card-badge">Activa</span>
                                        }
                                        <span class="cs-card-thumb">
                                            @if (!string.IsNullOrWhiteSpace(t.LogoUrl))
                                            {
                                                <img class="cs-card-logo" src="@t.LogoUrl" alt="" aria-hidden="true" />
                                            }
                                            else
                                            {
                                                <span class="cs-avatar" aria-hidden="true">@Inicial(t.Nombre)</span>
                                            }
                                        </span>
                                        <span class="cs-card-nombre">@t.Nombre</span>
                                        @if (!string.IsNullOrWhiteSpace(t.CodigoCorto))
                                        {
                                            <span class="cs-card-cod" title="Codigo de la copropiedad">@t.CodigoCorto</span>
                                        }
                                        <span class="cs-card-rol">@t.Rol</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* ---------- Creacion: un unico formulario (sin wizard). Solo identidad. ---------- *@
                    <div class="cs-modal-head">
                        <div>
                            <div class="cs-modal-title">Nueva copropiedad</div>
                            <div class="cs-modal-sub">Registra la identidad; la distribucion, zonas y equipos se cargan despues en Mi Copropiedad</div>
                        </div>
                        <button class="cs-close" type="button" @onclick="Cerrar" aria-label="Cerrar" title="Cerrar">
                            <i class="fi fi-rr-cross-small"></i>
                        </button>
                    </div>

                    <div class="cs-form-body">
                        <div class="cs-form">
                            <div class="cs-sectlbl">DATOS BASICOS</div>

                            <label class="cs-lbl">Nombre de la copropiedad *</label>
                            <input class="cs-in" @ref="_nombreRef" @bind="_form.Nombre" @bind:event="oninput" placeholder="Ej. Conjunto Altos del Bosque" />

                            <div class="cs-grid2">
                                <div>
                                    <label class="cs-lbl">Tipo</label>
                                    <select class="cs-in" @bind="_form.Tipo">
                                        @foreach (var t in (TipoCopropiedad[])Enum.GetValues(typeof(TipoCopropiedad)))
                                        {
                                            <option value="@t">@t</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="cs-lbl">Estrato</label>
                                    <select class="cs-in" @bind="_form.Estrato">
                                        @foreach (var e in (Estrato[])Enum.GetValues(typeof(Estrato)))
                                        {
                                            <option value="@e">@((int)e)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="cs-grid2">
                                <div>
                                    <label class="cs-lbl">NIT</label>
                                    <input class="cs-in" @bind="_form.Nit" placeholder="900123456" />
                                </div>
                                <div>
                                    <label class="cs-lbl">Digito de verificacion</label>
                                    <input class="cs-in" @bind="_form.Dv" maxlength="1" placeholder="7" />
                                </div>
                            </div>

                            <div class="cs-sectlbl">UBICACION</div>

                            <div class="cs-grid2">
                                <div>
                                    <label class="cs-lbl">Departamento</label>
                                    <select class="cs-in" @bind="_form.Departamento" @bind:after="OnDeptoCambio">
                                        <option value="">Seleccionar...</option>
                                        @foreach (var d in ColombiaCatalogo.DepartamentosColombia)
                                        {
                                            <option value="@d">@d</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="cs-lbl">Ciudad</label>
                                    <select class="cs-in" @bind="_form.Ciudad" disabled="@string.IsNullOrWhiteSpace(_form.Departamento)">
                                        <option value="">Seleccionar...</option>
                                        @foreach (var c in ColombiaCatalogo.CiudadesDelDepartamento(_form.Departamento))
                                        {
                                            <option value="@c">@c</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <label class="cs-lbl">Direccion</label>
                            <input class="cs-in" @bind="_form.Direccion" placeholder="Cra 45 # 100-20" />

                            <div class="cs-note">
                                Se creara dentro de tu organizacion y quedaras como <b>Administrador</b>.
                            </div>

                            @if (!string.IsNullOrEmpty(_error))
                            {
                                <div class="cs-err">@_error</div>
                            }
                        </div>
                    </div>

                    <div class="cs-modal-foot">
                        <button class="cs-btn-ghost" type="button" @onclick="Cerrar">Cancelar</button>
                        <button class="cs-btn-brand @(_busy ? "cs-dis" : "")" type="button" @onclick="CrearAsync" disabled="@_busy">
                            <i class="fi fi-rr-check"></i> @(_busy ? "Creando..." : "Crear copropiedad")
                        </button>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    /// <summary>Modo compacto para la barra superior (pill horizontal). Por defecto false (tarjeta del sidebar).</summary>
    [Parameter] public bool Compact { get; set; }

    private string? _jwt;
    private bool _open;
    private bool _crear;         // false = selector; true = formulario de creacion (mismo backdrop)
    private bool _busy;
    private string _selVista = "galeria";   // "galeria" | "tabla"
    private string _q = "";                  // texto del buscador (nombre / codigo / rol)
    private List<TenantInfoDto> _tenants = new();
    private TenantInfoDto? _activa;

    private ElementReference _searchRef;
    private ElementReference _nombreRef;
    private bool _focusSearch;
    private bool _focusNombre;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _jwt is null)
        {
            try
            {
                var jwt = await Js.InvokeAsync<string?>("sessionStorage.getItem", "propia_jwt");
                if (!string.IsNullOrWhiteSpace(jwt))
                {
                    _jwt = jwt;
                    await CargarAsync();
                    StateHasChanged();
                }
            }
            catch { /* sin sesion o API no disponible: no renderiza el selector */ }
        }

        // Autofoco: buscador al abrir el selector, Nombre al entrar a creacion. Ademas garantiza
        // que haya un elemento con foco DENTRO del modal para que Escape (que burbujea) cierre.
        if (_focusSearch)
        {
            _focusSearch = false;
            try { await _searchRef.FocusAsync(); } catch { }
        }
        if (_focusNombre)
        {
            _focusNombre = false;
            try { await _nombreRef.FocusAsync(); } catch { }
        }
    }

    private async Task CargarAsync()
    {
        var me = await Auth().GetFromJsonAsync<MeResponseDto>("/connect/me");
        if (me is null) return;
        _tenants = me.AvailableTenants?.ToList() ?? new();
        _activa = _tenants.FirstOrDefault(t => t.TenantId == me.ActiveTenantId) ?? _tenants.FirstOrDefault();
    }

    // Se abre si hay algo que elegir O si el usuario puede crear una copropiedad nueva
    // (con una sola PH el modal sigue siendo la unica puerta a la creacion). Al abrir se
    // resetea a la vista Galeria con el buscador vacio (mismo contrato que la maqueta).
    private void Abrir()
    {
        if (_tenants.Count > 1 || PuedeCrear)
        {
            _crear = false;
            _selVista = "galeria";
            _q = "";
            _error = null;
            _open = true;
            _focusSearch = true;
        }
    }

    private void Cerrar()
    {
        _open = false;
        _crear = false;
        _error = null;
    }

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Cerrar();
    }

    /// <summary>Copropiedades del usuario filtradas por el buscador (nombre / codigo / rol), sin distinguir mayus/acentos basicos.</summary>
    private List<TenantInfoDto> Filtradas()
    {
        var q = _q?.Trim();
        if (string.IsNullOrEmpty(q)) return _tenants;
        return _tenants
            .Where(t => $"{t.Nombre} {t.CodigoCorto} {t.Rol}".Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    /// <summary>Capacidad de organizacion: puede crear una copropiedad nueva si es Administrador en
    /// ALGUNA de sus copropiedades (no solo la activa). El backend revalida y la cuelga de una
    /// organizacion que el usuario administre.</summary>
    private bool PuedeCrear =>
        _tenants.Any(t => string.Equals(t.Rol, "Administrador", StringComparison.OrdinalIgnoreCase));

    private string? _error;
    private NuevaCopropiedadForm _form = new();

    // Alta a mano (solo identidad): cambia el contenido del modal al formulario unico.
    private void AbrirCrear()
    {
        _form = new NuevaCopropiedadForm();
        _error = null;
        _crear = true;
        _focusNombre = true;
    }

    // Alternativa guiada: el onboarding de /bienvenida con ficha completa, asistente IA y
    // cargas por Excel (modo=nueva salta los pasos de bienvenida y perfil).
    private void IrAlAsistente()
    {
        _open = false;
        Nav.NavigateTo("/bienvenida?modo=nueva", forceLoad: true);
    }

    private void OnDeptoCambio() => _form.Ciudad = "";

    private async Task CrearAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Nombre)) { _error = "El nombre es obligatorio."; _focusNombre = true; return; }
        _busy = true; _error = null;
        try
        {
            var req = new CrearCopropiedadDto(
                _form.Nombre.Trim(),
                string.IsNullOrWhiteSpace(_form.Nit) ? null : _form.Nit.Trim(),
                string.IsNullOrWhiteSpace(_form.Dv) ? null : _form.Dv.Trim(),
                (int)_form.Tipo,
                (int)_form.Estrato,
                string.IsNullOrWhiteSpace(_form.Direccion) ? null : _form.Direccion.Trim(),
                string.IsNullOrWhiteSpace(_form.Departamento) ? null : _form.Departamento,
                string.IsNullOrWhiteSpace(_form.Ciudad) ? null : _form.Ciudad);

            var resp = await Auth().PostAsJsonAsync("/api/mis-copropiedades", req);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                _error = err is not null && err.TryGetValue("error", out var m) ? m : "No se pudo crear la copropiedad.";
                return;
            }

            var creada = await resp.Content.ReadFromJsonAsync<CopropiedadCreadaResp>();
            if (creada is null) { _error = "Respuesta inesperada del servidor."; return; }

            // Queda parado en la copropiedad recien creada (switch-tenant + recarga).
            await SeleccionarAsync(new TenantInfoDto(creada.TenantId, creada.Nombre, "Administrador"));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private sealed class NuevaCopropiedadForm
    {
        public string Nombre = "";
        public string? Nit;
        public string? Dv;
        public TipoCopropiedad Tipo = TipoCopropiedad.Residencial;
        public Estrato Estrato = Estrato.Tres;
        public string? Direccion;
        public string? Departamento;
        public string? Ciudad;
    }

    private record CrearCopropiedadDto(
        string Nombre, string? Nit, string? DigitoVerificacion,
        int Tipo, int Estrato, string? Direccion, string? Departamento, string? Ciudad);

    private record CopropiedadCreadaResp(Guid TenantId, string Nombre);

    private async Task SeleccionarAsync(TenantInfoDto t)
    {
        if (_activa is not null && t.TenantId == _activa.TenantId) { _open = false; return; }
        _busy = true;
        try
        {
            var resp = await Auth().PostAsJsonAsync("/connect/switch-tenant", new SwitchTenantRequestDto(t.TenantId));
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<LoginResponseDto>();
                if (dto is not null)
                {
                    // Persistir el nuevo contexto y recargar para que TODOS los modulos
                    // se re-scopeen al nuevo tenant_id (mismo patron que Panel Consolidado).
                    // Recargamos el MODULO ACTUAL (no saltamos a Mi Copropiedad) para no sacar al
                    // usuario de donde esta trabajando; el forceLoad re-scopea todo al nuevo tenant.
                    await Js.InvokeVoidAsync("propiaAuth.save", dto.AccessToken, t.TenantId.ToString(), t.Nombre);
                    Nav.NavigateTo(Nav.Uri, forceLoad: true);
                    return;
                }
            }
        }
        catch { /* error de red: dejamos el modal abierto para reintentar */ }
        finally { _busy = false; }
    }

    private static string Inicial(string? n)
        => string.IsNullOrWhiteSpace(n) ? "?" : n.Trim()[..1].ToUpperInvariant();

    private HttpClient Auth()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _jwt!);
        return http;
    }
}

<style>
    /* ====== Trigger del selector (pill/tarjeta del header o del sidebar) — sin cambios ====== */
    .cs-wrap { padding: 12px 14px 6px; }
    .cs-trigger {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--bs-border-color);
        border-radius: 13px;
        background: var(--bs-body-bg);
        cursor: pointer;
        transition: border-color .15s, box-shadow .15s, background .15s;
        text-align: left;
    }
    .cs-trigger:hover { border-color: var(--propia-primary); background: rgba(89,85,209,.06); }
    .cs-trigger.cs-single { cursor: default; }
    .cs-trigger.cs-single:hover { border-color: var(--bs-border-color); background: var(--bs-body-bg); }

    /* ====== Variante COMPACTA para la barra superior (pill horizontal, centrada) ====== */
    /* IMPORTANTE: sin `transform` aqui. Un ancestro transformado convierte el position:fixed del
       modal (.cs-backdrop) en relativo a este contenedor y lo rompe. Se centra con inset + flex. */
    .cs-header-center {
        position: fixed; top: 0; left: var(--pnav-w, 276px); right: 0; height: 80px; z-index: 11;
        display: flex; align-items: center; justify-content: center;
        pointer-events: none;   /* deja pasar clics a la fecha/herramientas del header */
    }
    .cs-header-center .cs-wrap { pointer-events: auto; }   /* el pill si es clicable */
    .cs-wrap--header { padding: 0; }
    .cs-trigger--compact {
        width: auto; max-width: 340px;
        padding: 5px 10px; gap: 9px; border-radius: 11px;
    }
    .cs-trigger--compact .cs-avatar,
    .cs-trigger--compact .cs-logo {
        width: 30px; height: 30px; flex: 0 0 30px; border-radius: 8px; font-size: .95rem;
    }
    .cs-trigger--compact .cs-meta { flex-direction: row; align-items: center; gap: 8px; }
    .cs-trigger--compact .cs-label { display: none; }   /* "Copropiedad activa" sobra en la barra */
    .cs-trigger--compact .cs-nombre {
        -webkit-line-clamp: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        max-width: 200px; font-size: .9rem;
    }
    .cs-trigger--compact .cs-cod { align-self: center; margin-top: 0; }
    @@media (max-width: 1280px) { .cs-trigger--compact .cs-nombre { max-width: 140px; } }

    .cs-avatar {
        width: 52px; height: 52px; flex: 0 0 52px;
        border-radius: 13px;
        background: linear-gradient(135deg, var(--propia-primary), var(--propia-primary-light));
        color: var(--propia-text-inverse); font-weight: 700; font-size: 1.25rem;
        display: flex; align-items: center; justify-content: center;
    }
    /* Logo real de la copropiedad (mismo gabarito que el avatar) */
    .cs-logo {
        width: 52px; height: 52px; flex: 0 0 52px;
        border-radius: 13px; object-fit: cover;
        background: var(--bs-secondary-bg);
        border: 1px solid var(--bs-border-color);
    }
    .cs-meta { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
    .cs-label { font-size: .68rem; text-transform: uppercase; letter-spacing: .03em; color: var(--bs-secondary-color); }
    .cs-nombre {
        font-size: .95rem; font-weight: 600; color: var(--bs-heading-color);
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden; overflow-wrap: anywhere;
    }
    .cs-caret { color: var(--bs-secondary-color); font-size: 14px; margin-left: 2px; }
    /* Codigo corto (6 chars) monospace tipo chip en el trigger. */
    .cs-cod {
        align-self: flex-start; margin-top: 2px;
        font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
        font-size: .68rem; font-weight: 700; letter-spacing: .05em;
        color: var(--propia-brand); background: var(--propia-brand-soft);
        border: 1px solid var(--propia-brand-border); border-radius: 6px; padding: 1px 6px;
    }

    /* ====== Modal Selector + Creacion (CALCA maqueta modal-copropiedad.html .cs-*, tokens --propia-*) ====== */
    /* Frame: mismo max-width/radio que el resto de modales, centrado; alto segun contenido hasta 86vh. */
