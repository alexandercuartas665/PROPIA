{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Propia": "REPLACE_IN_RAILWAY"
  },
  "Jwt": {
    "Issuer": "propia-api",
    "Audience": "propia-clients",
    "SigningKey": "REPLACE_IN_RAILWAY",
    "AccessTokenMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": "https://app.propia.cubot.com.co"
  },
  "Storage": {
    "Provider": "R2",
    "R2": {
      "AccountId": "REPLACE_IN_RAILWAY",
      "AccessKeyId": "REPLACE_IN_RAILWAY",
      "SecretAccessKey": "REPLACE_IN_RAILWAY",
      "BucketName": "propia-pilot-uploads",
      "PublicUrl": "https://uploads.propia.cubot.com.co"
    }
  }
}
