@page "/integraciones/ocr"
@rendermode InteractiveServer
@using Propia.Application.Integraciones
@using Propia.Domain.Enums
@inject IHttpClientFactory HttpFactory
@inject SuperAdminSession Session
@inject NavigationManager Nav

<PageTitle>OCR / Lectura de documentos</PageTitle>

@if (!Session.IsAuthenticated) { Nav.NavigateTo("/login", forceLoad: true); return; }

<h1 class="h3 mb-1">OCR / Lectura de documentos</h1>
<p class="text-muted mb-4">Proveedor maestro de OCR de la plataforma. Lo usan los modulos que leen documentos: recibos de servicios publicos (2.17), RUT / Camara de Comercio (Directorio) y contratos. La API key se guarda cifrada y nunca se muestra completa.</p>

@if (_cargando)
{
    <div class="text-center py-5"><div class="spinner-border"></div></div>
}
else if (_p is not null)
{
    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert @_msgCls">@_msg</div> }
    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong>@_p.DisplayName</strong>
                    @if (_p.IsEnabled) { <span class="badge bg-success">Habilitado</span> } else { <span class="badge bg-secondary">Inactivo</span> }
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Proveedor de OCR</label>
                            <select class="form-select" @onchange="CambiarProveedor" disabled="@_busy">
                                @foreach (var p in OcrProviderCatalog.Todos)
                                {
                                    <option value="@((int)p)" selected="@(p == _provSel)">@OcrProviderCatalog.For(p).DisplayName</option>
                                }
                            </select>
                            <div class="form-text">Solo un proveedor puede estar habilitado a la vez. Al habilitar uno se desactiva el otro.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Endpoint</label>
                            <input class="form-control" @bind="_p.Endpoint" placeholder="@(_esVision ? "https://miorg-vision.cognitiveservices.azure.com" : "https://miorg-di.cognitiveservices.azure.com")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@(_esVision ? "Feature (Image Analysis)" : "Modelo")</label>
                            <input class="form-control" list="ocr-models" @bind="_p.ModelId" placeholder="@_p.DefaultModel" />
                            <datalist id="ocr-models">
                                @foreach (var m in _p.SuggestedModels) { <option value="@m" /> }
                            </datalist>
                            @if (_esVision)
                            {
                                <div class="form-text">Computer Vision 4.0 usa la feature <code>read</code> (texto crudo del documento). Solo imagenes (JPG/PNG); no PDF.</div>
                            }
                            else
                            {
                                <div class="form-text">Recibos de servicios: <code>prebuilt-invoice</code> o <code>prebuilt-receipt</code>. Texto plano: <code>prebuilt-read</code>.</div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">API Key @(_p.HasApiKey ? "(guardada - dejar vacio para conservar)" : "")</label>
                            <input type="password" class="form-control" @bind="_p.NewApiKey" placeholder="@(_p.HasApiKey ? _p.ApiKeyMasked : "clave del recurso")" />
                        </div>
                        <div class="col-12">
                            <div class="form-check"><input type="checkbox" class="form-check-input" id="ocr-en" @bind="_p.IsEnabled" /><label class="form-check-label" for="ocr-en">Habilitar (requiere endpoint + API key)</label></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white text-end">
                    <button class="btn btn-dark btn-sm" @onclick="GuardarAsync" disabled="@_busy">Guardar</button>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card bg-light">
                <div class="card-body small text-muted">
                    <strong class="text-dark">Como obtener las credenciales (Azure)</strong>
                    @if (_esVision)
                    {
                        <ol class="mt-2 mb-0 ps-3">
                            <li>Crea un recurso <em>Azure AI Vision (Computer Vision)</em> en el portal de Azure.</li>
                            <li>En "Keys and Endpoint" copia el <em>Endpoint</em> y una <em>Key</em>.</li>
                            <li>Pegalos aqui, deja la feature en <code>read</code> y marca Habilitar.</li>
                        </ol>
                        <div class="mt-2">Devuelve el texto crudo del documento (no campos estructurados como total o fecha).</div>
                    }
                    else
                    {
                        <ol class="mt-2 mb-0 ps-3">
                            <li>Crea un recurso <em>Document Intelligence</em> (Form Recognizer) en el portal de Azure.</li>
                            <li>En "Keys and Endpoint" copia el <em>Endpoint</em> y una <em>Key</em>.</li>
                            <li>Pegalos aqui, deja el modelo en <code>prebuilt-invoice</code> y marca Habilitar.</li>
                        </ol>
                        <div class="mt-2">La imagen del documento se procesa en el servicio de Azure que configures.</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _cargando = true;
    private bool _busy;
    private string? _msg;
    private string _msgCls = "alert-info";
    private Row? _p;
    private OcrProvider _provSel = OcrProvider.AzureDocumentIntelligence;
    private bool _esVision => _provSel == OcrProvider.AzureComputerVision;

    private class Row
    {
        public OcrProvider Provider { get; set; }
        public string DisplayName { get; set; } = "";
        public string? Endpoint { get; set; }
        public string? ModelId { get; set; }
        public string? ApiKeyMasked { get; set; }
        public bool HasApiKey { get; set; }
        public bool IsEnabled { get; set; }
        public string DefaultModel { get; set; } = "";
        public IReadOnlyList<string> SuggestedModels { get; set; } = Array.Empty<string>();
        public string? NewApiKey { get; set; }
    }

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync(OcrProvider? provider = null)
    {
        _cargando = true;
        try
        {
            var url = provider.HasValue ? $"/admin/ocr-config?provider={(int)provider.Value}" : "/admin/ocr-config";
            var c = await AuthorizedClient().GetFromJsonAsync<OcrProviderDto>(url);
            if (c is not null)
            {
                _provSel = c.Provider;
                _p = new Row
                {
                    Provider = c.Provider, DisplayName = c.DisplayName, Endpoint = c.Endpoint, ModelId = c.ModelId,
                    ApiKeyMasked = c.ApiKeyMasked, HasApiKey = c.HasApiKey, IsEnabled = c.IsEnabled,
                    DefaultModel = c.DefaultModel, SuggestedModels = c.SuggestedModels
                };
            }
        }
        finally { _cargando = false; }
    }

    private async Task CambiarProveedor(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _msg = null;
            await CargarAsync((OcrProvider)v);
        }
    }

    private async Task GuardarAsync()
    {
        if (_p is null) return;
        _busy = true; _msg = null;
        try
        {
            var req = new SaveOcrProviderRequest(_p.Provider, _p.Endpoint, _p.NewApiKey, _p.ModelId, _p.IsEnabled);
            var resp = await AuthorizedClient().PutAsJsonAsync("/admin/ocr-config", req);
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<OcrProviderDto>();
                if (dto is not null) { _p.HasApiKey = dto.HasApiKey; _p.ApiKeyMasked = dto.ApiKeyMasked; _p.IsEnabled = dto.IsEnabled; _p.NewApiKey = null; }
                _msg = "Configuracion de OCR guardada."; _msgCls = "alert-success";
            }
            else { _msg = $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}"; _msgCls = "alert-danger"; }
        }
        finally { _busy = false; }
    }

    private HttpClient AuthorizedClient()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Session.AccessToken!);
        return http;
    }
}
