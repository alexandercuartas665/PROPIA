@page "/billing/suscripciones"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject SuperAdminSession Session
@inject NavigationManager Nav

<PageTitle>Suscripciones - Billing</PageTitle>

@if (!Session.IsAuthenticated) { Nav.NavigateTo("/login", forceLoad: true); return; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Suscripciones</h1>
    <button class="btn btn-dark" @onclick="MostrarFormulario">+ Crear suscripcion</button>
</div>

@if (_mostrarForm)
{
    <div class="card mb-4 border-dark">
        <div class="card-body">
            <h5>Nueva suscripcion</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Cliente (Organizacion o Copropiedad)</label>
                    <select class="form-select" @bind="_clienteSel">
                        <option value="">- Selecciona -</option>
                        <optgroup label="Organizaciones">
                            @foreach (var o in _organizaciones)
                            {
                                <option value="@($"org:{o.Id}")">[ORG] @o.Nombre</option>
                            }
                        </optgroup>
                        <optgroup label="Copropiedades">
                            @foreach (var t in _tenants)
                            {
                                <option value="@($"cp:{t.Id}")">[CP] @t.Nombre</option>
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Plan</label>
                    <select class="form-select" @bind="_form.PlanIdStr">
                        <option value="">- Plan -</option>
                        @foreach (var p in _planesActivos)
                        {
                            <option value="@p.Id">@p.Nombre - $@p.FeeBase.ToString("N0")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Ciclo</label>
                    <select class="form-select" @bind="_form.Ciclo">
                        <option value="@CicloFacturacion.Mensual">Mensual</option>
                        <option value="@CicloFacturacion.Anual">Anual</option>
                    </select>
                </div>
                <div class="col-12">
                    @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2">@_error</div> }
                    <button class="btn btn-dark me-2" @onclick="CrearAsync" disabled="@_busy">@(_busy ? "Creando..." : "Crear")</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _mostrarForm = false">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_cambioEstadoId is not null)
{
    <div class="card mb-4 border-warning">
        <div class="card-body">
            <h5>Cambiar estado de suscripcion</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nuevo estado</label>
                    <select class="form-select" @bind="_estadoNuevo">
                        <option value="@EstadoSuscripcion.Trial">Trial</option>
                        <option value="@EstadoSuscripcion.Activa">Activa</option>
                        <option value="@EstadoSuscripcion.Suspendida">Suspendida</option>
                        <option value="@EstadoSuscripcion.EnCancelacion">En cancelacion</option>
                        <option value="@EstadoSuscripcion.Cancelada">Cancelada</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Justificacion <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="_estadoJustif" placeholder="Ej. Pago al dia + ajuste manual" />
                </div>
                <div class="col-12">
                    @if (!string.IsNullOrEmpty(_estadoError)) { <div class="alert alert-danger py-2">@_estadoError</div> }
                    <button class="btn btn-warning me-2" @onclick="AplicarEstadoAsync" disabled="@_estadoBusy">
                        @(_estadoBusy ? "Aplicando..." : "Aplicar")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => _cambioEstadoId = null">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_cargando)
{
    <div class="text-center py-5"><div class="spinner-border"></div></div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Cliente</th>
                        <th>Plan</th>
                        <th>Ciclo</th>
                        <th>Estado</th>
                        <th>Activacion</th>
                        <th>Proximo cobro</th>
                        <th>Trial</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _suscripciones)
                    {
                        <tr>
                            <td>
                                <strong>@(s.OrganizacionNombre ?? s.CopropiedadNombre)</strong>
                                <div class="text-muted small">@(s.OrganizacionId.HasValue ? "Organizacion" : "Copropiedad directa")</div>
                            </td>
                            <td>@s.PlanNombre</td>
                            <td><span class="badge bg-info text-dark">@s.Ciclo</span></td>
                            <td>@EstadoBadge(s.Estado)</td>
                            <td><small>@s.FechaInicio</small></td>
                            <td><small>@s.FechaProximoCobro (dia @s.FechaAniversario)</small></td>
                            <td><small>@(s.FechaFinTrial?.ToString() ?? "-")</small></td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => MostrarCambioEstado(s)">Estado</button>
                            </td>
                        </tr>
                    }
                    @if (_suscripciones.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Sin suscripciones aun.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _cargando = true;
    private bool _mostrarForm;
    private bool _busy;
    private string? _error;
    private List<SuscripcionDto> _suscripciones = new();
    private List<OrganizacionDto> _organizaciones = new();
    private List<TenantDto> _tenants = new();
    private List<PlanDto> _planesActivos = new();
    private SuscripcionForm _form = new();
    private string _clienteSel = "";

    // Cambio de estado
    private Guid? _cambioEstadoId;
    private EstadoSuscripcion _estadoNuevo = EstadoSuscripcion.Activa;
    private string _estadoJustif = "";
    private string? _estadoError;
    private bool _estadoBusy;

    private class SuscripcionForm
    {
        public string PlanIdStr { get; set; } = "";
        public CicloFacturacion Ciclo { get; set; } = CicloFacturacion.Mensual;
    }

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        try
        {
            var http = AuthorizedClient();
            _suscripciones = await http.GetFromJsonAsync<List<SuscripcionDto>>("/admin/billing/suscripciones") ?? new();
            _organizaciones = await http.GetFromJsonAsync<List<OrganizacionDto>>("/admin/organizaciones") ?? new();
            _tenants = await http.GetFromJsonAsync<List<TenantDto>>("/admin/tenants") ?? new();
            var todos = await http.GetFromJsonAsync<List<PlanDto>>("/admin/billing/planes") ?? new();
            _planesActivos = todos.Where(p => p.Estado == EstadoPlan.Activo).ToList();
        }
        finally { _cargando = false; }
    }

    private void MostrarFormulario()
    {
        _form = new SuscripcionForm();
        _clienteSel = "";
        _error = null;
        _mostrarForm = true;
    }

    private async Task CrearAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_clienteSel)) { _error = "Selecciona cliente."; return; }
        if (!Guid.TryParse(_form.PlanIdStr, out var planId)) { _error = "Selecciona plan."; return; }
        Guid? orgId = null, cpId = null;
        if (_clienteSel.StartsWith("org:") && Guid.TryParse(_clienteSel.Substring(4), out var g1)) orgId = g1;
        else if (_clienteSel.StartsWith("cp:") && Guid.TryParse(_clienteSel.Substring(3), out var g2)) cpId = g2;
        else { _error = "Cliente invalido."; return; }

        _busy = true;
        try
        {
            var http = AuthorizedClient();
            var req = new CrearSuscripcionRequest(orgId, cpId, planId, _form.Ciclo);
            var resp = await http.PostAsJsonAsync("/admin/billing/suscripciones", req);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}";
                return;
            }
            _mostrarForm = false;
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private void MostrarCambioEstado(SuscripcionDto s)
    {
        _cambioEstadoId = s.Id;
        _estadoNuevo = s.Estado;
        _estadoJustif = "";
        _estadoError = null;
    }

    private async Task AplicarEstadoAsync()
    {
        if (string.IsNullOrWhiteSpace(_estadoJustif)) { _estadoError = "Justificacion obligatoria."; return; }
        _estadoBusy = true; _estadoError = null;
        try
        {
            var http = AuthorizedClient();
            var resp = await http.PutAsJsonAsync($"/admin/billing/suscripciones/{_cambioEstadoId}/estado",
                new CambiarEstadoSuscripcionRequest(_estadoNuevo, _estadoJustif));
            if (!resp.IsSuccessStatusCode)
            {
                _estadoError = $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}";
                return;
            }
            _cambioEstadoId = null;
            await CargarAsync();
        }
        finally { _estadoBusy = false; }
    }

    private RenderFragment EstadoBadge(EstadoSuscripcion e) => __builder =>
    {
        var cls = e switch
        {
            EstadoSuscripcion.Activa => "bg-success",
            EstadoSuscripcion.Trial => "bg-info text-dark",
            EstadoSuscripcion.Suspendida => "bg-warning text-dark",
            EstadoSuscripcion.EnCancelacion => "bg-secondary",
            EstadoSuscripcion.Cancelada or EstadoSuscripcion.Archivada => "bg-dark",
            _ => "bg-light text-dark"
        };
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", $"badge {cls}");
        __builder.AddContent(2, e.ToString());
        __builder.CloseElement();
    };

    private HttpClient AuthorizedClient()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Session.AccessToken!);
        return http;
    }
}
