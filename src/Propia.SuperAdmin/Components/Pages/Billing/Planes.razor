@page "/billing/planes"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject SuperAdminSession Session
@inject NavigationManager Nav

<PageTitle>Planes - Billing</PageTitle>

@if (!Session.IsAuthenticated) { Nav.NavigateTo("/login", forceLoad: true); return; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Planes comerciales</h1>
    <button class="btn btn-dark" @onclick="MostrarFormulario">+ Crear plan</button>
</div>

@if (_mostrarForm)
{
    <div class="card mb-4 border-dark">
        <div class="card-body">
            <h5>@(_editId is null ? "Nuevo plan" : "Editar plan")</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="_form.Nombre" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fee base (COP)</label>
                    <input type="number" step="100" class="form-control" @bind="_form.FeeBase" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fee variable por unidad</label>
                    <input type="number" step="100" class="form-control" @bind="_form.FeeVariablePorUnidad" />
                </div>
                <div class="col-12">
                    <label class="form-label">Descripcion</label>
                    <textarea class="form-control" rows="2" @bind="_form.Descripcion"></textarea>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Dias de trial</label>
                    <input type="number" class="form-control" @bind="_form.DiasTrial" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">% Desc. anual</label>
                    <input type="number" step="0.5" class="form-control" @bind="_form.DescuentoAnualPct" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Limite unidades</label>
                    <input type="number" class="form-control" @bind="_form.LimiteUnidades" placeholder="vacio = ilimitado" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Limite usuarios</label>
                    <input type="number" class="form-control" @bind="_form.LimiteUsuarios" placeholder="vacio = ilimitado" />
                </div>
                <div class="col-md-3 form-check ms-3 mt-4">
                    <input type="checkbox" class="form-check-input" id="cm" @bind="_form.CicloMensual" />
                    <label class="form-check-label" for="cm">Ciclo mensual</label>
                </div>
                <div class="col-md-3 form-check ms-3 mt-4">
                    <input type="checkbox" class="form-check-input" id="ca" @bind="_form.CicloAnual" />
                    <label class="form-check-label" for="ca">Ciclo anual</label>
                </div>
                @if (_editId is not null)
                {
                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="_form.Estado">
                            <option value="@EstadoPlan.Activo">Activo</option>
                            <option value="@EstadoPlan.Inactivo">Inactivo</option>
                            <option value="@EstadoPlan.Archivado">Archivado</option>
                        </select>
                    </div>
                }
                <div class="col-12">
                    @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2">@_error</div> }
                    <button class="btn btn-dark me-2" @onclick="GuardarAsync" disabled="@_busy">
                        @(_busy ? "Guardando..." : (_editId is null ? "Crear" : "Guardar"))
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="CancelarForm">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_cargando)
{
    <div class="text-center py-5"><div class="spinner-border"></div></div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th class="text-end">Fee base</th>
                        <th class="text-end">Fee/unidad</th>
                        <th class="text-center">Ciclo</th>
                        <th>Trial</th>
                        <th>Suscripciones</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _planes)
                    {
                        <tr>
                            <td>
                                <strong>@p.Nombre</strong>
                                @if (!string.IsNullOrEmpty(p.Descripcion)) { <div class="text-muted small">@p.Descripcion</div> }
                            </td>
                            <td>@EstadoBadge(p.Estado)</td>
                            <td class="text-end">@p.FeeBase.ToString("N0")</td>
                            <td class="text-end">@p.FeeVariablePorUnidad.ToString("N0")</td>
                            <td class="text-center"><small>@(p.CicloMensual ? "M" : "")@(p.CicloAnual ? "/A" : "") @(p.DescuentoAnualPct > 0 ? $"(-{p.DescuentoAnualPct}%)" : "")</small></td>
                            <td><small>@p.DiasTrial dias</small></td>
                            <td>@p.SuscripcionesActivas</td>
                            <td>
                                <button class="btn btn-sm btn-outline-dark" @onclick="() => EditarPlan(p)">Editar</button>
                            </td>
                        </tr>
                    }
                    @if (_planes.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Sin planes aun. Crea el primero.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _cargando = true;
    private bool _mostrarForm;
    private bool _busy;
    private string? _error;
    private List<PlanDto> _planes = new();
    private PlanForm _form = new();
    private Guid? _editId;

    private class PlanForm
    {
        public string Nombre { get; set; } = "";
        public string? Descripcion { get; set; }
        public decimal FeeBase { get; set; }
        public decimal FeeVariablePorUnidad { get; set; }
        public bool CicloMensual { get; set; } = true;
        public bool CicloAnual { get; set; } = true;
        public decimal DescuentoAnualPct { get; set; }
        public int? LimiteUnidades { get; set; }
        public int? LimiteUsuarios { get; set; }
        public int? LimiteStorageGb { get; set; }
        public int DiasTrial { get; set; }
        public EstadoPlan Estado { get; set; } = EstadoPlan.Activo;
    }

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        try
        {
            var http = AuthorizedClient();
            _planes = await http.GetFromJsonAsync<List<PlanDto>>("/admin/billing/planes") ?? new();
        }
        finally { _cargando = false; }
    }

    private void MostrarFormulario()
    {
        _form = new PlanForm();
        _editId = null;
        _error = null;
        _mostrarForm = true;
    }

    private void EditarPlan(PlanDto p)
    {
        _editId = p.Id;
        _form = new PlanForm
        {
            Nombre = p.Nombre,
            Descripcion = p.Descripcion,
            FeeBase = p.FeeBase,
            FeeVariablePorUnidad = p.FeeVariablePorUnidad,
            CicloMensual = p.CicloMensual,
            CicloAnual = p.CicloAnual,
            DescuentoAnualPct = p.DescuentoAnualPct,
            LimiteUnidades = p.LimiteUnidades,
            LimiteUsuarios = p.LimiteUsuarios,
            LimiteStorageGb = p.LimiteStorageGb,
            DiasTrial = p.DiasTrial,
            Estado = p.Estado
        };
        _error = null;
        _mostrarForm = true;
    }

    private void CancelarForm()
    {
        _mostrarForm = false;
        _editId = null;
    }

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Nombre)) { _error = "Nombre obligatorio."; return; }
        _busy = true; _error = null;
        try
        {
            var http = AuthorizedClient();
            HttpResponseMessage resp;
            if (_editId is null)
            {
                var req = new CrearPlanRequest(_form.Nombre, _form.Descripcion,
                    _form.FeeBase, _form.FeeVariablePorUnidad,
                    _form.CicloMensual, _form.CicloAnual, _form.DescuentoAnualPct,
                    _form.LimiteUnidades, _form.LimiteUsuarios, _form.LimiteStorageGb,
                    _form.DiasTrial);
                resp = await http.PostAsJsonAsync("/admin/billing/planes", req);
            }
            else
            {
                var req = new ActualizarPlanRequest(_form.Nombre, _form.Descripcion,
                    _form.FeeBase, _form.FeeVariablePorUnidad,
                    _form.CicloMensual, _form.CicloAnual, _form.DescuentoAnualPct,
                    _form.LimiteUnidades, _form.LimiteUsuarios, _form.LimiteStorageGb,
                    _form.DiasTrial, _form.Estado);
                resp = await http.PutAsJsonAsync($"/admin/billing/planes/{_editId}", req);
            }
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Error {(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}";
                return;
            }
            CancelarForm();
            await CargarAsync();
        }
        finally { _busy = false; }
    }

    private RenderFragment EstadoBadge(EstadoPlan e) => __builder =>
    {
        var cls = e switch
        {
            EstadoPlan.Activo => "bg-success",
            EstadoPlan.Inactivo => "bg-secondary",
            _ => "bg-dark"
        };
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", $"badge {cls}");
        __builder.AddContent(2, e.ToString());
        __builder.CloseElement();
    };

    private HttpClient AuthorizedClient()
    {
        var http = HttpFactory.CreateClient("PropiaApi");
        http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Session.AccessToken!);
        return http;
    }
}
