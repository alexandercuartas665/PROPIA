@inject SuperAdminSession Session
@inject NavigationManager Nav
@implements IDisposable

@* Sidebar de la consola SuperAdmin - MISMA estructura NexLink del cliente (rail + tab-content).
   Rail (iconos) agrupa: Inicio, Plataforma, Billing, Integraciones, Monitoria, Auditoria, Cuenta.
   El tab activo se calcula server-side desde la ruta (igual patron que el Web cliente). *@

@if (Session.IsAuthenticated)
{
    @* === Rail (iconos verticales, 80px) === *@
    <div class="app-navbar-tabs" data-simplebar>
        <ul class="nav" id="appMenubarTabs" role="tablist" aria-orientation="vertical">

            <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Inicio">
                <a class="@RailClass("tabInicio")" href="javascript:void(0)" data-tab-target="tabInicio">
                    <i class="fi fi-rr-dashboard"></i>
                </a>
            </li>

            <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Plataforma">
                <a class="@RailClass("tabPlataforma")" href="javascript:void(0)" data-tab-target="tabPlataforma">
                    <i class="fi fi-rr-building"></i>
                </a>
            </li>

            <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Billing y suscripciones">
                <a class="@RailClass("tabBilling")" href="javascript:void(0)" data-tab-target="tabBilling">
                    <i class="fi fi-rr-usd-circle"></i>
                </a>
            </li>

            <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Integraciones">
                <a class="@RailClass("tabIntegraciones")" href="javascript:void(0)" data-tab-target="tabIntegraciones">
                    <i class="fi fi-rr-plug"></i>
                </a>
            </li>

            <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Monitoria">
                <a class="@RailClass("tabMonitoria")" href="javascript:void(0)" data-tab-target="tabMonitoria">
                    <i class="fi fi-rr-heart-rate"></i>
                </a>
            </li>

            <li class="nav-item-hr"></li>

            <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Auditoria">
                <a class="@RailClass("tabAuditoria")" href="javascript:void(0)" data-tab-target="tabAuditoria">
                    <i class="fi fi-rr-document"></i>
                </a>
            </li>

            <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Mi cuenta">
                <a class="@RailClass("tabCuenta")" href="javascript:void(0)" data-tab-target="tabCuenta">
                    <i class="fi fi-rr-user"></i>
                </a>
            </li>
        </ul>
    </div>

    @* === Panel textual (200px) === *@
    <div class="app-tab-content">
        <div class="app-side-brands">
            <a class="navbar-brand-text" href="/dashboard">PROPIA <small class="text-muted">Super Admin</small></a>
        </div>
        <div class="app-content-inner">
            <div class="tab-content" id="appMenubarTabsContent">

                @* --- INICIO --- *@
                <div class="@TabClass("tabInicio")" id="tabInicio" role="tabpanel">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">Inicio</span></li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/dashboard" Match="NavLinkMatch.All">
                                    <i class="fi fi-rr-dashboard"></i>
                                    <span class="menu-label">Dashboard</span>
                                </NavLink>
                            </li>
                        </ul>
                    </nav>
                </div>

                @* --- PLATAFORMA --- *@
                <div class="@TabClass("tabPlataforma")" id="tabPlataforma" role="tabpanel">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">Plataforma</span></li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/organizaciones">
                                    <i class="fi fi-rr-network"></i>
                                    <span class="menu-label">Organizaciones</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/tenants">
                                    <i class="fi fi-rr-building"></i>
                                    <span class="menu-label">Copropiedades</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/equipo">
                                    <i class="fi fi-rr-users-alt"></i>
                                    <span class="menu-label">Equipo A&D</span>
                                </NavLink>
                            </li>
                        </ul>
                    </nav>
                </div>

                @* --- BILLING --- *@
                <div class="@TabClass("tabBilling")" id="tabBilling" role="tabpanel">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">Billing y suscripciones</span></li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/billing/planes">
                                    <i class="fi fi-rr-layers"></i>
                                    <span class="menu-label">Planes</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/billing/suscripciones">
                                    <i class="fi fi-rr-refresh"></i>
                                    <span class="menu-label">Suscripciones</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/billing/facturas">
                                    <i class="fi fi-rr-receipt"></i>
                                    <span class="menu-label">Facturas</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/billing/config">
                                    <i class="fi fi-rr-settings"></i>
                                    <span class="menu-label">Configuracion</span>
                                </NavLink>
                            </li>
                        </ul>
                    </nav>
                </div>

                @* --- INTEGRACIONES --- *@
                <div class="@TabClass("tabIntegraciones")" id="tabIntegraciones" role="tabpanel">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">Integraciones</span></li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/integraciones/wompi">
                                    <i class="fi fi-rr-credit-card"></i>
                                    <span class="menu-label">Wompi</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/integraciones/correo">
                                    <i class="fi fi-rr-envelope"></i>
                                    <span class="menu-label">Servidor de correo</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/integraciones/ia">
                                    <i class="fi fi-rr-brain"></i>
                                    <span class="menu-label">Servidores de IA</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/integraciones/evolution">
                                    <i class="fi fi-rr-comment-alt"></i>
                                    <span class="menu-label">Evolution (WhatsApp)</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/integraciones/marca">
                                    <i class="fi fi-rr-palette"></i>
                                    <span class="menu-label">Marca</span>
                                </NavLink>
                            </li>
                        </ul>
                    </nav>
                </div>

                @* --- MONITORIA (0.3) --- *@
                <div class="@TabClass("tabMonitoria")" id="tabMonitoria" role="tabpanel">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">Monitoria (0.3)</span></li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/monitoria" Match="NavLinkMatch.All">
                                    <i class="fi fi-rr-heart-rate"></i>
                                    <span class="menu-label">Dashboard salud</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/monitoria/logs">
                                    <i class="fi fi-rr-file-medical-alt"></i>
                                    <span class="menu-label">Logs sistema</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/monitoria/incidentes">
                                    <i class="fi fi-rr-triangle-warning"></i>
                                    <span class="menu-label">Incidentes</span>
                                </NavLink>
                            </li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/monitoria/jobs">
                                    <i class="fi fi-rr-time-fast"></i>
                                    <span class="menu-label">Jobs nocturnos</span>
                                </NavLink>
                            </li>
                        </ul>
                    </nav>
                </div>

                @* --- AUDITORIA --- *@
                <div class="@TabClass("tabAuditoria")" id="tabAuditoria" role="tabpanel">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">Auditoria</span></li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/logs">
                                    <i class="fi fi-rr-document"></i>
                                    <span class="menu-label">Logs Super Admin</span>
                                </NavLink>
                            </li>
                        </ul>
                    </nav>
                </div>

                @* --- MI CUENTA --- *@
                <div class="@TabClass("tabCuenta")" id="tabCuenta" role="tabpanel">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">Mi cuenta</span></li>
                            <li class="menu-item">
                                <NavLink class="menu-link" href="/mfa/setup">
                                    <i class="fi fi-rr-shield-check"></i>
                                    <span class="menu-label">MFA</span>
                                </NavLink>
                            </li>
                        </ul>
                    </nav>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private string _activeTab = "tabInicio";

    protected override void OnInitialized()
    {
        _activeTab = ResolveTab(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var nuevo = ResolveTab(e.Location);
        if (nuevo != _activeTab)
        {
            _activeTab = nuevo;
            InvokeAsync(StateHasChanged);
        }
    }

    private static string ResolveTab(string uri)
    {
        string path;
        try { path = new Uri(uri).AbsolutePath.ToLowerInvariant(); }
        catch { path = uri.ToLowerInvariant(); }

        if (path.StartsWith("/organizaciones") || path.StartsWith("/tenants") || path.StartsWith("/equipo")) return "tabPlataforma";
        if (path.StartsWith("/billing")) return "tabBilling";
        if (path.StartsWith("/integraciones")) return "tabIntegraciones";
        if (path.StartsWith("/monitoria")) return "tabMonitoria";
        if (path.StartsWith("/logs")) return "tabAuditoria";
        if (path.StartsWith("/mfa")) return "tabCuenta";
        return "tabInicio";
    }

    private string TabClass(string id) =>
        _activeTab == id ? "tab-pane fade show active" : "tab-pane fade";

    private string RailClass(string id) =>
        _activeTab == id ? "menu-link active" : "menu-link";
}
