@inject SuperAdminSession Session

@* Sidebar de navegacion del Super Admin Console. Solo se muestra si hay sesion. *@

@if (Session.IsAuthenticated)
{
    <nav class="nav flex-column py-3">
        <NavLink class="nav-link text-white px-3 py-2" href="/dashboard" Match="NavLinkMatch.All">
            <i class="me-2">DB</i> Dashboard
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2" href="/organizaciones">
            <i class="me-2">O</i> Organizaciones
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2" href="/tenants">
            <i class="me-2">T</i> Copropiedades
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2" href="/equipo">
            <i class="me-2">E</i> Equipo A&D
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2" href="/logs">
            <i class="me-2">L</i> Logs
        </NavLink>
        <hr class="text-secondary mx-3" />
        <NavLink class="nav-link text-white px-3 py-2" href="/mfa/setup">
            <i class="me-2">M</i> MFA
        </NavLink>
    </nav>
}

<style>
    .nav-link.active {
        background-color: rgba(255, 255, 255, 0.1);
        color: white !important;
    }
    .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.05);
        color: white !important;
    }
</style>
