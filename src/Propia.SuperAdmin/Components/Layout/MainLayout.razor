@inherits LayoutComponentBase
@inject SuperAdminSession Session
@inject NavigationManager Nav

@* Layout principal del Super Admin Console: sidebar oscuro estilo "operador" + topbar *@

<div class="d-flex" style="min-height: 100vh; background-color: #f5f6fa;">
    <aside class="bg-dark text-white" style="width: 240px; flex-shrink: 0;">
        <div class="p-3 border-bottom border-secondary">
            <h5 class="mb-0 fw-bold">PROPIA</h5>
            <small style="color: #a0a0b0;">Super Admin Console</small>
        </div>
        <NavMenu />
    </aside>

    <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
        <header class="bg-white border-bottom px-4 py-2 d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted">A&D GROUP S.A.S</small>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (Session.IsAuthenticated)
                {
                    <div class="text-end">
                        <div style="font-size: 0.9rem;"><strong>@Session.Email</strong></div>
                        <small class="text-muted">@Session.Rol</small>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Logout">Cerrar sesion</button>
                }
                else
                {
                    <a href="/login" class="btn btn-sm btn-dark">Ingresar</a>
                }
            </div>
        </header>

        <main class="flex-grow-1 p-4" style="overflow-y: auto;">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Error inesperado. <a href="." class="reload">Recargar</a>
    <span class="dismiss">X</span>
</div>

@code {
    private void Logout()
    {
        Session.Clear();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
