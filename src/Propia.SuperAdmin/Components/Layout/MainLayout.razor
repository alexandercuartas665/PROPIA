@inherits LayoutComponentBase
@inject SuperAdminSession Session
@inject NavigationManager Nav
@inject IJSRuntime Js

@* Layout de la consola SuperAdmin con el MISMO concepto visual del cliente (tema NexLink):
   - app-header arriba (fecha + usuario + salir)
   - app-menubar-tabs a la izquierda (rail 80px iconos + panel 200px textual)
   - app-wrapper con el contenido @Body
   Ambiente aparte del cliente, pero identico look & feel. *@

<div class="page-layout">

    @* === HEADER === *@
    <header class="app-header">
        <div class="app-header-inner">
            <button class="app-toggler" type="button" aria-label="app toggler">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.66699 12.6668L3.66699 8.00016L7.66699 3.3335" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                    <path opacity="0.5" d="M12.667 12.6668L8.66699 8.00016L12.667 3.3335" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>

            <div class="app-header-start d-none d-md-flex align-items-center gap-2">
                <span class="badge text-bg-light border">Consola interna</span>
                <small class="text-muted">A&D GROUP S.A.S &middot; @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</small>
            </div>

            <div class="app-header-end">
                @if (Session.IsAuthenticated)
                {
                    <div class="d-flex align-items-center gap-2 me-3">
                        <div class="sa-user-avatar">@(Session.Email is { Length: > 0 } e ? e[..1].ToUpper() : "?")</div>
                        <div class="d-none d-md-block lh-1">
                            <div class="fw-semibold" style="font-size:0.85rem;">@Session.Email</div>
                            <small class="text-muted">@Session.Rol</small>
                        </div>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm waves-effect" @onclick="Logout">
                        <i class="fi fi-rr-sign-out-alt me-1"></i> Salir
                    </button>
                }
                else
                {
                    <a href="/login" class="btn btn-primary btn-sm waves-effect waves-light">
                        <i class="fi fi-rr-sign-in-alt me-1"></i> Ingresar
                    </a>
                }
            </div>
        </div>
    </header>

    @* === SIDEBAR (rail + tabs) === *@
    <aside class="app-menubar-tabs" id="appMenubar">
        <div class="app-navbar-brand">
            <a class="navbar-brand-logo" href="/dashboard" title="PROPIA Super Admin">
                <div class="propia-brand-mark">P</div>
            </a>
        </div>
        <NavMenu />
    </aside>

    @* === CONTENIDO === *@
    <div class="app-wrapper">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Error inesperado. <a href="." class="reload">Recargar</a>
    <span class="dismiss">X</span>
</div>

<style>
    :root {
        --propia-primary: #5955D1;
        --propia-primary-light: #7A77E0;
    }

    .propia-brand-mark {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--propia-primary), var(--propia-primary-light));
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        font-family: 'Instrument Sans', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(89, 85, 209, 0.25);
    }

    .sa-user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--propia-primary);
        color: white;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Rail: estado activo y tamanos identicos al cliente */
    .app-navbar-tabs .nav-item .menu-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        padding: 0;
        margin: 0 auto;
    }
    .app-navbar-tabs .nav-item .menu-link i,
    .app-navbar-tabs .nav-item .menu-link i::before {
        font-size: 18px;
    }
    .app-navbar-tabs .nav-item-hr {
        width: 24px;
        margin: 12px auto;
    }

    .app-menubar-tabs .side-menubar .menu-item .menu-link.active {
        color: var(--propia-primary);
        font-weight: 600;
    }
    .app-menubar-tabs .side-menubar .menu-item .menu-link.active i {
        color: var(--propia-primary);
    }
    .app-menubar-tabs .side-menubar .menu-item .menu-link:hover {
        color: var(--propia-primary);
    }

    @@media (min-width: 1200px) {
        html:not([data-app-sidebar=mini]) {
            --app-menubar-tabs: 280px !important;
        }
        html:not([data-app-sidebar=mini]) .app-menubar-tabs .app-tab-content {
            left: 80px !important;
            width: 200px !important;
        }
        html:not([data-app-sidebar=mini]) :has(.app-menubar-tabs) .app-wrapper {
            margin-left: 280px !important;
        }
        html:not([data-app-sidebar=mini]) :has(.app-menubar-tabs) .app-header {
            padding-left: 280px !important;
        }
        html[data-app-sidebar=mini] {
            --app-menubar-tabs: 80px !important;
        }
        html[data-app-sidebar=mini] .app-menubar-tabs .app-tab-content {
            display: none !important;
        }
        html[data-app-sidebar=mini] :has(.app-menubar-tabs) .app-wrapper {
            margin-left: 80px !important;
        }
        html[data-app-sidebar=mini] :has(.app-menubar-tabs) .app-header {
            padding-left: 80px !important;
        }
        html:not([data-app-sidebar=mini]) :has(.app-menubar-tabs) .app-toggler::after,
        html[data-app-sidebar=mini] :has(.app-menubar-tabs) .app-toggler::after {
            display: none !important;
        }
        html[data-app-sidebar=mini] .app-toggler svg {
            transform: rotate(180deg);
            transition: transform 0.2s;
        }
        .app-toggler svg { transition: transform 0.2s; }
    }

    .app-menubar-tabs {
        border-right: 1px solid var(--bs-border-color);
    }

    #blazor-error-ui {
        background: #fff3cd;
        bottom: 0;
        box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2);
        display: none;
        left: 0;
        padding: 0.6rem 1.25rem 0.7rem 1.25rem;
        position: fixed;
        width: 100%;
        z-index: 1000;
    }
    #blazor-error-ui .dismiss {
        cursor: pointer;
        position: absolute;
        right: 0.75rem;
        top: 0.5rem;
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Rebind del rail/tabs/tooltips del tema NexLink en cada render.
        try { await Js.InvokeVoidAsync("propiaUI.rebind"); } catch { }
    }

    private void Logout()
    {
        Session.Clear();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
