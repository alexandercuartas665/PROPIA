@inherits LayoutComponentBase
@inject SuperAdminSession Session
@inject NavigationManager Nav

@* Layout principal con NexLink + estructura tipo cubot:
   sidebar oscuro vertical + topbar con info de sesion + main content *@

<div class="propia-app">
    <aside class="propia-sidebar">
        <div class="propia-brand">
            <div class="propia-logo">P</div>
            <div class="propia-brand-text">
                <strong>PROPIA</strong>
                <small>Super Admin</small>
            </div>
        </div>
        <NavMenu />
    </aside>

    <div class="propia-main">
        <header class="propia-topbar">
            <div class="propia-topbar-left">
                <span class="text-muted">A&D GROUP S.A.S</span>
                <span class="propia-topbar-divider"></span>
                <span class="text-muted small">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</span>
            </div>
            <div class="propia-topbar-right">
                @if (Session.IsAuthenticated)
                {
                    <div class="propia-user">
                        <div class="propia-user-avatar">@(Session.Email is { Length: > 0 } e ? e[..1].ToUpper() : "?")</div>
                        <div class="propia-user-info">
                            <div class="propia-user-name">@Session.Email</div>
                            <small class="text-muted">@Session.Rol</small>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Logout">Salir</button>
                }
                else
                {
                    <a href="/login" class="btn btn-sm btn-dark">Ingresar</a>
                }
            </div>
        </header>

        <main class="propia-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Error inesperado. <a href="." class="reload">Recargar</a>
    <span class="dismiss">X</span>
</div>

<style>
    :root {
        --propia-primary: #5955D1;
        --propia-primary-light: #7A77E0;
        --propia-sidebar-bg: #1a1a2e;
        --propia-sidebar-hover: rgba(255, 255, 255, 0.08);
        --propia-bg: #f5f6fa;
        --propia-text-muted: #6e6e85;
    }

    body {
        font-family: 'Instrument Sans', sans-serif;
        background: var(--propia-bg);
        margin: 0;
    }

    .propia-app {
        display: flex;
        min-height: 100vh;
    }

    .propia-sidebar {
        width: 250px;
        flex-shrink: 0;
        background: var(--propia-sidebar-bg);
        color: white;
        display: flex;
        flex-direction: column;
    }

    .propia-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.25rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .propia-logo {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--propia-primary) 0%, var(--propia-primary-light) 100%);
        color: white;
        font-weight: 700;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .propia-brand-text strong {
        display: block;
        line-height: 1.1;
        font-size: 1.1rem;
    }

    .propia-brand-text small {
        color: #a0a0b0;
        font-size: 0.72rem;
    }

    .propia-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .propia-topbar {
        background: white;
        border-bottom: 1px solid #e6e6ee;
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .propia-topbar-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .propia-topbar-divider {
        display: inline-block;
        width: 1px;
        height: 16px;
        background: #d6d6e1;
    }

    .propia-topbar-right {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .propia-user {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .propia-user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--propia-primary);
        color: white;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .propia-user-info {
        line-height: 1.15;
    }

    .propia-user-name {
        font-size: 0.85rem;
        font-weight: 600;
    }

    .propia-content {
        flex: 1;
        padding: 1.5rem;
        overflow-y: auto;
    }

    @@media (max-width: 768px) {
        .propia-sidebar { width: 64px; }
        .propia-brand-text { display: none; }
    }
</style>

@code {
    private void Logout()
    {
        Session.Clear();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
